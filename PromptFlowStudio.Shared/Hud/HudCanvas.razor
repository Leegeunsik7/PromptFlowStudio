@using Microsoft.JSInterop
@implements IAsyncDisposable

@* ── 재사용 HUD 캔버스 — 상태는 HudFrameBuffer(파라미터) 소유, 렌더는 hud-canvas.js rAF. Blazor DOM 재렌더 0(ShouldRender=false). ── *@
<div class="hud-canvas @(_ready ? null : "fallback")" style="height:@(Height)">
    <canvas @ref="_canvas" aria-label="@(Label)" role="img"></canvas>
    @if (Label is not null)
    {
        <span class="hud-canvas-label">@(Label)</span>
    }
</div>

@code {
    public const string ModulePath = "./_pfs/hud-canvas.js";

    [Inject] private IJSRuntime Js { get; set; } = default!;

    /// <summary>생산자가 쓰는 프레임 버퍼 — 인스턴스는 최초 바인딩 후 교체하지 않는다.</summary>
    [Parameter, EditorRequired] public HudFrameBuffer Buffer { get; set; } = default!;
    [Parameter] public HudCanvasMode Mode { get; set; } = HudCanvasMode.Bars;
    [Parameter] public string Height { get; set; } = "48px";
    [Parameter] public string? Label { get; set; }
    /// <summary>.NET→JS 푸시 주기 상한(ms). 표시 rAF 와 별개 — 데이터가 안 바뀌면 왕복 0.</summary>
    [Parameter] public int PushIntervalMs { get; set; } = 33;

    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private Timer? _timer;
    private byte[] _send = Array.Empty<byte>();
    private object?[] _pushArgs = Array.Empty<object?>();
    private long _seen = -1;
    private int _viewId, _inFlight;
    private HudCanvasMode _sentMode;
    private bool _ready, _settled, _disposed;

    protected override bool ShouldRender() => !_settled;   // ready 클래스 반영 1회 후 DOM 고정

    protected override async Task OnParametersSetAsync()
    {
        if (_module is not null && _viewId != 0 && Mode != _sentMode)
        {
            _sentMode = Mode;
            try { await _module.InvokeVoidAsync("setMode", _viewId, (int)Mode); }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) { _settled = _ready; return; }
        try
        {
            _module = await Js.InvokeAsync<IJSObjectReference>("import", ModulePath);
            _viewId = await _module.InvokeAsync<int>("init", _canvas, Buffer.Capacity, (int)Mode);
            if (_viewId == 0 || _disposed) return;
            _sentMode = Mode;
            _send = new byte[Buffer.Capacity];
            _pushArgs = new object?[] { _viewId, _send };   // 틱마다 재사용 — 인자 배열 할당 0
            _ready = true;
            StateHasChanged();
            int period = Math.Max(8, PushIntervalMs);
            _timer = new Timer(static s => ((HudCanvas)s!).OnTick(), this, period, period);
        }
        catch (Exception)
        {
            // 모듈 로드/WebGL·Canvas 미지원 → fallback 클래스 유지(CSS 빈 패널), 호스트 동작엔 영향 없음
            _ready = false;
        }
    }

    private void OnTick()
    {
        if (_disposed || Interlocked.Exchange(ref _inFlight, 1) == 1) return;   // 이전 푸시 미완료면 건너뜀(백로그 0)
        try
        {
            if (!Buffer.TryCopy(_send, ref _seen)) { Volatile.Write(ref _inFlight, 0); return; }
            _ = InvokeAsync(PushAsync);
        }
        catch (Exception) { Volatile.Write(ref _inFlight, 0); }
    }

    private async Task PushAsync()
    {
        try
        {
            if (_module is not null && !_disposed) await _module.InvokeVoidAsync("push", _pushArgs);
        }
        catch (Exception) { /* 콜백 예외 격리 — 다음 틱 재시도 */ }
        finally { Volatile.Write(ref _inFlight, 0); }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _timer?.Dispose();
        _timer = null;
        if (_module is null) return;
        try
        {
            if (_viewId != 0) await _module.InvokeVoidAsync("dispose", _viewId);
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (TaskCanceledException) { }
        _module = null;
    }
}
