@using Microsoft.AspNetCore.Components.Web.Virtualization

@* [PromptFlow Studio v4.4.1] 스토리보드 UI 크로스플랫폼 경계값 방어(Task 4 · 공용 RCL).
   대용량 Virtualize + 초장문 overflow-wrap/word-break + 48px 터치 타깃. *@

<div class="suh">
    <div class="suh-h"><span class="suh-title">🛡️ 스토리보드 UI 하드닝</span><span class="suh-badge">v4.4.1</span>
        <span class="suh-cnt">@(_items.Count)컷 · @(StoryboardStateHardening.ShouldVirtualize(_items.Count) ? "Virtualize ON" : "일반 렌더")</span></div>

    <div class="suh-list">
        @if (StoryboardStateHardening.ShouldVirtualize(_items.Count))
        {
            <Virtualize Items="_items" Context="cut" ItemSize="76" OverscanCount="4">
                <div class="suh-row">
                    <span class="suh-idx">@(cut.Index + 1)</span>
                    <div class="suh-body"><div class="suh-prompt">@cut.Prompt</div></div>
                    <div class="suh-ops">
                        <button class="suh-btn edit" title="수정">✏️</button>
                        <button class="suh-btn del" title="삭제">🗑️</button>
                    </div>
                </div>
            </Virtualize>
        }
        else
        {
            @foreach (var cut in _items)
            {
                <div class="suh-row" @key="cut.Index">
                    <span class="suh-idx">@(cut.Index + 1)</span>
                    <div class="suh-body"><div class="suh-prompt">@cut.Prompt</div></div>
                    <div class="suh-ops">
                        <button class="suh-btn edit" title="수정">✏️</button>
                        <button class="suh-btn del" title="삭제">🗑️</button>
                    </div>
                </div>
            }
        }
    </div>
    <div class="suh-note">💡 100컷 이상 자동 Virtualize(DOM 병목 차단) · 초장문/이모지 컷도 컨테이너를 뚫지 않고 줄바꿈 · 수정/삭제 버튼 48×48 터치 타깃.</div>
</div>

<style>
    .suh { border: 1px solid color-mix(in srgb, #22c55e 34%, #2b2f42); border-radius: 16px; overflow: hidden; font-family: Pretendard, 'Malgun Gothic', sans-serif; color: #e6edff; background: linear-gradient(160deg, rgba(34,197,94,.07), rgba(18,20,31,.92)); }
    .suh-h { display: flex; align-items: center; gap: 8px; padding: 12px 15px; border-bottom: 1px solid #2b2f42; flex-wrap: wrap; }
    .suh-title { font: 900 14px Pretendard,'Malgun Gothic',sans-serif; color: #86efac; }
    .suh-badge { font: 800 10px ui-monospace,monospace; color: #052e16; background: #34d399; border-radius: 20px; padding: 2px 8px; }
    .suh-cnt { margin-left: auto; font: 700 10px ui-monospace,monospace; color: #6b7392; }
    .suh-list { max-height: 360px; overflow-y: auto; padding: 8px 12px; }
    .suh-row { display: flex; align-items: center; gap: 10px; padding: 8px; border: 1px solid #2b2f42; border-radius: 11px; background: rgba(26,29,43,.6); margin-bottom: 6px; min-height: 60px; }
    .suh-idx { flex: 0 0 auto; width: 26px; height: 26px; border-radius: 8px; background: #12141f; border: 1px solid #2b2f42; display: grid; place-items: center; font: 800 11px ui-monospace,monospace; color: #86efac; }
    .suh-body { flex: 1; min-width: 0; }
    /* ★ 초장문/이모지 방어 — 컨테이너 이탈 금지 */
    .suh-prompt { font: 600 11.5px Pretendard,'Malgun Gothic',sans-serif; color: #cbd5e1; line-height: 1.5; overflow-wrap: anywhere; word-break: keep-all; }
    .suh-ops { flex: 0 0 auto; display: flex; gap: 6px; }
    /* ★ 최소 터치 타깃 48×48 */
    .suh-btn { min-width: 48px; min-height: 48px; display: grid; place-items: center; border-radius: 12px; border: 1px solid #2b2f42; background: #1a1d2b; color: #e6edff; cursor: pointer; font-size: 17px; }
    .suh-btn.edit:hover { border-color: #0ea5e9; } .suh-btn.del:hover { border-color: #ef4444; }
    .suh-note { padding: 0 15px 14px; font: 600 10.5px Pretendard,'Malgun Gothic',sans-serif; color: #6b7392; line-height: 1.5; word-break: keep-all; }
</style>

@code {
    /// <summary>렌더할 컷 목록(기본: 하드닝 시연용 150컷 · 초장문/이모지 포함).</summary>
    [Parameter] public IReadOnlyList<HardenSampleCut>? Cuts { get; set; }

    private List<HardenSampleCut> _items = new();

    protected override void OnInitialized()
    {
        if (Cuts is not null) { _items = Cuts.ToList(); return; }
        // 시연용 150컷 — 대용량 Virtualize + 초장문/이모지 경계값 방어 확인.
        _items = Enumerable.Range(0, 150).Select(i => new HardenSampleCut(i,
            i == 3
                ? "😀🍋👶 " + string.Concat(Enumerable.Repeat("초장문컷프롬프트텍스트그리고특수문자!!!@#$%^&*()_+-=", 12)) + " 끝"
                : $"컷 {i + 1} · Macro 85mm 렌즈, 따뜻한 골든아워 백라이트, 아기의 클로즈업 리액션 컷 (테마 자동 구성)")).ToList();
    }

    /// <summary>하드닝 시연 컷 DTO.</summary>
    public sealed record HardenSampleCut(int Index, string Prompt);
}
