{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-desktop",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/PromptFlowStudio/PromptFlowStudio.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": { "kind": "build", "isDefault": true }
        }
    ]
}
