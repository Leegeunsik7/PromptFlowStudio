<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PromptFlowKeyGen</AssemblyName>
    <RootNamespace>PromptFlowStudio.KeyGen</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- ⚠ 발급자(벤더) 전용 도구 — RSA 개인 서명키 내장. 고객 배포본에 절대 포함 금지.
       메인 앱(PromptFlowStudio.csproj)은 이 프로젝트를 참조하지 않으며, 배포 패키징에서 명시적으로 제외한다. -->

</Project>
