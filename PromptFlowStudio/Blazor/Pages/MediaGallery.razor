    private async Task ExportStock(GalleryItem g)
    {
        if (_stockBusy) return;
        _stockBusy = true;
        Vm.SetStatus("💼 StockSuite 내보내기 중(" + PromptFlowStudio.Services.Export.StockSuiteExporter.FormatLabel(StockSuite.DefaultFormat) + ")… " + g.Title);
        try
        {
            var r = await StockSuite.ExportAsync(g.FilePath);
            if (r.Ok) { RefreshArchive(); ProbeRollback(); }   // 📦 내보냄 메타 즉시 반영 · ↩️ 복원 버튼
            Vm.SetStatus(r.Ok ? r.Message : r.NeedsPathSetup ? "⚠ " + r.Message + " (설정 ▸ 사용자 설정 ▸ StockSuite 에셋 경로)" : "⚠ " + r.Message);
        }
        catch (Exception ex) { Program.Log("MediaGallery.StockSuite", ex); Vm.SetStatus("⚠ StockSuite 내보내기 실패 — 경로를 재설정하세요"); }
        finally { _stockBusy = false; await InvokeAsync(StateHasChanged); }
    }

    // ── 📅 장중 스케줄러 ──
    private bool _scheduleOpen, _scheduleBusy;
    private string? _scheduleMsg;
    private readonly Dictionary<string, string?> _slotAssign = new(StringComparer.Ordinal);

    private void OpenSchedule() { _scheduleOpen = true; _scheduleMsg = null; }
    private void CloseSchedule() { if (!_scheduleBusy) _scheduleOpen = false; }
    private string SlotValue(string key) => _slotAssign.TryGetValue(key, out var v) ? v ?? "" : "";

    private void SetSlot(string key, string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) _slotAssign.Remove(key);
        else _slotAssign[key] = path;
    }

    private async Task PublishSchedule()
    {
        if (_scheduleBusy || _slotAssign.Count == 0) return;
        _scheduleBusy = true;
        _scheduleMsg = "📅 스케줄 발행 중…";
        try
        {
            var r = await Playlist.PublishAsync(_slotAssign);
            _scheduleMsg = r.NeedsPathSetup ? "⚠ " + r.Message + " (설정 ▸ 사용자 설정 ▸ StockSuite 에셋 경로)" : r.Message;
            if (r.Published.Count > 0) RefreshArchive();   // 📦 내보냄 탭 즉시 반영
        }
        catch (Exception ex) { Program.Log("MediaGallery.Schedule", ex); _scheduleMsg = "⚠ 스케줄 발행 실패: " + ex.Message; }
        finally { _scheduleBusy = false; await InvokeAsync(StateHasChanged); }
    }

