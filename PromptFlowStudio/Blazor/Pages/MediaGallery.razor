@page "/gallery"
@using PromptFlowStudio.Services.Wan
@using PromptFlowStudio.Services.Gallery
@using PromptFlowStudio.ViewModels
@using System.Globalization
@implements IDisposable
@inject IMediaLibraryService Library
@inject IVideoUpscaleService Upscale
@inject PromptFlowStudio.Services.Ui.GalleryAutoSaveService Flow
@inject NavigationManager Nav
@inject GalleryViewModel Vm
@inject ILocalMediaService Media
@inject IClipboardService Clipboard
@inject PublishViewModel PubVm
@inject PromptFlowStudio.Services.Export.StockSuiteExporter StockSuite
@inject PromptFlowStudio.Services.Export.StockSuitePlaylistService Playlist
@inject PromptFlowStudio.Services.Export.AssetBundleService Bundles

@* [PromptFlow Studio] 갤러리 — %LocalAppData%/PromptFlowStudio/Media 의 모든 MP4 를 그리드로 감상/관리/삭제. *@

<PageTitle>PromptFlow Studio · 갤러리</PageTitle>

<div class="gl">
    <header class="gl-head">
        <div>
            <h1 class="gl-title">미디어 <span class="gl-title-g">갤러리</span> <MenuHelpBadge MenuKey="@GranularHelpService.Keys.Gallery" /></h1>
            <p class="gl-sub">로컬에 자산화된 완성 영상·컷을 모아 봅니다.</p>
        </div>
        <div class="gl-stat">
            <span>@_items.Count 개</span>
            <span>· @MediaLibraryService.FormatBytes(_totalBytes)</span>
            <span>· 여유 @MediaLibraryService.FormatBytes(_freeBytes)</span>
            <button class="gl-btn ghost" @onclick="Refresh" title="새로고침">↻</button>
        </div>
    </header>

    <div style="margin:12px 0 16px;"><StudioMonitorHeader EngineReady="true" /></div>

    @* 메타데이터 아카이브 — 프롬프트·시드·해상도 사이드카(.meta.json) 기반 그리드 + 인스펙터 → 작업실 복원 *@
    <section class="ga">
        <div class="ga-bar">
            <div class="ga-tabs">
                <button class="ga-tab @(Vm.SelectedFilter == GalleryFilter.All ? "on" : null)" @onclick="() => Vm.SetFilter(GalleryFilter.All)">전체</button>
                <button class="ga-tab @(Vm.SelectedFilter == GalleryFilter.Vertical9x16 ? "on" : null)" @onclick="() => Vm.SetFilter(GalleryFilter.Vertical9x16)">9:16 쇼츠</button>
                <button class="ga-tab @(Vm.SelectedFilter == GalleryFilter.Landscape16x9 ? "on" : null)" @onclick="() => Vm.SetFilter(GalleryFilter.Landscape16x9)">16:9 와이드</button>
                <button class="ga-tab @(Vm.SelectedFilter == GalleryFilter.Favorites ? "on" : null)" @onclick="() => Vm.SetFilter(GalleryFilter.Favorites)">⭐ 즐겨찾기</button>
                <button class="ga-tab @(Vm.SelectedFilter == GalleryFilter.AiRender ? "on" : null)" @onclick="() => Vm.SetFilter(GalleryFilter.AiRender)">🎬 AI Render</button>
                <button class="ga-tab @(Vm.SelectedFilter == GalleryFilter.Snapshots ? "on" : null)" @onclick="() => Vm.SetFilter(GalleryFilter.Snapshots)" title="MediaRoot/_stills 캡처 PNG">🖼️ 스냅샷</button>
                <button class="ga-tab @(Vm.SelectedFilter == GalleryFilter.Exported ? "on" : null)" @onclick="() => Vm.SetFilter(GalleryFilter.Exported)">📦 내보냄</button>
            </div>
            <input class="gl-search" value="@Vm.SearchQuery" @oninput="OnArchiveSearch" placeholder="🔎 프롬프트(영/한)·티커·파일명 검색…" />
            <button class="gl-btn ghost" @onclick="RefreshArchive" title="아카이브 새로고침">⟳</button>
            <button class="gl-btn bad" @onclick="DeleteMockAll" disabled="@(Vm.MockCount == 0)" title="🧪 Mock 태그 영상 + 메타데이터를 디스크에서 영구 삭제">🧹 더미/Mock 파일 일괄 삭제 (@(Vm.MockCount))</button>
            <button class="gl-btn bad" @onclick="DeleteCheckedAll" disabled="@(Vm.CheckedCount == 0)" title="체크된 항목을 디스크에서 영구 삭제">🗑 다중 선택 삭제 (@(Vm.CheckedCount))</button>
            @if (Vm.CheckedCount > 0)
            {
                <button class="gl-btn ghost" @onclick="Vm.ClearChecks" title="선택 해제">✕</button>
            }
            <span class="ga-cnt">@Vm.MediaItems.Count / @Vm.TotalCount</span>
        </div>
        @* 🔎 다각도 칩 필터 — 같은 칩 재클릭 = 해제 *@
        <div class="ga-chips" role="group" aria-label="다각도 필터">
            <span class="ga-chip-cap">화면비</span>
            <button class="ga-chip @(Vm.AspectChip == GalleryAspectChip.W16x9 ? "on" : null)" @onclick="() => Vm.SetAspectChip(GalleryAspectChip.W16x9)">16:9</button>
            <button class="ga-chip @(Vm.AspectChip == GalleryAspectChip.W21x9 ? "on" : null)" @onclick="() => Vm.SetAspectChip(GalleryAspectChip.W21x9)">21:9</button>
            <button class="ga-chip @(Vm.AspectChip == GalleryAspectChip.W32x9 ? "on" : null)" @onclick="() => Vm.SetAspectChip(GalleryAspectChip.W32x9)">32:9</button>
            <button class="ga-chip @(Vm.AspectChip == GalleryAspectChip.V9x16 ? "on" : null)" @onclick="() => Vm.SetAspectChip(GalleryAspectChip.V9x16)">9:16</button>
            <span class="ga-chip-cap">해상도</span>
            <button class="ga-chip @(Vm.ResolutionChip == GalleryResolutionChip.Uhd4K ? "on" : null)" @onclick="() => Vm.SetResolutionChip(GalleryResolutionChip.Uhd4K)">4K</button>
            <button class="ga-chip @(Vm.ResolutionChip == GalleryResolutionChip.Fhd1080 ? "on" : null)" @onclick="() => Vm.SetResolutionChip(GalleryResolutionChip.Fhd1080)">1080p</button>
            <span class="ga-chip-cap">코덱</span>
            <button class="ga-chip @(Vm.CodecChip == GalleryCodecChip.Mp4 ? "on" : null)" @onclick="() => Vm.SetCodecChip(GalleryCodecChip.Mp4)">MP4</button>
            <button class="ga-chip @(Vm.CodecChip == GalleryCodecChip.WebM ? "on" : null)" @onclick="() => Vm.SetCodecChip(GalleryCodecChip.WebM)">WebM</button>
            @if (Vm.HasActiveSearch)
            {
                <button class="gl-btn bad" @onclick="() => _confirmBulk = BulkKind.Search" disabled="@(Vm.SearchResultCount == 0)" title="현재 검색·칩 조건에 일치하는 항목만 디스크에서 영구 삭제">🗑 검색된 결과만 일괄 삭제 (@(Vm.SearchResultCount))</button>
                <button class="gl-btn ghost" @onclick="ExportSearchResults" disabled="@(Vm.SearchResultCount == 0)" title="내 비디오\PromptFlowStudio Exports 로 미디어 + 메타 복사">📤 검색된 결과 일괄 내보내기</button>
            }
        </div>
        @* 💽 스토리지 점유율 대시보드 *@
        @{ var stg = Vm.Storage; }
        <div class="ga-stg">
            <div class="ga-stg-h">
                <b>💽 @MediaLibraryService.FormatBytes(stg.TotalBytes)</b>
                <span>/ 디스크 여유 @(stg.FreeBytes >= 0 ? MediaLibraryService.FormatBytes(stg.FreeBytes) : "확인 불가")</span>
                <span class="ga-stg-n">· 에셋 @(stg.Count.ToString(CultureInfo.InvariantCulture))개</span>
            </div>
            <div class="ga-stg-bar" role="img" aria-label="포맷별 점유율">
                <i class="uhd" style="width:@(stg.Percent(stg.Uhd4KBytes).ToString("0.##", CultureInfo.InvariantCulture))%"></i>
                <i class="fhd" style="width:@(stg.Percent(stg.Fhd1080Mp4Bytes).ToString("0.##", CultureInfo.InvariantCulture))%"></i>
                <i class="webm" style="width:@(stg.Percent(stg.WebMBytes).ToString("0.##", CultureInfo.InvariantCulture))%"></i>
                <i class="etc" style="width:@(stg.Percent(stg.OtherBytes).ToString("0.##", CultureInfo.InvariantCulture))%"></i>
            </div>
            <div class="ga-stg-lg">
                <span><i class="uhd"></i>4K UHD @MediaLibraryService.FormatBytes(stg.Uhd4KBytes)</span>
                <span><i class="fhd"></i>1080p MP4 @MediaLibraryService.FormatBytes(stg.Fhd1080Mp4Bytes)</span>
                <span><i class="webm"></i>WebM @MediaLibraryService.FormatBytes(stg.WebMBytes)</span>
                <span><i class="etc"></i>기타 @MediaLibraryService.FormatBytes(stg.OtherBytes)</span>
            </div>
        </div>
        @if (_confirmBulk is { } cb)
        {
            <div class="ga-confirm">
                <span>⚠ @(cb == BulkKind.Mock ? "Mock 더미 " + Vm.MockCount.ToString(CultureInfo.InvariantCulture) : cb == BulkKind.Search ? "검색 결과 " + Vm.SearchResultCount.ToString(CultureInfo.InvariantCulture) : "선택 " + Vm.CheckedCount.ToString(CultureInfo.InvariantCulture))개 파일을 영구 삭제할까요? (되돌릴 수 없음)</span>
                <button class="gl-btn bad" @onclick="ConfirmBulk">삭제</button>
                <button class="gl-btn ghost" @onclick="() => _confirmBulk = null">취소</button>
            </div>
        }
        <div class="ga-body">
            <div class="ga-grid">
                @foreach (var g in Vm.MediaItems)
                {
                    <div class="ga-card @(ReferenceEquals(g, Vm.SelectedItem) ? "sel" : null)" @key="g.ItemId" @onclick="() => Vm.SelectMedia(g)">
                        <div class="ga-thumb" @onmouseenter="() => HoverOn(g)" @onmouseleave="() => HoverOff(g)">
                            @* 초경량 Hover-to-Play — 기본은 정적 포스터(VRAM 0) · 호버 시에만 <video> 마운트(2초 무음 루프) · 이탈 시 언마운트 *@
                            @if (g.IsVideo && !g.IsSample && _hoverId == g.ItemId)
                            {
                                <video src="@Media.ToPlaybackUrl(g.FilePath)" autoplay muted loop playsinline preload="auto"
                                       ontimeupdate="if(this.currentTime>=2)this.currentTime=0"></video>
                            }
                            else if (StillOf(g) is { } th)
                            {
                                <img src="@th" alt="@g.Title" loading="lazy" />
                            }
                            else if (g.IsVideo && !g.IsSample)
                            {
                                <div class="ga-still"><span>▶</span></div>
                            }
                            <button class="ga-fav @(g.IsFavorite ? "on" : null)" @onclick="() => Vm.ToggleFavorite(g)" @onclick:stopPropagation="true"
                                    title="@(g.IsFavorite ? "즐겨찾기 해제" : "즐겨찾기 추가")">@(g.IsFavorite ? "⭐" : "☆")</button>
                            <span class="ga-badge">@AspectLabel(g.AspectCategory)</span>
                            @if (g.IsVideo && PromptFlowStudio.Services.Gallery.GalleryMediaService.FormatDurationBadge(g.DurationSeconds) is { } durBadge)
                            {
                                <span class="ga-badge dur" title="재생시간(트림 시 즉시 갱신)">⏱ @durBadge</span>
                            }
                            @if (g.IsSample)
                            {
                                <span class="ga-badge smp">샘플</span>
                            }
                            else
                            {
                                <input type="checkbox" class="ga-chk" checked="@Vm.IsChecked(g)" @onchange="() => Vm.ToggleCheck(g)" @onclick:stopPropagation="true" title="다중 선택" />
                                <span class="ga-tag @(g.IsStill ? "still" : g.IsMock ? "mock" : g.IsExported ? "exp" : "ai")">@g.AssetTag</span>
                                @if (g.IsVideo && IsStockApplied(g))
                                {
                                    <span class="ga-ss" title="StockSuite 에셋 폴더의 bg_ambient 와 일치">🟢 StockSuite 적용 중</span>
                                }
                                @if (g.IsVideo)
                                {
                                    <button class="ga-hover" @onclick="() => ExportStock(g)" @onclick:stopPropagation="true" disabled="@_stockBusy"
                                            title="@("StockSuite 에셋 폴더에 " + PromptFlowStudio.Services.Export.StockSuiteExporter.FormatLabel(StockSuite.DefaultFormat) + " 로 즉시 덮어쓰기")">💼 StockSuite로 즉시 내보내기</button>
                                }
                                else if (g.IsStill)
                                {
                                    <div class="ga-snap" @onclick:stopPropagation="true">
                                        <button @onclick="() => ApplyWallpaper(g)" title="Windows 바탕화면 배경으로 즉시 적용">🖼️ 바탕화면 적용</button>
                                        <button @onclick="() => RevealStill(g)" title="탐색기에서 파일 선택 상태로 열기">📂 탐색기에서 보기</button>
                                        <button class="del" @onclick="() => DeleteArchive(g)" title="스냅샷 파일 영구 삭제(다중 선택은 체크박스 → 🗑 다중 선택 삭제)">🗑️ 스냅샷 삭제</button>
                                    </div>
                                }
                            }
                        </div>
                        <div class="ga-t" title="@g.Title">@g.Title</div>
                        <div class="ga-d">@g.CreatedAt.ToString("MM-dd HH:mm", CultureInfo.InvariantCulture)</div>
                    </div>
                }
                @if (Vm.MediaItems.Count == 0)
                {
                    <div class="ga-none">조건에 맞는 미디어가 없어요.</div>
                }
            </div>
            <aside class="ga-insp">
                @if (Vm.SelectedItem is { } si)
                {
                    <div class="ga-prev">
                        @if (si.IsVideo && !si.IsSample)
                        {
                            <video src="@Media.ToPlaybackUrl(si.FilePath)" controls loop muted></video>
                        }
                        else if (ThumbOf(si) is { } pv)
                        {
                            <img src="@pv" alt="@si.Title" />
                        }
                    </div>
                    <div class="ga-it">@si.Title</div>
                    <div class="ga-k">사용된 프롬프트 <button class="ga-copy" @onclick="() => CopyPrompt(si)" title="프롬프트 복사">📋</button></div>
                    <textarea class="ga-prompt" readonly value="@si.Prompt"></textarea>
                    @if (si.ReferenceImagePath is { } refPath)
                    {
                        <div class="ga-k">I2V 참조 이미지</div>
                        <div class="ga-ref" title="@refPath">🖼 @(System.IO.Path.GetFileName(refPath))</div>
                    }
                    <div class="ga-meta">
                        <span>시드</span><b>@si.Seed.ToString(CultureInfo.InvariantCulture)</b>
                        <span>해상도</span><b>@si.Resolution</b>
                        <span>렌더 시간</span><b>@(si.RenderDurationSec.ToString("0.0", CultureInfo.InvariantCulture))초</b>
                    </div>
                    <div class="ga-acts">
                        <button class="gl-btn up" @onclick="() => Vm.RestoreToWorkspace(si)">✨ 이 프롬프트로 작업실 복원 →</button>
                        @if (si.IsVideo && !si.IsSample)
                        {
                            <button class="gl-btn up" @onclick="() => OpenPublish(si.FilePath, si.Title, si.Prompt)" title="YouTube Shorts · Instagram Reels 원클릭 발행">🚀 SNS 발행</button>
                        }
                        @if (si.IsVideo && !si.IsSample)
                        {
                            <button class="gl-btn up" @onclick="() => ExportStock(si)" disabled="@_stockBusy" title="StockSuite 에셋 폴더에 즉시 덮어쓰기">💼 StockSuite</button>
                        }
                        <button class="gl-btn bad" @onclick="() => DeleteArchive(si)">🗑 삭제</button>
                    </div>
                }
                else
                {
                    <div class="ga-none">카드를 선택하면 프롬프트·시드·해상도를 확인할 수 있어요.</div>
                }
                @if (Vm.StatusMessage is { } sm)
                {
                    <div class="ga-msg">@sm</div>
                }
            </aside>
        </div>
    </section>

    @* v5.6: 플로우 노드가 자산화한 이미지/비디오(추출 프레임·롱폼 병합) 실시간 스트립 *@
    @if (Flow.Assets.Count > 0)
    {
        <div class="gl-flow">
            <div class="gl-flow-h">🕹️ 플로우 노드 자산 <span class="gl-flow-n">@Flow.Assets.Count</span></div>
            <div class="gl-flow-grid">
                @foreach (var a in Flow.Assets)
                {
                    <div class="gl-flow-tile" @key="a">
                        @if (a.Kind == GalleryAssetKind.Video && !WanSampleFactory.IsImageUrl(a.Url))
                        {
                            <video src="@a.Url" preload="metadata" muted></video>
                        }
                        else
                        {
                            <img src="@a.Url" alt="@a.Label" loading="lazy" />
                        }
                        <div class="gl-flow-lb">@a.Label</div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="gl-toolbar">
        <input class="gl-search" @bind="_filter" @bind:event="oninput" placeholder="파일명·폴더 검색…" />
        <button class="gl-btn up" @onclick="ExportBundle" disabled="@_bundleBusy" title="현재 목록 영상 + .meta.json + playlist.json · 디스플레이 설정을 단일 .pfsbundle(ZIP)로 패키징 — MediaRoot/_bundles">📦 Export .pfsbundle</button>
        <label class="gl-btn up gl-file @(_bundleBusy ? "off" : null)" title=".pfsbundle 가져오기 — 매니페스트 검증 · SHA-256 무결성 · 중복 건너뜀 · 플레이리스트 슬롯 안전 병합">📥 Import Bundle<InputFile class="gl-file-input" OnChange="ImportBundle" accept=".pfsbundle,application/zip" disabled="@_bundleBusy" /></label>
        <button class="gl-btn up" @onclick="OpenSchedule" title="장초반/정규장/장마감/야간 시간대별 배경 자동 전환 — StockSuite playlist.json 발행">📅 장중 스케줄러</button>
        @if (_canRollback)
        {
            <button class="gl-btn up" @onclick="RollbackStock" disabled="@_stockBusy" title="StockSuite 활성 배경 ↔ 직전 백업(bg_ambient.backup) 맞교환">↩️ 이전 배경으로 복원</button>
        }
    </div>

    @if (Filtered.Count == 0)
    {
        <div class="gl-empty">
            <div class="gl-empty-ic">🎞️</div>
            @if (_items.Count == 0)
            {
                <div class="gl-empty-t">아직 만든 영상이 없어요</div>
                <div class="gl-empty-d">첫 AI 숏츠를 만들어 보세요 — 프롬프트 한 줄이면 충분합니다.</div>
                <div class="gl-empty-cards">
                    <button class="gl-card" @onclick='() => Nav.NavigateTo("workspace")'>
                        <span class="gl-card-ic">➕</span>
                        <span class="gl-card-t">새 프로젝트 생성</span>
                        <span class="gl-card-d">텍스트/이미지 → 영상 단일 컷</span>
                    </button>
                    <button class="gl-card" @onclick='() => Nav.NavigateTo("storyboard")'>
                        <span class="gl-card-ic">✨</span>
                        <span class="gl-card-t">대본 자동 생성</span>
                        <span class="gl-card-d">주제 한 줄 → 5컷 스토리보드</span>
                    </button>
                </div>
            }
            else
            {
                <div class="gl-empty-t">검색 결과가 없어요</div>
                <div class="gl-empty-d">다른 검색어를 입력해 보세요.</div>
            }
        </div>
    }
    else
    {
        <div class="gl-grid">
            @foreach (var m in Filtered)
            {
                <div class="gl-tile" @key="m.Path">
                    <div class="gl-thumb" @onclick="() => _modal = m">
                        @if (m.PosterUrl is not null)
                        {
                            <img src="@m.PosterUrl" alt="@m.Name" loading="lazy" />
                        }
                        else
                        {
                            <video src="@m.PlaybackUrl" preload="metadata" muted></video>
                        }
                        <div class="gl-play">▶</div>
                    </div>
                    <div class="gl-meta">
                        <div class="gl-name" title="@m.Name">@m.Name</div>
                        <div class="gl-info">@m.Folder · @MediaLibraryService.FormatBytes(m.Bytes) · @m.Created.ToString("MM-dd HH:mm")</div>
                    </div>
                    <div class="gl-ops">
                        <button class="gl-op" @onclick="() => Library.Reveal(m.Path)" title="탐색기에서 보기">📂</button>
                        <button class="gl-op pub" @onclick="() => OpenPublish(m.Path, m.Folder, null)" title="🚀 SNS 발행 (YouTube Shorts · Instagram Reels)">🚀</button>
                        <button class="gl-op del" @onclick="() => _pendingDelete = m" title="삭제">🗑️</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* 확대 재생 모달 *@
@if (_modal is { } mv)
{
    <div class="gl-modal" @onclick="() => _modal = null">
        <div class="gl-modal-box" @onclick:stopPropagation="true">
            <div class="gl-modal-h">
                <span class="gl-modal-t" title="@mv.Path">@mv.Name</span>
                <button class="gl-op" @onclick="() => _modal = null">✕</button>
            </div>
            <video class="gl-modal-vid" src="@mv.PlaybackUrl" controls autoplay loop="@_loopPlayback"></video>
            <label class="gl-loop-toggle" title="배경(앰비언트) 비디오 검토용 무한 반복"><input type="checkbox" @bind="_loopPlayback" /> 🔁 무한 반복 재생</label>
            <div class="gl-modal-f">
                <button class="gl-btn ghost" @onclick="() => Library.Reveal(mv.Path)">💾 탐색기에서 보기</button>
                <button class="gl-btn up" @onclick="() => OpenPublish(mv.Path, mv.Folder, null)" title="YouTube Shorts · Instagram Reels 원클릭 발행">🚀 SNS 발행</button>
                <div class="gl-up">
                    <select class="gl-up-eng" @bind="_upEngine" disabled="@_upBusy">
                        <option value="RealEsrgan">실사 · Real-ESRGAN</option>
                        <option value="RealCugan">2D/애니 · Real-CUGAN</option>
                    </select>
                    <button class="gl-btn up" @onclick="() => UpscaleItem(mv)"
                            disabled="@(_upBusy || !Upscale.AnyAvailable)"
                            title="@(Upscale.AnyAvailable ? "이 영상을 4K로 업스케일" : "업스케일 엔진 미설치 — appsettings.json 의 Engines:RealEsrgan:Exe 지정")">
                        @(_upBusy ? "업스케일 중…" : "🚀 4K 업스케일")
                    </button>
                </div>
                <span class="gl-modal-info">@MediaLibraryService.FormatBytes(mv.Bytes) · @mv.Created.ToString("yyyy-MM-dd HH:mm")</span>
            </div>

            <MediaInspector VideoPath="@mv.Path" />
            @if (_upBusy || _upMsg is not null)
            {
                <div class="gl-up-prog">
                    <div class="gl-up-t">@(_upBusy ? $"🚀 {_upStatus} {(int)_upPct}%" : _upMsg)</div>
                    @if (_upBusy)
                    {
                        <div class="gl-bar"><div class="gl-bar-f" style="width:@((int)_upPct)%"></div></div>
                    }
                </div>
            }
        </div>
    </div>
}

@* 삭제 확인 *@
