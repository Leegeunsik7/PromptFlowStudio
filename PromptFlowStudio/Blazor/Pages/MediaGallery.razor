@page "/gallery"
@using PromptFlowStudio.Services.Wan
@using PromptFlowStudio.Services.Gallery
@using PromptFlowStudio.ViewModels
@using System.Globalization
@implements IDisposable
@inject IMediaLibraryService Library
@inject IVideoUpscaleService Upscale
@inject PromptFlowStudio.Services.Ui.GalleryAutoSaveService Flow
@inject NavigationManager Nav
@inject GalleryViewModel Vm
@inject ILocalMediaService Media
@inject IClipboardService Clipboard

@* [PromptFlow Studio] 갤러리 — %LocalAppData%/PromptFlowStudio/Media 의 모든 MP4 를 그리드로 감상/관리/삭제. *@

<PageTitle>PromptFlow Studio · 갤러리</PageTitle>

<div class="gl">
    <header class="gl-head">
        <div>
            <h1 class="gl-title">미디어 <span class="gl-title-g">갤러리</span> <MenuHelpBadge MenuKey="@GranularHelpService.Keys.Gallery" /></h1>
            <p class="gl-sub">로컬에 자산화된 완성 영상·컷을 모아 봅니다.</p>
        </div>
        <div class="gl-stat">
            <span>@_items.Count 개</span>
            <span>· @MediaLibraryService.FormatBytes(_totalBytes)</span>
            <span>· 여유 @MediaLibraryService.FormatBytes(_freeBytes)</span>
            <button class="gl-btn ghost" @onclick="Refresh" title="새로고침">↻</button>
        </div>
    </header>

    <div style="margin:12px 0 16px;"><StudioMonitorHeader EngineReady="true" /></div>

    @* 메타데이터 아카이브 — 프롬프트·시드·해상도 사이드카(.meta.json) 기반 그리드 + 인스펙터 → 작업실 복원 *@
    <section class="ga">
        <div class="ga-bar">
            <div class="ga-tabs">
                <button class="ga-tab @(Vm.SelectedFilter == GalleryFilter.All ? "on" : null)" @onclick="() => Vm.SetFilter(GalleryFilter.All)">전체</button>
                <button class="ga-tab @(Vm.SelectedFilter == GalleryFilter.Vertical9x16 ? "on" : null)" @onclick="() => Vm.SetFilter(GalleryFilter.Vertical9x16)">9:16 쇼츠</button>
                <button class="ga-tab @(Vm.SelectedFilter == GalleryFilter.Landscape16x9 ? "on" : null)" @onclick="() => Vm.SetFilter(GalleryFilter.Landscape16x9)">16:9 와이드</button>
            </div>
            <input class="gl-search" value="@Vm.SearchQuery" @oninput="OnArchiveSearch" placeholder="프롬프트·제목 검색…" />
            <button class="gl-btn ghost" @onclick="RefreshArchive" title="아카이브 새로고침">⟳</button>
            <span class="ga-cnt">@Vm.MediaItems.Count / @Vm.TotalCount</span>
        </div>
        <div class="ga-body">
            <div class="ga-grid">
                @foreach (var g in Vm.MediaItems)
                {
                    <div class="ga-card @(ReferenceEquals(g, Vm.SelectedItem) ? "sel" : null)" @key="g.ItemId" @onclick="() => Vm.SelectMedia(g)">
                        <div class="ga-thumb">
                            @if (ThumbOf(g) is { } th)
                            {
                                <img src="@th" alt="@g.Title" loading="lazy" />
                            }
                            else if (g.IsVideo && !g.IsSample)
                            {
                                <video src="@Media.ToPlaybackUrl(g.FilePath)" preload="metadata" muted></video>
                            }
                            <span class="ga-badge">@AspectLabel(g.AspectCategory)</span>
                            @if (g.IsSample)
                            {
                                <span class="ga-badge smp">샘플</span>
                            }
                        </div>
                        <div class="ga-t" title="@g.Title">@g.Title</div>
                        <div class="ga-d">@g.CreatedAt.ToString("MM-dd HH:mm", CultureInfo.InvariantCulture)</div>
                    </div>
                }
                @if (Vm.MediaItems.Count == 0)
                {
                    <div class="ga-none">조건에 맞는 미디어가 없어요.</div>
                }
            </div>
            <aside class="ga-insp">
                @if (Vm.SelectedItem is { } si)
                {
                    <div class="ga-prev">
                        @if (si.IsVideo && !si.IsSample)
                        {
                            <video src="@Media.ToPlaybackUrl(si.FilePath)" controls loop muted></video>
                        }
                        else if (ThumbOf(si) is { } pv)
                        {
                            <img src="@pv" alt="@si.Title" />
                        }
                    </div>
                    <div class="ga-it">@si.Title</div>
                    <div class="ga-k">사용된 프롬프트 <button class="ga-copy" @onclick="() => CopyPrompt(si)" title="프롬프트 복사">📋</button></div>
                    <textarea class="ga-prompt" readonly value="@si.Prompt"></textarea>
                    <div class="ga-meta">
                        <span>시드</span><b>@si.Seed.ToString(CultureInfo.InvariantCulture)</b>
                        <span>해상도</span><b>@si.Resolution</b>
                        <span>렌더 시간</span><b>@(si.RenderDurationSec.ToString("0.0", CultureInfo.InvariantCulture))초</b>
                    </div>
                    <div class="ga-acts">
                        <button class="gl-btn up" @onclick="() => Vm.RestoreToWorkspace(si)">✨ 이 프롬프트로 작업실 복원 →</button>
                        <button class="gl-btn bad" @onclick="() => DeleteArchive(si)">🗑 삭제</button>
                    </div>
                }
                else
                {
                    <div class="ga-none">카드를 선택하면 프롬프트·시드·해상도를 확인할 수 있어요.</div>
                }
                @if (Vm.StatusMessage is { } sm)
                {
                    <div class="ga-msg">@sm</div>
                }
            </aside>
        </div>
    </section>

    @* v5.6: 플로우 노드가 자산화한 이미지/비디오(추출 프레임·롱폼 병합) 실시간 스트립 *@
    @if (Flow.Assets.Count > 0)
    {
        <div class="gl-flow">
            <div class="gl-flow-h">🕹️ 플로우 노드 자산 <span class="gl-flow-n">@Flow.Assets.Count</span></div>
            <div class="gl-flow-grid">
                @foreach (var a in Flow.Assets)
                {
                    <div class="gl-flow-tile" @key="a">
                        @if (a.Kind == GalleryAssetKind.Video && !WanSampleFactory.IsImageUrl(a.Url))
                        {
                            <video src="@a.Url" preload="metadata" muted></video>
                        }
                        else
                        {
                            <img src="@a.Url" alt="@a.Label" loading="lazy" />
                        }
                        <div class="gl-flow-lb">@a.Label</div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="gl-toolbar">
        <input class="gl-search" @bind="_filter" @bind:event="oninput" placeholder="파일명·폴더 검색…" />
    </div>

    @if (Filtered.Count == 0)
    {
        <div class="gl-empty">
            <div class="gl-empty-ic">🎞️</div>
            @if (_items.Count == 0)
            {
                <div class="gl-empty-t">아직 만든 영상이 없어요</div>
                <div class="gl-empty-d">첫 AI 숏츠를 만들어 보세요 — 프롬프트 한 줄이면 충분합니다.</div>
                <div class="gl-empty-cards">
                    <button class="gl-card" @onclick='() => Nav.NavigateTo("workspace")'>
                        <span class="gl-card-ic">➕</span>
                        <span class="gl-card-t">새 프로젝트 생성</span>
                        <span class="gl-card-d">텍스트/이미지 → 영상 단일 컷</span>
                    </button>
                    <button class="gl-card" @onclick='() => Nav.NavigateTo("storyboard")'>
                        <span class="gl-card-ic">🪄</span>
                        <span class="gl-card-t">대본 자동 생성</span>
                        <span class="gl-card-d">주제 한 줄 → 5컷 스토리보드</span>
                    </button>
                </div>
            }
            else
            {
                <div class="gl-empty-t">검색 결과가 없어요</div>
                <div class="gl-empty-d">다른 검색어를 입력해 보세요.</div>
            }
        </div>
    }
    else
    {
        <div class="gl-grid">
            @foreach (var m in Filtered)
            {
                <div class="gl-tile" @key="m.Path">
                    <div class="gl-thumb" @onclick="() => _modal = m">
                        @if (m.PosterUrl is not null)
                        {
                            <img src="@m.PosterUrl" alt="@m.Name" loading="lazy" />
                        }
                        else
                        {
                            <video src="@m.PlaybackUrl" preload="metadata" muted></video>
                        }
                        <div class="gl-play">▶</div>
                    </div>
                    <div class="gl-meta">
                        <div class="gl-name" title="@m.Name">@m.Name</div>
                        <div class="gl-info">@m.Folder · @MediaLibraryService.FormatBytes(m.Bytes) · @m.Created.ToString("MM-dd HH:mm")</div>
                    </div>
                    <div class="gl-ops">
                        <button class="gl-op" @onclick="() => Library.Reveal(m.Path)" title="탐색기에서 보기">💾</button>
                        <button class="gl-op del" @onclick="() => _pendingDelete = m" title="삭제">🗑️</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* 확대 재생 모달 *@
@if (_modal is { } mv)
{
    <div class="gl-modal" @onclick="() => _modal = null">
        <div class="gl-modal-box" @onclick:stopPropagation="true">
            <div class="gl-modal-h">
                <span class="gl-modal-t" title="@mv.Path">@mv.Name</span>
                <button class="gl-op" @onclick="() => _modal = null">✕</button>
            </div>
            <video class="gl-modal-vid" src="@mv.PlaybackUrl" controls autoplay loop></video>
            <div class="gl-modal-f">
                <button class="gl-btn ghost" @onclick="() => Library.Reveal(mv.Path)">💾 탐색기에서 보기</button>
                <div class="gl-up">
                    <select class="gl-up-eng" @bind="_upEngine" disabled="@_upBusy">
                        <option value="RealEsrgan">실사 · Real-ESRGAN</option>
                        <option value="RealCugan">2D/애니 · Real-CUGAN</option>
                    </select>
                    <button class="gl-btn up" @onclick="() => UpscaleItem(mv)"
                            disabled="@(_upBusy || !Upscale.AnyAvailable)"
                            title="@(Upscale.AnyAvailable ? "이 영상을 4K로 업스케일" : "업스케일 엔진 미설치 — appsettings.json 의 Engines:RealEsrgan:Exe 지정")">
                        @(_upBusy ? "업스케일 중…" : "🚀 4K 업스케일")
                    </button>
                </div>
                <span class="gl-modal-info">@MediaLibraryService.FormatBytes(mv.Bytes) · @mv.Created.ToString("yyyy-MM-dd HH:mm")</span>
            </div>

            <MediaInspector VideoPath="@mv.Path" />
            @if (_upBusy || _upMsg is not null)
            {
                <div class="gl-up-prog">
                    <div class="gl-up-t">@(_upBusy ? $"🚀 {_upStatus} {(int)_upPct}%" : _upMsg)</div>
                    @if (_upBusy)
                    {
                        <div class="gl-bar"><div class="gl-bar-f" style="width:@((int)_upPct)%"></div></div>
                    }
                </div>
            }
        </div>
    </div>
}

@* 삭제 확인 *@
@if (_pendingDelete is { } pd)
{
    <div class="gl-modal" @onclick="() => _pendingDelete = null">
        <div class="gl-confirm" @onclick:stopPropagation="true">
            <div class="gl-confirm-t">🗑️ 삭제할까요?</div>
            <div class="gl-confirm-d">@pd.Name<br /><span>이 작업은 되돌릴 수 없습니다.</span></div>
            <div class="gl-confirm-a">
                <button class="gl-btn ghost" @onclick="() => _pendingDelete = null">취소</button>
                <button class="gl-btn bad" @onclick="() => Confirm(pd)">삭제</button>
            </div>
        </div>
    </div>
}

<style>
    .gl { padding: 6px 8px 48px; width: 100%; box-sizing: border-box; }
    .gl-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 14px; }
    .gl-title { font-size: 26px; font-weight: 900; letter-spacing: -.4px; color: var(--text-primary); margin: 0 0 6px; }
    .gl-title-g { background: linear-gradient(90deg, var(--flow-magenta), var(--flow-violet)); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .gl-sub { font-size: 13px; color: var(--text-secondary); margin: 0; }
    .gl-stat { display: flex; align-items: center; gap: 8px; font: 600 11.5px var(--mono); color: var(--text-muted); }

    .gl-toolbar { margin-bottom: 14px; }
    .gl-search { width: 100%; max-width: 360px; box-sizing: border-box; background: var(--card-2); border: 1px solid var(--line); border-radius: 10px; padding: 9px 13px; color: var(--text-primary); font-size: 13px; font-family: inherit; }
    .gl-search:focus { outline: none; border-color: var(--accent); }

    .gl-empty { text-align: center; padding: 54px 20px; color: var(--text-muted); font-size: 13px; border: 1px dashed var(--line); border-radius: 16px; background: var(--card); }
    .gl-empty-ic { font-size: 46px; opacity: .5; margin-bottom: 10px; }
    .gl-empty-t { font-size: 17px; font-weight: 800; color: var(--text-primary); }
    .gl-empty-d { font-size: 13px; color: var(--text-secondary); margin: 8px 0 20px; }
    .gl-empty-cards { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
    .gl-card { display: flex; flex-direction: column; align-items: center; gap: 3px; width: 180px; padding: 16px 14px; border-radius: 14px; cursor: pointer;
        background: var(--card-2); border: 1px solid var(--line); color: var(--text-secondary); font-family: inherit; }
    .gl-card:hover { border-color: var(--accent); transform: translateY(-2px); }
    .gl-card-ic { font-size: 26px; }
    .gl-card-t { font-size: 13.5px; font-weight: 800; color: var(--text-primary); }
    .gl-card-d { font-size: 11px; color: var(--text-muted); }

    /* v5.6 플로우 자산 스트립 */
    .gl-flow { margin: 0 0 18px; padding: 12px 14px; border: 1px solid color-mix(in srgb, #7c5cff 28%, var(--line)); border-radius: 14px; background: color-mix(in srgb, #7c5cff 6%, var(--card)); }
    .gl-flow-h { font: 800 13px Pretendard,'Malgun Gothic',sans-serif; color: var(--text-primary); margin-bottom: 10px; }
    .gl-flow-n { font: 800 10px var(--mono); color: #a78bfa; background: color-mix(in srgb,#7c5cff 16%,transparent); border-radius: 20px; padding: 2px 8px; margin-left: 4px; }
    .gl-flow-grid { display: flex; gap: 10px; flex-wrap: wrap; }
    .gl-flow-tile { width: 160px; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; background: var(--card-2); }
    .gl-flow-tile img, .gl-flow-tile video { width: 100%; aspect-ratio: 16/9; object-fit: cover; display: block; background: #000; }
    .gl-flow-lb { font: 700 10px Pretendard,'Malgun Gothic',sans-serif; color: var(--text-secondary); padding: 5px 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    .gl-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; }
    .gl-tile { border: 1px solid var(--line); border-radius: 14px; background: var(--card); overflow: hidden; display: flex; flex-direction: column; transition: border-color .14s, transform .1s; }
    .gl-tile:hover { border-color: color-mix(in srgb, var(--flow-violet) 45%, var(--line)); transform: translateY(-2px); }
    .gl-thumb { position: relative; aspect-ratio: 16/9; background: #000; cursor: pointer; display: grid; place-items: center; overflow: hidden; }
    .gl-thumb video, .gl-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .gl-play { position: absolute; width: 42px; height: 42px; border-radius: 50%; background: rgba(0,0,0,.5); color: #fff; display: grid; place-items: center; font-size: 16px; pointer-events: none; }
    .gl-meta { padding: 9px 11px 4px; }
    .gl-name { font-size: 12.5px; font-weight: 700; color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .gl-info { font: 600 10.5px var(--mono); color: var(--text-muted); margin-top: 2px; }
    .gl-ops { display: flex; gap: 6px; padding: 6px 11px 11px; }
    .gl-op { width: 30px; height: 30px; border-radius: 8px; border: 1px solid var(--line); background: var(--card-2); color: var(--text-secondary); cursor: pointer; font-size: 13px; }
    .gl-op:hover { border-color: var(--accent); color: var(--text-primary); }
    .gl-op.del:hover { border-color: #ef4444; color: #ef4444; }

    .gl-btn { border: none; border-radius: 10px; padding: 9px 14px; font-weight: 800; font-size: 12.5px; cursor: pointer; font-family: inherit; }
    .gl-btn.ghost { background: var(--card-2); color: var(--text-secondary); border: 1px solid var(--line); }
    .gl-btn.bad { background: #ef4444; color: #fff; }

    .gl-modal { position: fixed; inset: 0; z-index: 200; background: rgba(0,0,0,.72); display: grid; place-items: center; padding: 24px; }
    .gl-modal-box { width: min(860px, 96vw); max-height: 92vh; overflow-y: auto; overscroll-behavior: contain; background: var(--card); border: 1px solid var(--line); border-radius: 16px; box-shadow: 0 30px 80px rgba(0,0,0,.5); }
    .gl-modal-h { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; border-bottom: 1px solid var(--line); }
    .gl-modal-t { font-size: 13px; font-weight: 700; color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .gl-modal-vid { width: 100%; max-height: 66vh; background: #000; display: block; }
    .gl-modal-f { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px; }
    .gl-modal-info { font: 600 11px var(--mono); color: var(--text-muted); }

    .gl-confirm { width: min(380px, 92vw); background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 22px; text-align: center; box-shadow: 0 24px 60px rgba(0,0,0,.5); }
    .gl-confirm-t { font-size: 17px; font-weight: 800; color: var(--text-primary); }
    .gl-confirm-d { font-size: 13px; color: var(--text-secondary); margin: 10px 0 18px; line-height: 1.6; } .gl-confirm-d span { color: var(--text-muted); font-size: 11.5px; }
    .gl-confirm-a { display: flex; gap: 10px; justify-content: center; }

    /* 4K 업스케일(모달) */
    .gl-up { display: flex; align-items: center; gap: 8px; }
    .gl-up-eng { border-radius: 8px; border: 1px solid var(--line); background: var(--card-2); color: var(--text-primary); padding: 8px 10px; font-size: 12px; font-family: inherit; }
    .gl-up-eng:focus { outline: none; border-color: var(--accent); }
    .gl-btn.up { color: #fff; background: linear-gradient(135deg, var(--flow-violet), var(--accent)); }
    .gl-btn.up:disabled { opacity: .45; cursor: not-allowed; }
    .gl-up-prog { padding: 0 16px 14px; }
    .gl-up-t { font: 700 12px var(--mono); color: var(--accent-2); margin-bottom: 6px; }
    .gl-bar { height: 8px; border-radius: 999px; background: var(--card-2); border: 1px solid var(--line); overflow: hidden; }
    /* 메타데이터 아카이브 */
    .ga { margin: 0 0 18px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 14px; background: var(--card); }
    .ga-bar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; }
    .ga-tabs { display: flex; gap: 4px; }
    .ga-tab { border: 1px solid var(--line); background: var(--card-2); color: var(--text-secondary); border-radius: 20px; padding: 6px 12px; font-weight: 700; font-size: 12px; cursor: pointer; font-family: inherit; }
    .ga-tab.on { border-color: var(--flow-violet); color: var(--text-primary); background: color-mix(in srgb, var(--flow-violet) 16%, var(--card-2)); }
    .ga-cnt { font: 600 11px var(--mono); color: var(--text-muted); margin-left: auto; }
    .ga-body { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 14px; }
    .ga-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; align-content: start; }
    .ga-card { border: 2px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--card-2); cursor: pointer; transition: border-color .14s; }
    .ga-card:hover { border-color: color-mix(in srgb, var(--flow-violet) 45%, var(--line)); }
    .ga-card.sel { border-color: var(--accent); box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 30%, transparent); }
    .ga-thumb { position: relative; aspect-ratio: 16/9; background: #000; }
    .ga-thumb img, .ga-thumb video { width: 100%; height: 100%; object-fit: cover; display: block; }
    .ga-badge { position: absolute; top: 6px; left: 6px; font: 800 9.5px var(--mono); color: #fff; background: rgba(0,0,0,.6); border-radius: 6px; padding: 2px 6px; }
    .ga-badge.smp { left: auto; right: 6px; background: color-mix(in srgb, var(--flow-violet) 70%, #000); }
    .ga-t { font-size: 12px; font-weight: 700; color: var(--text-primary); padding: 6px 8px 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ga-d { font: 600 10px var(--mono); color: var(--text-muted); padding: 2px 8px 7px; }
    .ga-insp { border: 1px solid var(--line); border-radius: 12px; background: var(--card-2); padding: 12px; display: flex; flex-direction: column; gap: 8px; }
    .ga-prev { background: #000; border-radius: 8px; overflow: hidden; display: grid; place-items: center; max-height: 260px; }
    .ga-prev img, .ga-prev video { max-width: 100%; max-height: 260px; display: block; }
    .ga-it { font-size: 14px; font-weight: 800; color: var(--text-primary); }
    .ga-k { font-size: 11px; font-weight: 700; color: var(--text-muted); display: flex; align-items: center; justify-content: space-between; }
    .ga-copy { border: 1px solid var(--line); background: var(--card); border-radius: 6px; cursor: pointer; font-size: 12px; padding: 2px 6px; }
