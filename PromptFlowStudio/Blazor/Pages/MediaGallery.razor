@code {
    private IReadOnlyList<MediaItem> _items = Array.Empty<MediaItem>();
    private string _filter = "";
    private long _totalBytes, _freeBytes;
    private MediaItem? _modal;
    private MediaItem? _pendingDelete;

    // 4K 업스케일
    private bool _upBusy;
    private double _upPct;
    private string _upStatus = "준비";
    private string _upEngine = "RealEsrgan";
    private string? _upMsg;

    private List<MediaItem> Filtered => string.IsNullOrWhiteSpace(_filter)
        ? _items.ToList()
        : _items.Where(m =>
              m.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase) ||
              m.Folder.Contains(_filter, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override void OnInitialized()
    {
        Refresh();
        Flow.OnChanged += OnFlowChanged;   // v5.6 플로우 자산 실시간 갱신
        Vm.Changed += OnVmChanged;
        Vm.RestoreRequested += OnRestoreRequested;
        Vm.Refresh(Media.MediaRoot);
    }

    private void OnFlowChanged() => InvokeAsync(StateHasChanged);
    private void OnVmChanged() => InvokeAsync(StateHasChanged);
    private void OnRestoreRequested() => InvokeAsync(() => Nav.NavigateTo("workspace"));
    public void Dispose()
    {
        Flow.OnChanged -= OnFlowChanged;
        Vm.Changed -= OnVmChanged;
        Vm.RestoreRequested -= OnRestoreRequested;
    }

    // ── 메타데이터 아카이브 ──
    private void RefreshArchive() => Vm.Refresh(Media.MediaRoot);

    private void OnArchiveSearch(ChangeEventArgs e)
    {
        Vm.SearchQuery = e.Value?.ToString() ?? "";
        Vm.ApplyFilter();
    }

    private void DeleteArchive(GalleryItem g)
    {
        if (Vm.Delete(g)) Refresh();   // 파일 삭제 → 하단 MP4 그리드 동기화
    }

    private void CopyPrompt(GalleryItem g) => Clipboard.SetText(g.Prompt);

    private string? ThumbOf(GalleryItem g)
    {
        var t = g.ThumbnailUrl;
        if (string.IsNullOrEmpty(t)) return null;
        if (t.StartsWith("data:", StringComparison.Ordinal) || t.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return t;
        try { return Media.ToPlaybackUrl(t); } catch { return null; }
    }

    private static string AspectLabel(AspectCategory a) => a switch
    {
        AspectCategory.Vertical9x16 => "9:16",
        AspectCategory.Square1x1 => "1:1",
        _ => "16:9",
    };

    private void Refresh()
    {
        _items = Library.List();
        _totalBytes = _items.Sum(i => i.Bytes);
        _freeBytes = Library.FreeSpaceBytes();
    }

    private void Confirm(MediaItem m)
    {
        Library.Delete(m.Path);
        _pendingDelete = null;
        if (_modal?.Path == m.Path) _modal = null;
        Refresh();
    }

    // ── 4K 업스케일(모달 대상 영상) ──
    private async Task UpscaleItem(MediaItem m)
    {
        if (_upBusy) return;
        var engine = _upEngine == "RealCugan" ? UpscaleEngine.RealCugan : UpscaleEngine.RealEsrgan;
        if (!Upscale.IsAvailable(engine)) { _upMsg = $"❌ {engine} 엔진 미설치 — appsettings.json 의 Engines 경로를 지정하세요."; return; }

        _upBusy = true; _upPct = 0; _upStatus = "시작"; _upMsg = null;
        try
        {
            var dir = Path.GetDirectoryName(m.Path)!;
            var outPath = Path.Combine(dir, Path.GetFileNameWithoutExtension(m.Path) + "_4k.mp4");
            var prog = new Progress<double>(p => { _upPct = p; _ = InvokeAsync(StateHasChanged); });
            var stat = new Progress<string>(s => { _upStatus = s; _ = InvokeAsync(StateHasChanged); });
            var r = await Upscale.UpscaleAsync(m.Path, outPath, 4, engine, prog, stat, CancellationToken.None);
            _upMsg = r.Ok ? "✅ 4K 완료 — " + Path.GetFileName(r.OutputPath) : "❌ " + r.Message;
            if (r.Ok) Refresh();   // 새 _4k 파일을 그리드에 반영
        }
        catch (Exception ex) { _upMsg = "❌ " + ex.Message; }
        finally { _upBusy = false; _ = InvokeAsync(StateHasChanged); }
    }
}
