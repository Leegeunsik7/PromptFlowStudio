    private BulkKind? _confirmBulk;
    private bool _stockBusy, _canRollback;
    private bool _bundleBusy;
    public const long MaxBundleBytes = 16L * 1024 * 1024 * 1024;

    /// <summary>📦 현재 필터 목록 → MediaRoot/_bundles/pfs_yyyyMMdd_HHmmss.pfsbundle(프리셋 포함).</summary>
    private async Task ExportBundle()
    {
        if (_bundleBusy) return;
        _bundleBusy = true;
        try
        {
            var ids = new List<string>(Filtered.Count);
            foreach (var m in Filtered) ids.Add(m.Path);
            var path = System.IO.Path.Combine(Media.MediaRoot, "_bundles", "pfs_" + DateTime.Now.ToString("yyyyMMdd_HHmmss", System.Globalization.CultureInfo.InvariantCulture) + PromptFlowStudio.Services.Export.AssetBundleService.Extension);
            var r = await Bundles.ExportBundleAsync(path, ids, includePresets: true);
            Vm.SetStatus(r.Ok ? r.Message : "⚠ " + r.Message);
        }
        catch (Exception ex) { Program.Log("MediaGallery.BundleExport", ex); Vm.SetStatus("⚠ 번들 내보내기 실패"); }
        finally { _bundleBusy = false; await InvokeAsync(StateHasChanged); }
    }

    /// <summary>📥 선택 .pfsbundle → 임시 파일 스트리밍 → 검증 · 추출 · 갤러리 갱신.</summary>
    private async Task ImportBundle(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null || _bundleBusy) return;
        if (file.Size > MaxBundleBytes) { Vm.SetStatus("⚠ 번들 파일이 너무 큽니다"); return; }
        _bundleBusy = true;
        var tmp = System.IO.Path.Combine(System.IO.Path.GetTempPath(), "pfs_import_" + Guid.NewGuid().ToString("N") + PromptFlowStudio.Services.Export.AssetBundleService.Extension);
        try
        {
            await using (var src = file.OpenReadStream(MaxBundleBytes))
            await using (var dst = System.IO.File.Create(tmp))
                await src.CopyToAsync(dst);
            var r = await Bundles.ImportBundleAsync(tmp);
            Vm.SetStatus(r.Ok ? r.Message : "⚠ " + r.Message);
            if (r.Imported.Count > 0) { Refresh(); RefreshArchive(); }
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException or OperationCanceledException or ObjectDisposedException or UnauthorizedAccessException)
        {
            Program.Log("MediaGallery.BundleImport", ex);
            Vm.SetStatus("⚠ 번들 가져오기 실패: " + ex.Message);
        }
        finally
        {
            try { if (System.IO.File.Exists(tmp)) System.IO.File.Delete(tmp); } catch (IOException) { } catch (UnauthorizedAccessException) { }
            _bundleBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ProbeRollback()
    {
        try { _canRollback = StockSuite.CanRollback(); }
        catch (Exception ex) { Program.Log("MediaGallery.RollbackProbe", ex); _canRollback = false; }
