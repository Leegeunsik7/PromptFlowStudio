    // ── 🧹 정화 도구 · 💼 StockSuite 직결 ──
    private enum BulkKind { Mock, Checked, Search }

    private void ExportSearchResults()
    {
        try { Vm.ExportSearchResults(); }
        catch (Exception ex) { Program.Log("MediaGallery.ExportSearch", ex); Vm.SetStatus("⚠ 내보내기 실패: " + ex.Message); }
