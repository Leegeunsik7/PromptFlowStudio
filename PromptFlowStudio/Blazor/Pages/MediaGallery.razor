    private async Task RollbackStock()
    {
        if (_stockBusy) return;
        _stockBusy = true;
        try
        {
            var r = StockSuite.RollbackPrevious();
            Vm.SetStatus(r.Ok ? r.Message : "⚠ " + r.Message);
        }
        catch (Exception ex) { Program.Log("MediaGallery.Rollback", ex); Vm.SetStatus("⚠ 롤백 실패"); }
        finally { _stockBusy = false; ProbeRollback(); await InvokeAsync(StateHasChanged); }
    }

    private void DeleteMockAll() => _confirmBulk = BulkKind.Mock;
    private void DeleteCheckedAll() => _confirmBulk = BulkKind.Checked;

    private void ConfirmBulk()
    {
        var kind = _confirmBulk;
        _confirmBulk = null;
        try
        {
            var n = kind == BulkKind.Mock ? Vm.DeleteMockAssets() : kind == BulkKind.Checked ? Vm.DeleteChecked() : kind == BulkKind.Search ? Vm.DeleteSearchResults() : 0;
            if (n > 0) Refresh();   // 하단 MP4 그리드 동기화
        }
        catch (Exception ex) { Program.Log("MediaGallery.BulkDelete", ex); Vm.SetStatus("⚠ 일괄 삭제 실패: " + ex.Message); }
    }

