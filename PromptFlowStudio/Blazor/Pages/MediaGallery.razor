@* 📅 장중 시간대별 스케줄러 *@
@if (_scheduleOpen)
{
    <div class="gl-modal" @onclick="CloseSchedule">
        <div class="gl-confirm gl-sched" @onclick:stopPropagation="true">
            <div class="gl-confirm-t">📅 StockSuite 장중 스케줄러</div>
            <div class="gl-confirm-d"><span>시간대별 배경 영상을 지정하면 슬롯 파일 복사 + playlist.json · hotreload.trigger 를 동시 갱신합니다.</span></div>
            @foreach (var slot in PromptFlowStudio.Services.Export.StockSuitePlaylistService.DefaultSlots)
            {
                var key = slot.Key;
                <div class="gl-sched-row" @key="key">
                    <div class="gl-sched-lb"><b>@slot.Label</b><span>@slot.Time · @slot.File</span></div>
                    <select class="gl-up-eng" value="@(SlotValue(key))" @onchange="e => SetSlot(key, e.Value?.ToString())" disabled="@_scheduleBusy">
                        <option value="">— 지정 안 함(기존 유지) —</option>
                        @foreach (var m in _items)
                        {
                            <option value="@m.Path">@m.Folder / @m.Name</option>
                        }
                    </select>
                </div>
            }
            @if (_scheduleMsg is not null)
