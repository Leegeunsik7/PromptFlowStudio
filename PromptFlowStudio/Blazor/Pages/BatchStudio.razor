@page "/batch"
@implements IDisposable
@inject BatchProductionService Batch
@inject IWanConfigService Cfg
@inject ILocalMediaService Media
@inject IVideoExportService Export
@inject NavigationManager Nav
@inject PromptFlowStudio.ViewModels.MassProductionViewModel Vm

@* [PromptFlow Studio] 대량 양산 배치 팩토리 — CSV/TXT 대량 입력을 큐로 받아 백그라운드에서 한 편씩 순차 양산.
   상태는 BatchProductionService(싱글턴)가 보유, 이 컴포넌트는 OnChange 구독 후 InvokeAsync(StateHasChanged)로만 갱신. *@

<PageTitle>PromptFlow Studio · 대량 양산</PageTitle>

<div class="bt">
    <header class="bt-head">
        <div class="bt-navrow">
            <button class="bt-back" @onclick='() => Nav.NavigateTo("storyboard")'>← 스토리보드</button>
            <button class="bt-back" @onclick='() => Nav.NavigateTo("")'>홈</button>
            <button class="bt-back" @onclick='() => Nav.NavigateTo("analytics")'>📊 생산성 &amp; 비용 대시보드</button>
            <button class="bt-back" @onclick='() => Nav.NavigateTo("brand-studio")'>🛍️ 커머셜 브랜드 스튜디오</button>
        </div>
        <div class="bt-titlerow">
            <h1 class="bt-title">대량 양산 <span class="bt-title-g">배치 팩토리</span> <MenuHelpBadge MenuKey="@GranularHelpService.Keys.MassProduction" /></h1>
            <span class="bt-ff @(Batch.Enabled ? "ok" : "off")">@(Batch.Enabled ? "● 엔진 준비됨" : "○ 엔진 미구성")</span>
        </div>
        <p class="bt-sub">CSV·TXT 로 <b>수십 편</b>의 숏츠를 한 번에 대기열에 올리고, 백그라운드에서 <b>한 편씩 자동</b>으로 양산합니다 — 대본 분석 → 컷 생성/병합 → 커버 → 메타데이터.</p>
    </header>

    <div style="margin:12px 0 16px;"><StudioMonitorHeader EngineReady="true" /></div>

    @* 엑셀식 배치 그리드 — 셀 수정·검증·CSV/JSON 임포트 후 일괄 큐 등록(공유 배치 큐) *@
    <div style="margin:0 0 16px;"><MassProductionGrid /></div>

    @* 3번 워크플로우 대량 양산 & 비용 — MassProductionViewModel(싱글턴) 바인딩 · 입력 즉시 비용/VRAM 재계산 *@
    <section class="bt-mp">
        <div class="bt-mp-in">
            <textarea class="bt-mp-ta" rows="5" placeholder="한 줄에 프롬프트 하나 — 줄 수만큼 렌더 작업이 생성됩니다"
                      @bind="Vm.PromptInputText" @bind:event="oninput"></textarea>
            <div class="bt-mp-opts">
                <label>해상도
                    <select @bind="Vm.SelectedResolution">
                        <option value="854x480">480p</option>
                        <option value="1280x720">720p</option>
                        <option value="1920x1080">1080p</option>
                        <option value="3840x2160">4K</option>
                    </select>
                </label>
                <label>컷 길이(초) <input type="number" min="1" max="600" step="0.5" @bind="Vm.DurationSec" @bind:event="oninput" /></label>
                <label>FPS <input type="number" min="1" max="120" @bind="Vm.Fps" @bind:event="oninput" /></label>
                <label>시드 <input type="number" @bind="Vm.BaseSeed" /></label>
                <label class="bt-mp-sw"><input type="checkbox" @bind="Vm.IncrementSeed" /> 시드 자동 증분</label>
            </div>
        </div>
        <div class="bt-mp-hud">
            <div><span>총 작업</span><b>@(Vm.JobCount.ToString(System.Globalization.CultureInfo.InvariantCulture))개</b></div>
            <div><span>예상 VRAM</span><b>@Vm.EstimatedVramDisplay</b></div>
            <div><span>총 예상 크레딧</span><b>@(Vm.TotalEstimatedCredits.ToString(System.Globalization.CultureInfo.InvariantCulture))</b></div>
            <div><span>예상 소요</span><b class="bt-mp-time">⏱ @RenderTimeText</b></div>
            <div><span>예상 비용</span><b>$@(PromptFlowStudio.Services.Telemetry.ProductionCostTrackerService.Usd(Vm.EstimatedUsd))</b></div>
        </div>
        @if (Vm.GeneratedJobs.Count > 0)
        {
            <table class="bt-mp-tbl">
                <thead><tr><th>#</th><th>프롬프트</th><th>시드</th><th>해상도</th><th>길이</th><th>상태</th></tr></thead>
                <tbody>
                    @for (var i = 0; i < Vm.GeneratedJobs.Count; i++)
                    {
                        var job = Vm.GeneratedJobs[i];
                        <tr @key="job.JobId">
                            <td>@((i + 1).ToString(System.Globalization.CultureInfo.InvariantCulture))</td>
                            <td class="bt-mp-pr" title="@job.Prompt">@job.Prompt</td>
                            <td>@(job.Seed.ToString(System.Globalization.CultureInfo.InvariantCulture))</td>
                            <td>@job.Resolution</td>
                            <td>@(job.DurationSec.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))초</td>
                            <td><span class="bt-mp-st @(job.Status == PromptFlowStudio.Services.Batch.BatchJobStatus.Queued ? "q" : "")">@job.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <div class="bt-mp-foot">
            <span>렌더 큐 누적 <b>@(Vm.RenderQueue.Count.ToString(System.Globalization.CultureInfo.InvariantCulture))</b>건</span>
            <button class="bt-mp-go" disabled="@(Vm.JobCount == 0)" @onclick="() => DispatchMassProduction(false)">전체 렌더 큐로 디스패치</button>
        </div>
        @if (Vm.BudgetWarning)
        {
            <div class="bt-mp-foot">
                <span>@Vm.BudgetWarningMessage</span>
                <button class="bt-mp-go" @onclick="() => DispatchMassProduction(true)">⚠ 한도 초과 승인 후 디스패치</button>
            </div>
        }
    </section>

    @* v16.16.0 대량 생산 허브 — 테마 다중 선택 일괄 큐 · 우선순위 · 일시정지/재개 · 재시도 · 자원 거버너 *@
    <BatchProductionHub />

    @if (!Batch.Enabled)
    {
        <div class="bt-warn">
            ⚠ 생성 엔진이 구성되지 않았습니다. <button class="bt-warn-link" @onclick='() => Nav.NavigateTo("settings")'>관리자 설정</button> 에서 API 키/엔진을 먼저 등록하세요.
        </div>
    }

    <div class="bt-grid">
        @* ── 좌: 입력/옵션 ── *@
        <section class="bt-panel">
            <h2 class="bt-h2">① 대량 입력</h2>

            @* 파일 드롭존(CSV/TXT) *@
            <div class="bt-drop">
                <InputFile class="bt-drop-input" OnChange="OnFilePicked" accept=".csv,.txt,text/csv,text/plain"
                           disabled="@Batch.IsRunning" />
                <div class="bt-drop-hint">
                    📄 CSV / TXT 파일 <span>(드래그 앤 드롭 · 클릭)</span>
                    <div class="bt-drop-sub">한 줄 = 한 편 · <code>제목,대본</code> 또는 대본만</div>
                </div>
            </div>

            @* 직접 붙여넣기 *@
            <label class="bt-lbl">직접 붙여넣기 <span class="bt-sub2">한 줄에 한 편씩 (제목,대본 · 탭/콤마 구분)</span></label>
            <textarea class="bt-ta" @bind="_paste" @bind:event="oninput" rows="4" disabled="@Batch.IsRunning"
                      placeholder="예)&#10;우주 고양이의 모험,깊은 우주를 여행하는 용감한 고양이 이야기&#10;해변의 아침,잔잔한 파도와 일출의 힐링 풍경"></textarea>
            <div class="bt-inline">
                <button class="bt-tbtn" @onclick="AddFromPaste" disabled="@(Batch.IsRunning || string.IsNullOrWhiteSpace(_paste))">＋ 대기열에 추가</button>
                @if (_addedNote is not null) { <span class="bt-note">@_addedNote</span> }
            </div>

            @* v5.6.5: 생성 전 예상 첫 프레임 시뮬레이터 — 붙여넣은 대본 기반 정체성 프리뷰 *@
            <FirstFramePreviewDeck Prompt="@_paste" MotionStyle="대량 양산" />

            <div class="bt-divider"></div>

            <h2 class="bt-h2">② 공통 양산 옵션</h2>
            <div class="bt-opts">
                <div class="bt-optrow">
                    <label class="bt-lbl">해상도</label>
                    <select class="bt-sel" @bind="_resolution" disabled="@Batch.IsRunning">
                        @foreach (var (val, label) in StoryboardProject.ResolutionPresets)
                        {
                            <option value="@val">@label</option>
                        }
                    </select>
                </div>
                <div class="bt-optrow">
                    <label class="bt-lbl">컷 수 / 편</label>
                    <select class="bt-sel" @bind="_cutCount" disabled="@Batch.IsRunning">
                        <option value="3">3컷</option>
                        <option value="4">4컷</option>
                        <option value="5">5컷</option>
                    </select>
                </div>
                <div class="bt-optrow">
                    <label class="bt-lbl">템포 배속</label>
                    <select class="bt-sel" @bind="_speedStr" disabled="@Batch.IsRunning">
                        @foreach (var (val, label) in StoryboardProject.SpeedPresets)
                        {
                            <option value="@Inv(val)">@label</option>
                        }
                    </select>
                </div>
            </div>

            <div class="bt-checks">
                <label class="bt-chk"><input type="checkbox" @bind="_fade" disabled="@Batch.IsRunning" /> <span>부드러운 전환(페이드)</span></label>
                <label class="bt-chk"><input type="checkbox" @bind="_smartSfx" disabled="@Batch.IsRunning" /> <span>🔊 스마트 사운드 FX</span></label>
                <label class="bt-chk"><input type="checkbox" @bind="_autoCover" disabled="@Batch.IsRunning" /> <span>🖼️ 커버 썸네일 자동</span></label>
                <label class="bt-chk"><input type="checkbox" @bind="_autoMeta" disabled="@Batch.IsRunning" /> <span>🏷️ 메타데이터 자동</span></label>
                <label class="bt-chk"><input type="checkbox" @bind="_offlineTts" disabled="@Batch.IsRunning" /> <span>🎙️ 오프라인 TTS 우선</span></label>
            </div>

            @* 브랜드 워터마크(전 항목 공통) *@
            <div class="bt-wm">
                <label class="bt-lbl">🏷️ 브랜드 워터마크 <span class="bt-sub2">전 항목 우측 상단 로고(투명 PNG 권장 · 선택)</span></label>
                @if (_watermarkPath is not null)
                {
                    <div class="bt-wm-has">
                        <img class="bt-wm-img" src="@_watermarkThumb" alt="워터마크" />
                        <button class="bt-x" @onclick="ClearWatermark" disabled="@Batch.IsRunning" title="워터마크 해제">✕</button>
                    </div>
                }
                else
                {
                    <div class="bt-drop mini">
                        <InputFile class="bt-drop-input" OnChange="OnWatermarkPicked" accept="image/png,image/webp,image/jpeg" disabled="@Batch.IsRunning" />
                        <div class="bt-drop-hint">🏷️ 로고 이미지 <span>(클릭/드래그)</span></div>
                    </div>
                }
            </div>
        </section>

        @* ── 우: 대기열 + 진행 ── *@
        <section class="bt-panel">
            <div class="bt-quehead">
                <h2 class="bt-h2">③ 대기열 <span class="bt-count">@(Batch.TotalCount)편</span></h2>
                <div class="bt-quetools">
                    <button class="bt-mini" @onclick="Batch.ClearFinished" disabled="@(Batch.CompletedCount + Batch.FailedCount == 0)">완료 항목 정리</button>
                    <button class="bt-mini danger" @onclick="Batch.ClearAll" disabled="@(Batch.IsRunning || Batch.TotalCount == 0)">전체 비우기</button>
                </div>
            </div>

            @if (Batch.IsRunning || Batch.OverallPercent > 0)
            {
                <div class="bt-overall">
                    <div class="bt-overall-top">
                        <span>@(Batch.StatusMessage ?? "진행 중…")</span>
                        <span class="bt-overall-pct">@Batch.OverallPercent%</span>
                    </div>
                    <div class="bt-bar"><div class="bt-bar-f" style="width:@(Batch.OverallPercent)%"></div></div>
                    <div class="bt-overall-sum">✅ 완료 @Batch.CompletedCount · ❌ 실패 @Batch.FailedCount · ⏳ 대기 @Batch.QueuedCount</div>
                </div>
            }

            @if (Batch.TotalCount == 0)
            {
                <div class="bt-empty">
                    <div class="bt-empty-ic">🏭</div>
                    <div class="bt-empty-t">대기열이 비어 있습니다</div>
                    <div class="bt-empty-s">왼쪽에서 CSV/TXT 를 올리거나 대본을 붙여넣어 대량으로 추가하세요.</div>
                </div>
            }
            else
            {
                <div class="bt-list">
                    @foreach (var (item, i) in Batch.Items.Select((x, idx) => (x, idx)))
                    {
                        <div class="bt-item @(item.Status == BatchItemStatus.Running ? "run" : null)" @key="item.Id">
                            <div class="bt-item-h">
                                <span class="bt-item-no">@(i + 1)</span>
                                <span class="bt-item-title" title="@item.Script">@(string.IsNullOrWhiteSpace(item.Title) ? "(무제)" : item.Title)</span>
                                <span class="bt-badge @Cls(item.Status)">@Label(item.Status)</span>
                                @if (item.Status == BatchItemStatus.Queued && !Batch.IsRunning)
                                {
                                    <button class="bt-x" @onclick="() => Batch.Remove(item.Id)" title="제거">✕</button>
                                }
                            </div>

                            @if (item.Status == BatchItemStatus.Running)
                            {
                                <div class="bt-item-prog">
                                    <div class="bt-bar sm"><div class="bt-bar-f" style="width:@(item.Percent)%"></div></div>
                                    <span class="bt-item-st">@item.StatusText</span>
                                </div>
                            }
                            else if (item.Status == BatchItemStatus.Completed)
                            {
                                <div class="bt-item-done">
                                    @if (item.CoverPath is not null)
                                    {
                                        <img class="bt-thumb" src="@(Media.ToPlaybackUrl(item.CoverPath) + "?v=" + item.Id)" alt="커버" />
                                    }
                                    <div class="bt-item-links">
                                        <span class="bt-ok">✅ 완료</span>
                                        <button class="bt-mini" @onclick="() => ExportItem(item)">⬇ 내보내기</button>
                                        @if (item.MetadataPath is not null) { <span class="bt-tag">🏷️ 메타데이터 저장됨</span> }
                                    </div>
                                </div>
                            }
                            else if (item.Status is BatchItemStatus.Failed or BatchItemStatus.Skipped)
                            {
                                <div class="bt-item-err">@(item.Error ?? item.StatusText)</div>
                            }
                            else
                            {
                                <div class="bt-item-preview">@Trunc(item.Script)</div>
                            }
                        </div>
                    }
                </div>
            }

            @* ── 실행 컨트롤 ── *@
            <div class="bt-actions">
                @if (!Batch.IsRunning)
                {
                    <button class="bt-go" @onclick="Start" disabled="@(!Batch.Enabled || Batch.QueuedCount == 0)">▶️ 일괄 대량 양산 시작</button>
                }
                else
                {
                    @if (Batch.IsPaused)
                    {
                        <button class="bt-go" @onclick="Batch.Resume">▶️ 재개</button>
                    }
                    else
                    {
                        <button class="bt-pause" @onclick="Batch.Pause" disabled="@Batch.PauseRequested">@(Batch.PauseRequested ? "⏸️ 정지 예약됨…" : "⏸️ 일시정지")</button>
                    }
                    <button class="bt-cancel" @onclick="Batch.Cancel">■ 취소</button>
                }
            </div>
        </section>
    </div>

    @if (_toast is not null)
    {
        <div class="bt-toast">@_toast</div>
    }
</div>

<style>
    .bt { padding: 6px 8px 48px; width: 100%; box-sizing: border-box; }
    .bt-head { margin-bottom: 14px; }
    .bt-navrow { display: flex; gap: 6px; margin-bottom: 8px; }
    .bt-back { font: 700 12px/1 var(--mono); color: var(--text-muted); background: none; border: none; cursor: pointer; padding: 4px 0; }
    .bt-back:hover { color: var(--accent); }
    .bt-titlerow { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
    .bt-title { font-size: 26px; font-weight: 900; letter-spacing: -.4px; color: var(--text-primary); margin: 0; }
    .bt-title-g { background: linear-gradient(90deg, var(--flow-violet), var(--flow-magenta)); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .bt-sub { font-size: 13px; color: var(--text-secondary); margin: 8px 0 0; } .bt-sub b { color: var(--text-primary); }
    .bt-ff { font: 700 10.5px var(--mono); border-radius: 999px; padding: 4px 10px; border: 1px solid var(--line); }
    .bt-ff.ok { color: #10b981; border-color: color-mix(in srgb, #10b981 45%, var(--line)); }
    .bt-ff.off { color: var(--text-muted); }

    .bt-warn { margin: 12px 0; padding: 12px 16px; border-radius: 12px; font-size: 12.5px; line-height: 1.6;
        border: 1px solid color-mix(in srgb, #f5a623 45%, var(--line)); background: color-mix(in srgb, #f5a623 10%, var(--card)); color: var(--text-secondary); }
    .bt-warn-link { font: 700 12.5px inherit; color: var(--accent-2); background: none; border: none; padding: 0; cursor: pointer; text-decoration: underline; }

    .bt-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1.15fr); gap: 16px; align-items: start; }
    @@media (max-width: 900px) { .bt-grid { grid-template-columns: 1fr; } }
    .bt-panel { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 16px; }
    .bt-h2 { font-size: 14px; font-weight: 800; color: var(--text-primary); margin: 0 0 12px; }
    .bt-count { font: 800 11px var(--mono); color: var(--accent-2); margin-left: 6px; }

    .bt-drop { position: relative; border: 1.5px dashed var(--line); border-radius: 12px; padding: 20px 14px; text-align: center; cursor: pointer; transition: border-color .15s, background .15s; background: var(--card-2); }
    .bt-drop:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 6%, var(--card-2)); }
    .bt-drop.mini { padding: 12px; }
    .bt-drop-input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
    .bt-drop-hint { font-size: 13px; font-weight: 700; color: var(--text-secondary); } .bt-drop-hint span { font-weight: 500; color: var(--text-muted); }
    .bt-drop-sub { font-size: 11px; color: var(--text-muted); margin-top: 5px; font-weight: 500; } .bt-drop-sub code { font-family: var(--mono); color: var(--accent-2); }

    .bt-lbl { display: block; font-size: 12px; font-weight: 700; color: var(--text-secondary); margin: 14px 0 6px; }
    .bt-sub2 { font-weight: 500; color: var(--text-muted); }
    .bt-ta { width: 100%; box-sizing: border-box; background: var(--card-2); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; color: var(--text-primary); font-size: 12.5px; font-family: inherit; line-height: 1.6; resize: vertical; }
    .bt-ta:focus { outline: none; border-color: var(--accent); }
    .bt-inline { display: flex; align-items: center; gap: 10px; margin-top: 8px; }
    .bt-note { font-size: 11.5px; color: #10b981; font-weight: 700; }

    .bt-tbtn { font: 700 12.5px inherit; padding: 8px 14px; border-radius: 10px; border: 1px solid var(--line); background: var(--card-2); color: var(--text-secondary); cursor: pointer; }
    .bt-tbtn:hover:not(:disabled) { border-color: var(--accent); color: var(--text-primary); } .bt-tbtn:disabled { opacity: .45; cursor: not-allowed; }

    .bt-divider { height: 1px; background: var(--line); margin: 18px 0; }

    .bt-opts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    @@media (max-width: 560px) { .bt-opts { grid-template-columns: 1fr; } }
    .bt-optrow { display: flex; flex-direction: column; gap: 5px; }
    .bt-optrow .bt-lbl { margin: 0; }
    .bt-sel { border-radius: 10px; border: 1px solid var(--line); background: var(--card-2); color: var(--text-primary); padding: 8px 10px; font-size: 12.5px; font-family: inherit; }
    .bt-sel:focus { outline: none; border-color: var(--accent); }

    .bt-checks { display: flex; flex-wrap: wrap; gap: 8px 16px; margin-top: 14px; }
    .bt-chk { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--text-secondary); cursor: pointer; }
    .bt-chk input { accent-color: var(--accent); }

    .bt-wm { margin-top: 6px; }
    .bt-wm-has { display: inline-flex; align-items: center; gap: 8px; padding: 6px; border: 1px solid var(--line); border-radius: 10px; background: var(--card-2); }
    .bt-wm-img { height: 40px; max-width: 120px; object-fit: contain; border-radius: 4px; background: repeating-conic-gradient(#8884 0% 25%, transparent 0% 50%) 0/12px 12px; }

    .bt-quehead { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 10px; }
    .bt-quehead .bt-h2 { margin: 0; }
    .bt-quetools { display: flex; gap: 6px; }
    .bt-mini { font: 700 11px inherit; padding: 5px 10px; border-radius: 8px; border: 1px solid var(--line); background: var(--card-2); color: var(--text-secondary); cursor: pointer; }
    .bt-mini:hover:not(:disabled) { border-color: var(--accent); color: var(--text-primary); } .bt-mini:disabled { opacity: .4; cursor: not-allowed; }
    .bt-mini.danger:hover:not(:disabled) { border-color: #ef4444; color: #ef4444; }

    .bt-overall { background: var(--card-2); border: 1px solid var(--line); border-radius: 12px; padding: 12px; margin-bottom: 12px; }
    .bt-overall-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 12px; color: var(--text-secondary); font-weight: 700; }
    .bt-overall-pct { font: 800 13px var(--mono); color: var(--accent-2); }
    .bt-overall-sum { font-size: 11.5px; color: var(--text-muted); margin-top: 8px; font-weight: 600; }

    .bt-bar { height: 8px; background: var(--line); border-radius: 999px; overflow: hidden; margin-top: 8px; }
