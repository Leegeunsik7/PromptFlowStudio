    .bt-list { display: flex; flex-direction: column; gap: 8px; max-height: 420px; overflow-y: auto; padding-right: 2px; }
    .bt-item { border: 1px solid var(--line); border-radius: 11px; padding: 10px 12px; background: var(--card-2); }
    .bt-item.run { border-color: color-mix(in srgb, var(--accent) 55%, var(--line)); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 12%, transparent); }
    .bt-item-h { display: flex; align-items: center; gap: 8px; }
    .bt-item-no { font: 800 11px var(--mono); color: var(--text-muted); min-width: 18px; }
    .bt-item-title { flex: 1; min-width: 0; font-size: 13px; font-weight: 700; color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .bt-badge { font: 800 10px var(--mono); border-radius: 999px; padding: 3px 8px; border: 1px solid var(--line); white-space: nowrap; }
    .bt-badge.q { color: var(--text-muted); }
    .bt-badge.r { color: #fff; border-color: transparent; background: linear-gradient(135deg, var(--flow-violet), var(--flow-magenta)); }
    .bt-badge.ok { color: #10b981; border-color: color-mix(in srgb, #10b981 45%, var(--line)); background: color-mix(in srgb, #10b981 10%, transparent); }
    .bt-badge.bad { color: #ef4444; border-color: color-mix(in srgb, #ef4444 45%, var(--line)); background: color-mix(in srgb, #ef4444 10%, transparent); }
    .bt-badge.skip { color: #f5a623; border-color: color-mix(in srgb, #f5a623 45%, var(--line)); background: color-mix(in srgb, #f5a623 10%, transparent); }
    .bt-x { flex: 0 0 auto; width: 24px; height: 24px; border: none; background: none; color: var(--text-muted); cursor: pointer; border-radius: 6px; font-size: 12px; }
    .bt-x:hover { background: color-mix(in srgb, #ef4444 15%, transparent); color: #ef4444; }

    .bt-item-preview { font-size: 11.5px; color: var(--text-muted); margin-top: 6px; line-height: 1.5; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    .bt-item-prog { display: flex; align-items: center; gap: 10px; margin-top: 8px; }
    .bt-item-prog .bt-bar { flex: 1; }
    .bt-item-st { font: 700 10.5px var(--mono); color: var(--accent-2); white-space: nowrap; }
    .bt-item-done { display: flex; align-items: center; gap: 10px; margin-top: 8px; }
    .bt-thumb { height: 46px; border-radius: 6px; border: 1px solid var(--line); }
    .bt-item-links { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .bt-ok { font-size: 12px; font-weight: 700; color: #10b981; }
    .bt-tag { font: 700 10px var(--mono); color: var(--text-muted); }
    .bt-item-err { font-size: 11.5px; color: #ef4444; margin-top: 6px; line-height: 1.5; }

    .bt-actions { display: flex; gap: 8px; margin-top: 14px; }
    .bt-go { flex: 1; font: 800 13.5px inherit; padding: 12px; border-radius: 12px; border: none; color: #fff; cursor: pointer;
        background: linear-gradient(135deg, var(--flow-violet), var(--flow-magenta)); box-shadow: 0 6px 18px color-mix(in srgb, var(--flow-magenta) 28%, transparent); }
    .bt-go:hover:not(:disabled) { filter: brightness(1.07); } .bt-go:disabled { opacity: .45; cursor: not-allowed; box-shadow: none; }
    .bt-pause { flex: 1; font: 800 13px inherit; padding: 12px; border-radius: 12px; border: 1px solid var(--line); background: var(--card-2); color: var(--text-primary); cursor: pointer; }
    .bt-pause:hover:not(:disabled) { border-color: #f5a623; color: #f5a623; } .bt-pause:disabled { opacity: .6; }
    .bt-cancel { font: 800 13px inherit; padding: 12px 18px; border-radius: 12px; border: 1px solid color-mix(in srgb, #ef4444 45%, var(--line)); background: none; color: #ef4444; cursor: pointer; }
    .bt-cancel:hover { background: color-mix(in srgb, #ef4444 12%, transparent); }

    .bt-toast { position: fixed; bottom: 22px; left: 50%; transform: translateX(-50%); z-index: 90; background: var(--card); border: 1px solid var(--line);
        color: var(--text-primary); padding: 11px 18px; border-radius: 12px; font-size: 12.5px; font-weight: 600; box-shadow: 0 12px 32px rgba(0,0,0,.32); max-width: 82vw; }

    /* 3번 워크플로우 대량 양산 & 비용(MassProductionViewModel) */
    .bt-mp { display: flex; flex-direction: column; gap: 10px; margin: 0 0 16px; padding: 12px; background: var(--card); border: 1px solid var(--line); border-radius: 12px; }
    .bt-mp-ta { width: 100%; box-sizing: border-box; resize: vertical; background: var(--card-2); border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; color: var(--text-primary); font: 13px/1.5 inherit; }
    .bt-mp-ta:focus { outline: none; border-color: var(--accent); }
    .bt-mp-opts { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px; font-size: 12px; color: var(--text-secondary); }
    .bt-mp-opts label { display: flex; align-items: center; gap: 6px; }
    .bt-mp-opts select, .bt-mp-opts input[type=number] { font: 600 12px inherit; width: 90px; background: var(--card-2); color: var(--text-primary); border: 1px solid var(--line); border-radius: 8px; padding: 4px 6px; }
    .bt-mp-hud { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .bt-mp-hud div { display: flex; flex-direction: column; gap: 4px; padding: 8px 10px; border-radius: 10px; background: var(--card-2); border: 1px solid var(--line); }
    .bt-mp-hud span { font-size: 11px; color: var(--text-muted); }
    .bt-mp-hud b { font: 800 15px/1 var(--mono); color: var(--text-primary); }
    .bt-mp-time { color: var(--accent) !important; }
    .bt-mp-tbl { width: 100%; border-collapse: collapse; font-size: 12px; }
    .bt-mp-tbl th, .bt-mp-tbl td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--line); color: var(--text-secondary); }
    .bt-mp-tbl th { color: var(--text-muted); font-weight: 700; }
    .bt-mp-pr { max-width: 360px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-primary) !important; }
    .bt-mp-st { font: 700 11px/1 inherit; padding: 3px 8px; border-radius: 999px; border: 1px solid var(--line); }
    .bt-mp-st.q { color: #059669; border-color: color-mix(in srgb, #10b981 40%, var(--line)); }
    .bt-mp-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; font-size: 13px; color: var(--text-secondary); }
    .bt-mp-foot b { color: var(--text-primary); }
    .bt-mp-go { font: 800 13px inherit; padding: 10px 16px; border-radius: 10px; border: none; background: var(--accent); color: #fff; cursor: pointer; }
    .bt-mp-go:disabled { opacity: .45; cursor: not-allowed; }
</style>

@code {
    // ── 옵션 상태 ──
    private string _resolution = "1080x1920";
    private int _cutCount = 5;
    private string _speedStr = "1";
    private bool _fade;
    private bool _smartSfx;
    private bool _autoCover = true;
    private bool _autoMeta = true;
    private bool _offlineTts;
    private string? _watermarkPath;
    private string? _watermarkThumb;

    private string _paste = "";
    private string? _addedNote;
    private string? _toast;
    private System.Threading.Timer? _toastTimer;

    protected override void OnInitialized()
    {
        Batch.OnChange += OnStateChanged;
        Batch.OnCompleted += OnBatchCompleted;
        Cfg.OnConfigChanged += OnStateChanged;
        Vm.PropertyChanged += OnMassProductionChanged;   // 3번 워크플로우 비용/VRAM HUD · 작업 미리보기
    }

    // ── 3번 워크플로우 대량 양산 & 비용(MassProductionViewModel) ──
    private string RenderTimeText
    {
        get
        {
            var sec = Vm.EstimatedRenderTimeSec;
            if (sec < 60) return sec.ToString("0", System.Globalization.CultureInfo.InvariantCulture) + "초";
            if (sec < 3600) return (sec / 60).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) + "분";
            return (sec / 3600).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) + "시간";
        }
    }
    private void OnMassProductionChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e) => _ = InvokeAsync(StateHasChanged);
    private void DispatchMassProduction(bool approveOverBudget)
    {
        var n = Vm.DispatchAllToRenderQueue(approveOverBudget);
        ShowToast(n > 0 ? "🚀 렌더 큐로 " + n.ToString(System.Globalization.CultureInfo.InvariantCulture) + "건 디스패치 완료"
            : Vm.BudgetWarning ? "💸 예산 한도 초과 — 승인 후 진행하세요" : "디스패치할 프롬프트가 없습니다");
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    private void OnBatchCompleted() => InvokeAsync(() =>
    {
        ShowToast($"🏭 대량 양산 종료 — 성공 {Batch.CompletedCount} · 실패 {Batch.FailedCount}");
        StateHasChanged();
    });

    // ── 입력 ──
    private async Task OnFilePicked(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        const long maxSize = 5L * 1024 * 1024;   // 5MB
        if (file.Size > maxSize) { ShowToast("❌ 파일이 너무 큽니다(최대 5MB)."); return; }
        try
        {
            string text;
            await using (var s = file.OpenReadStream(maxSize))
            using (var reader = new System.IO.StreamReader(s, System.Text.Encoding.UTF8))
                text = await reader.ReadToEndAsync();

            var added = Batch.ImportFromText(text);
            _addedNote = added > 0 ? $"＋{added}편 추가됨" : null;
            ShowToast(added > 0 ? $"📄 {file.Name} — {added}편을 대기열에 추가했습니다." : "추가할 항목을 찾지 못했습니다(빈 파일).");
        }
        catch (Exception ex) { ShowToast("❌ 파일 읽기 실패: " + ex.Message); }
    }

    private void AddFromPaste()
    {
        var added = Batch.ImportFromText(_paste);
        if (added > 0)
        {
            _paste = "";
            _addedNote = $"＋{added}편 추가됨";
            ShowToast($"＋ {added}편을 대기열에 추가했습니다.");
        }
        else ShowToast("추가할 항목을 찾지 못했습니다.");
    }

    // ── 실행 ──
    private async Task Start()
    {
        var opt = new BatchOptions
        {
            Resolution = _resolution,
            CutCount = _cutCount,
            Speed = ParseSpeed(_speedStr),
            Fade = _fade,
            SmartSfx = _smartSfx,
            AutoCover = _autoCover,
            AutoMetadata = _autoMeta,
            UseOfflineTts = _offlineTts,
            WatermarkPath = _watermarkPath,
        };
        await Batch.StartAsync(opt);
    }

    private async Task ExportItem(BatchItem item)
    {
        if (item.FinalVideoPath is null) return;
        try
        {
            var saved = await Export.ExportAsync(item.FinalVideoPath, item.Title);
            ShowToast(saved is not null ? $"✅ 내보내기 — {saved}" : "내보내기를 취소했습니다.");
        }
        catch (Exception ex) { ShowToast("❌ 내보내기 실패: " + ex.Message); }
    }

    // ── 워터마크 ──
    private async Task OnWatermarkPicked(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        const long maxSize = 8L * 1024 * 1024;
        if (file.Size > maxSize) { ShowToast("❌ 워터마크 이미지가 너무 큽니다(최대 8MB)."); return; }
        try
        {
            var dir = System.IO.Path.Combine(Media.MediaRoot, "_uploads", "watermark");
            System.IO.Directory.CreateDirectory(dir);
            var name = SanitizeFileName(file.Name);
            if (string.IsNullOrWhiteSpace(System.IO.Path.GetExtension(name))) name += ".png";
            var savePath = System.IO.Path.Combine(dir, name);

            await using (var src = file.OpenReadStream(maxSize))
            await using (var dst = new System.IO.FileStream(savePath, System.IO.FileMode.Create, System.IO.FileAccess.Write, System.IO.FileShare.None, 81920, System.IO.FileOptions.Asynchronous))
                await src.CopyToAsync(dst);

            _watermarkPath = savePath;
            _watermarkThumb = Media.ToPlaybackUrl(savePath) + "?v=" + DateTime.Now.Ticks;
            ShowToast($"🏷️ 워터마크 등록됨 — {name}");
        }
        catch (Exception ex) { ShowToast("❌ 워터마크 추가 실패: " + ex.Message); }
    }

    private void ClearWatermark()
    {
        _watermarkPath = null;
        _watermarkThumb = null;
    }

    // ── 유틸 ──
    private static string Inv(double d) => d.ToString(System.Globalization.CultureInfo.InvariantCulture);
    private static double ParseSpeed(string s) =>
        double.TryParse(s, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 1.0;

    private static string SanitizeFileName(string n)
    {
        foreach (var c in System.IO.Path.GetInvalidFileNameChars()) n = n.Replace(c, '_');
        return n;
    }

    private static string Trunc(string s)
    {
        s = (s ?? "").Replace('\n', ' ').Replace('\r', ' ').Trim();
        return s.Length <= 120 ? s : s[..120] + "…";
    }

    private static string Label(BatchItemStatus s) => s switch
    {
        BatchItemStatus.Queued => "대기",
        BatchItemStatus.Running => "생성중",
        BatchItemStatus.Completed => "완료",
        BatchItemStatus.Failed => "실패",
        BatchItemStatus.Skipped => "건너뜀",
        _ => "",
    };

    private static string Cls(BatchItemStatus s) => s switch
    {
        BatchItemStatus.Queued => "q",
        BatchItemStatus.Running => "r",
        BatchItemStatus.Completed => "ok",
        BatchItemStatus.Failed => "bad",
        BatchItemStatus.Skipped => "skip",
        _ => "q",
    };

    private void ShowToast(string msg)
    {
        _toast = msg;
        _toastTimer?.Dispose();
        _toastTimer = new System.Threading.Timer(_ => InvokeAsync(() => { _toast = null; StateHasChanged(); }), null, 3600, System.Threading.Timeout.Infinite);
        StateHasChanged();
    }

    public void Dispose()
    {
        Batch.OnChange -= OnStateChanged;
        Batch.OnCompleted -= OnBatchCompleted;
        Cfg.OnConfigChanged -= OnStateChanged;
        Vm.PropertyChanged -= OnMassProductionChanged;
        _toastTimer?.Dispose();
    }
}
