@page "/settings"
@using PromptFlowStudio.Services.Account
@inject SessionState Session
@inject MemberRegistryService Members
@inject NavigationManager Nav
@inject PromptFlowStudio.Services.Pluto.IPlutoDriveHealthService DriveHealth
@inject PromptFlowStudio.Services.Pluto.IPlutoSystemDiagnosticService PlutoDiagnostics
@inject PromptFlowStudio.Services.Pluto.IPlutoFlywheelSelfTestService FlywheelSelfTest
@inject PromptFlowStudio.Services.Platform.IClipboardService Clipboard
@inject PromptFlowStudio.Services.Pluto.IPlutoYouTubeApiSyncService YouTubeApi
@using PromptFlowStudio.Services.Pluto
@using System.Globalization

@* [PromptFlowStudio] 관리자 설정 — 사이드바에서 진입하는 관리자 전용 화면(진입 시 관리자 비밀번호 게이트). 탭 구성:
     [회원·권한] 회원 RBAC 관리 · [메일(SMTP)] 발송 서버(암호화 저장) · [설치 PC] 배포자 수집 정보
     [라이선스] 발급 목록 · [보안·배포] 올인원 인스톨러/단일 EXE · [관리자 명부] 관리자 자격
   ⚠ 일반 사용자 설정(임계·경보·테마)은 별도 <사용자 설정>(/user-settings)으로 분리했다.
   모니터링 오토메이션(SoundStack) 관리 센터 기능 이식. MainLayout(사이드바) 안에서 렌더. *@

<PageTitle>PromptFlow Studio · 관리자 설정</PageTitle>

@* ★ [관리자 설정 진입 게이트] 잠금 해제 전에는 관리자 비밀번호만 요구한다.
     들어올 때마다 다시 묻는다(_unlocked 는 페이지 재진입 시 false 로 시작). *@
@if (!_unlocked)
{
    <div class="st-gatewrap">
        <div class="st-gate">
            <div class="st-gate-ic">🔒</div>
            <h1 class="st-gate-t">관리자 설정</h1>
            <div class="st-gate-d">이 화면은 <b>관리자 비밀번호</b>가 필요합니다. 관리자(Admin) 계정의 비밀번호를 입력하세요.</div>
            <input class="st-gate-in" type="password" placeholder="관리자 비밀번호"
                   @bind="_pwInput" @bind:event="oninput" @onkeydown="OnGateKey" />
            @if (_pwErr is { Length: > 0 }) { <div class="st-gate-e" role="alert">⚠ @_pwErr</div> }
            <button class="st-gate-b" @onclick="TryUnlock">🔓 잠금 해제</button>
            <div class="st-gate-hint">💡 테스트 계정(ANG)은 관리자 설정에 들어올 수 없습니다.</div>
        </div>
    </div>
}
else
{
<div class="st">
    <header class="st-head">
        <div><h1 class="st-title">⚙️ 관리자 설정</h1><HelpHint /><div class="st-sub">회원·권한 · 메일 발송 · 설치 PC · 라이선스 · 관리자 명부</div></div>
    </header>

    @* ── 탭 바 ── *@
    <nav class="st-tabs">
        <button class="st-tab @(_tab == Tab.Members ? "on" : null)" @onclick="() => _tab = Tab.Members">👥 회원·권한</button>
        <button class="st-tab @(_tab == Tab.Mail ? "on" : null)" @onclick="() => _tab = Tab.Mail">📧 메일(SMTP)</button>
        <button class="st-tab @(_tab == Tab.Video ? "on" : null)" @onclick="() => _tab = Tab.Video">🎬 영상(Wan)</button>
        <button class="st-tab @(_tab == Tab.Engines ? "on" : null)" @onclick="() => _tab = Tab.Engines">🤖 AI 엔진</button>
        <button class="st-tab @(_tab == Tab.Gemini ? "on" : null)" @onclick="() => _tab = Tab.Gemini">🔑 Gemini AI</button>
        <button class="st-tab @(_tab == Tab.KeyVault ? "on" : null)" @onclick="() => _tab = Tab.KeyVault">🗝️ 키 볼트</button>
        <button class="st-tab @(_tab == Tab.InstallPc ? "on" : null)" @onclick="() => _tab = Tab.InstallPc">💻 설치 PC</button>
        <button class="st-tab @(_tab == Tab.License ? "on" : null)" @onclick="() => _tab = Tab.License">🪪 라이선스 관리</button>
        <button class="st-tab @(_tab == Tab.Deploy ? "on" : null)" @onclick="() => _tab = Tab.Deploy">🚀 보안·배포</button>
        <button class="st-tab @(_tab == Tab.Admins ? "on" : null)" @onclick="() => _tab = Tab.Admins">🛡️ 관리자 명부</button>
    </nav>

    @if (!Session.IsAdmin)
    {
        <div class="st-lock">🔒 관리자(Admin) 권한이 필요한 기능입니다. 현재 권한: <b>@Session.Role</b> · Admin 계정(GSLEE)으로 로그인하세요.</div>
    }
    else if (_tab == Tab.Members)
    {
        @* 사이드바에서 옮겨 온 <회원·라이선스 관리> — 회원 표는 이 컴포넌트 한 곳에만 있다. *@
        <MemberAdminPanel />
    }
    else if (_tab == Tab.Mail)
    {
        <SmtpSettingsPanel />
    }
    else if (_tab == Tab.Video)
    {
        <WanSettingsPanel />
    }
    else if (_tab == Tab.Engines)
    {
        @* 4대 오픈소스 AI 엔진(TTS/업스케일/STT/립싱크) 실행 파일 경로·인자 설정 + 연결 진단. *@
        <EngineSettingsPanel />

        @* ☁️ Google Drive 영구 백업 헬스(Pluto 핵심 허브 9종 + 계정·설정 2종)(PC 이전 준비) — 존재 · 크기 · JSON 파싱 검증 + 미러 오류 노출. *@
        <section class="dh">
            <div class="dh-head">
                <div>
                    <div class="dh-title">☁️ Google Drive 영구 백업 · PC 이전 준비 상태</div>
                    @if (_drive is { } rep)
                    {
                        <div class="dh-sum @(rep.HealthyCount == rep.TotalCount ? "ok" : "warn")">
                            @(rep.HealthyCount)/@(rep.TotalCount) 파일 정상 동기화 · @(rep.IsDriveMounted ? "드라이브 연결됨" : "드라이브 미연결") · 점검 @(rep.CheckedAtUtc.ToLocalTime().ToString("HH:mm:ss", CultureInfo.InvariantCulture))
                        </div>
                    }
                </div>
                <button class="dh-btn" disabled="@_driveBusy" @onclick="VerifyDriveAsync">@(_driveBusy ? "⏳ 검증 중…" : "🔄 지금 전체 드라이브 백업 검증")</button>
                <button class="dh-btn" data-pluto-diagnostic-copy="1" disabled="@_diagBusy" @onclick="CopyPlutoDiagnosticAsync" title="9 허브 Drive 동기화 · 충돌 · 실측 YouTube · 기획 적중률 · 4축 파레토 · 오답 노트 가드(감쇠 잔여 벌점)를 Markdown 으로 복사 — 절대 경로는 파일명만 남김">@(_diagBusy ? "⏳ 진단 수집 중…" : "[🩺 플루토 진단 리포트 복사]")</button>
                <button class="dh-btn" data-pluto-diagnostic-save="1" disabled="@_diagBusy" @onclick="SavePlutoDiagnosticFileAsync" title="같은 진단 리포트를 로컬 앱 데이터 진단 폴더에 pluto_diagnostic_날짜_시각.md(UTF-8)로 원자 저장 — 기존 파일 · 폴더 · 링크는 덮지 않음 · 절대 경로는 파일명만 남김">@(_diagBusy ? "⏳ 진단 수집 중…" : "[💾 진단서 파일 저장(.md)]")</button>
            </div>
            @if (_drive?.LiveProbe is { } lp)
            {
                <div class="dh-sum @(lp.Attempted && !lp.Ok ? "warn" : "ok")" data-drive-live-probe="@(lp.Attempted ? (lp.Ok ? "ok" : "fail") : "skip")" data-drive-live-probe-ms="@(lp.RoundTripMs.ToString("0.0", CultureInfo.InvariantCulture))">🩺 @(lp.StatusKorean)</div>
            }
            @* ⚔️ 두 PC 분기 충돌 — 덮이기 전에 보관된 오프라인 사본 · 병합/복원은 해당 허브를 실행 중 즉시 재적재(재시작 불필요 · 재적재 불가 허브만 다음 실행 때 적용) *@
            <div class="dh-conflicts" data-drive-conflicts="@(_conflicts.Count.ToString(CultureInfo.InvariantCulture))">
                <div class="dh-sum @(_conflicts.Count == 0 ? "ok" : "warn")">⚔️ 동기화 충돌 @(_conflicts.Count.ToString(CultureInfo.InvariantCulture))건@(_pendingResolutions > 0 ? " · 📥 적용 대기 " + _pendingResolutions.ToString(CultureInfo.InvariantCulture) + "건(다음 실행 시 반영)" : "")</div>
                @foreach (var c in _conflicts)
                {
                    var cRef = c;
                    <div class="dh-conflict" data-drive-conflict="@(c.FileName)">
                        <span>@(c.HubFileName) · @(c.CapturedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)) · @(FormatSize(c.SizeBytes))@(c.IsValidJson ? "" : " · ❌ 손상")</span>
                        @if (c.IsMergeable && c.IsValidJson) { <button class="dh-btn" data-conflict-merge="1" disabled="@_driveBusy" @onclick="() => ResolveConflict(cRef, 1)" title="두 PC 의 기록을 키 단위로 합칩니다(어느 쪽 항목도 버리지 않음)">🔀 병합</button> }
                        @if (c.IsValidJson) { <button class="dh-btn" data-conflict-restore="1" disabled="@_driveBusy" @onclick="() => ResolveConflict(cRef, 2)" title="현재 기록 대신 이 오프라인 사본을 사용합니다">↩️ 이 사본으로 복원</button> }
                        <button class="dh-btn" data-conflict-dismiss="1" disabled="@_driveBusy" @onclick="() => ResolveConflict(cRef, 3)" title="사본을 지우고 현재 기록을 유지합니다">🗑️ 무시</button>
                    </div>
                }
                @if (_diagToast is { } dgt) { <div class="dh-sum" role="status" data-pluto-diagnostic-toast="1">@(dgt)</div> }
                @if (_conflictToast is { } ct) { <div class="dh-err" role="status" data-conflict-toast="1">@(ct)</div> }
            </div>
            @if (_drive is { } r2)
            {
                @if (!string.IsNullOrEmpty(r2.SettingsMirrorError))
                {
                    <div class="dh-err" role="alert">⚠️ 설정 미러 오류(user_settings.json): @r2.SettingsMirrorError</div>
                }
                @if (!string.IsNullOrEmpty(r2.MemberMirrorError))
                {
                    <div class="dh-err" role="alert">⚠️ 회원 원장 미러 오류(members.json): @r2.MemberMirrorError</div>
                }
                <div class="dh-list">
                    @foreach (var it in r2.Items)
                    {
                        <div class="dh-row" title="@(it.FullPath)">
                            <span class="dh-badge s@((int)it.Status)">@BadgeText(it.Status)</span>
                            <span class="dh-name">@it.FileName</span>
                            <span class="dh-cat">@it.Category</span>
                            <span class="dh-size">@FormatSize(it.SizeBytes)</span>
                            <span class="dh-time">@(it.LastModifiedUtc is { } t ? t.ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) : "—")</span>
                            @if (!string.IsNullOrEmpty(it.ErrorDetail)) { <span class="dh-detail">@it.ErrorDetail</span> }
                        </div>
                    }
                </div>
                @* 🔁 Step 30 — 동반 동기화 파일 2종(핵심 허브 9종 집계 밖) — 로컬/Drive 존재 · SHA-256 일치 · 항목 수 *@
                <div class="dh-companions" data-drive-companions="@(r2.CompanionInSyncCount.ToString(CultureInfo.InvariantCulture))/@(r2.Companions.Count.ToString(CultureInfo.InvariantCulture))">
                    <div class="dh-sum @(AllCompanionsHealthy(r2) ? "ok" : "warn")">@(r2.CompanionSummaryKorean)</div>
                    @foreach (var cp in r2.Companions)
                    {
                        <div class="dh-row" data-drive-companion="@(cp.FileName)" data-companion-state="@(cp.State.ToString())">
                            <span class="dh-badge @(cp.IsHealthy ? "s0" : "s2")">@(cp.StateKorean)</span>
                            <span class="dh-name">@(cp.FileName)</span>
                            <span class="dh-cat">로컬 @(cp.LocalPresent ? "✔" : "—") · Drive @(cp.DrivePresent ? "✔" : "—")</span>
                            <span class="dh-size">@(cp.EntryCount.ToString(CultureInfo.InvariantCulture))건</span>
                            <span class="dh-time">@(cp.DriveSha256 is { Length: >= 12 } dsha ? dsha.Substring(0, 12) : "—")</span>
                            @if (!string.IsNullOrEmpty(cp.ErrorDetail)) { <span class="dh-detail">@(PromptFlowStudio.Services.Pluto.PlutoSystemDiagnosticService.RedactPaths(cp.ErrorDetail))</span> }
                        </div>
                    }
                </div>
            }
            @* 🧪 Step 30 — 샌드박스 1클릭 7단계 플라이휠 자가진단(임시 폴더 · 네트워크 0 · 라이브 상태/Drive 무접촉) *@
            <div class="dh-selftest" data-flywheel-selftest="@(_selfTest is { } stx ? (stx.AllPassed ? "pass" : "fail") : "idle")">
                <button class="dh-btn" data-flywheel-selftest-run="1" disabled="@_selfTestBusy" @onclick="RunFlywheelSelfTestAsync" title="격리 임시 폴더에서 토픽 플래너 → 기획 출처 → 업로드 패키지 · 연결성 → Studio 내보내기 정규화 · 연결 → 기획 채점 · 사후 분석 → 유기적 복권 · 멀티 PC 장부 재생 → 진단 Markdown 7단계를 실행하고 끝나면 임시 폴더를 지웁니다 — 실제 학습 데이터 · Google Drive 는 건드리지 않음">@(_selfTestBusy ? "⏳ 자가진단 실행 중…" : "[🧪 플라이휠 자가진단 실행]")</button>
                @if (_selfTest is { } st)
                {
                    <div class="dh-sum @(st.AllPassed ? "ok" : "warn")" role="status">@(st.SummaryKorean)</div>
                    @foreach (var sg in st.Stages)
                    {
                        <div class="dh-row" data-flywheel-stage="@(sg.Index.ToString(CultureInfo.InvariantCulture))" data-flywheel-stage-status="@(sg.StatusLabel)">
                            <span class="dh-badge @(sg.Passed ? "s0" : sg.Skipped ? "s3" : "s2")">@(sg.Passed ? "✅ PASS" : sg.Skipped ? "⏭ SKIP" : "❌ FAIL")</span>
                            <span class="dh-name">@(sg.Index.ToString(CultureInfo.InvariantCulture)). @(sg.Name)</span>
                            <span class="dh-cat">@(sg.Detail)</span>
                            <span class="dh-size">@(sg.ElapsedMs.ToString("0.0", CultureInfo.InvariantCulture))ms</span>
                            <span class="dh-time"></span>
                        </div>
                    }
                }
                @if (_selfTestError is { } ste) { <div class="dh-err" role="alert">@(ste)</div> }
            </div>
        </section>

        @* 🔄 Step 33 — YouTube Data API v3 연동(🔐 이 PC 전용 봉인 · Drive 미동기화 · 빈 칸 저장 = 기존 값 유지 · 비밀값은 다시 표시하지 않음) *@
        <section class="dh" data-yt-api-card="1">
            <div class="dh-head">
                <div>
                    <div class="dh-title">🔄 YouTube Data API v3 연동</div>
                    @if (_ytApi is { } ya)
                    {
                        <div class="dh-sum @(ya.IsConfigured ? "ok" : "warn")" data-yt-api-status="@(ya.IsConfigured ? (ya.IsNetworkAllowed ? "ready" : "isolated") : "unset")">
                            @(ya.AuthMode) · @(ya.MaskedCredential) · 채널 @(ya.ChannelCount.ToString(CultureInfo.InvariantCulture))개 · 쿼터 @(ya.QuotaUnitsUsedToday.ToString(CultureInfo.InvariantCulture))/@(ya.DailyUnitBudget.ToString(CultureInfo.InvariantCulture)) unit(태평양 일 기준)@(ya.CooldownUntilUtc is { } cd ? " · ⏸ 냉각 ~" + cd.ToLocalTime().ToString("MM-dd HH:mm", CultureInfo.InvariantCulture) : "") · 마지막 동기화 @(ya.LastSyncUtc is { } ls ? ls.ToLocalTime().ToString("MM-dd HH:mm", CultureInfo.InvariantCulture) : "—")
                        </div>
                        @if (!string.IsNullOrEmpty(ya.LastSummaryKorean)) { <div class="dh-sum" data-yt-api-last="1">@(ya.LastSummaryKorean)</div> }
                    }
                </div>
                <button class="dh-btn" data-yt-api-test="1" disabled="@(_ytApiBusy || _ytApi?.IsConfigured != true)" @onclick="TestYouTubeApiAsync" title="channels.list 1회(1 unit)로 채널 · 업로드 재생목록 확인">@(_ytApiBusy ? "⏳ 확인 중…" : "[🔌 연결 테스트]")</button>
                <button class="dh-btn" data-yt-api-disconnect="1" disabled="@(_ytApiBusy || _ytApi?.IsConfigured != true)" @onclick="DisconnectYouTubeApiAsync" title="봉인 파일을 덮어쓴 뒤 삭제하고 리프레시 토큰 폐기를 요청합니다">🗑️ 연결 해제 · 자격 증명 삭제</button>
            </div>
            <div class="dh-ytapi">
                <input type="password" autocomplete="off" data-yt-api-key="1" @bind="_ytApiKey" placeholder="API 키(읽기 전용 · 공개 통계)" />
                <input type="text" autocomplete="off" data-yt-api-client-id="1" @bind="_ytClientId" placeholder="OAuth 클라이언트 ID(선택)" />
                <input type="password" autocomplete="off" data-yt-api-client-secret="1" @bind="_ytClientSecret" placeholder="OAuth 클라이언트 시크릿(선택)" />
                <input type="password" autocomplete="off" data-yt-api-refresh="1" @bind="_ytRefreshToken" placeholder="OAuth 리프레시 토큰(선택 · 자동 갱신)" />
                <textarea rows="2" spellcheck="false" data-yt-api-channels="1" @bind="_ytChannels" placeholder="채널 ID(줄마다 · 선택 로캘) 예: UCxxxxxxxxxxxxxxxxxxxxxx=ko-KR&#10;UCyyyyyyyyyyyyyyyyyyyyyy=ja-JP"></textarea>
                <button class="dh-btn" data-yt-api-save="1" disabled="@_ytApiBusy" @onclick="SaveYouTubeApiAsync">🔐 암호화 저장</button>
            </div>
            @if (_ytApiToast is { } yat) { <div class="dh-sum" role="status" data-yt-api-toast="1">@(yat)</div> }
        </section>
    }
    else if (_tab == Tab.Gemini)
    {
        @* Gemini AI API 키 간편 등록 + 연결 검증(핑) — 7대 Gemini 디렉터/자율 에이전시 기능의 열쇠. *@
        <GeminiSettingsPanel />
    }
    else if (_tab == Tab.KeyVault)
    {
        @* v15.11.0 다중 클라우드 Key Vault(DashScope/SiliconFlow/Custom 다중 키 · 입력 즉시 반영). *@
        <AdminSettings Embedded="true" />
    }
    else if (_tab == Tab.InstallPc)
    {
        <InstallPcPanel />
    }
    else if (_tab == Tab.License)
    {
        @* 시리얼 라이선스 발급/명부 관리(XXXX-XXXX · Used/Unused). *@
        <LicenseSettingsPanel />
    }
    else if (_tab == Tab.Deploy)
    {
        @* 보안 배포 · 올인원 인스톨러 & 단일 EXE 패키징 집행(발급자 PC 전용). *@
        <DeployPackagerPanel />
    }
    else if (_tab == Tab.Admins)
    {
        <AdminRosterPanel />
    }
</div>
}

<style>
    .dh-ytapi{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:8px;margin-top:10px}
    .dh-ytapi input,.dh-ytapi textarea{font:12px/1.4 var(--mono,monospace);padding:7px 9px;border-radius:8px;border:1px solid var(--line,rgba(148,163,184,.25));background:transparent;color:inherit;min-width:0}
    .dh-ytapi textarea{grid-column:1/-1;resize:vertical}
    .st{padding:22px 26px 40px;max-width:980px;color:var(--ink,#e6eefc)}
    .st-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:16px}
    .st-title{font-size:22px;font-weight:800;margin:0;color:var(--ink,#f1f6ff)}
    .st-sub{font-size:13px;color:var(--sub,#93a3b8);margin-top:4px}
    /* 탭 바 */
    .st-tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:18px;border-bottom:1px solid var(--line,rgba(148,163,184,.18));padding-bottom:2px}
    .st-tab{appearance:none;border:0;background:transparent;cursor:pointer;font-family:inherit;font-size:13px;font-weight:700;color:var(--sub,#93a3b8);padding:9px 14px;border-radius:10px 10px 0 0;border-bottom:2px solid transparent;transition:color .14s ease,border-color .14s ease,background .14s ease}
    .st-tab:hover{color:var(--ink,#e6eefc);background:color-mix(in srgb,var(--accent,#f59e0b) 7%,transparent)}
    .st-tab.on{color:var(--accent,#f59e0b);border-bottom-color:var(--accent,#f59e0b);background:color-mix(in srgb,var(--accent,#f59e0b) 10%,transparent)}
    .st-lock{padding:16px 18px;border-radius:12px;background:color-mix(in srgb,var(--down,#dc2626) 12%,transparent);border:1px solid color-mix(in srgb,var(--down,#dc2626) 40%,transparent);color:var(--down,#f87171);font-size:13.5px;line-height:1.6}
    .st-lock b{color:var(--ink,#e6eefc)}
    /* ── 관리자 설정 진입 게이트(관리자 비밀번호) — 콘텐츠 영역 정중앙 ── */
    .st-gatewrap{display:grid;place-items:center;width:100%;min-height:calc(100vh - 64px);box-sizing:border-box;padding:24px}
    .st-gate{max-width:420px;width:100%;text-align:center;background:var(--card,#111a2e);border:1px solid var(--line,rgba(148,163,184,.18));border-radius:18px;padding:34px 30px;box-shadow:0 20px 60px rgba(0,0,0,.35)}
    .st-gate-ic{font-size:38px;line-height:1;margin-bottom:12px}
    .st-gate-t{font-size:20px;font-weight:800;margin:0 0 8px;color:var(--ink,#f1f6ff)}
    .st-gate-d{font-size:13px;color:var(--sub,#93a3b8);line-height:1.6;margin-bottom:18px}
    .st-gate-d b{color:var(--accent,#fbbf24)}
    .st-gate-in{width:100%;box-sizing:border-box;text-align:center;letter-spacing:.15em;background:rgba(8,13,24,.6);border:1px solid var(--line,rgba(148,163,184,.28));border-radius:11px;padding:12px 14px;color:var(--ink,#e6eefc);font-size:15px;font-family:inherit;outline:none}
    .st-gate-in:focus{border-color:var(--accent,#f59e0b);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent,#f59e0b) 18%,transparent)}
    .st-gate-e{margin-top:12px;padding:9px 12px;border-radius:9px;background:color-mix(in srgb,var(--down,#dc2626) 12%,transparent);border:1px solid color-mix(in srgb,var(--down,#dc2626) 38%,transparent);color:var(--down,#f87171);font-size:12.5px}
    .st-gate-b{width:100%;margin-top:16px;padding:13px;border-radius:12px;border:0;cursor:pointer;font-family:inherit;font-size:14.5px;font-weight:800;color:#fff;background:linear-gradient(135deg,#8b7bff,#6d5efc);box-shadow:0 8px 22px rgba(124,108,255,.32)}
    .st-gate-b:hover{filter:brightness(1.06)}
    .st-gate-hint{margin-top:14px;font-size:11.5px;color:var(--sub,#94a3b8)}
    /* ── ☁️ Drive 백업 헬스 카드 ── */
    .dh{margin-top:18px;padding:16px 18px;border-radius:14px;background:var(--card,#111a2e);border:1px solid var(--line,rgba(148,163,184,.18))}
    .dh-head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:10px}
    .dh-title{font-size:14.5px;font-weight:800;color:var(--ink,#f1f6ff)}
    .dh-sum{font-size:12.5px;margin-top:4px}
    .dh-sum.ok{color:#34d399}.dh-sum.warn{color:#fbbf24}
    .dh-btn{border:0;border-radius:10px;padding:9px 14px;cursor:pointer;font-family:inherit;font-size:13px;font-weight:700;color:#fff;background:linear-gradient(135deg,#3b82f6,#2563eb)}
    .dh-btn:disabled{opacity:.6;cursor:wait}
    .dh-conflicts{margin-top:8px;display:flex;flex-direction:column;gap:6px}
    .dh-conflict{display:flex;flex-wrap:wrap;gap:6px;align-items:center;font-size:12.5px}
    .dh-err{margin:6px 0;padding:8px 11px;border-radius:9px;font-size:12.5px;color:#fbbf24;background:color-mix(in srgb,#f59e0b 12%,transparent);border:1px solid color-mix(in srgb,#f59e0b 38%,transparent)}
    .dh-list{display:flex;flex-direction:column;gap:4px}
    .dh-row{display:grid;grid-template-columns:96px 1fr 104px 72px 120px;gap:8px;align-items:center;font-size:12.5px;padding:6px 8px;border-radius:8px;background:rgba(8,13,24,.35)}
    .dh-badge{font-weight:700;font-size:11.5px}
    .dh-badge.s0{color:#34d399}.dh-badge.s1{color:#fbbf24}.dh-badge.s2{color:#f87171}.dh-badge.s3{color:#94a3b8}
    .dh-name{font-family:Consolas,monospace;color:var(--ink,#e6eefc);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .dh-cat,.dh-size,.dh-time{color:var(--sub,#93a3b8)}
    .dh-size{text-align:right}
    .dh-detail{grid-column:2/-1;color:#f87171;font-size:11.5px}
    .dh-companions,.dh-selftest{margin-top:10px;display:flex;flex-direction:column;gap:4px}
    .dh-selftest .dh-btn{align-self:flex-start}
</style>

@code {
    private enum Tab { Members, Mail, Video, Engines, Gemini, KeyVault, InstallPc, License, Deploy, Admins }
    private Tab _tab = Tab.Members;

    /// <summary>v5.3.2: 원클릭 앱 제작 직결 — <c>/settings?tab=deploy</c> 진입 시 보안·배포 탭 자동 활성.
    ///   ⚠ 프로퍼티명은 enum <c>Tab</c> 과의 충돌을 피해 <c>TabParam</c> 로 두고 쿼리키는 <c>tab</c> 으로 매핑.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "tab")] public string? TabParam { get; set; }
    private string? _appliedTabParam;

    // ── 관리자 설정 진입 게이트(관리자 비밀번호) ──
    private bool _unlocked;
    private string _pwInput = "";
    private string? _pwErr;

    private void TryUnlock()
    {
        if (Members.VerifyAdminPassword(_pwInput)) { _unlocked = true; _pwErr = null; _pwInput = ""; }
        else { _pwErr = "관리자 비밀번호가 일치하지 않습니다."; _pwInput = ""; }
    }
    private void OnGateKey(KeyboardEventArgs e) { if (e.Key == "Enter") TryUnlock(); }

    // ── ☁️ Drive 백업 헬스(Pluto 9종 + 계정·설정 2종) ──
    private PlutoDriveHealthReport? _drive;
    private bool _driveBusy;
    private IReadOnlyList<PlutoConflictCopy> _conflicts = Array.Empty<PlutoConflictCopy>();
    private int _pendingResolutions;
    private string? _conflictToast;

    private void RefreshConflicts()
    {
        try { _conflicts = DriveHealth.ListConflicts(); _pendingResolutions = DriveHealth.PendingConflictResolutions; }
        catch (Exception ex) { Program.Log("Settings.Conflicts", ex); _conflicts = Array.Empty<PlutoConflictCopy>(); }
    }

    /// <summary>⚔️ 1 = 병합 · 2 = 이 사본으로 복원(둘 다 ♻️ 실행 중 허브 즉시 재적재 · 재시작 불필요) · 3 = 무시(예외 전파 금지).</summary>
    private async Task ResolveConflict(PlutoConflictCopy c, int action)
    {
        if (_driveBusy) return;
        _driveBusy = true;
        try
        {
            var r = action == 1 ? await DriveHealth.MergeConflictLiveAsync(c.FullPath) : action == 2 ? await DriveHealth.RestoreConflictLiveAsync(c.FullPath) : DriveHealth.DismissConflict(c.FullPath);
            _conflictToast = r.MessageKorean;
        }
        catch (Exception ex) { Program.Log("Settings.ConflictResolve", ex); _conflictToast = "⚠ 처리 실패: " + ex.Message; }
        finally { _driveBusy = false; }
        RefreshConflicts();
    }

    // ── 🩺 Step 28 — 통합 Pluto 진단 스냅샷(클립보드) ──
    private bool _diagBusy;
    private string? _diagToast;

    private async Task CopyPlutoDiagnosticAsync()
    {
        if (_diagBusy) return;
        _diagBusy = true;
        try
        {
            var md = await PlutoDiagnostics.BuildSnapshotMarkdownAsync();
            _diagToast = Clipboard.SetText(md) ? "🩺 플루토 진단 리포트를 복사했습니다(" + md.Length.ToString(CultureInfo.InvariantCulture) + "자)" : "⚠ 클립보드 복사에 실패했습니다";
        }
        catch (Exception ex) { Program.Log("Settings.PlutoDiagnostic", ex); _diagToast = "⚠ 진단 수집 실패: " + ex.Message; }
        finally { _diagBusy = false; }
    }

    // ── 💾 Step 29 — 진단서 파일 저장(.md · 원자 · 덮어쓰기 없음) ──
    private async Task SavePlutoDiagnosticFileAsync()
    {
        if (_diagBusy) return;
        _diagBusy = true;
        try
        {
            var r = await PlutoDiagnostics.ExportSnapshotMarkdownFileAsync();
            _diagToast = r.MessageKorean;
        }
        catch (Exception ex) { Program.Log("Settings.PlutoDiagnosticSave", ex); _diagToast = "⚠ 진단서 저장 실패: " + PromptFlowStudio.Services.Pluto.PlutoSystemDiagnosticService.RedactPaths(ex.Message); }
        finally { _diagBusy = false; }
    }

    // ── 🧪 Step 30 — 샌드박스 플라이휠 자가진단 ──
    private bool _selfTestBusy;
    private PromptFlowStudio.Services.Pluto.PlutoFlywheelSelfTestReport? _selfTest;
    private string? _selfTestError;

    private async Task RunFlywheelSelfTestAsync()
    {
        if (_selfTestBusy) return;
        _selfTestBusy = true;
        _selfTestError = null;
        try { _selfTest = await FlywheelSelfTest.RunAsync(); }
        catch (Exception ex) { Program.Log("Settings.FlywheelSelfTest", ex); _selfTestError = "⚠ 자가진단 실행 실패: " + PromptFlowStudio.Services.Pluto.PlutoSystemDiagnosticService.RedactPaths(ex.Message); }
        finally { _selfTestBusy = false; }
    }

    private static bool AllCompanionsHealthy(PlutoDriveHealthReport r)
    {
        foreach (var c in r.Companions) if (!c.IsHealthy) return false;
        return true;
    }

    private async Task VerifyDriveAsync()
    {
        if (_driveBusy) return;
        _driveBusy = true;
        try { _drive = await DriveHealth.ForceSyncAndVerifyAsync(); }
        catch (Exception ex) { Program.Log("Settings.DriveHealth", ex); _drive = DriveHealth.CheckHealth(); }
        finally { _driveBusy = false; }
        RefreshConflicts();
    }

    private static string BadgeText(PlutoDriveFileStatus s) => s switch
    {
        PlutoDriveFileStatus.Healthy => "✅ 동기화됨",
        PlutoDriveFileStatus.Missing => "⚠️ 미생성",
        PlutoDriveFileStatus.CorruptOrEmpty => "❌ 손상/오류",
        _ => "⛔ 드라이브 없음",
    };

    // ── 🔄 Step 33 — YouTube Data API v3 연동 ──
    private PlutoYouTubeApiStatusSnapshot? _ytApi;
    private bool _ytApiBusy;
    private string? _ytApiToast;
    private string _ytApiKey = "", _ytClientId = "", _ytClientSecret = "", _ytRefreshToken = "", _ytChannels = "";

    private void RefreshYouTubeApiStatus()
    {
        try { _ytApi = YouTubeApi.GetStatus(); }
        catch (Exception ex) { Program.Log("Settings.YouTubeApiStatus", ex); _ytApi = null; }
    }

    private async Task SaveYouTubeApiAsync()
    {
        if (_ytApiBusy) return;
        var invalid = new List<string>();
        var channels = PlutoYouTubeApiSyncService.ParseChannelList(_ytChannels, invalid);
        if (invalid.Count > 0) { _ytApiToast = "⚠ 채널 입력 오류: " + string.Join(", ", invalid); return; }
        _ytApiBusy = true;
        try
        {
            var r = await YouTubeApi.SaveCredentialsAsync(new PlutoYouTubeApiCredentials
            {
                ApiKey = _ytApiKey, ClientId = _ytClientId, ClientSecret = _ytClientSecret, RefreshToken = _ytRefreshToken, Channels = channels,
            });
            _ytApiToast = r.MessageKorean;
            if (r.Ok) { _ytApiKey = ""; _ytClientSecret = ""; _ytRefreshToken = ""; }   // 🔐 비밀값은 화면에 남기지 않음
        }
        catch (Exception ex) { Program.Log("Settings.YouTubeApiSave", ex); _ytApiToast = "⚠ 저장 실패: " + ex.GetType().Name; }
        finally { _ytApiBusy = false; RefreshYouTubeApiStatus(); }
    }

    private async Task TestYouTubeApiAsync()
    {
        if (_ytApiBusy) return;
        _ytApiBusy = true;
        try { _ytApiToast = (await YouTubeApi.TestConnectionAsync()).SummaryKorean; }
        catch (Exception ex) { Program.Log("Settings.YouTubeApiTest", ex); _ytApiToast = "⚠ 연결 테스트 실패: " + ex.GetType().Name; }
        finally { _ytApiBusy = false; RefreshYouTubeApiStatus(); }
    }

    private async Task DisconnectYouTubeApiAsync()
    {
        if (_ytApiBusy) return;
        _ytApiBusy = true;
        try { await YouTubeApi.DisconnectAsync(); _ytApiToast = "🔌 연결 해제 — 저장된 자격 증명을 삭제했습니다."; }
        catch (Exception ex) { Program.Log("Settings.YouTubeApiDisconnect", ex); _ytApiToast = "⚠ 해제 실패: " + ex.GetType().Name; }
        finally { _ytApiBusy = false; RefreshYouTubeApiStatus(); }
    }

    private static string FormatSize(long b) => b <= 0 ? "—"
        : b < 1024 ? b.ToString(CultureInfo.InvariantCulture) + " B"
        : b < 1024 * 1024 ? (b / 1024.0).ToString("0.0", CultureInfo.InvariantCulture) + " KB"
        : (b / (1024.0 * 1024.0)).ToString("0.00", CultureInfo.InvariantCulture) + " MB";

    protected override void OnInitialized()
    {
        if (!Session.IsAuthenticated) { Nav.NavigateTo("login"); return; }
        try { _drive = DriveHealth.CheckHealth(); }
        catch (Exception ex) { Program.Log("Settings.DriveHealth", ex); }
        RefreshConflicts();
        RefreshYouTubeApiStatus();
    }

    // v5.3.2: 쿼리(?tab=) 값이 바뀔 때만 초기 활성 탭을 반영한다(사용자의 이후 탭 클릭은 보존).
    //   같은 /settings 에서 [원클릭 앱 제작](?tab=deploy) 재진입 시에도 OnParametersSet 이 잡아 Deploy 탭으로 전환.
    protected override void OnParametersSet()
    {
        if (string.Equals(_appliedTabParam, TabParam, StringComparison.Ordinal)) return;
        _appliedTabParam = TabParam;
        if (ParseTab(TabParam) is { } t) _tab = t;
    }

    /// <summary>쿼리 tab 값 → 탭(모르는 값은 null). deploy=보안·배포(원클릭 APK/iOS 제작).</summary>
    private static Tab? ParseTab(string? q) => (q ?? "").Trim().ToLowerInvariant() switch
    {
        "deploy" => Tab.Deploy,
        "members" => Tab.Members,
        "mail" => Tab.Mail,
        "video" => Tab.Video,
        "engines" => Tab.Engines,
        "gemini" => Tab.Gemini,
        "keyvault" => Tab.KeyVault,
        "installpc" => Tab.InstallPc,
        "license" => Tab.License,
        "admins" => Tab.Admins,
        _ => null,
    };
}
