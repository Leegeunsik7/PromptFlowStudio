@implements IDisposable
@using System.Globalization
@using PromptFlowStudio.Services.Camera
@inject PromptFlowStudio.ViewModels.WirelessCameraViewModel Vm
@inject NavigationManager Nav

@* [PromptFlow Studio] 📡 무선 카메라 (CameraStudio 📡 탭 컴포넌트) — RTSP/SRT/WebRTC 스트림 연결 · 뷰파인더 HUD(FPS/지연) + 3x3 구도 그리드 · 단일 프레임 캡처 → I2V 첫 프레임 전달.
   상태는 싱글턴 서비스 소유 — 이 페이지는 Vm.Changed 구독 + 500ms 텔레메트리 타이머(Streaming 중에만 갱신) InvokeAsync(StateHasChanged). *@

<div class="wc">
    <header class="wc-head">
        <h1 class="wc-title">📡 무선 <span class="wc-title-g">카메라</span></h1>
        <p class="wc-sub">IP/액션캠 스트림을 연결해 장면을 캡처하고, 캡처 프레임을 I2V 첫 프레임으로 바로 보냅니다.</p>
    </header>

    @* ── 상단 컨트롤 바: 주소 · 연결 토글 · 상태 배지 ── *@
    <section class="wc-bar">
        <input class="wc-input" @bind="Vm.StreamEndpointInput" placeholder="rtsp://192.168.0.10:554/live" disabled="@(Vm.IsStreaming || Vm.IsBusy)" />
        <button class="wc-btn @(Vm.IsStreaming ? "wc-btn-off" : null)" @onclick="Toggle">@(Vm.IsStreaming || Vm.IsBusy ? "⏹ 연결 해제" : "▶ 연결")</button>
        <span class="wc-state wc-state-@(Vm.ConnectionState.ToString().ToLowerInvariant())">@(StateLabel(Vm.ConnectionState))</span>
        @if (!string.IsNullOrEmpty(Vm.StatusMessage))
        {
            <span class="wc-msg">@(Vm.StatusMessage)</span>
        }
    </section>

    <div class="wc-grid">
        @* ── 중앙 뷰파인더: HUD + 3x3 구도 가이드 ── *@
        <section class="wc-view">
            <div class="wc-frame @(Vm.IsStreaming ? "on" : null)">
                @if (Vm.IsStreaming)
                {
                    <div class="wc-live"></div>
                    <span class="wc-rec">● LIVE</span>
                }
                else
                {
                    <span class="wc-empty">@(Vm.IsBusy ? "핸드셰이크 중…" : "스트림 미연결")</span>
                }
                <div class="wc-thirds">
                    <i style="left:33.333%"></i><i style="left:66.666%"></i>
                    <b style="top:33.333%"></b><b style="top:66.666%"></b>
                </div>
                <div class="wc-hud">
                    <span class="wc-chip">@(Vm.CurrentFps.ToString("0.00", CultureInfo.InvariantCulture)) FPS</span>
                    <span class="wc-chip @(Vm.LatencyMs > 500 ? "warn" : null)">@(Vm.LatencyMs.ToString(CultureInfo.InvariantCulture)) ms</span>
                    <span class="wc-chip">@(Vm.ResolutionDisplay)</span>
                    <span class="wc-chip">@((Vm.BitrateKbps / 1000.0).ToString("0.0", CultureInfo.InvariantCulture)) Mbps</span>
                </div>
            </div>
        </section>

        @* ── 우측 캡처 덱 ── *@
        <section class="wc-deck">
            <button class="wc-shutter" @onclick="Capture" disabled="@(!Vm.IsStreaming)">📷 현재 프레임 캡처</button>
            @if (Vm.LastCapturedFrame is { } f)
            {
                <img class="wc-thumb" src="@f.FrameDataUrl" alt="최근 캡처" />
                <div class="wc-meta">
                    <span>@(f.Resolution)</span>
                    <span>@(f.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff", CultureInfo.InvariantCulture))</span>
                </div>
                <div class="wc-id">@(f.FrameId.ToString("N").Substring(0, 12))</div>
            }
            else
            {
                <div class="wc-thumb wc-thumb-empty">캡처된 프레임 없음</div>
            }
            <button class="wc-btn wc-send" @onclick="SendToI2v" disabled="@(Vm.LastCapturedFrame is null)">I2V 첫 프레임으로 보내기 →</button>
            @if (Vm.I2vQueued)
            {
                <div class="wc-hint">✅ 대기 중 — 프롬프트 입력 화면을 열면 첫 프레임으로 적용됩니다.</div>
            }
        </section>
    </div>
</div>

<style>
    .wc { padding: 22px 26px; display: flex; flex-direction: column; gap: 14px; }
    .wc-title { font-size: 24px; font-weight: 900; margin: 0; color: var(--text-primary); }
    .wc-title-g { background: linear-gradient(135deg, #22d3ee, var(--flow-magenta)); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .wc-sub { font-size: 13px; color: var(--text-secondary); margin: 6px 0 0; }
    .wc-bar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .wc-input { flex: 1; min-width: 260px; font: 600 12px var(--mono); padding: 9px 11px; border-radius: 9px; border: 1px solid var(--line); background: var(--card-2); color: var(--text-primary); }
    .wc-btn { font: 800 12px/1 var(--mono); padding: 10px 14px; border-radius: 9px; border: 1px solid var(--line); background: linear-gradient(135deg, #0ea5e9, #6366f1); color: #fff; cursor: pointer; }
    .wc-btn:disabled { opacity: .45; cursor: default; }
    .wc-btn-off { background: linear-gradient(135deg, #ef4444, #b91c1c); }
    .wc-state { font: 800 11px/1 var(--mono); padding: 5px 9px; border-radius: 999px; border: 1px solid var(--line); color: var(--text-secondary); }
    .wc-state-streaming { color: #22c55e; border-color: #22c55e; }
    .wc-state-connecting { color: #f59e0b; border-color: #f59e0b; }
    .wc-state-error { color: #ef4444; border-color: #ef4444; }
    .wc-msg { font-size: 12px; color: var(--text-muted); }
    .wc-grid { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 14px; }
    @@media (max-width: 980px) { .wc-grid { grid-template-columns: 1fr; } }
    .wc-frame { position: relative; aspect-ratio: 16/9; border-radius: 14px; overflow: hidden; background: #05070d; border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; }
    .wc-frame.on { border-color: #22c55e; }
    .wc-live { position: absolute; inset: 0; background: linear-gradient(120deg, #0f172a, #1e3a8a 40%, #0e7490 70%, #0f172a); background-size: 300% 300%; animation: wc-pan 8s ease-in-out infinite; }
    @@keyframes wc-pan { 0%, 100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
    .wc-empty { position: relative; font: 700 13px var(--mono); color: var(--text-muted); }
    .wc-rec { position: absolute; top: 15px; left: 12px; font: 900 11px var(--mono); color: #ef4444; }
    .wc-thirds { position: absolute; inset: 0; pointer-events: none; }
    .wc-thirds i, .wc-thirds b { position: absolute; background: transparent; }
    .wc-thirds i { border-left: 1px dashed rgba(34,211,238,.55); }
    .wc-thirds b { border-top: 1px dashed rgba(236,72,153,.5); }
    .wc-thirds i { top: 0; bottom: 0; width: 0; }
    .wc-thirds b { left: 0; right: 0; height: 0; }
    .wc-hud { position: absolute; top: 12px; right: 12px; left: 64px; display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
    .wc-chip { font: 800 11px/1 var(--mono); letter-spacing: .03em; padding: 5px 9px; border-radius: 999px; background: rgba(0,0,0,.6); backdrop-filter: blur(6px); font-variant-numeric: tabular-nums; color: #a7f3d0; border: 1px solid rgba(167,243,208,.35); }
    .wc-chip.warn { color: #fbbf24; border-color: rgba(251,191,36,.45); }
    .wc-deck { display: flex; flex-direction: column; gap: 10px; padding: 14px; border-radius: 14px; border: 1px solid var(--line); background: var(--card-2); }
    .wc-shutter { font: 900 13px/1 var(--mono); padding: 14px; border-radius: 12px; border: none; background: linear-gradient(135deg, #f43f5e, #d946ef); color: #fff; cursor: pointer; }
    .wc-shutter:disabled { opacity: .45; cursor: default; }
    .wc-thumb { width: 100%; aspect-ratio: 16/9; border-radius: 10px; object-fit: cover; border: 1px solid var(--line); image-rendering: auto; }
    .wc-thumb-empty { display: flex; align-items: center; justify-content: center; font-size: 12px; color: var(--text-muted); background: #05070d; }
    .wc-meta { display: flex; justify-content: space-between; font: 700 11px var(--mono); color: var(--text-secondary); }
    .wc-id { font: 600 10px var(--mono); color: var(--text-muted); }
    .wc-send { width: 100%; }
    .wc-hint { font-size: 11.5px; color: var(--text-secondary); }
</style>

@code {
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        Vm.Changed += OnVmChanged;
        Vm.RefreshTelemetry();
        _timer = new System.Threading.Timer(OnTick, null, 500, 500);
    }

    private void OnTick(object? _)
    {
        try { if (Vm.IsStreaming) Vm.RefreshTelemetry(); }
        catch (Exception ex) { Program.Log("WirelessCamera.Tick", ex); }
    }

    private void OnVmChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task Toggle()
    {
        try { await Vm.ToggleConnection(); }
        catch (Exception ex) { Program.Log("WirelessCamera.Toggle", ex); }
    }

    private async Task Capture()
    {
        try { await Vm.CaptureCurrentFrame(); }
        catch (Exception ex) { Program.Log("WirelessCamera.Capture", ex); }
    }

    private void SendToI2v()
    {
        if (Vm.SendToI2vReference()) Nav.NavigateTo("workspace");
    }

    private static string StateLabel(CameraConnectionState s) => s switch
    {
        CameraConnectionState.Streaming => "● STREAMING",
        CameraConnectionState.Connecting => "◌ CONNECTING",
        CameraConnectionState.Error => "✕ ERROR",
        _ => "○ DISCONNECTED",
    };

    public void Dispose()
    {
        Vm.Changed -= OnVmChanged;
        _timer?.Dispose();
        _timer = null;
    }
}
