    private bool _fcWarmed, _forecastSwapBusy;
    private string? _forecastToast;
    /// <summary>예측 재평가 최소 간격(입력 동일 시 · 렌더마다 재계산 방지).</summary>
    private const long ForecastRefreshMs = 2000;

    /// <summary>예측 훅 = 무장된 기획 훅 → 학습 1위 훅 → 성과 입력 훅(사후 분석 조합 키와 같은 라벨 체계).</summary>
    private string ForecastHook() => _appliedBriefArm is { HookStyle.Length: > 0 } arm ? arm.HookStyle : _adaptiveRec is { } rec ? rec.TopHook.DisplayLabel : _perfHookStyle;

    private PromptFlowStudio.Services.Pluto.PlutoSetupForecast? CurrentSetupForecast()
    {
        if (_disposed || EcoSp.GetService(typeof(PromptFlowStudio.Services.Pluto.IPlutoBriefOutcomeAttributionService)) is not PromptFlowStudio.Services.Pluto.IPlutoBriefOutcomeAttributionService svc) return null;
        var theme = string.IsNullOrWhiteSpace(_appliedBriefTitle) ? _prompt : _appliedBriefTitle;
        var hook = ForecastHook();
        var look = _montageLook;
        var bgm = CurrentBgmMood();
        var nowMs = Environment.TickCount64;
        if (_setupForecast is not null && nowMs - _fcAtMs < ForecastRefreshMs && string.Equals(theme, _fcTheme, StringComparison.Ordinal) && string.Equals(hook, _fcHook, StringComparison.Ordinal)
            && string.Equals(look, _fcLook, StringComparison.Ordinal) && string.Equals(bgm, _fcBgm, StringComparison.Ordinal)) return _setupForecast;
        if (!_fcWarmed) { _fcWarmed = true; _ = WarmSetupForecastAsync(svc); }
        try { _setupForecast = svc.EvaluateSetupForecast(theme, hook, look, bgm, "몽타주"); }
        catch (Exception ex) { Program.Log("Workspace.SetupForecast", ex); _setupForecast = null; }
        (_fcTheme, _fcHook, _fcLook, _fcBgm, _fcAtMs) = (theme, hook, look, bgm, nowMs);
        return _setupForecast;
    }

    /// <summary>예측용 카탈로그 스냅샷 1회 선적재(예외 전파 금지) → 다시 그리기.</summary>
    private async Task WarmSetupForecastAsync(PromptFlowStudio.Services.Pluto.IPlutoBriefOutcomeAttributionService svc)
    {
        try { await svc.RefreshForecastCacheAsync(_mediaCts.Token); }
        catch (OperationCanceledException) { return; }
        catch (Exception ex) { Program.Log("Workspace.SetupForecastWarm", ex); return; }
        if (_disposed) return;
        _setupForecast = null;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>🔁 원클릭 안전 룩 교체 — 룩 고정 → 몽타주 룩 재해석 → (직접 고친 자막이 없을 때만) 프리뷰 재구성.</summary>
    private async Task ApplySafeLookSwapAsync(string safeLook)
    {
        if (_disposed || _forecastSwapBusy || _montageBusy || State.IsBusy || PromptFlowStudio.Services.Pluto.PlutoColorGradingCompiler.TryGetPreset(safeLook) is null) return;
        _forecastSwapBusy = true;
        try
        {
            _learnedLookPinned = safeLook;
            RefreshMontageLook();
            if (_montagePhotos.Count >= 2 && !CuesManuallyEdited) await RefreshMontagePreviewAsync();
            _setupForecast = null;
            _forecastToast = "🔁 안전 룩 " + _montageLook + "(으)로 교체" + (_appliedBriefArm is not null ? " · 기획 룩과 달라져 이 클립은 기획 채점에서 제외돼요" : "");
        }
        catch (OperationCanceledException) { return; }
        catch (Exception ex) { Program.Log("Workspace.SetupForecastSwap", ex); _forecastToast = "⚠ 룩 교체 실패: " + PromptFlowStudio.Services.Pluto.PlutoAutonomousActivityFeedService.Redact(ex.Message); }
        finally { _forecastSwapBusy = false; }
        if (_disposed) return;
        await InvokeAsync(StateHasChanged);
    }

    private bool CuesManuallyEdited => _montageCues is { Count: > 0 } && ReferenceEquals(_montageCues, _cuesManualEditRef);

