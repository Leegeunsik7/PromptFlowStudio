    // ── 🌍 Step 39 — 원클릭 전 언어 일괄 분기/패키지 ──
    private bool _localeBatchBusy;
    private string? _localeBatchToast;

    /// <summary>🌍 [전 언어 일괄 분기/패키지] — KO · EN · JA · ES 번역 · 적합 · 분기 · 사이드카 묶음을 한 번에(예외 전파 금지 · 로캘별 요약 토스트).</summary>
    private async Task BranchAndExportAllLocalesAsync()
    {
        if (_localeBatchBusy || _publishPackBusy || LocaleChannels() is not { } channels
            || EcoSp.GetService(typeof(PromptFlowStudio.Services.Pluto.IPlutoYouTubePublishPackService)) is not PromptFlowStudio.Services.Pluto.IPlutoYouTubePublishPackService svc) return;
        PromptFlowStudio.Services.Pluto.PlutoRenderedClipRecord? clip = null;
        var vid = _perfVideoId?.Trim() ?? "";
        foreach (var c in _catalogClips) if (vid.Length > 0 && string.Equals(c.VideoId, vid, StringComparison.OrdinalIgnoreCase)) { clip = c; break; }
        if (clip is null && _catalogClips.Count > 0 && vid.Length == 0) clip = _catalogClips[0];
        if (clip is null) { _localeBatchToast = "⚠ 일괄 분기할 렌더가 카탈로그에 없습니다"; await InvokeAsync(StateHasChanged); return; }
        _localeBatchBusy = true;
        _publishPackBusy = true;   // 단건 패키지 · 로캘 전환과 상호 배제
        await InvokeAsync(StateHasChanged);
        try
        {
            await ReloadGlossaryAsync();
            var title = string.IsNullOrWhiteSpace(clip.Title) ? clip.VideoId : clip.Title;
            PromptFlowStudio.Services.Pluto.PlutoSeriesArcMemoryService.TryParseEpisodeMode(clip.RenderMode, out var n, out var total);
            var theme = total > 0 && _series is { } ser && ser.Episodes.Count == total && !string.IsNullOrWhiteSpace(ser.SeriesTheme)
                ? ser.SeriesTheme : PromptFlowStudio.Services.Pluto.PlutoSeriesArcMemoryService.SeriesThemeOf(title);
            var (ep, epTotal) = LocaleEpisode();
            var req = new PromptFlowStudio.Services.Pluto.PlutoMultiLocaleBatchRequest(clip.VideoId, _montageCues)
            {
                ContextKey = LocaleTrackContext(), SubtitleEpisode = ep, SubtitleTotal = epTotal, Glossary = _glossaryEntries,
                Theme = theme, CatalogTitle = title, EpisodeNumber = n, TotalEpisodes = total, HookStyle = clip.HookStyle ?? _perfHookStyle, StyleTags = clip.Tags,
                IsShorts = !string.Equals(_perfPlatform, "Instagram Reels", StringComparison.Ordinal),
                VideoPath = string.IsNullOrWhiteSpace(clip.OutputPath) ? null : clip.OutputPath,
            };
            var deps = new PromptFlowStudio.Services.Pluto.PlutoMultiLocaleBatchServices(SubtitleLocalization(),
                EcoSp.GetService(typeof(PromptFlowStudio.Services.Pluto.IPlutoRenderCatalogService)) as PromptFlowStudio.Services.Pluto.IPlutoRenderCatalogService, svc);
            var result = await channels.BranchAndExportAllLocalesAsync(req, deps, _mediaCts.Token);
            if (_disposed) return;
            _localeFitCache = null;   // 🔄 새 번역 트랙 반영(미리보기 · 렌더 투영 즉시 갱신)
            _publishPack = null;      // 단건 패키지 상태는 선택 로캘 기준 — 일괄 뒤엔 다시 생성
            _publishPackClip = null;
            _localeBatchToast = result.SummaryKorean + (req.VideoPath is null ? " · 렌더 영상 경로 없음(사이드카 생략)" : "");
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Program.Log("Workspace.LocaleBatch", ex); _localeBatchToast = "⚠ 전 언어 일괄 실패: " + PromptFlowStudio.Services.Pluto.PlutoAutonomousActivityFeedService.Redact(ex.Message); }
        finally { _localeBatchBusy = false; _publishPackBusy = false; }
        if (_disposed) return;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>🎬 Step 40 [전 언어 일괄 렌더/패키지] — 사전 분기/패키지 → 로캘별 몽타주 렌더(스테이징) → 검증 → MP4 + 사이드카 짝 커밋(예외 전파 금지 · 로캘별 요약 토스트 · 활동 피드 기록).</summary>
    private async Task RenderAllLocalesAsync()
    {
        var svc = EcoSp.GetService(typeof(PromptFlowStudio.Services.Pluto.IPlutoYouTubePublishPackService)) as PromptFlowStudio.Services.Pluto.IPlutoYouTubePublishPackService;
        var renderSvc = EcoSp.GetService(typeof(PromptFlowStudio.Services.Pluto.IPlutoMultiLocaleBatchRenderService)) as PromptFlowStudio.Services.Pluto.IPlutoMultiLocaleBatchRenderService;
        var blocker = PromptFlowStudio.Services.Pluto.PlutoMultiLocaleBatchRenderService.DescribeRenderBlocker(_localeBatchBusy,
            _publishPackBusy || _localeTranslateBusy || _montageBusy || _stockBusy, _montagePhotos.Count, LocaleChannels() is not null, svc is not null && renderSvc is not null);
        if (blocker is not null || svc is null || renderSvc is null) { _localeBatchToast = blocker ?? "⚠ 전 언어 일괄 렌더를 시작할 수 없습니다"; await InvokeAsync(StateHasChanged); return; }
        PromptFlowStudio.Services.Pluto.PlutoRenderedClipRecord? clip = null;
        var vid = _perfVideoId?.Trim() ?? "";
        foreach (var c in _catalogClips) if (vid.Length > 0 && string.Equals(c.VideoId, vid, StringComparison.OrdinalIgnoreCase)) { clip = c; break; }
        if (clip is null && _catalogClips.Count > 0 && vid.Length == 0) clip = _catalogClips[0];
        if (clip is null || string.IsNullOrWhiteSpace(clip.OutputPath)) { _localeBatchToast = "⚠ 일괄 렌더할 마스터 렌더(영상 경로)가 카탈로그에 없습니다"; await InvokeAsync(StateHasChanged); return; }
        var mismatch = PromptFlowStudio.Services.Pluto.PlutoMultiLocaleBatchRenderService.DescribeWorkspaceMismatch(clip.VideoId, _renderedMasterVideoId, _renderedMasterFingerprint,
            PromptFlowStudio.Services.Pluto.PlutoMultiLocaleBatchRenderService.ComputeWorkspaceFingerprint(_montagePhotos, _montageCues));
        _localeBatchBusy = true;
        if (mismatch is not null) _localeBatchToast = mismatch + " · ⏳ 렌더 진행 중…";
        _publishPackBusy = true;
        _montageBusy = true;
        _stockBusy = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await ReloadGlossaryAsync();
            var photos = _montagePhotos.ToArray();
            var focals = await EnsureStagedFocalPointsAsync(photos, _mediaCts.Token);
            var locked = _activeMontagePlan is { } lp && lp.Clips.Count == photos.Length ? lp : null;   // 🔒 마스터와 같은 컷 경계
            var title = string.IsNullOrWhiteSpace(clip.Title) ? clip.VideoId : clip.Title;
            PromptFlowStudio.Services.Pluto.PlutoSeriesArcMemoryService.TryParseEpisodeMode(clip.RenderMode, out var n, out var total);
            var theme = total > 0 && _series is { } ser && ser.Episodes.Count == total && !string.IsNullOrWhiteSpace(ser.SeriesTheme)
                ? ser.SeriesTheme : PromptFlowStudio.Services.Pluto.PlutoSeriesArcMemoryService.SeriesThemeOf(title);
            var (ep, epTotal) = LocaleEpisode();
            var isShorts = !string.Equals(_perfPlatform, "Instagram Reels", StringComparison.Ordinal);
            var batch = new PromptFlowStudio.Services.Pluto.PlutoMultiLocaleBatchRequest(clip.VideoId, _montageCues)
            {
                ContextKey = LocaleTrackContext(), SubtitleEpisode = ep, SubtitleTotal = epTotal, Glossary = _glossaryEntries,
                Theme = theme, CatalogTitle = title, EpisodeNumber = n, TotalEpisodes = total, HookStyle = clip.HookStyle ?? _perfHookStyle, StyleTags = clip.Tags,
                IsShorts = isShorts, VideoPath = clip.OutputPath,
            };
            var deps = new PromptFlowStudio.Services.Pluto.PlutoMultiLocaleBatchServices(SubtitleLocalization(),
                EcoSp.GetService(typeof(PromptFlowStudio.Services.Pluto.IPlutoRenderCatalogService)) as PromptFlowStudio.Services.Pluto.IPlutoRenderCatalogService, svc);
            PromptFlowStudio.Services.Export.BabyBgmTrack? bgm = _bgmOn ? _bgmTrack : null;
            var look = _montageLook;
            var customWav = _customBgm?.CroppedWavBytes;
            PromptFlowStudio.Services.Pluto.PlutoLocaleRenderDelegate render = async (job, ct) =>
            {
                var r = await StockSuite.ExportMontageVideoFromPhotosAsync(photos, focals, new PromptFlowStudio.Services.Export.ExportOptions(), job.Cues,
                    bgm, includeSfx: true, preferredLook: look, outputPath: job.StagingPath, ct: ct, customBgmWavBytes: customWav,
                    lockedPlan: locked, vertical9x16SmartCrop: job.IsShorts);
                if (!r.Ok) return new PromptFlowStudio.Services.Pluto.PlutoLocaleRenderOutcome(false, r.Message);
                double? dur = null;
                try { if (await Probe.ProbeAsync(job.StagingPath, ct) is { DurationSec: > 0 } spec) dur = spec.DurationSec; }
                catch (Exception ex) when (ex is not OperationCanceledException) { Program.Log("Workspace.LocaleRenderProbe", ex); }
                return new PromptFlowStudio.Services.Pluto.PlutoLocaleRenderOutcome(true, r.Message) { VideoDurationSeconds = dur };
            };
            var result = await renderSvc.RenderAllLocalesAsync(new PromptFlowStudio.Services.Pluto.PlutoMultiLocaleRenderRequest(batch), deps, render, _mediaCts.Token);
            if (_disposed) return;
            _localeFitCache = null;
            _publishPack = null;
            _publishPackClip = null;
            _localeBatchToast = mismatch is null ? result.SummaryKorean : mismatch + " · " + result.SummaryKorean;
        }
        catch (OperationCanceledException) { if (!_disposed) _localeBatchToast = "⏹ 전 언어 일괄 렌더가 취소되었습니다"; }
        catch (Exception ex) { Program.Log("Workspace.LocaleRenderBatch", ex); _localeBatchToast = "⚠ 전 언어 일괄 렌더 실패: " + PromptFlowStudio.Services.Pluto.PlutoAutonomousActivityFeedService.Redact(ex.Message); }
        finally { _localeBatchBusy = false; _publishPackBusy = false; _montageBusy = false; _stockBusy = false; }
        if (_disposed) return;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>📋 활성 렌더(성과 입력 영상 ID → 최근 렌더) → A/B 제목 · 설명 · 고정 댓글 · 해시태그 생성 후 클립보드 복사.</summary>
    private async Task GeneratePublishPackAsync()
    {
        if (_publishPackBusy || EcoSp.GetService(typeof(PromptFlowStudio.Services.Pluto.IPlutoYouTubePublishPackService)) is not PromptFlowStudio.Services.Pluto.IPlutoYouTubePublishPackService svc) return;
        _publishPackBusy = true;
        try
        {
            PromptFlowStudio.Services.Pluto.PlutoRenderedClipRecord? clip = null;
            var vid = _perfVideoId?.Trim() ?? "";
            foreach (var c in _catalogClips) if (vid.Length > 0 && string.Equals(c.VideoId, vid, StringComparison.OrdinalIgnoreCase)) { clip = c; break; }
            if (clip is null && _catalogClips.Count > 0 && vid.Length == 0) clip = _catalogClips[0];
            var title = clip is not null ? (string.IsNullOrWhiteSpace(clip.Title) ? clip.VideoId : clip.Title) : vid;
            int n = 0, total = 0;
            if (clip is not null) PromptFlowStudio.Services.Pluto.PlutoSeriesArcMemoryService.TryParseEpisodeMode(clip.RenderMode, out n, out total);
            var theme = total > 0 && _series is { } ser && ser.Episodes.Count == total && !string.IsNullOrWhiteSpace(ser.SeriesTheme)
                ? ser.SeriesTheme : PromptFlowStudio.Services.Pluto.PlutoSeriesArcMemoryService.SeriesThemeOf(title);
            var hook = clip?.HookStyle ?? _perfHookStyle;
            IReadOnlyList<string> tags = clip?.Tags ?? (string.IsNullOrWhiteSpace(_perfStyleTags) ? Array.Empty<string>() : SplitPerfTags(_perfStyleTags));
            // 🌐 Step 31 — 선택 로캘이 마스터와 다르면 {클립ID}::{로캘} 변형으로 분기(카탈로그 제목 = 로캘 편 토큰 · 게시 후 내보내기가 정확한 변형에 연결)
            string? targetLocale = null;
            if (clip is not null && EcoSp.GetService(typeof(PromptFlowStudio.Services.Pluto.IPlutoRenderCatalogService)) is PromptFlowStudio.Services.Pluto.IPlutoRenderCatalogService cat)
            {
                var channels = EcoSp.GetService(typeof(PromptFlowStudio.Services.Pluto.IPlutoMultiLanguageChannelService)) as PromptFlowStudio.Services.Pluto.IPlutoMultiLanguageChannelService;
                var token = n > 0 && total > 0 && channels is not null ? channels.FormatEpisodeToken(_publishLocale, n, total) : "";
                var locTitle = PromptFlowStudio.Services.Pluto.PlutoYouTubePublishPackService.FitTitle(PromptFlowStudio.Services.Pluto.PlutoYouTubePublishPackService.StripEpisodeToken(title), token);
                if (await cat.BranchLocaleVariantAsync(clip.VideoId, _publishLocale, locTitle, null, _mediaCts.Token) is { } branched)
                {
                    clip = branched;
                    if (branched.IsLocaleVariant)
                    {
                        title = branched.Title;
                        theme = PromptFlowStudio.Services.Pluto.PlutoYouTubePublishPackService.StripEpisodeToken(branched.Title);
                        targetLocale = branched.TargetLocale;
                    }
                }
            }
            else if (clip is null && !string.Equals(_publishLocale, PromptFlowStudio.Services.Pluto.PlutoMultiLanguageChannelService.DefaultLocale, StringComparison.Ordinal)) targetLocale = _publishLocale;
            var req = new PromptFlowStudio.Services.Pluto.PlutoPublishPackRequest(theme, title, n, total, hook, tags) { IsShorts = !string.Equals(_perfPlatform, "Instagram Reels", StringComparison.Ordinal), TargetLocale = targetLocale };
            var pack = await svc.GenerateAsync(req, _mediaCts.Token);
            _publishPack = pack;
            _publishPackClip = clip;
            bool copied;
            try { copied = Clipboard.SetText(pack.ToClipboardText()); }
            catch (Exception ex) { Program.Log("Workspace.PublishPackCopy", ex); copied = false; }
            _publishPackToast = copied ? "📋 업로드 패키지가 복사되었습니다" : "⚠ 복사 실패 — 아래 요약을 참고하세요";
            // 🅰️🅱️ 전체 패키지 복사 → A/B 둘 다 후보로 기록(게시 후 실제 YouTube 제목으로 판정)
            if (copied && clip is not null)
                try { await svc.RecordSelectionAsync(clip.VideoId, pack, "AB", _mediaCts.Token); }
                catch (OperationCanceledException) { throw; }
                catch (Exception ex) { Program.Log("Workspace.PublishPackRecord", ex); }
        }
        catch (OperationCanceledException) { return; }
        catch (Exception ex) { Program.Log("Workspace.PublishPack", ex); _publishPackToast = "⚠ 업로드 패키지 생성 실패: " + PromptFlowStudio.Services.Pluto.PlutoAutonomousActivityFeedService.Redact(ex.Message); }
        finally { _publishPackBusy = false; }
        if (_disposed) return;
        await InvokeAsync(StateHasChanged);
    }

