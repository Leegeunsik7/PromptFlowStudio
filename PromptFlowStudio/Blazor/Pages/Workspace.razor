    /// <summary>🎯 다음 기획안 재합성(세대 가드 · 예외 전파 금지 · 서비스 미등록 → 생략).</summary>
    private async Task LoadTopicPlanAsync()
    {
        if (_disposed || EcoSp.GetService(typeof(PromptFlowStudio.Services.Pluto.IPlutoAutonomousTopicPlannerService)) is not PromptFlowStudio.Services.Pluto.IPlutoAutonomousTopicPlannerService planner) return;
        var seq = ++_topicPlanSeq;
        _topicPlanBusy = true;
        try
        {
            var seed = _prompt ?? "";
            if (seed.Length > 60) seed = seed[..60];
            var briefs = await planner.ProposeAsync(seed, PromptFlowStudio.Services.Pluto.PlutoAutonomousTopicPlannerService.DefaultMaxBriefs, _mediaCts.Token);
            if (_disposed || seq != _topicPlanSeq) return;
            _topicBriefs = briefs;
            if (briefs.Count == 0) _topicPlanToast = "⚠ 오답 노트를 피한 기획안을 찾지 못했어요.";
        }
        catch (OperationCanceledException) { return; }   // 페이지 이탈
        catch (Exception ex) { Program.Log("Workspace.TopicPlan", ex); _topicPlanToast = "⚠ 기획 제안 실패: " + PromptFlowStudio.Services.Pluto.PlutoAutonomousActivityFeedService.Redact(ex.Message); }
        finally { if (seq == _topicPlanSeq) _topicPlanBusy = false; }
    }

    /// <summary>🌐 Step 32 — 교차 로캘 각색 기획 적용: 원본 클립 · 대상 로캘 선택 → 로캘 업로드 패키지 생성({원본}::{로캘} 변형 멱등 분기 · 새 렌더/프롬프트 변경 없음).</summary>
    private async Task ApplyCrossLocaleBriefAsync(PromptFlowStudio.Services.Pluto.PlutoTopicBrief brief)
    {
        if (_publishPackBusy) return;
        _perfVideoId = brief.SourceClipId;
        if (!string.Equals(_publishLocale, brief.TargetLocale, StringComparison.Ordinal)) SelectPublishLocale(brief.TargetLocale);
        _topicPlanToast = "🌐 " + brief.TargetLocale + " 채널 각색 — " + brief.SourceClipId + " 로캘 업로드 패키지 생성";
        await GeneratePublishPackAsync();
    }

    /// <summary>🎯 [기획 즉시 적용] — 테마 · 시리즈 편수 · 룩 고정 · BGM · 학습 추천 갱신 · (직접 고친 자막이 없을 때만) 몽타주 재구성.</summary>
    private async Task ApplyTopicBriefAsync(PromptFlowStudio.Services.Pluto.PlutoTopicBrief brief)
    {
        if (brief is null || _topicPlanBusy || _montageBusy || State.IsBusy) return;
        if (brief.IsCrossLocale) { await ApplyCrossLocaleBriefAsync(brief); return; }
        _topicPlanBusy = true;
        try
        {
            Snap("기획 적용 전");
            _prompt = PromptFlowStudio.Services.Pluto.PlutoAutonomousTopicPlannerService.BuildReadyPrompt(brief);
            if (PromptFlowStudio.Services.Pluto.PromptDomainClassifier.IsGeneralBrief(_prompt, brief.Theme))
            {
                _babyExplicit = false;
                SyncDomainNegativeBox();
            }
            Snap("🎯 기획: " + brief.Theme);
            _appliedBriefTitle = brief.Theme;
            _plannedSeriesEpisodes = brief.IsSeries ? brief.TotalEpisodes : 0;
