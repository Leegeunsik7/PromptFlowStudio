    private bool _miniCancelled;

    /// <summary>❌ 인라인 취소 — 합본 그룹 일괄(없으면 JobId 개별) 취소 → 엔진 프로세스 킬 · ComfyUI /interrupt. 표시는 즉시 Cancelled.</summary>
    private void CancelMiniQueue()
    {
        if (_miniIds.Length == 0 || !_mini.IsActive) return;
        try
        {
            if (_miniGroup is { Length: > 0 } g) RenderQueue.CancelJobGroup(g);
            else for (var i = 0; i < _miniIds.Length; i++) RenderQueue.CancelJob(_miniIds[i]);
        }
        catch (Exception ex) { Program.Log("Workspace.MiniQueue.Cancel", ex); }
        _miniCancelled = true;
        _mini = _mini.AsCancelled();
        _durationMsg = "⏹ 렌더 취소됨 — GPU 추론 중단 신호 전송";
    }

