    private void AttachCircuitBreaker()
    {
        try
        {
            // DI 공유 싱글턴 우선(엔진과 동일 인스턴스) · 미등록 구성은 엔진 보유분으로 폴백
            _circuitBreaker = EcoSp.GetService(typeof(PromptFlowStudio.Services.Render.ProviderCircuitBreaker)) as PromptFlowStudio.Services.Render.ProviderCircuitBreaker
                ?? (EcoSp.GetService(typeof(PromptFlowStudio.Services.Render.IRenderExecutionEngine)) as PromptFlowStudio.Services.Render.VideoEngineRenderExecutionEngine)?.CircuitBreaker;
            if (_circuitBreaker is null) return;
            _circuitBreaker.StateChanged += OnCircuitStateChanged;
            _circuitRows = _circuitBreaker.GetTrippedSnapshots();
            _circuitCountdown = new PromptFlowStudio.Services.Render.ProviderCircuitCountdown(_circuitBreaker, OnCircuitCountdownTick);
        }
        catch (Exception ex) { Program.Log("Workspace.CircuitAttach", ex); }
    }

    private void OnCircuitStateChanged()
    {
        if (_disposed || _circuitBreaker is not { } breaker) return;
        try
        {
            _circuitRows = breaker.GetTrippedSnapshots();
            _ = InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) { Program.Log("Workspace.CircuitChanged", ex); }
    }

