    private string AccelClass => !State.Enabled ? "off" : State.IsBusy ? "run" : "ready";
    private string AccelLabel => !State.Enabled ? "OFFLINE" : State.IsBusy ? "RENDERING" : "READY";

    // v15.3.0 제미나이 AI 추천: 강화(누적 1회)·픽(참조 교체) 핸들러도 인스턴스당 1회 생성.
