    // ── 🎯 자동 첫 프레임 시드 고정(기본 = Gemini 키 설정 시 ON) ──
    private bool _autoAnchorOn, _anchorBusy;

    /// <summary>고정된 컷 1 참조가 없을 때 원격 첫 프레임을 자동 생성해 I2V 시드로 반환(키 없음/실패 → null · T2V).</summary>
    private async Task<string?> ResolveAutoAnchorAsync(string prompt, string? cut1Ref)
    {
        if (cut1Ref is not null || !_autoAnchorOn) return cut1Ref;
        if (_idLockOn && IdentityLockOf()?.FaceImagePath is { } face && File.Exists(face)) return null;   // 얼굴 프로필 I2V 우선
        _anchorBusy = true;
        StateHasChanged();
        try
        {
            var r = await PromptFlowStudio.Services.Render.RenderQueueService.TryAutoVisualAnchorAsync(GeminiSvc, prompt, _size, null, true,
                Path.Combine(Media.MediaRoot, "_uploads"), _mediaCts.Token);
            _ffpMsg = r.Path is null ? "ℹ " + PromptFlowStudio.Services.Pluto.PlutoAutonomousActivityFeedService.Redact(r.Message) : r.Message;
            return r.Path;
        }
        catch (Exception ex) when (ex is ObjectDisposedException or OperationCanceledException) { return null; }
        finally { _anchorBusy = false; }
    }

    private async Task Start()
    {
        if (_preflightBusy || _anchorBusy) return;
        var block = PromptFlowStudio.Services.Render.WorkspaceGenerationReadiness.Evaluate(State.IsBusy, _prompt, _imagePath, _durationMode, State.Enabled, _subPrompts);
        if (block != PromptFlowStudio.Services.Render.WorkspaceStartBlock.None)
        {
            if (PromptFlowStudio.Services.Render.WorkspaceGenerationReadiness.BlockMessage(block) is { } msg) _durationMsg = msg;
            return;
        }
        _durationMsg = null;
        var primary = EffectivePrompt;
        _learnRawPrompt = string.IsNullOrWhiteSpace(primary) ? null : primary;   // 🧠 피드백 학습 기준(원문)
        _learnRefinedPrompt = null;
        var antiArtifact = false;
        if (_preflightOn && !string.IsNullOrWhiteSpace(primary))
        {
            _preflightBusy = true;
            try
            {
                var result = await RunPreflightAsync(primary);
                _preflight = result;
                _preflightReverted = false;
                primary = result.RefinedPrompt;   // 🛡️ 비영속 — 입력 박스 원문은 그대로(↩ 1클릭 복귀)
                _learnRefinedPrompt = result.RefinedPrompt;
                antiArtifact = true;
            }
            finally { _preflightBusy = false; }
            if (State.IsBusy) return;   // 보정 대기 중 다른 경로로 생성이 시작됨
        }
        RefreshRenderMode();
        var anchored = WithIdentityAnchor(primary);   // 🍼 캐릭터 일관성 앵커(비영속 · 멱등) · 메인 비면 파트 1 폴백
        var cut1Ref = StageCut1Reference();   // 사용자 참조 우선 → 검증된 첫 화면 미리보기(토글 ON)
        if (cut1Ref is null && _autoAnchorOn)
        {
            cut1Ref = await ResolveAutoAnchorAsync(anchored, cut1Ref);   // 🎯 자동 첫 프레임 시드(원격만 · 로컬 폴백 PNG 무시)
            if (State.IsBusy || _disposed) return;   // 시드 생성 대기 중 다른 경로로 생성 시작/이탈
        }
        if (_durationMode != PromptFlowStudio.Services.Render.VideoDurationMode.Sec5_Single) { EnqueueDuration(anchored, cut1Ref, antiArtifact); return; }
        _canvasQueueUrl = _canvasQueuePath = null;   // 단일 생성 — 캔버스를 라이브 진행 표시로 복귀
        // v16.20.0 미세 표정 퍼핏 — 표정 구문·정체성 유지·얼굴 보호 네거티브 비영속 주입(Neutral 은 원문 그대로).
        // v16.22.0 피사체 Identity 고정 — 프로필 정체성/의상/스타일 구문(비영속) · 얼굴 사진 I2V(사용자 이미지 우선) · 프로필 시드(핀 우선).
        var idLock = _idLockOn ? IdentityLockOf() : null;
        var domainNeg = EffectiveNegative(anchored);   // 🧭 GeneralCinematic → 아기 전용 네거티브 미주입
        if (RunCoherenceGate(anchored, domainNeg, null, null, null, _size) is { WasAutoSanitized: true } gate) domainNeg = gate.SanitizedNegativePrompt;   // 🧩 프리플라이트 보정본
        if (antiArtifact) domainNeg = PromptFlowStudio.Services.AI.PromptPreflightDirector.MergeNegative(domainNeg, out _);   // 🛡️ 안티 아티팩트 네거티브(중복 없이)
        var (lockedPrompt, lockedNeg) = idLock is null ? (anchored, domainNeg) : EpisodicStorySeriesBuilder.ComposeScenePrompt(anchored, domainNeg, idLock);
        var emo = FacialEmotionPuppeteerEngine.Apply(lockedPrompt, lockedNeg, _emotion, _emotionIntensity);
        var faceRef = idLock?.FaceImagePath is { } fp && File.Exists(fp) ? fp : null;
        var req = new WanVideoRequest
        {
            Prompt = emo.Prompt,
            Size = _size,
            ImagePath = cut1Ref ?? faceRef,   // null → t2v · 존재 → i2v(백엔드가 업로드→img_url 바인딩) · 사용자 이미지 > 첫 화면 미리보기 > 얼굴
            LastFramePath = _imagePath is null ? null : _lastImagePath,   // v16.5.0: 첫+끝 → kf2v 보간
            NegativePrompt = emo.Negative,           // 비어 있으면 서비스가 필드 생략
            Seed = _canvas.EffectiveSeed ?? (idLock is { Seed: > 0 } ? idLock.Seed : null),   // 핀 해제 시 프로필 시드 → 없으면 서버 랜덤
            Tuning = _canvas.Snapshot(),             // 값 형식 스냅숏(0B)
        };
        _ = State.StartAsync(req);    // fire-and-forget — 진행은 OnChange 로 반영된다.
    }

