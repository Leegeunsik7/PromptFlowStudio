    private string CurrentBgmMood() => _customBgm is not null ? "custom" : _bgmOn ? _bgmTrack.ToString() : "none";

    // ── 🧩 Step 14 — 렌더 직전 교차 모달 정합성 게이트(보정/경고가 있을 때만 배지 표시) ──
    private string? _coherenceBadge;
    private string _coherenceDetail = "";
    private int _coherenceScore = 100;

    /// <summary>🧩 프리플라이트 감사 — 보정본(네거티브 · 자막 큐)을 돌려주고 배지 갱신. 서비스 미등록/예외 → 입력 그대로(렌더를 막지 않음).</summary>
    private PromptFlowStudio.Services.Pluto.PlutoCoherenceAuditReport? RunCoherenceGate(string? prompt, string? negative,
        IReadOnlyList<PromptFlowStudio.Services.Export.SubtitleCue>? cues, string? hook, string? look, string aspect)
    {
        try
        {
            if (EcoSp.GetService(typeof(PromptFlowStudio.Services.Pluto.IPlutoPreRenderCoherenceGuard)) is not PromptFlowStudio.Services.Pluto.IPlutoPreRenderCoherenceGuard guard) return null;
            var bgm = CurrentBgmMood();
            var report = guard.Audit(new PromptFlowStudio.Services.Pluto.PlutoPreRenderCoherenceRequest(
                PromptFlowStudio.Services.Pluto.PromptDomainClassifier.Classify(prompt, _babyExplicit), prompt, negative, cues, hook, look,
                string.Equals(bgm, "none", StringComparison.Ordinal) || string.Equals(bgm, "custom", StringComparison.Ordinal) ? null : bgm, aspect));
            _coherenceScore = report.CoherenceScore0To100;
            if (report.HasFindings)
            {
                _coherenceBadge = report.SummaryKorean + (report.WarningsKorean.Count > 0 ? " — " + report.WarningsKorean[0] : "");
                _coherenceDetail = string.Join(" / ", report.SanitizationsKorean) + (report.SanitizationsKorean.Count > 0 && report.WarningsKorean.Count > 0 ? " / " : "") + string.Join(" / ", report.WarningsKorean);
            }
            else { _coherenceBadge = null; _coherenceDetail = ""; }
            return report;
        }
        catch (Exception ex) { Program.Log("Workspace.CoherenceGate", ex); return null; }
    }

    private string PerfHookFromPrompt()
    {
        var p = (_prompt ?? "").Trim();
        return p.Length == 0 ? "prompt-hook" : p.Length > 60 ? p[..60] : p;
    }

    private static readonly char[] s_perfTagSeparators = { ',', '#', ' ' };

    private static string[] SplitPerfTags(string raw)
    {
        var parts = raw.Split(s_perfTagSeparators, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length > 8 ? parts[..8] : parts;
    }

    /// <summary>🧾 렌더 완료 → 성과 피드백 입력 자동 채움(VideoId · HookStyle · ColorLookId · BgmMood · StyleTags). 지표 입력값은 유지.</summary>
    private void CapturePerfContext(string? renderedPath, string source, string? hook, string? look)
    {
        if (string.IsNullOrWhiteSpace(renderedPath)) return;
        _perfVideoId = Path.GetFileNameWithoutExtension(renderedPath);
        _perfHookStyle = hook ?? (_montageCues is { Count: > 0 } mc && !string.IsNullOrWhiteSpace(mc[0].Text) ? mc[0].Text.Trim() : "montage-hook");
        _perfLookId = string.IsNullOrWhiteSpace(look) ? _montageLook : look;
        _perfBgmMood = CurrentBgmMood();
        _perfStyleTags = string.Join(", ", ActiveViralTagsSafe(3));
        _perfContextSource = source;
        _perfOutcome = null;
        // 🔍 마스터 ↔ 작업 공간 지문(전 언어 일괄 렌더 시 불일치 경고용)
        _renderedMasterVideoId = _perfVideoId;
        _renderedMasterFingerprint = PromptFlowStudio.Services.Pluto.PlutoMultiLocaleBatchRenderService.ComputeWorkspaceFingerprint(_montagePhotos, _montageCues);

        // 🎞️ 카탈로그 영속 — 시리즈 편은 편 제목 · 편 번호 모드로 기록(덮어쓰기 없이 편별 선택 가능)
        var title = _perfVideoId;
        var mode = source;
        if (_series is { } ser && _seriesActiveEpisode > 0 && string.Equals(source, "몽타주", StringComparison.Ordinal)
            && string.Equals(_seriesEpisodeKey, string.Join("|", _montagePhotos), StringComparison.Ordinal))
        {
            mode = "시리즈 " + _seriesActiveEpisode.ToString(CultureInfo.InvariantCulture) + "/" + ser.Episodes.Count.ToString(CultureInfo.InvariantCulture) + "편";
            foreach (var ep in ser.Episodes)
                if (ep.EpisodeNumber == _seriesActiveEpisode && !string.IsNullOrWhiteSpace(ep.EpisodeTitle)) { title = ep.EpisodeTitle.Trim(); break; }
            _perfContextSource = mode;
        }
        var record = new PromptFlowStudio.Services.Pluto.PlutoRenderedClipRecord(_perfVideoId, title, mode, _perfHookStyle, _perfLookId, _perfBgmMood,
            SplitPerfTags(_perfStyleTags), renderedPath, DateTimeOffset.UtcNow, false);
        // 🎯 Step 27 — [기획 즉시 적용] 출처 찍기(룩/BGM 을 바꿨으면 기획 책임 아님 · 편수 예산 · 48시간 TTL)
        try { record = PromptFlowStudio.Services.Pluto.PlutoBriefOutcomeAttributionService.StampProvenance(record, _appliedBriefArm, DateTimeOffset.UtcNow, ReferenceEquals(mode, source) ? 0 : _seriesActiveEpisode, out _appliedBriefArm, out _); }
        catch (Exception ex) { Program.Log("Workspace.BriefProvenance", ex); }
        // ⚡ 시리즈 편은 아크 메모리에 즉시 반영(동기 write-through) — 카탈로그 기록(비동기)이 끝나기 전에 다음 편을 불러와도 이 편의 룩/BGM 이 앵커로 이어진다
        try { if (SeriesArcMemory() is { } arcMem && arcMem.RecordRenderedEpisode(record)) RefreshSeriesSeasonInfo(); }
        catch (Exception ex) { Program.Log("Workspace.SeriesWriteThrough", ex); }
        _ = RecordCatalogClipAsync(record);
    }

