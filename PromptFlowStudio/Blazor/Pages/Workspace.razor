    private Action[][] _babyActs = { Array.Empty<Action>(), Array.Empty<Action>(), Array.Empty<Action>() };
    private Action[] _babyTabSel = Array.Empty<Action>();
    private void BuildBabyInjectors()
    {
        var tabs = new Action[BabyTabNames.Length];
        var acts = new Action[BabyTabNames.Length][];
        for (var t = 0; t < tabs.Length; t++)
        {
            var tab = t;
            tabs[t] = () => _babyTab = tab;
            var src = BabyCatalog(t);
            var arr = new Action[src.Length];
            for (var i = 0; i < arr.Length; i++)
            {
                var idx = i;
                arr[i] = tab == 2
                    ? () => _prompt = BabyStudioMatrix.AppendModifier(_prompt, idx)
                    : () => { _prompt = _baby.ApplyTheme(src, idx, _prompt); _canvas.FaceSharpen = true; };
            }
            acts[t] = arr;
        }
        _babyTabSel = tabs;
        _babyActs = acts;
    }

    // v15.4.0 라이브 캔버스 튜너: 값 필드만 갱신(클램프), 요약 문자열은 변경 후 첫 렌더에서만 생성.
    private readonly LiveVideoCanvasStudio _canvas = new();
    private void RollSeed() => _canvas.Seed = Random.Shared.Next();

    // v15.6.0 Wan 2.1 카메라·스타일: 그룹 배타 결합 핸들러 1회 생성 · 가속 배지는 리터럴만.
    private Action[] _zenCam = Array.Empty<Action>();
