    private static string FormatMmSs(double sec)
    {
        var t = (int)Math.Floor(Math.Max(0, sec) + 1e-6);
        return (t / 60).ToString("00", CultureInfo.InvariantCulture) + ":" + (t % 60).ToString("00", CultureInfo.InvariantCulture);
    }

    /// <summary>🎵 음원 업로드 → 하이라이트 자동 추출 → 프리뷰/궤적/몽타주 재정렬. 실패 → 기존 상태 유지 + 안내.</summary>
    private async Task OnCustomBgmPickedAsync(InputFileChangeEventArgs e)
    {
        if (_customBgmBusy) return;
        var file = e.File;
        _customBgmError = null;
        if (file.Size > PromptFlowStudio.Services.Pluto.PlutoCustomBgmService.MaxUploadBytes) { _customBgmError = "BGM 파일은 최대 25MB 까지 업로드할 수 있습니다."; return; }
        _customBgmBusy = true;
        StateHasChanged();
        try
        {
            var ct = _mediaCts.Token;
            byte[] bytes;
            await using (var src = file.OpenReadStream(PromptFlowStudio.Services.Pluto.PlutoCustomBgmService.MaxUploadBytes, ct))
            using (var ms = new MemoryStream((int)Math.Max(0, file.Size)))
            {
                await src.CopyToAsync(ms, ct);
                bytes = ms.ToArray();
            }
            var hl = await CustomBgm.LoadAndExtractHighlightAsync(file.Name, bytes, null, ct);
            _customBgmSource = bytes;
            _customBgmName = file.Name;
            await ApplyCustomBgmAsync(hl);
        }
        catch (OperationCanceledException) { }   // 페이지 이탈
        catch (InvalidOperationException ex) { _customBgmError = PromptFlowStudio.Services.Pluto.PlutoAutonomousActivityFeedService.Redact(ex.Message); }
        catch (Exception ex) { Program.Log("Workspace.CustomBgm", ex); _customBgmError = "BGM 업로드 실패: " + PromptFlowStudio.Services.Pluto.PlutoAutonomousActivityFeedService.Redact(ex.Message); }
        finally { _customBgmBusy = false; }
        if (_disposed) return;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>🎵 하이라이트 창 ±1초 이동(경계 클램프 · 스냅 없음) → 재정렬.</summary>
    private async Task NudgeCustomBgmAsync(int deltaSec)
    {
        if (_customBgmBusy || _customBgm is not { } cur || _customBgmSource is not { } src) return;
        _customBgmBusy = true;
        _customBgmError = null;
        try
        {
            var hl = await CustomBgm.LoadAndExtractHighlightAsync(_customBgmName ?? "custom.wav", src, cur.StartOffsetSec + deltaSec, _mediaCts.Token);
            await ApplyCustomBgmAsync(hl);
        }
        catch (OperationCanceledException) { }
        catch (InvalidOperationException ex) { _customBgmError = PromptFlowStudio.Services.Pluto.PlutoAutonomousActivityFeedService.Redact(ex.Message); }
        catch (Exception ex) { Program.Log("Workspace.CustomBgmNudge", ex); _customBgmError = "하이라이트 이동 실패: " + PromptFlowStudio.Services.Pluto.PlutoAutonomousActivityFeedService.Redact(ex.Message); }
        finally { _customBgmBusy = false; }
        if (_disposed) return;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>🎵 하이라이트 WAV → 미디어 루트(가상호스트) → 프리뷰 URL · 단일 궤적/몽타주 비트 재정렬.</summary>
    private async Task ApplyCustomBgmAsync(PromptFlowStudio.Services.Pluto.Dsp.PlutoHighlightClipResult hl)
    {
        var dir = Path.Combine(Media.MediaRoot, "bgm");
        var path = Path.Combine(dir, "custom_hl_" + Guid.NewGuid().ToString("N") + ".wav");
        await Task.Run(() => { Directory.CreateDirectory(dir); File.WriteAllBytes(path, hl.CroppedWavBytes); });
        if (_disposed) { TryDeleteCustomBgmFile(path); return; }
        var old = _customBgmPath;
        _customBgm = hl;
        _customBgmPath = path;
        _customBgmUrl = Media.ToPlaybackUrl(path);
        TryDeleteCustomBgmFile(old);
        _ = RefreshMotionBeatSyncAsync(null);   // 🥁 단일 사진 궤적 · SFX 큐 → 하이라이트 비트
        await RefreshMontagePreviewAsync();     // 🎞 몽타주 컷 → 하이라이트 비트
    }

    /// <summary>🎵 커스텀 BGM 해제 → 합성 트랙 복원(비트 재검출).</summary>
    private async Task ClearCustomBgmAsync()
    {
        if (_customBgmBusy) return;
        TryDeleteCustomBgmFile(_customBgmPath);
        _customBgm = null;
        _customBgmName = null;
        _customBgmSource = null;
        _customBgmUrl = null;
        _customBgmPath = null;
        _customBgmError = null;
        await RefreshMotionBgmAsync();
        await RefreshMontagePreviewAsync();
    }

    private static void TryDeleteCustomBgmFile(string? path)
    {
        if (string.IsNullOrEmpty(path)) return;
        try { if (File.Exists(path)) File.Delete(path); }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException) { Program.Log("Workspace.CustomBgmCleanup", ex); }
    }

