    private void ApplyUserPreset(PromptFlowStudio.Services.Prompt.WorkspaceUserPreset preset)
    {
        if (State.IsBusy || preset is null) return;
        var prompt = ReapplyByLabel(preset.Prompt, WanCameraStyleStudio.Cameras, preset.CameraMotion, cam: true);
        prompt = ReapplyByLabel(prompt, WanCameraStyleStudio.Styles, preset.Style, cam: false);
        _prompt = prompt;
        _vm.UserInput = _prompt;
        _baby.NegativePrompt = preset.NegativePrompt;
        _durationMode = preset.DurationMode;
        _durationMsg = null;
        Array.Clear(_subPrompts);
        _upMsg = "⭐ 프리셋 적용 · " + preset.Name;
    }

    private static string ReapplyByLabel(string prompt, PromptChip[] group, string label, bool cam)
    {
        if (label.Length == 0) return prompt;
        for (var i = 0; i < group.Length; i++)
        {
            if (!string.Equals(group[i].Label, label, StringComparison.Ordinal)) continue;
            if (WanCameraStyleStudio.ActiveIndex(prompt, group) == i) return prompt;
            return cam ? WanCameraStyleStudio.ApplyCamera(prompt, i) : WanCameraStyleStudio.ApplyStyle(prompt, i);
        }
        return prompt;
    }

