    private string? _lastImagePath, _lastImageName, _lastImagePreview;

    // ── v16.5.0 🔄 영상 반전(FFmpeg -vf reverse) — 반전본은 원본 LocalPath 단위로 캐시 · 토글 ──
    private string? _reversedFor, _reversedUrl, _reverseMsg;
    private bool _reversing, _showReversed;

    // ── v16.22.0 피사체 Identity 고정 ──
    private string _idProfileId = "";
    private bool _idLockOn, _characterOpen;
    private string? _idScoreText, _idScoredFor;

    private CharacterProfile? SelectedProfile => SeriesBuilder.FindProfile(_idProfileId);

    private CharacterLockSnapshot? IdentityLockOf()
    {
        if (SelectedProfile is not { } p) return null;
        var probe = new StoryboardProject();
        EpisodicStorySeriesBuilder.Propagate(probe, p);
        return probe.CharacterLock;
