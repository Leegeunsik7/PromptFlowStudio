    .ws-vf.i2v-hot { border: 1px solid #f472b6; box-shadow: 0 0 0 2px color-mix(in srgb, #f472b6 35%, transparent), 0 0 24px color-mix(in srgb, #f472b6 40%, transparent); animation: ws-i2v-pulse 1.6s ease-in-out 3; }
