    /// 렌더 중에는 입력 폼을 건드리지 않는다.
    /// </summary>
    private void RehydrateFromRecent(MediaItem item)
    {
        if (State.IsBusy || item is null) return;
        try
        {
            var snap = PromptFlowStudio.Services.Gallery.WorkspaceRehydration.Load(item.Path);
            var isVideo = item.PosterUrl is null;
            if (isVideo)
            {
                _canvasQueueUrl = item.PlaybackUrl;
                _canvasQueuePath = item.Path;
            }
            if (snap.HasMetadata)
            {
                if (snap.Prompt.Length > 0) { _prompt = snap.Prompt; _vm.UserInput = _prompt; }
                _durationMode = snap.DurationMode;
                _durationMsg = null;
                Array.Clear(_subPrompts);
                if (!string.Equals(_size, snap.WorkspaceSize, StringComparison.Ordinal)) { _size = snap.WorkspaceSize; _vm.SetOutputSize(_size); }
                if (snap.Seed > 0) { _canvas.SeedPinned = true; _canvas.Seed = snap.Seed; }
            }
            _camToast = snap.HasMetadata
                ? "♻️ 작업 설정 복원 · " + PromptFlowStudio.Services.Render.MultiDurationPlanner.Label(snap.DurationMode) + " · " + snap.AspectRatio
                  + (snap.CameraMotion.Length > 0 ? " · 🎥 " + snap.CameraMotion : "")
                : "ℹ️ 저장된 작업 메타가 없어 영상만 불러왔습니다";
        }
        catch (Exception ex) { Program.Log("Workspace.Rehydrate", ex); }
        StateHasChanged();
    }

