    // ── 작업실 인라인 큐 진행률(MiniQueueProgress) — 적재 작업 JobId 추적 → 컷 진행/합본 → 완료 시 인라인 자동 재생 ──
    private Guid[] _miniIds = Array.Empty<Guid>();
    private string? _miniGroup, _miniUrl, _miniPlayed, _miniStitchFail, _miniError, _miniNotice, _canvasQueueUrl, _canvasQueuePath;
