    private async Task PairYouTubeRowAsync(string youTubeVideoId, string clipVideoId)
    {
        if (_ytPairBusy || _ytUnmatchedSvc is not { } q) return;
        _ytPairBusy = true;
        try
        {
            var r = await q.PairAsync(youTubeVideoId, clipVideoId, _perfPlatform, _mediaCts.Token);
            _ytPairToast = r.MessageKorean;
            if (r.Succeeded)
            {
                await RefreshCatalogClipsAsync();
                await RefreshAdaptiveRecommendationAsync();   // 🧠 폐루프 → 순방향 랭킹
                await RefreshBrainSummaryAsync();
            }
            await RefreshYouTubeUnmatchedAsync();
        }
        catch (OperationCanceledException) { return; }
        catch (Exception ex) { Program.Log("Workspace.YouTubePair", ex); _ytPairToast = "⚠ 연결 실패: " + PromptFlowStudio.Services.Pluto.PlutoAutonomousActivityFeedService.Redact(ex.Message); }
        finally { _ytPairBusy = false; }
        if (_disposed) return;
        await InvokeAsync(StateHasChanged);
    }

