    //   테마 클릭 → 정적 리터럴 참조 대입(0B) + 얼굴 보호 네거티브 CAS 결합, 모디파이어 클릭 → span 결합(결과 문자열 1회).
    private static readonly string[] BabyTabNames = { "🍼 감성 성장", "🧚 몽환 동화", "🎥 모디파이어" };
    private static PromptChip[] BabyCatalog(int tab) => tab switch
    {
        0 => BabyStudioMatrix.Growth,
        1 => BabyStudioMatrix.Fantasy,
        _ => BabyStudioMatrix.Modifiers,
    };
    private readonly BabyStudioSession _baby = new();
