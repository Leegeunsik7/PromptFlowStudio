    /// <summary>🧯 회로 폐기 경합 안전 — InvokeAsync 자체의 ObjectDisposed/InvalidOperation(디스패처 소멸)을 흡수.</summary>
    private void SafeUiUpdate(Func<Task> work, string tag)
    {
        try
        {
            _ = InvokeAsync(async () =>
            {
                if (_disposed) return;
                try
                {
                    await work();
                    if (!_disposed) StateHasChanged();
                }
                catch (OperationCanceledException) { }
                catch (ObjectDisposedException) { }
                catch (Exception ex) { Program.Log(tag, ex); }
            }).ContinueWith(static t => _ = t.Exception, TaskContinuationOptions.OnlyOnFaulted);
        }
        catch (Exception ex) when (ex is ObjectDisposedException or InvalidOperationException) { /* 회로 종료 직후 */ }
    }

