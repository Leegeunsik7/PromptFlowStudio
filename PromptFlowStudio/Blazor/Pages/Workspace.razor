    .ws-jbadge { cursor: pointer; animation: none; }
    .ws-retry { font: 700 11px/1 var(--mono); padding: 4px 10px; border-radius: 999px; border: 1px solid rgba(96,165,250,.45); color: #93c5fd; background: rgba(96,165,250,.08); }
    .ws-jmodal-bg { position: fixed; inset: 0; z-index: 900; background: rgba(0,0,0,.55); display: flex; align-items: center; justify-content: center; }
    .ws-jmodal { width: min(920px, 94vw); max-height: 80vh; overflow: auto; padding: 14px 16px; border-radius: 12px; background: #0d0b16; border: 1px solid var(--line); }
