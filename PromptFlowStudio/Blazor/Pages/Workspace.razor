    private async Task SubmitPerformanceAsync()
    {
        if (_perfBusy) return;
        var svc = EcoSp.GetService(typeof(PromptFlowStudio.Services.Pluto.IPlutoClosedLoopReinforcementService)) as PromptFlowStudio.Services.Pluto.IPlutoClosedLoopReinforcementService;
        if (svc is null) { _snsToast = "⚠ 성과 학습 서비스를 사용할 수 없습니다."; return; }
        var videoId = string.IsNullOrWhiteSpace(_perfVideoId) ? "" : _perfVideoId.Trim();
        if (videoId.Length == 0) { _snsToast = "⚠ 영상 ID를 입력하세요."; return; }
        _perfBusy = true;
        StateHasChanged();
        try
        {
            var hook = !string.IsNullOrWhiteSpace(_perfHookStyle) ? _perfHookStyle.Trim()
                : _montageCues is { Count: > 0 } mc && !string.IsNullOrWhiteSpace(mc[0].Text) ? mc[0].Text.Trim() : "montage-hook";
            var look = string.IsNullOrWhiteSpace(_perfLookId) ? _montageLook : _perfLookId.Trim();
            var bgm = string.IsNullOrWhiteSpace(_perfBgmMood) ? CurrentBgmMood() : _perfBgmMood.Trim();
            var tags = string.IsNullOrWhiteSpace(_perfStyleTags) ? ActiveViralTagsSafe(3) : SplitPerfTags(_perfStyleTags);
            var telemetry = new PromptFlowStudio.Services.Pluto.PlutoVideoPerformanceTelemetry(videoId, _perfPlatform, hook, look,
                bgm, tags,
                _perfHook, _perfCompletion, _perfCtr, DateTimeOffset.UtcNow) { Domain = PromptDomain.ToString(), RenderMode = await ResolvePerfRenderModeAsync(videoId) };   // 🧭 domain_hook 상호작용 키 · 📐 컨텍스트 기준선(ctx:)
            _perfOutcome = await svc.IngestPerformanceAsync(telemetry, _mediaCts.Token);
            _snsToast = null;
            try
            {
                if (EcoSp.GetService(typeof(PromptFlowStudio.Services.Pluto.IPlutoRenderCatalogService)) is PromptFlowStudio.Services.Pluto.IPlutoRenderCatalogService cat)
                    await cat.MarkTelemetryLoggedAsync(videoId, _mediaCts.Token);   // 🎞️ ⏳ 미학습 → ✅ 학습완료
            }
            catch (OperationCanceledException) { throw; }
            catch (Exception ex) { Program.Log("Workspace.RenderCatalogMark", ex); }
            await RefreshCatalogClipsAsync();
            await RefreshAdaptiveRecommendationAsync();   // 🧠 폐루프 → 순방향 랭킹 즉시 반영
            await RefreshBrainSummaryAsync();   // 🧠 두뇌 리포트 갱신
        }
        catch (OperationCanceledException) { return; }   // 페이지 이탈
        catch (Exception ex) { Program.Log("Workspace.PerfFeedback", ex); _snsToast = "⚠ 성과 학습 반영 실패: " + PromptFlowStudio.Services.Pluto.PlutoAutonomousActivityFeedService.Redact(ex.Message); }
        finally { _perfBusy = false; }
        if (_disposed) return;
        await InvokeAsync(StateHasChanged);
    }

