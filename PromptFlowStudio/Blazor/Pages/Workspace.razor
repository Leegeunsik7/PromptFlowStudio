        AbsorbWirelessCameraFrame();   // 무선 카메라(/wireless-camera)에서 전달된 I2V 첫 프레임 흡수
        AbsorbGalleryRestore();        // 갤러리(/gallery) ✨ 작업실 복원 — 프롬프트·시드·해상도·I2V 참조 이미지 주입
        _guardOn = TradingGuard.IsThrottling;
        RefreshSession();
        _ = GuardTickLoopAsync(_guardCts.Token);   // 🛡️ 10초 주기 장중 판정 — 09:00 개장/15:30 마감 인디케이터 자동 전환
