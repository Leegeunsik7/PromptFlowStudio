                var dir = Path.Combine(Media.MediaRoot, "bgm");
                var wav = await Task.Run(() => PromptFlowStudio.Services.Export.StockSuiteExporter.EnsureBabyBgm(track, 30, dir));
                url = wav is null ? null : Media.ToPlaybackUrl(wav);
            }
            await JS.InvokeAsync<bool>("pfsBgmPreview.set", _bgmOn && url is not null, url, PromptFlowStudio.Services.Export.StockSuiteExporter.BabyBgmVolume, "video.ws-video");
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
        {
            Program.Log("Workspace.BgmPreview", ex);
        }
    }
