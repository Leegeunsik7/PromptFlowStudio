    private void CloseCharacterStudio()
    {
        _characterOpen = false;
        if (SelectedProfile is null && SeriesBuilder.Profiles.Count > 0) _idProfileId = SeriesBuilder.Profiles[0].Id;
    }

    private async Task ScoreIdentityAsync(string videoPath)
    {
        try
        {
            if (SelectedProfile is not { HasFace: true } p) { _idScoreText = "정합성: 프로필 얼굴 특징 없음"; return; }
            var s = await SeriesBuilder.Identity.ScoreAsync(p, videoPath, _mediaCts.Token);
            _idScoreText = s.Verdict == IdentityVerdict.Unknown ? "정합성 측정 실패(ffmpeg 확인)"
                : "👶 정합성 " + s.Confidence.ToString("0.0", CultureInfo.InvariantCulture) + "% · " + CharacterIdentityLockService.VerdictLabel(s.Verdict)
                  + (s.Verdict == IdentityVerdict.Lost ? " — 재생성 권장" : "");
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Program.Log("Workspace.IdentityScore", ex); _idScoreText = "정합성 측정 오류"; }
        await InvokeAsync(StateHasChanged);
    }

    // ── v16.20.0 AI 정밀 립싱크 & 미세 표정 ──
    private static readonly FacialEmotion[] WorkspaceEmotions = { FacialEmotion.HappySmile, FacialEmotion.Curious, FacialEmotion.Surprised, FacialEmotion.Giggle, FacialEmotion.Pout };
    private FacialEmotion _emotion;
    private double _emotionIntensity = FacialEmotionPuppeteerEngine.DefaultIntensity;
    private bool _lipOn, _lipBusy;
    private string _lipText = "";
    private string? _lipMsg, _lipUrl;

    /// <summary>대사 TTS → 오케스트레이터(원격 API → LatentSync → FFmpeg 프레임 보정) · 결과는 별도 파일(원본 유지).</summary>
    private async Task RealignLipSyncAsync()
    {
        if (_lipBusy || State.LocalPath is not { } src || string.IsNullOrWhiteSpace(_lipText)) return;
        _lipBusy = true;
        _lipUrl = null;
        _lipMsg = "🎙️ 나레이션 합성 중…";
        try
        {
            var ct = _mediaCts.Token;
            var audio = await Tts.SynthesizeAsync(_lipText, NarrationTone.FairyTale, 1.0, TtsProvider.Auto, ct);
            if (audio is null) { _lipMsg = "⚠ 나레이션 합성 실패(TTS 엔진/네트워크 확인)"; return; }
            var dir = Path.GetDirectoryName(src) ?? Media.MediaRoot;
            var output = Path.Combine(dir, Path.GetFileNameWithoutExtension(src) + "_lipsync.mp4");
            var status = new Progress<string>(s => { _lipMsg = s; _ = InvokeAsync(StateHasChanged); });
            var r = await LipAi.SyncAsync(new AudioLipSyncRequest(src, audio, output, _lipText + " " + (_prompt ?? ""), _emotion, _emotionIntensity), status, ct);
            if (r.Ok && r.OutputPath is not null)
            {
                _lipUrl = Media.ToPlaybackUrl(r.OutputPath) + "?v=" + DateTime.Now.Ticks.ToString(CultureInfo.InvariantCulture);
                _lipMsg = "✅ " + r.Message + " · 음소 " + r.Visemes.Count.ToString(CultureInfo.InvariantCulture) + "구간";
            }
            else _lipMsg = "⚠ " + r.Message;
        }
        catch (OperationCanceledException) { _lipMsg = "취소됨"; }
        catch (Exception ex) { Program.Log("Workspace.LipSync", ex); _lipMsg = "⚠ 립싱크 실패: " + ex.Message; }
        finally { _lipBusy = false; }
    }
    private bool IsShowingReversed => _showReversed && _reversedUrl is not null && string.Equals(_reversedFor, State.LocalPath, StringComparison.Ordinal);
    private string? ShownVideoUrl => IsShowingReversed ? _reversedUrl : State.VideoUrl;

    private async Task ToggleReverse()
    {
        if (_reversing || State.LocalPath is not { } src) return;
        if (_reversedUrl is not null && string.Equals(_reversedFor, src, StringComparison.Ordinal)) { _showReversed = !_showReversed; return; }
        _reversing = true;
        _reverseMsg = "🔄 반전 중…";
        try
        {
            var r = await VideoReverseService.ReverseAsync(src);
            if (r.Ok && r.OutputPath is not null)
            {
                _reversedFor = src;
                _reversedUrl = Media.ToPlaybackUrl(r.OutputPath);
                _showReversed = true;
                _reverseMsg = "✅ 반전 완료 · " + r.ElapsedMs.ToString(CultureInfo.InvariantCulture) + "ms";
            }
            else _reverseMsg = "⚠ " + r.Message;
        }
        finally { _reversing = false; }
