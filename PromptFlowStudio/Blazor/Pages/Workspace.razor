@code {
    private string _prompt = "";

    // 2번 워크플로우: 입력 대본 → StoryboardViewModel 컷 전개 후 스토리보드 화면 전환(빈 대본은 4컷 기본 시놉시스).
    private const string DefaultStorySynopsis = "아침 햇살이 드는 방에서 주인공이 눈을 뜬다.\n창밖을 바라보며 무언가를 결심한다.\n거리로 나서 목적지를 향해 걷는다.\n노을 아래 목적지에 도착해 미소 짓는다.";
    private void SendScriptToStoryboard()
    {
        var script = string.IsNullOrWhiteSpace(_prompt) ? DefaultStorySynopsis : _prompt;
        if (!StoryVm.ReceiveGeneratedScript(script)) StoryVm.ReceiveGeneratedScript(DefaultStorySynopsis);
        Nav.NavigateTo("storyboard");
    }
    // 단일 콘셉트 원클릭 확장: 1번 컷 = 현재 프롬프트, 2~4번 = 기승전결 뼈대, 시드 핀 값(미고정이면 콘셉트 결정적 시드) 계승.
    private void ExpandToStoryboard()
    {
        if (!StoryVm.ExpandFromWorkspace(_prompt, _canvas.EffectiveSeed)) return;
        Nav.NavigateTo("storyboard");
    }
    private string _size = "1280*720";
    private bool _safeZone = true;   // 숏츠 세이프존 오버레이(세로 결과일 때만 표시)

    /// <summary>선택 해상도가 세로(쇼츠) 비율인지 — "가로*세로"에서 세로가 더 크면 true.</summary>
    private bool IsPortrait
    {
        get { var p = _size.Split('*', 'x', 'X'); return p.Length == 2 && int.TryParse(p[0], out var w) && int.TryParse(p[1], out var h) && h > w; }
    }

