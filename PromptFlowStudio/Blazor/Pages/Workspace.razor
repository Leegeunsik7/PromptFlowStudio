                        @if (_growthBadge) { <div class="ws-growth-badge" role="button" title="@(_identity is not null ? "클릭해 우리 아이 프로필 편집" : "클릭해 D-day · 문구 편집")" data-growth-badge="@GrowthBadgeLabel" @onclick="OnGrowthBadgeClick">@GrowthBadgeLabel</div> @if (_badgeEdit) { <input class="ws-growth-edit" placeholder="예: D+100 · 우리아기 첫돌" maxlength="40" @bind="_badgeCustom" @bind:event="oninput" /> } }
                    </div>
                }
                @ScrubBar
                <div class="ws-done">
                    @if (IsPortrait)
                    {
                        <label class="ws-sztog" title="유튜브 숏츠 UI 가림 영역 미리보기">
                            <input type="checkbox" @bind="_safeZone" />
                            <span>🛡️ 숏츠 UI 가이드</span>
                        </label>
                    }
                    @if (State.IsLocal)
                    {
                        <span class="ws-src ok">💾 로컬 저장됨</span>
