    private async Task OpenPublish(string path)
    {
        try
        {
            // 산출물 사이드카 메타 우선(최근 미디어 역복원 영상 등) → 없으면 현재 입력 폼 프롬프트 · 듀레이션.
            var snap = PromptFlowStudio.Services.Gallery.WorkspaceRehydration.Load(path);
            var prompt = snap.HasMetadata && snap.Prompt.Length > 0 ? snap.Prompt : _prompt;
            var mode = snap.HasMetadata ? snap.DurationMode : _durationMode;
            PubVm.OpenForMedia(path, Path.GetFileNameWithoutExtension(path), Path.ChangeExtension(path, ".srt"), string.IsNullOrWhiteSpace(prompt) ? null : prompt,
                PromptFlowStudio.Services.Gallery.WorkspaceRehydration.SecondsOf(mode));
            // 🎞️ 스크러버 동기 — 동일 영상이 재생기에 로드돼 있으면 현재 재생 위치를 미리보기 시각으로(실패 = 기본 1초 유지).
            if (InspectPath is { } ip && string.Equals(ip, path, StringComparison.OrdinalIgnoreCase) && await ReadPlayheadAsync() is { } st)
                PubVm.PreviewTimestampSec = st[0];
        }
        catch (Exception ex) { Program.Log("Workspace.Publish", ex); }
    }

