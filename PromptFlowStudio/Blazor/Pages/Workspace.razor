    private PromptFlowStudio.Services.Pluto.Dsp.PlutoHighlightClipResult? _customBgm;
    private string? _customBgmName;
    private byte[]? _customBgmSource;   // 원본 업로드(±1s 넛지 재추출 · 서비스가 디코드 캐시)
    private string? _customBgmUrl;      // 🎞 프리뷰 하이라이트 WAV(가상호스트 URL)
    private string? _customBgmPath;
