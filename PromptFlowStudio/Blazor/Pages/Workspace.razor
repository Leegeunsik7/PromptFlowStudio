    /// <summary>10s/15s/Ambient — 렌더 큐 적재(멀티 샷 체이닝·합본 / 앰비언트 루프 후처리는 큐 워커·엔진이 수행).</summary>
    private void EnqueueDuration(string prompt, string? cut1Ref, bool antiArtifact = false)
    {
        RefreshRenderMode();   // 렌더 시작 직전 최신 [환경설정] 모드 재조회
        var project = "ws_" + DateTime.Now.ToString("yyyyMMdd_HHmmss", CultureInfo.InvariantCulture);
        var meta = _durationMode == PromptFlowStudio.Services.Render.VideoDurationMode.Sec15_AmbientSlow && _ambientPingPong
            ? new Dictionary<string, string>(StringComparer.Ordinal) { [PromptFlowStudio.Services.Render.VideoEngineRenderExecutionEngine.MetaAmbientPingPong] = "true" }
            : null;
        IReadOnlyList<string?> subs = _subPrompts;
        if (PromptFlowStudio.Services.Render.MultiDurationPlanner.IsSinglePromptLong(_durationMode))
        {
            // 🎞️ 단일 프롬프트 장편 — 네이티브 길이·모델 계열 기록(플래너가 1×15 / 2×15 / 3×10 / 6×5 분할), 파트 입력 무시
            var native = NativeClipSeconds;
            meta = PromptFlowStudio.Services.Render.MultiDurationPlanner.WithMeta(meta, PromptFlowStudio.Services.Render.MultiDurationPlanner.MetaNativeSeconds, native.ToString(CultureInfo.InvariantCulture));
            if (native >= PromptFlowStudio.Services.Wan.WanModelCatalog.Wan26MaxSeconds)
                meta = PromptFlowStudio.Services.Render.MultiDurationPlanner.WithMeta(meta, PromptFlowStudio.Services.Render.MultiDurationPlanner.MetaWanFamily, nameof(PromptFlowStudio.Services.Wan.WanModelFamily.Wan26));
            meta = PromptFlowStudio.Services.Render.MultiDurationPlanner.WithTransition(meta, _longTransition);   // 🎬 기본 하드 컷 · 0.25초 디졸브는 명시 선택
            subs = Array.Empty<string?>();
        }
        else if (PromptFlowStudio.Services.Render.MultiDurationPlanner.IsMultiShot(_durationMode))
        {
            meta = PromptFlowStudio.Services.Render.MultiDurationPlanner.WithTransition(meta, _cutTransition);   // 🎬 컷 전환 방식(독립 하드 컷 / 독립 디졸브 / 프레임 체인)
            if (PromptFlowStudio.Services.Render.MultiDurationPlanner.IsIndependent(_cutTransition))
            {
                prompt = PromptFlowStudio.Services.Render.MultiDurationPlanner.WithContinuityHint(prompt);   // 독립 컷 피사체·유니폼 일관성
                var hinted = new string?[_subPrompts.Length];
                for (var i = 0; i < hinted.Length; i++)
                    hinted[i] = string.IsNullOrWhiteSpace(_subPrompts[i]) ? null : PromptFlowStudio.Services.Render.MultiDurationPlanner.WithContinuityHint(_subPrompts[i]);
                subs = hinted;
            }
        }
        var negative = EffectiveNegative(prompt);   // 🧭 도메인 격리 네거티브
        if (RunCoherenceGate(prompt, negative, null, null, null, _size) is { WasAutoSanitized: true } gate) negative = gate.SanitizedNegativePrompt;   // 🧩 누출 토큰·중복 구문 보정본 전송
        if (antiArtifact) negative = PromptFlowStudio.Services.AI.PromptPreflightDirector.MergeNegative(negative, out _);   // 🛡️ 안티 아티팩트 네거티브(중복 없이)
        if (!string.IsNullOrWhiteSpace(negative))   // ☁️ Cloud 요청에 네거티브 프롬프트 전달
            meta = PromptFlowStudio.Services.Render.MultiDurationPlanner.WithMeta(meta, PromptFlowStudio.Services.Render.VideoEngineRenderExecutionEngine.MetaNegativePrompt, negative);
        var template = new PromptFlowStudio.Services.Batch.BatchRenderJob
        {
            Prompt = prompt,
            Seed = _canvas.EffectiveSeed ?? Random.Shared.NextInt64(1, int.MaxValue),   // 그룹 전 컷 동일 시드(일관성)
            Resolution = _size.Replace('*', 'x'),
            DurationSec = PromptFlowStudio.Services.Render.MultiDurationPlanner.ShotSeconds,
            ReferenceImagePath = cut1Ref,   // 컷 1 전용(사용자 이미지 > 검증된 첫 화면 미리보기)
            OutputPath = Path.Combine(Media.MediaRoot, project + ".mp4"),
            DurationMode = _durationMode,
            Metadata = meta,
            EngineKind = _renderMode,   // 적재 시점 모드 표기(실제 엔진은 디스패치 시점 설정으로 재확정)
        };
        var jobs = RenderQueue.EnqueueJob(template, subs, project);
        TrackMiniQueue(jobs);
        _durationMsg = jobs.Count == 0 ? "⚠ 렌더 큐 적재 실패"
            : "📥 렌더 큐 적재 " + jobs.Count.ToString(CultureInfo.InvariantCulture) + "컷 · " + PromptFlowStudio.Services.Render.MultiDurationPlanner.Label(_durationMode) + " → " + project;
    }

    // ── 🛡️ AI 프롬프트 자동 보정(프리플라이트 디렉터 · 기본 ON · 비영속) ──
    private bool _preflightOn = true, _preflightBusy, _preflightInspect, _preflightReverted;
    private PromptFlowStudio.Services.AI.PromptPreflightResult? _preflight;
    /// <summary>프리플라이트 AI 호출 상한 — 초과 시 결정적 로컬 규칙으로 즉시 폴백.</summary>
    private static readonly TimeSpan PreflightTimeout = TimeSpan.FromSeconds(8);

    /// <summary>↩ 원문으로 / 🛡️ 보정 다시 사용 — 1클릭 토글(다음 생성부터 적용).</summary>
    private void TogglePreflightRevert()
    {
        _preflightReverted = !_preflightReverted;
        _preflightOn = !_preflightReverted;
    }

    /// <summary>생성 직전 프리플라이트 — 클립 길이 · 화면비 · 앰비언트 여부 기준 보정(실패/타임아웃은 로컬 규칙 · 절대 throw 없음).</summary>
    private async Task<PromptFlowStudio.Services.AI.PromptPreflightResult> RunPreflightAsync(string prompt)
    {
        var ambient = _durationMode == PromptFlowStudio.Services.Render.VideoDurationMode.Sec15_AmbientSlow;
        var seconds = ambient ? (int)PromptFlowStudio.Services.Render.MultiDurationPlanner.ShotSeconds : PromptFlowStudio.Services.Render.MultiDurationPlanner.TargetSeconds(_durationMode);
        var aspect = GeminiPromptService.AspectRatioOf(_size);
        var learned = PlutoLearn.GetLearnedGuidanceForPrompt(prompt, ambient);   // 🧠 학습 레시피 · 실패 회피 규칙
        try
        {
            using var cts = CancellationTokenSource.CreateLinkedTokenSource(_mediaCts.Token);
            cts.CancelAfter(PreflightTimeout);
            return await GeminiSvc.AnalyzeAndRefinePromptAsync(prompt, seconds, aspect, ambient, null, learned, cts.Token);
        }
        catch (Exception ex) when (ex is ObjectDisposedException or OperationCanceledException)
        {
            return PromptFlowStudio.Services.AI.PromptPreflightDirector.RefineLocal(prompt, seconds, aspect, ambient, null, learned);
        }
    }

    // ── 🧠 플루토 자기학습 피드백 루프(👍 레시피 강화 · 👎 사유별 회피 규칙 + 보완 재생성) ──
    private string? _learnRawPrompt, _learnRefinedPrompt, _learnMsg;
    private bool _learnBusy, _learnReasonOpen, _learnAutoRerender = true;

    /// <summary>👍 잘 나옴 — 직전 생성 원문/보정본으로 성공 레시피 기록(예외 격리).</summary>
    private void LearnPositive()
    {
        if (_learnRawPrompt is null) return;
        try
        {
            PlutoLearn.RecordPositiveOutcome(_learnRawPrompt, _learnRefinedPrompt);
            _learnMsg = "🧠 학습 완료 — 유사 프롬프트에 이 레시피를 우선 적용합니다";
            _learnReasonOpen = false;
        }
        catch (Exception ex) when (ex is not OutOfMemoryException) { Program.Log("Workspace.LearnPositive", ex); _learnMsg = "⚠ 학습 저장 실패"; }
    }

    /// <summary>내보내기 성공 = 암묵 👍(메시지 없음 · 예외 격리).</summary>
    private void LearnPositiveSilently()
    {
        if (_learnRawPrompt is null) return;
        try { PlutoLearn.RecordPositiveOutcome(_learnRawPrompt, _learnRefinedPrompt); }
        catch (Exception ex) when (ex is not OutOfMemoryException) { Program.Log("Workspace.LearnExport", ex); }
    }

    /// <summary>👎 어색함 + 사유 — 회피 규칙 학습 → (즉시 재생성 ON) 보완 레시피로 재생성.</summary>
    private async Task LearnNegativeAsync(PromptFlowStudio.Services.AI.PlutoFeedbackReason reason)
    {
        if (_learnRawPrompt is null || _learnBusy) return;
        _learnBusy = true;
        try
        {
            var ambient = _durationMode == PromptFlowStudio.Services.Render.VideoDurationMode.Sec15_AmbientSlow;
            var seconds = ambient ? (int)PromptFlowStudio.Services.Render.MultiDurationPlanner.ShotSeconds : PromptFlowStudio.Services.Render.MultiDurationPlanner.TargetSeconds(_durationMode);
            var refined = PlutoLearn.RecordFailureAndGetRefinement(_learnRawPrompt, reason, seconds, GeminiPromptService.AspectRatioOf(_size), ambient);
            _preflight = refined;
            _preflightReverted = false;
            _learnReasonOpen = false;
            _learnMsg = "🧠 '" + PromptFlowStudio.Services.AI.PlutoVideoLearningMemoryService.ReasonLabel(reason) + "' 회피 규칙 학습 완료";
            if (_learnAutoRerender && !State.IsBusy && CanStart)
            {
                _preflightOn = true;
                _learnMsg += " — 보완 레시피로 재생성";
                await Start();
            }
        }
        catch (Exception ex) when (ex is not OutOfMemoryException) { Program.Log("Workspace.LearnNegative", ex); _learnMsg = "⚠ 학습 저장 실패"; }
        finally { _learnBusy = false; }
    }

    // ── ✨ 플루토 감독 원클릭 확장(생성 전 미리보기 · 적용 시 입력 박스 교체) ──
    private bool _magicBusy;
    private PromptFlowStudio.Services.AI.PromptPreflightResult? _magic;

    /// <summary>[✨ 플루토 감독 확장] — 학습 디렉터 보정본을 미리 계산(실패/타임아웃은 로컬 규칙 · throw 없음).</summary>
    private async Task MagicExpandAsync()
