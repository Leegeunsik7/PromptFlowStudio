    .ws-lum.warn { color: #facc15; border-color: rgba(250, 204, 21, .45); background: rgba(250, 204, 21, .1); }
    .ws-lum.na { color: var(--text-secondary, #aab); }
    .ws-spec { margin: 6px 0; padding: 10px 12px; border-radius: 10px; border: 1px solid rgba(61, 139, 255, .45); background: rgba(10, 14, 22, .92); font-size: 12px; }
