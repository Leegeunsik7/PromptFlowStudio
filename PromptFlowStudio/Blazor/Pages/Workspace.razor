    private void TrackMiniQueue(IReadOnlyList<PromptFlowStudio.Services.Batch.BatchRenderJob> jobs)
    {
        var ids = new Guid[jobs.Count];
        for (var i = 0; i < ids.Length; i++) ids[i] = jobs[i].JobId;
        _miniIds = ids;
        _miniGroup = jobs.Count > 0 ? jobs[0].StitchGroupId : null;
        _miniUrl = _miniPlayed = _miniStitchFail = _miniError = _miniNotice = _canvasQueueUrl = _canvasQueuePath = null;
        _miniCancelled = false;
        _mini = PromptFlowStudio.Services.Render.MiniQueueProgress.None;
        RefreshMiniQueue();
    }

    /// <returns>표시 상태가 바뀌었는지.</returns>
    private bool RefreshMiniQueue()
    {
        if (_miniIds.Length == 0) return false;
        var next = PromptFlowStudio.Services.Render.MiniQueueProgress.Compute(RenderQueue.Snapshot(), _miniIds);
        if (_miniCancelled && next.Phase is PromptFlowStudio.Services.Render.MiniQueuePhase.Rendering or PromptFlowStudio.Services.Render.MiniQueuePhase.Stitching)
            next = next.AsCancelled();   // 엔진 중단 완료 전이라도 취소 상태 유지
        if (next == _mini) return false;
        _mini = next;
        if (next.Phase == PromptFlowStudio.Services.Render.MiniQueuePhase.Completed)
        {
            // 완료 콜백 — 디스크 실존 재확인 후에만 캔버스 소스 교체, 아니면 인라인 빨간 오류
            if (next.FinalPath is { } fp && File.Exists(fp))
            {
                _miniError = null;
                if (!string.Equals(fp, _miniPlayed, StringComparison.OrdinalIgnoreCase))
                {
                    _miniPlayed = fp;
                    try { _miniUrl = Media.ToPlaybackUrl(fp); } catch (Exception ex) { Program.Log("Workspace.MiniQueue", ex); _miniUrl = null; }
                    _canvasQueueUrl = _miniUrl;
                    _canvasQueuePath = _miniUrl is null ? null : fp;
                }
            }
            else
            {
                _miniUrl = _canvasQueueUrl = _canvasQueuePath = null;
                _miniError = MiniMissingOutputMessage();
            }
            _miniNotice = MiniJobMeta(PromptFlowStudio.Services.Render.VideoEngineRenderExecutionEngine.MetaAmbientNotice);
        }
        else if (next.Phase == PromptFlowStudio.Services.Render.MiniQueuePhase.Failed)
            _miniError = MiniFailedMessage() ?? "렌더 실패";
        return true;
    }

    /// <summary>완료 보고 + 산출물 부재 — 실행 엔진 종류별 원인 안내(Mock: ffmpeg 부재 · Cloud: 원격 URL 미수신 · ComfyUI: 출력 누락).</summary>
    private string MiniMissingOutputMessage()
    {
        string? kind = null;
        foreach (var j in RenderQueue.Snapshot())
            if (Array.IndexOf(_miniIds, j.JobId) >= 0 && !string.IsNullOrWhiteSpace(j.EngineKind)) { kind = j.EngineKind; break; }
        return kind switch
        {
            PromptFlowStudio.Services.Render.RenderEngineKind.Mock => "Mock 모드: 샘플 MP4 생성 실패 — FFmpeg 미설치 또는 실행 오류입니다 ([환경설정]에서 FFmpeg 설치)",
            PromptFlowStudio.Services.Render.RenderEngineKind.Cloud => "Cloud(DashScope) 렌더 완료 보고 후 결과 영상을 로컬로 받지 못했습니다 (네트워크/URL 만료 확인)",
            PromptFlowStudio.Services.Render.RenderEngineKind.ComfyUi => "ComfyUI 렌더 완료 보고 후 출력 파일이 디스크에 없습니다 (ComfyUI output 폴더 확인)",
            _ => "렌더 완료로 보고됐으나 산출 파일이 디스크에 없습니다 (엔진 출력 누락)",
        };
    }

    /// <summary>추적 작업 중 첫 실패 컷의 오류 메시지.</summary>
    private string? MiniFailedMessage()
    {
        foreach (var j in RenderQueue.Snapshot())
            if (j.Status == PromptFlowStudio.Services.Batch.BatchJobStatus.Failed && Array.IndexOf(_miniIds, j.JobId) >= 0 && !string.IsNullOrWhiteSpace(j.ErrorMessage))
                return j.ErrorMessage;
        return null;
    }

    /// <summary>추적 작업 메타 값(첫 매치).</summary>
    private string? MiniJobMeta(string key)
    {
        foreach (var j in RenderQueue.Snapshot())
            if (Array.IndexOf(_miniIds, j.JobId) >= 0 && j.Metadata is { } m && m.TryGetValue(key, out var v) && !string.IsNullOrWhiteSpace(v))
                return v;
        return null;
    }

