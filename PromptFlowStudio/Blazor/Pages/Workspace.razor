    // t2v 는 프롬프트 필수, i2v 는 이미지가 있으면 프롬프트 없이도 시작 가능.
    private bool CanStart => State.Enabled && !State.IsBusy
        && (!string.IsNullOrWhiteSpace(_prompt) || !string.IsNullOrWhiteSpace(_imagePath));

    private void Start()
    {
        if (!CanStart) return;
        // v16.20.0 미세 표정 퍼핏 — 표정 구문·정체성 유지·얼굴 보호 네거티브 비영속 주입(Neutral 은 원문 그대로).
