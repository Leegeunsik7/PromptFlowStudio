    /// <summary>🛡️ 장중 안전 모드 판정 백그라운드 틱 — 상태가 바뀔 때만 재렌더(휴장일·개장·마감 실시간 반영).</summary>
    private readonly CancellationTokenSource _guardCts = new();
    private bool _guardOn;
    public static readonly TimeSpan GuardTickInterval = TimeSpan.FromSeconds(10);
    private PromptFlowStudio.Services.ProcessBridge.KrxSessionInfo _session;
    private long _sessionRemainMin = -1;

    /// <summary>📈 KRX 4단계 세션 재평가 — 단계 또는 남은 분이 바뀌면 true(툴팁 실시간 갱신).</summary>
    private bool RefreshSession()
    {
        var s = TradingGuard.CurrentSession;
        var min = (long)Math.Ceiling(s.Remaining.TotalMinutes);
        if (s.Status == _session.Status && min == _sessionRemainMin) return false;
        _session = s;
        _sessionRemainMin = min;
        return true;
    }

    private string SessionBadgeText => _session.Status == PromptFlowStudio.Services.ProcessBridge.KrxSessionStatus.RegularMarket && !_guardOn
        ? "📈 정규장 (안전 모드 꺼짐)"
        : PromptFlowStudio.Services.ProcessBridge.TradingSafetyGuardService.SessionLabel(_session.Status);

    private string SessionTooltip => "KRX 세션 전환까지 " + PromptFlowStudio.Services.ProcessBridge.TradingSafetyGuardService.FormatRemaining(_session.Remaining)
        + " (" + _session.NextChangeKst.ToString("MM-dd HH:mm", CultureInfo.InvariantCulture) + " KST) — 장전 08:30 · 정규 09:00~15:30 · 시간외 ~18:00 · krx_closures.json 비정기 일정 반영"
        + (_guardOn ? " · FFmpeg BelowNormal · 동시 렌더/인코딩 1개 제한" : "");

    private async Task GuardTickLoopAsync(CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(GuardTickInterval);
            while (await timer.WaitForNextTickAsync(ct).ConfigureAwait(false))
            {
                try
                {
                    var on = TradingGuard.IsThrottling;
                    var sessionChanged = RefreshSession();
                    if (on == _guardOn && !sessionChanged) continue;
                    _guardOn = on;
                    await InvokeAsync(StateHasChanged).ConfigureAwait(false);
                }
                catch (OperationCanceledException) { throw; }
                catch (ObjectDisposedException) { return; }
                catch (Exception ex) { Program.Log("Workspace.GuardTick", ex); }
            }
        }
        catch (OperationCanceledException) { /* 페이지 이탈 */ }
    }

    /// <summary>갤러리 복원 번들 1회 소비 → 프롬프트(UserInput) · Seed 핀 · 출력 사이즈 · I2V 참조 이미지(첫 프레임 · 모드 자동 활성화) 주입.</summary>
    private void AbsorbGalleryRestore()
    {
        if (GalleryMedia.TakePendingRestore() is not { } ctx) return;
        try
        {
            if (!string.IsNullOrWhiteSpace(ctx.Prompt)) { _prompt = ctx.Prompt; _vm.UserInput = _prompt; }
            if (ctx.Seed > 0) { _canvas.SeedPinned = true; _canvas.Seed = ctx.Seed; }
            if (ctx.WorkspaceSize is "1280*720" or "720*1280" or "960*960") { _size = ctx.WorkspaceSize; _vm.SetOutputSize(_size); }
            if (ctx.ReferenceImagePath is { Length: > 0 } refPath && File.Exists(refPath))
            {
                _imagePath = refPath;
                _imageName = Path.GetFileName(refPath);
                _imagePreview = Media.ToPlaybackUrl(refPath);
                _ = _vm.ApplyGalleryRestoreAsync(ctx with { Prompt = "", WorkspaceSize = "" }, _mediaCts.Token);   // I2V 바인딩 + 모드 활성화(프롬프트·사이즈는 위에서 반영)
                _camToast = "🖼️ 갤러리 참조 이미지가 첫 프레임으로 복원되었습니다 · I2V 모드 활성화";
            }
        }
        catch (Exception ex) { Program.Log("Workspace.GalleryRestore", ex); }
    }

    /// <summary>
    /// 스마트 카메라 캡처(JPEG/PNG/BMP) + 전송 페이로드 1회 소비 → _uploads 저장 → I2V 첫 프레임 바인딩 ·
    ///   페이로드가 있으면 기존 프롬프트 카메라 지시어 교체 병합 + I2V 자동 활성화 토스트. 실패 시 T2V 유지.
    /// </summary>
    private void AbsorbWirelessCameraFrame()
    {
        var transfer = WirelessCam.TakeWorkspaceTransfer();
        var bytes = WirelessCam.TakeI2vReference();
        if (bytes is null && transfer is null) return;
        try
        {
            if (bytes is not null)
            {
                var ext = PromptFlowStudio.Services.Camera.CameraFrameCodec.MimeOf(bytes) switch { "image/jpeg" => ".jpg", "image/png" => ".png", _ => ".bmp" };
                var dir = Path.Combine(Media.MediaRoot, "_uploads");
                Directory.CreateDirectory(dir);
                var savePath = Path.Combine(dir, Guid.NewGuid().ToString("N") + ext);
                File.WriteAllBytes(savePath, bytes);
                _imagePath = savePath;
                _imageName = "camera-studio" + ext;
                _imagePreview = Media.ToPlaybackUrl(savePath);
            }
            if (transfer is not null)
            {
                _ = _vm.ApplyCameraTransferAsync(transfer, bytes, _mediaCts.Token);   // 프롬프트 병합(즉시) + I2V 바인딩(메모리 스트림 → 동기 완료)
                _prompt = _vm.UserInput ?? "";
                _camToast = bytes is not null ? "📸 카메라 프레임 및 모션이 작업실에 적용되었습니다 · I2V 모드 활성화" : "🎥 카메라 모션이 작업실 프롬프트에 적용되었습니다";
            }
            else if (bytes is not null)
                _ = _vm.HandleImageDroppedAsync(new MemoryStream(bytes, writable: false), _mediaCts.Token);   // T2V→I2V 감지 · 비율 판독(메모리 스트림 → 동기 완료)
        }
        catch (Exception ex) { Program.Log("Workspace.WirelessCamFrame", ex); }
    }

    private string? _camToast;
    // 🎞️ 듀얼 버퍼 크로스디졸브 — 렌더 후 큐 URL 변경 시에만 JS 스왑(컨테이너 소멸 시 기록 리셋 → 재마운트 시 재로드)
    private const string XdHostId = "ws-xd-queue";
    private const string XdMainId = "ws-xd-main";
    private string? _xdShownUrl, _xdShownHost;
    private int _xdShownLayout = -1;

    // 렌더 분기와 동일 판정 — 큐 산출물 우선, 아니면 단일 생성 완료 캔버스(세로/세이프존/가로 레이아웃 키 포함: 호스트 재생성 시 재적재)
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        string? want = null, hostId = null;
        var layout = 0;
        if (_canvasQueueUrl is not null && !State.IsBusy) { want = _canvasQueueUrl; hostId = XdHostId; }
        else if (State.Phase == WanJobPhase.Completed && State.VideoUrl is not null && ShownVideoUrl is { } main)
        {
            want = main; hostId = XdMainId;
            layout = IsPortrait ? (_safeZone ? 2 : 1) : 0;
        }
        if (want is null) { _xdShownUrl = _xdShownHost = null; _xdShownLayout = -1; return; }
        if (layout == _xdShownLayout && ReferenceEquals(hostId, _xdShownHost) && string.Equals(want, _xdShownUrl, StringComparison.Ordinal)) return;
        _xdShownUrl = want; _xdShownHost = hostId; _xdShownLayout = layout;
        try { await JS.InvokeAsync<bool>("promptflow.swapVideoSource", hostId, want); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or InvalidOperationException) { _xdShownUrl = null; }
    }

    public void Dispose()
    {
        _typingTimer?.Dispose();
        History.Changed -= OnHistoryChanged;
        AppSettings.OnSettingsChanged -= OnAppSettingsChanged;
        State.OnChange -= OnStateChanged;
        RenderQueue.OnChange -= OnRenderQueueChanged;
        if (RenderQueue is PromptFlowStudio.Services.Render.RenderQueueService rqs) rqs.OnDurationStitched -= OnDurationStitched;
        StockMon.OnChanged -= OnStockMonChanged;
        Journal.OnChanged -= OnHubChanged;
        Resilience.OnRetryAttempt -= OnRetryAttempt;
        Ipc.OnConnectionChanged -= OnHubChanged;
        Ipc.OnConnectionStateChanged -= OnIpcState;
        Ipc.OnTickerSelected -= OnIpcTicker;
        _vm.PropertyChanged -= OnVmChanged;
        Presets.Changed -= OnUserPresetsChanged;
        var cts = Interlocked.Exchange(ref _liveCts, null);
        if (cts is not null) { cts.Cancel(); cts.Dispose(); }
        _mediaCts.Cancel(); _mediaCts.Dispose();
        _guardCts.Cancel(); _guardCts.Dispose();
        if (_seamCheck)
        {
            _seamCheck = false;
            try { JS.InvokeAsync<bool>("pfsSeamInspector.set", false, 2.0, "video.ws-video").AsTask().ContinueWith(static t => _ = t.Exception, TaskContinuationOptions.OnlyOnFaulted); }
            catch (Exception ex) when (ex is JSException or InvalidOperationException) { Program.Log("Workspace.SeamCheck", ex); }
        }
        if (_bgmOn)
        {
            try { JS.InvokeVoidAsync("pfsBgmPreview.stop").AsTask().ContinueWith(static t => _ = t.Exception, TaskContinuationOptions.OnlyOnFaulted); }
            catch (Exception ex) when (ex is JSException or InvalidOperationException) { Program.Log("Workspace.BgmPreview", ex); }
        }
    }

    // ── 🕒 프롬프트 타임머신 ──
    private bool _histOpen;
    private System.Threading.Timer? _typingTimer;
    private bool _histSubscribed;

    private void EnsureHistorySubscribed()
    {
        if (_histSubscribed) return;
        _histSubscribed = true;
        History.Changed += OnHistoryChanged;
    }

    private void OnHistoryChanged() => _ = InvokeAsync(StateHasChanged);

    private void ToggleHistory() { EnsureHistorySubscribed(); _histOpen = !_histOpen; }

    private static bool ContainsHangul(string s)
    {
        foreach (var c in s) if (c >= '가' && c <= '힣') return true;
        return false;
    }

    /// <summary>현재 프롬프트·카메라·시드 스냅샷 적재(직전과 동일하면 무시).</summary>
    private void Snap(string label)
    {
        try
        {
            EnsureHistorySubscribed();
            var p = _prompt ?? "";
            var cam = WanCameraStyleStudio.ActiveIndex(p, WanCameraStyleStudio.Cameras);
            History.Push(label, p, cam >= 0 ? WanCameraStyleStudio.Cameras[cam].Label : null, _canvas.Seed, _canvas.SeedPinned);
        }
        catch (Exception ex) { Program.Log("Workspace.PromptSnap", ex); }
    }

    /// <summary>입력 정지 1.5초 후 스냅샷(디바운스 · 타이머 1개 재사용).</summary>
    private void OnPromptTyped()
    {
        _typingTimer ??= new System.Threading.Timer(static st =>
        {
            var self = (Workspace)st!;
            try { _ = self.InvokeAsync(() => self.Snap("직접 입력")); }
            catch (Exception ex) when (ex is ObjectDisposedException or InvalidOperationException) { Program.Log("Workspace.TypingSnap", ex); }
        }, this, System.Threading.Timeout.Infinite, System.Threading.Timeout.Infinite);
        _typingTimer.Change(1500, System.Threading.Timeout.Infinite);
    }

    private void RestoreSnapshot(int newestIndex)
    {
        _histOpen = false;
        if (History.Restore(newestIndex) is not { } snap) return;
        Snap("되돌리기 전");
        _prompt = snap.Prompt;
        _canvas.Seed = snap.Seed;
        _canvas.SeedPinned = snap.SeedPinned;
    }

    // ── v15.9.0 Wan 2.1 Gap-Filler: Auto-Foley(무음 보완) + 멀티 컷 타임라인 병합(단일 컷 보완). 실패는 원본 유지(Graceful) ──
    private readonly FfmpegAudioMuxer _muxer = new();
    private readonly CancellationTokenSource _mediaCts = new();
    private bool _autoFoley = true;
    private string? _foleyDoneFor;
    private string _foleyMsg = "", _timelineMsg = "";
    private bool _timelineBusy;

    private async Task RunAutoFoleyAsync(string videoPath, string? prompt)
    {
        try
        {
            _foleyMsg = "🔊 Auto-Foley 병합 중…";
            await InvokeAsync(StateHasChanged);
            var r = await AudioSfxEngine.AutoFoleyAsync(_muxer, videoPath, prompt, _mediaCts.Token);
            _foleyMsg = r.Applied ? "🔊 오디오 트랙 병합 완료 · " + Path.GetFileName(r.OutputPath) : "🔇 " + r.Message;
            if (r.Applied) _recent = Library.List(6);
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { /* 페이지 이탈 */ }
        catch (Exception ex) { Program.Log("Workspace.AutoFoley", ex); }
    }

    private async Task MergeTimelineAsync(IReadOnlyList<TimelineSequencer.TimelineCut> cuts)
    {
        if (_timelineBusy || cuts.Count < 2) return;
        _timelineBusy = true;
        _timelineMsg = "⛓ 타임라인 병합 중…";
        try
        {
            if (!Merge.IsAvailable) { _timelineMsg = "ffmpeg 미탐지 — 타임라인 병합을 건너뜁니다."; return; }
            var paths = new string[cuts.Count];
            var trans = new VideoTransition?[cuts.Count - 1];
            for (var i = 0; i < cuts.Count; i++)
            {
                paths[i] = cuts[i].Path;
                if (i > 0) trans[i - 1] = cuts[i].FadeIn ? new VideoTransition("fade", 500) : null;
            }
            var p = _size.Split('*', 'x', 'X');
            var w = p.Length == 2 && int.TryParse(p[0], out var pw) ? pw : 1280;
            var h = p.Length == 2 && int.TryParse(p[1], out var ph) ? ph : 720;
            var dir = Path.GetDirectoryName(paths[0]) ?? Library.MediaRoot;
            var outPath = Path.Combine(dir, "timeline_" + DateTime.Now.ToString("yyyyMMdd_HHmmss", CultureInfo.InvariantCulture) + ".mp4");
            var r = await Merge.MergeAsync(paths, outPath, w, h, ct: _mediaCts.Token, transitions: trans);
            _timelineMsg = r.Ok ? "✅ 타임라인 병합 완료 · " + Path.GetFileName(outPath) : "⚠ " + r.Message;
            if (r.Ok) _recent = Library.List(6);
        }
        catch (OperationCanceledException) { /* 페이지 이탈 */ }
        catch (Exception ex) { Program.Log("Workspace.Timeline", ex); _timelineMsg = "⚠ 타임라인 병합 실패 — 원본 클립은 그대로 유지됩니다."; }
        finally { _timelineBusy = false; }
    }

    // ── v15.4.1 MMF 라이브 캔버스: 16ms 틱 폴링 → 새 시퀀스만 JS 캔버스로 전달. 리더 복사는 0B, interop 마샬링은 프레임당 1회 ──
    private LiveCanvasFrameReader? _live;
    private CancellationTokenSource? _liveCts;
    private bool _liveSignal;
    private Func<Task>? _liveDraw;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        // 🌱 HTS 스마트 에코 절전 — 백그라운드/최소화 시 <video> 일시정지(GPU 디코더 0%). 설정 서비스 부재(모바일) 시 기본 ON.
        var eco = EcoSp.GetService(typeof(PromptFlowStudio.Services.Ui.UserPreferenceService)) is PromptFlowStudio.Services.Ui.UserPreferenceService ecoPrefs ? ecoPrefs.HtsEcoMode : true;
        _ = SetEcoModeAsync(eco);
        var live = _live = new LiveCanvasFrameReader(VirtualCam);
        var draw = _liveDraw = () => JS.InvokeVoidAsync("pfsLiveCanvas.draw", "ws-live", live.Width, live.Height, live.Frame).AsTask();
        var cts = _liveCts = new CancellationTokenSource();
        _ = LiveLoopAsync(live, draw, cts.Token);
    }

    private async Task SetEcoModeAsync(bool enabled)
    {
        try { await JS.InvokeVoidAsync("promptflow.setEcoMode", enabled); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException or ObjectDisposedException) { /* 브릿지 미적재 — 무시 */ }
    }

    private async Task LiveLoopAsync(LiveCanvasFrameReader reader, Func<Task> draw, CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(16));
            while (await timer.WaitForNextTickAsync(ct).ConfigureAwait(false))
            {
                try
                {
                    if (!reader.TryPoll()) continue;
                    await InvokeAsync(draw).ConfigureAwait(false);
                    if (!_liveSignal) { _liveSignal = true; await InvokeAsync(StateHasChanged).ConfigureAwait(false); }
                }
                catch (OperationCanceledException) { throw; }
                catch (JSDisconnectedException) { return; }
                catch (ObjectDisposedException) { return; }
                catch (Exception ex) { Program.Log("Workspace.LiveCanvas", ex); }
            }
        }
        catch (OperationCanceledException) { /* 페이지 이탈 */ }
    }
    private void OnStateChanged()
    {
        // v16.3.1: 업로드/네트워크 실패는 1회 안내 팝업 + [다시 시도](동일 입력으로 재시작). 원문 XML 은 서비스 단에서 이미 정화.
        if (State.Phase == WanJobPhase.Failed && State.Error is { } err && !ReferenceEquals(err, _alertedError)
            && PromptFlowStudio.Services.Platform.ErrorDialogService.IsUploadOrNetworkFailure(err))
        {
            _alertedError = err;
            Errors.Show(err, () => { State.Reset(); Start(); });
        }
        // 단일 생성 산출물 사이드카(.meta.json) 1회 기록 — 최근 미디어 역복원용(기존 메타 보존 · 실패 격리).
        if (State.Phase == WanJobPhase.Completed && State.IsLocal && State.LocalPath is { } mp && !string.Equals(_metaWrittenFor, mp, StringComparison.Ordinal))
        {
            _metaWrittenFor = mp;
            PromptFlowStudio.Services.Gallery.WorkspaceRehydration.WriteIfMissing(mp, State.LastPrompt, _durationMode, _size, _canvas.EffectiveSeed ?? 0);
        }
        if (State.Phase == WanJobPhase.Completed) _recent = Library.List(6);   // 새 결과를 퀵갤러리에 반영
        // v16.22.0 고정 캐릭터 정합성 — 완료 영상 1회 측정(fire-and-forget · 내부 예외 격리).
        if (State.Phase == WanJobPhase.Completed && _idLockOn && State.IsLocal && State.LocalPath is { } idp && !string.Equals(_idScoredFor, idp, StringComparison.Ordinal))
        {
            _idScoredFor = idp;
            _ = ScoreIdentityAsync(idp);
        }
        else _foleyMsg = "";
        // v15.9.0: 로컬 저장 완료 영상 1회만 Auto-Foley(fire-and-forget · 내부 예외 격리).
        if (State.Phase == WanJobPhase.Completed && _autoFoley && State.IsLocal && State.LocalPath is { } lp && !string.Equals(_foleyDoneFor, lp, StringComparison.Ordinal))
        {
            _foleyDoneFor = lp;
            _ = RunAutoFoleyAsync(lp, State.LastPrompt);
        }
        _ = InvokeAsync(StateHasChanged);
    }

    private string PhaseLabel => State.Phase switch
    {
        WanJobPhase.Submitting => "제출 중",
        WanJobPhase.Queued     => "대기열",
        WanJobPhase.Rendering  => "렌더링",
        WanJobPhase.Downloading => "다운로드",
        WanJobPhase.Completed  => "완료",
        WanJobPhase.Failed     => "실패",
        WanJobPhase.Canceled   => "취소됨",
        _                      => "대기",
    };

    private string PhaseClass => State.Phase switch
    {
        WanJobPhase.Completed => "ok",
        WanJobPhase.Failed or WanJobPhase.Canceled => "bad",
        WanJobPhase.Idle => "",
        _ => "run",
    };

    private static string Short(string id) => id.Length <= 10 ? id : id[..8] + "…";

    private static string ShortPath(string? p)
        => string.IsNullOrEmpty(p) ? "" : (p.Length <= 48 ? p : "…" + p[^46..]);
