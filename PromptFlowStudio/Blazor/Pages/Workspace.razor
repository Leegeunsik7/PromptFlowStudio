    private (int Episode, int Total) LocaleEpisode()
        => _seriesCueState is not null && _series is { } s && _seriesActiveEpisode > 0 && ReferenceEquals(_montageCues, _seriesComposedCues) ? (_seriesActiveEpisode, s.Episodes.Count) : (0, 0);

    /// <summary>🌐 표시 자막의 로캘 적합(TTS 초과 경고 칩) — 자막 · 로캘 · 편이 같으면 캐시.</summary>
    private PromptFlowStudio.Services.Pluto.PlutoLocalizedSubtitleProjection? LocaleFit()
    {
        if (_montageCues is not { Count: > 0 } cues || string.Equals(_publishLocale, PromptFlowStudio.Services.Pluto.PlutoMultiLanguageChannelService.DefaultLocale, StringComparison.Ordinal)) return null;
        var (ep, total) = LocaleEpisode();
        var track = ActiveLocaleTrack();
        if (_localeFitCache is not null && ReferenceEquals(cues, _localeFitCues) && string.Equals(_localeFitLocale, _publishLocale, StringComparison.Ordinal) && _localeFitEpisode == ep * 1000 + total && ReferenceEquals(track, _localeFitTrack)) return _localeFitCache;
        _localeFitTrack = track;
        try { _localeFitCache = PromptFlowStudio.Services.Pluto.PlutoLocaleSubtitleFitter.Project(cues, LocaleChannels(), _publishLocale, ep, total, track); }
        catch (Exception ex) { Program.Log("Workspace.LocaleFit", ex); _localeFitCache = null; }
        _localeFitCues = cues;
        _localeFitLocale = _publishLocale;
        _localeFitEpisode = ep * 1000 + total;
        return _localeFitCache;
    }

    /// <summary>🌐 렌더용 로캘 투영(기본 로캘 · 실패 → 원문 그대로 [부분 구제]).</summary>
    private PromptFlowStudio.Services.Pluto.PlutoLocalizedSubtitleProjection LocalizeCuesForRender(IReadOnlyList<PromptFlowStudio.Services.Export.SubtitleCue> cues)
    {
        var (ep, total) = ReferenceEquals(cues, _montageCues) ? LocaleEpisode() : (0, 0);
