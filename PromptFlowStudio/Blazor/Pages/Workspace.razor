    .ws-count.over { color: #f87171; }
    .ws-empty b { color: var(--text-secondary); }
    .ws-empty-card { margin-top: 6px; padding: 9px 16px; border-radius: 999px; cursor: pointer; font-weight: 700; font-size: 12px; font-family: inherit; color: var(--accent-2);
        background: color-mix(in srgb, var(--flow-cyan) 8%, var(--card-2)); border: 1px solid color-mix(in srgb, var(--flow-cyan) 30%, var(--line)); }
