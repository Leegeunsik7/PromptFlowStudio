    .ws-growth-badge { position: absolute; left: 12px; bottom: 12px; z-index: 3; padding: 4px 12px; border-radius: 999px; font-size: 13px; font-weight: 800; color: #fff; background: rgba(255, 140, 170, .82); box-shadow: 0 2px 8px rgba(0,0,0,.25); cursor: pointer; }
.ws-growth-edit { position: absolute; left: 12px; bottom: 44px; z-index: 4; width: 220px; padding: 4px 10px; border-radius: 999px; border: 1px solid rgba(255, 140, 170, .9); font-size: 12px; background: #fff; color: #3a2e39; }
    .ws-hts-tog.on { background: rgba(61, 139, 255, .18); border-color: #3d8bff; color: #9cc3ff; }
