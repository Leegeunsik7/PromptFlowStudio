        for (var i = 0; i < cam.Length; i++) { var idx = i; cam[i] = () => _prompt = WanCameraStyleStudio.ApplyCamera(_prompt, idx); }
        var sty = new Action[WanCameraStyleStudio.Styles.Length];
        for (var i = 0; i < sty.Length; i++) { var idx = i; sty[i] = () => _prompt = WanCameraStyleStudio.ApplyStyle(_prompt, idx); }
        _zenCam = cam;
