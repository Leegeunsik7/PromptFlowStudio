        _ = RefreshBrainSummaryAsync();   // 🧠 두뇌 리포트 선집계(예외 내부 격리)
        _ = RefreshCatalogClipsAsync();   // 🎞️ 영속 렌더 카탈로그 선적재(재시작 후 최근 렌더 선택)
        _ = SyncBgmPreviewAsync();   // 🎵 SNS 레이더 주입 BGM ON → 미리듣기 시작 · OFF → 잔존 전역 미리듣기 정리(예외 내부 격리)
