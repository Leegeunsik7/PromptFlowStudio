    //   Step3: 표정·행동·소품 키워드 칩은 모두 꼬리 결합(중복 0) + 얼굴 보호 가드, 카메라 모션은 그룹 배타.
    private static readonly string[] BabyTabNames = { "😊 표정 & 감정", "🧸 놀이 & 행동", "🎈 소품 & 배경" };
    private static PromptChip[] BabyCatalog(int tab) => tab switch
    {
        0 => BabyStudioMatrix.Expressions,
        1 => BabyStudioMatrix.Actions,
        _ => BabyStudioMatrix.Atmosphere,
    };
    private Action[] _babyCam = Array.Empty<Action>();
    private readonly BabyStudioSession _baby = new();
    private int _babyTab;
    private Action[][] _babyActs = { Array.Empty<Action>(), Array.Empty<Action>(), Array.Empty<Action>() };
    private Action[] _babyTabSel = Array.Empty<Action>();
    private void BuildBabyInjectors()
    {
        var tabs = new Action[BabyTabNames.Length];
        var acts = new Action[BabyTabNames.Length][];
        for (var t = 0; t < tabs.Length; t++)
        {
            var tab = t;
            tabs[t] = () => _babyTab = tab;
            var src = BabyCatalog(t);
            var arr = new Action[src.Length];
            for (var i = 0; i < arr.Length; i++)
            {
                var idx = i;
                arr[i] = () => { _prompt = _baby.AppendKeyword(src, idx, _prompt); _canvas.FaceSharpen = true; };
            }
            acts[t] = arr;
        }
        var cam = new Action[BabyStudioMatrix.CameraMotions.Length];
        for (var i = 0; i < cam.Length; i++) { var idx = i; cam[i] = () => _prompt = BabyStudioMatrix.ApplyCameraMotion(_prompt, idx); }
        _babyCam = cam;
        _babyTabSel = tabs;
        _babyActs = acts;
    }

