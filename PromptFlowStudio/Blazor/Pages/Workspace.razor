        var idLock = _idLockOn ? IdentityLockOf() : null;
        var (lockedPrompt, lockedNeg) = idLock is null ? (_prompt, _baby.NegativePrompt) : EpisodicStorySeriesBuilder.ComposeScenePrompt(_prompt, _baby.NegativePrompt, idLock);
        var emo = FacialEmotionPuppeteerEngine.Apply(lockedPrompt, lockedNeg, _emotion, _emotionIntensity);
        var faceRef = idLock?.FaceImagePath is { } fp && File.Exists(fp) ? fp : null;
        var req = new WanVideoRequest
        {
            Prompt = emo.Prompt,
            Size = _size,
            ImagePath = _imagePath ?? faceRef,   // null → t2v · 존재 → i2v(백엔드가 업로드→img_url 바인딩)
            LastFramePath = _imagePath is null ? null : _lastImagePath,   // v16.5.0: 첫+끝 → kf2v 보간
            NegativePrompt = emo.Negative,           // 비어 있으면 서비스가 필드 생략
            Seed = _canvas.EffectiveSeed ?? (idLock is { Seed: > 0 } ? idLock.Seed : null),   // 핀 해제 시 프로필 시드 → 없으면 서버 랜덤
            Tuning = _canvas.Snapshot(),             // 값 형식 스냅숏(0B)
        };
        _ = State.StartAsync(req);    // fire-and-forget — 진행은 OnChange 로 반영된다.
    }

    /// <summary>이미지 선택/드롭 — 원본을 미디어 폴더에 저장(백엔드 업로드용)하고 가상호스트 썸네일을 만든다.</summary>
    private async Task OnImagePicked(InputFileChangeEventArgs e)
    {
        if (await SaveUploadAsync(e.File) is not { } savePath) return;
        _imagePath = savePath;
        _imageName = e.File.Name;
        _imagePreview = Media.ToPlaybackUrl(savePath);   // base64 불필요 — 가상호스트에서 직접
    }

    /// <summary>v16.5.0: 끝 프레임 선택/드롭 — 첫 프레임과 같은 저장 경로 규칙.</summary>
    private async Task OnLastImagePicked(InputFileChangeEventArgs e)
    {
        if (await SaveUploadAsync(e.File) is not { } savePath) return;
        _lastImagePath = savePath;
        _lastImageName = e.File.Name;
        _lastImagePreview = Media.ToPlaybackUrl(savePath);
    }

    /// <summary>업로드 이미지를 미디어 루트의 _uploads 에 저장하고 경로를 돌려준다(실패 시 null + _imgError).</summary>
    private async Task<string?> SaveUploadAsync(IBrowserFile? file)
    {
        if (file is null) return null;
        _imgError = null;
        const long maxSize = PromptFlowStudio.Services.Wan.WanApiService.MaxUploadImageBytes;   // v16.3.1: 32MB(고해상도 원본 허용)
        if (file.Size > maxSize) { _imgError = "이미지가 너무 큽니다(최대 32MB)."; return null; }

        try
        {
            // 원본을 미디어 루트의 _uploads 에 저장 → ImagePath. 미디어 루트는 가상호스트로 매핑돼 썸네일도 디스크 직접 재생.
            var dir = Path.Combine(Media.MediaRoot, "_uploads");
            Directory.CreateDirectory(dir);
            var ext = Path.GetExtension(file.Name);
            if (string.IsNullOrWhiteSpace(ext)) ext = ".png";
            var savePath = Path.Combine(dir, $"{Guid.NewGuid():N}{ext}");

            await using (var src = file.OpenReadStream(maxSize))
            await using (var dst = new FileStream(savePath, FileMode.Create, FileAccess.Write, FileShare.None, 81920, FileOptions.Asynchronous))
                await src.CopyToAsync(dst);
            return savePath;
        }
        catch (Exception ex) { _imgError = "이미지 로드 실패: " + ex.Message; return null; }
    }

    /// <summary>참조 이미지 제거(임시 파일 정리 · best-effort).</summary>
    private void ClearImage()
    {
        try { if (!string.IsNullOrEmpty(_imagePath) && File.Exists(_imagePath)) File.Delete(_imagePath); } catch { /* 무시 */ }
        _imagePath = null; _imageName = null; _imagePreview = null; _imgError = null;
        ClearLastImage();   // v16.5.0: 첫 프레임이 없으면 끝 프레임도 무의미
    }

    /// <summary>v16.5.0: 끝 프레임 제거(임시 파일 정리 · best-effort).</summary>
    private void ClearLastImage()
    {
        try { if (!string.IsNullOrEmpty(_lastImagePath) && File.Exists(_lastImagePath)) File.Delete(_lastImagePath); } catch { /* 무시 */ }
        _lastImagePath = null; _lastImageName = null; _lastImagePreview = null;
    }

    // ── OnChange 구독: 상태 변화를 UI 로. 폴링 스레드에서 오므로 InvokeAsync 로 마샬링 ──
    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
        BuildBabyInjectors();
        BuildGeminiInjectors();
        BuildZenInjectors();
        var d = Draft.Consume();   // 모션프리셋(/motion)에서 전달된 스니펫 흡수
        if (!string.IsNullOrWhiteSpace(d)) _prompt = d;
        _recent = Library.List(6);
    }
    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
        var cts = Interlocked.Exchange(ref _liveCts, null);
        if (cts is not null) { cts.Cancel(); cts.Dispose(); }
        _mediaCts.Cancel(); _mediaCts.Dispose();
    }

    // ── v15.9.0 Wan 2.1 Gap-Filler: Auto-Foley(무음 보완) + 멀티 컷 타임라인 병합(단일 컷 보완). 실패는 원본 유지(Graceful) ──
    private readonly FfmpegAudioMuxer _muxer = new();
    private readonly CancellationTokenSource _mediaCts = new();
    private bool _autoFoley = true;
    private string? _foleyDoneFor;
    private string _foleyMsg = "", _timelineMsg = "";
    private bool _timelineBusy;

    private async Task RunAutoFoleyAsync(string videoPath, string? prompt)
    {
        try
        {
            _foleyMsg = "🔊 Auto-Foley 병합 중…";
            await InvokeAsync(StateHasChanged);
            var r = await AudioSfxEngine.AutoFoleyAsync(_muxer, videoPath, prompt, _mediaCts.Token);
            _foleyMsg = r.Applied ? "🔊 오디오 트랙 병합 완료 · " + Path.GetFileName(r.OutputPath) : "🔇 " + r.Message;
            if (r.Applied) _recent = Library.List(6);
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { /* 페이지 이탈 */ }
        catch (Exception ex) { Program.Log("Workspace.AutoFoley", ex); }
    }

    private async Task MergeTimelineAsync(IReadOnlyList<TimelineSequencer.TimelineCut> cuts)
    {
        if (_timelineBusy || cuts.Count < 2) return;
        _timelineBusy = true;
        _timelineMsg = "⛓ 타임라인 병합 중…";
        try
        {
            if (!Merge.IsAvailable) { _timelineMsg = "ffmpeg 미탐지 — 타임라인 병합을 건너뜁니다."; return; }
            var paths = new string[cuts.Count];
            var trans = new VideoTransition?[cuts.Count - 1];
            for (var i = 0; i < cuts.Count; i++)
            {
                paths[i] = cuts[i].Path;
                if (i > 0) trans[i - 1] = cuts[i].FadeIn ? new VideoTransition("fade", 500) : null;
            }
            var p = _size.Split('*', 'x', 'X');
            var w = p.Length == 2 && int.TryParse(p[0], out var pw) ? pw : 1280;
            var h = p.Length == 2 && int.TryParse(p[1], out var ph) ? ph : 720;
            var dir = Path.GetDirectoryName(paths[0]) ?? Library.MediaRoot;
            var outPath = Path.Combine(dir, "timeline_" + DateTime.Now.ToString("yyyyMMdd_HHmmss", CultureInfo.InvariantCulture) + ".mp4");
            var r = await Merge.MergeAsync(paths, outPath, w, h, ct: _mediaCts.Token, transitions: trans);
            _timelineMsg = r.Ok ? "✅ 타임라인 병합 완료 · " + Path.GetFileName(outPath) : "⚠ " + r.Message;
            if (r.Ok) _recent = Library.List(6);
        }
        catch (OperationCanceledException) { /* 페이지 이탈 */ }
        catch (Exception ex) { Program.Log("Workspace.Timeline", ex); _timelineMsg = "⚠ 타임라인 병합 실패 — 원본 클립은 그대로 유지됩니다."; }
        finally { _timelineBusy = false; }
    }

    // ── v15.4.1 MMF 라이브 캔버스: 16ms 틱 폴링 → 새 시퀀스만 JS 캔버스로 전달. 리더 복사는 0B, interop 마샬링은 프레임당 1회 ──
    private LiveCanvasFrameReader? _live;
    private CancellationTokenSource? _liveCts;
    private bool _liveSignal;
    private Func<Task>? _liveDraw;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        var live = _live = new LiveCanvasFrameReader(VirtualCam);
        var draw = _liveDraw = () => JS.InvokeVoidAsync("pfsLiveCanvas.draw", "ws-live", live.Width, live.Height, live.Frame).AsTask();
        var cts = _liveCts = new CancellationTokenSource();
        _ = LiveLoopAsync(live, draw, cts.Token);
    }

    private async Task LiveLoopAsync(LiveCanvasFrameReader reader, Func<Task> draw, CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(16));
            while (await timer.WaitForNextTickAsync(ct).ConfigureAwait(false))
            {
                try
                {
                    if (!reader.TryPoll()) continue;
                    await InvokeAsync(draw).ConfigureAwait(false);
                    if (!_liveSignal) { _liveSignal = true; await InvokeAsync(StateHasChanged).ConfigureAwait(false); }
                }
                catch (OperationCanceledException) { throw; }
                catch (JSDisconnectedException) { return; }
                catch (ObjectDisposedException) { return; }
                catch (Exception ex) { Program.Log("Workspace.LiveCanvas", ex); }
            }
        }
        catch (OperationCanceledException) { /* 페이지 이탈 */ }
    }
    private void OnStateChanged()
    {
        // v16.3.1: 업로드/네트워크 실패는 1회 안내 팝업 + [다시 시도](동일 입력으로 재시작). 원문 XML 은 서비스 단에서 이미 정화.
        if (State.Phase == WanJobPhase.Failed && State.Error is { } err && !ReferenceEquals(err, _alertedError)
            && PromptFlowStudio.Services.Platform.ErrorDialogService.IsUploadOrNetworkFailure(err))
        {
            _alertedError = err;
            Errors.Show(err, () => { State.Reset(); Start(); });
        }
        if (State.Phase == WanJobPhase.Completed) _recent = Library.List(6);   // 새 결과를 퀵갤러리에 반영
        // v16.22.0 고정 캐릭터 정합성 — 완료 영상 1회 측정(fire-and-forget · 내부 예외 격리).
        if (State.Phase == WanJobPhase.Completed && _idLockOn && State.IsLocal && State.LocalPath is { } idp && !string.Equals(_idScoredFor, idp, StringComparison.Ordinal))
        {
            _idScoredFor = idp;
            _ = ScoreIdentityAsync(idp);
        }
        else _foleyMsg = "";
        // v15.9.0: 로컬 저장 완료 영상 1회만 Auto-Foley(fire-and-forget · 내부 예외 격리).
        if (State.Phase == WanJobPhase.Completed && _autoFoley && State.IsLocal && State.LocalPath is { } lp && !string.Equals(_foleyDoneFor, lp, StringComparison.Ordinal))
        {
            _foleyDoneFor = lp;
            _ = RunAutoFoleyAsync(lp, State.LastPrompt);
        }
        _ = InvokeAsync(StateHasChanged);
    }

    private string PhaseLabel => State.Phase switch
    {
        WanJobPhase.Submitting => "제출 중",
        WanJobPhase.Queued     => "대기열",
        WanJobPhase.Rendering  => "렌더링",
        WanJobPhase.Downloading => "다운로드",
        WanJobPhase.Completed  => "완료",
        WanJobPhase.Failed     => "실패",
        WanJobPhase.Canceled   => "취소됨",
        _                      => "대기",
    };

    private string PhaseClass => State.Phase switch
    {
        WanJobPhase.Completed => "ok",
        WanJobPhase.Failed or WanJobPhase.Canceled => "bad",
        WanJobPhase.Idle => "",
        _ => "run",
    };

    private static string Short(string id) => id.Length <= 10 ? id : id[..8] + "…";

    private static string ShortPath(string? p)
        => string.IsNullOrEmpty(p) ? "" : (p.Length <= 48 ? p : "…" + p[^46..]);
}
