        try { return PromptFlowStudio.Services.Pluto.PlutoLocaleSubtitleFitter.Project(cues, LocaleChannels(), _publishLocale, ep, total, track); }
        catch (Exception ex)
        {
            Program.Log("Workspace.LocaleRender", ex);
            return PromptFlowStudio.Services.Pluto.PlutoLocaleSubtitleFitter.Project(cues, null, null);
        }
    }

