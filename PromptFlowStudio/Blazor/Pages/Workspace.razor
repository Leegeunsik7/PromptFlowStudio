                        <button class="ws-back" data-publish-sidecar="1" @onclick="SavePublishPackSidecarAsync" disabled="@(_publishPackBusy || string.IsNullOrWhiteSpace(_publishPackClip?.OutputPath))" title="렌더된 영상 바로 옆에 {영상이름}_publish_pack.txt 로 제목 A/B · 설명 · 고정 댓글 · 해시태그 저장(원자 기록) — 앱 없이 어느 폴더에서든 업로드">[💾 영상 옆 패키지(.txt) 저장]</button>
                    }
                    else if (_publishPackToast is { } ppt) { <span class="ws-retry" role="status" data-publish-pack-result="error">@(ppt)</span> }
                </div>
            }
            @if (_montageBusy) { <span class="ws-retry" role="status" data-montage-busy="1"><span class="ws-motion-spin" aria-hidden="true"></span> 🎞️ 몽타주 렌더 중… (@(_montagePhotos.Count.ToString(CultureInfo.InvariantCulture))컷 · 15초 · 60fps)</span> }
            else if (_montageToast is { } mtt) { <span class="ws-retry" role="status" data-montage-result="1">@(mtt) @if (_montageOutput is { } mto) { <button class="ws-back" data-montage-open="1" @onclick="() => RevealInExplorer(mto)" title="@(mto)">📂 @(Path.GetFileName(mto)) 위치 열기</button> }</span> }
            @* 🎵 커스텀 BGM — 업로드 음원 → 최고 흥분도 15초 하이라이트(비트 스냅) → 프리뷰 · 렌더 공통 *@
            <span class="ws-back ws-file-pick" data-custom-bgm-pick="1" title="내 음원(.mp3 · .wav · .m4a · .aac · .ogg · 최대 25MB) → 가장 신나는 15초 하이라이트를 자동 추출해 비트에 맞춰 컷을 다시 정렬">🎵 내 BGM 업로드<InputFile class="ws-drop-input" OnChange="OnCustomBgmPickedAsync" accept=".mp3,.wav,.m4a,.aac,.ogg" disabled="@(_customBgmBusy || _motionBusy || _montageBusy)" /></span>
            @if (_customBgmBusy) { <span class="ws-retry" role="status" data-custom-bgm-busy="1"><span class="ws-motion-spin" aria-hidden="true"></span> 🎵 하이라이트 분석 중…</span> }
            else if (_customBgm is { } cbg)
            {
                <span class="ws-pcore on" data-custom-bgm="1" title="@("원곡 " + FormatMmSs(cbg.TotalSourceDurationSec) + " · 흥분도 " + cbg.ExcitementScore.ToString("0.00", CultureInfo.InvariantCulture))">🎵 @(_customBgmName) · 하이라이트 @(FormatMmSs(cbg.StartOffsetSec))~@(FormatMmSs(cbg.EndOffsetSec)) (@(cbg.DetectedBpm > 0 ? cbg.DetectedBpm.ToString("F0", CultureInfo.InvariantCulture) + " BPM" : "BPM 미검출"))</span>
                <button class="ws-back" data-custom-bgm-nudge="-1" @onclick="() => NudgeCustomBgmAsync(-1)" disabled="@(cbg.StartOffsetSec <= 0 || _motionBusy || _montageBusy)" title="하이라이트 구간을 1초 앞으로">◀ -1s</button>
                <button class="ws-back" data-custom-bgm-nudge="1" @onclick="() => NudgeCustomBgmAsync(1)" disabled="@(cbg.EndOffsetSec >= cbg.TotalSourceDurationSec || _motionBusy || _montageBusy)" title="하이라이트 구간을 1초 뒤로">+1s ▶</button>
                <button class="ws-back" data-custom-bgm-clear="1" @onclick="ClearCustomBgmAsync" disabled="@(_motionBusy || _montageBusy)" title="업로드 음원 해제 → 감성 BGM 합성 트랙 복원">✕ 기본 BGM</button>
            }
            @if (_customBgmError is { } cbe) { <span class="ws-retry" role="alert" data-custom-bgm-error="1">⚠ @(cbe)</span> }
        </div>
        @* 🎞 실시간 모션 프리뷰 — FFmpeg 없이 캔버스 60fps Ken Burns + Web Audio 동기 + KO/EN 자막(궤적/자막/BGM 변경은 재생 유지 핫스왑) *@
        @if (_motionImage is not null)
        {
            <div class="ws-motion-preview" data-motion-preview="1">
                <PlutoMotionPreviewer Js="JS" Trajectory="MotionPreviewPath" SfxCues="MotionBeatSync?.SfxCues" Subtitles="_motionSubs" ImageUrl="@_motionImageUrl" BgmUrl="@(_bgmOn ? _motionBgmUrl : null)" BgmVolume="MotionPreviewBgmVolume" CustomBgmDataUrl="@_customBgmUrl" />
                @if (MotionBeatSync is { } mbs) { <span class="ws-retry" role="status" data-motion-beatsync="1">🎵 비트 싱크 퀀타이즈 적용됨 (@(mbs.Bpm.ToString("F0", CultureInfo.InvariantCulture)) BPM, @(mbs.BeatCount.ToString(CultureInfo.InvariantCulture)) 비트 정렬)</span> }
            </div>
        }
        @* 🎞️ 멀티컷 몽타주 프리뷰 — 사진별 초점 · 클립별 카메라 · xfade 크로스디졸브 · 근사 색보정(오디오 마스터 클록 동기) *@
        @if (_activeMontagePreviewPlan is { } amp)
        {
            <div class="ws-motion-preview" data-montage-preview="@(amp.Clips.Count.ToString(CultureInfo.InvariantCulture))">
                <PlutoMotionPreviewer Js="JS" MontagePlan="@_activeMontagePreviewPlan" Subtitles="_motionSubs" SubtitleCues="_montageCues"BgmUrl="@(_bgmOn ? _motionBgmUrl : null)" BgmVolume="MotionPreviewBgmVolume" CustomBgmDataUrl="@_customBgmUrl" />
            </div>
        }
        @if (_jOpen)
        {
            <div class="ws-jmodal-bg" @onclick="CloseJournal">
                <div class="ws-jmodal" role="dialog" aria-label="클라우드 작업 저널 인스펙터" @onclick:stopPropagation="true">
                    <div class="ws-jmodal-h">
                        <b>🔄 클라우드 작업 저널</b>
                        <span>
                            <button class="ws-btn ghost sm" @onclick="PurgeAllJournal" disabled="@(_jBusy || _jEntries.Count == 0)">🧹 전체 비우기</button>
                            <button class="ws-btn ghost sm" @onclick="CloseJournal">✕</button>
                        </span>
                    </div>
                    @if (_jMsg is not null) { <div class="ws-hint">@_jMsg</div> }
                    @if (_jEntries.Count == 0)
                    {
                        <div class="ws-hint">저널이 비어 있습니다.</div>
                    }
                    else
                    {
                        <table class="ws-jtbl">
                            <thead><tr><th>Task ID</th><th>발번 시각</th><th>프롬프트</th><th>상태</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var je in _jEntries)
                                {
                                    <tr @key="je.TaskId">
                                        <td class="mono" title="@je.TaskId">@ShortId(je.TaskId)</td>
                                        <td class="mono">@(je.StartedAt.ToLocalTime().ToString("MM-dd HH:mm:ss", CultureInfo.InvariantCulture))</td>
                                        <td title="@je.Prompt">@Summary(je.Prompt)</td>
                                        <td><span class="ws-jst @JournalStatusClass(je.Status)">@je.Status</span></td>
                                        <td class="ws-jact">
                                            <button class="ws-btn ghost sm" @onclick="() => RecoverJournalAsync(je.TaskId)" disabled="@_jBusy" title="상태 무관 원격 결과 즉시 회수">⬇ 수동 회수/다운로드</button>
                                            <button class="ws-btn ghost sm" @onclick="() => RetryJournalAsync(je.TaskId)" disabled="@_jBusy" title="Processing 으로 복귀 → 자동 회수 대상 편입">🔁 재시도</button>
                                            <button class="ws-btn ghost sm" @onclick="() => PurgeJournal(je.TaskId)" disabled="@_jBusy">🗑 저널에서 영구 삭제</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }
        <h1 class="ws-title">새 프로젝트 <span class="ws-title-g">텍스트 → 영상</span>
            <span class="ws-accel @AccelClass" title="Wan 2.1 엔진 상태">⚡ @(AccelClass == "ready" ? _vm.StatusBadge : "WAN 2.1 · " + AccelLabel)</span></h1>
        <p class="ws-sub">프롬프트를 입력하면 통의만상(Wan 2.1)이 5초 영상을 생성합니다.</p>
    </header>

    @* 🔮 Step 28 — 렌더 전 셋업 예측 · 오답 노트 위험 배지(헤더 밖 · 기획안 없이 고른 조합도 평가 · 룩이 원인인 차단만 원클릭 안전 룩 교체) *@
    @if (CurrentSetupForecast() is { } sfc)
    {
        <div class="ws-setup-forecast" data-setup-forecast="@(sfc.PredictedScore.ToString("0.0", CultureInfo.InvariantCulture))" data-setup-forecast-tier="@(sfc.ConfidenceTier)" data-setup-forecast-blocked="@(sfc.IsBlocked ? "1" : "0")" style="display:flex;flex-wrap:wrap;gap:6px;align-items:center;font-size:12px;margin:4px 0">
            <span class="@(sfc.IsBlocked ? "ws-retry" : "ws-pcore on")" role="status" title="예상 합성 = 훅 기대치(채널 기준선 수축) + 0.5 × 룩·BGM·렌더 모드 리프트 − 오답 노트 벌점 × 5(최대 15) · 신뢰 = 일치 실측 표본 수(3건 보통 · 8건 높음)">@(sfc.ToBadgeLabel())</span>
            @if (sfc.WarningKorean is { } sfw) { <span class="ws-retry" data-setup-forecast-warning="1">@(sfw)</span> }
            @if (sfc.SafeLookId is { } sfl)
            {
                var safeLook = sfl;
                <button class="ws-back" data-setup-forecast-swap="@(safeLook)" disabled="@(_forecastSwapBusy || _montageBusy || State.IsBusy)" @onclick="() => ApplySafeLookSwapAsync(safeLook)" title="차단 조합을 피하는 룩으로 고정하고 몽타주 프리뷰를 다시 구성(직접 고친 자막은 보존)">[🔁 안전 룩 @(safeLook)(으)로 교체]</button>
            }
            @if (_forecastToast is { } fct) { <span class="ws-retry" role="status" data-setup-forecast-toast="1">@(fct)</span> }
        </div>
    }

    @if (!State.Enabled)
    {
        <div class="ws-warn">
            ⚠ Wan API 키가 아직 구성되지 않았습니다.
            <button class="ws-warn-link" @onclick='() => Nav.NavigateTo("settings")'>관리자 설정 › 영상(Wan)</button>
            에서 API 키를 등록하면 <b>재시작 없이 즉시</b> 여기서 생성할 수 있습니다.
        </div>
    }

    @if (_camToast is not null)
    {
        <div class="ws-cam-toast" role="status">@(_camToast) @if (ReferenceEquals(_camToast, _stockToast) && StockCanLaunch) { <button class="ws-btn sm" @onclick="() => LaunchStockSuite(_stockRestart)" title="StockSuite 를 실행(실행 중이면 재실행)해 새 에셋을 즉시 반영">@(_stockRestart ? "🔄 StockSuite 재실행" : "🚀 StockSuite 실행")</button> } <button class="ws-cam-toast-x" @onclick="() => _camToast = null" title="닫기">✕</button></div>
    }

    <section class="ws-grid" data-compact-layout="1">
        @* ── ① 입력 ── *@
        <div class="ws-card">
            <div class="ws-card-h">
                <span>① 프롬프트 입력</span>
                @if (_imagePath is not null && _lastImagePath is not null) { <span class="ws-mode">🎯 첫·끝 프레임 보간(kf2v)</span> }
                else if (_imagePath is not null) { <span class="ws-mode">🖼️ 이미지→영상(i2v)</span> }
            </div>

            @* ── 참조 이미지(선택) — 있으면 i2v 로 분기 · 드래그&드롭 + 클릭 ── *@
            <div class="ws-drop @(_imagePreview is not null ? "has" : "")">
                @if (_imagePreview is null)
                {
                    <InputFile class="ws-drop-input" OnChange="OnImagePicked"
                               accept="image/png,image/jpeg,image/webp,image/bmp" disabled="@State.IsBusy" />
                    <div class="ws-drop-hint">
                        <span class="ws-drop-ic">🖼️</span>
                        <span>참조 이미지 <b>드래그</b> 또는 <b>클릭</b>해서 업로드</span>
                        <span class="ws-drop-sub">(선택) 이미지를 넣으면 <b>이미지→영상(i2v)</b>로 생성됩니다</span>
                    </div>
                }
                else
                {
                    <img class="ws-thumb" src="@_imagePreview" alt="참조 이미지" />
                    <div class="ws-thumb-meta">
                        <span class="ws-thumb-name" title="@_imageName">@_imageName</span>
                        <button class="ws-thumb-x" @onclick="ClearImage" disabled="@State.IsBusy" title="이미지 제거">✕</button>
                    </div>
                }
            </div>
            @* v16.5.0 🎯 끝 프레임(Last Frame) 슬롯 — 첫 프레임과 함께 넣으면 두 키프레임 보간으로 모션 동선을 고정 *@
            @if (_imagePath is not null)
            {
                <div class="ws-drop @(_lastImagePreview is not null ? "has" : "")">
                    @if (_lastImagePreview is null)
                    {
                        <InputFile class="ws-drop-input" OnChange="OnLastImagePicked"
                                   accept="image/png,image/jpeg,image/webp,image/bmp" disabled="@State.IsBusy" />
                        <div class="ws-drop-hint">
                            <span class="ws-drop-ic">🏁</span>
                            <span>끝 프레임(Last Frame) <b>드래그</b> 또는 <b>클릭</b></span>
                            <span class="ws-drop-sub">(선택) 위 이미지=첫 프레임 · 이 이미지=끝 프레임으로 <b>보간 생성</b>됩니다</span>
                        </div>
                    }
                    else
                    {
                        <img class="ws-thumb" src="@_lastImagePreview" alt="끝 프레임" />
                        <div class="ws-thumb-meta">
                            <span class="ws-thumb-name" title="@_lastImageName">🏁 @_lastImageName</span>
                            <button class="ws-thumb-x" @onclick="ClearLastImage" disabled="@State.IsBusy" title="끝 프레임 제거">✕</button>
                        </div>
                    }
                </div>
            }
            @if (_imgError is not null) { <div class="ws-imgerr">⚠ @_imgError</div> }

            <div class="ws-insp-bar">
                <button class="ws-insp-open" @onclick="OpenInspiration" disabled="@State.IsBusy" title="장르별 완성 스토리 · 레고식 조합기">💡 스토리 레시피 & 영감 모음</button>
                <button class="ws-preset-save" @onclick="ToggleUserPresetForm" disabled="@State.IsBusy" title="프롬프트 · 네거티브 · 카메라 모션 · 스타일 · 듀레이션을 user_presets.json 에 영구 저장">⭐ 현재 설정을 프리셋으로 저장</button>
            </div>
            @if (_upFormOpen)
            {
                <div class="ws-preset-form">
                    <input class="ws-preset-in" @bind="_upName" @bind:event="oninput" maxlength="@PromptFlowStudio.Services.Prompt.PresetManagerService.MaxNameLength"
                           placeholder="프리셋 이름 (예: 심야 OLED 퀀트 다크)" @onkeydown="OnUserPresetKey" />
                    <button class="ws-btn sm" @onclick="SaveUserPreset" disabled="@(string.IsNullOrWhiteSpace(_upName) || string.IsNullOrWhiteSpace(_prompt))">💾 저장</button>
                    <button class="ws-btn ghost sm" @onclick="() => _upFormOpen = false">취소</button>
                </div>
            }
            @if (_upMsg is not null) { <div class="ws-hint">@_upMsg</div> }
            @* 🌱 우리 아기 성장 단계 칩 바 — 클릭 → 연령 적합 피사체·스타일 키워드를 프롬프트 선두에 시드(멱등 · 단계 전환 시 교체) *@
            <div class="ws-watch-bar" role="group" aria-label="우리 아기 성장 단계">
                <span class="ws-mood-cap">🌱 우리 아기 성장 단계</span>
                @{ var activeStage = PromptFlowStudio.Services.AI.GeminiPromptService.ActiveGrowthStage(_prompt); }
                @for (var i = 0; i < PromptFlowStudio.Services.AI.GeminiPromptService.BabyGrowthStages.Length; i++)
                {
                    var gs = PromptFlowStudio.Services.AI.GeminiPromptService.BabyGrowthStages[i];
                    <button class="ws-mood-chip @(activeStage == gs.Stage ? "on" : null)" @key="gs.Stage" @onclick="StagePick(i)" disabled="@State.IsBusy"
                            title="@gs.Tokens">@gs.Emoji @gs.Label <small>(@gs.Range)</small></button>
                }
            </div>
            @if (_tickerMsg is not null) { <div class="ws-hint">@_tickerMsg</div> }
            <div class="ws-hist">
                <button class="ws-hist-btn" @onclick="ToggleHistory" disabled="@(State.IsBusy || History.Count == 0)" title="프롬프트 타임머신 — AI 강화·번역·3-Way·아기 무드 직전 상태로 되돌리기">🕒 되돌리기 @(History.Count)</button>
                @if (_histOpen)
                {
                    var snaps = History.Snapshots;
                    <div class="ws-hist-menu" role="menu">
                        @for (var hi = 0; hi < snaps.Count; hi++)
                        {
                            var hIdx = hi;
                            var hs = snaps[hi];
                            <button class="ws-hist-item" role="menuitem" @key="hs" @onclick="() => RestoreSnapshot(hIdx)" title="@hs.Prompt">@hs.Display<small>@(hs.Camera is null ? "" : "🎥 " + hs.Camera + " · ")🌱 @hs.Seed.ToString(CultureInfo.InvariantCulture)</small></button>
                        }
                    </div>
                }
            </div>
            <textarea class="ws-ta" @bind="_prompt" @bind:event="oninput" @bind:after="OnPromptTyped"
                      placeholder="@(_imagePath is null ? "예) 노을 지는 해변을 천천히 걷는 골든리트리버, 시네마틱, 부드러운 카메라 팬" : "예) 카메라가 천천히 줌인, 머리카락이 바람에 날림 (i2v는 움직임 위주로 · 프롬프트 선택)")"
                      maxlength="800" disabled="@State.IsBusy"></textarea>
            @* ✨ 플루토 감독 원클릭 확장 — 거친 1줄 아이디어 → 학습 디렉터 보정본 미리보기 · 적용 *@
            <div class="ws-magic" role="group" aria-label="플루토 감독 확장" data-pluto-magic-expand="1">
                <button class="ws-pf-btn" @onclick="MagicExpandAsync" disabled="@(State.IsBusy || _magicBusy || _preflightBusy || string.IsNullOrWhiteSpace(_prompt))"
                        title="입력한 아이디어를 플루토 학습 디렉터(👍 레시피 · 👎 회피 규칙 · 클립 길이 압축)로 미리 확장합니다 — 적용 전 비교 가능">@(_magicBusy ? "⏳ 확장 중…" : "✨ 플루토 감독 확장")</button>
                @if (_magic is { } mx)
                {
                    <span class="ws-learn-msg" role="status">@mx.SummaryKo</span>
                    <div class="ws-pf-cmp" data-pluto-magic-preview="1"><div><b>확장본</b> @mx.RefinedPrompt</div></div>
                    <button class="ws-pf-btn" @onclick="ApplyMagicExpand" disabled="@State.IsBusy" data-pluto-magic-apply="1">✅ 적용</button>
                    <button class="ws-pf-btn" @onclick="() => _magic = null" data-pluto-magic-cancel="1">✕ 취소</button>
                }
            </div>
            @* 👶 아기 감성 & 성장 무드 칩 바 · ✨ 3종 스타일 동시 전개 *@
            <div class="ws-mood-bar" role="group" aria-label="아기 감성 & 성장 무드">
                <span class="ws-mood-cap">아기 감성 & 성장 무드</span>
                @{ var activeMood = PromptFlowStudio.Services.AI.GeminiPromptService.ActiveBabyMood(_prompt); }
                @for (var i = 0; i < PromptFlowStudio.Services.AI.GeminiPromptService.BabyMoods.Length; i++)
                {
                    var mp = PromptFlowStudio.Services.AI.GeminiPromptService.BabyMoods[i];
                    <button class="ws-mood-chip @(activeMood == mp.Mood ? "on" : null)" @key="mp.Mood" @onclick="MoodPick(i)" disabled="@State.IsBusy"
                            title="@mp.Tokens">@mp.Emoji @mp.Label <small>(@mp.English)</small></button>
                }
                <button class="ws-mood-3way" @onclick="_threeWay" disabled="@(State.IsBusy || _variantBusy || string.IsNullOrWhiteSpace(_prompt))"
                        title="입력 아이디어를 Realistic Dark Quant · Cyber Neon Depth · Minimal Modern Studio 3종으로 동시 전개">@(_variantBusy ? "⏳ 전개 중…" : "✨ 3종 스타일 동시 전개")</button>
            </div>
            @if (_variants.Count > 0)
            {
                <div class="ws-var-tabs" role="tablist">
                    @for (var i = 0; i < _variants.Count; i++)
                    {
                        var v = _variants[i];
                        <button class="ws-var-tab @(_variantSel == i ? "on" : null)" role="tab" aria-selected="@(_variantSel == i ? "true" : "false")" @key="v.StyleKey"
                                @onclick="VariantPick(i)" disabled="@State.IsBusy" title="@v.Prompt">@(v.Index). @v.Title <small>🎥 @v.Camera · 🌱 @v.Seed.ToString(CultureInfo.InvariantCulture)</small></button>
                    }
                    <button class="ws-btn sm" @onclick="EnqueueVariants" disabled="@State.IsBusy" title="3종 프롬프트·시드를 렌더 큐에 일괄 적재">📥 3종 렌더 큐 적재</button>
                    <button class="ws-btn ghost sm" @onclick="ClearVariants">닫기</button>
                </div>
            }
            @if (_variantMsg is not null) { <div class="ws-hint">@_variantMsg</div> }
            @* 멀티 듀레이션 — 5s 단일(직접 생성) · 10s/15s 멀티 샷(렌더 큐 체이닝·합본) · 15s 앰비언트(5초 + 3x 슬로우 루프) *@
            <div class="ws-dur" role="radiogroup" aria-label="영상 길이">
                @for (var i = 0; i < DurationModes.Length; i++)
                {
                    var m = DurationModes[i];
                    <button class="ws-dur-chip @(_durationMode == m ? "on" : null)" role="radio" aria-checked="@(_durationMode == m ? "true" : "false")"
                            @onclick="_durPick[i]" disabled="@State.IsBusy" @key="m">@PromptFlowStudio.Services.Render.MultiDurationPlanner.Label(m)</button>
                }
            </div>
            @if (PromptFlowStudio.Services.Render.MultiDurationPlanner.IsMultiShot(_durationMode))
            {
                <div class="ws-dur-parts">
                    @for (var i = 0; i < PromptFlowStudio.Services.Render.MultiDurationPlanner.ShotCount(_durationMode); i++)
                    {
                        var idx = i;
                        <label class="ws-dur-part" @key="idx">
                            <span>@PromptFlowStudio.Services.Render.MultiDurationPlanner.PartLabel(idx)</span>
                            <textarea class="ws-ta ws-ta-part" @bind="_subPrompts[idx]" @bind:event="oninput" maxlength="800" disabled="@State.IsBusy"
                                      placeholder="@PromptFlowStudio.Services.Render.MultiDurationPlanner.ResolvePartPrompt(_prompt, null, idx, PromptFlowStudio.Services.Render.MultiDurationPlanner.ShotCount(_durationMode))"></textarea>
                        </label>
                    }
                    <div class="ws-dur ws-cut-trans" role="radiogroup" aria-label="컷 전환 방식" data-cut-transition="@(_cutTransition)">
                        <span class="ws-dur-hint">🎬 컷 전환 방식</span>
                        @foreach (var tm in CutTransitionChoices)
                        {
                            var t = tm;
                            <button class="ws-dur-chip @(_cutTransition == t ? "on" : null)" role="radio" @key="t"
                                    aria-checked="@(_cutTransition == t ? "true" : "false")" disabled="@State.IsBusy"
                                    @onclick="() => _cutTransition = t">@PromptFlowStudio.Services.Render.MultiDurationPlanner.TransitionLabel(t)</button>
                        }
                    </div>
                    <div class="ws-dur-hint">@(_cutTransition switch
                    {
                        PromptFlowStudio.Services.Render.CutTransitionMode.LastFrameChain => "비운 파트는 메인 프롬프트 + 카메라 모션 차등 상속 · 이전 컷 마지막 프레임이 다음 컷 I2V 앵커로 주입됩니다(피사체가 화면 밖으로 나가면 왜곡될 수 있음).",
                        PromptFlowStudio.Services.Render.CutTransitionMode.IndependentCrossfade => "각 컷을 자기 프롬프트로 독립 생성 → 0.25초 디졸브 합본(앵글이 다르면 반투명 잔상이 보일 수 있음) · 피사체/유니폼 일관성 힌트 자동 부착.",
                        _ => "각 컷을 자기 프롬프트로 독립 생성 → 하드 컷(0.0초 직접 연결) 합본 · 디졸브 고스트 잔상 없음 · 피사체/유니폼 일관성 힌트 자동 부착 · 메인이 비면 파트 1 이 주 프롬프트로 쓰입니다.",
                    })</div>
                </div>
            }
            else if (PromptFlowStudio.Services.Render.MultiDurationPlanner.IsSinglePromptLong(_durationMode))
            {
                <div class="ws-dur ws-wan-model" role="radiogroup" aria-label="Wan 모델" data-wan-model="@(Cfg.ModelFamily)">
                    @foreach (var fam in new[] { PromptFlowStudio.Services.Wan.WanModelFamily.Wan26, PromptFlowStudio.Services.Wan.WanModelFamily.Wan21 })
                    {
                        var f = fam;
                        <button class="ws-dur-chip @(Cfg.ModelFamily == f ? "on" : null)" role="radio" aria-checked="@(Cfg.ModelFamily == f ? "true" : "false")"
                                disabled="@State.IsBusy" @onclick="() => PickWanFamily(f)" @key="f">@PromptFlowStudio.Services.Wan.WanModelCatalog.Label(f)</button>
                    }
                </div>
                @if (PromptFlowStudio.Services.Render.MultiDurationPlanner.SegmentPlan(_durationMode, NativeClipSeconds).Count > 1)
                {
                    <div class="ws-dur ws-cut-trans" role="radiogroup" aria-label="세그먼트 전환 방식" data-long-transition="@(_longTransition)">
                        <span class="ws-dur-hint">🎬 세그먼트 전환</span>
                        @foreach (var lm in LongTransitionChoices)
                        {
                            var l = lm;
                            <button class="ws-dur-chip @(_longTransition == l ? "on" : null)" role="radio" @key="l"
                                    aria-checked="@(_longTransition == l ? "true" : "false")" disabled="@State.IsBusy"
                                    @onclick="() => _longTransition = l">@(l == PromptFlowStudio.Services.Render.CutTransitionMode.IndependentCrossfade ? "0.25초 디졸브" : "하드 컷 (기본)")</button>
                        }
                    </div>
                }
                <div class="ws-dur-hint" data-single-prompt-plan="1">@SegmentPlanLabel() — 파트 입력 없이 메인 프롬프트만 사용합니다@(NativeClipSeconds < 15 && Cfg.ModelFamily == PromptFlowStudio.Services.Wan.WanModelFamily.Wan26 ? " (Cloud 렌더 모드에서만 15초 네이티브)" : "").</div>
            }
            else if (_durationMode == PromptFlowStudio.Services.Render.VideoDurationMode.Sec15_AmbientSlow)
            {
                <span class="ws-pcore on" data-ambient-badge="1">🌙 15초 엠비언트 루프 · 5초 마스터 → 무이음새 15초 핑퐁</span>
                <label class="ws-dur-hint"><input type="checkbox" @bind="_ambientPingPong" disabled="@State.IsBusy" /> 🔁 리버스 핑퐁 루프(시작·끝 이음새 제거)</label>
            }
            @if (_durationMode != PromptFlowStudio.Services.Render.VideoDurationMode.Sec5_Single && !State.IsBusy && string.IsNullOrWhiteSpace(EffectivePrompt) && string.IsNullOrWhiteSpace(_imagePath))
            {
                <div class="ws-dur-hint" role="status" data-duration-need-input="1">⚠ 프롬프트를 입력하거나(T2V) 참조 사진 1장을 올려 주세요(I2V) — 입력 후 [✨ 생성 시작]</div>
            }
            @if (_durationMsg is not null) { <div class="ws-dur-hint">@_durationMsg</div> }
            @* ⚡ 프로바이더 회로 차단 상태 — 닫히지 않은 회로만 노출 · [지금 탐침](냉각 건너뛰기) · [차단 해제](수동 복구) *@
            @if (_circuitRows.Count > 0)
            {
                <div class="ws-dur-hint" role="status" data-circuit-strip="@(_circuitRows.Count.ToString(CultureInfo.InvariantCulture))" style="white-space:normal;display:flex;flex-wrap:wrap;gap:6px;align-items:center">
                    @foreach (var circuit in _circuitRows)
                    {
                        var circuitProvider = circuit.Provider;
                        <span data-circuit-state="@(circuit.State.ToString())" title="@(circuit.LastError ?? "최근 오류 없음")">⚡ @(circuit.ToLabel())</span>
                        <button class="ws-back" data-circuit-probe="1" disabled="@(circuit.State != PromptFlowStudio.Services.Render.ProviderCircuitState.Open)" @onclick="() => ProbeCircuit(circuitProvider)" title="남은 냉각을 건너뛰고 다음 렌더 1건을 복구 탐침으로 보냅니다 — 실패하면 냉각 2배로 다시 차단">[🔎 지금 탐침]</button>
                        <button class="ws-back" data-circuit-reset="1" @onclick="() => ResetCircuit(circuitProvider)" title="프로바이더 복구를 직접 확인했을 때 — 회로를 즉시 닫고 연속 실패를 초기화">[♻️ 차단 해제]</button>
                    }
                </div>
            }
            @if (_coherenceBadge is { } cohBadge) { <div class="ws-dur-hint" role="status" data-coherence-badge="@(_coherenceScore.ToString(CultureInfo.InvariantCulture))" title="@(_coherenceDetail)" style="white-space:normal">@(cohBadge)</div> }
            @if (_mini.Phase != PromptFlowStudio.Services.Render.MiniQueuePhase.Idle)
            {
                <div class="ws-mini-q @(_mini.Phase == PromptFlowStudio.Services.Render.MiniQueuePhase.Failed || _miniStitchFail is not null || _miniError is not null ? "bad" : null)">
                    <div class="ws-mini-q-h">
                        <div class="ws-mini-q-l">@(_miniStitchFail is null ? _mini.Label : "⚠ 합본 실패 — " + _miniStitchFail)</div>
                        @if (_mini.IsActive)
                        {
                            <button class="ws-btn ghost sm ws-mini-q-x" @onclick="CancelMiniQueue" title="이 그룹의 전 컷 일괄 취소 · GPU 추론 즉시 중단(ComfyUI /interrupt)">❌ 취소</button>
                        }
                    </div>
                    <div class="ws-mini-q-bar"><i style="width:@(_mini.Percent.ToString(CultureInfo.InvariantCulture))%"></i></div>
                    @if (_miniError is not null) { <div class="ws-mini-err">⛔ @(_miniError)</div> }
                    @if (_miniNotice is not null) { <div class="ws-mini-note">ℹ @(_miniNotice)</div> }
                    @if (_miniCheckpoint is not null) { <div class="ws-mini-note"><span class="ws-ckpt-badge" data-checkpoint-reuse="1" title="@(_miniCheckpoint)">@(PromptFlowStudio.Services.Render.VideoEngineRenderExecutionEngine.CheckpointBadgeLabel)</span> @(_miniCheckpoint)</div> }
                    @if (_mini.Phase == PromptFlowStudio.Services.Render.MiniQueuePhase.Completed && _mini.FinalPath is { } miniFinal)
                    {
                        <button class="ws-btn sm ws-pub" @onclick="() => OpenPublish(miniFinal)" title="YouTube Shorts · Instagram Reels 원클릭 발행">🚀 SNS 원클릭 발행</button>
                    }
                </div>
            }
            <div class="ws-row">
                <label class="ws-lbl">해상도
                    <select class="ws-sel" @bind="_size" @bind:after="SyncSize" disabled="@State.IsBusy">
                        <option value="1280*720">가로 1280×720 (16:9)</option>
                        <option value="720*1280">세로 720×1280 (9:16)</option>
                        <option value="960*960">정사각 960×960 (1:1)</option>
                    </select>
                </label>
                <span class="ws-count @(_vm.IsOverBudget ? "over" : null)" title="Wan 2.1 합성 프롬프트 글자 수">@_vm.CharacterCount / @_vm.MaxCharacterLimit</span>
            </div>
            @* v15.6.0 🎥 Wan 2.1 시네마틱 카메라 & 그래픽 스타일 — 그룹 배타 결합(재클릭 0B) *@
            <div class="ws-zen">
                <div class="ws-zen-h">🎥 Wan 2.1 카메라 & 스타일 스튜디오</div>
                @{ var camOn = WanCameraStyleStudio.ActiveIndex(_prompt, WanCameraStyleStudio.Cameras); var styOn = WanCameraStyleStudio.ActiveIndex(_prompt, WanCameraStyleStudio.Styles); }
                <div class="ws-zen-l">카메라 모션</div>
                <div class="ws-zen-g cam">
                    @for (var i = 0; i < _zenCam.Length; i++)
                    {
                        var z = WanCameraStyleStudio.Cameras[i];
                        <button class="ws-zen-chip @(camOn == i ? "on" : null)" @onclick="_zenCam[i]" disabled="@State.IsBusy" title="@z.Snippet" @key="z.Label"><span>@z.Icon</span>@z.Label</button>
                    }
                </div>
                <div class="ws-zen-l">그래픽 스타일</div>
                <div class="ws-zen-g sty">
                    @for (var i = 0; i < _zenSty.Length; i++)
                    {
                        var z = WanCameraStyleStudio.Styles[i];
                        <button class="ws-zen-chip @(styOn == i ? "on" : null)" @onclick="_zenSty[i]" disabled="@State.IsBusy" title="@z.Snippet" @key="z.Label"><span>@z.Icon</span>@z.Label</button>
                    }
                </div>
            </div>
            @* 🖼️ 첫 화면 미리보기 — 정적 예상 프레임 더미 대체: [첫 화면 미리보기] 명시 클릭 시에만 Gemini 이미지 1장 생성(키 입력마다 호출 금지)
               → [이 첫 화면으로 영상 생성] 시 시작 프레임(I2V 참조)으로 바인딩 후 생성. 키 미설정/실패는 Redact 안내. *@
            <div class="ws-ffp" data-first-frame-preview="1">
                <div class="ws-ffp-h">
                    <span>🖼️ 첫 화면 미리보기</span>
                    <span class="ws-hint">@(GeminiPromptService.AspectRatioOf(_size))</span>
                </div>
                <div class="ws-ffp-vp" style="aspect-ratio: @(FirstFrameAspectCss)">
                    @if (_ffpUrl is not null)
                    {
                        <img src="@_ffpUrl" alt="첫 화면 미리보기" @key="_ffpUrl" />
                    }
                    else
                    {
                        <div class="ws-ffp-ph">@(_ffpBusy ? "⏳ 첫 화면 생성 중…" : "프롬프트 입력 후 [첫 화면 미리보기]를 누르면 생성 전 첫 장면을 확인할 수 있습니다.")</div>
                    }
                </div>
                <div class="ws-ffp-act">
                    <button class="ws-btn ghost sm" @onclick="GenerateFirstFramePreviewAsync" disabled="@(_ffpBusy || State.IsBusy || string.IsNullOrWhiteSpace(EffectivePrompt))"
                            title="현재 프롬프트로 정지 이미지 1장을 생성합니다(Gemini 이미지 · 클릭 시에만 호출)">@(_ffpBusy ? "⏳ 생성 중…" : "🖼️ 첫 화면 미리보기")</button>
                    @if (_ffpPath is not null && !_ffpLocal)
                    {
                        <button class="ws-btn sm" @onclick="UseFirstFramePreviewAsync" disabled="@(_ffpBusy || State.IsBusy)" data-first-frame-use="1"
                                title="이 이미지를 시작 프레임(I2V 참조)으로 지정하고 영상 생성을 시작합니다">🎬 이 첫 화면으로 영상 생성</button>
                    }
                    @if (_ffpPath is not null && !_ffpLocal && _imagePath is null)
                    {
                        <label class="ws-hint" data-first-frame-bind="1" title="[✨ 생성 시작] 시 이 미리보기를 컷 1 시작 프레임(I2V)으로 자동 사용 — 끄면 프롬프트만으로 생성">
                            <input type="checkbox" @bind="_ffpBindCut1" disabled="@State.IsBusy" /> 🎯 컷 1 시작 프레임으로 사용
                        </label>
                        <button class="ws-btn ghost sm" @onclick="DiscardFirstFramePreviewFile" disabled="@State.IsBusy" data-first-frame-clear="1" title="미리보기 제거(컷 1 바인딩 해제)">✕ 미리보기 지우기</button>
                    }
                    @if (_ffpMsg is { Length: > 0 }) { <span class="ws-hint" role="status">@_ffpMsg</span> }
                </div>
            </div>
            <div class="ws-actions">
                @if (State.IsBusy)
                {
                    <button class="ws-btn ghost" @onclick="State.Cancel">■ 취소</button>
                }
                else
                {
                    <button class="ws-btn" disabled="@(!CanStart || _preflightBusy || _anchorBusy)" @onclick="Start">@(_anchorBusy ? "🎯 첫 프레임 시드 생성 중…" : _preflightBusy ? "🛡️ 프롬프트 보정 중…" : "✨ 생성 시작")</button>
                }
                <label class="ws-pf-tog" title="생성 직전 프롬프트를 분석해 클립 길이에 맞게 동작을 압축하고 카메라·피사체·조명·물리 연속성 앵커와 안티 아티팩트 네거티브를 자동 보정합니다(모든 장르 공통 · Gemini 키 없으면 로컬 규칙)." data-preflight-toggle="@(_preflightOn ? "on" : "off")">
                    <input type="checkbox" @bind="_preflightOn" disabled="@(State.IsBusy || _preflightBusy)" /> 🛡️ AI 프롬프트 자동 보정
                </label>
                <label class="ws-pf-tog" title="참조 사진·고정된 미리보기가 없으면 [✨ 생성 시작] 시 Gemini 로 깨끗한 첫 프레임 1장을 자동 생성해 컷 1 시작 프레임(I2V 시드)으로 고정합니다 — 머리 잘림·크롭 시작 방지(키 없거나 실패 시 프롬프트만으로 생성)" data-auto-anchor-toggle="@(_autoAnchorOn ? "on" : "off")">
                    <input type="checkbox" @bind="_autoAnchorOn" disabled="@(State.IsBusy || _anchorBusy)" /> 🎯 자동 첫 프레임 시드 고정
                </label>
                <span class="ws-eng ws-eng-@(_renderMode.ToLowerInvariant())" title="[환경설정] 기본 렌더 모드 — 변경 즉시 반영">● 렌더 엔진: @(_renderMode)</span>
            </div>
            @if (_preflight is { } pf)
            {
                <div class="ws-pf-badge" role="status" data-preflight-badge="@(pf.UsedFallback ? "local" : "ai")">
                    <span class="ws-pf-sum">@(_preflightReverted ? "↩ 원문으로 되돌림 — 다음 생성부터 원문 그대로 전송" : pf.SummaryKo)</span>
                    @if (!_preflightReverted && pf.LearnedRulesApplied > 0)
                    {
                        <span class="ws-learn-ind" data-pluto-learned="@(pf.LearnedRulesApplied.ToString(CultureInfo.InvariantCulture))" title="과거 👍 성공 레시피 · 👎 실패 회피 규칙 중 이 프롬프트와 유사한 패턴을 자동 적용했습니다">🧠 플루토 학습 패턴 @(pf.LearnedRulesApplied.ToString(CultureInfo.InvariantCulture))건 적용됨</span>
                    }
                    <button class="ws-pf-btn" @onclick="() => _preflightInspect = !_preflightInspect" aria-pressed="@(_preflightInspect ? "true" : "false")" data-preflight-inspect="1">@(_preflightInspect ? "접기" : "🔍 비교")</button>
                    <button class="ws-pf-btn" @onclick="TogglePreflightRevert" data-preflight-revert="1">@(_preflightReverted ? "🛡️ 보정 다시 사용" : "↩ 원문으로")</button>
                    @if (_preflightInspect)
                    {
                        <div class="ws-pf-cmp">
                            <div><b>원문</b> @pf.RawPrompt</div>
                            <div><b>보정본</b> @pf.RefinedPrompt</div>
                            <div><b>네거티브</b> @pf.MergedNegative</div>
                        </div>
                    }
                </div>
            }
        </div>

        @* ── ② 진행 / 결과 ── *@
        <div class="ws-card">
            <div class="ws-card-h">
                <span>② 🎬 라이브 비디오 캔버스</span>
                <span class="ws-hts-tools">
                    <button class="ws-hts-tog @(_growthBadge ? "on" : null)" @onclick="() => _growthBadge = !_growthBadge" aria-pressed="@(_growthBadge ? "true" : "false")" title="개월 수 · 성장 마일스톤 뱃지와 자막을 영상 위에 미리보기" data-canvas-tool="growth-badge">🏷️ 성장 뱃지/자막</button>
                    <button class="ws-hts-tog @(_letterSubs ? "on" : null)" @onclick="() => _letterSubs = !_letterSubs" aria-pressed="@(_letterSubs ? "true" : "false")" title="내보내기 시 플루토 3막 KO/EN 이중 감성 편지 자막(1~4초 · 5~10초 · 11~14초)을 주 MP4 에 2줄 번인하고 이중 언어 {출력명}.srt 를 함께 저장" data-canvas-tool="letter-subs">🏷️ 감성 자막 포함</button>
