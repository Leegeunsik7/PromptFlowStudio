    /* 🔀 캔버스 A/B 스플릿 — 원본(좌) | backdrop LUT+샤프닝(우) · --ab 는 JS 가 직접 갱신 */
    .ws-hts-wrap.ab-on .ws-video { filter: none; }
    .ws-ab { position: absolute; inset: 0; pointer-events: none; border-radius: 12px; overflow: hidden; --ab: 50%; }
    .ws-ab-b { position: absolute; top: 0; bottom: 44px; left: var(--ab); right: 0; border-left: 2px solid #3d8bff; }
    .ws-ab-h { position: absolute; top: 0; bottom: 44px; left: var(--ab); width: 22px; margin-left: -11px; pointer-events: auto; cursor: ew-resize; touch-action: none; background: transparent; border: 0; padding: 0; }
    .ws-ab-h::after { content: "⇔"; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 26px; height: 26px; border-radius: 50%; background: #3d8bff; color: #fff; font: 700 13px/26px var(--mono); text-align: center; box-shadow: 0 0 0 3px rgba(61,139,255,.25); }
