    /// <summary>🎞️ [최근 렌더 영상 불러오기] — 선택 영상 메타 → 성과 입력 자동 채움(지표 입력값 유지).</summary>
    private void OnCatalogClipPicked(ChangeEventArgs e)
    {
        var id = e.Value as string ?? "";
        _catalogPick = id;
        if (id.Length == 0) return;
        foreach (var c in _catalogClips)
        {
            if (!string.Equals(c.VideoId, id, StringComparison.Ordinal)) continue;
            _perfVideoId = c.VideoId;
            _perfHookStyle = c.HookStyle;
            _perfLookId = c.ColorLookId;
            _perfBgmMood = c.BgmMood;
            _perfStyleTags = string.Join(", ", c.Tags);
            _perfContextSource = "🎞️ " + c.RenderMode;
            _perfOutcome = null;
            return;
        }
    }

