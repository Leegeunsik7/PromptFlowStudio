    .ws-vf { position: relative; height: min(40vh, 280px); width: auto; max-width: 100%; margin-bottom: 6px; border: 1px dashed color-mix(in srgb, #22d3ee 55%, var(--line)); border-radius: 6px;
        background: radial-gradient(ellipse at center, color-mix(in srgb, #22d3ee 6%, transparent), transparent 70%); overflow: hidden; }
