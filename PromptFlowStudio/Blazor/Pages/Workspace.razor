            var r = await StockSuite.ExportWithSubtitlesAsync(path, cues, project, _mediaCts.Token, _snsKit, _prompt, cues ?? _montageCues);   // 🎵 BGM 직접 먹싱 · 💌 시간 게이트 drawtext + {출력}.srt · 🎁 subtitles.srt(🔒 3막 자막) · SNS_게시문.txt · thumbnail.jpg
            if (r.Ok && _specPath == path) { _spec = null; _specPath = null; }   // ⚡ 인코더 텔레메트리 갱신 → 규격 캐시 무효화
            if (r.Ok) LearnPositiveSilently();   // 🧠 내보내기 = 👍 강화(직전 생성 프롬프트 기준 · 예외 격리)
