    private async Task ApplyRecipeAsync(PromptFlowStudio.Services.Prompt.StoryRecipe recipe)
    {
        if (!await FadeOutInspirationAsync()) return;
        _vm.ApplyRecipe(recipe);
        _prompt = _vm.UserInput ?? "";
        // 카테고리 기본 네거티브 칩(핀테크 등) — 중복 없이 기존 네거티브 뒤에 결합
        if (PromptFlowStudio.Services.Prompt.PromptInspirationService.DefaultNegativeFor(recipe.Category) is { } neg
            && !_baby.NegativePrompt.Contains(neg, StringComparison.Ordinal))
            _baby.NegativePrompt = string.IsNullOrWhiteSpace(_baby.NegativePrompt) ? neg : _baby.NegativePrompt.TrimEnd().TrimEnd(',') + ", " + neg;
    }
    private async Task ApplyChipsAsync()
    {
        if (!await FadeOutInspirationAsync()) return;
        var p = ChipAt(PromptFlowStudio.Services.Prompt.PromptInspirationService.Subjects, _chipSubj);
        var e = ChipAt(PromptFlowStudio.Services.Prompt.PromptInspirationService.Environments, _chipEnv);
        var m = ChipAt(PromptFlowStudio.Services.Prompt.PromptInspirationService.Motions, _chipMot);
        var l = ChipAt(PromptFlowStudio.Services.Prompt.PromptInspirationService.Lightings, _chipLight);
        if (_vm.BuildAndApplyChips(p, e, m, l)) _prompt = _vm.UserInput ?? "";
        else _vm.IsInspirationModalOpen = false;
    }
