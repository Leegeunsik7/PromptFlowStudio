    private string[] ActiveViralTagsSafe(int max)
    {
        try
        {
            var learning = EcoSp.GetService(typeof(PromptFlowStudio.Services.Pluto.PlutoLearningService)) as PromptFlowStudio.Services.Pluto.PlutoLearningService;
            var active = learning?.GetActiveViralTrends(max);
            var tags = new string[active?.Count ?? 0];
            for (var i = 0; i < tags.Length; i++) tags[i] = active![i].Tag;
            return tags;
        }
        catch (Exception ex) { Program.Log("Workspace.ViralTags", ex); return Array.Empty<string>(); }
    }

    /// <summary>📱 [9:16 릴스/쇼츠 스마트 패키징 &amp; SNS 키트] — 4단 페일오버 키트 생성(실패 → 템플릿 · 예외 전파 금지).</summary>
    private async Task GenerateSnsKitAsync()
    {
        if (_snsBusy || _montagePhotos.Count < 2) return;
        _snsBusy = true;
        _snsToast = null;
        StateHasChanged();
        try
        {
            var packager = EcoSp.GetService(typeof(PromptFlowStudio.Services.Pluto.IPlutoMultiFormatPackager)) as PromptFlowStudio.Services.Pluto.IPlutoMultiFormatPackager;
            var tags = ActiveViralTagsSafe(5);
            if (packager is null)
            {
                var notebook = EcoSp.GetService(typeof(PromptFlowStudio.Services.Pluto.IPlutoMistakeNotebookService)) as PromptFlowStudio.Services.Pluto.IPlutoMistakeNotebookService;
                _snsKit = PromptFlowStudio.Services.Pluto.PlutoMultiFormatPackager.BuildTemplateKit(MontageThemeHint(), tags, _montageCues, notebook?.GetSuppressedTokens(), DateTime.UtcNow);
            }
            else _snsKit = await packager.GeneratePublishingKitAsync(MontageThemeHint(), tags, _montageCues, _mediaCts.Token);
        }
        catch (OperationCanceledException) { return; }   // 페이지 이탈
        catch (Exception ex) { Program.Log("Workspace.SnsKit", ex); _snsToast = "⚠ SNS 키트 생성 실패: " + PromptFlowStudio.Services.Pluto.PlutoAutonomousActivityFeedService.Redact(ex.Message); }
        finally { _snsBusy = false; }
        if (_disposed) return;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>📋 키트 복사 — 0..2 제목 · -1 캡션 · -2 해시태그 · -3 전체.</summary>
    private void CopySnsPart(int part)
    {
        if (_snsKit is not { } kit) return;
        string text, label;
        if (part >= 0 && part < kit.Titles.Count) { text = kit.Titles[part]; label = "제목"; }
        else if (part == -1) { text = kit.CaptionEn.Length > 0 ? kit.CaptionKo + "\n\n" + kit.CaptionEn : kit.CaptionKo; label = "캡션"; }
        else if (part == -2) { text = string.Join(" ", kit.Hashtags); label = "해시태그"; }
        else { text = kit.FullText; label = "전체 키트"; }
        try { _snsToast = Clipboard.SetText(text) ? "📋 " + label + "이(가) 복사되었습니다" : "⚠ 클립보드 복사에 실패했습니다"; }
        catch (Exception ex) { Program.Log("Workspace.SnsCopy", ex); _snsToast = "⚠ 클립보드 복사에 실패했습니다"; }
    }

    /// <summary>📋 Pluto 4.6 — 플랫폼 정규화 원클릭 복사(JS 클립보드 → 네이티브 클립보드 폴백 · 예외 전파 금지).</summary>
    private async Task CopySnsPlatformAsync(bool shorts)
    {
        if (_snsKit is not { } kit) return;
        var text = shorts ? PromptFlowStudio.Services.Pluto.PlutoMultiFormatPackager.FormatForYouTubeShorts(kit) : PromptFlowStudio.Services.Pluto.PlutoMultiFormatPackager.FormatForInstagramReels(kit);
        var label = shorts ? "▶️ 쇼츠용 업로드 문구" : "📸 릴스용 업로드 문구";
        var ok = false;
        try { ok = await JS.InvokeAsync<bool>("siteMaticClip.copy", text); }
        catch (OperationCanceledException) { return; }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException) { Program.Log("Workspace.SnsPlatformCopy.Js", ex); }
        if (!ok)
        {
            try { ok = Clipboard.SetText(text); }
            catch (Exception ex) { Program.Log("Workspace.SnsPlatformCopy", ex); }
        }
        if (_disposed) return;
        _snsToast = ok ? "📋 " + label + "가 복사되었습니다 — 바로 붙여넣기 하세요" : "⚠ 클립보드 복사에 실패했습니다";
        await InvokeAsync(StateHasChanged);
    }

