    // ══════ ✂️ 무손실 키프레임 트리머 ══════
    private bool _trimOpen;
    private double _trimStart = 0.5, _trimEnd = 14.5;

    private async Task ToggleTrim()
    {
        _trimOpen = !_trimOpen;
        if (!_trimOpen || await ReadPlayheadAsync() is not { } st || st[1] <= 0 || double.IsNaN(st[1])) return;
        _trimStart = Math.Min(0.5, Math.Round(st[1] * 0.1, 1));
        _trimEnd = Math.Max(_trimStart + 0.1, Math.Round(st[1] - Math.Min(0.5, st[1] * 0.1), 1));
    }

    private async Task MarkTrimAsync(bool start)
    {
        if (await ReadPlayheadAsync() is not { } st) { _scrubMsg = "⚠ 재생 중인 영상을 찾지 못했습니다."; return; }
        var t = Math.Round(st[0], 1);
        if (start) _trimStart = t; else _trimEnd = t;
    }

    private async Task ApplyTrimAsync(bool overwrite)
    {
        if (_scrubBusy || InspectPath is not { } path) return;
        var st = await ReadPlayheadAsync();
        if (PromptFlowStudio.Services.Video.VideoTrimService.ValidateRange(_trimStart, _trimEnd, st?[1]) is { } bad) { _scrubMsg = "⚠ " + bad; return; }
        _scrubBusy = true;
        _scrubMsg = "✂️ 무손실 컷 중…";
        try
        {
            // 🔓 덮어쓰기: 임시 컷 → JS 소스 디태치(파일 핸들 해제) → 원자 교체 → 캐시 버스트(?v=ticks) 재마운트. 훅은 렌더러 컨텍스트에서 JS 호출.
            var hooks = new PromptFlowStudio.Services.Video.VideoHandleHooks(
                c => InvokeAsync(() => JS.InvokeVoidAsync("promptflow.releaseVideoSwap", c, ScrubVideoSelector).AsTask()),   // 🧊 프리즈 프레임 → 핸들 해제
                (ok, c) => InvokeAsync(() => JS.InvokeVoidAsync("promptflow.reloadVideoSwap", c, ScrubVideoSelector, null).AsTask()));   // 🎞️ 크로스디졸브 재적재
            var r = overwrite
                ? await Trimmer.TrimInPlaceAsync(path, _trimStart, _trimEnd, hooks, _mediaCts.Token)
                : await Trimmer.TrimAsync(path, PromptFlowStudio.Services.Video.VideoTrimService.BuildClipPath(Path.GetDirectoryName(path) ?? Media.MediaRoot, path, _trimStart, _trimEnd), _trimStart, _trimEnd, _mediaCts.Token);
            _scrubMsg = r.Ok ? r.Message + (r.DurationSeconds is { } dur ? " · ⏱ " + dur.ToString("0.0", CultureInfo.InvariantCulture) + "s" : "") + (overwrite ? "" : " → 갤러리 저장: " + Path.GetFileName(r.Path)) : "⚠ " + r.Message;
            if (r.Ok && overwrite)
            {
                _scrubFpsPath = null;
                if (_spec is not null && _specPath == path) { _spec = null; _specPath = null; }   // 규격 캐시 무효화(길이 변경)
            }
            if (r.Ok && r.Path is { } outPath)
            {
                try { GalleryMedia.NotifyMediaMetadataChanged(outPath, r.DurationSeconds); }   // 🗂️ 갤러리/스토리보드 재생시간 뱃지 즉시 갱신
                catch (Exception ex) { Program.Log("Workspace.TrimNotify", ex); }
            }
            if (r.Ok) _trimOpen = false;
        }
        catch (OperationCanceledException) { _scrubMsg = null; }
        catch (Exception ex) { Program.Log("Workspace.Trim", ex); _scrubMsg = "⚠ 구간 자르기 실패"; }
        finally { _scrubBusy = false; }
    }

    private async Task EnsureScrubFpsAsync(string path)
    {
        if (_scrubFpsPath == path) return;
        double? fps = _spec is { } sp && _specPath == path ? sp.Fps : null;
        if (fps is null)
        {
            try { fps = (await Probe.ProbeAsync(path, _mediaCts.Token))?.Fps; }
            catch (Exception ex) when (ex is not OperationCanceledException) { Program.Log("Workspace.ScrubFps", ex); }
        }
        _scrubFps = PromptFlowStudio.Services.Export.StockSuiteExporter.NormalizeFps(fps);
        _scrubFpsPath = path;
    }

    private async Task<double[]?> ReadPlayheadAsync()
    {
        try
        {
            var st = await JS.InvokeAsync<double[]>("pfsFrameScrub.get", ScrubVideoSelector);
            return st is { Length: >= 2 } ? st : null;
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException) { Program.Log("Workspace.ScrubGet", ex); return null; }
    }

    private async Task StepFrameAsync(int frames)
    {
        if (_scrubBusy || InspectPath is not { } path) return;
        _scrubBusy = true;
        try
        {
            await EnsureScrubFpsAsync(path);
            if (await ReadPlayheadAsync() is not { } st) { _scrubMsg = "⚠ 재생 중인 영상을 찾지 못했습니다."; return; }
            var t = PromptFlowStudio.Services.Export.StockSuiteExporter.StepFrame(st[0], frames, _scrubFps, st[1]);
            await JS.InvokeAsync<bool>("pfsFrameScrub.seek", ScrubVideoSelector, t);
            var frame = (long)Math.Round(t * _scrubFps);
            _scrubMsg = "🎞️ F" + frame.ToString(CultureInfo.InvariantCulture) + " · " + t.ToString("0.000", CultureInfo.InvariantCulture) + "s @" + _scrubFps.ToString("0.##", CultureInfo.InvariantCulture) + "fps";
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException) { Program.Log("Workspace.ScrubStep", ex); _scrubMsg = "⚠ 프레임 이동 실패"; }
        finally { _scrubBusy = false; }
    }

    private async Task ExtractSnapshotAsync()
    {
        if (_scrubBusy || InspectPath is not { } path) return;
        _scrubBusy = true;
        _scrubMsg = "📸 추출 중…";
        try
        {
            var st = await ReadPlayheadAsync();
            var r = await StockSuite.ExtractSnapshotAsync(path, st?[0] ?? 0, Path.Combine(Media.MediaRoot, "_stills"), _mediaCts.Token);
            _lastSnap = r.Ok ? r.Path : _lastSnap;
            _scrubMsg = r.Ok ? r.Message + " → 갤러리 스틸 보존" : "⚠ " + r.Message;
        }
        catch (Exception ex) when (ex is not OperationCanceledException) { Program.Log("Workspace.Snapshot", ex); _scrubMsg = "⚠ 스냅샷 추출 실패"; }
        catch (OperationCanceledException) { _scrubMsg = null; }
        finally { _scrubBusy = false; }
    }

