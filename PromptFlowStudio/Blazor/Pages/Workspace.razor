            for (var i = 0; i < csv.Length; i++) if (csv[i] == '\n') n++;
            n = Math.Max(0, n - 1);   // 헤더 제외
            _batchCsv = csv;
            _batchToast = n == 0 ? "📋 미학습 영상이 없습니다 — 모든 렌더 영상의 성과가 반영되었습니다." : "📋 미학습 영상 " + n.ToString(CultureInfo.InvariantCulture) + "편을 불러왔습니다 — 수치를 실제 값으로 고친 뒤 [일괄 학습 실행]";
        }
        catch (OperationCanceledException) { return; }
        catch (Exception ex) { Program.Log("Workspace.BatchTemplate", ex); _batchToast = "⚠ 템플릿 생성 실패: " + PromptFlowStudio.Services.Pluto.PlutoAutonomousActivityFeedService.Redact(ex.Message); }
