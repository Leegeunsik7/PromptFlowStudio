@page "/workspace"
@using System.Globalization
@using PromptFlowStudio.Services.AI
@using PromptFlowStudio.Blazor.Components.Workflow
@implements IDisposable
@inject WanJobState State
@inject ILocalMediaService Media
@inject IMediaLibraryService Library
@inject IWanConfigService Cfg
@inject IVideoMergeService Merge
@inject PromptDraftService Draft
@inject PromptFlowStudio.Services.Platform.ErrorDialogService Errors
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IServiceProvider EcoSp
@inject AiAudioDrivenLipSyncService LipAi
@inject AiVoiceoverTtsService Tts
@inject EpisodicStorySeriesBuilder SeriesBuilder
@inject PromptFlowStudio.Services.Prompt.PromptSynthesizerService Synth
@inject PromptFlowStudio.Services.AI.GeminiPromptService GeminiSvc
@inject PromptFlowStudio.Services.AI.PlutoVideoLearningMemoryService PlutoLearn
@inject PromptFlowStudio.ViewModels.StoryboardViewModel StoryVm
@inject PromptFlowStudio.Services.Camera.WirelessCameraService WirelessCam
@inject PromptFlowStudio.Services.Gallery.GalleryMediaService GalleryMedia
@inject PromptFlowStudio.Services.Prompt.PromptInspirationService Inspiration
@inject PromptFlowStudio.Services.Render.IRenderQueueService RenderQueue
@inject PromptFlowStudio.ViewModels.PublishViewModel PubVm
@inject PromptFlowStudio.Services.Configuration.AppSettingsManager AppSettings
@inject PromptFlowStudio.Services.Platform.IClipboardService Clipboard
@inject PromptFlowStudio.Services.Export.StockSuiteExporter StockSuite
@inject PromptFlowStudio.Services.ProcessBridge.TradingSafetyGuardService TradingGuard
@inject PromptFlowStudio.Services.Video.VideoTrimService Trimmer
@inject PromptFlowStudio.Services.ProcessBridge.StockSuiteProcessMonitor StockMon
@inject PromptFlowStudio.Services.Prompt.PresetManagerService Presets
@inject PromptFlowStudio.Services.Render.MediaProbeService Probe
@inject PromptFlowStudio.Services.Export.StockSuiteWatchlistService Watchlist
@inject PromptFlowStudio.Services.Prompt.PromptHistoryService History
@inject PromptFlowStudio.Services.Render.TaskJournalService Journal
@inject PromptFlowStudio.Services.ProcessBridge.StockSuiteIpcBridge Ipc
@inject PromptFlowStudio.Services.Network.ResilientHttpClient Resilience
@inject PromptFlowStudio.Services.Chart.ChartStillGeneratorService ChartGen
@inject PromptFlowStudio.Services.Pluto.PlutoCopilot PlutoCopilotSvc
@inject PromptFlowStudio.Services.Pluto.PlutoIdentityVault IdentityVault
@inject PromptFlowStudio.Services.Pluto.PlutoLocalAiSettingsService LocalAiSettings
@inject PromptFlowStudio.Services.Pluto.PlutoCoreProcessManager PlutoCoreMgr
@inject PromptFlowStudio.Services.Pluto.IPlutoStorageManager PlutoStorage
@inject PromptFlowStudio.Services.Pluto.PlutoAutonomousTrendHarvester PlutoHarvester
@inject PromptFlowStudio.Services.Pluto.IPlutoDirectorRankService PlutoDirector
@inject PromptFlowStudio.Services.Pluto.Dsp.IPlutoBeatSyncQuantizer BeatQuantizer
@inject PromptFlowStudio.Services.Pluto.IPlutoImageFocalDetector FocalDetector
@inject PromptFlowStudio.Services.Pluto.IPlutoMontageCompiler MontageCompiler
@inject PromptFlowStudio.Services.Pluto.IPlutoPhotoCurationEngine Curation
@inject PromptFlowStudio.Services.Pluto.IPlutoCustomBgmService CustomBgm

@* [PromptFlow Studio] 새 프로젝트 — 텍스트→영상(Wan 2.1) 생성 파이프라인 구동 화면.
   상태는 WanJobState(싱글턴)에 있고, 이 컴포넌트는 OnChange 를 구독해 InvokeAsync(StateHasChanged)로만 갱신한다.
   ⚠ 생성은 fire-and-forget(_ = State.StartAsync)로 시작 — 버튼 핸들러가 수 분간 블록되지 않게 한다. *@

<PageTitle>PromptFlow Studio · 새 프로젝트</PageTitle>

<div class="ws" style="--ws-lut: @(PromptFlowStudio.Services.Export.ColorGradingService.CssFilter(_lut))">
    <header class="ws-head">
        <div class="ws-navrow ws-row-primary" data-ws-row="primary">
            <button class="ws-back" @onclick='() => Nav.NavigateTo("")'>← 워크스페이스</button>
            <button class="ws-back" @onclick='() => Nav.NavigateTo("storyboard")'>🎬 스토리보드(여러 컷) →</button>
            <button class="ws-back" @onclick="ExpandToStoryboard" disabled="@(State.IsBusy || string.IsNullOrWhiteSpace(_prompt))" title="현재 프롬프트·시드로 1번 컷을 채우고 2~4번 컷을 기승전결로 자동 전개">🎬 스토리보드로 4컷 확장</button>
            <div class="ws-status-badges" data-ws-status="1">
                <button class="ws-back" data-local-ai-open="1" @onclick="() => _localAiModal = true" title="Gemini 장애 시 사내/로컬 AI 서버(OpenAI 호환 · Ollama)로 자동 전환 — 엔드포인트 · 모델 · 연결 테스트">🦙 로컬 AI 설정@(LocalAiSettings.Gateway.Options.IsEnabled ? " · ON" : "")</button>
                @{ var pcs = PlutoCoreMgr.Current; }
                @if (pcs.IsRunning)
                {
                    <button class="ws-back ws-pcore on" data-plutocore-pill="running" @onclick="() => _localAiModal = true"
                            title="@("PlutoCore 허브 연결됨 · " + pcs.EndpointUrl + (pcs.Latency is { } plat ? " · 핑 " + plat.TotalMilliseconds.ToString("0.0", CultureInfo.InvariantCulture) + "ms" : "") + (pcs.ProcessId is { } ppid ? " · PID " + ppid.ToString(CultureInfo.InvariantCulture) : ""))">🟢 PlutoCore (@(PlutoCoreMgr.RootDirectory)) 연결됨</button>
                }
                else if (pcs.DirectoryExists)
                {
                    <span class="ws-pcore" data-plutocore-pill="stopped">⚪ PlutoCore 미실행
                        @if (pcs.CanLaunch)
                        {
                            <button class="ws-back ws-pcore-go" data-plutocore-launch="1" disabled="@_plutoCoreLaunching" @onclick="LaunchPlutoCoreAsync" title="@(pcs.ExecutablePath)">@(_plutoCoreLaunching ? "⏳ 기동 중..." : "[🚀 기동]")</button>
                        }
                    </span>
                }
                <span class="ws-pcore@(PlutoStorage.IsCloudSynced ? " on" : "")" data-pluto-storage="@(PlutoStorage.IsCloudSynced ? "drive" : "local")" title="@("Pluto 학습 데이터 저장 위치: " + PlutoStorage.ActiveRoot)">@(PlutoStorage.IsCloudSynced ? @"☁️ G:\내 드라이브\DATA 동기화됨" : "💾 로컬 폴백")</span>
                <span class="ws-pcore@(PlutoHarvester.IsRunning ? " on" : "")" data-pluto-harvest="@(PlutoHarvester.IsHarvesting ? "busy" : PlutoHarvester.IsRunning ? "on" : "off")">@(PlutoHarvester.StatusLabel)</span>
                <PlutoDirectorBadge Director="PlutoDirector" />   @* 🎬 디렉터 랭크(XP → 광학 티어) *@
                @* 🍼 Step5: 증시 세션/외부 연동 배지는 기본 아기 스튜디오 화면에서 제거(설정 > 연동 진단으로 이관). *@
                @if (Journal.RecoveringCount > 0) { <span class="ws-recover" role="status">[🔄 미완료 클라우드 작업 복원 중: @(Journal.RecoveringCount.ToString(CultureInfo.InvariantCulture))건]</span> }
                else if (Journal.Count > 0) { <button class="ws-recover ws-jbadge" @onclick="OpenJournal" title="클릭 → 저널 인스펙터(수동 회수·재시도·삭제)">[🔄 미완료 클라우드 작업: @(Journal.Count.ToString(CultureInfo.InvariantCulture))건]</button> }
                @if (_retryMsg is not null) { <span class="ws-retry" role="status">@_retryMsg</span> }
            </div>
        </div>
        @* 🧠 Pluto 인텔리전스 스트립 — 좌: 자율 트렌드 기획안 · 우: 학습 최적 훅·룩·BGM *@
        <div class="ws-pluto-strip" data-ws-row="pluto">
            <div class="ws-brief-strip" data-brief-strip="@((_briefs?.Count ?? 0).ToString(CultureInfo.InvariantCulture))" style="display:flex;flex-wrap:wrap;gap:6px;align-items:center">
                <span class="ws-pcore on">🔭 오늘의 자율 트렌드 기획안 (3선)</span>
                <button class="ws-back" data-brief-refresh="1" @onclick="RefreshBriefsAsync" disabled="@(_briefsBusy)" title="실시간/저장 트렌드 × 학습 1위 훅·룩·BGM × 오답 노트 회피 — Gemini → PlutoCore → 로컬 게이트웨이 → 템플릿">[🔄 기획안 새로고침]</button>
                @if (_briefsBusy) { <span class="ws-retry" role="status" data-brief-busy="1"><span class="ws-motion-spin" aria-hidden="true"></span> 🔭 기획안 생성 중…</span> }
                else if (_briefs is { Count: > 0 } brs)
                {
                    @foreach (var br in brs)
                    {
                        var brief = br;
                        <span class="ws-retry" data-brief-id="@(brief.BriefId)" title="@(brief.ReadyPrompt)">📌 @(brief.Title) · #@(brief.TrendKeyword) · @(brief.TargetPlatform) · @(brief.RationaleBadge)@(brief.AvoidedMistakeCount > 0 ? " · 🛡 회피 " + brief.AvoidedMistakeCount.ToString(CultureInfo.InvariantCulture) : "")</span>
                        <button class="ws-back" data-brief-apply="@(brief.BriefId)" @onclick="() => ApplyBriefAsync(brief)" disabled="@(_briefsBusy || _montageBusy || State.IsBusy)" title="@("프롬프트 · 룩 " + brief.RecommendedColorLook + " · BGM " + brief.RecommendedBgmMood + " · 훅 '" + brief.RecommendedHook + "' 한 번에 세팅")">[🚀 이 기획안으로 즉시 세팅]</button>
                    }
                }
                @if (_briefsToast is { } bft) { <span class="ws-retry" role="status" data-brief-toast="1">@(bft)</span> }
            </div>
            @if (_adaptiveRec is { } arec)
            {
                <div class="ws-adaptive-strip" data-adaptive-strip="@(arec.HasReinforcedHistory ? "learned" : "explore")" style="display:flex;flex-wrap:wrap;gap:6px;align-items:center">
                    <span class="@(arec.TopHook.IsReinforced ? "ws-pcore on" : "ws-retry")" data-adaptive-hook="@(arec.TopHook.DisplayLabel)" title="@("점수 " + arec.TopHook.FinalScore.ToString("0.000", CultureInfo.InvariantCulture) + " · 학습 ×" + arec.TopHook.LearnedWeightMultiplier.ToString("0.00", CultureInfo.InvariantCulture))">🧠 최적 훅: @(arec.TopHook.DisplayLabel) · @(arec.TopHook.ReasonBadge)</span>
                    <span class="@(arec.TopColorLook.IsReinforced ? "ws-pcore on" : "ws-retry")" data-adaptive-look="@(arec.TopColorLook.DisplayLabel)" title="@("점수 " + arec.TopColorLook.FinalScore.ToString("0.000", CultureInfo.InvariantCulture) + " · 학습 ×" + arec.TopColorLook.LearnedWeightMultiplier.ToString("0.00", CultureInfo.InvariantCulture))">🎨 최적 룩: @(arec.TopColorLook.DisplayLabel) · @(arec.TopColorLook.ReasonBadge)</span>
                    <span class="@(arec.TopBgmMood.IsReinforced ? "ws-pcore on" : "ws-retry")" data-adaptive-bgm="@(arec.TopBgmMood.DisplayLabel)" title="@("점수 " + arec.TopBgmMood.FinalScore.ToString("0.000", CultureInfo.InvariantCulture) + " · 학습 ×" + arec.TopBgmMood.LearnedWeightMultiplier.ToString("0.00", CultureInfo.InvariantCulture))">🎵 최적 BGM: @(arec.TopBgmMood.DisplayLabel) · @(arec.TopBgmMood.ReasonBadge)</span>
                    <button class="ws-back" data-adaptive-apply="1" @onclick="ApplyLearnedLookAndHookAsync" disabled="@(_adaptiveBusy || _montageBusy)" title="배포 성과로 강화된 1위 색보정 룩을 몽타주에 고정하고, 1위 훅을 3막 자막(Act 1)·프롬프트에 주입 · 1위 BGM 무드 트랙 선택 후 컷 비트 재정렬(내 BGM 업로드 시 유지)">[🧠 학습 최적 룩·훅·BGM 적용]</button>
                    @if (_learnedLookPinned is { } llp) { <span class="ws-retry" data-adaptive-pinned="@(llp)">📌 룩 고정: @(llp)</span> }
                    @if (_adaptiveToast is { } adt) { <span class="ws-retry" role="status" data-adaptive-toast="1">@(adt)</span> }
                </div>
            }
            <div class="ws-brain-strip" data-brain-strip="@(_brainOpen ? "open" : "closed")" style="display:flex;flex-wrap:wrap;gap:6px;align-items:center">
                <button class="@(_brainOpen ? "ws-pcore on" : "ws-back")" data-brain-toggle="1" @onclick="ToggleBrainSummaryAsync" aria-expanded="@(_brainOpen ? "true" : "false")" title="실험 장부 × 학습 랭커 × 오답 노트 집계 — 판정 실험 · 챌린저 승률 · 오답 가드 · 다음 가설">[🧠 플루토 두뇌 리포트]</button>
                @if (_brainOpen && _brainSummary is { } bs)
                {
                    <span class="ws-retry" data-brain-evaluated="@(bs.TotalEvaluatedExperiments.ToString(CultureInfo.InvariantCulture))">🏆 판정 실험 @(bs.TotalEvaluatedExperiments.ToString(CultureInfo.InvariantCulture))건 · ⏳ 대기 @(bs.PendingExperimentsCount.ToString(CultureInfo.InvariantCulture))건</span>
                    <span class="ws-retry" data-brain-winrate="@(bs.ChallengerWinRatePct.ToString("0.#", CultureInfo.InvariantCulture))">⚔️ 챌린저 승률 @(bs.ChallengerWinRatePct.ToString("0.#", CultureInfo.InvariantCulture))%</span>
                    <span class="ws-retry" data-brain-guards="@(bs.ActiveMistakeGuardCount.ToString(CultureInfo.InvariantCulture))">🛡️ 오답 가드 @(bs.ActiveMistakeGuardCount.ToString(CultureInfo.InvariantCulture))개</span>
                    <span class="ws-pcore on" data-brain-hypothesis="1" style="white-space:normal">💡 @(bs.NextHypothesisBanner)</span>
                    @* 🔗 최강 시너지 조합 · 🎰 UCB1 탐색 · ⏳ 오답 노트 시간 감쇠 *@
                    <span class="@(bs.TopSynergyScore > 1.0 ? "ws-pcore on" : "ws-retry")" data-brain-synergy="@(bs.TopSynergyPairLabel)" style="white-space:normal" title="훅 × 룩 조합 키(pair:) 학습 배수 × 조합 감점 반영 — 14일 반감기 감쇠">🔗 최강 시너지 조합: @(bs.TopSynergyPairLabel) · ×@(bs.TopSynergyScore.ToString("0.00", CultureInfo.InvariantCulture))</span>
                    <span class="ws-retry" data-brain-explore="@(bs.ExplorationRatePct.ToString("0.#", CultureInfo.InvariantCulture))" title="UCB1 = 사후 평균 + C·√(ln(전체 시행+1)/(시행+1)) — 덜 검증된 훅·룩을 챌린저 B와 탐색 기획안에 배정">🎰 UCB1 탐색 @(bs.ExplorationRatePct.ToString("0.#", CultureInfo.InvariantCulture))% · 후보 @(bs.ExplorationCandidateCount.ToString(CultureInfo.InvariantCulture))개 · 시행 @(bs.TotalBanditTrials.ToString("0.#", CultureInfo.InvariantCulture))회</span>
                    <span class="ws-retry" data-brain-decay="@(bs.MistakeDecay.RecoveringCount.ToString(CultureInfo.InvariantCulture))" style="white-space:normal" title="오답 노트 벌점은 21일 반감기로 감쇠 — 재범이 없으면 자연 복권">⏳ 오답 노트 감쇠: @(bs.MistakeDecayLabel)</span>
                    @* 🌊 레짐 드리프트(Page-Hinkley) · 📐 컨텍스트 기준선(잔차 알파) · 🎯 사후 신뢰 구간 *@
                    <span class="@(bs.RegimeDrift.IsSurgeActive ? "ws-pcore on" : "ws-retry")" data-brain-drift="@(bs.RegimeDrift.IsSurgeActive ? "surge" : "stable")" style="white-space:normal" title="Page-Hinkley: 예측 잔차(기대 − 관측) 누적합 m_T − 최소 M_T 가 임계를 넘으면 레짐 변화로 판정 → UCB1 탐색 온도 상향 · 새 관측이 안정되면 서지 감쇠">🌊 레짐 드리프트: @(bs.RegimeDriftLabel)</span>
                    <span class="ws-retry" data-brain-context="@(bs.ContextBaselines.Count.ToString(CultureInfo.InvariantCulture))" style="white-space:normal" title="도메인 × 렌더 포맷별 EWMA 기준선(합성 점수) — 패턴 보상은 원시 지표가 아니라 기준선 대비 잔차 알파로 평가">📐 컨텍스트 기준선: @(bs.ContextBaselineLabel)</span>
                    <span class="@(bs.TopHookConfidence.IsProvenWinner ? "ws-pcore on" : "ws-retry")" data-brain-posterior="@(bs.TopHookConfidence.LowerConfidenceBound.ToString("0.00", CultureInfo.InvariantCulture))" style="white-space:normal" title="Normal–Normal 사후 분포: 평균 = 1 + (배수 − 1)·n/(n + 1) · 표준편차 = 0.35/√(n + 1) · 90% 구간 — 하한이 1.0 을 넘어야 검증된 승자">🎯 사후 신뢰: @(bs.PosteriorConfidenceLabel)</span>
                    @* 🎯 메타 보정(예측 vs 실현 Brier/RMSE) · 💸 반사실 후회 → UCB1 탐색 배수 *@
                    <span class="@(bs.Calibration.IsAmplifying ? "ws-pcore on" : "ws-retry")" data-brain-calibration="@(bs.Calibration.AccuracyPct.ToString("0.#", CultureInfo.InvariantCulture))" style="white-space:normal" title="예측 기대 점수(기준선 + 패턴 알파) vs 실현 합성 점수 — 최근 64건 Brier/RMSE · 예측이 실현보다 계속 높으면(과신) UCB1 탐색 상수를 최대 ×2 로 증폭, 잘 맞으면 ×0.6 까지 활용 집중">🎯 보정 정확도: @(bs.CalibrationLabel)</span>
                    <span class="@(bs.Calibration.MeanRegret > PromptFlowStudio.Services.Pluto.PlutoMetaCalibrationService.RegretDeadBand ? "ws-pcore on" : "ws-retry")" data-brain-regret="@(bs.Calibration.CumulativeRegret.ToString("0.00", CultureInfo.InvariantCulture))" style="white-space:normal" title="반사실 후회 = max(0, 선택하지 않은 최선 대안 점수 − 실현 점수) · A/B 는 상대 변형의 실측 점수 사용 — 후회가 커지면 탐색을 늘려 놓친 대안을 다시 검증">💸 반사실 후회: @(bs.CounterfactualRegretLabel)</span>
                    @* ⚖️ 다목적 파레토 프런티어 선두 · 🔁 능동 후회 리허설 대상 *@
                    <span class="@(bs.ParetoLeader is not null ? "ws-pcore on" : "ws-retry")" data-brain-pareto="@(bs.ParetoLeader?.FrontierSize.ToString(CultureInfo.InvariantCulture) ?? "0")" style="white-space:normal" title="훅별 (3초 유지율 · 완주율 · CTR) EWMA 를 비지배 정렬 — 어느 축에서도 지배당하지 않는 프런티어 · 최약 축이 높을수록 가산 · 3초 65%+ 인데 완주 20% 미만인 클릭베이트는 학습 부스트 무효 + 강등">⚖️ 파레토 선두: @(bs.ParetoFrontierLabel)</span>
                    <span class="@(bs.RegretRehearsalTarget is not null ? "ws-pcore on" : "ws-retry")" data-brain-rehearsal="@((bs.RegretRehearsalTarget?.Boost ?? 0.0).ToString("0.00", CultureInfo.InvariantCulture))" style="white-space:normal" title="거듭 지나친 대안의 미해소 후회 잔액(14일 반감기)이 임계를 넘으면 다음 A/B 챌린저 B 로 배정해 실측 검증 — 검증되면 잔액 소거 · 오답 노트 차단 대안은 제외">🔁 후회 리허설: @(bs.RegretRehearsalLabel)</span>
                    @* ⚖️ 전 모달리티(훅 · 룩 · BGM · 태그) 균형 · 📺 시리즈 아크(편 간 유지율 연속성) *@
                    <span class="@(bs.ParetoEvidencedModalityCount > 0 ? "ws-pcore on" : "ws-retry")" data-brain-pareto-modality="@(bs.ParetoEvidencedModalityCount.ToString(CultureInfo.InvariantCulture))" style="white-space:normal" title="훅 · 룩 · BGM 무드 · 스타일 태그 각각을 (3초 유지율 · 완주율 · CTR) 로 비지배 정렬 — 프런티어/근거 후보 수 · 🎣 = 클릭베이트 강등 수 · 오래된 근거는 14일 유예 뒤 28일 반감기로 소멸">⚖️ 전 모달리티 균형: @(bs.ParetoModalityLabel)</span>
                    <span class="@(bs.SeriesArc.DropOffSeriesCount > 0 ? "ws-pcore on" : "ws-retry")" data-brain-series-arc="@(bs.SeriesArc.TrackedSeriesCount.ToString(CultureInfo.InvariantCulture))" style="white-space:normal" title="시리즈 편별 유지 지수 = (3초 유지율 + 완주율) / 2 — 연속 편 사이 변화가 −5p 이하면 이탈로 보고 다음 편에 궁금증 훅 · 클리프행어 아웃트로를 권고 · 앞선 편의 룩/BGM 앵커는 그대로 유지 · 같은 테마로 다시 만든 시리즈는 시즌으로 분리">📺 시리즈 아크: @(bs.SeriesArcLabel)</span>
                    <span class="@(bs.ColdStartTransfer.IsTransferActive ? "ws-pcore on" : "ws-retry")" data-brain-coldstart="@(bs.ColdStartTransfer.ColdStartContextCount.ToString(CultureInfo.InvariantCulture))" style="white-space:normal" title="계층적 경험적 베이즈: 표본이 적은 (도메인·포맷) 컨텍스트는 지역 추정을 검증된 전역 패턴 사후로 수축 — α = 지역 시행 / (지역 시행 + 사전 강도) · 지역 시행 3건부터는 지역 데이터만 사용 · 챌린저 B 는 톰슨–UCB 하이브리드 추첨">🧬 콜드스타트 전이: @(bs.ColdStartTransferLabel)</span>
                    <span class="@(bs.UnresolvedConflictCount > 0 ? "ws-pcore on" : "ws-retry")" data-brain-conflicts="@(bs.UnresolvedConflictCount.ToString(CultureInfo.InvariantCulture))" style="white-space:normal" title="두 PC 가 오프라인에서 같은 기록을 바꿔 Drive 동기화가 갈라진 경우 — 덮이기 전에 보관한 사본 수 · 환경설정에서 키 단위 병합/복원/무시">⚔️ 동기화 충돌: @(bs.ConflictLabel)</span>
                    @* 📺 Step 26 — 실측 유튜브 성과 요약 · 🎯 다음 제작 기획안(1클릭 적용 · 수동 자막 보존) *@
                    <span class="@(bs.RealizedYouTube.HasRealizedData ? "ws-pcore on" : "ws-retry")" data-brain-realized="@(bs.RealizedYouTube.MeasuredVideoCount.ToString(CultureInfo.InvariantCulture))" data-brain-realized-framing="@(bs.RealizedYouTube.LeadingFraming)" style="white-space:normal" title="YouTube ID 로 연결된 영상의 최신 워터마크 — CTR · 3초 유지율 · 완주율을 조회수 가중(1,000회에서 가중치 상한 · 바이럴 1편 독점 방지) · 선두 제목 프레이밍은 실측 귀속 2건부터 축소 CTR 로 판정">📺 실측 유튜브 성과 요약: @(bs.RealizedYouTubeLabel)</span>
                    @* 🌐 Step 32 — 로캘별 성과(KO · EN · JA · ES 연결 · 가중 CTR/3초/완주 · 로캘 선두 제목) *@
                    <span class="@(bs.RealizedYouTube.Locales.Count > 0 && bs.RealizedYouTube.LinkedVideoCount > 0 ? "ws-pcore on" : "ws-retry")" data-brain-locales="@(bs.RealizedYouTube.Locales.Count.ToString(CultureInfo.InvariantCulture))" style="white-space:normal" title="연결 영상을 업로드 로캘(변형 ID {클립}::{로캘} 우선)별로 조회수 가중 집계 — 로캘마다 CTR 기준선이 달라 제목 프레이밍도 로캘 귀속 2건부터 로캘 안에서 따로 판정(미달 → 전역 사전)">🌐 로캘별 성과: @(bs.LocaleBreakdownLabel)</span>
                    @if (bs.BriefHitRate.HasEvidence)
                    {
                        @* 📐 Step 27 — 기획안 적중률 요약(적용 기획 실측 채점 1건 이상) *@
                        <span class="@(bs.BriefHitRate.HitRatePct >= 50.0 ? "ws-pcore on" : "ws-retry")" data-brain-brief-hitrate="@(bs.BriefHitRate.EvaluatedBriefs.ToString(CultureInfo.InvariantCulture))" style="white-space:normal" title="[기획 즉시 적용]으로 만든 영상의 실측 합성 지표(0.4·3초 + 0.4·완주 + 0.2·CTR×10)를 기획 시점 기대치와 비교 — 조회 50회부터 클립당 1회 채점 · 시리즈는 기획 1건으로 집계 · 기대 대비 −12p 이하면 그 훅×룩 조합을 오답 노트에 사후 분석 · 3건부터 활용/탐색 점수 보정">🎯 기획안 적중률 요약: @(bs.BriefHitRateLabel)</span>
                    }
                    @if (_activityLatest is { } act)
                    {
                        @* 🛰️ Step 37 — 최근 자율 활동 1줄(백그라운드 API 동기화 · Downloads 수집 · 사후 분석 · 복권 · 경로/비밀값 가림) *@
                        <span class="ws-retry" data-brain-activity="@(act.Kind.ToString())" style="white-space:normal;flex-basis:100%;opacity:.85" title="관리자 설정의 최근 자율 활동 피드에서 최근 30건을 볼 수 있습니다">🛰️ 최근 자율 활동 · @(act.ToLine())</span>
                    }
                    <div class="ws-topic-plans" data-topic-plan-count="@(_topicBriefs.Count.ToString(CultureInfo.InvariantCulture))" style="flex-basis:100%;display:flex;flex-direction:column;gap:4px;font-size:12px">
                        <div style="display:flex;flex-wrap:wrap;gap:4px;align-items:center">
                            <span class="ws-retry">🗺️ 다음 제작 기획안</span>
                            <button class="ws-back" data-topic-plan-refresh="1" @onclick="RefreshTopicPlanAsync" disabled="@(_topicPlanBusy)" title="파레토 승자 × 실측 제목 프레이밍 × 미완 시리즈 × 오답 노트 차단 × 최근 반복 피로를 합성해 최대 3건 재제안">[🔄 다시 제안]</button>
                            @if (_topicPlanToast is { } tpt) { <span class="ws-retry" role="status" data-topic-plan-toast="1">@(tpt)</span> }
                        </div>
                        @foreach (var tb in _topicBriefs)
                        {
                            var brief = tb;
                            <div class="@(brief.Kind == PromptFlowStudio.Services.Pluto.PlutoTopicBriefKinds.SeriesContinuation ? "ws-pcore on" : "ws-retry")" data-topic-plan="@(brief.BriefId)" data-topic-kind="@(brief.Kind)" style="white-space:normal">
                                <b>#@(brief.Rank.ToString(CultureInfo.InvariantCulture)) @(brief.Format) · @(brief.Theme)</b> — @(brief.Angle) · 훅 '@(brief.HookStyle)' · 룩 @(brief.ColorLookId) · BGM @(brief.BgmMood) · 제목 @(brief.TitleFraming)
                                <div style="opacity:.85">@(brief.RationaleKorean)</div>
                                <button class="ws-back" data-topic-plan-apply="@(brief.BriefId)" @onclick="() => ApplyTopicBriefAsync(brief)" disabled="@(_topicPlanBusy || _montageBusy || State.IsBusy)" title="테마 · 시리즈 편수 · 훅/룩/BGM/스타일 토큰을 한 번에 세팅 — 직접 고친 자막은 덮지 않음">[🎯 기획 즉시 적용]</button>
                            </div>
                        }
                    </div>
                    @* 🛡️ 오답 노트 활성 가드 인스펙터 — 패턴 · 유효 벌점 · 진단 사유 · [해제](오탐 용서) *@
                    <div class="ws-brain-guards" data-mistake-inspector="@(_mistakeRules.Count.ToString(CultureInfo.InvariantCulture))" style="flex-basis:100%;display:flex;flex-wrap:wrap;gap:4px;align-items:center;font-size:12px">
                        <span class="ws-retry">🛡️ 오답 노트 활성 가드</span>
                        @if (_mistakeRules.Count == 0) { <span class="ws-retry" data-mistake-empty="1">없음</span> }
                        @foreach (var rule in _mistakeRules)
                        {
                            var key = rule.PatternKey;
                            <span class="ws-retry" data-mistake-rule="@(key)" data-mistake-dim="@(rule.FailureDimension)" title="@(rule.FailureDimension) · @(rule.RecordedAtUtc.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)) UTC">
                                @(key) · ⚖ @(rule.PenaltyWeight.ToString("0.00", CultureInfo.InvariantCulture)) · @(rule.DiagnosticReasonKorean)
                                <button class="ws-back" data-mistake-forgive="@(key)" style="padding:0 6px;margin-left:4px" disabled="@(_mistakeForgiveBusy)" @onclick="() => ForgiveMistakeRuleAsync(key)" title="오탐 용서 — 이 패턴의 오답 가드를 해제하고 추천 후보로 복귀">[해제]</button>
                            </span>
                        }
                        @if (_mistakeStatus is { } mst) { <span class="ws-retry" role="status" data-mistake-status="1">@(mst)</span> }
                    </div>
                }
                else if (_brainOpen && _brainBusy) { <span class="ws-retry" role="status" data-brain-busy="1"><span class="ws-motion-spin" aria-hidden="true"></span> 🧠 집계 중…</span> }
            </div>
        </div>
        <div class="ws-navrow ws-row-tools" data-ws-row="tools">
            @* 🎞 4컷 성장 마일스톤 — 아침 훅 → 액션 → 미소 → 잠 · 활성 프로필 앵커 선두 · 4슬롯 일괄 세팅 *@
            <button class="ws-back" data-milestone="Day100" @onclick='() => ApplyMilestonePresetAsync("Day100")' disabled="@(State.IsBusy || _milestoneBusy)" title="100일의 기적 — 4컷 성장 일기를 스토리보드 4슬롯에 한 번에 세팅">💯 100일의 기적</button>
            <button class="ws-back" data-milestone="FirstBirthday" @onclick='() => ApplyMilestonePresetAsync("FirstBirthday")' disabled="@(State.IsBusy || _milestoneBusy)" title="첫돌의 감동 — 4컷 성장 일기를 스토리보드 4슬롯에 한 번에 세팅">🎂 첫돌</button>
            <button class="ws-back" data-milestone="DailyRoutine" @onclick='() => ApplyMilestonePresetAsync("DailyRoutine")' disabled="@(State.IsBusy || _milestoneBusy)" title="우리아이 하루 — 4컷 성장 일기를 스토리보드 4슬롯에 한 번에 세팅">☀️ 하루</button>
            @if (_milestoneBusy) { <span class="ws-retry" role="status">🎞 플루토가 4컷을 구성하는 중…</span> }
            @* 🌊 점진 스트리밍 — 1컷이 도착하는 즉시 스토리보드 캔버스에 페인트(나머지 컷 생성 중) *@
            @if (_milestoneBusy && _milestoneLive is { } live)
            {
                <span class="ws-retry" role="status" data-milestone-live="@(live.StreamedSlotMask)">
                    @for (var i = 0; i < live.Scenes.Count; i++)
                    {
                        var arrived = (live.StreamedSlotMask & (1 << i)) != 0;
                        <span title="@live.Scenes[i].SceneTitle" style="@(arrived ? "" : "opacity:.45")">@(arrived ? "✅" : "⏳")@(i + 1)컷 </span>
                    }
                </span>
            }
            @* 📸 Vision-to-Story — 사진 1장(클릭/드롭) → 15초 3막 4컷 · 추천 BGM · 감성 자막 초안 일괄 세팅 *@
            <span class="ws-back ws-file-pick ws-vstory@(_visionStoryBusy ? " busy" : "")" data-vision-story="1" title="아기/반려동물 사진 1장 → 셔터 3초 전 호기심 · 사진 속 클라이맥스 · 5초 후 여운의 15초 3막 스토리를 4컷 캔버스에 한 번에 세팅(Gemini Vision → 로컬 AI → 규칙 분석 · 디렉터 광학 자동 주입)">📸 사진으로 15초 스토리 완성<InputFile class="ws-drop-input" OnChange="OnVisionStoryPickedAsync" accept="image/png,image/jpeg,image/webp,image/bmp" disabled="@(State.IsBusy || _visionStoryBusy)" /></span>
            @if (_imagePath is not null && !_visionStoryBusy) { <button class="ws-back" data-vision-story-ref="1" @onclick="() => RunVisionStoryAsync(_imagePath)" disabled="@State.IsBusy" title="이미 올린 참조 이미지로 15초 3막 스토리 구성">📸 참조 사진으로</button> }
            @if (_visionStoryBusy) { <span class="ws-retry" role="status">📸 플루토가 사진 속 순간의 앞뒤를 상상하는 중…</span> }
            else if (_visionStoryToast is { } vst) { <span class="ws-retry" role="status" data-vision-story-result="1">@(vst) <button class="ws-back" @onclick='() => Nav.NavigateTo("storyboard")'>🎬 스토리보드 열기 →</button></span> }
            @* 🎥 1-Click 모션 비디오 — 사진 1장 → 15초 60fps Ken Burns MP4(이중 자막 · BGM · SFX) *@
            @if (_motionImage is not null && !_visionStoryBusy) { <button class="ws-back" data-motion-render="1" @onclick="RenderMotionVideoAsync" disabled="@(_motionBusy || _stockBusy)" title="사진 1장을 4막 Ken Burns 카메라 궤적으로 15초 60fps MP4 렌더 — KO/EN 이중 자막 번인 · BGM · 절차적 SFX 믹스">🎬 15초 모션 비디오 즉시 렌더</button> }
            @if (_motionBusy) { <span class="ws-retry" role="status" data-motion-busy="1"><span class="ws-motion-spin" aria-hidden="true"></span> 🎥 모션 비디오 렌더 중… (15초 · 60fps)</span> }
            else if (_motionToast is { } mvt) { <span class="ws-retry" role="status" data-motion-result="1">@(mvt) @if (_motionOutput is { } mvo) { <button class="ws-back" data-motion-open="1" @onclick="() => RevealInExplorer(mvo)" title="@(mvo)">📂 @(Path.GetFileName(mvo)) 위치 열기</button> }</span> }
            @* 🎞️ 멀티컷 몽타주 — 사진 2~5장 → 15초 60fps · 노출 정합 자동 색보정 · BGM 비트 스냅 xfade *@
            <span class="ws-back ws-file-pick" data-montage-pick="1" title="사진 2~5장(연사 최대 30장 · 장당 15MB) 선택 — 6장 이상이면 AI가 베스트 4컷을 자동 선별 · 비트에 맞춘 15초 멀티컷 몽타주">🎞️ 몽타주 사진 추가 (@(_montagePhotos.Count.ToString(CultureInfo.InvariantCulture))/5@(_curationPool.Count > _montagePhotos.Count ? " · 후보 " + _curationPool.Count.ToString(CultureInfo.InvariantCulture) + "장" : ""))<InputFile class="ws-drop-input" OnChange="OnMontagePhotosPickedAsync" multiple accept="image/png,image/jpeg,image/webp,image/bmp" disabled="@(State.IsBusy || _montageBusy || _curationBusy || _curationPool.Count >= CurationMaxPhotos)" /></span>
            @if (_curationPool.Count >= 4 && !_montageBusy) { <button class="ws-back" data-curation-run="1" @onclick="RunPhotoCurationAsync" disabled="@(_curationBusy || _motionBusy || _stockBusy)" title="흔들림 · 노출 불량 · 유사 연사를 걸러내고 베스트 컷을 3막(후킹 → 리듬 → 클라이맥스) 순서로 배치">[✨ AI 베스트 컷 자동 선별]</button> }
            @if (_curationPool.Count >= PromptFlowStudio.Services.Pluto.PlutoSeriesBatchPlanner.RecommendedMinPhotos && !_montageBusy) { <button class="ws-back" data-series-run="1" @onclick="BuildSeriesAsync" disabled="@(_seriesBusy || _curationBusy || _motionBusy || _stockBusy)" title="고품질 비중복 컷을 서로 겹치지 않는 2~3편(편당 3~5컷)으로 나누고 'n/N편' 연속 3막 자막 · 편별 SNS 키트 생성">[📚 시리즈 자동 분할 (2~3편)]</button> }
            @if (_seriesBusy) { <span class="ws-retry" role="status" data-series-busy="1"><span class="ws-motion-spin" aria-hidden="true"></span> 📚 @(_curationPool.Count.ToString(CultureInfo.InvariantCulture))장 → 시리즈 분할 중…</span> }
            else if (_series is { } ser)
            {
                <div class="ws-retry" data-series-panel="@(ser.Episodes.Count.ToString(CultureInfo.InvariantCulture))" style="display:flex;flex-wrap:wrap;gap:6px;align-items:center;width:100%">
                    @if (_seriesDirective is { } sdir) { <span class="@(sdir.EscalateHook ? "ws-pcore on" : "ws-retry")" data-series-continuity="@(sdir.EscalationLevel.ToString(CultureInfo.InvariantCulture))" style="white-space:normal" title="앞선 편의 실측 유지율과 구성에서 유도 — 앵커 룩/BGM 은 자동 유지 · 이탈 감지 시 1막 훅과 마지막 자막에 반영">📺 @(sdir.NextEpisodeNumber.ToString(CultureInfo.InvariantCulture))편 연속성: @(sdir.ReasonKorean)@(sdir.HasAnchor ? " · 앵커 " + (sdir.AnchorColorLookId.Length > 0 ? sdir.AnchorColorLookId : "—") + " / " + (sdir.AnchorBgmMood.Length > 0 ? sdir.AnchorBgmMood : "—") : "")</span> }
                    <span class="ws-pcore on" data-series-summary="1">📚 '@(ser.SeriesTheme)' @(ser.Episodes.Count.ToString(CultureInfo.InvariantCulture))편 · @(ser.TotalInputPhotos.ToString(CultureInfo.InvariantCulture))장 중 고유 @(ser.TotalUsedUniquePhotos.ToString(CultureInfo.InvariantCulture))컷</span>
                    @if (_seriesSeason is { } ssn && (ssn.HasArc || ssn.Season > 1))
                    {
                        <span class="ws-retry" data-series-season="@(ssn.Season.ToString(CultureInfo.InvariantCulture))" title="같은 테마 · 같은 편수 시리즈의 아크 기록 — 시즌마다 따로 보존">🗂️ 시즌 @(ssn.Season.ToString(CultureInfo.InvariantCulture)) · 기록 @(ssn.EpisodeCount.ToString(CultureInfo.InvariantCulture))편(측정 @(ssn.MeasuredCount.ToString(CultureInfo.InvariantCulture)))</span>
                        @if (ssn.HasArc) { <button class="ws-back" data-series-new-season="1" @onclick="StartNewSeriesSeasonAsync" disabled="@(_montageBusy || _seriesBusy || _seriesRenderAllBusy)" title="같은 테마로 시리즈를 다시 만들 때 누르세요 — 이전 시즌의 편별 성과는 그대로 보존하고, 지금부터 렌더하는 편은 앵커 · 이탈 추적이 깨끗한 새 아크에서 시작합니다">[🆕 새 시즌 분리]</button> }
                    }
                    <button class="@(_seriesAutoRewrite ? "ws-back on" : "ws-back")" data-series-escalation-mode="@(_seriesAutoRewrite ? "auto" : "recommend")" @onclick="ToggleSeriesEscalationModeAsync" disabled="@(_montageBusy || _seriesBusy || _seriesRenderAllBusy)" title="편 간 이탈 감지 시 — 자동 각색 적용(Auto-Rewrite): 1막 훅과 마지막 자막을 자동으로 바꿉니다 · 추천만 표시(Recommend-Only): 자막 원문은 그대로 두고 추천 문구만 보여 줍니다">@(_seriesAutoRewrite ? "[✍️ 자동 각색 적용]" : "[💡 추천만 표시]")</button>
