    private string MontageThemeHint()
    {
        var hint = string.IsNullOrWhiteSpace(_visionSubtitle) ? _prompt ?? "" : _visionSubtitle + ", " + _prompt;
        // 🧭 아기 칩 명시 선택 시 BabyStudio 유지(토큰 없는 힌트가 일반 시네마틱 자막으로 전환되지 않도록)
        return _babyExplicit && !PromptFlowStudio.Services.Pluto.PromptDomainClassifier.ContainsBabyToken(hint) ? "baby, " + hint : hint;
    }

    /// <summary>🎬 결정론 템플릿 초안 즉시 적용(오답 노트 차단 토큰 회피 · 실패 → 자막 없음).</summary>
    private void ApplyLocalMontageCues(PromptFlowStudio.Services.Pluto.PlutoMontagePlan plan)
    {
        try
        {
            var notebook = EcoSp.GetService(typeof(PromptFlowStudio.Services.Pluto.IPlutoMistakeNotebookService)) as PromptFlowStudio.Services.Pluto.IPlutoMistakeNotebookService;
            var ranker = EcoSp.GetService(typeof(PromptFlowStudio.Services.Pluto.IPlutoAdaptivePatternRanker)) as PromptFlowStudio.Services.Pluto.IPlutoAdaptivePatternRanker;
            _montageCues = PromptFlowStudio.Services.Pluto.PlutoMontageStoryGenerator.GenerateLocal(plan, MontageThemeHint(), notebook?.GetSuppressedTokens(), ranker);
            _montageStoryLlm = false;
            ApplySeriesCueDecoration();
        }
        catch (Exception ex) { Program.Log("Workspace.MontageStoryLocal", ex); _montageCues = null; }
    }

    /// <summary>🎬 [✨ 3막 자막 자동 생성] — 4단 페일오버 생성(세대 가드 · 실패 → 템플릿 유지).</summary>
    private async Task GenerateMontageStoryAsync()
    {
        if (_activeMontagePlan is not { } plan || _montageStoryBusy) return;
        var gen = EcoSp.GetService(typeof(PromptFlowStudio.Services.Pluto.IPlutoMontageStoryGenerator)) as PromptFlowStudio.Services.Pluto.IPlutoMontageStoryGenerator;
        if (gen is null) { ApplyLocalMontageCues(plan); return; }
        var seq = ++_montageStorySeq;
        _montageStoryBusy = true;
        StateHasChanged();
        try
        {
            var cuts = _curationResult?.SelectedCuts is { } sc && sc.Count == plan.Clips.Count ? sc : null;
            var cues = await gen.GenerateThreeActSubtitlesAsync(plan, cuts, MontageThemeHint(), _mediaCts.Token);
            if (_disposed || seq != _montageStorySeq || !ReferenceEquals(plan, _activeMontagePlan)) return;
            _montageCues = cues;
            _montageStoryLlm = gen.LastUsedLlm;
            ApplySeriesCueDecoration();
        }
        catch (OperationCanceledException) { return; }   // 페이지 이탈
        catch (Exception ex) { Program.Log("Workspace.MontageStory", ex); }
        finally { if (seq == _montageStorySeq) _montageStoryBusy = false; }
        if (_disposed) return;
        await InvokeAsync(StateHasChanged);
    }

    private PromptFlowStudio.Services.Pluto.PlutoVisionStorySynthesizer? ResolveVisionSynth()
        => EcoSp.GetService(typeof(PromptFlowStudio.Services.Pluto.PlutoVisionStorySynthesizer)) as PromptFlowStudio.Services.Pluto.PlutoVisionStorySynthesizer;

    /// <summary>🎯 사진별 초점(로컬 돌출도 + Vision 병렬 보정) — 같은 사진 목록이면 캐시. 실패 → 기본 초점([부분 구제]).</summary>
    private async Task<IReadOnlyList<(double X, double Y)>> EnsureStagedFocalPointsAsync(string[] photos, CancellationToken ct)
    {
        var key = string.Join("|", photos);
        if (_stagedFocalPoints is { } cached && cached.Count == photos.Length && string.Equals(_stagedFocalKey, key, StringComparison.Ordinal)) return cached;
        IReadOnlyList<(double X, double Y)> pts;
        try { pts = await FocalDetector.ExtractBatchFocalPointsAsync(photos, ResolveVisionSynth(), ct); }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            Program.Log("Workspace.MontageFocal", ex);
            var f = PromptFlowStudio.Services.Pluto.PlutoMotionCompiler.FallbackFocal(_identity?.IsPet == true);
            var arr = new (double X, double Y)[photos.Length];
            for (var i = 0; i < arr.Length; i++) arr[i] = f;
            pts = arr;
        }
        if (pts.Count != photos.Length) return pts;
        _stagedFocalPoints = pts;
        _stagedFocalKey = key;
        return pts;
    }

    /// <summary>🎞 2~5장 → 초점 · 색 분석 · 비트 → 몽타주 플랜 → 캔버스 프리뷰 플랜(세대 가드 · 미리보기 전용 — 예외 전파 금지).</summary>
    private async Task RefreshMontagePreviewAsync()
    {
        var seq = ++_montagePreviewSeq;
        var photos = _montagePhotos.ToArray();
        if (photos.Length < PromptFlowStudio.Services.Pluto.PlutoMontageCompiler.MinClips || photos.Length > MontageMaxPhotos)
        {
            _activeMontagePreviewPlan = null;
            _activeMontagePlan = null;
            _montageCues = null;
            return;
        }
        PromptFlowStudio.Services.Pluto.PlutoMontagePreviewPlan? preview = null;
        PromptFlowStudio.Services.Pluto.PlutoMontagePlan? compiled = null;
        try
        {
            var ct = _mediaCts.Token;
            var focals = await EnsureStagedFocalPointsAsync(photos, ct);
            if (_disposed || seq != _montagePreviewSeq) return;
            var analyzer = StockSuite.ColorAnalyzer;
            var look = _montageLook;
            var notebook = EcoSp.GetService(typeof(PromptFlowStudio.Services.Pluto.IPlutoMistakeNotebookService)) as PromptFlowStudio.Services.Pluto.IPlutoMistakeNotebookService;
            var profiles = await Task.Run(() =>
            {
                var m = new PromptFlowStudio.Services.Pluto.PlutoImageColorMetrics[photos.Length];
                for (var i = 0; i < m.Length; i++)
                {
                    try { m[i] = analyzer.AnalyzeImage(photos[i]); }
                    catch (Exception ex) when (ex is not OperationCanceledException) { Program.Log("Workspace.MontageColor", ex); m[i] = PromptFlowStudio.Services.Pluto.PlutoImageColorMetrics.Neutral; }
                }
                return analyzer.BuildHarmonizedProfiles(m, look, notebook);
            }, ct);
            var beats = _customBgm is { RelativeBeatTimestampsSec.Count: > 0 } chl ? chl.RelativeBeatTimestampsSec   // 🎵 커스텀 하이라이트 비트 우선
                : _bgmOn ? await StockSuite.TryDetectBgmBeatsAsync(_bgmTrack, PromptFlowStudio.Services.Pluto.PlutoMotionCompiler.FourActDurationSec, ct) : null;
            if (_disposed || seq != _montagePreviewSeq) return;
            var plan = MontageCompiler.CompileMontagePlan(photos, focals, beats, profiles, PromptFlowStudio.Services.Pluto.PlutoMotionCompiler.FourActDurationSec);
            var urls = new string[photos.Length];
            for (var i = 0; i < urls.Length; i++) urls[i] = Media.ToPlaybackUrl(photos[i]);
            preview = MontageCompiler.BuildMontagePreviewPlan(plan, urls, beats);
            compiled = plan;
        }
        catch (OperationCanceledException) { return; }   // 페이지 이탈
        catch (Exception ex) { Program.Log("Workspace.MontagePreview", ex); preview = null; compiled = null; }
        if (_disposed || seq != _montagePreviewSeq) return;
        _activeMontagePreviewPlan = preview;
        _activeMontagePlan = compiled;
        _montageStorySeq++;   // 진행 중 생성 결과 폐기(플랜 교체)
        _montageStoryBusy = false;
        if (compiled is not null) ApplyLocalMontageCues(compiled);   // 🎬 템플릿 초안 즉시 → AI 생성으로 승격
        else _montageCues = null;
        await InvokeAsync(StateHasChanged);
        if (compiled is not null)
        {
            await RefreshAdaptiveRecommendationAsync();   // 🧠 몽타주 세션 초기화 → 학습 최적 훅·룩 갱신
            if (_disposed || seq != _montagePreviewSeq) return;
            bool bgmChanged;
            try { bgmChanged = await TryAutoApplyLearnedBgmAsync(); }
            catch (OperationCanceledException) { return; }   // 페이지 이탈
            if (_disposed || seq != _montagePreviewSeq) return;
            if (bgmChanged) { await RefreshMontagePreviewAsync(); return; }   // 🎵 새 트랙 비트 그리드로 컷·3막 자막 재잠금(자동 적용 1회 → 재귀 1단)
            await GenerateMontageStoryAsync();
        }
    }

