@page "/workspace"
@using System.Globalization
@using PromptFlowStudio.Services.AI
@using PromptFlowStudio.Blazor.Components.Workflow
@implements IDisposable
@inject WanJobState State
@inject ILocalMediaService Media
@inject IMediaLibraryService Library
@inject IWanConfigService Cfg
@inject IVideoMergeService Merge
@inject PromptDraftService Draft
@inject PromptFlowStudio.Services.Platform.ErrorDialogService Errors
@inject NavigationManager Nav
@inject PromptFlowStudio.Services.AI.Wan.LiveStreamVirtualCamPipe VirtualCam
@inject IJSRuntime JS
@inject IServiceProvider EcoSp
@inject AiAudioDrivenLipSyncService LipAi
@inject AiVoiceoverTtsService Tts
@inject EpisodicStorySeriesBuilder SeriesBuilder
@inject PromptFlowStudio.Services.Prompt.PromptSynthesizerService Synth
@inject PromptFlowStudio.Services.AI.GeminiPromptService GeminiSvc
@inject PromptFlowStudio.ViewModels.StoryboardViewModel StoryVm
@inject PromptFlowStudio.Services.Camera.WirelessCameraService WirelessCam
@inject PromptFlowStudio.Services.Gallery.GalleryMediaService GalleryMedia
@inject PromptFlowStudio.Services.Prompt.PromptInspirationService Inspiration
@inject PromptFlowStudio.Services.Render.IRenderQueueService RenderQueue
@inject PromptFlowStudio.ViewModels.PublishViewModel PubVm
@inject PromptFlowStudio.Services.Configuration.AppSettingsManager AppSettings
@inject PromptFlowStudio.Services.Platform.IClipboardService Clipboard
@inject PromptFlowStudio.Services.Export.StockSuiteExporter StockSuite
@inject PromptFlowStudio.Services.ProcessBridge.TradingSafetyGuardService TradingGuard
@inject PromptFlowStudio.Services.Video.VideoTrimService Trimmer
@inject PromptFlowStudio.Services.ProcessBridge.StockSuiteProcessMonitor StockMon
@inject PromptFlowStudio.Services.Prompt.PresetManagerService Presets
@inject PromptFlowStudio.Services.Render.MediaProbeService Probe
@inject PromptFlowStudio.Services.Export.StockSuiteWatchlistService Watchlist
@inject PromptFlowStudio.Services.Prompt.PromptHistoryService History
@inject PromptFlowStudio.Services.Render.TaskJournalService Journal
@inject PromptFlowStudio.Services.ProcessBridge.StockSuiteIpcBridge Ipc
@inject PromptFlowStudio.Services.Network.ResilientHttpClient Resilience
@inject PromptFlowStudio.Services.Chart.ChartStillGeneratorService ChartGen

@* [PromptFlow Studio] 새 프로젝트 — 텍스트→영상(Wan 2.1) 생성 파이프라인 구동 화면.
   상태는 WanJobState(싱글턴)에 있고, 이 컴포넌트는 OnChange 를 구독해 InvokeAsync(StateHasChanged)로만 갱신한다.
   ⚠ 생성은 fire-and-forget(_ = State.StartAsync)로 시작 — 버튼 핸들러가 수 분간 블록되지 않게 한다. *@

<PageTitle>PromptFlow Studio · 새 프로젝트</PageTitle>

<div class="ws" style="--ws-lut: @(PromptFlowStudio.Services.Export.ColorGradingService.CssFilter(_lut))">
    <header class="ws-head">
        <div class="ws-navrow">
            <button class="ws-back" @onclick='() => Nav.NavigateTo("")'>← 워크스페이스</button>
            <button class="ws-back" @onclick='() => Nav.NavigateTo("storyboard")'>🎬 스토리보드(여러 컷) →</button>
            <button class="ws-back" @onclick="ExpandToStoryboard" disabled="@(State.IsBusy || string.IsNullOrWhiteSpace(_prompt))" title="현재 프롬프트·시드로 1번 컷을 채우고 2~4번 컷을 기승전결로 자동 전개">🎬 스토리보드로 4컷 확장</button>
            @* 🍼 Step5: 증시 세션/외부 연동 배지는 기본 아기 스튜디오 화면에서 제거(설정 > 연동 진단으로 이관). *@
            @if (Journal.RecoveringCount > 0) { <span class="ws-recover" role="status">[🔄 미완료 클라우드 작업 복원 중: @(Journal.RecoveringCount.ToString(CultureInfo.InvariantCulture))건]</span> }
            else if (Journal.Count > 0) { <button class="ws-recover ws-jbadge" @onclick="OpenJournal" title="클릭 → 저널 인스펙터(수동 회수·재시도·삭제)">[🔄 미완료 클라우드 작업: @(Journal.Count.ToString(CultureInfo.InvariantCulture))건]</button> }
            @if (_retryMsg is not null) { <span class="ws-retry" role="status">@_retryMsg</span> }
        </div>
        @if (_jOpen)
        {
            <div class="ws-jmodal-bg" @onclick="CloseJournal">
                <div class="ws-jmodal" role="dialog" aria-label="클라우드 작업 저널 인스펙터" @onclick:stopPropagation="true">
                    <div class="ws-jmodal-h">
                        <b>🔄 클라우드 작업 저널</b>
                        <span>
                            <button class="ws-btn ghost sm" @onclick="PurgeAllJournal" disabled="@(_jBusy || _jEntries.Count == 0)">🧹 전체 비우기</button>
                            <button class="ws-btn ghost sm" @onclick="CloseJournal">✕</button>
                        </span>
                    </div>
                    @if (_jMsg is not null) { <div class="ws-hint">@_jMsg</div> }
                    @if (_jEntries.Count == 0)
                    {
                        <div class="ws-hint">저널이 비어 있습니다.</div>
                    }
                    else
                    {
                        <table class="ws-jtbl">
                            <thead><tr><th>Task ID</th><th>발번 시각</th><th>프롬프트</th><th>상태</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var je in _jEntries)
                                {
                                    <tr @key="je.TaskId">
                                        <td class="mono" title="@je.TaskId">@ShortId(je.TaskId)</td>
                                        <td class="mono">@(je.StartedAt.ToLocalTime().ToString("MM-dd HH:mm:ss", CultureInfo.InvariantCulture))</td>
                                        <td title="@je.Prompt">@Summary(je.Prompt)</td>
                                        <td><span class="ws-jst @JournalStatusClass(je.Status)">@je.Status</span></td>
                                        <td class="ws-jact">
                                            <button class="ws-btn ghost sm" @onclick="() => RecoverJournalAsync(je.TaskId)" disabled="@_jBusy" title="상태 무관 원격 결과 즉시 회수">⬇ 수동 회수/다운로드</button>
                                            <button class="ws-btn ghost sm" @onclick="() => RetryJournalAsync(je.TaskId)" disabled="@_jBusy" title="Processing 으로 복귀 → 자동 회수 대상 편입">🔁 재시도</button>
                                            <button class="ws-btn ghost sm" @onclick="() => PurgeJournal(je.TaskId)" disabled="@_jBusy">🗑 저널에서 영구 삭제</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }
        <h1 class="ws-title">새 프로젝트 <span class="ws-title-g">텍스트 → 영상</span>
            <span class="ws-accel @AccelClass" title="Wan 2.1 엔진 상태">⚡ @(AccelClass == "ready" ? _vm.StatusBadge : "WAN 2.1 · " + AccelLabel)</span></h1>
        <p class="ws-sub">프롬프트를 입력하면 통의만상(Wan 2.1)이 5초 영상을 생성합니다.</p>
    </header>

    @if (!State.Enabled)
    {
        <div class="ws-warn">
            ⚠ Wan API 키가 아직 구성되지 않았습니다.
            <button class="ws-warn-link" @onclick='() => Nav.NavigateTo("settings")'>관리자 설정 › 영상(Wan)</button>
            에서 API 키를 등록하면 <b>재시작 없이 즉시</b> 여기서 생성할 수 있습니다.
        </div>
    }

    @if (_camToast is not null)
    {
        <div class="ws-cam-toast" role="status">@(_camToast) @if (ReferenceEquals(_camToast, _stockToast) && StockCanLaunch) { <button class="ws-btn sm" @onclick="() => LaunchStockSuite(_stockRestart)" title="StockSuite 를 실행(실행 중이면 재실행)해 새 에셋을 즉시 반영">@(_stockRestart ? "🔄 StockSuite 재실행" : "🚀 StockSuite 실행")</button> } <button class="ws-cam-toast-x" @onclick="() => _camToast = null" title="닫기">✕</button></div>
    }

    <section class="ws-grid">
        @* ── ① 입력 ── *@
        <div class="ws-card">
            <div class="ws-card-h">
                <span>① 프롬프트 입력</span>
                @if (_imagePath is not null && _lastImagePath is not null) { <span class="ws-mode">🎯 첫·끝 프레임 보간(kf2v)</span> }
                else if (_imagePath is not null) { <span class="ws-mode">🖼️ 이미지→영상(i2v)</span> }
            </div>

            @* ── 참조 이미지(선택) — 있으면 i2v 로 분기 · 드래그&드롭 + 클릭 ── *@
            <div class="ws-drop @(_imagePreview is not null ? "has" : "")">
                @if (_imagePreview is null)
                {
                    <InputFile class="ws-drop-input" OnChange="OnImagePicked"
                               accept="image/png,image/jpeg,image/webp,image/bmp" disabled="@State.IsBusy" />
                    <div class="ws-drop-hint">
                        <span class="ws-drop-ic">🖼️</span>
                        <span>참조 이미지 <b>드래그</b> 또는 <b>클릭</b>해서 업로드</span>
                        <span class="ws-drop-sub">(선택) 이미지를 넣으면 <b>이미지→영상(i2v)</b>로 생성됩니다</span>
                    </div>
                }
                else
                {
                    <img class="ws-thumb" src="@_imagePreview" alt="참조 이미지" />
                    <div class="ws-thumb-meta">
                        <span class="ws-thumb-name" title="@_imageName">@_imageName</span>
                        <button class="ws-thumb-x" @onclick="ClearImage" disabled="@State.IsBusy" title="이미지 제거">✕</button>
                    </div>
                }
            </div>
            @* v16.5.0 🎯 끝 프레임(Last Frame) 슬롯 — 첫 프레임과 함께 넣으면 두 키프레임 보간으로 모션 동선을 고정 *@
            @if (_imagePath is not null)
            {
                <div class="ws-drop @(_lastImagePreview is not null ? "has" : "")">
                    @if (_lastImagePreview is null)
                    {
                        <InputFile class="ws-drop-input" OnChange="OnLastImagePicked"
                                   accept="image/png,image/jpeg,image/webp,image/bmp" disabled="@State.IsBusy" />
                        <div class="ws-drop-hint">
                            <span class="ws-drop-ic">🏁</span>
                            <span>끝 프레임(Last Frame) <b>드래그</b> 또는 <b>클릭</b></span>
                            <span class="ws-drop-sub">(선택) 위 이미지=첫 프레임 · 이 이미지=끝 프레임으로 <b>보간 생성</b>됩니다</span>
                        </div>
                    }
                    else
                    {
                        <img class="ws-thumb" src="@_lastImagePreview" alt="끝 프레임" />
                        <div class="ws-thumb-meta">
                            <span class="ws-thumb-name" title="@_lastImageName">🏁 @_lastImageName</span>
                            <button class="ws-thumb-x" @onclick="ClearLastImage" disabled="@State.IsBusy" title="끝 프레임 제거">✕</button>
                        </div>
                    }
                </div>
            }
            @if (_imgError is not null) { <div class="ws-imgerr">⚠ @_imgError</div> }

            <div class="ws-insp-bar">
                <button class="ws-insp-open" @onclick="OpenInspiration" disabled="@State.IsBusy" title="장르별 완성 스토리 · 레고식 조합기">💡 스토리 레시피 & 영감 모음</button>
                <button class="ws-preset-save" @onclick="ToggleUserPresetForm" disabled="@State.IsBusy" title="프롬프트 · 네거티브 · 카메라 모션 · 스타일 · 듀레이션을 user_presets.json 에 영구 저장">⭐ 현재 설정을 프리셋으로 저장</button>
            </div>
            @if (_upFormOpen)
            {
                <div class="ws-preset-form">
                    <input class="ws-preset-in" @bind="_upName" @bind:event="oninput" maxlength="@PromptFlowStudio.Services.Prompt.PresetManagerService.MaxNameLength"
                           placeholder="프리셋 이름 (예: 심야 OLED 퀀트 다크)" @onkeydown="OnUserPresetKey" />
                    <button class="ws-btn sm" @onclick="SaveUserPreset" disabled="@(string.IsNullOrWhiteSpace(_upName) || string.IsNullOrWhiteSpace(_prompt))">💾 저장</button>
                    <button class="ws-btn ghost sm" @onclick="() => _upFormOpen = false">취소</button>
                </div>
            }
            @if (_upMsg is not null) { <div class="ws-hint">@_upMsg</div> }
            @* 🌱 우리 아기 성장 단계 칩 바 — 클릭 → 연령 적합 피사체·스타일 키워드를 프롬프트 선두에 시드(멱등 · 단계 전환 시 교체) *@
            <div class="ws-watch-bar" role="group" aria-label="우리 아기 성장 단계">
                <span class="ws-mood-cap">🌱 우리 아기 성장 단계</span>
                @{ var activeStage = PromptFlowStudio.Services.AI.GeminiPromptService.ActiveGrowthStage(_prompt); }
                @for (var i = 0; i < PromptFlowStudio.Services.AI.GeminiPromptService.BabyGrowthStages.Length; i++)
                {
                    var gs = PromptFlowStudio.Services.AI.GeminiPromptService.BabyGrowthStages[i];
                    <button class="ws-mood-chip @(activeStage == gs.Stage ? "on" : null)" @key="gs.Stage" @onclick="StagePick(i)" disabled="@State.IsBusy"
                            title="@gs.Tokens">@gs.Emoji @gs.Label <small>(@gs.Range)</small></button>
                }
            </div>
            @if (_tickerMsg is not null) { <div class="ws-hint">@_tickerMsg</div> }
            <div class="ws-hist">
                <button class="ws-hist-btn" @onclick="ToggleHistory" disabled="@(State.IsBusy || History.Count == 0)" title="프롬프트 타임머신 — AI 강화·번역·3-Way·아기 무드 직전 상태로 되돌리기">🕒 되돌리기 @(History.Count)</button>
                @if (_histOpen)
                {
                    var snaps = History.Snapshots;
                    <div class="ws-hist-menu" role="menu">
                        @for (var hi = 0; hi < snaps.Count; hi++)
                        {
                            var hIdx = hi;
                            var hs = snaps[hi];
                            <button class="ws-hist-item" role="menuitem" @key="hs" @onclick="() => RestoreSnapshot(hIdx)" title="@hs.Prompt">@hs.Display<small>@(hs.Camera is null ? "" : "🎥 " + hs.Camera + " · ")🌱 @hs.Seed.ToString(CultureInfo.InvariantCulture)</small></button>
                        }
                    </div>
                }
            </div>
            <textarea class="ws-ta" @bind="_prompt" @bind:event="oninput" @bind:after="OnPromptTyped"
                      placeholder="@(_imagePath is null ? "예) 노을 지는 해변을 천천히 걷는 골든리트리버, 시네마틱, 부드러운 카메라 팬" : "예) 카메라가 천천히 줌인, 머리카락이 바람에 날림 (i2v는 움직임 위주로 · 프롬프트 선택)")"
                      maxlength="800" disabled="@State.IsBusy"></textarea>
            @* 👶 아기 감성 & 성장 무드 칩 바 · ✨ 3종 스타일 동시 전개 *@
            <div class="ws-mood-bar" role="group" aria-label="아기 감성 & 성장 무드">
                <span class="ws-mood-cap">아기 감성 & 성장 무드</span>
                @{ var activeMood = PromptFlowStudio.Services.AI.GeminiPromptService.ActiveBabyMood(_prompt); }
                @for (var i = 0; i < PromptFlowStudio.Services.AI.GeminiPromptService.BabyMoods.Length; i++)
                {
                    var mp = PromptFlowStudio.Services.AI.GeminiPromptService.BabyMoods[i];
                    <button class="ws-mood-chip @(activeMood == mp.Mood ? "on" : null)" @key="mp.Mood" @onclick="MoodPick(i)" disabled="@State.IsBusy"
                            title="@mp.Tokens">@mp.Emoji @mp.Label <small>(@mp.English)</small></button>
                }
                <button class="ws-mood-3way" @onclick="_threeWay" disabled="@(State.IsBusy || _variantBusy || string.IsNullOrWhiteSpace(_prompt))"
                        title="입력 아이디어를 Realistic Dark Quant · Cyber Neon Depth · Minimal Modern Studio 3종으로 동시 전개">@(_variantBusy ? "⏳ 전개 중…" : "✨ 3종 스타일 동시 전개")</button>
            </div>
            @if (_variants.Count > 0)
            {
                <div class="ws-var-tabs" role="tablist">
                    @for (var i = 0; i < _variants.Count; i++)
                    {
                        var v = _variants[i];
                        <button class="ws-var-tab @(_variantSel == i ? "on" : null)" role="tab" aria-selected="@(_variantSel == i ? "true" : "false")" @key="v.StyleKey"
                                @onclick="VariantPick(i)" disabled="@State.IsBusy" title="@v.Prompt">@(v.Index). @v.Title <small>🎥 @v.Camera · 🌱 @v.Seed.ToString(CultureInfo.InvariantCulture)</small></button>
                    }
                    <button class="ws-btn sm" @onclick="EnqueueVariants" disabled="@State.IsBusy" title="3종 프롬프트·시드를 렌더 큐에 일괄 적재">📥 3종 렌더 큐 적재</button>
                    <button class="ws-btn ghost sm" @onclick="ClearVariants">닫기</button>
                </div>
            }
            @if (_variantMsg is not null) { <div class="ws-hint">@_variantMsg</div> }
            @* 멀티 듀레이션 — 5s 단일(직접 생성) · 10s/15s 멀티 샷(렌더 큐 체이닝·합본) · 15s 앰비언트(5초 + 3x 슬로우 루프) *@
            <div class="ws-dur" role="radiogroup" aria-label="영상 길이">
                @for (var i = 0; i < DurationModes.Length; i++)
                {
                    var m = DurationModes[i];
                    <button class="ws-dur-chip @(_durationMode == m ? "on" : null)" role="radio" aria-checked="@(_durationMode == m ? "true" : "false")"
                            @onclick="_durPick[i]" disabled="@State.IsBusy" @key="m">@PromptFlowStudio.Services.Render.MultiDurationPlanner.Label(m)</button>
                }
            </div>
            @if (PromptFlowStudio.Services.Render.MultiDurationPlanner.IsMultiShot(_durationMode))
            {
                <div class="ws-dur-parts">
                    @for (var i = 0; i < PromptFlowStudio.Services.Render.MultiDurationPlanner.ShotCount(_durationMode); i++)
                    {
                        var idx = i;
                        <label class="ws-dur-part" @key="idx">
                            <span>@PromptFlowStudio.Services.Render.MultiDurationPlanner.PartLabel(idx)</span>
                            <textarea class="ws-ta ws-ta-part" @bind="_subPrompts[idx]" @bind:event="oninput" maxlength="800" disabled="@State.IsBusy"
                                      placeholder="@PromptFlowStudio.Services.Render.MultiDurationPlanner.ResolvePartPrompt(_prompt, null, idx, PromptFlowStudio.Services.Render.MultiDurationPlanner.ShotCount(_durationMode))"></textarea>
                        </label>
                    }
                    <div class="ws-dur-hint">비운 파트는 메인 프롬프트 + 카메라 모션 차등 상속 · 이전 컷 마지막 프레임이 다음 컷 I2V 앵커로 자동 주입됩니다.</div>
                </div>
            }
            else if (_durationMode == PromptFlowStudio.Services.Render.VideoDurationMode.Sec15_AmbientSlow)
            {
                <label class="ws-dur-hint"><input type="checkbox" @bind="_ambientPingPong" disabled="@State.IsBusy" /> 🔁 리버스 핑퐁 루프(시작·끝 이음새 제거)</label>
            }
            @if (_durationMsg is not null) { <div class="ws-dur-hint">@_durationMsg</div> }
            @if (_mini.Phase != PromptFlowStudio.Services.Render.MiniQueuePhase.Idle)
            {
                <div class="ws-mini-q @(_mini.Phase == PromptFlowStudio.Services.Render.MiniQueuePhase.Failed || _miniStitchFail is not null || _miniError is not null ? "bad" : null)">
                    <div class="ws-mini-q-h">
                        <div class="ws-mini-q-l">@(_miniStitchFail is null ? _mini.Label : "⚠ 합본 실패 — " + _miniStitchFail)</div>
                        @if (_mini.IsActive)
                        {
                            <button class="ws-btn ghost sm ws-mini-q-x" @onclick="CancelMiniQueue" title="이 그룹의 전 컷 일괄 취소 · GPU 추론 즉시 중단(ComfyUI /interrupt)">❌ 취소</button>
                        }
                    </div>
                    <div class="ws-mini-q-bar"><i style="width:@(_mini.Percent.ToString(CultureInfo.InvariantCulture))%"></i></div>
                    @if (_miniError is not null) { <div class="ws-mini-err">⛔ @(_miniError)</div> }
                    @if (_miniNotice is not null) { <div class="ws-mini-note">ℹ @(_miniNotice)</div> }
                    @if (_miniUrl is not null)
                    {
                        <video class="ws-mini-q-vid" src="@_miniUrl" controls autoplay loop muted preload="auto" @key="_miniUrl"></video>
                    }
                    @if (_mini.Phase == PromptFlowStudio.Services.Render.MiniQueuePhase.Completed && _mini.FinalPath is { } miniFinal)
                    {
                        <button class="ws-btn sm ws-pub" @onclick="() => OpenPublish(miniFinal)" title="YouTube Shorts · Instagram Reels 원클릭 발행">🚀 SNS 원클릭 발행</button>
                    }
                </div>
            }
            <div class="ws-row">
                <label class="ws-lbl">해상도
                    <select class="ws-sel" @bind="_size" @bind:after="SyncSize" disabled="@State.IsBusy">
                        <option value="1280*720">가로 1280×720 (16:9)</option>
                        <option value="720*1280">세로 720×1280 (9:16)</option>
                        <option value="960*960">정사각 960×960 (1:1)</option>
                    </select>
                </label>
                <span class="ws-count @(_vm.IsOverBudget ? "over" : null)" title="Wan 2.1 합성 프롬프트 글자 수">@_vm.CharacterCount / @_vm.MaxCharacterLimit</span>
            </div>
            @* v15.6.0 🎥 Wan 2.1 시네마틱 카메라 & 그래픽 스타일 — 그룹 배타 결합(재클릭 0B) *@
            <div class="ws-zen">
                <div class="ws-zen-h">🎥 Wan 2.1 카메라 & 스타일 스튜디오</div>
                @{ var camOn = WanCameraStyleStudio.ActiveIndex(_prompt, WanCameraStyleStudio.Cameras); var styOn = WanCameraStyleStudio.ActiveIndex(_prompt, WanCameraStyleStudio.Styles); }
                <div class="ws-zen-l">카메라 모션</div>
                <div class="ws-zen-g cam">
                    @for (var i = 0; i < _zenCam.Length; i++)
                    {
                        var z = WanCameraStyleStudio.Cameras[i];
                        <button class="ws-zen-chip @(camOn == i ? "on" : null)" @onclick="_zenCam[i]" disabled="@State.IsBusy" title="@z.Snippet" @key="z.Label"><span>@z.Icon</span>@z.Label</button>
                    }
                </div>
                <div class="ws-zen-l">그래픽 스타일</div>
                <div class="ws-zen-g sty">
                    @for (var i = 0; i < _zenSty.Length; i++)
                    {
                        var z = WanCameraStyleStudio.Styles[i];
                        <button class="ws-zen-chip @(styOn == i ? "on" : null)" @onclick="_zenSty[i]" disabled="@State.IsBusy" title="@z.Snippet" @key="z.Label"><span>@z.Icon</span>@z.Label</button>
                    }
                </div>
            </div>
            @* v5.6.5·v5.6.6: 생성 전 예상 첫 프레임 + 참조(i2v) 이미지 앵커 대조(정체성 드리프트 사전검증)
               v16.12.0: 정적 스틸 프리뷰 전용 — 렌더 큐 비결선(생성은 [영상 생성 시작] 버튼만 · 재생은 라이브 비디오 캔버스 전담) *@
            <FirstFramePreviewDeck Prompt="@_prompt" AnchorImageUrl="@_imagePreview" AnchorAspect="@_vm.ReferenceAspectCss" Size="@_size" />
            <div class="ws-actions">
                @if (State.IsBusy)
                {
                    <button class="ws-btn ghost" @onclick="State.Cancel">■ 취소</button>
                }
                else
                {
                    <button class="ws-btn" disabled="@(!CanStart)" @onclick="Start">✨ 생성 시작</button>
                }
                <span class="ws-eng ws-eng-@(_renderMode.ToLowerInvariant())" title="[환경설정] 기본 렌더 모드 — 변경 즉시 반영">● 렌더 엔진: @(_renderMode)</span>
            </div>
        </div>

        @* ── ② 진행 / 결과 ── *@
        <div class="ws-card">
            <div class="ws-card-h">
                <span>② 🎬 라이브 비디오 캔버스</span>
                <span class="ws-hts-tools">
                    <button class="ws-hts-tog @(_growthBadge ? "on" : null)" @onclick="() => _growthBadge = !_growthBadge" aria-pressed="@(_growthBadge ? "true" : "false")" title="개월 수 · 성장 마일스톤 뱃지와 자막을 영상 위에 미리보기" data-canvas-tool="growth-badge">🏷️ 성장 뱃지/자막</button>
                    <button class="ws-hts-tog @(_bgmOn ? "on" : null)" @onclick="ToggleBgmAsync" aria-pressed="@(_bgmOn ? "true" : "false")" title="감성 BGM 믹스 토글" data-canvas-tool="bgm">🎵 감성 BGM</button>
                    @if (_bgmOn)
                    {
                        <select class="ws-hts-sel" value="@((int)_bgmTrack)" @onchange="OnBgmTrackChanged" title="캔버스 재생과 동기 미리듣기 · 내보내기 시 주 MP4 에 직접 합성(-14 LUFS · 0.25 볼륨 · 1.5초 페이드 인/아웃)" data-canvas-tool="bgm-track">
                            @foreach (var bt in BabyBgmTracks)
                            {
                                <option value="@((int)bt)">@PromptFlowStudio.Services.Export.StockSuiteExporter.BabyBgmLabel(bt)</option>
                            }
                        </select>
                    }
                    @if (InspectPath is not null) { <button class="ws-hts-tog @(_specOpen ? "on" : null)" @onclick="ToggleSpecAsync" aria-pressed="@(_specOpen ? "true" : "false")" title="실측 코덱 · 해상도/FPS · 비트레이트 · 파일 크기 · 무음(-an) 적용 여부">ℹ️ 미디어 규격</button> }
                    <button class="ws-hts-tog @(_abOn ? "on" : null)" @onclick="() => _abOn = !_abOn" aria-pressed="@(_abOn ? "true" : "false")" title="좌: 원본 · 우: 선택 LUT + 샤프닝 — 분할 핸들을 드래그해 텍스트·캔들 라인 선명도를 즉시 비교">🔀 A/B 비교</button>
                    <button class="ws-hts-tog @(_seamCheck ? "on" : null)" @onclick="ToggleSeamCheckAsync" aria-pressed="@(_seamCheck ? "true" : "false")" title="영상 종료 2초 전 → 0~2초 구간만 무한 반복해 루프 접합면(Seam) 프레임 튐을 1초 만에 점검">🔁 이음새 점검</button>
                    <label class="ws-lut-l" title="시네마틱 컬러 그레이딩 — 캔버스 실시간 미리보기 · 내보내기 시 FFmpeg eq 번인" data-canvas-tool="lut">🎨 톤매핑/LUT
                        <select class="ws-hts-sel" value="@((int)_lut)" @onchange="OnLutChanged">
                            @foreach (var lp in PromptFlowStudio.Services.Export.ColorGradingService.All)
                            {
                                <option value="@((int)lp)">@PromptFlowStudio.Services.Export.ColorGradingService.Label(lp)</option>
                            }
                        </select></label>
                    <span class="ws-badge @PhaseClass">@PhaseLabel</span>
                </span>
            </div>
            @if (_htsHud)
            {
                <div class="ws-hts-ctl">
                    <label>오버레이 투명도 <b>@(_htsOpacity.ToString(CultureInfo.InvariantCulture))%</b>
                        <input type="range" min="@HtsHudOverlay.MinOpacity" max="@HtsHudOverlay.MaxOpacity" step="1" @bind="_htsOpacity" @bind:event="oninput" /></label>
                    <label>배경 어둡기 <b>@(_htsDimmer.ToString(CultureInfo.InvariantCulture))%</b>
                        <input type="range" min="@HtsHudOverlay.MinDimmer" max="@HtsHudOverlay.MaxDimmer" step="1" @bind="_htsDimmer" @bind:event="oninput" @bind:after="BroadcastHtsTheme" /></label>
                    <label>테마
                        <select class="ws-hts-sel" value="@((int)_htsTheme)" @onchange="OnHtsThemeChanged">
                            @foreach (var th in PromptFlowStudio.Services.Export.HtsHudThemes.All)
                            {
                                <option value="@((int)th)">@PromptFlowStudio.Services.Export.HtsHudThemes.Label(th)</option>
                            }
                        </select></label>
                    <button class="ws-hts-tog" @onclick="InspectLumaAsync" disabled="@(_lumaBusy || InspectPath is null)" title="영상 중앙 차트 영역(50%) 평균 밝기를 실측해 HUD 대비율을 진단">@(_lumaBusy ? "⏳ 측정 중" : "🔆 조도 검사")</button>
                    @if (LumaVerdict is { } lv)
                    {
                        <span class="ws-lum @lv.CssClass" title="@LumaTitle(lv)">@lv.Badge</span>
                        @if (lv.Level == PromptFlowStudio.Services.Export.HtsReadability.Caution && lv.RecommendedDimmer <= HtsHudOverlay.MaxDimmer)
                        {
                            <button class="ws-hts-tog" @onclick="() => { _htsDimmer = lv.RecommendedDimmer; BroadcastHtsTheme(); }">Dimmer 적용</button>
                        }
                    }
                </div>
            }
            @if (_specOpen && InspectPath is not null)
            {
                <div class="ws-spec" role="dialog" aria-label="미디어 규격">
                    <div class="ws-spec-h"><b>ℹ️ 미디어 테크니컬 규격</b><button class="ws-spec-x" @onclick="() => _specOpen = false" aria-label="닫기">✕</button></div>
                    @if (_specBusy)
                    {
                        <div class="ws-hint">⏳ 분석 중…</div>
                    }
                    else if (_spec is { } sp)
                    {
                        <dl class="ws-spec-g">
                            <dt>포맷/코덱</dt><dd>@sp.CodecLabel <span class="ws-hint">@sp.Container</span></dd>
                            <dt>해상도</dt><dd>@sp.ResolutionLabel</dd>
                            <dt>비트레이트</dt><dd>@sp.BitrateLabel</dd>
                            <dt>파일 크기</dt><dd>@sp.SizeLabel</dd>
                            <dt>오디오</dt><dd class="@(sp.HasAudio ? "warn" : "ok")">@sp.AudioLabel</dd>
                            @if (sp.Encoder is { } enc)
                            {
                                <dt>인코더</dt><dd><span class="ws-enc-badge @(enc.IsHardware ? "hw" : "cpu")">[@enc.Badge]</span>@(enc.IsFallback ? " ⚠ GPU→CPU 폴백" : "")@(enc.EncodeElapsedMs > 0 ? " · ⏱ " + (enc.EncodeElapsedMs / 1000d).ToString("0.0", CultureInfo.InvariantCulture) + "s" : "")</dd>
                            }
                        </dl>
                        @if (sp.Source == "header") { <div class="ws-hint">※ ffprobe/ffmpeg 미설치 — 파일 헤더 정보만 표시합니다.</div> }
                    }
                    else
                    {
                        <div class="ws-hint">❌ 규격을 읽을 수 없습니다(파일 없음).</div>
                    }
                </div>
            }

            @if (_canvasQueueUrl is not null && !State.IsBusy)
            {
                @* 큐 렌더(10s/15s/앰비언트)·갤러리 선택 산출물 — 🎞️ 듀얼 버퍼(A/B) 크로스디졸브: 자식 <video> 2장은 JS 소유(promptflow.swapVideoSource) → 소스 교체 시 검은 화면 0 *@
                <div class="ws-hts-wrap @(_abOn ? "ab-on" : null)">
                    <div id="@XdHostId" class="ws-xd"></div>
                    @if (_abOn) { @AbSplit }
                    @if (_growthBadge) { <div class="ws-growth-badge" role="button" title="클릭해 D-day · 문구 편집" data-growth-badge="@GrowthBadgeLabel" @onclick="() => _badgeEdit = !_badgeEdit">@GrowthBadgeLabel</div> @if (_badgeEdit) { <input class="ws-growth-edit" placeholder="예: D+100 · 우리아기 첫돌" maxlength="40" @bind="_badgeCustom" @bind:event="oninput" /> } }
                </div>
                @ScrubBar
                @if (_canvasQueuePath is { } qPath)
                {
                    <div class="ws-done">
                        <button class="ws-btn sm" @onclick="() => OpenPublish(qPath)" title="YouTube Shorts · Instagram Reels 원클릭 발행">🚀 SNS 원클릭 발행</button>
                        <button class="ws-btn ghost sm" @onclick="() => RevealInExplorer(qPath)" title="윈도우 탐색기에서 파일 선택 상태로 열기">📂 폴더 열기</button>
                        <button class="ws-btn ghost sm" @onclick="() => CopyMediaPath(qPath)" title="파일 절대 경로를 클립보드에 복사">📋 경로 복사</button>
                        <button class="ws-btn ghost sm" @onclick="() => ExportToStockSuite(qPath)" disabled="@_stockBusy" title="환경설정의 StockSuite 에셋 폴더에 bg_ambient.mp4 로 원자적 덮어쓰기">💼 StockSuite로 내보내기</button>
                        @if (StockCanLaunch) { <button class="ws-btn ghost sm" @onclick="() => LaunchStockSuite(false)" title="환경설정의 StockSuite.exe 를 즉시 실행해 에셋 적용을 실기 검증">🚀 StockSuite 실행</button> }
                        <span class="ws-hint" title="@qPath">@ShortPath(qPath)</span>
                    </div>
                }
            }
            else if (State.Phase == WanJobPhase.Idle)
            {
                <div class="ws-empty">
                    @* 뷰파인더 HUD — 선택 해상도 비율 가이드 박스 + 3분할 그리드 + 중앙 크로스헤어 + 해상도 상태 *@
                    <div class="ws-vf @(_vm.I2vModeRequested ? "i2v-hot" : null)" style="aspect-ratio: @_vm.HudAspectCss">
                        <span class="ws-vf-g v1"></span><span class="ws-vf-g v2"></span>
                        <span class="ws-vf-g h1"></span><span class="ws-vf-g h2"></span>
                        <span class="ws-vf-x"></span>
                        <span class="ws-vf-c tl"></span><span class="ws-vf-c tr"></span><span class="ws-vf-c bl"></span><span class="ws-vf-c br"></span>
                        <span class="ws-vf-mode">@_vm.StatusBadge</span>
                        <span class="ws-vf-st">@_vm.HudStatusText</span>
                    </div>
                    <div>왼쪽에 프롬프트를 입력하고 <b>생성 시작</b>을 누르세요.</div>
                    <button class="ws-empty-card" @onclick="SendScriptToStoryboard">✨ 여러 컷을 한 번에 — 대본 자동 생성 →</button>
                </div>
            }
            else if (State.Phase == WanJobPhase.Completed && State.VideoUrl is not null)
            {
                @* 로컬 성공 시 가상호스트 URL(디스크 직접 스트리밍), 실패 시 원격 URL — 🎞️ 듀얼 버퍼(A/B) 크로스디졸브 호스트(JS 소유 <video> 2장) *@
                @if (IsPortrait && _safeZone)
                {
                    <div class="ws-video-wrap portrait">
                        <ShortsSafeZone Caption="@_prompt">
                            <div id="@XdMainId" class="ws-xd"></div>
                        </ShortsSafeZone>
                    </div>
                }
                else if (IsPortrait)
                {
                    <div class="ws-video-wrap portrait">
                        <div id="@XdMainId" class="ws-xd"></div>
                    </div>
                }
                else
                {
                    <div class="ws-hts-wrap @(_abOn ? "ab-on" : null)">
                        <div id="@XdMainId" class="ws-xd"></div>
                        @if (_abOn) { @AbSplit }
                        @if (_growthBadge) { <div class="ws-growth-badge" role="button" title="클릭해 D-day · 문구 편집" data-growth-badge="@GrowthBadgeLabel" @onclick="() => _badgeEdit = !_badgeEdit">@GrowthBadgeLabel</div> @if (_badgeEdit) { <input class="ws-growth-edit" placeholder="예: D+100 · 우리아기 첫돌" maxlength="40" @bind="_badgeCustom" @bind:event="oninput" /> } }
                    </div>
                }
                @ScrubBar
                <div class="ws-done">
                    @if (IsPortrait)
                    {
                        <label class="ws-sztog" title="유튜브 숏츠 UI 가림 영역 미리보기">
                            <input type="checkbox" @bind="_safeZone" />
                            <span>🛡️ 숏츠 UI 가이드</span>
                        </label>
                    }
                    @if (State.IsLocal)
                    {
                        <span class="ws-src ok">💾 로컬 저장됨</span>
                        <button class="ws-btn ghost sm" @onclick="ToggleReverse" disabled="@_reversing"
                                title="FFmpeg -vf reverse — 재생성 과금 없이 모션 방향만 반전">@(IsShowingReversed ? "↩ 원본 보기" : "🔄 영상 반전")</button>
                        @if (_reverseMsg is { Length: > 0 })
                        {
                            <span class="ws-hint">@_reverseMsg</span>
                        }
                        <button class="ws-btn ghost sm" @onclick="State.Reset">＋ 새로 만들기</button>
                        @if (State.LocalPath is { } pubSrc)
                        {
                            <button class="ws-btn sm" @onclick="() => OpenPublish(pubSrc)" title="YouTube Shorts · Instagram Reels 원클릭 발행">🚀 SNS 원클릭 발행</button>
                            <button class="ws-btn ghost sm" @onclick="() => RevealInExplorer(pubSrc)" title="윈도우 탐색기에서 파일 선택 상태로 열기">📂 폴더 열기</button>
                            <button class="ws-btn ghost sm" @onclick="() => CopyMediaPath(pubSrc)" title="파일 절대 경로를 클립보드에 복사">📋 경로 복사</button>
                            <button class="ws-btn ghost sm" @onclick="() => ExportToStockSuite(pubSrc)" disabled="@_stockBusy" title="환경설정의 StockSuite 에셋 폴더에 bg_ambient.mp4 로 원자적 덮어쓰기">💼 StockSuite로 내보내기</button>
                            @if (StockCanLaunch) { <button class="ws-btn ghost sm" @onclick="() => LaunchStockSuite(false)" title="환경설정의 StockSuite.exe 를 즉시 실행해 에셋 적용을 실기 검증">🚀 StockSuite 실행</button> }
                        }
                        <span class="ws-hint" title="@State.LocalPath">@ShortPath(State.LocalPath)</span>
                        <label class="ws-sztog" title="@AudioSfxEngine.GenerateAudioPrompt(State.LastPrompt)">
                            <input type="checkbox" @bind="_autoFoley" />
                            <span>🔊 Auto-Foley</span>
                        </label>
                        @if (_foleyMsg is { Length: > 0 })
                        {
                            <span class="ws-hint">@_foleyMsg</span>
                        }
                    }
                    else
                    {
                        <span class="ws-src warn">☁ 원격 재생(24h)</span>
                        <a class="ws-btn sm" href="@State.RemoteUrl" target="_blank" rel="noopener">↗ 원본 열기</a>
                        <button class="ws-btn ghost sm" @onclick="State.Reset">＋ 새로 만들기</button>
                        <span class="ws-hint">※ 로컬 저장 실패로 원격 링크 재생 중 — 24시간 후 만료됩니다.</span>
                    }
                </div>
                @if (_lipOn && State.IsLocal)
                {
                    <div class="ws-lip">
                        <input class="ws-lip-in" @bind="_lipText" @bind:event="oninput" maxlength="200" disabled="@_lipBusy"
                               placeholder="👄 나레이션 대사 — TTS 음성으로 합성해 입모양을 맞춥니다" />
                        <button class="ws-btn sm" @onclick="RealignLipSyncAsync" disabled="@(_lipBusy || string.IsNullOrWhiteSpace(_lipText) || !LipAi.IsAvailable)"
                                title="@(AiAudioDrivenLipSyncService.LabelOf(LipAi.PreferredBackend))">@(_lipBusy ? "⏳ 처리 중…" : "🔁 1-Click 오디오-립싱크 재정렬")</button>
                        @if (_lipMsg is { Length: > 0 }) { <span class="ws-hint">@_lipMsg</span> }
                        @if (_lipUrl is not null) { <video class="ws-lip-vid" src="@_lipUrl" controls preload="metadata"></video> }
                    </div>
                }
            }
            else if (State.Phase is WanJobPhase.Failed or WanJobPhase.Canceled)
            {
                <div class="ws-err">⚠ @(PromptFlowStudio.Services.Platform.ErrorDialogService.CleanMessage(State.Error ?? State.StatusText))</div>
                <div class="ws-done">
                    <button class="ws-btn ghost sm" @onclick="State.Reset">다시 시도</button>
                    <button class="ws-btn ghost sm" @onclick='() => Errors.Show(State.Error ?? State.StatusText)'>🔎 해결 방법</button>
                </div>
            }
            else
            {
                <div class="ws-prog">
                    <div class="ws-bar"><div class="ws-bar-f" style="width:@(State.Percent)%"></div></div>
                    <div class="ws-prog-t">@State.StatusText</div>
                    <div class="ws-prog-m">
                        <span>@State.Percent%</span>
                        <span>경과 @($"{State.Elapsed.TotalSeconds:0}")초</span>
                        @if (State.TaskId is not null)
                        {
                            <span class="ws-tid">task @Short(State.TaskId)</span>
                        }
                    </div>
                </div>
            }

            @* v15.4.1 MMF 라이브 프레임 캔버스 — 파이프 시퀀스가 전진할 때만 그린다(최대 ~60FPS) *@
            <div class="ws-live">
                <canvas id="ws-live" class="ws-live-cv" width="128" height="128"></canvas>
                <span class="ws-live-badge @(_liveSignal ? "on" : null)">@(_liveSignal ? "● LIVE · MMF" : "○ 프레임 신호 대기")</span>
            </div>

            @* v15.4.0 ⚙️ Wan 2.1 파라미터 튜너 · 🍼 아기 디테일 복원 스위치 · 📊 미니 텔레메트리 바 *@
            <div class="ws-tune">
                <div class="ws-tune-h">⚙️ Wan 2.1 파라미터 튜너 <button class="ws-more inl" @onclick="_canvas.Reset" disabled="@State.IsBusy">기본값</button></div>
                <label class="ws-tune-r"><span>Inference Steps</span><b>@_canvas.Steps</b>
                    <input type="range" min="@LiveVideoCanvasStudio.MinSteps" max="@LiveVideoCanvasStudio.MaxSteps" step="1" @bind="_canvas.Steps" @bind:event="oninput" disabled="@State.IsBusy" /></label>
                <label class="ws-tune-r"><span>CFG Scale</span><b>@_canvas.CfgLabel</b>
                    <input type="range" min="1" max="15" step="0.5" @bind="_canvas.CfgScale" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" disabled="@State.IsBusy" /></label>
                <label class="ws-tune-r"><span>Motion Bucket</span><b>@_canvas.MotionBucket</b>
                    <input type="range" min="@LiveVideoCanvasStudio.MinMotion" max="@LiveVideoCanvasStudio.MaxMotion" step="1" @bind="_canvas.MotionBucket" @bind:event="oninput" disabled="@State.IsBusy" /></label>
                <div class="ws-tune-seed">
                    <label class="ws-sztog"><input type="checkbox" @bind="_canvas.SeedPinned" disabled="@State.IsBusy" /><span>📌 Seed 핀</span></label>
                    <input class="ws-sel ws-seed" type="number" min="0" @bind="_canvas.Seed" disabled="@(State.IsBusy || !_canvas.SeedPinned)" />
                    <button class="ws-btn ghost sm" @onclick="RollSeed" disabled="@(State.IsBusy || !_canvas.SeedPinned)" title="새 시드">🎲</button>
                </div>
                <div class="ws-tune-h">🍼 아기 디테일 복원 스위치</div>
                <div class="ws-tune-sw">
                    <label class="ws-sztog"><input type="checkbox" @bind="_canvas.FaceSharpen" disabled="@State.IsBusy" /><span>👶 Baby Face Sharpener</span></label>
                    <label class="ws-sztog"><input type="checkbox" @bind="_canvas.Interpolate60" disabled="@State.IsBusy" /><span>🎞️ 60FPS 모션 보간</span></label>
                </div>
                <div class="ws-tele" title="튜너 값은 로컬 CLI 엔진에 전달되며, 클라우드(DashScope)는 Seed 만 반영합니다.">
                    <span class="ws-tele-l">📊</span>
                    <div class="ws-tele-bar"><div class="ws-tele-f" style="width:@(State.Percent)%"></div></div>
                    <span class="ws-tele-t">@_canvas.Summary</span>
                </div>
            </div>
        </div>

        @* ── ③ 퀵 위젯 레일 ── *@
        <aside class="ws-rail">
            <div class="ws-w">
                <div class="ws-w-h">🎥 아기 카메라 모션</div>
                <div class="ws-chips">
                    @{ var babyCamOn = WanCameraStyleStudio.ActiveIndex(_prompt, BabyStudioMatrix.CameraMotions); }
                    @for (var i = 0; i < _babyCam.Length; i++)
                    {
                        var c = BabyStudioMatrix.CameraMotions[i];
                        <button class="ws-chip @(babyCamOn == i ? "on" : null)" @onclick="_babyCam[i]" disabled="@State.IsBusy" title="@c.Snippet" @key="c.Snippet">
                            <span>@c.Icon</span> @c.Label
                        </button>
                    }
                </div>
                <button class="ws-more" @onclick='() => Nav.NavigateTo("camera-studio?tab=motion")'>더 많은 모션·카메라 →</button>

                <div class="ws-baby">
                    <div class="ws-baby-h">👶 아기 스튜디오 얼티메이트 매트릭스</div>
                    <div class="ws-baby-tabs">
                        @for (var t = 0; t < BabyTabNames.Length; t++)
                        {
                            <button class="ws-baby-tab @(_babyTab == t ? "on" : null)" @onclick="_babyTabSel[t]" @key="BabyTabNames[t]">@BabyTabNames[t]</button>
                        }
                    </div>
                    <div class="ws-chips">
                        @{ var cat = BabyCatalog(_babyTab); var acts = _babyActs[_babyTab]; }
                        @for (var i = 0; i < acts.Length; i++)
                        {
                            var b = cat[i];
                            <button class="ws-chip ws-chip-baby" @onclick="acts[i]" disabled="@State.IsBusy" title="@b.Snippet" @key="b.Label">
                                <span>@b.Icon</span> @b.Label
                            </button>
                        }
                    </div>
                    <div class="ws-baby-neg">
                        <div class="ws-baby-neg-h">🛡️ 네거티브 (Wan 2.1)
                            @if (_baby.GuardActive) { <span class="ws-baby-guard">얼굴 보호 ON</span> }
                        </div>
                        <textarea class="ws-ta ws-ta-neg" @bind="_baby.NegativePrompt" @bind:event="oninput" maxlength="500"
                                  placeholder="피하고 싶은 요소(선택) — 아기 테마 클릭 시 얼굴 보호 문구가 자동 결합됩니다" disabled="@State.IsBusy"></textarea>
                    </div>
                    <div class="ws-emo">
                        <div class="ws-baby-neg-h">👶 피사체 Identity 고정
                            @if (_idLockOn && SelectedProfile is not null) { <span class="ws-baby-guard">🔒 @SelectedProfile.Name · 앵커 @(SelectedProfile.Anchors.Count)</span> }
                        </div>
                        <div class="ws-chips">
                            <select class="ws-lip-in" @bind="_idProfileId" disabled="@State.IsBusy">
                                <option value="">— 캐릭터 선택 —</option>
                                @foreach (var cp in SeriesBuilder.Profiles) { <option value="@cp.Id">@cp.Name</option> }
                            </select>
                            <label class="ws-sztog"><input type="checkbox" @bind="_idLockOn" disabled="@(State.IsBusy || SelectedProfile is null)" /><span>고정 켜기</span></label>
                            <button class="ws-chip" @onclick="() => _characterOpen = true" disabled="@State.IsBusy">👶 캐릭터 스튜디오</button>
                        </div>
                        @if (_idScoreText is not null) { <span class="ws-hint">@_idScoreText</span> }
                    </div>
                    @if (_characterOpen)
                    {
                        <CharacterStudioModal OnClose="CloseCharacterStudio" />
                    }
                    <div class="ws-emo">
                        <label class="ws-sztog" title="@(LipAi.AiAvailable ? AiAudioDrivenLipSyncService.LabelOf(LipAi.PreferredBackend) : "AI 립싱크 엔진 미구성 — FFmpeg 프레임 보정(오디오 정렬)만 가능")">
                            <input type="checkbox" @bind="_lipOn" />
                            <span>👄 AI 정밀 립싱크 켜기</span>
                        </label>
                        <div class="ws-chips">
                            @foreach (var ep in WorkspaceEmotions)
                            {
                                <button class="ws-chip @(_emotion == ep ? "on" : null)" disabled="@State.IsBusy" @key="ep"
                                        @onclick="() => _emotion = _emotion == ep ? FacialEmotion.Neutral : ep">@FacialEmotionPuppeteerEngine.LabelOf(ep)</button>
                            }
                        </div>
                        @if (_emotion != FacialEmotion.Neutral)
                        {
                            <label class="ws-emo-int">표정 강도 <b>@((_emotionIntensity * 100).ToString("0", CultureInfo.InvariantCulture))%</b>
                                <input type="range" min="0.2" max="1" step="0.05" @bind="_emotionIntensity" @bind:event="oninput" disabled="@State.IsBusy" /></label>
                            <span class="ws-baby-guard">얼굴 보호 ON · 표정만 변화</span>
                        }
                    </div>
                </div>
            </div>

            <div class="ws-w ws-gem">
                <div class="ws-w-h">✨ 제미나이 AI 추천 스튜디오</div>
                @if (_myPresets.Count > 0)
                {
                    <div class="ws-gem-h">⭐ 내 프리셋</div>
                    <div class="ws-chips">
                        @foreach (var up in _myPresets)
                        {
                            <span class="ws-chip ws-chip-my" @key="up.Id">
                                <button class="ws-chip-my-b" @onclick="() => ApplyUserPreset(up)" disabled="@State.IsBusy" title="@UserPresetTip(up)">⭐ @up.Name</button>
                                <button class="ws-chip-my-x" @onclick="() => DeleteUserPreset(up.Id)" disabled="@State.IsBusy" title="프리셋 삭제">✕</button>
                            </span>
                        }
                    </div>
                }
                <button class="ws-gem-enh" @onclick="_geminiEnhance" disabled="@(State.IsBusy || _enhancing)" title="@(_imagePath is not null ? "참조 이미지를 Gemini Vision 으로 분석해 I2V 프롬프트를 역생성합니다" : "선택한 듀레이션에 맞춰 Wan 2.1 시네마틱 프롬프트로 강화합니다")">@(_enhancing ? "⏳ 강화 중..." : _imagePath is not null ? "✨ AI 문장 자동 강화 (Vision I2V)" : "✨ AI 문장 자동 강화")</button>
                @if (_promptKoOrigin is { } ko && string.Equals(_prompt, _promptKoTranslated, StringComparison.Ordinal))
                {
                    <div class="ws-gem-ko" title="@ko">🇰🇷 원문: @ko</div>
                }
                <div class="ws-gem-h">🎨 비주얼 스타일</div>
                <div class="ws-chips">
                    @{ var gemStyOn = WanCameraStyleStudio.ActiveIndex(_prompt, GeminiRecommendationMatrix.Picks); }
                    @for (var i = 0; i < _geminiPick.Length; i++)
                    {
                        var g = GeminiRecommendationMatrix.Picks[i];
                        <button class="ws-chip ws-chip-gem @(gemStyOn == i ? "on" : null)" @onclick="_geminiPick[i]" disabled="@State.IsBusy" title="@g.Snippet" @key="g.Label">
                            <span>@g.Icon</span> @g.Label
                        </button>
                    }
                </div>
            </div>

            <div class="ws-w">
                <div class="ws-w-h">🕒 최근 미디어 <button class="ws-more inl" @onclick='() => Nav.NavigateTo("gallery")'>전체 갤러리</button></div>
                @if (_recent.Count == 0)
                {
                    <div class="ws-w-empty">아직 생성된 영상이 없습니다.</div>
                }
                else
                {
                    <div class="ws-tiles">
                        @foreach (var m in _recent)
                        {
                            var item = m;
                            @* 클릭 → 캔버스 소스 교체 + 프롬프트·카메라·듀레이션·화면비·시드 역복원(.meta.json) *@
                            <div class="ws-tile-pick" @onclick="() => RehydrateFromRecent(item)" title="클릭: @(item.Name) 작업 설정을 작업실에 복원" @key="item.Path">
                                @if (item.PosterUrl is not null)
                                {
                                    <img class="ws-tile" src="@item.PosterUrl" alt="@item.Name" loading="lazy" />
                                }
                                else
                                {
                                    <video class="ws-tile" src="@item.PlaybackUrl" muted preload="metadata"></video>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="ws-w">
                <div class="ws-w-h">📊 API · 시스템</div>
                <div class="ws-mon">
                    <div class="ws-mon-r"><span>Wan API</span><span class="ws-dot @(Cfg.IsConfigured ? "ok" : "off")">@(Cfg.IsConfigured ? "● 연결됨" : "○ 미설정")</span></div>
                    <div class="ws-mon-r"><span>FFmpeg 병합</span><span class="ws-dot @(Merge.IsAvailable ? "ok" : "off")">@(Merge.IsAvailable ? "● 감지됨" : "○ 없음")</span></div>
                    <div class="ws-mon-r"><span>저장소 여유</span><span class="ws-mon-v">@FreeSpace</span></div>
                </div>
            </div>
        </aside>
    </section>

    @* v15.9.0 멀티 컷 타임라인 — 퀵갤러리 클립을 드래그해 순서/트랜지션 지정 후 ffmpeg 병합(Fade=xfade 500ms · Cut=하드 컷). *@
    <TimelineSequencer Clips="_recent" Busy="_timelineBusy" OnMerge="MergeTimelineAsync" />
    @if (_timelineMsg is { Length: > 0 })
    {
        <div class="ws-hint" style="margin-top:6px">@_timelineMsg</div>
    }
</div>

@* 💡 스토리 레시피 & 인스피레이션 허브 — 탭1 장르별 카드 덱 · 탭2 레고식 칩 조합기 → UserInput 즉시 적용 *@
@if (_vm.IsInspirationModalOpen)
{
    <div class="ws-insp-ov @(_inspClosing ? "closing" : null)" @onclick="CloseInspiration">
        <div class="ws-insp-dlg" role="dialog" aria-label="스토리 레시피 & 영감 모음" @onclick:stopPropagation="true">
            <div class="ws-insp-h">
                <span>💡 스토리 레시피 & 영감 모음</span>
                <button class="ws-insp-x" @onclick="CloseInspiration" title="닫기">✕</button>
            </div>
            <div class="ws-insp-tabs">
                <button class="ws-insp-tab @(_inspTab == 0 ? "on" : null)" @onclick="() => _inspTab = 0">🎬 장르별 완성 스토리</button>
                <button class="ws-insp-tab @(_inspTab == 1 ? "on" : null)" @onclick="() => _inspTab = 1">🧱 레고식 모듈 조합기</button>
                <button class="ws-insp-tab @(_inspTab == 2 ? "on" : null)" @onclick="() => _inspTab = 2">⭐ 내 커스텀 프리셋 (@(_vm.CustomPresets.Count))</button>
            </div>
            <div class="ws-insp-save">
                <input class="ws-insp-save-in" placeholder="현재 프롬프트를 내 프리셋으로 저장 — 제목 입력" maxlength="@PromptFlowStudio.Services.Prompt.PromptInspirationService.MaxCustomTitleLength" @bind="_presetTitle" @bind:event="oninput" />
                <button class="ws-insp-apply" @onclick="SaveCurrentPreset" disabled="@(string.IsNullOrWhiteSpace(_presetTitle) || string.IsNullOrWhiteSpace(_prompt))">💾 저장</button>
                @if (_presetMsg is { Length: > 0 })
                {
                    <span class="ws-insp-save-msg">@_presetMsg</span>
                }
            </div>
            @if (_inspTab == 0)
            {
                <div class="ws-insp-cats">
                    <button class="ws-zen-chip @(_inspCat is null ? "on" : null)" @onclick="() => SelectInspirationCategory(null)">전체</button>
                    @foreach (var ic in InspirationCategories)
                    {
                        <button class="ws-zen-chip @(_inspCat == ic ? "on" : null)" @onclick="() => SelectInspirationCategory(ic)" @key="ic">@PromptFlowStudio.Services.Prompt.PromptInspirationService.CategoryLabel(ic)</button>
                    }
                </div>
                <div class="ws-insp-deck">
                    @foreach (var r in _inspList)
                    {
                        <button class="ws-insp-card @(ReferenceEquals(_inspPick, r) ? "on" : null)" @onclick="() => _inspPick = r" @key="r.Title">
                            <span class="ws-insp-cat">@PromptFlowStudio.Services.Prompt.PromptInspirationService.CategoryLabel(r.Category)</span>
                            <span class="ws-insp-title">@r.Title</span>
                            <span class="ws-insp-meta">🎥 @r.RecommendedCamera</span>
                            <span class="ws-insp-meta">💡 @r.RecommendedLighting</span>
                        </button>
                    }
                </div>
                @if (_inspPick is { } pick)
                {
                    <div class="ws-insp-prev">
                        <div class="ws-insp-prev-t">@pick.Title</div>
                        <div class="ws-insp-prev-p">@pick.FullPrompt</div>
                        <button class="ws-insp-apply" @onclick="() => ApplyRecipeAsync(pick)">✅ 이 스토리 적용</button>
                    </div>
                }
            }
            else if (_inspTab == 2)
            {
                @if (_vm.CustomPresets.Count == 0)
                {
                    <div class="ws-insp-empty">
                        <span class="ws-insp-empty-ic" aria-hidden="true">🐣</span>
                        <div class="ws-insp-empty-t">아직 저장된 프리셋이 없어요</div>
                        <div class="ws-insp-empty-p">저장된 프리셋이 없습니다. 위 입력란에 제목을 적고 💾 저장을 누르세요.</div>
                    </div>
                }
                else
                {
                    <div class="ws-insp-deck">
                        @foreach (var cp in _vm.CustomPresets)
                        {
                            <div class="ws-insp-card" @key="cp.Id">
                                <span class="ws-insp-cat">⭐ @cp.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)</span>
                                <span class="ws-insp-title">@cp.Title</span>
                                @if (cp.CameraMotion.Length > 0)
                                {
                                    <span class="ws-insp-meta">🎥 @cp.CameraMotion</span>
                                }
                                <span class="ws-insp-meta ws-insp-clip" title="@cp.Prompt">@cp.Prompt</span>
                                <div class="ws-insp-acts">
                                    <button class="ws-insp-apply" @onclick="() => ApplyCustomPresetAsync(cp)">✅ 적용</button>
                                    <button class="ws-insp-del" @onclick="() => DeleteCustomPreset(cp.Id)">🗑 삭제</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="ws-zen-l">주인공</div>
                <div class="ws-zen-g">
                    @for (var i = 0; i < PromptFlowStudio.Services.Prompt.PromptInspirationService.Subjects.Length; i++)
                    {
                        var idx = i; var c = PromptFlowStudio.Services.Prompt.PromptInspirationService.Subjects[i];
                        <button class="ws-zen-chip @(_chipSubj == idx ? "on" : null)" @onclick="() => _chipSubj = _chipSubj == idx ? -1 : idx" title="@c.Snippet" @key="c.Label">@c.Label</button>
                    }
                </div>
                <div class="ws-zen-l">배경</div>
                <div class="ws-zen-g">
                    @for (var i = 0; i < PromptFlowStudio.Services.Prompt.PromptInspirationService.Environments.Length; i++)
                    {
                        var idx = i; var c = PromptFlowStudio.Services.Prompt.PromptInspirationService.Environments[i];
                        <button class="ws-zen-chip @(_chipEnv == idx ? "on" : null)" @onclick="() => _chipEnv = _chipEnv == idx ? -1 : idx" title="@c.Snippet" @key="c.Label">@c.Label</button>
                    }
                </div>
                <div class="ws-zen-l">카메라 무빙</div>
                <div class="ws-zen-g">
                    @for (var i = 0; i < PromptFlowStudio.Services.Prompt.PromptInspirationService.Motions.Length; i++)
                    {
                        var idx = i; var c = PromptFlowStudio.Services.Prompt.PromptInspirationService.Motions[i];
                        <button class="ws-zen-chip @(_chipMot == idx ? "on" : null)" @onclick="() => _chipMot = _chipMot == idx ? -1 : idx" title="@c.Snippet" @key="c.Label">@c.Label</button>
                    }
                </div>
                <div class="ws-zen-l">조명</div>
                <div class="ws-zen-g">
                    @for (var i = 0; i < PromptFlowStudio.Services.Prompt.PromptInspirationService.Lightings.Length; i++)
                    {
                        var idx = i; var c = PromptFlowStudio.Services.Prompt.PromptInspirationService.Lightings[i];
                        <button class="ws-zen-chip @(_chipLight == idx ? "on" : null)" @onclick="() => _chipLight = _chipLight == idx ? -1 : idx" title="@c.Snippet" @key="c.Label">@c.Label</button>
                    }
                </div>
                var chipText = ChipPreview();
                <div class="ws-insp-prev">
                    <div class="ws-insp-prev-t">실시간 문장 미리보기</div>
                    <div class="ws-insp-prev-p">@(chipText.Length > 0 ? chipText : "칩을 하나 이상 선택하세요")</div>
                    <button class="ws-insp-apply" @onclick="ApplyChipsAsync" disabled="@(chipText.Length == 0)">✅ 조합 문장 적용</button>
                </div>
            }
        </div>
    </div>
}

<PublishModal Vm="PubVm" />

<style>
    .ws { padding: 6px 8px 48px; width: 100%; box-sizing: border-box; }
    .ws-head { margin-bottom: 18px; }
    .ws-navrow { display: flex; gap: 14px; margin-bottom: 4px; }
    .ws-back { font: 700 12px/1 var(--mono); color: var(--text-muted); background: none; border: none; cursor: pointer; padding: 0 0 10px; }
    .ws-back:hover { color: var(--accent); }
    .ws-ssmon { margin-left: auto; font: 700 11px/1 var(--mono); padding: 4px 10px; border-radius: 999px; cursor: pointer; border: 1px solid var(--border, #333); background: none; color: var(--text-muted); align-self: flex-start; }
    .ws-ssmon.on { color: #22c55e; border-color: rgba(34,197,94,.45); background: rgba(34,197,94,.08); }
    .ws-ssmon:hover { color: var(--accent); }
    .ws-ipc-wait { border-color: rgba(250,204,21,.45) !important; color: #facc15 !important; background: rgba(250,204,21,.08) !important; }
    .ws-ipc { font: 700 11px/1 var(--mono); padding: 4px 10px; border-radius: 999px; border: 1px solid rgba(56,189,248,.45); color: #38bdf8; background: rgba(56,189,248,.08); align-self: flex-start; }
    .ws-recover { font: 700 11px/1 var(--mono); padding: 4px 10px; border-radius: 999px; border: 1px solid rgba(250,204,21,.45); color: #facc15; background: rgba(250,204,21,.08); align-self: flex-start; animation: ws-recover-pulse 1.4s ease-in-out infinite; }
    @@keyframes ws-recover-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .55; } }
    .ws-title { font-size: 28px; font-weight: 900; letter-spacing: -.4px; color: var(--text-primary); margin: 0 0 6px; }
    .ws-title-g { background: linear-gradient(90deg, var(--flow-violet), var(--flow-cyan)); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .ws-sub { font-size: 13.5px; color: var(--text-secondary); margin: 0; }

    .ws-warn { margin: 14px 0; padding: 12px 16px; border-radius: 12px; font-size: 12.5px; line-height: 1.6;
        border: 1px solid color-mix(in srgb, #f5a623 45%, var(--line)); background: color-mix(in srgb, #f5a623 10%, var(--card)); color: var(--text-secondary); }
    .ws-warn code { font: 600 11.5px var(--mono); color: var(--accent-2); }
    .ws-warn-link { font-weight: 700; font-size: 12.5px; font-family: inherit; color: var(--accent-2); background: none; border: none; padding: 0; cursor: pointer; text-decoration: underline; }
    .ws-warn-link:hover { color: var(--text-primary); }

    /* v15.5.0 픽셀 정렬: 3칼럼을 같은 행 높이로 늘려(stretch) 상·하단 수평선 일치, 각 칼럼은 height:100% · min-height:0 */
    .ws-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1.15fr) 300px; gap: 16px; margin-top: 16px; align-items: stretch; }
