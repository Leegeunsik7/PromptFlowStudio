    private async Task GenerateThreeWayAsync()
    {
        if (_variantBusy) return;
        _variantBusy = true;
        _variantMsg = null;
        try
        {
            Snap("3-Way 전개 전");
            var r = await GeminiSvc.GenerateThreeWayVariantsAsync(_prompt, _mediaCts.Token);
            _variants = r.Variants;
            _variantSel = -1;
            var picks = new Action[r.Variants.Count];
            for (var k = 0; k < picks.Length; k++)
            {
                var idx = k;
                picks[k] = () =>
                {
                    if (idx >= _variants.Count) return;
                    _variantSel = idx;
                    _prompt = _variants[idx].Prompt;
                    _canvas.Seed = _variants[idx].Seed; _canvas.SeedPinned = true;   // 스타일 시드 고정(재현성)
                    Snap("3-Way " + _variants[idx].Title);
                };
            }
            _variantPick = picks;
            _variantMsg = (r.UsedFallback ? "💡 " : "") + r.Message;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Program.Log("Workspace.ThreeWay", ex); _variantMsg = "⚠ 3종 전개 실패 — 다시 시도하세요."; }
        finally { _variantBusy = false; }
    }

    /// <summary>3종 변형 일괄 렌더 큐 적재 — 스타일별 고유 시드 · 5초 단일 컷.</summary>
    private void EnqueueVariants()
    {
        if (_variants.Count == 0) return;
        RefreshRenderMode();
        var stamp = DateTime.Now.ToString("yyyyMMdd_HHmmss", CultureInfo.InvariantCulture);
        var total = 0;
        for (var k = 0; k < _variants.Count; k++)
        {
            var v = _variants[k];
            var project = "ws3way_" + stamp + "_" + v.Index.ToString(CultureInfo.InvariantCulture);
            var job = new PromptFlowStudio.Services.Batch.BatchRenderJob
            {
                Prompt = v.Prompt,
                Seed = v.Seed,
                Resolution = _size.Replace('*', 'x'),
                DurationSec = PromptFlowStudio.Services.Render.MultiDurationPlanner.ShotSeconds,
                ReferenceImagePath = _imagePath,
                OutputPath = Path.Combine(Media.MediaRoot, project + ".mp4"),
                DurationMode = PromptFlowStudio.Services.Render.VideoDurationMode.Sec5_Single,
                EngineKind = _renderMode,
            };
            total += RenderQueue.EnqueueJob(job, null, project).Count;
        }
        _variantMsg = total == 0 ? "⚠ 렌더 큐 적재 실패" : "📥 3종 스타일 렌더 큐 적재 " + total.ToString(CultureInfo.InvariantCulture) + "건";
    }

