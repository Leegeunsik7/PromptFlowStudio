    .ws-tile-pick:hover { transform: translateY(-1px); box-shadow: 0 0 0 2px var(--accent, #7c5cff); }
    .ws-tile-pick .ws-tile { display: block; pointer-events: none; }
    .ws-mon { display: flex; flex-direction: column; gap: 8px; }
