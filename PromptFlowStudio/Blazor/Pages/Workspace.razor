            StockSuite.MistakeNotebook ??= EcoSp.GetService(typeof(PromptFlowStudio.Services.Pluto.IPlutoMistakeNotebookService)) as PromptFlowStudio.Services.Pluto.IPlutoMistakeNotebookService;
            IReadOnlyList<PromptFlowStudio.Services.Export.SubtitleCue> cues = _montageCues is { Count: > 0 } mc && _activeMontagePlan is { } amp && amp.Clips.Count == photos.Length
                ? mc   // 🎬 클립 경계 정렬 3막 자막(프리뷰와 동일)
                : (await GenerateWorkspaceLetterAsync(_mediaCts.Token)).ToCues();
            // 🧩 프리플라이트 — 빈/연속 중복 자막 큐 보정 · 9:16 폭 초과 · 오답 노트 차단 훅×룩 조합 경고
            var montageGate = RunCoherenceGate(_prompt, null, cues, cues.Count > 0 && !string.IsNullOrWhiteSpace(cues[0].Text) ? cues[0].Text.Trim() : null, _montageLook, vertical9x16 ? "9:16" : "16:9");
            if (montageGate is { WasAutoSanitized: true, SanitizedSubtitleCues.Count: > 0 }) cues = montageGate.SanitizedSubtitleCues;
            var localeRender = LocalizeCuesForRender(cues);   // 🌐 Step 32 — 비기본 로캘 → 로캘 줄바꿈 · 편 토큰 재장식(편집 원문 불변)
            cues = localeRender.Cues;
            // 🔒 Zero-Drift — 프리뷰 · 3막 자막과 동일한 컷 경계(클립 수 일치 시)
            var locked = _activeMontagePlan is { } lp && lp.Clips.Count == photos.Length ? lp : null;
            var montageOptions = new PromptFlowStudio.Services.Export.ExportOptions();
            var abOut = abRun is null ? null : AbVariantOutputPath(abRun.ExperimentId, photos[0], abChallenger, vertical9x16, montageOptions.OutputDirectory);
            var r = await StockSuite.ExportMontageVideoFromPhotosAsync(photos, focals, montageOptions, cues,
                _bgmOn ? _bgmTrack : null, includeSfx: true, preferredLook: _montageLook, outputPath: abOut, ct: _mediaCts.Token, customBgmWavBytes: _customBgm?.CroppedWavBytes,
                lockedPlan: locked, vertical9x16SmartCrop: vertical9x16);
            _montageOutput = r.Ok ? r.TargetPath : null;
            if (r.Ok && r.TargetPath is { } rendered)
            {
                CapturePerfContext(rendered, "몽타주", null, _montageLook);
                RecordSeriesEpisodeOutput(rendered);
                if (abRun is not null) AttachAbArtifact(abRun.ExperimentId, abChallenger ? null : rendered, abChallenger ? rendered : null);
