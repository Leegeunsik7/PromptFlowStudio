    // ── ✨ 배치 베스트 컷 큐레이션(연사 최대 30장) ──
    private const int CurationMaxPhotos = PromptFlowStudio.Services.Pluto.PlutoPhotoCurationEngine.MaxBatchSize;
    private const long CurationMaxPhotoBytes = 15L * 1024 * 1024;
    private const int CurationAutoThreshold = 5;   // 초과 업로드 → 자동 선별
    private readonly List<string> _curationPool = new();
    private PromptFlowStudio.Services.Pluto.PlutoBatchCurationResult? _curationResult;
