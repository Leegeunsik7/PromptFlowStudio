    private async Task RefreshYouTubeUnmatchedAsync()
    {
        if (_ytUnmatchedSvc is not { } q || _disposed) return;
        var gen = Interlocked.Increment(ref _ytUnmatchedGen);
        try
        {
            await q.EnsureLoadedAsync(_mediaCts.Token);
            // 🔁 Step 25 — 멀티 PC 대기열 조정(60초 간격 · 다른 PC의 연결/무시/새 행 반영 · 변경 시 Changed → 재조회는 무변경으로 수렴)
            var nowTick = Environment.TickCount64;
            if (nowTick - Interlocked.Read(ref _ytReconcileTick) >= 60_000)
            {
                Interlocked.Exchange(ref _ytReconcileTick, nowTick);
                try { await q.ReconcileAsync(null, _mediaCts.Token); }
                catch (OperationCanceledException) { throw; }
                catch (Exception ex) { Program.Log("Workspace.YouTubeUnmatchedReconcile", ex); }
            }
            var rows = q.GetPending(YtUnmatchedVisible);
            var map = new Dictionary<string, IReadOnlyList<PromptFlowStudio.Services.Pluto.PlutoUnmatchedPairSuggestion>>(StringComparer.Ordinal);
            foreach (var r in rows) map[r.YouTubeVideoId] = await q.SuggestClipsAsync(r.YouTubeVideoId, 2, _mediaCts.Token);
            if (gen != Volatile.Read(ref _ytUnmatchedGen) || _disposed) return;
            _ytUnmatched = rows;
            _ytPairSuggestions = map;
        }
        catch (OperationCanceledException) { return; }
        catch (Exception ex) { Program.Log("Workspace.YouTubeUnmatchedRefresh", ex); return; }
        if (_disposed) return;
        await InvokeAsync(StateHasChanged);
    }

