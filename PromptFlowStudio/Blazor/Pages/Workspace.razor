    private bool _enhancing;
    private string? _promptKoOrigin, _promptKoTranslated;   // 한→영 치환 전 한글 원문(툴팁/서브 라벨 보존) · 치환본이 그대로일 때만 표시
    private async Task EnhanceWithGeminiAsync()
    {
        if (_enhancing) return;
        _enhancing = true;
        try
        {
            var src = _prompt ?? "";
            Snap(ContainsHangul(src) ? "원본 한글" : "강화 전 원본");
            PromptFlowStudio.Services.AI.GeminiEnhanceOutcome r;
            if (_imagePath is { } img)
                r = await GeminiSvc.AnalyzeReferenceImageAsync(img, src, _durationMode, _mediaCts.Token);
            else
            {
                var cam = WanCameraStyleStudio.ActiveIndex(src, WanCameraStyleStudio.Cameras);
                var sty = WanCameraStyleStudio.ActiveIndex(src, WanCameraStyleStudio.Styles);
                r = await GeminiSvc.EnhancePromptAsync(src, _durationMode,
                    sty >= 0 ? WanCameraStyleStudio.Styles[sty].Label : null,
                    cam >= 0 ? WanCameraStyleStudio.Cameras[cam].Label : null, _mediaCts.Token);
            }
            if (!string.IsNullOrWhiteSpace(r.Prompt)) { _prompt = r.Prompt; if (r.SourceKorean is not null) { _promptKoOrigin = r.SourceKorean; _promptKoTranslated = r.Prompt; } Snap(r.SourceKorean is not null ? "제미나이 영문 강화" : "제미나이 강화"); }
            if (r.UsedFallback) _camToast = "💡 " + r.Message;
        }
        catch (Exception ex) { Program.Log("Workspace.GeminiEnhance", ex); }
        finally { _enhancing = false; }
    }

