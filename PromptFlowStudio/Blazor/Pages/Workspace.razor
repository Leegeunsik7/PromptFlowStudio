    /// <summary>🎞️ 다중 사진 선택(최대 30장 · 장당 15MB) → 후보 풀 적재 → 6장 이상이면 AI 베스트 컷 자동 선별, 이하면 큐에 직접 추가(최대 5장).</summary>
    private async Task OnMontagePhotosPickedAsync(InputFileChangeEventArgs e)
    {
        if (_montageBusy || _curationBusy) return;
        IReadOnlyList<IBrowserFile> files;
        try { files = e.GetMultipleFiles(CurationMaxPhotos); }
        catch (InvalidOperationException ex) { Program.Log("Workspace.MontagePick", ex); _montageToast = "⚠ 한 번에 최대 30장까지 선택할 수 있습니다."; return; }
        var skipped = 0;
        for (var i = 0; i < files.Count && _curationPool.Count < CurationMaxPhotos; i++)
        {
            if (files[i].Size > CurationMaxPhotoBytes) { skipped++; continue; }
            if (await SaveUploadAsync(files[i], keepName: true) is not { } path) continue;
            if (!_curationPool.Contains(path, StringComparer.OrdinalIgnoreCase)) _curationPool.Add(path);
        }
        _montageOutput = null;
        if (_curationPool.Count > CurationAutoThreshold)
        {
            _montageToast = skipped > 0 ? "⚠ 15MB 초과 사진 " + skipped.ToString(CultureInfo.InvariantCulture) + "장 제외" : null;
            await RunPhotoCurationAsync();
            return;
        }
        for (var i = 0; i < _curationPool.Count && _montagePhotos.Count < MontageMaxPhotos; i++)
            if (!_montagePhotos.Contains(_curationPool[i], StringComparer.OrdinalIgnoreCase)) _montagePhotos.Add(_curationPool[i]);
        _montageToast = skipped > 0 ? "⚠ 15MB 초과 사진 " + skipped.ToString(CultureInfo.InvariantCulture) + "장 제외"
            : files.Count > 0 && _montagePhotos.Count >= MontageMaxPhotos ? "🎞️ 최대 5장까지 담았습니다." : null;
        RefreshMontageLook();
        StateHasChanged();
        await RefreshMontagePreviewAsync();
    }

    /// <summary>✨ 후보 풀 → 흔들림/노출/연사 제거 → 베스트 4컷 3막 배열 → 몽타주 큐 · 초점 캐시 교체 → 프리뷰 플랜 재컴파일. 실패 → 기존 큐 보존([부분 구제]).</summary>
    private async Task RunPhotoCurationAsync()
    {
        if (_curationBusy || _montageBusy || _curationPool.Count < 2) return;
        _curationBusy = true;
        StateHasChanged();
        try
        {
            var pool = _curationPool.ToArray();
            var result = await Curation.CurateBatchAsync(pool, PromptFlowStudio.Services.Pluto.PlutoPhotoCurationEngine.DefaultCutCount, ResolveVisionSynth(), _mediaCts.Token);
            if (_disposed) return;
            if (result.SelectedCuts.Count >= PromptFlowStudio.Services.Pluto.PlutoMontageCompiler.MinClips)
            {
                var photos = new string[result.SelectedCuts.Count];
                var focals = new (double X, double Y)[photos.Length];
                for (var i = 0; i < photos.Length; i++)
                {
                    photos[i] = result.SelectedCuts[i].ImagePath;
                    focals[i] = result.SelectedCuts[i].FocalPoint;
                }
                _montagePhotos.Clear();
                _montagePhotos.AddRange(photos);
                _stagedFocalPoints = focals;
                _stagedFocalKey = string.Join("|", photos);
                _curationResult = result;
                _showCurationDetails = false;
                _montageOutput = null;
            }
            else _montageToast = "⚠ 선별 가능한 사진이 부족합니다(판독 가능 2장 이상 필요).";
        }
        catch (OperationCanceledException) { return; }   // 페이지 이탈
        catch (Exception ex) { Program.Log("Workspace.PhotoCuration", ex); _montageToast = "⚠ AI 베스트 컷 선별 실패: " + PromptFlowStudio.Services.Pluto.PlutoAutonomousActivityFeedService.Redact(ex.Message); }
        finally { _curationBusy = false; }
        RefreshMontageLook();
        await InvokeAsync(StateHasChanged);
        await RefreshMontagePreviewAsync();
    }

    private bool _curationEditBusy;

    /// <summary>🔁 [채택 교체] — 탈락 후보 → 마지막 컷(클라이맥스) 슬롯 승격.</summary>
    private Task SwapCurationCandidateAsync(int rejectedOriginalIndex)
    {
        if (_curationResult is not { SelectedCuts.Count: > 0 } cur) return Task.CompletedTask;
        return EditCurationAsync(() => Curation.SwapCandidate(cur, cur.SelectedCuts.Count - 1, rejectedOriginalIndex));
    }

    /// <summary>↕ [▲]/[▼] — 선택 컷 순서 이동.</summary>
    private Task MoveCurationCutAsync(int fromIndex, int toIndex)
    {
        if (_curationResult is not { } cur || (uint)toIndex >= (uint)cur.SelectedCuts.Count) return Task.CompletedTask;
        return EditCurationAsync(() => Curation.MoveSelectedCut(cur, fromIndex, toIndex));
    }

    private async Task EditCurationAsync(Func<PromptFlowStudio.Services.Pluto.PlutoBatchCurationResult> edit)
    {
        if (_curationEditBusy || _curationBusy || _montageBusy) return;
        PromptFlowStudio.Services.Pluto.PlutoBatchCurationResult updated;
        try { updated = edit(); }
        catch (ArgumentException ex) { Program.Log("Workspace.CurationEdit", ex); _montageToast = "⚠ 컷 편집 실패: " + PromptFlowStudio.Services.Pluto.PlutoAutonomousActivityFeedService.Redact(ex.Message); return; }
        if (ReferenceEquals(updated, _curationResult)) return;
        _curationEditBusy = true;
        try { await ApplyUpdatedCurationAsync(updated); }
        finally { _curationEditBusy = false; }
        if (!_disposed) await InvokeAsync(StateHasChanged);
    }

    /// <summary>✨ 교체/재배열 공용 후처리 — 몽타주 큐 · 초점 캐시 동기화 → 플랜/프리뷰 재컴파일(BGM 비트 유지) → 3막 자막 갱신.</summary>
    private async Task ApplyUpdatedCurationAsync(PromptFlowStudio.Services.Pluto.PlutoBatchCurationResult updated)
    {
        var cuts = updated.SelectedCuts;
        var photos = new string[cuts.Count];
        var focals = new (double X, double Y)[cuts.Count];
        for (var i = 0; i < photos.Length; i++)
        {
            photos[i] = cuts[i].ImagePath;
            focals[i] = cuts[i].FocalPoint;
        }
        _curationResult = updated;
        _montagePhotos.Clear();
        _montagePhotos.AddRange(photos);
        _stagedFocalPoints = focals;
        _stagedFocalKey = string.Join("|", photos);
        _montageOutput = null;
        RefreshMontageLook();
        StateHasChanged();
        await RefreshMontagePreviewAsync();   // 플랜 · 프리뷰 · 비트 · 3막 자막(템플릿 → AI 승격) 일괄 재구성
    }

