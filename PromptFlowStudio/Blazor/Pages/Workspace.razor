    .ws-dot { font: 700 11px var(--mono); } .ws-dot.ok { color: #10b981; } .ws-dot.off { color: var(--text-muted); }
    .ws-mon-v { font: 700 11px var(--mono); color: var(--text-primary); }

    @@keyframes ws-flow { to { background-position: 200% 0; } }
    @@media (prefers-reduced-motion: reduce) { .ws-bar-f { animation: none; } }

    /* 💡 스토리 레시피 & 인스피레이션 모달 */
    .ws-watch-bar { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin: 4px 0 6px; }
    .ws-mood-bar { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin: 6px 0; }
    .ws-mood-cap { font-size: 11px; opacity: .7; margin-right: 2px; }
    .ws-mood-chip { font-size: 12px; padding: 3px 9px; border-radius: 999px; border: 1px solid rgba(255,255,255,.15); background: rgba(255,255,255,.04); color: inherit; cursor: pointer; }
    .ws-mood-chip small { opacity: .6; }
    .ws-mood-chip.on { border-color: #34d399; background: rgba(52,211,153,.15); }
    .ws-mood-3way { margin-left: auto; font-size: 12px; padding: 4px 12px; border-radius: 8px; border: 1px solid #a78bfa; background: rgba(167,139,250,.14); color: inherit; cursor: pointer; }
    .ws-mood-chip:disabled, .ws-mood-3way:disabled { opacity: .45; cursor: default; }
    .ws-var-tabs { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-bottom: 6px; }
    .ws-var-tab { font-size: 12px; padding: 4px 10px; border-radius: 8px; border: 1px solid rgba(255,255,255,.15); background: rgba(255,255,255,.03); color: inherit; cursor: pointer; text-align: left; }
    .ws-var-tab small { display: block; opacity: .6; font-size: 10px; }
    .ws-var-tab.on { border-color: #a78bfa; background: rgba(167,139,250,.18); }
    .ws-insp-bar { display: flex; justify-content: flex-end; margin-bottom: 6px; }
    .ws-insp-open { font-weight: 700; font-size: 12px; font-family: inherit; padding: 6px 12px; border-radius: 999px; cursor: pointer; color: var(--text-primary); border: 1px solid color-mix(in srgb, var(--flow-violet) 55%, var(--line)); background: linear-gradient(90deg, color-mix(in srgb, var(--flow-violet) 18%, var(--card)), color-mix(in srgb, var(--flow-cyan) 14%, var(--card))); }
    .ws-insp-open:hover:not(:disabled) { border-color: var(--flow-cyan); }
    .ws-insp-open:disabled { opacity: .5; cursor: default; }
    .ws-insp-ov { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,.55); backdrop-filter: blur(3px); animation: ws-insp-in .18s ease-out; }
    .ws-insp-ov.closing { animation: ws-insp-out .18s ease-in forwards; }
    .ws-insp-dlg { width: min(860px, 94vw); max-height: 86vh; overflow: auto; display: flex; flex-direction: column; gap: 10px; padding: 16px 18px; border-radius: 14px; background: var(--card); border: 1px solid var(--line); box-shadow: 0 18px 48px rgba(0,0,0,.45); }
    .ws-insp-h { display: flex; align-items: center; justify-content: space-between; font-size: 15px; font-weight: 900; color: var(--text-primary); }
    .ws-insp-x { background: none; border: none; color: var(--text-muted); font-size: 16px; cursor: pointer; }
    .ws-insp-x:hover { color: var(--text-primary); }
    .ws-insp-tabs { display: flex; gap: 6px; border-bottom: 1px solid var(--line); }
    .ws-insp-tab { background: none; border: none; border-bottom: 2px solid transparent; border-radius: 8px 8px 0 0; padding: 6px 10px; font-weight: 700; font-size: 12.5px; font-family: inherit; color: var(--text-secondary); cursor: pointer; transition: color .15s ease, background .15s ease, box-shadow .15s ease; }
    .ws-insp-tab:hover { color: var(--text-primary); }
    .ws-insp-tab.on { color: var(--text-primary); border-bottom-color: var(--flow-cyan); background: color-mix(in srgb, #6366f1 14%, transparent); box-shadow: 0 0 12px rgba(99, 102, 241, .5); }
    .ws-insp-cats { display: flex; flex-wrap: wrap; gap: 6px; }
    .ws-insp-deck { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 8px; }
    .ws-insp-card { display: flex; flex-direction: column; gap: 3px; text-align: left; padding: 10px; border-radius: 10px; cursor: pointer; background: var(--card-2); border: 1px solid var(--line); color: var(--text-primary); transition: transform .16s ease, border-color .16s ease, box-shadow .16s ease; }
    .ws-insp-card:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--flow-violet) 70%, var(--line)); box-shadow: 0 6px 18px rgba(0,0,0,.22); }
    .ws-insp-card.on { border-color: var(--flow-cyan); box-shadow: 0 0 0 1px var(--flow-cyan) inset; }
    .ws-insp-cat { font: 700 10.5px var(--mono); color: var(--text-muted); }
    .ws-insp-title { font-size: 13.5px; font-weight: 800; }
    .ws-insp-meta { font-size: 11px; line-height: 1.5; color: var(--text-secondary); }
    .ws-insp-empty { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 26px 16px; border-radius: 12px; text-align: center; background: var(--card-2); border: 1px dashed color-mix(in srgb, var(--flow-violet) 45%, var(--line)); }
    .ws-insp-empty-ic { font-size: 34px; line-height: 1; animation: ws-insp-bob 2.4s ease-in-out infinite; }
    .ws-insp-empty-t { font-size: 13.5px; font-weight: 800; color: var(--text-primary); }
    .ws-insp-empty-p { font-size: 12px; line-height: 1.5; color: var(--text-secondary); }
    @@keyframes ws-insp-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
    @@media (prefers-reduced-motion: reduce) { .ws-insp-card, .ws-insp-card:hover { transform: none; transition: none; } .ws-insp-empty-ic { animation: none; } }
    .ws-insp-prev { display: flex; flex-direction: column; gap: 6px; padding: 10px 12px; border-radius: 10px; background: var(--card-2); border: 1px dashed var(--line); }
    .ws-insp-prev-t { font-size: 12px; font-weight: 800; color: var(--text-primary); }
    .ws-insp-prev-p { font-size: 12.5px; line-height: 1.6; color: var(--text-secondary); white-space: pre-wrap; }
    .ws-insp-apply { align-self: flex-end; padding: 7px 14px; border-radius: 8px; border: none; cursor: pointer; font-weight: 800; font-size: 12.5px; font-family: inherit; color: #fff; background: linear-gradient(90deg, var(--flow-violet), var(--flow-cyan)); }
    .ws-insp-apply:disabled { opacity: .45; cursor: default; }
    .ws-insp-save { display: flex; align-items: center; gap: 8px; }
    .ws-insp-save-in { flex: 1; min-width: 0; padding: 6px 10px; border-radius: 8px; border: 1px solid var(--line); background: var(--card-2); color: var(--text-primary); font-family: inherit; font-size: 12.5px; }
    .ws-insp-save-msg { font-size: 11.5px; color: var(--text-secondary); white-space: nowrap; }
    .ws-insp-clip { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .ws-insp-acts { display: flex; justify-content: flex-end; gap: 6px; margin-top: 4px; }
    .ws-insp-del { padding: 7px 12px; border-radius: 8px; cursor: pointer; font-weight: 700; font-size: 12px; font-family: inherit; color: var(--text-secondary); background: none; border: 1px solid var(--line); }
    .ws-insp-del:hover { color: var(--text-primary); border-color: color-mix(in srgb, #ef4444 60%, var(--line)); }
    @@keyframes ws-insp-in { from { opacity: 0; transform: scale(.98); } to { opacity: 1; transform: none; } }
    @@keyframes ws-insp-out { from { opacity: 1; } to { opacity: 0; transform: scale(.98); } }
    @@media (prefers-reduced-motion: reduce) { .ws-insp-ov, .ws-insp-ov.closing { animation: none; } }
</style>

@code {
    private string _prompt = "";

    // 2번 워크플로우: 입력 대본 → StoryboardViewModel 컷 전개 후 스토리보드 화면 전환(빈 대본은 4컷 기본 시놉시스).
    private const string DefaultStorySynopsis = "아침 햇살이 드는 방에서 주인공이 눈을 뜬다.\n창밖을 바라보며 무언가를 결심한다.\n거리로 나서 목적지를 향해 걷는다.\n노을 아래 목적지에 도착해 미소 짓는다.";
    private void SendScriptToStoryboard()
    {
        var script = string.IsNullOrWhiteSpace(_prompt) ? DefaultStorySynopsis : _prompt;
        if (!StoryVm.ReceiveGeneratedScript(script)) StoryVm.ReceiveGeneratedScript(DefaultStorySynopsis);
        Nav.NavigateTo("storyboard");
    }
    // 단일 콘셉트 원클릭 확장: 1번 컷 = 현재 프롬프트, 2~4번 = 기승전결 뼈대, 시드 핀 값(미고정이면 콘셉트 결정적 시드) 계승.
    private void ExpandToStoryboard()
    {
        if (!StoryVm.ExpandFromWorkspace(_prompt, _canvas.EffectiveSeed)) return;
        Nav.NavigateTo("storyboard");
    }
    private bool _milestoneBusy;
    private PromptFlowStudio.Services.Pluto.PlutoMilestonePlan? _milestoneLive;   // 🌊 스트리밍 중 최신 스냅샷(도착 슬롯 표시)
    /// <summary>🎞 4컷 성장 마일스톤 프리셋 — 오케스트레이터(Gemini → 로컬 게이트웨이 → 템플릿) 결과를 스토리보드 4슬롯에 일괄 적용(프롬프트·카메라·구간). 작업실 프롬프트는 부모 메모로 전달.</summary>
    private async Task ApplyMilestonePresetAsync(string milestoneKey)
    {
        if (_milestoneBusy) return;
        _milestoneBusy = true;
        _milestoneLive = null;
        StateHasChanged();
        PromptFlowStudio.Services.Pluto.PlutoMilestonePlan? plan = null;
        var painted = false;
        try
        {
            var orch = EcoSp.GetService(typeof(PromptFlowStudio.Services.Pluto.PlutoMilestoneOrchestrator)) as PromptFlowStudio.Services.Pluto.PlutoMilestoneOrchestrator;
            if (orch is not null)
            {
                // 🌊 템플릿 4컷 선페인트 → LLM 씬이 스트림에서 닫힐 때마다 해당 슬롯 즉시 재페인트(2~4컷 생성 중에도 1컷 반영)
                await foreach (var snap in orch.OrchestrateFourCutPlanStreamAsync(milestoneKey, _prompt, _mediaCts.Token))
                {
                    if (_disposed) return;
                    plan = snap;
                    _milestoneLive = snap;
                    painted = StoryVm.ApplyDirectorShots(snap.ToDirectorShots(), snap.MilestoneName);
                    StateHasChanged();
                }
            }
        }
        catch (OperationCanceledException) { return; }   // 페이지 이탈
        catch (Exception ex) { Program.Log("Workspace.PlutoMilestone", ex); }   // [부분 구제] 이미 페인트된 스냅샷 유지
        finally { _milestoneBusy = false; _milestoneLive = null; }
        if (_disposed) return;
        if (plan is null)
        {
            plan = PromptFlowStudio.Services.Pluto.PlutoMilestoneOrchestrator.BuildLocal(PromptFlowStudio.Services.Pluto.PlutoMilestoneOrchestrator.ParseTheme(milestoneKey), _identity?.GetConsistencyAnchor(), _identity?.IsPet == true, _prompt);
            painted = StoryVm.ApplyDirectorShots(plan.ToDirectorShots(), plan.MilestoneName);
        }
        if (painted) Nav.NavigateTo("storyboard");
        else StateHasChanged();
    }

    private bool _visionStoryBusy;
    private string? _visionStoryToast;
    private string? _visionSubtitle;   // 📸 사진 스토리 감성 자막 초안(💌 편지 자막 생성 입력 우선)

    /// <summary>📸 사진 선택/드롭 → 참조 이미지(i2v)로 저장 후 15초 3막 스토리 합성.</summary>
    private async Task OnVisionStoryPickedAsync(InputFileChangeEventArgs e)
    {
        if (_visionStoryBusy) return;
        if (await SaveUploadAsync(e.File, keepName: true) is not { } savePath) return;
        _imagePath = savePath;
        _imageName = e.File.Name;
        _imagePreview = Media.ToPlaybackUrl(savePath);
        await RunVisionStoryAsync(savePath);
    }

    /// <summary>
    /// 📸 Vision-to-Story — 합성기(Gemini Vision → 로컬 게이트웨이 → 규칙 분석) 결과를 스토리보드 4컷에 일괄 적용 +
    /// 추천 BGM 트랙 ON · 감성 자막 초안/자막 번인 ON. 빈 작업실 프롬프트는 클라이맥스(사진 속 순간) 컷으로 채움. 화면 유지(설정 보존).
    /// </summary>
    private async Task RunVisionStoryAsync(string? imagePath)
    {
        if (_visionStoryBusy || string.IsNullOrWhiteSpace(imagePath)) return;
        _visionStoryBusy = true;
        _visionStoryToast = null;
        StateHasChanged();
        PromptFlowStudio.Services.Pluto.PlutoVisionStoryPlan plan;
        try
        {
            var synth = EcoSp.GetService(typeof(PromptFlowStudio.Services.Pluto.PlutoVisionStorySynthesizer)) as PromptFlowStudio.Services.Pluto.PlutoVisionStorySynthesizer
                        ?? new PromptFlowStudio.Services.Pluto.PlutoVisionStorySynthesizer(null, null, IdentityVault, PlutoDirector);
            plan = await synth.SynthesizeFromImageAsync(imagePath, _prompt, _mediaCts.Token);
        }
        catch (OperationCanceledException) { _visionStoryBusy = false; return; }   // 페이지 이탈
        catch (Exception ex)
        {
            Program.Log("Workspace.PlutoVisionStory", ex);   // [부분 구제] 규칙 분석 플랜
            var attrs = PromptFlowStudio.Services.Pluto.PlutoVisionStorySynthesizer.AnalyzeHeuristic(imagePath, default, _prompt, _identity?.IsPet == true);
            plan = PromptFlowStudio.Services.Pluto.PlutoVisionStorySynthesizer.ApplyOptics(
                PromptFlowStudio.Services.Pluto.PlutoVisionStorySynthesizer.BuildLocal(attrs, _identity?.GetConsistencyAnchor(), _prompt), PlutoDirector.GetCurrentTier());
        }
        _visionStoryBusy = false;
        if (_disposed) return;
        _motionImage = imagePath;            // 🎥 1-Click 모션 렌더 입력(사진 + 4막 궤적)
        _motionPath = plan.MotionPath;
        _motionImageUrl = Media.ToPlaybackUrl(imagePath);   // 🎞 실시간 프리뷰 입력
        _motionToast = null;
        _motionOutput = null;
        var applied = StoryVm.ApplyDirectorShots(plan.ToDirectorShots(), plan.DetectedMood);
        if (applied)
        {
            _bgmTrack = plan.SuggestedBgmTrack;
            _bgmOn = true;
            _visionSubtitle = plan.SuggestedSubtitle;
            _letterSubs = true;
            if (string.IsNullOrWhiteSpace(_prompt) && plan.StoryboardScenes.Count > 2) _prompt = plan.StoryboardScenes[2].Prompt;   // 사진 속 클라이맥스
            _visionStoryToast = "📸 " + plan.DetectedMood + " · " + plan.DetectedSetting + " → 4컷 완성 · 🎵 " + plan.SuggestedBgmTheme + " · 💬 " + plan.SuggestedSubtitle;
        }
        else _visionStoryToast = "📸 스토리 구성에 실패했습니다 — 다른 사진으로 다시 시도해 주세요.";
        RefreshMotionPreviewSubs();      // 🎞 프리뷰 자막 · BGM 초기화
        _ = RefreshMotionBgmAsync();
        StateHasChanged();
    }

    private string? _motionImage;      // 🎥 모션 렌더 원본 사진
    private PromptFlowStudio.Services.Pluto.PlutoMotionTrajectory? _motionPath;
    private bool _motionBusy;
    private string? _motionToast;
    private string? _motionOutput;     // 렌더 완료 MP4 절대 경로(📂 위치 열기)
    private string? _motionImageUrl;   // 🎞 프리뷰 캔버스 원본(가상호스트 URL)
    private string? _motionBgmUrl;     // 🎞 프리뷰 BGM WAV(가상호스트 URL · 없으면 SFX 만)
    private PromptFlowStudio.Services.Pluto.PlutoSubtitleScript? _motionSubs;   // 🎞 프리뷰 3막 자막(로컬 결정론 초안)
    private int _motionBgmSeq;
    private PromptFlowStudio.Services.Pluto.PlutoBeatSyncedPreview? _motionBeatSync;      // 🥁 프리뷰 BGM 비트 스냅 결과
    private PromptFlowStudio.Services.Pluto.PlutoMotionTrajectory? _motionBeatBase;     // 스냅 계산 기준 궤적(교체 시 무효)
    private int _motionBeatSeq;

    /// <summary>🥁 유효 비트 싱크(BGM ON · 현 궤적 기준 · 폴백 아님) — 아니면 null.</summary>
    private PromptFlowStudio.Services.Pluto.PlutoBeatSyncedPreview? MotionBeatSync
        => (_bgmOn || _customBgm is not null) && _motionBeatSync is { Applied: true } b && ReferenceEquals(_motionBeatBase, _motionPath) ? b : null;

    /// <summary>🎞 프리뷰 궤적 — 비트 스냅 궤적(익스포터와 동일 규칙) · 없으면 원본.</summary>
    private PromptFlowStudio.Services.Pluto.PlutoMotionTrajectory? MotionPreviewPath => MotionBeatSync?.Trajectory ?? _motionPath;

    /// <summary>🥁 BGM WAV → 비트 검출 → 막 경계 · SFX 큐 스냅(백그라운드 · 세대 가드 · 미리보기 전용 — 예외 전파 금지).</summary>
    private async Task RefreshMotionBeatSyncAsync(string? wav)
    {
        var seq = ++_motionBeatSeq;
        var basePath = _motionPath;
        PromptFlowStudio.Services.Pluto.PlutoBeatSyncedPreview? r = null;
        try
        {
            if (basePath is not null && _customBgm is { RelativeBeatTimestampsSec.Count: > 0 } hl)
            {
                var q = BeatQuantizer;   // 🎵 커스텀 하이라이트 비트 우선
                r = await Task.Run(() => PromptFlowStudio.Services.Pluto.PlutoMotionCompiler.BuildBeatSyncedPreview(basePath, hl.RelativeBeatTimestampsSec, hl.DetectedBpm, q));
            }
            else if (wav is not null && basePath is not null)
            {
                var q = BeatQuantizer;
                r = await Task.Run(() => PromptFlowStudio.Services.Pluto.PlutoMotionCompiler.BuildBeatSyncedPreview(basePath, File.ReadAllBytes(wav), null, q));
            }
        }
        catch (Exception ex) { Program.Log("Workspace.MotionBeatSync", ex); r = null; }
        if (_disposed || seq != _motionBeatSeq) return;
        _motionBeatSync = r;
        _motionBeatBase = basePath;
        try { await InvokeAsync(StateHasChanged); }
        catch (Exception ex) when (ex is ObjectDisposedException or InvalidOperationException) { }
    }

    private const double MotionPreviewBgmVolume = PromptFlowStudio.Services.Export.StockSuiteExporter.BabyBgmVolume;   // 내보내기 믹스와 동일 볼륨

    /// <summary>🎞 프리뷰 자막 갱신 — 프롬프트/사진 스토리 초안 → 로컬 결정론 3막(LLM 호출 없음 · 타이핑마다 호출 가능).</summary>
    private void RefreshMotionPreviewSubs()
    {
        if (_motionImage is null) return;
        try
        {
            var src = string.IsNullOrWhiteSpace(_visionSubtitle) ? _prompt : _visionSubtitle + ", " + _prompt;
            _motionSubs = PromptFlowStudio.Services.Pluto.PlutoSubtitleDirector.GenerateLocal(src, _identity?.SubjectName, PromptFlowStudio.Services.Pluto.PlutoSubtitleDirector.ResolveDomain(src, _babyExplicit));
        }
        catch (Exception ex) { Program.Log("Workspace.MotionPreviewSubs", ex); }
    }

    /// <summary>🎞 프리뷰 BGM URL 갱신(선택 트랙 WAV 보장 → 가상호스트 URL). 미리보기 전용 — 예외 전파 금지.</summary>
    private async Task RefreshMotionBgmAsync()
    {
        var seq = ++_motionBgmSeq;
        try
        {
            string? url = null, wav = null;
            if (_bgmOn)
            {
                var track = _bgmTrack;
                var dir = Path.Combine(Media.MediaRoot, "bgm");
                wav = await Task.Run(() => PromptFlowStudio.Services.Export.StockSuiteExporter.EnsureBabyBgm(track, 30, dir));
                url = wav is null ? null : Media.ToPlaybackUrl(wav);
            }
            if (_disposed || seq != _motionBgmSeq) return;
            _motionBgmUrl = url;
            _ = RefreshMotionBeatSyncAsync(wav);   // 🥁 비트 스냅 궤적 · SFX 큐
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) { Program.Log("Workspace.MotionPreviewBgm", ex); }
    }

    /// <summary>🎬 디렉터 랭크 변경 → 프리뷰 궤적/자막 상태 재평가(재생 유지 핫스왑).</summary>
    private void OnDirectorRankChanged()
    {
        if (_disposed || _motionImage is null) return;
        try { _ = InvokeAsync(() => { if (_disposed) return; RefreshMotionPreviewSubs(); StateHasChanged(); }); }
        catch (Exception ex) when (ex is ObjectDisposedException or InvalidOperationException) { Program.Log("Workspace.MotionPreviewRank", ex); }
    }

    /// <summary>
