            var fit = LocaleFit();
            _localeTranslateToast = result.MessageKorean + (fit is { } f && f.UsedTranslationTrack ? " · 🎙️ " + f.SpeakingRate.ToString("0.00", CultureInfo.InvariantCulture) + "x" : "");
        }
