            if (localeRender.WarningKorean.Length > 0) _montageToast += " · " + localeRender.WarningKorean;
        }
        catch (OperationCanceledException) { }   // 페이지 이탈
        catch (Exception ex) { Program.Log("Workspace.MontageVideo", ex); _montageToast = "⚠ 몽타주 렌더 실패: " + PromptFlowStudio.Services.Pluto.PlutoAutonomousActivityFeedService.Redact(ex.Message); }
        finally { _montageBusy = false; _stockBusy = false; }
        if (_disposed) return;
        await InvokeAsync(StateHasChanged);
