    private static string ShortId(string id) => id.Length <= 14 ? id : id.Substring(0, 6) + "…" + id.Substring(id.Length - 6);
    private static string Summary(string? p) => string.IsNullOrEmpty(p) ? "" : p.Length <= 48 ? p : p.Substring(0, 48) + "…";
    private static string JournalStatusClass(string s) => s switch
    {
        PromptFlowStudio.Services.Render.TaskJournalService.StatusUserCanceled => "cancel",
        PromptFlowStudio.Services.Render.TaskJournalService.StatusFailed => "fail",
        _ => "proc",
    };

    private async Task RecoverJournalAsync(string taskId)
    {
        if (_jBusy) return;
        _jBusy = true; _jMsg = "⏳ 회수 중…";
        try
        {
            var r = await Journal.RecoverTaskAsync(taskId, _mediaCts.Token);
            _jMsg = r.Recovered > 0 ? "✅ 회수 완료 — " + r.RecoveredPaths[0]
                : r.Dropped > 0 ? "⚠ 원격 작업 실패/만료 — 저널에서 제거됨"
                : r.Scanned == 0 ? "⚠ 다른 복구 진행 중이거나 조회 서비스 미구성"
                : "⏳ 원격 작업 진행 중 — 잠시 후 다시 시도하세요";
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Program.Log("Workspace.Journal.Recover", ex); _jMsg = "⚠ 회수 실패: " + ex.Message; }
        finally { _jBusy = false; ReloadJournal(); }
    }

    private async Task RetryJournalAsync(string taskId)
    {
        if (_jBusy) return;
        _jBusy = true;
        try
        {
            Journal.Retry(taskId);
            _jMsg = "🔁 자동 회수 대상으로 복귀 — 회수 시도 중";
            ReloadJournal();
            var r = await Journal.RecoverAsync(_mediaCts.Token);
            if (r.Recovered > 0) _jMsg = "✅ 재시도 회수 " + r.Recovered.ToString(CultureInfo.InvariantCulture) + "건 완료";
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Program.Log("Workspace.Journal.Retry", ex); _jMsg = "⚠ 재시도 실패: " + ex.Message; }
        finally { _jBusy = false; ReloadJournal(); }
    }

    private void PurgeJournal(string taskId)
    {
        try { if (Journal.Purge(taskId)) _jMsg = "🗑 저널에서 삭제됨"; }
        catch (Exception ex) { Program.Log("Workspace.Journal.Purge", ex); }
        ReloadJournal();
    }

    private void PurgeAllJournal()
    {
        try { _jMsg = "🧹 " + Journal.PurgeAll().ToString(CultureInfo.InvariantCulture) + "건 삭제"; }
        catch (Exception ex) { Program.Log("Workspace.Journal.PurgeAll", ex); }
        ReloadJournal();
    }

    private void OnRetryAttempt(int current, int max, TimeSpan delay)
    {
        try
        {
            _retryMsg = "⏳ API 일시 지연으로 재시도 중 (" + current.ToString(CultureInfo.InvariantCulture) + "/" + max.ToString(CultureInfo.InvariantCulture) + ")...";
            var seq = Interlocked.Increment(ref _retrySeq);
            _ = InvokeAsync(StateHasChanged);
            _ = ClearRetryLaterAsync(seq, delay + TimeSpan.FromSeconds(3));
        }
        catch (Exception ex) { Program.Log("Workspace.RetryNotice", ex); }
    }

    private async Task ClearRetryLaterAsync(int seq, TimeSpan after)
    {
        try
        {
            await Task.Delay(after, _mediaCts.Token);
            if (Volatile.Read(ref _retrySeq) != seq) return;   // 후속 재시도 알림 유지
            _retryMsg = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (Exception ex) { Program.Log("Workspace.RetryClear", ex); }
    }

    private void OnIpcTicker(PromptFlowStudio.Services.ProcessBridge.StockSuiteIpcMessage m)
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                var ticker = m.Ticker ?? "";
                PromptFlowStudio.Services.Export.WatchlistStock? st = null;
                for (var i = 0; i < _watch.Stocks.Count; i++)
                    if (string.Equals(_watch.Stocks[i].Ticker, ticker, StringComparison.OrdinalIgnoreCase)) { st = _watch.Stocks[i]; break; }
                st ??= new PromptFlowStudio.Services.Export.WatchlistStock(ticker, string.IsNullOrWhiteSpace(m.Name) ? ticker : m.Name!, m.Sector ?? "");
                if (!State.IsBusy) await GenerateTickerPromptAsync(st);
                StateHasChanged();
            }
            catch (Exception ex) { Program.Log("Workspace.IpcTicker", ex); }
        });
