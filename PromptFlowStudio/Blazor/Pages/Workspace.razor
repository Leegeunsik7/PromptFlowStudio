    private async Task RunYouTubeStudioImportAsync(byte[] bytes, string fileName)
    {
        if (EcoSp.GetService(typeof(PromptFlowStudio.Services.Pluto.IPlutoTelemetryBatchImporter)) is not PromptFlowStudio.Services.Pluto.IPlutoTelemetryBatchImporter importer)
        { _batchToast = "⚠ 일괄 반영 서비스를 사용할 수 없습니다."; return; }
        _batchBusy = true;
        _batchToast = null;
        StateHasChanged();
        try
        {
            var ct = _mediaCts.Token;
            var platform = _perfPlatform;
            var r = _ytWatcher is { } watcher   // 🔒 Step 23 — 백그라운드 감시기와 같은 게이트 · 해시 장부 공유(이중 반영/재토스트 차단)
                ? await watcher.RunExclusiveImportAsync(bytes, fileName, c => importer.ImportYouTubeStudioFileAsync(bytes, fileName, platform, c), ct)
                : await importer.ImportYouTubeStudioFileAsync(bytes, fileName, platform, ct);
            var toast = "📊 " + fileName + " · " + (r.TotalRows == 0 && r.SkippedNoiseCount == 0 ? "⚠ 인식된 성과 행이 없습니다." : r.SummaryKorean);
            if (r.UnmatchedIdentifiers.Count > 0)
            {
                var n = Math.Min(5, r.UnmatchedIdentifiers.Count);
                var sb = new System.Text.StringBuilder(" · 미매칭: ");
                for (var i = 0; i < n; i++) { if (i > 0) sb.Append(", "); sb.Append(r.UnmatchedIdentifiers[i]); }
                if (r.UnmatchedIdentifiers.Count > n) sb.Append(" 외 ").Append((r.UnmatchedIdentifiers.Count - n).ToString(CultureInfo.InvariantCulture)).Append("건");
                toast += sb.ToString();
            }
            _batchToast = toast;
            await RefreshCatalogClipsAsync();
            await RefreshAdaptiveRecommendationAsync();   // 🧠 폐루프 → 순방향 랭킹
            await RefreshBrainSummaryAsync();   // 🧠 두뇌 리포트 갱신
        }
        catch (OperationCanceledException) { return; }   // 페이지 이탈
        catch (InvalidDataException ex) { _batchToast = "⚠ " + PromptFlowStudio.Services.Pluto.PlutoAutonomousActivityFeedService.Redact(ex.Message); }
        catch (Exception ex) { Program.Log("Workspace.YouTubeStudioImport", ex); _batchToast = "⚠ YouTube Studio 반영 실패: " + PromptFlowStudio.Services.Pluto.PlutoAutonomousActivityFeedService.Redact(ex.Message); }
        finally { _batchBusy = false; }
        if (_disposed) return;
        await InvokeAsync(StateHasChanged);
    }

