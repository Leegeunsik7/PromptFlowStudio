    /// <summary>대사 TTS → 오케스트레이터(원격 API → LatentSync → FFmpeg 프레임 보정) · 결과는 별도 파일(원본 유지).</summary>
    private async Task RealignLipSyncAsync()
    {
        if (_lipBusy || State.LocalPath is not { } src || string.IsNullOrWhiteSpace(_lipText)) return;
        _lipBusy = true;
        _lipUrl = null;
        _lipMsg = "🎙️ 나레이션 합성 중…";
        try
        {
            var ct = _mediaCts.Token;
            var audio = await Tts.SynthesizeAsync(_lipText, NarrationTone.FairyTale, 1.0, TtsProvider.Auto, ct);
            if (audio is null) { _lipMsg = "⚠ 나레이션 합성 실패(TTS 엔진/네트워크 확인)"; return; }
            var dir = Path.GetDirectoryName(src) ?? Media.MediaRoot;
            var output = Path.Combine(dir, Path.GetFileNameWithoutExtension(src) + "_lipsync.mp4");
            var status = new Progress<string>(s => { _lipMsg = s; _ = InvokeAsync(StateHasChanged); });
            var r = await LipAi.SyncAsync(new AudioLipSyncRequest(src, audio, output, _lipText + " " + (_prompt ?? ""), _emotion, _emotionIntensity), status, ct);
            if (r.Ok && r.OutputPath is not null)
            {
                _lipUrl = Media.ToPlaybackUrl(r.OutputPath) + "?v=" + DateTime.Now.Ticks.ToString(CultureInfo.InvariantCulture);
                _lipMsg = "✅ " + r.Message + " · 음소 " + r.Visemes.Count.ToString(CultureInfo.InvariantCulture) + "구간";
            }
            else _lipMsg = "⚠ " + r.Message;
        }
        catch (OperationCanceledException) { _lipMsg = "취소됨"; }
        catch (Exception ex) { Program.Log("Workspace.LipSync", ex); _lipMsg = "⚠ 립싱크 실패: " + ex.Message; }
        finally { _lipBusy = false; }
    }
