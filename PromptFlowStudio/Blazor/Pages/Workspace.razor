                    {
                        @foreach (var reason in PromptFlowStudio.Services.AI.PlutoVideoLearningMemoryService.AllReasons)
                        {
                            var rr = reason;
                            <button class="ws-pf-btn ws-learn-reason" @onclick="() => LearnNegativeAsync(rr)" disabled="@_learnBusy" data-pluto-reason="@rr">@PromptFlowStudio.Services.AI.PlutoVideoLearningMemoryService.ReasonLabel(rr)</button>
                        }
                        <label class="ws-learn-auto"><input type="checkbox" @bind="_learnAutoRerender" /> 즉시 재생성</label>
                    }
                    @if (_learnMsg is not null) { <span class="ws-learn-msg" role="status">@_learnMsg</span> }
                </div>
            }
            <div class="ws-learn-fb" role="group" aria-label="플루토 학습 상태" data-pluto-learn-status="1">
                <span class="ws-learn-ind" title="플루토 자기학습 디렉터 메모리(👍 레시피 · 👎/🩺 회피 규칙)">🧠 @PlutoLearn.ToString()</span>
                <button class="ws-pf-btn" @onclick="ImportGalleryLearningAsync" disabled="@_galleryImportBusy" data-pluto-gallery-import="1"
                        title="저장된 갤러리 영상의 메타(.meta.json) 프롬프트를 긍정 기준선 레시피로 흡수합니다 — 프롬프트 해시로 중복 제거(여러 번 눌러도 안전)">@(_galleryImportBusy ? "⏳ 흡수 중…" : "📥 기존 갤러리 학습 흡수")</button>
                @if (_galleryImportMsg is not null) { <span class="ws-learn-msg" role="status">@_galleryImportMsg</span> }
            </div>
            @if (_htsHud)
            {
