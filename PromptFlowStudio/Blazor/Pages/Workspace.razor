    private async Task<bool> FadeOutInspirationAsync()
    {
        if (_inspClosing) return false;
        _inspClosing = true;
        StateHasChanged();
        try { await Task.Delay(180, _mediaCts.Token); }
        catch (OperationCanceledException) { return false; }
        finally { _inspClosing = false; }
        return true;
    }

