    .ws-enc-badge { font-weight: 700; padding: 1px 6px; border-radius: 6px; } .ws-enc-badge.hw { color: #4ade80; background: rgba(74, 222, 128, .12); } .ws-enc-badge.cpu { color: #f59e0b; background: rgba(245, 158, 11, .12); }
    .ws-hts-wrap > .ws-video { display: block; }
    /* 🎞️ 듀얼 버퍼 크로스디졸브 — 그리드 단일 셀 겹침(컨테이너 높이 = 큰 레이어), 활성 z2/대기 z1 */
    .ws-xd { display: grid; position: relative; width: 100%; border-radius: 12px; overflow: hidden; background: #000; }
    .ws-xd > video { grid-area: 1 / 1; width: 100%; height: 100%; display: block; object-fit: contain; background: #000; }
    .ws-xd > canvas { grid-area: 1 / 1; width: 100%; height: 100%; object-fit: contain; }
