@page "/queue"
@implements IDisposable
@using System.Globalization
@using PromptFlowStudio.Services.Batch
@inject WanJobState WanJob
@inject StoryboardJobManager Jobs
@inject NavigationManager Nav
@inject PromptFlowStudio.ViewModels.RenderQueueViewModel Vm

@* [PromptFlow Studio] 렌더링 큐 — 대량 양산 렌더 큐(RenderQueueViewModel)·단일 컷(WanJobState)·스토리보드 배치(StoryboardJobManager)의 진행을 대형 뷰어로 관찰. *@

<PageTitle>PromptFlow Studio · 렌더링 큐</PageTitle>

<div class="q">
    <header class="q-head">
        <h1 class="q-title">렌더링 <span class="q-title-g">큐</span> <MenuHelpBadge MenuKey="@GranularHelpService.Keys.RenderQueue" /></h1>
        <p class="q-sub">백그라운드에서 진행 중인 생성·병합 작업을 실시간으로 모니터링합니다.</p>
    </header>

    <div style="margin:12px 0;"><StudioMonitorHeader EngineReady="true" /></div>
    <div style="margin:0 0 16px;"><ResourceMonitor /></div>

    @* ── 대량 양산 렌더 큐 요약 HUD ── *@
    <section class="q-hud">
        <div class="q-hud-c pend"><span class="q-hud-l">대기 중</span><b>@(Vm.PendingCount.ToString(CultureInfo.InvariantCulture))</b></div>
        <div class="q-hud-c proc"><span class="q-hud-l">렌더 중</span><b>@(Vm.ProcessingCount.ToString(CultureInfo.InvariantCulture))</b></div>
        <div class="q-hud-c done"><span class="q-hud-l">완료</span><b>@(Vm.CompletedCount.ToString(CultureInfo.InvariantCulture))</b></div>
        <div class="q-hud-c fail"><span class="q-hud-l">실패</span><b>@(Vm.FailedCount.ToString(CultureInfo.InvariantCulture))</b></div>
        <div class="q-hud-c eng"><span class="q-hud-l">실행 엔진</span><span class="q-eng @EngineCls(Vm.ActiveEngineKind)">@(Vm.ActiveEngineKind ?? "대기")</span></div>
        <div class="q-hud-a">
            <button class="q-btn ghost" @onclick="Vm.TogglePause">@(Vm.IsPaused ? "▶ 큐 재개" : "⏸ 큐 일시정지")</button>
            <button class="q-btn ghost" disabled="@(Vm.CompletedCount == 0)" @onclick="Vm.ClearCompleted">🧹 완료 항목 정리</button>
        </div>
    </section>

    @if (Vm.TotalJobsCount > 0)
    {
        <section class="q-card">
            <div class="q-card-h">
                <span>🏭 대량 양산 렌더 큐 <span class="q-dim">— 총 @(Vm.TotalJobsCount.ToString(CultureInfo.InvariantCulture))건</span></span>
                @if (Vm.ActiveJob is { } act) { <span class="q-badge run">렌더 중 · @(Trunc(act.Prompt))@(act.EngineKind is null ? "" : " · " + act.EngineKind)</span> }
                else if (Vm.IsPaused) { <span class="q-badge">일시정지</span> }
            </div>
            <table class="q-tbl">
                <thead><tr><th>#</th><th>프롬프트</th><th>시드</th><th>해상도</th><th>길이</th><th>엔진</th><th>상태</th><th>진행률</th><th></th></tr></thead>
                <tbody>
                    @for (var i = 0; i < Vm.Jobs.Count; i++)
                    {
                        var job = Vm.Jobs[i];
                        var no = i + 1;
                        <tr @key="job.JobId">
                            <td class="q-mono">@(no.ToString(CultureInfo.InvariantCulture))</td>
                            <td class="q-tbl-p" title="@job.Prompt">@(Trunc(job.Prompt))</td>
                            <td class="q-mono">@(job.Seed.ToString(CultureInfo.InvariantCulture))</td>
                            <td class="q-mono">@job.Resolution</td>
                            <td class="q-mono">@(job.DurationSec.ToString("0.#", CultureInfo.InvariantCulture))s</td>
                            <td>@if (job.EngineKind is { } ek) { <span class="q-eng @EngineCls(ek)">@ek</span> } else { <span class="q-dim">—</span> }</td>
                            <td><span class="q-st @JobCls(job.Status)" tabindex="@(job.Status == BatchJobStatus.Failed && !string.IsNullOrEmpty(job.ErrorMessage) ? "0" : null)" aria-label="@(job.Status == BatchJobStatus.Failed && !string.IsNullOrEmpty(job.ErrorMessage) ? job.ErrorMessage : null)" data-tip="@(job.Status == BatchJobStatus.Failed && !string.IsNullOrEmpty(job.ErrorMessage) ? job.ErrorMessage : null)">@JobLabel(job.Status)@(job.Status == BatchJobStatus.Failed && !string.IsNullOrEmpty(job.ErrorMessage) ? " ⓘ" : "")</span></td>
                            <td>
                                <div class="q-scene-bar"><div class="q-scene-bar-f" style="width:@(job.ProgressPercent.ToString(CultureInfo.InvariantCulture))%"></div></div>
                                <span class="q-mono q-pct">@(job.ProgressPercent.ToString(CultureInfo.InvariantCulture))%</span>
                            </td>
                            <td class="q-tbl-a">
                                @if (job.Status is BatchJobStatus.Queued or BatchJobStatus.Processing)
                                {
                                    <button class="q-ic" title="취소" @onclick="() => Vm.Cancel(job.JobId)">✕</button>
                                }
                                else if (job.Status is BatchJobStatus.Failed or BatchJobStatus.Cancelled)
                                {
                                    <button class="q-ic" title="재시도(오류 초기화 후 재큐잉)" @onclick="() => Vm.Retry(job.JobId)">↺</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (Vm.LastErrorMessage is { } lastErr)
            {
                <div class="q-err" title="@lastErr">⚠ 최근 렌더 실패 — @lastErr</div>
            }
        </section>
    }

    @if (!AnyActive)
    {
        <div class="q-empty">
            <div class="q-empty-ic">💤</div>
            <div class="q-empty-t">진행 중인 렌더링 작업이 없습니다</div>
            <div class="q-empty-a">
                <button class="q-btn go" @onclick='() => Nav.NavigateTo("workspace")'>＋ 단일 컷 생성</button>
                <button class="q-btn ghost" @onclick='() => Nav.NavigateTo("storyboard")'>🎬 스토리보드</button>
            </div>
        </div>
    }

    @* ── 단일 컷 작업 ── *@
    @if (WanJob.Phase != WanJobPhase.Idle)
    {
        <section class="q-card">
            <div class="q-card-h"><span>🎨 단일 컷 생성</span><span class="q-badge @WanCls">@WanLabel</span></div>
            <div class="q-bignum">@WanJob.Percent<span>%</span></div>
            <div class="q-bar"><div class="q-bar-f" style="width:@(WanJob.Percent)%"></div></div>
            <div class="q-line"><span class="q-line-t">@WanJob.StatusText</span><span class="q-line-m">경과 @($"{WanJob.Elapsed.TotalSeconds:0}")초 @(WanJob.TaskId is { } tid ? $"· task {Short(tid)}" : "")</span></div>
            @if (WanJob.Phase == WanJobPhase.Completed && WanJob.VideoUrl is not null)
            {
                <video class="q-vid" src="@WanJob.VideoUrl" controls muted loop preload="metadata"></video>
            }
        </section>
    }

    @* ── 스토리보드 배치 ── *@
    @if (Jobs.Current is { } proj && proj.Scenes.Count > 0)
    {
        <section class="q-card">
            <div class="q-card-h">
                <span>🎞️ 스토리보드 배치 <span class="q-dim">— @proj.Title</span></span>
                <span class="q-badge @(Jobs.IsRunning || Jobs.IsMerging ? "run" : "idle")">@(Jobs.IsMerging ? "병합 중" : Jobs.IsRunning ? "생성 중" : "대기/완료")</span>
            </div>
            <div class="q-bignum">@Jobs.OverallPercent<span>%</span></div>
            <div class="q-bar"><div class="q-bar-f" style="width:@(Jobs.OverallPercent)%"></div></div>
            <div class="q-line">
                <span class="q-line-t"><b>@Jobs.CompletedCount</b> / @proj.Scenes.Count 완료 @(Jobs.FailedCount > 0 ? $"· 실패 {Jobs.FailedCount}" : "")</span>
                @if (Jobs.IsMerging) { <span class="q-line-m">병합 @Jobs.MergePercent%</span> }
            </div>

            <div class="q-scenes">
                @foreach (var (s, i) in proj.Scenes.Select((s, idx) => (s, idx)))
                {
                    <div class="q-scene @SceneCls(s.Status)" @key="s.Id">
                        <span class="q-scene-no">@(i + 1)</span>
                        <div class="q-scene-mid">
                            <div class="q-scene-t">@(string.IsNullOrWhiteSpace(s.Prompt) ? (s.IsI2v ? "(이미지 컷)" : "(빈 프롬프트)") : Trunc(s.Prompt))</div>
                            <div class="q-scene-bar"><div class="q-scene-bar-f" style="width:@(s.IsTerminal ? 100 : s.Percent)%"></div></div>
                        </div>
                        <span class="q-badge sm @SceneCls(s.Status)">@SceneLabel(s.Status)</span>
                    </div>
                }
            </div>

            @if (Jobs.MergeMessage is not null) { <div class="q-merge">@Jobs.MergeMessage</div> }
        </section>
    }
</div>

<style>
    .q { padding: 6px 8px 48px; width: 100%; box-sizing: border-box; }
    .q-head { margin-bottom: 18px; }
    .q-title { font-size: 26px; font-weight: 900; letter-spacing: -.4px; color: var(--text-primary); margin: 0 0 6px; }
    .q-title-g { background: linear-gradient(90deg, var(--flow-cyan), var(--flow-violet)); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .q-sub { font-size: 13.5px; color: var(--text-secondary); margin: 0; }

    .q-empty { text-align: center; padding: 60px 20px; border: 1px dashed var(--line); border-radius: 18px; background: var(--card); }
    .q-empty-ic { font-size: 48px; opacity: .5; }
    .q-empty-t { font-size: 16px; font-weight: 800; color: var(--text-primary); margin: 10px 0 16px; }
    .q-empty-a { display: flex; gap: 10px; justify-content: center; }

    .q-card { border: 1px solid var(--line); border-radius: 18px; background: var(--card); padding: 18px 20px; margin-bottom: 16px; }
    .q-card-h { display: flex; align-items: center; justify-content: space-between; font-size: 14px; font-weight: 800; color: var(--text-primary); margin-bottom: 10px; }
    .q-dim { color: var(--text-muted); font-weight: 600; }
    .q-bignum { font-size: 40px; font-weight: 900; color: var(--text-primary); line-height: 1; letter-spacing: -1px; }
    .q-bignum span { font-size: 18px; color: var(--text-muted); margin-left: 3px; }
    .q-bar { height: 12px; border-radius: 999px; background: var(--card-2); border: 1px solid var(--line); overflow: hidden; margin: 10px 0; }
    .q-bar-f { height: 100%; border-radius: 999px; transition: width .5s ease; background: linear-gradient(90deg, var(--flow-violet), var(--flow-cyan), var(--flow-magenta)); background-size: 200% 100%; animation: q-flow 2.4s linear infinite; }
    .q-line { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .q-line-t { font-size: 13px; color: var(--text-secondary); } .q-line-t b { color: var(--text-primary); }
    .q-line-m { font: 600 11.5px var(--mono); color: var(--text-muted); }
    .q-vid { width: 100%; max-width: 420px; border-radius: 11px; background: #000; border: 1px solid var(--line); margin-top: 12px; }

    .q-badge { font: 700 10.5px var(--mono); border-radius: 999px; padding: 4px 10px; border: 1px dashed var(--line); color: var(--text-muted); white-space: nowrap; }
    .q-badge.sm { padding: 3px 8px; font-size: 10px; }
    .q-badge.run { color: var(--accent-2); border-style: solid; border-color: color-mix(in srgb, var(--flow-cyan) 45%, var(--line)); }
    .q-badge.ok { color: #10b981; border-style: solid; border-color: color-mix(in srgb, #10b981 45%, var(--line)); }
    .q-badge.bad { color: #ef4444; border-style: solid; border-color: color-mix(in srgb, #ef4444 45%, var(--line)); }

    .q-scenes { display: flex; flex-direction: column; gap: 6px; margin-top: 14px; }
    .q-scene { display: flex; align-items: center; gap: 12px; padding: 9px 12px; border-radius: 10px; border: 1px solid var(--line); background: var(--card-2); }
    .q-scene.run { border-color: color-mix(in srgb, var(--flow-cyan) 40%, var(--line)); }
    .q-scene.ok { border-color: color-mix(in srgb, #10b981 35%, var(--line)); }
    .q-scene.bad { border-color: color-mix(in srgb, #ef4444 35%, var(--line)); }
    .q-scene-no { font: 800 12px var(--mono); color: var(--text-muted); width: 18px; text-align: center; }
    .q-scene-mid { flex: 1; min-width: 0; }
    .q-scene-t { font-size: 12.5px; color: var(--text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .q-scene-bar { height: 5px; border-radius: 999px; background: var(--card); border: 1px solid var(--line); overflow: hidden; margin-top: 5px; }
    .q-scene-bar-f { height: 100%; background: linear-gradient(90deg, var(--flow-violet), var(--flow-cyan)); transition: width .4s ease; }
    .q-merge { margin-top: 12px; font-size: 12.5px; color: var(--text-secondary); }

    .q-btn { border: none; border-radius: 11px; padding: 10px 16px; font-weight: 800; font-size: 13px; cursor: pointer; font-family: inherit; }
    .q-btn.go { color: #fff; background: linear-gradient(135deg, var(--flow-violet), var(--accent)); }
    .q-btn.ghost { background: var(--card-2); color: var(--text-secondary); border: 1px solid var(--line); }

    .q-hud { display: flex; flex-wrap: wrap; gap: 10px; align-items: stretch; margin-bottom: 16px; }
    .q-hud-c { flex: 1 1 110px; border: 1px solid var(--line); border-radius: 14px; background: var(--card); padding: 12px 14px; display: flex; flex-direction: column; gap: 4px; }
    .q-hud-c b { font-size: 26px; font-weight: 900; color: var(--text-primary); line-height: 1; }
    .q-hud-l { font: 700 11px var(--mono); color: var(--text-muted); }
    .q-hud-c.pend { border-color: color-mix(in srgb, #eab308 45%, var(--line)); } .q-hud-c.pend b { color: #eab308; }
    .q-hud-c.proc { border-color: color-mix(in srgb, #3b82f6 45%, var(--line)); } .q-hud-c.proc b { color: #3b82f6; }
    .q-hud-c.done { border-color: color-mix(in srgb, #10b981 45%, var(--line)); } .q-hud-c.done b { color: #10b981; }
    .q-hud-c.fail { border-color: color-mix(in srgb, #ef4444 45%, var(--line)); } .q-hud-c.fail b { color: #ef4444; }
    .q-hud-a { display: flex; flex-direction: column; gap: 6px; justify-content: center; }
    .q-hud-a .q-btn:disabled { opacity: .45; cursor: default; }

    .q-tbl { width: 100%; border-collapse: collapse; font-size: 12.5px; }
    .q-tbl th { text-align: left; font: 700 10.5px var(--mono); color: var(--text-muted); padding: 6px 8px; border-bottom: 1px solid var(--line); }
    .q-tbl td { padding: 7px 8px; border-bottom: 1px solid var(--line); color: var(--text-secondary); vertical-align: middle; }
    .q-tbl-p { max-width: 280px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .q-tbl-a { width: 36px; text-align: center; }
    .q-hud-c.eng { justify-content: space-between; }
    .q-eng { font: 800 10.5px var(--mono); border-radius: 999px; padding: 3px 9px; border: 1px solid var(--line); color: var(--text-muted); white-space: nowrap; align-self: flex-start; }
    .q-eng.comfy { color: #10b981; border-color: color-mix(in srgb, #10b981 55%, var(--line)); background: color-mix(in srgb, #10b981 12%, transparent); }
    .q-eng.cloud { color: #06b6d4; border-color: color-mix(in srgb, #06b6d4 55%, var(--line)); background: color-mix(in srgb, #06b6d4 12%, transparent); }
    .q-eng.mock { color: #f59e0b; border-color: color-mix(in srgb, #f59e0b 55%, var(--line)); background: color-mix(in srgb, #f59e0b 12%, transparent); }
    .q-err { margin-top: 10px; padding: 8px 12px; border-radius: 10px; font-size: 12.5px; color: #ef4444; border: 1px solid color-mix(in srgb, #ef4444 45%, var(--line)); background: color-mix(in srgb, #ef4444 8%, var(--card)); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .q-mono { font: 600 11.5px var(--mono); }
    .q-pct { color: var(--text-muted); }
    .q-st { font: 700 10px var(--mono); border-radius: 999px; padding: 3px 8px; border: 1px solid var(--line); white-space: nowrap; }
    .q-st.pend { color: #eab308; border-color: color-mix(in srgb, #eab308 50%, var(--line)); }
    .q-st.proc { color: #3b82f6; border-color: color-mix(in srgb, #3b82f6 50%, var(--line)); }
    .q-st.done { color: #10b981; border-color: color-mix(in srgb, #10b981 50%, var(--line)); }
    .q-st.fail { color: #ef4444; border-color: color-mix(in srgb, #ef4444 50%, var(--line)); }
    /* 실패 사유 툴팁 — 네이티브 title 은 표 셀 텍스트에 가려지고 지연이 길어 CSS 말풍선으로 대체 */
    .q-st[data-tip] { position: relative; cursor: help; }
    .q-st[data-tip]::after { content: attr(data-tip); position: absolute; right: 0; top: calc(100% + 6px); z-index: var(--z-toast-notification, 140); width: max-content; max-width: 320px; padding: 7px 10px; border-radius: 8px; font-family: inherit; font-size: 11.5px; font-weight: 600; line-height: 1.5; white-space: normal; text-align: left; color: var(--text-primary); background: var(--card); border: 1px solid color-mix(in srgb, #ef4444 55%, var(--line)); box-shadow: 0 8px 24px rgba(0,0,0,.35); opacity: 0; visibility: hidden; pointer-events: none; transition: opacity .12s ease; }
    .q-st[data-tip]:hover::after, .q-st[data-tip]:focus-visible::after { opacity: 1; visibility: visible; }
    .q-ic { width: 26px; height: 26px; border-radius: 8px; border: 1px solid var(--line); background: var(--card-2); color: var(--text-secondary); cursor: pointer; font-weight: 800; }
    .q-ic:hover { color: var(--text-primary); }

    @@keyframes q-flow { to { background-position: 200% 0; } }
    @@media (prefers-reduced-motion: reduce) { .q-bar-f { animation: none; } }
</style>

@code {
    private bool AnyActive => Vm.TotalJobsCount > 0 || WanJob.Phase != WanJobPhase.Idle || (Jobs.Current is { } p && p.Scenes.Count > 0);

    protected override void OnInitialized()
    {
        WanJob.OnChange += OnCh;
        Jobs.OnChange += OnCh;
        Jobs.OnCompleted += OnCh;
        Vm.Changed += OnCh;
        Vm.Refresh();
    }
    public void Dispose()
    {
        WanJob.OnChange -= OnCh;
        Jobs.OnChange -= OnCh;
        Jobs.OnCompleted -= OnCh;
        Vm.Changed -= OnCh;
    }
    private void OnCh() => InvokeAsync(StateHasChanged);

    private string WanLabel => WanJob.Phase switch
    {
        WanJobPhase.Submitting => "제출 중", WanJobPhase.Queued => "대기열", WanJobPhase.Rendering => "렌더링",
        WanJobPhase.Downloading => "다운로드", WanJobPhase.Completed => "완료", WanJobPhase.Failed => "실패",
        WanJobPhase.Canceled => "취소", _ => "대기",
    };
    private string WanCls => WanJob.Phase switch
    {
        WanJobPhase.Completed => "ok", WanJobPhase.Failed or WanJobPhase.Canceled => "bad", WanJobPhase.Idle => "", _ => "run",
    };

    private static string SceneLabel(SceneStatus s) => s switch
    {
        SceneStatus.Pending => "대기", SceneStatus.Generating => "생성중", SceneStatus.Downloading => "다운로드",
        SceneStatus.Completed => "완료", SceneStatus.Failed => "실패", SceneStatus.Canceled => "취소", _ => "",
    };
    private static string SceneCls(SceneStatus s) => s switch
    {
        SceneStatus.Completed => "ok", SceneStatus.Failed or SceneStatus.Canceled => "bad",
        SceneStatus.Generating or SceneStatus.Downloading => "run", _ => "",
    };

    private static string JobLabel(BatchJobStatus s) => s switch
    {
        BatchJobStatus.Pending => "대기", BatchJobStatus.Queued => "대기열", BatchJobStatus.Processing => "렌더 중",
        BatchJobStatus.Completed => "완료", BatchJobStatus.Failed => "실패", BatchJobStatus.Cancelled => "취소", _ => "",
    };
    private static string JobCls(BatchJobStatus s) => s switch
    {
        BatchJobStatus.Processing => "proc", BatchJobStatus.Completed => "done",
        BatchJobStatus.Failed or BatchJobStatus.Cancelled => "fail", _ => "pend",
    };
    private static string? EngineCls(string? kind) => kind switch
    {
        PromptFlowStudio.Services.Render.RenderEngineKind.ComfyUi => "comfy",
        PromptFlowStudio.Services.Render.RenderEngineKind.Cloud => "cloud",
        PromptFlowStudio.Services.Render.RenderEngineKind.Mock => "mock",
        _ => null,
    };

    private static string Trunc(string s) => s.Length <= 60 ? s : s[..58] + "…";
    private static string Short(string id) => id.Length <= 10 ? id : id[..8] + "…";
}
