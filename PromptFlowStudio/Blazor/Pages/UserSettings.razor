@page "/user-settings"
@using PromptFlowStudio.Services.Account
@inject SessionState Session
@inject NavigationManager Nav
@inject PromptFlowStudio.Services.Ui.UserPreferenceService Prefs
@inject IJSRuntime JS
@inject PromptFlowStudio.Services.Render.RenderCacheCleaner CacheCleaner
@inject PromptFlowStudio.Services.Export.StockSuiteHealthService StockHealth
@inject PromptFlowStudio.Services.Diagnostics.HardwareBenchmarkService Benchmark

@* [PromptFlow Studio] 사용자 설정 — 이 PC 의 화면·생성 기본값 표시 설정.
   ⚠ 관리자 비밀번호 없이 <로그인한 모든 사용자>가 쓴다. 이 PC 의 localStorage 에만 저장된다.
     관리자 전용(회원·메일·라이선스·설치PC)은 <관리자 설정>에 있다. *@

<PageTitle>PromptFlow Studio · 사용자 설정</PageTitle>

<div class="st">
    <header class="st-head">
        <div><h1 class="st-title">🎚️ 사용자 설정 <MenuHelpBadge MenuKey="@GranularHelpService.Keys.UserSettings" /></h1><HelpHint /><div class="st-sub">화면 표시 · 렌더 알림 · 생성 기본값 — 이 PC 의 작업 환경</div></div>
        <button class="st-save" @onclick="Save">💾 설정 저장</button>
    </header>

    @if (_saved) { <div class="st-toast">✓ 설정이 저장되었습니다.</div> }

    @* ── 화면 표시 ── *@
    <section class="st-card">
        <div class="st-card-h"><span class="st-ic">🎨</span><div><div class="st-card-t">화면 표시</div><div class="st-card-d">테마·밀도·모션 등 이 PC 의 화면 환경.</div></div></div>
        <div class="st-grid">
            <div class="st-field"><label>화면 테마</label>
                <select @bind="_theme" class="st-sel"><option value="dark">다크(기본)</option><option value="light">라이트</option></select>
            </div>
            <div class="st-field"><label>목록 밀도</label>
                <select @bind="_density" class="st-sel"><option value="comfortable">여유</option><option value="compact">컴팩트</option></select>
            </div>
            <div class="st-field"><label>표시 언어</label>
                <select @bind="_lang" class="st-sel"><option value="ko">한국어</option><option value="en">English</option></select>
            </div>
        </div>
        <div class="st-toggles" style="margin-top:14px">
            <button class="st-tog @(!_motionOff ? "on" : null)" @onclick="() => _motionOff = !_motionOff"><span class="st-knob"></span>모션 효과 @(_motionOff ? "정지" : "켜기")</button>
        </div>
    </section>

    @* ── 스튜디오 모드(테마 갤러리) ── *@
    <section class="st-card">
        <div class="st-card-h"><span class="st-ic">🎬</span><div><div class="st-card-t">스튜디오 모드</div><div class="st-card-d">앱 전체 UI 무드를 선택합니다 — 표준 다크 vs 방송 주조종실. 즉시 적용·저장됩니다.</div></div></div>
        <div class="st-themegrid">
            <ThemePreviewCard Broadcast="false" Active="@(!_broadcast)" Name="표준 다크" Icon="🌑" OnSelect="() => SelectBroadcast(false)" />
            <ThemePreviewCard Broadcast="true" Active="@_broadcast" Name="방송 스튜디오" Icon="📡" OnSelect="() => SelectBroadcast(true)" />
        </div>
        <div class="st-hint">방송 스튜디오 모드: 글래스모피즘·네온 시그널·펄스 LED·라이브 VU 미터로 전 메뉴가 프로덕션 제어반처럼 바뀝니다.</div>
    </section>

    @* ── 렌더 알림 ── *@
    <section class="st-card">
        <div class="st-card-h"><span class="st-ic">🔔</span><div><div class="st-card-t">렌더 알림</div><div class="st-card-d">영상 생성·렌더 완료 시 알림 방식을 선택합니다.</div></div></div>
        <div class="st-toggles">
            <button class="st-tog @(_soundDone ? "on" : null)" @onclick="() => _soundDone = !_soundDone"><span class="st-knob"></span>완료 알림음</button>
        </div>
        <div class="st-hint">생성 파이프라인이 연결되면 렌더 완료 시 이 설정에 따라 알림이 동작합니다.</div>
    </section>

    @* ── AI 비디오 품질 & 정체성 유지 가드레일 (v5.6.4 · 즉시 적용) ── *@
    <section class="st-card">
        <div class="st-card-h"><span class="st-ic">🛡️</span><div><div class="st-card-t">AI 비디오 품질 &amp; 정체성 유지 가드레일</div><div class="st-card-d">인물·사물·동물의 형상을 1:1 유지하고 프레임 전환을 부드럽게 만드는 전역 품질 구문을 렌더 요청에 자동 결합합니다. T2V·I2V 모든 요청에 즉시 반영됩니다.</div></div></div>
        <div class="st-toggles">
            <button class="st-tog @(Prefs.EnableGlobalQualityGuardrail ? "on" : null)" @onclick="() => Prefs.EnableGlobalQualityGuardrail = !Prefs.EnableGlobalQualityGuardrail">
                <span class="st-knob"></span>가드레일 @(Prefs.EnableGlobalQualityGuardrail ? "켜짐" : "꺼짐 — 원본 프롬프트 100%")
            </button>
        </div>
        @if (Prefs.EnableGlobalQualityGuardrail)
        {
            <div class="st-grid" style="margin-top:14px">
                <div class="st-field"><label>강도 프리셋</label>
                    <select class="st-sel" value="@Prefs.QualityGuardrailPreset" @onchange="OnGuardPreset">
                        <option value="Soft">Soft — 경량(정체성 핵심만)</option>
                        <option value="Balanced">Balanced — 표준(권장)</option>
                        <option value="Strict">Strict — 최상위(무플리커·초고밀도 모션)</option>
                    </select>
                </div>
            </div>
            <div class="st-field" style="margin-top:12px"><label>커스텀 키워드 <span style="opacity:.6">(선택 · 비우면 프리셋 사용)</span></label>
                <textarea class="st-sel" rows="2" style="resize:vertical" value="@Prefs.CustomQualityPrompt" @onchange="OnGuardCustom"
                          placeholder="예: consistent character face, stable product shape, no morphing"></textarea>
            </div>
        }
        <div class="st-hint">⚠ 끄면(Off) 시스템이 프롬프트에 일절 개입하지 않아 <b>원본 그대로</b> 렌더됩니다(완전한 제어권).</div>
    </section>

    @* ── FFmpeg 실행 경로 (v5.7.3 · 데스크톱 실프레임 추출) ── *@
    <section class="st-card">
        <div class="st-card-h"><span class="st-ic">🎬</span><div><div class="st-card-t">FFmpeg 실행 경로</div><div class="st-card-d">시스템 PATH에 FFmpeg가 없거나 포터블 실행 파일을 쓸 때 경로를 직접 지정합니다. 비우면 PATH 탐색 → 없으면 스텁 프리뷰로 폴백됩니다.</div></div></div>
        <div class="st-field"><label>FFmpeg 파일 경로 (.exe)</label>
            <div class="st-inrow">
                <input type="text" class="st-sel" placeholder="예: C:\Tools\ffmpeg\bin\ffmpeg.exe" value="@Prefs.FfmpegBinaryPath" @onchange="OnFfmpegPathChanged" />
                <button type="button" class="st-btn-sm" @onclick="ValidateFfmpegPath">🔍 경로 검증</button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_ffmpegMsg))
        {
            <div class="st-hint @(_ffmpegOk ? "ok" : "err")">@_ffmpegMsg</div>
        }
        <div class="st-hint">지정 경로는 스토리보드 ▸ Long→Shorts 재구성의 실프레임 추출에 즉시 적용됩니다.</div>
    </section>

    @* ── 💼 StockSuite 에셋 경로 (원클릭 내보내기 대상) ── *@
    <section class="st-card">
        <div class="st-card-h"><span class="st-ic">💼</span><div><div class="st-card-t">StockSuite 에셋 경로</div><div class="st-card-d">작업실 · 스토리보드 · SNS 발행 모달의 [💼 StockSuite로 내보내기]가 이 폴더에 bg_ambient.mp4 로 덮어씁니다.</div></div></div>
        <div class="st-field"><label>에셋 폴더</label>
            <div class="st-inrow">
                <input type="text" class="st-sel" placeholder="예: C:\Projects\StockSuite\Assets\Video" value="@Prefs.StockSuiteAssetPath" @onchange="OnStockSuitePathChanged" />
                <button class="st-btn-sm" @onclick="ValidateStockSuitePath">🔍 검증</button>
            </div>
        </div>
        <div class="st-field"><label>내보내기 포맷</label>
            <select class="st-sel" value="@Prefs.StockSuiteFormat" @onchange="OnStockSuiteFormatChanged">
                <option value="mp4">MP4 (기본) — bg_ambient.mp4</option>
                <option value="webm">WebM VP9 (HTS 저사양 최적화) — bg_ambient.webm</option>
            </select>
        </div>
        <div class="st-field"><label><input type="checkbox" checked="@Prefs.StockSuiteSharpen" @onchange="e => Prefs.StockSuiteSharpen = e.Value is true" /> 🔎 고선명 샤프닝 (1080p Lanczos + Unsharp) — MP4·WebM 재인코딩 · 끄면 스트림 복사(빠른 내보내기)</label></div>
        <div class="st-field"><label><input type="checkbox" checked="@Prefs.StockSuiteSmooth60" @onchange="e => Prefs.StockSuiteSmooth60 = e.Value is true" /> ⚡ 60fps 모션 스무딩 (minterpolate MCI) — 16~24fps AI 영상을 고주사율 모니터용 60fps 로 보간 · 재인코딩 시간 증가</label></div>
        <div class="st-field"><label>🖥️ 기본 내보내기 해상도</label>
            <select value="@Prefs.DefaultResolution.ToString()" @onchange="e => Prefs.DefaultResolution = Enum.TryParse<PromptFlowStudio.Services.Ui.ExportResolution>(e.Value?.ToString(), out var dr) ? dr : PromptFlowStudio.Services.Ui.ExportResolution.Res1080p">
                @foreach (var r in Enum.GetValues<PromptFlowStudio.Services.Ui.ExportResolution>())
                {
                    <option value="@r.ToString()">@(PromptFlowStudio.Services.Ui.ExportResolutionInfo.Label(r))</option>
                }
            </select>
        </div>
        <div class="st-field"><label>⚡ 하드웨어 벤치마크 오토튠</label>
            <div class="st-inrow">
                <button class="st-btn-sm" @onclick="RunBenchmark" disabled="@_benchBusy" title="1초 합성 1080p 인코드(NVENC/QSV/CPU)로 처리량 측정 → 렌더 프로필 추천">@(_benchBusy ? "⏳ 측정 중…" : "⚡ Run 1-Sec Benchmark & Auto-Tune")</button>
                @if (_bench is { } br)
                {
                    <span>@br.Message</span>
                    @if (!_benchApplied)
                    {
                        <button class="st-btn-sm" @onclick="ApplyBenchmark" title="추천 프로필을 샤프닝 · 60fps 스무딩 기본값에 반영">✅ 추천 설정 적용</button>
                    }
                    else
                    {
                        <span>✔ 적용됨 — 기본 해상도 @(PromptFlowStudio.Services.Ui.ExportResolutionInfo.Label(Prefs.DefaultResolution))</span>
                    }
                }
            </div>
        </div>
        <div class="st-field"><label><input type="checkbox" checked="@Prefs.TradingSafetyMode" @onchange="e => Prefs.TradingSafetyMode = e.Value is true" /> 🛡️ 장중 트레이딩 안전 모드 — 평일 09:00~15:30(KST) FFmpeg 우선순위 BelowNormal · 동시 렌더/인코딩 1개 제한(HTS 주문 렉 방지)</label></div>
        <div class="st-field"><label><input type="checkbox" checked="@Prefs.HtsEcoMode" @onchange="OnEcoModeChanged" /> 🌱 HTS 스마트 에코 절전 모드 — 창 최소화/백그라운드 전환 시 영상 재생 일시정지(GPU 디코딩 0%) · 복귀 즉시 재개</label></div>
        <div class="st-field"><label>StockSuite 실행 파일 경로 (StockSuite.exe)</label>
            <div class="st-inrow">
                <input type="text" class="st-sel" placeholder="예: C:\Projects\StockSuite\bin\StockSuite.exe" value="@Prefs.StockSuiteExecutablePath" @onchange="OnStockSuiteExeChanged" />
                <button class="st-btn-sm" @onclick="ValidateStockSuiteExe">🔍 검증</button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_stockMsg))
        {
            <div class="st-hint @(_stockOk ? "ok" : "err")">@_stockMsg</div>
        }
        @* 🩺 StockSuite 연동 헬스 닥터 — 폴더 권한 · 디스플레이 규격 · 매니페스트 무결성 · IPC 파이프 4대 진단 + 1클릭 복구 *@
        <div class="st-field">
            <div class="st-inrow">
                <button class="st-btn-sm" @onclick="RunHealthCheckAsync" disabled="@_healthBusy">@(_healthBusy ? "⏳ 진단 중…" : "🩺 StockSuite 연동 정밀 진단")</button>
                @if (_health is { NeedsRepair: true })
                {
                    <button class="st-btn-sm" @onclick="RepairHealthAsync" disabled="@_healthBusy" title="깨진 JSON·매니페스트·디스플레이 설정을 .corrupt 로 보존한 뒤 표준 규격으로 재작성">🩹 기본 규격으로 1클릭 복구</button>
                }
            </div>
        </div>
        @if (_health is { } hr)
        {
            <div class="st-health">
                <div class="st-health-h">@PromptFlowStudio.Services.Export.StockSuiteHealthService.Badge(hr.Overall)@(hr.IpcLatencyMs >= 0 ? " · IPC " + hr.IpcLatencyMs.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) + "ms" : "")</div>
                @foreach (var it in hr.Items)
                {
                    <div class="st-health-r h@((int)it.Status)"><b>@PromptFlowStudio.Services.Export.StockSuiteHealthService.Label(it.Check)</b><span>@it.Message</span></div>
                }
            </div>
        }
        @if (_healthMsg is not null) { <div class="st-hint @(_health is { Overall: PromptFlowStudio.Services.Export.IntegrationHealth.Unhealthy } ? "err" : "ok")">@_healthMsg</div> }
    </section>

    @* ── 🧹 렌더 캐시 정리 ── *@
    <section class="st-card">
        <div class="st-card-h"><span class="st-ic">🧹</span><div><div class="st-card-t">렌더 캐시 · 임시 파일</div><div class="st-card-d">중간 인코딩 산출물(_temp_* · *.tmp · concat_*.txt · synth_*.wav)을 회수하고, 상한 초과 시 메타데이터가 없는 오래된 파일부터 정리(LRU)합니다.</div></div></div>
        <div class="st-field"><label>최대 렌더 캐시 용량 (GB)</label>
            <div class="st-inrow">
                <input type="number" class="st-sel" min="@PromptFlowStudio.Services.Render.RenderCacheCleaner.MinMaxCacheGb" max="@PromptFlowStudio.Services.Render.RenderCacheCleaner.MaxMaxCacheGb" step="1" value="@Prefs.RenderCacheMaxGb" @onchange="OnCacheMaxChanged" />
                <button class="st-btn-sm" @onclick="CleanCacheNow" disabled="@_cacheBusy">@(_cacheBusy ? "⏳ 정리 중" : "🧹 임시 캐시 즉시 비우기")</button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_cacheMsg))
        {
            <div class="st-hint ok">@_cacheMsg</div>
        }
    </section>

    @* ── 생성 기본값 (준비 중) ── *@
    <section class="st-card">
        <div class="st-card-h"><span class="st-ic">🎬</span><div><div class="st-card-t">생성 기본값 <span class="st-soon">준비 중</span></div><div class="st-card-d">새 프로젝트의 기본 해상도·화면비·길이. 생성 파이프라인 연결 후 적용됩니다.</div></div></div>
        <div class="st-grid">
            <div class="st-field"><label>기본 해상도</label>
                <select class="st-sel" disabled><option>1080p (FHD)</option><option>720p (HD)</option><option>4K (UHD)</option></select>
            </div>
            <div class="st-field"><label>화면비</label>
                <select class="st-sel" disabled><option>16:9 (가로)</option><option>9:16 (세로)</option><option>1:1 (정사각)</option></select>
            </div>
            <div class="st-field"><label>기본 길이</label>
                <select class="st-sel" disabled><option>5초</option><option>10초</option><option>15초</option></select>
            </div>
        </div>
    </section>
</div>

<style>
    .st{padding:22px 26px 40px;max-width:980px;color:var(--ink,#e6eefc)}
    .st-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:16px}
    .st-title{font-size:22px;font-weight:800;margin:0;color:var(--ink,#f1f6ff)}
    .st-sub{font-size:13px;color:var(--sub,#93a3b8);margin-top:4px}
    .st-save{padding:10px 18px;border-radius:11px;border:0;cursor:pointer;font-weight:800;font-size:13.5px;color:#fff;background:linear-gradient(135deg,#8b7bff,#6d5efc);box-shadow:0 8px 22px rgba(124,108,255,.32)}
    .st-toast{margin-bottom:14px;padding:10px 14px;border-radius:10px;font-size:13px;font-weight:700;color:#4ade80;background:rgba(34,197,94,.12);border:1px solid rgba(34,197,94,.4)}
    .st-card{background:var(--card,#111a2e);border:1px solid var(--line,rgba(148,163,184,.16));border-radius:16px;padding:16px 18px;margin-bottom:14px}
    .st-card-h{display:flex;align-items:center;gap:12px;margin-bottom:14px}
    .st-ic{width:42px;height:42px;flex:0 0 auto;display:grid;place-items:center;font-size:20px;border-radius:11px;background:rgba(124,108,255,.14);border:1px solid rgba(124,108,255,.3)}
    .st-card-t{font-size:15px;font-weight:800;color:var(--ink,#f1f6ff)}
    .st-card-d{font-size:11.5px;color:var(--sub,#93a3b8);margin-top:2px}
    .st-soon{font:700 9px/1 'Roboto Mono',Consolas,monospace;color:var(--sub,#94a3b8);border:1px solid rgba(148,163,184,.3);border-radius:999px;padding:3px 7px;margin-left:6px;vertical-align:middle}
    .st-toggles{display:flex;gap:10px;flex-wrap:wrap}
    .st-tog{display:inline-flex;align-items:center;gap:9px;padding:9px 14px;border-radius:11px;cursor:pointer;font-size:13px;font-weight:700;color:var(--sub,#94a3b8);background:rgba(148,163,184,.06);border:1px solid var(--line,rgba(148,163,184,.18))}
    .st-tog .st-knob{width:30px;height:17px;border-radius:999px;background:#334155;position:relative;transition:.18s}
    .st-tog .st-knob::after{content:'';position:absolute;top:2px;left:2px;width:13px;height:13px;border-radius:50%;background:#94a3b8;transition:.18s}
    .st-tog.on{color:#c4b5fd;border-color:rgba(124,108,255,.45);background:rgba(124,108,255,.1)}
    .st-tog.on .st-knob{background:linear-gradient(135deg,#6d5efc,#8b7bff)}
    .st-tog.on .st-knob::after{left:15px;background:#fff}
    .st-hint{margin-top:10px;font-size:11px;color:var(--sub,#94a3b8)} .st-hint b{color:var(--accent,#7c6cff)}
    .st-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
    .st-field label{display:block;font-size:12px;font-weight:600;color:var(--sub,#b6c2d6);margin-bottom:6px}
    .st-sel{width:100%;padding:9px 11px;border-radius:9px;background:rgba(8,6,16,.6);border:1px solid var(--line,rgba(148,163,184,.22));color:var(--ink,#e6eefc);font-size:13px;font-family:inherit}
    .st-sel:disabled{opacity:.5;cursor:not-allowed}
    .st-themegrid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    @@media(max-width:620px){.st-themegrid{grid-template-columns:1fr}}
    .st-inrow{display:flex;gap:8px;align-items:center}
    .st-inrow .st-sel{flex:1}
