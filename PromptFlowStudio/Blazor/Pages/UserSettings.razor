@code {
    private PromptFlowStudio.Services.Diagnostics.HardwareBenchmarkResult? _bench;
    private bool _benchBusy, _benchApplied;

    private async Task RunBenchmark()
    {
        if (_benchBusy) return;
        _benchBusy = true; _benchApplied = false; _bench = null;
        try { _bench = await Benchmark.RunAsync(); }
        catch (Exception ex) when (ex is not OperationCanceledException) { Program.Log("UserSettings.Benchmark", ex); }
        finally { _benchBusy = false; await InvokeAsync(StateHasChanged); }
    }

    /// <summary>사용자 확인 시 추천 프로필 반영 — Eco: 1080p·30fps · Balanced: 1080p·60fps · Ultra: 4K·60fps · 샤프닝 ON.</summary>
    private async Task ApplyBenchmark()
    {
        if (_bench is not { } b) return;
        try { await PromptFlowStudio.Services.Diagnostics.HardwareBenchmarkService.ApplyRecommendationAsync(b, Prefs); _benchApplied = true; }
        catch (Exception ex) { Program.Log("UserSettings.BenchmarkApply", ex); }
    }
    private string _theme = "dark", _density = "comfortable", _lang = "ko";
    private bool _motionOff, _soundDone, _broadcast;
    private bool _saved;

    // v5.6.4: 품질 가드레일 — Prefs 직결(즉시 영속·렌더 파이프라인 실시간 반영).
    private void OnGuardPreset(ChangeEventArgs e)
    {
        if (Enum.TryParse<PromptFlowStudio.Services.Wan.QualityGuardrailPreset>(e.Value?.ToString(), out var p))
            Prefs.QualityGuardrailPreset = p;
    }
    private void OnGuardCustom(ChangeEventArgs e) => Prefs.CustomQualityPrompt = e.Value?.ToString() ?? "";

    // v5.7.3: 커스텀 FFmpeg 경로 — Prefs 직결(즉시 영속) + 파일 존재 검증.
    private string? _ffmpegMsg;
    private bool _ffmpegOk;
    private void OnFfmpegPathChanged(ChangeEventArgs e) { Prefs.FfmpegBinaryPath = e.Value?.ToString() ?? ""; _ffmpegMsg = null; }
    private void ValidateFfmpegPath()
    {
        var path = (Prefs.FfmpegBinaryPath ?? "").Trim();
        if (string.IsNullOrEmpty(path)) { _ffmpegOk = true; _ffmpegMsg = "ℹ 비어 있음 — 시스템 PATH의 ffmpeg를 탐색합니다(없으면 스텁 프리뷰)."; return; }
        if (System.IO.File.Exists(path)) { _ffmpegOk = true; _ffmpegMsg = "✅ 유효한 실행 파일을 확인했습니다."; }
        else { _ffmpegOk = false; _ffmpegMsg = "❌ 해당 경로에 파일이 존재하지 않습니다."; }
    }

    // 💼 StockSuite 에셋 경로 — Prefs 직결(즉시 영속) + 폴더 존재 검증.
    private string? _stockMsg;
    private bool _stockOk;
    private void OnStockSuitePathChanged(ChangeEventArgs e) { Prefs.StockSuiteAssetPath = (e.Value?.ToString() ?? "").Trim().Trim('"'); _stockMsg = null; }
    private void OnStockSuiteFormatChanged(ChangeEventArgs e) => Prefs.StockSuiteFormat = e.Value?.ToString() ?? "mp4";
    private void OnStockSuiteExeChanged(ChangeEventArgs e) { Prefs.StockSuiteExecutablePath = (e.Value?.ToString() ?? "").Trim().Trim('"'); _stockMsg = null; }
    private void ValidateStockSuiteExe()
    {
        var st = PromptFlowStudio.Services.Export.StockSuiteExporter.ValidateExecutablePath(Prefs.StockSuiteExecutablePath);
        _stockOk = st == PromptFlowStudio.Services.Export.StockSuiteExeStatus.Ok;
        _stockMsg = PromptFlowStudio.Services.Export.StockSuiteExporter.DescribeExeStatus(st);
    }
    private void ValidateStockSuitePath()
    {
        var path = (Prefs.StockSuiteAssetPath ?? "").Trim();
        if (string.IsNullOrEmpty(path)) { _stockOk = false; _stockMsg = "ℹ 비어 있음 — 내보내기 전에 StockSuite 에셋 폴더를 지정하세요."; return; }
        if (System.IO.Directory.Exists(path)) { _stockOk = true; _stockMsg = "✅ 에셋 폴더를 확인했습니다."; }
        else { _stockOk = false; _stockMsg = "❌ 폴더가 존재하지 않습니다(상위 폴더가 있으면 내보내기 시 자동 생성)."; }
    }

    // 🩺 StockSuite 헬스 닥터 — 진단/복구 모두 백그라운드 스레드 · 예외 격리.
    private PromptFlowStudio.Services.Export.HealthCheckResult? _health;
    private bool _healthBusy;
    private string? _healthMsg;
    private async Task OnEcoModeChanged(ChangeEventArgs e)
    {
        var on = e.Value is true;
        Prefs.HtsEcoMode = on;
        try { await JS.InvokeVoidAsync("promptflow.setEcoMode", on); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException) { /* 브릿지 미적재 — 다음 작업실 진입 시 반영 */ }
    }

    private async Task RunHealthCheckAsync()
    {
        if (_healthBusy) return;
        _healthBusy = true; _healthMsg = null;
        try { _health = await Task.Run(() => StockHealth.ValidateIntegrationHealthAsync()); }
        catch (Exception ex) { Program.Log("Settings.StockHealth", ex); _healthMsg = "⚠ 진단 실패 — 다시 시도하세요."; }
        finally { _healthBusy = false; }
    }
    private async Task RepairHealthAsync()
    {
        if (_healthBusy) return;
        _healthBusy = true; _healthMsg = null;
        try
        {
            var before = _health;
            var r = await Task.Run(() => StockHealth.RepairAsync(before));
            _health = r.After;
            _healthMsg = "🩹 복구 " + r.Repaired.ToString(System.Globalization.CultureInfo.InvariantCulture) + "건 — " + string.Join(" · ", r.Actions);
        }
        catch (Exception ex) { Program.Log("Settings.StockRepair", ex); _healthMsg = "⚠ 복구 실패 — 다시 시도하세요."; }
        finally { _healthBusy = false; }
    }

    // 🧹 렌더 캐시 — 상한(GB) Prefs 직결 · 즉시 비우기(백그라운드 · 진행 중 산출물 60초 보호).
    private string? _cacheMsg;
    private bool _cacheBusy;
    private void OnCacheMaxChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var gb))
            Prefs.RenderCacheMaxGb = gb;
        _cacheMsg = null;
    }
    private async Task CleanCacheNow()
    {
        if (_cacheBusy) return;
        _cacheBusy = true;
        try { _cacheMsg = (await CacheCleaner.CleanAsync(PromptFlowStudio.Services.Render.RenderCacheCleaner.ImmediateMinAge)).Summary; }
        catch (Exception ex) { Program.Log("UserSettings.CacheClean", ex); _cacheMsg = "❌ 캐시 정리 중 오류가 발생했습니다."; }
        finally { _cacheBusy = false; }
    }

    // 스튜디오 모드 즉시 전환(방송 스튜디오 테마 루트 플래그 + 영속).
    private async Task SelectBroadcast(bool on)
    {
        _broadcast = on;
        Prefs.IsBroadcast = on;   // localStorage 영속(비동기)
        try { await JS.InvokeVoidAsync("siteMaticUi.setRootFlag", "broadcast", on); }
        catch (Exception) { /* 화면 옵션 때문에 앱이 죽으면 안 된다 */ }
    }

    protected override void OnInitialized()
    {
        if (!Session.IsAuthenticated) { Nav.NavigateTo("login"); return; }

        // 저장된 값을 화면에 되살린다.
        _theme = Prefs.Get(UserPreferenceService.Keys.Theme);
        _density = Prefs.Get(UserPreferenceService.Keys.Density);
        _soundDone = Prefs.GetBool(UserPreferenceService.Keys.SoundAlert);
        _motionOff = Prefs.IsMotionDisabled;
        _broadcast = Prefs.IsBroadcast;
    }

    private async Task Save()
    {
        Prefs.Set(UserPreferenceService.Keys.Theme, _theme);
        Prefs.Set(UserPreferenceService.Keys.Density, _density);
        Prefs.SetBool(UserPreferenceService.Keys.SoundAlert, _soundDone);
        Prefs.IsMotionDisabled = _motionOff;

        await ApplyTheme();
        try { await JS.InvokeVoidAsync("siteMaticUi.setRootFlag", "motion-off", _motionOff); }
        catch (Exception) { /* 화면 옵션 때문에 앱이 죽으면 안 된다 */ }

        _saved = true;
    }

    private async Task ApplyTheme()
    {
        try { await JS.InvokeVoidAsync("siteMaticUi.setTheme", _theme); }
        catch (Exception) { /* 테마 때문에 화면이 죽으면 안 된다 */ }
    }
}
