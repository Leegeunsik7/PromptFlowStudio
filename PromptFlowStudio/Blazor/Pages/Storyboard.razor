    // ── 브랜드 워터마크(채널 로고) ──
    private async Task OnWatermarkPicked(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        const long maxSize = 8L * 1024 * 1024;   // 8MB(로고 이미지)
        if (file.Size > maxSize) { ShowToast("❌ 워터마크 이미지가 너무 큽니다(최대 8MB)."); return; }
        try
        {
            var dir = Path.Combine(Media.MediaRoot, "_uploads", "watermark");
            Directory.CreateDirectory(dir);
            var name = SanitizeFileName(file.Name);
            if (string.IsNullOrWhiteSpace(Path.GetExtension(name))) name += ".png";
            var savePath = Path.Combine(dir, name);

            await using (var src = file.OpenReadStream(maxSize))
            await using (var dst = new FileStream(savePath, FileMode.Create, FileAccess.Write, FileShare.None, 81920, FileOptions.Asynchronous))
                await src.CopyToAsync(dst);

            _project.WatermarkImagePath = savePath;
            _watermarkThumb = Media.ToPlaybackUrl(savePath) + "?v=" + DateTime.Now.Ticks;   // 캐시버스터로 즉시 갱신
            ShowToast($"🏷️ 워터마크 등록됨 — {name} · 최종 영상 우측 상단에 합성됩니다.");
        }
        catch (Exception ex) { ShowToast("❌ 워터마크 추가 실패: " + ex.Message); }
    }

    private void ClearWatermark()
    {
        _project.WatermarkImagePath = null;   // 파일은 남겨둠(재사용) · 경로만 해제
