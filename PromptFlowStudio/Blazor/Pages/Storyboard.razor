    // ── 원클릭 대본 위저드 ──
    private void RunWizard()
    {
        if (Jobs.IsRunning || Jobs.IsMerging) { ShowToast("생성/병합 중에는 사용할 수 없습니다."); return; }
        var cuts = Wizard.Generate(_wizardInput ?? "", 5);
        if (cuts.Count == 0) { ShowToast("생성할 내용이 없습니다. 주제나 대본을 입력하세요."); return; }

        foreach (var s in _project.Scenes) ClearSceneImageFile(s);   // 기존 컷 임시 이미지 정리
        _project.Scenes.Clear();

        var (w, h) = StoryboardProject.ParseResolution(_project.ExportResolution);
        var size = h > w ? "720*1280" : "1280*720";   // 세로 쇼츠면 세로 생성
        foreach (var c in cuts)
            _project.Scenes.Add(new StoryboardScene
            {
                Prompt = string.IsNullOrWhiteSpace(c.CameraMotion) ? c.Prompt : $"{c.Prompt}, {c.CameraMotion}",
                VoiceText = c.VoiceText,
                Size = size,
            });

        if (string.IsNullOrWhiteSpace(_project.Title) || _project.Title == "새 스토리보드")
            _project.Title = TruncTitle(_wizardInput!.Trim());

        _wizardOpen = false;
        ShowToast($"🪄 {cuts.Count}개 컷 자동 생성 완료 — 프롬프트·나레이션을 확인/편집하세요.");
    }

    private static string TruncTitle(string s)
    {
        s = s.Replace('\n', ' ').Replace('\r', ' ').Trim();
        return s.Length <= 28 ? s : s[..27] + "…";
    }

    // ── AI 콘텐츠 에이전시(Swarm) 확정안 적용 ──
    private void ApplySwarmPlan(SwarmPlan plan)
    {
        if (!plan.Ok || plan.Cuts.Count == 0) { ShowToast("적용할 확정안이 없습니다."); return; }
        if (Jobs.IsRunning || Jobs.IsMerging) { ShowToast("생성/병합 중에는 적용할 수 없습니다."); return; }

        foreach (var s in _project.Scenes) ClearSceneImageFile(s);
        _project.Scenes.Clear();

        var (w, h) = StoryboardProject.ParseResolution(_project.ExportResolution);
        var size = h > w ? "720*1280" : "1280*720";
        foreach (var c in plan.Cuts)
            _project.Scenes.Add(new StoryboardScene { Prompt = c.Prompt, VoiceText = c.VoiceText, Size = size });

        if (!string.IsNullOrWhiteSpace(plan.Title)) _project.Title = TruncTitle(plan.Title);

        _agencyOpen = false;
        ShowToast($"🤖 에이전시 확정안 적용 — {plan.Cuts.Count}컷 «{_project.Title}». 이제 생성을 시작하세요.");
    }

