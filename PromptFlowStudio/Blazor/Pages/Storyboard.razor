    private async Task OnOpenProject(InputFileChangeEventArgs e)
    {
        if (Jobs.IsRunning || Jobs.IsMerging) return;
        var file = e.File;
        if (file is null) return;
        try
        {
            using var sr = new StreamReader(file.OpenReadStream(8L * 1024 * 1024));
            var json = await sr.ReadToEndAsync();
            var loaded = Repo.Deserialize(json);
            if (loaded is null || loaded.Scenes.Count == 0) { ShowToast("❌ 열기 실패 — 올바른 스토리보드 파일이 아닙니다."); return; }
            _project = loaded;
            // 관리 폴더(Projects)에 있는 파일이면 절대경로를 알 수 있으므로 최근 목록에 등록.
            var canonical = Path.Combine(Repo.ProjectsDir, _project.Id + ".json");
            if (File.Exists(canonical)) Recents.Touch(canonical, _project.Title);
            ShowToast($"📂 '{_project.Title}' 열기 완료 · {_project.Scenes.Count} 컷.");
        }
        catch (Exception ex) { ShowToast("❌ 열기 실패: " + ex.Message); }
    }

