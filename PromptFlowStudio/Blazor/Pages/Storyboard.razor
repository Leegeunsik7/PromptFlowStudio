    private static readonly FacialEmotion[] SceneEmotions = { FacialEmotion.HappySmile, FacialEmotion.Curious, FacialEmotion.Surprised, FacialEmotion.Giggle, FacialEmotion.Pout };
    private readonly CancellationTokenSource _lipCts = new();
    private readonly Dictionary<string, (string Message, string? Url)> _lipResults = new();
    private string? _lipBusyId;

    /// <summary>컷 대사 TTS → 오케스트레이터 립싱크(결과 별도 파일 · 컷 원본/병합 파이프라인 불변).</summary>
    private async Task RealignSceneAsync(StoryboardScene scene)
    {
        if (_lipBusyId is not null || scene.LocalPath is not { } src || !System.IO.File.Exists(src)) return;
        _lipBusyId = scene.Id;
        _lipResults[scene.Id] = ("🎙️ 나레이션 합성 중…", null);
        try
        {
            var ct = _lipCts.Token;
            var audio = await LipTts.SynthesizeAsync(scene.VoiceText, NarrationTone.FairyTale, 1.0, TtsProvider.Auto, ct);
            if (audio is null) { _lipResults[scene.Id] = ("⚠ 나레이션 합성 실패(TTS 엔진/네트워크 확인)", null); return; }
            var output = System.IO.Path.Combine(System.IO.Path.GetDirectoryName(src) ?? Media.MediaRoot, "lipsync_realign_" + scene.Id + ".mp4");
            var id = scene.Id;
            var status = new Progress<string>(s => { _lipResults[id] = (s, null); _ = InvokeAsync(StateHasChanged); });
            var r = await LipAi.SyncAsync(new AudioLipSyncRequest(src, audio, output, scene.VoiceText + " " + scene.Prompt, scene.Emotion, scene.EmotionIntensity), status, ct);
            _lipResults[scene.Id] = r.Ok && r.OutputPath is not null
                ? ("✅ " + r.Message + " · 음소 " + r.Visemes.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) + "구간",
                   Media.ToPlaybackUrl(r.OutputPath) + "?v=" + DateTime.Now.Ticks.ToString(System.Globalization.CultureInfo.InvariantCulture))
                : ("⚠ " + r.Message, null);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Program.Log("Storyboard.LipRealign", ex); _lipResults[scene.Id] = ("⚠ 재정렬 실패: " + ex.Message, null); }
        finally { _lipBusyId = null; }
    }

