    .sb-note { font-size: 11px; color: var(--text-muted); line-height: 1.5; } .sb-note b { color: var(--text-secondary); }

    .sb-toast { position: sticky; bottom: 12px; margin-top: 16px; padding: 12px 16px; border-radius: 11px; font-size: 13px; font-weight: 700;
        color: var(--text-primary); background: var(--card); border: 1px solid var(--accent); box-shadow: 0 10px 30px rgba(0,0,0,.25); }

