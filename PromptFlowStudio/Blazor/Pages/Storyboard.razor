    // ── 숏츠 커버 썸네일 ──
    private async Task GenerateCover()
    {
        if (_project.FinalVideoPath is null) { ShowToast("먼저 최종 영상을 만들어 주세요."); return; }
        var text = (_project.CoverTitle ?? "").Trim();
        if (text.Length == 0) { ShowToast("커버 문구를 입력하세요."); return; }
        if (!Cover.IsAvailable) { ShowToast("ffmpeg.exe 가 필요합니다."); return; }

        _coverBusy = true;
        try
        {
            var poster = _project.FinalVideoPath + ".jpg";
            var src = File.Exists(poster) ? poster : _project.FinalVideoPath;   // 포스터 없으면 영상에서 프레임 추출
            var outPath = Path.Combine(Path.GetDirectoryName(_project.FinalVideoPath)!, "cover.jpg");
            var result = await Cover.GenerateAsync(src, text, outPath, _coverColor, _coverBox);
            if (result is not null)
            {
                _coverPath = result;
                _coverUrl = Media.ToPlaybackUrl(result) + "?t=" + DateTime.Now.Ticks;   // 덮어써도 새로 로드되도록 캐시버스터
                ShowToast("🖼️ 커버 썸네일 생성 완료");
            }
            else ShowToast("❌ 커버 생성 실패 (ffmpeg 확인 필요)");
        }
        catch (Exception ex) { ShowToast("❌ 커버 생성 실패: " + ex.Message); }
        finally { _coverBusy = false; }
    }

    // ── 4K 업스케일 ──
    private async Task UpscaleFinal()
    {
        if (_project.FinalVideoPath is null || _upBusy) return;
        var engine = _upEngine == "RealCugan" ? UpscaleEngine.RealCugan : UpscaleEngine.RealEsrgan;
        if (!Upscale.IsAvailable(engine)) { ShowToast($"{engine} 엔진 미설치 — appsettings.json 의 Engines 경로를 지정하세요."); return; }

        _upBusy = true; _upPct = 0; _upStatus = "시작"; _upResult = null; _up4kPath = null;
        try
        {
            var dir = Path.GetDirectoryName(_project.FinalVideoPath)!;
            var outPath = Path.Combine(dir, "final_4k.mp4");
            var prog = new Progress<double>(p => { _upPct = p; _ = InvokeAsync(StateHasChanged); });
            var stat = new Progress<string>(s => { _upStatus = s; _ = InvokeAsync(StateHasChanged); });
            var r = await Upscale.UpscaleAsync(_project.FinalVideoPath, outPath, 4, engine, prog, stat, CancellationToken.None);
            if (r.Ok && r.OutputPath is not null)
            {
                _up4kPath = r.OutputPath;
                _upResult = "✅ 4K 업스케일 완료 — " + ShortPath(r.OutputPath);
                ShowToast("🚀 4K 업스케일 완료");
            }
            else { _upResult = "❌ " + r.Message; ShowToast("❌ 업스케일 실패: " + r.Message); }
        }
        catch (Exception ex) { _upResult = "❌ " + ex.Message; ShowToast("❌ 업스케일 실패: " + ex.Message); }
        finally { _upBusy = false; _ = InvokeAsync(StateHasChanged); }
    }

    // ── 자막 자동 추출(STT) → 컷 동기화 ──
    private async Task ExtractSubs()
    {
        if (_project.FinalVideoPath is null || _sttBusy) return;
        if (!Stt.IsAvailable) { ShowToast("Faster-Whisper 미설치 — appsettings.json 의 Engines:FasterWhisper:Exe 를 지정하세요."); return; }
        _sttBusy = true;
        try
        {
            var r = await Stt.TranscribeAsync(_project.FinalVideoPath, null, null, CancellationToken.None);
            if (r.Ok)
            {
                var filled = Stt.DistributeToScenes(r.Cues, _project.Scenes, 5.0, _project.PlaybackSpeed);
                ShowToast($"📝 자막 {r.Cues.Count}구간 추출 · {filled}개 컷에 반영됨(재병합 시 자막·나레이션 적용).");
            }
            else ShowToast("❌ 자막 추출 실패: " + r.Message);
        }
        catch (Exception ex) { ShowToast("❌ 자막 추출 실패: " + ex.Message); }
        finally { _sttBusy = false; }
    }

    // ── 컷 이미지(i2v) ──
    private async Task OnScenePicked(StoryboardScene scene, InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        // v16.57.0: 12MB/32MB 상한 해제 — 1MB 청크 스트리밍 수신 · 업로드 한도/4K 초과 시 프록시 PNG 자동 생성(원본 보존).
        try
        {
            var dir = Path.Combine(Media.MediaRoot, "_uploads");
            MediaIngestResult r;
            await using (var src = file.OpenReadStream(MediaPipe.MaxIngestBytes))
                r = await MediaPipe.IngestAsync(src, dir, file.Name, file.Size, (done, total) =>
                {
                    _uploadProgress[scene.Id] = total > 0 ? (int)(done * 100 / total) : 0;
                    _ = InvokeAsync(StateHasChanged);
                });
            _uploadProgress.Remove(scene.Id);
            if (!r.Ok || r.EffectivePath is null) { scene.Error = r.Message; return; }
            var savePath = r.EffectivePath;
            if (_autoTune) AutoTuneScene(scene, r);

            scene.ImagePath = savePath;
            scene.ImageName = file.Name;
            scene.ThumbUrl = Media.ToPlaybackUrl(savePath);   // 가상호스트 썸네일
            scene.Error = null;
        }
        catch (Exception ex) { scene.Error = "이미지 로드 실패: " + ex.Message; }
    }

    private void ClearSceneImage(StoryboardScene s)
    {
        ClearSceneImageFile(s);
        s.ImagePath = null; s.ThumbUrl = null; s.ImageName = null;
    }

    private static void ClearSceneImageFile(StoryboardScene s)
    { try { if (!string.IsNullOrEmpty(s.ImagePath) && File.Exists(s.ImagePath)) File.Delete(s.ImagePath); } catch { /* 무시 */ } }

    private void ShowToast(string msg)
    {
        _toast = msg;
        _toastTimer?.Dispose();
        _toastTimer = new System.Threading.Timer(_ => { _toast = null; _ = InvokeAsync(StateHasChanged); },
            null, 8000, System.Threading.Timeout.Infinite);
    }

    // ── 표시 헬퍼 ──
    private static string Trunc(string s) => s.Length <= 42 ? s : s[..40] + "…";

    private static string Label(SceneStatus st) => st switch
    {
        SceneStatus.Pending => "대기",
        SceneStatus.Generating => "생성중",
        SceneStatus.Downloading => "다운로드",
        SceneStatus.Completed => "완료",
        SceneStatus.Failed => "실패",
        SceneStatus.Canceled => "취소",
        _ => "",
    };

    private static string Cls(SceneStatus st) => st switch
    {
        SceneStatus.Completed => "ok",
        SceneStatus.Failed or SceneStatus.Canceled => "bad",
        SceneStatus.Generating or SceneStatus.Downloading => "run",
        _ => "",
    };

    /// <summary>AI 감독 점수 뱃지 색 — 기준점 이상 ok, 15점 이내 근접 warn, 그 외 bad.</summary>
    private string QaCls(int score)
        => score >= _project.QualityThreshold ? "ok" : score >= _project.QualityThreshold - 15 ? "warn" : "bad";
}
