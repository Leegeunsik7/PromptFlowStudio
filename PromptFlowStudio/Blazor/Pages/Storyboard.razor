    // ── v16.12.0 최종 내보내기(Post-Production) ──
    private CancellationTokenSource? _ppCts;
    private PostTransition _ppTransition = PostTransition.Crossfade;
    private bool _ppVoice;
    private NarrationTone _ppTone = NarrationTone.FairyTale;
    private double _ppSpeed = 1.0;
    private SafePlatform _ppPlatform = SafePlatform.YouTubeShorts;
    private int _ppPct;
    private string _ppStage = "";
    private string? _ppMessage;
    private string? _ppOutput;
    private bool _ppOk;

    private bool CanFinalExport => Post.IsAvailable && !Jobs.IsRunning && !Jobs.IsMerging && _ppCts is null
        && PostProductionEngine.ReadyScenes(_project).Count > 0;

    private async Task FinalExportAsync()
    {
        if (!CanFinalExport) return;
        var cts = new CancellationTokenSource();
        _ppCts = cts;
        _ppPct = 0; _ppStage = "준비 중…"; _ppMessage = null; _ppOutput = null; _ppOk = false;
        var progress = new Progress<PostProductionProgress>(p =>
        {
            _ppPct = p.Percent; _ppStage = p.Stage;
            _ = InvokeAsync(StateHasChanged);
        });
        try
        {
            var voice = _ppVoice ? new VoiceoverMixOptions(Tone: _ppTone, Speed: _ppSpeed, Platform: _ppPlatform) : null;
            var r = await Task.Run(() => Post.ExportAsync(_project, progress, _ppTransition, cts.Token, voice));
            _ppOk = r.Ok; _ppOutput = r.OutputPath;
            _ppMessage = r.Ok ? "✅ 최종 영상 완성 — " + r.Message : "⚠ " + r.Message;
            if (r.Ok && r.OutputPath is not null)
            {
                FolderLink.Reveal(r.OutputPath);   // 완료 즉시 OS 탐색기에서 결과 파일 선택
                ShowToast("🎬 최종 영상 내보내기 완료 — 탐색기에서 결과 파일을 열었습니다.");
            }
        }
        catch (Exception ex) { _ppOk = false; _ppMessage = "⚠ 최종 내보내기 실패: " + ex.Message; }
        finally
        {
            if (ReferenceEquals(Interlocked.CompareExchange(ref _ppCts, null, cts), cts)) cts.Dispose();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CancelFinalExport()
    {
        try { _ppCts?.Cancel(); } catch (ObjectDisposedException) { /* 이미 종료 */ }
    }

    public void Dispose()
    {
        try { _ppCts?.Cancel(); } catch (ObjectDisposedException) { }   // v16.12.0 진행 중 내보내기 취소
        StudioNav.Requested -= OnStudioRequested;
        Jobs.OnChange -= OnStateChanged;
        Jobs.OnCompleted -= OnJobsCompleted;
        Cfg.OnConfigChanged -= OnStateChanged;
        Recents.OnChange -= OnStateChanged;
        QaInspector.OnChange -= OnStateChanged;
        _toastTimer?.Dispose();
        _guideTimer?.Dispose();
        _hlTimer?.Dispose();
        _lipCts.Cancel();   // v16.20.0 진행 중 립싱크 재정렬 취소
        _lipCts.Dispose();
    }

