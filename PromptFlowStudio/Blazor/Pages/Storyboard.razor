    // ── 유튜브 자동 업로드(비공개 기본) ──
    private async Task UploadYouTube()
    {
        if (_ytBusy || _project.FinalVideoPath is null || !YtPublish.Enabled) return;
        _ytBusy = true; _ytPct = 0;
        try
        {
            var meta = Meta.Generate(_project);
            var title = meta.HasContent ? meta.Title : _project.Title;
            var desc = meta.HasContent ? meta.Description : _project.Title;
            var tags = meta.HasContent ? (System.Collections.Generic.IReadOnlyList<string>)meta.Tags : System.Array.Empty<string>();
            var prog = new Progress<double>(p => { _ytPct = (int)p; _ = InvokeAsync(StateHasChanged); });
            var r = await YtPublish.UploadAsync(_project.FinalVideoPath, title, desc, tags, "private", null, prog, CancellationToken.None);
            ShowToast(r.Ok ? $"✅ 유튜브 업로드 완료(비공개) — {r.Url}" : "❌ 업로드 실패: " + r.Message);
        }
        catch (Exception ex) { Errors.Show(ex); }
        finally { _ytBusy = false; await InvokeAsync(StateHasChanged); }
    }

