    .sb-modal-scrim { position: fixed; inset: 0; z-index: var(--z-studio-modal); background: rgba(0,0,0,.55); display: flex; align-items: center; justify-content: center; padding: 24px; }
    .sb-modal { width: 100%; max-width: 620px; max-height: 88vh; display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--line); border-radius: 16px; box-shadow: 0 24px 60px rgba(0,0,0,.5); overflow: hidden; }
    .sb-modal-h { display: flex; align-items: center; justify-content: space-between; padding: 14px 18px; border-bottom: 1px solid var(--line); font-size: 15px; font-weight: 900; color: var(--text-primary); }
    .sb-modal-x { width: 30px; height: 30px; border-radius: 8px; border: 1px solid var(--line); background: var(--card-2); color: var(--text-secondary); cursor: pointer; font-size: 13px; }
    .sb-modal-x:hover { border-color: #ef4444; color: #ef4444; }
    .sb-modal-b { padding: 16px 18px; overflow-y: auto; display: flex; flex-direction: column; gap: 14px; }
    .sb-modal-note { margin: 0; font-size: 12px; color: var(--text-muted); line-height: 1.5; }
    .sb-modal-actions { display: flex; gap: 10px; margin-top: 2px; }

    .sb-meta-sec { display: flex; flex-direction: column; gap: 6px; }
    .sb-meta-lbl { display: flex; align-items: center; justify-content: space-between; font-size: 12.5px; font-weight: 800; color: var(--text-primary); }
    .sb-meta-lbl .sb-sub { font: 600 10.5px var(--mono); color: var(--text-muted); }
    .sb-copy { font: 700 11px inherit; padding: 5px 11px; border-radius: 8px; border: 1px solid var(--line); background: var(--card-2); color: var(--accent-2); cursor: pointer; white-space: nowrap; }
    .sb-copy:hover { border-color: var(--accent); color: var(--text-primary); }
    .sb-meta-box { width: 100%; box-sizing: border-box; background: var(--card-2); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; font-size: 12.5px; line-height: 1.55; color: var(--text-primary); word-break: break-word; }
    .sb-meta-box.area { resize: vertical; font-family: inherit; }
    .sb-meta-box.area:focus { outline: none; border-color: var(--accent); }

    /* 태그 칩 편집기 */
    .sb-chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .sb-chip-empty { font-size: 11.5px; color: var(--text-muted); padding: 4px 0; }
    .sb-chip { display: inline-flex; align-items: center; gap: 5px; font: 700 11.5px var(--mono); color: var(--accent-2);
        background: color-mix(in srgb, var(--flow-cyan) 10%, var(--card-2)); border: 1px solid color-mix(in srgb, var(--flow-cyan) 35%, var(--line)); border-radius: 999px; padding: 4px 6px 4px 11px; }
    .sb-chip-x { width: 18px; height: 18px; border-radius: 50%; border: none; background: color-mix(in srgb, var(--flow-cyan) 18%, transparent); color: var(--text-secondary); cursor: pointer; font-size: 10px; line-height: 1; }
    .sb-chip-x:hover { background: #ef4444; color: #fff; }
    .sb-chip-add { display: flex; align-items: center; gap: 8px; background: var(--card-2); border: 1px solid var(--line); border-radius: 10px; padding: 4px 6px 4px 12px; }
    .sb-chip-add:focus-within { border-color: var(--accent); }
    .sb-chip-hash { font: 800 13px var(--mono); color: var(--text-muted); }
    .sb-chip-in { flex: 1; min-width: 0; border: none; background: none; color: var(--text-primary); font-size: 12.5px; font-family: inherit; padding: 6px 0; }
    .sb-chip-in:focus { outline: none; } .sb-chip-in::placeholder { color: var(--text-muted); }

    /* 숏츠 커버 썸네일 */
    .sb-btn.sm { padding: 8px 13px; font-size: 12.5px; }
    .sb-cover-opts { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .sb-cover-opt { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--text-secondary); }
    .sb-cover-opt select { border-radius: 8px; border: 1px solid var(--line); background: var(--card-2); color: var(--text-primary); padding: 6px 8px; font-size: 12.5px; font-family: inherit; }
    .sb-cover-opt select:focus { outline: none; border-color: var(--accent); }
    .sb-cover-chk { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--text-secondary); cursor: pointer; }
    .sb-cover-chk input { accent-color: var(--flow-violet); }
    .sb-cover-img { width: 100%; max-width: 260px; margin: 4px auto 0; display: block; border-radius: 11px; border: 1px solid color-mix(in srgb, var(--flow-magenta) 45%, var(--line)); background: #000; }

    @@keyframes sb-flow { to { background-position: 200% 0; } }
    @@media (prefers-reduced-motion: reduce) { .sb-bar-f { animation: none; } }
</style>

@code {
    private StoryboardProject _project = new();   // 열기 시 교체되므로 readonly 불가
    private bool _parallel;
    private bool _recentsOpen;
    private bool _exporting;
    // 미리보기 세이프존 플랫폼 = 병합 대상(_project.TargetPlatform)과 단일 소스(양방향 동기화). 변경 시 마지막 선택을 로컬(UserPreference·localStorage)에 기억.
    private SafePlatform PreviewPlatform
    {
        get => _project.TargetPlatform;
        set { _project.TargetPlatform = value; Prefs.Set(UserPreferenceService.Keys.SafeZonePlatform, value.ToString()); ShowSwitchGuide(SwitchRoleGuideService.Keys.SafeZone); }
    }

    // ── 텐션 타임라인 → 컷 카드 스크롤 + 1.5초 네온 하이라이트 ──
    private string? _highlightSceneId;
    private System.Threading.Timer? _hlTimer;
    private async Task ScrollToCut(int index)
    {
        if (index < 0 || index >= _project.Scenes.Count) return;
        var id = _project.Scenes[index].Id;
        _highlightSceneId = id;
        StateHasChanged();
        try { await JS.InvokeVoidAsync("siteMaticUi.scrollToId", "cut-" + id, "center"); } catch { /* 스크롤 실패해도 하이라이트는 유지 */ }
        _hlTimer?.Dispose();
        _hlTimer = new System.Threading.Timer(_ => { _highlightSceneId = null; _ = InvokeAsync(StateHasChanged); }, null, 1500, System.Threading.Timeout.Infinite);
    }

    // ── 스위치 역할 실시간 가이드 토스트(6초 자동 소멸) ──
    private SwitchGuide? _switchGuide;
    private System.Threading.Timer? _guideTimer;
    private void ShowSwitchGuide(string key)
    {
        var g = Guides.Get(key);
        if (g is null) return;
        _switchGuide = g;
        _guideTimer?.Dispose();
        _guideTimer = new System.Threading.Timer(_ => { _switchGuide = null; _ = InvokeAsync(StateHasChanged); }, null, 6000, System.Threading.Timeout.Infinite);
    }
    private static string ShortName(SafePlatform p) => p switch
    {
        SafePlatform.YouTubeShorts => "숏츠",
        SafePlatform.InstagramReels => "릴스",
        SafePlatform.TikTok => "틱톡",
        _ => "Off",
    };

    // 컷 카드 세이프존 가이드(전 컷 썸네일 오버레이) — 토글은 로컬(UserPreference)에 기억. 플랫폼 미선택 시 숏츠 기준으로 가이드.
    private bool _cardGuide;
    private bool CardGuide { get => _cardGuide; set { _cardGuide = value; Prefs.SetBool(UserPreferenceService.Keys.CutCardSafeZone, value); } }
    private SafePlatform EffectiveCardPlatform => _project.TargetPlatform == SafePlatform.None ? SafePlatform.YouTubeShorts : _project.TargetPlatform;
    // 오디오 텐션 파형의 BGM 덕킹 표시 조건(BGM + 덕킹 ON).
    private bool _hasBgmDuck => !string.IsNullOrWhiteSpace(_project.BgmPath) && _project.EnableAudioDucking;
    private string? _toast;

    // 유튜브 메타데이터 모달
    private YoutubeMetadata? _meta;
    private bool _metaOpen;
    private List<string> _tags = new();   // 모달에서 편집 가능한 태그(칩)
    private string _newTag = "";

    // 글로벌 다국어 번역 & SEO
    private string _locLang = "EN";
    private bool _locBusy;
    private LocalizedMetadata? _locResult;
    private bool _locOpen;

    // 유튜브 업로드
    private bool _ytBusy;
    private int _ytPct;

    // 숏츠 커버 썸네일
    private bool _coverBusy;
    private string _coverColor = "yellow";
    private bool _coverBox = true;
    private string? _coverUrl;    // 미리보기 URL(가상호스트 + 캐시버스터)
    private string? _coverPath;   // 저장 절대경로

    // 대본 위저드 / 앵커
    private bool _wizardOpen;
    private bool _agencyOpen;   // AI 콘텐츠 에이전시(트렌드 + Swarm) 모달
    private bool _babyGalleryOpen;   // 아기 숏츠 원클릭 테마 갤러리 모달
    private bool _b2bGalleryOpen;    // B2B 기업/장비 전용 갤러리 모달(독립)
    private bool _weatherGalleryOpen; // v4.5.0 날씨/환경 테마 갤러리 모달(기후×시간대×강도 48종)
    private bool _hyperOpen;         // v5.3.5 초개인화 아기 하이퍼 스튜디오 전용 모달(테마 백과사전에서 분리)
    private bool _pitchOpen;         // v3.2.0 B2B 바이어 피치 모드(전체화면 발표)
    private bool _osmuOpen;          // OSMU 멀티 플랫폼 내보내기 모달
    private bool _characterOpen;     // v16.22.0 캐릭터 스튜디오 모달
    private bool _dubbingOpen;       // v16.24.0 글로벌 다국어 더빙 스튜디오 모달
    private bool _interactiveOpen;   // v16.26.0 인터랙티브 분기 & 쇼핑 스튜디오 모달
    private bool _enterpriseOpen;    // v16.27.0 엔터프라이즈 팀 & 렌더 팜 모달
    private bool _masterOpen;        // v16.30.0 마스터 엔터프라이즈 스튜디오
    private bool _spatialOpen;       // v16.31.0 공간 비디오 & Vision Pro 스튜디오
    private bool _virtualOpen;       // v16.32.0 AI 버추얼 프로덕션 & UE5 스튜디오
    private bool _soundOpen;         // v16.33.0 AI 사운드 디자인 & Dolby Atmos 스튜디오
    private bool _vfxOpen;           // v16.34.0 AI VFX 조명 & 8K 업스케일 스튜디오
    private bool _screenplayOpen;    // v16.35.0 AI 시나리오 & 세계관 스튜디오
    private bool _twinOpen;          // v16.36.0 AI 디지털 트윈 & 모캡 스튜디오
    private bool _mvOpen;            // v16.37.0 AI 뮤직비디오 & 안무 스튜디오
    private bool _mediaStudioOpen; // v16.57.0 오토 최적화 미디어 스튜디오
    private bool _autoTune = true;   // v16.57.0 ✨ AI 최적화 자동 셋팅(기본 ON)
    private readonly Dictionary<string, AutoPreset> _presets = new(StringComparer.Ordinal);
    private readonly Dictionary<string, MediaIngestResult> _sceneMedia = new(StringComparer.Ordinal);
    private readonly Dictionary<string, int> _uploadProgress = new(StringComparer.Ordinal);

    private void ToggleAutoTune()
    {
        _autoTune = !_autoTune;
        if (_autoTune) foreach (var s in _project.Scenes) OnPromptEdited(s);
    }

    /// <summary>프롬프트 입력 즉시 오토 튜닝(빈 필드만 자동 채움 · 본문 미변경). 업로드 미디어가 있으면 비전 통계 결합.</summary>
    private void OnPromptEdited(StoryboardScene s)
    {
        if (!_autoTune || Jobs.IsRunning) return;
        var p = _sceneMedia.TryGetValue(s.Id, out var m) && s.ImagePath == m.EffectivePath ? Tuner.Tune(s.Prompt, m) : Tuner.Tune(s.Prompt);
        _presets[s.Id] = p;
        AutoPresetContextTuner.ApplyToScene(s, p);
    }

    private void AutoTuneScene(StoryboardScene s, MediaIngestResult media)
    {
        _sceneMedia[s.Id] = media;
        var p = Tuner.Tune(s.Prompt, media);
        _presets[s.Id] = p;
        AutoPresetContextTuner.ApplyToScene(s, p);
        AutoPresetContextTuner.ApplyToProject(_project, p);
    }

    private void ApplyTunedPrompt(StoryboardScene s)
    {
        if (Jobs.IsRunning || !_presets.TryGetValue(s.Id, out var p)) return;
        AutoPresetContextTuner.ApplyToScene(s, p, replacePrompt: true);
    }

    // v16.25.0 24/7 AI 라이브 스튜디오 — 최종 영상을 루프 플레이리스트에 추가(중복은 무시) 후 이동.
    private void OpenLiveStudio() { LiveLoop.AddToPlaylist(_project.FinalVideoPath); Nav.NavigateTo("live-studio"); }

    /// <summary>v16.22.0 측정된 컷 정합성 평균(무할당 순회).</summary>
    private (double Avg, int Count) IdentityAverage()
    {
        double sum = 0;
        var n = 0;
        foreach (var s in _project.Scenes) if (s.IdentityConfidence is double c) { sum += c; n++; }
        return (n == 0 ? 0 : sum / n, n);
    }

    private void OnCharacterApplied(CharacterProfile p)
    {
        _anchorThumb = null;
        ShowToast("👶 '" + p.Name + "' 캐릭터 고정 — 다음 생성부터 전 컷에 적용됩니다.");
    }

    private void ReleaseCharacterLock()
    {
        if (Jobs.IsRunning || Jobs.IsMerging) return;
        _project.CharacterLock = null;
        foreach (var s in _project.Scenes) s.IdentityConfidence = null;
        ShowToast("🔓 캐릭터 고정 해제(앵커 이미지는 유지 — 필요 시 앵커도 해제하세요).");
    }

    private void OpenEpisodeProject(string path)
    {
        if (Jobs.IsRunning || Jobs.IsMerging) { ShowToast("⚠ 생성 중에는 다른 프로젝트를 열 수 없습니다."); return; }
        var loaded = Repo.Load(path);
        if (loaded is null) { ShowToast("❌ 에피소드 프로젝트를 열 수 없습니다."); return; }
        _project = loaded;
        _characterOpen = false;
        _anchorThumb = null;
        Recents.Touch(path, _project.Title);
        ShowToast("📚 '" + _project.Title + "' 열기 · " + _project.Scenes.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) + "컷 · 캐릭터 고정됨");
    }
    private bool _thumbBusy;         // 자동 썸네일 생성 중
    private string? _thumbUrl;       // 생성된 썸네일 미리보기 URL
    private string _wizardInput = "";
    private string? _anchorThumb;

    // v5.6.7: 실측 결과(완료된 첫 컷 포스터) 첫 프레임 + 갤러리 즉시 등록.
    private string? StoryboardActualUrl => _project.Scenes.FirstOrDefault(s => s.Status == SceneStatus.Completed && !string.IsNullOrEmpty(s.PosterUrl))?.PosterUrl;

    // v5.7.0: 앵커 vs 실측 결과 프레임 dHash 정체성 유지율(%). 입력(앵커/포스터 경로) 동일 시 재디코드 안 함(메모).
    private string? _scoreKey;
    private double? _identityScore;
    private double? IdentityScore
    {
        get
        {
            var anchor = _project.AnchorImagePath;
            var poster = _project.Scenes.FirstOrDefault(s => s.Status == SceneStatus.Completed && !string.IsNullOrEmpty(s.PosterPath))?.PosterPath;
            var key = (anchor ?? "") + "|" + (poster ?? "");
            if (key == _scoreKey) return _identityScore;
            _scoreKey = key;
            _identityScore = string.IsNullOrEmpty(anchor) || string.IsNullOrEmpty(poster)
                ? null : IdentityHashAnalyzer.ScoreFiles(anchor, poster);
            // v5.7.1 자율 피드백 루프: 유지율 80% 미만 → 가드레일 자동 Strict 격상(키당 1회 · On일 때 실효).
            if (_identityScore is double s && s < 80.0 && Prefs.QualityGuardrailPreset != QualityGuardrailPreset.Strict)
                Prefs.QualityGuardrailPreset = QualityGuardrailPreset.Strict;
            return _identityScore;
        }
    }
    private void RegisterActualToGallery()
    {
        var url = _project.FinalVideoPath is not null ? Media.ToPlaybackUrl(_project.FinalVideoPath)
                : _project.Scenes.FirstOrDefault(s => s.Status == SceneStatus.Completed && s.VideoUrl is not null)?.VideoUrl;
        if (!string.IsNullOrEmpty(url)) Gallery.Register(_project, GalleryAssetKind.Video, url!, "실측 검증");
    }

    // 브랜드 워터마크 / 스마트 SFX
    private string? _watermarkThumb;   // 미리보기 URL(가상호스트)
    private bool _sfxAvailable;        // Sfx 폴더에 효과음이 있는지(체크박스 힌트용 · OnInitialized 1회 계산)

    // 4K 업스케일 / STT
    private bool _upBusy;
    private double _upPct;
    private string _upStatus = "준비";
    private string? _upResult;
    private string? _up4kPath;
    private string _upEngine = "RealEsrgan";
    private bool _sttBusy;

    /// <summary>배속 select 바인딩용 문자열 래퍼(문화권 무관 — 항상 '.' 소수점).</summary>
    private string SpeedStr
    {
        get => Inv(_project.PlaybackSpeed);
        set { if (double.TryParse(value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v)) _project.PlaybackSpeed = v; }
    }
    private static string Inv(double d) => d.ToString(System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>BGM 음량 슬라이더 바인딩(정수 % ↔ 0.0~1.0). range 는 정수라 로캘 소수점 이슈 없음.</summary>
    private int BgmVolPct
    {
        get => (int)Math.Round(_project.BgmVolume * 100);
        set => _project.BgmVolume = Math.Clamp(value, 0, 100) / 100.0;
    }

    /// <summary>선택 해상도가 세로(쇼츠) 비율인지 — 세이프존 토글/오버레이는 세로에서만 의미.</summary>
    private bool IsPortrait { get { var (w, h) = StoryboardProject.ParseResolution(_project.ExportResolution); return h > w; } }

    /// <summary>새 프로젝트(비어 있는 컷 1개 · 앵커/완료 없음)면 시작 안내 카드를 노출.</summary>
    private bool IsFreshProject => !Jobs.IsRunning && Jobs.CompletedCount == 0
        && _project.Scenes.Count <= 1
        && _project.Scenes.All(s => string.IsNullOrWhiteSpace(s.Prompt) && string.IsNullOrWhiteSpace(s.VoiceText) && s.ImagePath is null)
        && string.IsNullOrEmpty(_project.AnchorImagePath);
    private System.Threading.Timer? _toastTimer;

    // 생성할 컷이 하나라도 남아 있어야 시작 가능.
    private bool CanStart => Cfg.IsConfigured && !Jobs.IsRunning
        && _project.Scenes.Any(s => s.Status != SceneStatus.Completed);

