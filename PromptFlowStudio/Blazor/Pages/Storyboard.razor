    /// <summary>선택 컷 분할 — 나레이션을 중앙(스냅 ON 이면 가장 가까운 문장 경계)에서 나눠 동일 설정의 다음 컷을 삽입.</summary>
    // v18.2.0 🎞 샷 분할 시퀀서(컴포넌트 소유 · 브리지는 버퍼를 0-카피 공유) — 나레이션 우선, 없으면 프롬프트.
    private readonly PromptFlowStudio.Services.Storyboard.StoryboardKeyframeSequencer _shotSeq = new();
    private readonly System.Text.StringBuilder _shotScript = new(1024);
    private string? _shotMsg;

    private static string ShotSec(int ms) => (ms / 1000.0).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);

    private void RefreshShots()
    {
        _shotScript.Clear();
        foreach (var s in _project.Scenes)
        {
            var line = string.IsNullOrWhiteSpace(s.VoiceText) ? s.Prompt : s.VoiceText;
            if (string.IsNullOrWhiteSpace(line)) continue;
            if (_shotScript.Length > 0) _shotScript.Append((char)10);
            _shotScript.Append(line.Trim());
        }
        var buf = System.Buffers.ArrayPool<char>.Shared.Rent(Math.Max(1, _shotScript.Length));
        try
        {
            _shotScript.CopyTo(0, buf, 0, _shotScript.Length);
            _shotSeq.Load(buf.AsSpan(0, _shotScript.Length));
        }
        finally { System.Buffers.ArrayPool<char>.Shared.Return(buf); }
        _shotMsg = _shotSeq.Count == 0 ? "샷 분할 실패 — 나레이션 또는 프롬프트를 입력하세요" : null;
    }

    /// <summary>v18.2.0 🎬 숏폼 팩토리로 시퀀스 전송 — 재분할 후 브리지 Push(레이아웃이 팩토리 ① 탭을 열고 모달이 수화).</summary>
    private void SendShotsToFactory()
    {
        RefreshShots();
        if (_shotSeq.Count == 0) return;
        _shotMsg = ShotBridge.Push(_shotSeq) ? "· ✅ 숏폼 팩토리로 전송됨" : "· ⚠ 전송 실패";
    }

    private void SplitSelected()
    {
        var s = _selScene;
        if (s is null || Jobs.IsRunning) return;
        var idx = _project.Scenes.IndexOf(s);
        if (idx < 0) { _selScene = null; return; }
        var text = s.VoiceText ?? "";
        var cut = text.Length / 2;
        if (_snap && text.Length > 1)
        {
            var best = -1;
            for (var k = 0; k < text.Length - 1; k++)
                if (text[k] is '.' or '!' or '?' or '。' or '\n' && (best < 0 || Math.Abs(k + 1 - text.Length / 2) < Math.Abs(best - text.Length / 2))) best = k + 1;
            if (best > 0) cut = best;
        }
        var n = new StoryboardScene
        {
            Mode = s.Mode, Prompt = s.Prompt, Size = s.Size, NegativePrompt = s.NegativePrompt, VoiceText = text[cut..].Trim(),
            UseLipSync = s.UseLipSync, Emotion = s.Emotion, EmotionIntensity = s.EmotionIntensity,
            ImagePath = s.ImagePath, ThumbUrl = s.ThumbUrl, ImageName = s.ImageName,
        };
        s.VoiceText = text[..cut].Trim();
        _project.Scenes.Insert(idx + 1, n);
        _selScene = n;
    }

