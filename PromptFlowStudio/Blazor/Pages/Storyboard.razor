    // ── BGM ──
    private async Task OnBgmPicked(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        const long maxSize = 30L * 1024 * 1024;   // 30MB
        if (file.Size > maxSize) { ShowToast("❌ BGM 파일이 너무 큽니다(최대 30MB)."); return; }
        try
        {
            var dir = Path.Combine(Media.MediaRoot, "_uploads", "bgm");
            Directory.CreateDirectory(dir);
            var name = SanitizeFileName(file.Name);
            if (string.IsNullOrWhiteSpace(Path.GetExtension(name))) name += ".mp3";
            var savePath = Path.Combine(dir, name);

            await using (var src = file.OpenReadStream(maxSize))
            await using (var dst = new FileStream(savePath, FileMode.Create, FileAccess.Write, FileShare.None, 81920, FileOptions.Asynchronous))
                await src.CopyToAsync(dst);

            _project.BgmPath = savePath;
            ShowToast($"🎵 BGM 추가됨 — {name}");
        }
        catch (Exception ex) { ShowToast("❌ BGM 추가 실패: " + ex.Message); }
    }

    private void ClearBgm() => _project.BgmPath = null;   // 파일은 남겨둠(재사용 가능) · 경로만 해제

    private static string SanitizeFileName(string n)
    {
        foreach (var c in Path.GetInvalidFileNameChars()) n = n.Replace(c, '_');
        return n;
    }

