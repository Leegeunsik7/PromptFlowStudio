    // ── v4.5.0 날씨/환경 테마 적용 — 갤러리에서 프리셋 선택 시 호출(모달 닫기 + 프로젝트 기상 구성 + 빈 컷 시네마틱 프롬프트 주입) ──
    private void ApplyWeatherTheme(WeatherPreset p)
    {
        if (Jobs.IsRunning || Jobs.IsMerging) { ShowToast("생성/병합 중에는 적용할 수 없습니다."); return; }
        _weatherGalleryOpen = false;
        if (p is null) return;

        _project.Weather = WeatherThemeConfig.FromPreset(p);   // Enabled=true · 기후/시간대/강도 반영
        _project.SpatialAudio = true;                          // 렌더 시 입체 앰비언스(빗소리/바람) 합성

        // 아직 비어 있는 컷에만 시네마틱 프롬프트를 주입(기존 사용자 프롬프트는 보존).
        var filled = 0;
        foreach (var s in _project.Scenes)
            if (string.IsNullOrWhiteSpace(s.Prompt)) { s.Prompt = Weather.SynthesizePrompt(_project.Weather); filled++; }

        var climate = WeatherThemeCatalog.ClimateLabel(p.Climate);
        var inject = filled > 0 ? $" · 빈 컷 {filled}개에 시네마틱 프롬프트 주입" : "";
        ShowToast($"☁️ 날씨 테마 «{p.Title}» 적용 — 기후 {climate}·강도 {p.Intensity}{inject}. 렌더 시 입체 앰비언스가 합성됩니다.");
        StateHasChanged();
    }

    // ── 원클릭 즉시 생성 — 아기 사진 레퍼런스 연동(+1:1 오토 크롭) + 테마 구성 + 원스톱 생성 시작 ──
    private async Task InstantStartBabyTheme(ThemeInstantRequest req)
    {
        if (Jobs.IsRunning || Jobs.IsMerging) { ShowToast("생성/병합 중에는 시작할 수 없습니다."); return; }

        // ① 새 사진을 골랐다면 등록 + 1:1 정중앙 오토 크롭 → 전 컷 I2V 레퍼런스로 바인딩.
        if (req.Photo is not null)
        {
            var reg = await Anchor.RegisterAsync(req.Photo);
            if (reg.Ok && reg.Path is not null)
            {
                var crop = await FaceCropper.CropSquareAsync(reg.Path);
                _project.AnchorImagePath = crop.Cropped && crop.Path is not null ? crop.Path : reg.Path;
                _anchorThumb = Anchor.ThumbUrl(_project);
                ShowToast(crop.Cropped ? "👶 아기 얼굴 1:1 오토 크롭 등록 — 전 컷 I2V 유지" : "👶 아기 얼굴 레퍼런스 등록 — 전 컷 I2V 유지");
            }
        }
        // (req.AllowT2v == true 이거나 사진이 없으면 앵커 없이 T2V 로 Graceful 진행)

        // ② 테마 구성 + 즉시 시작(원스톱).
        ApplyBabyTheme((req.Key, req.Format));        // 테마 구성 + 모달 닫기 + 토스트
        if (_project.Scenes.Count == 0) return;       // 적용 실패면 중단
        if (CanStart)
        {
            StartAll();                               // fire-and-forget 전체 생성 → 오디오 → 세이프존 → 렌더링
            var mode = Anchor.HasAnchor(_project) ? "아기 얼굴 유지(I2V)" : "텍스트(T2V)";
            ShowToast($"🚀 «{_project.Title}» 즉시 생성 시작 — {_project.Scenes.Count}컷 · {mode} 원스톱 실행.");
        }
        else
        {
            ShowToast("⚙️ 테마는 구성됐어요. Wan API 키 설정 후 [✨ 영상 제작 시작]을 눌러 시작하세요.");
        }
    }

