    private int? _dragIndex;   // 드래그 중인 컷 인덱스
    private int? _dragOver;    // 현재 드롭 대상(하이라이트)
    private void OnDragStart(int i) { if (!Jobs.IsRunning) _dragIndex = i; }
    private void OnDragEnter(int i) { if (_dragIndex is not null && !Jobs.IsRunning) _dragOver = i; }
    private void OnDragEnd() { _dragIndex = null; _dragOver = null; }
    private void OnDrop(int target)
    {
        var from = _dragIndex;
        OnDragEnd();
        if (Jobs.IsRunning || from is null) return;
        var f = from.Value;
        if (f == target || f < 0 || f >= _project.Scenes.Count || target < 0 || target >= _project.Scenes.Count) return;
        var s = _project.Scenes[f];
        _project.Scenes.RemoveAt(f);
        var insertAt = Math.Clamp(f < target ? target - 1 : target, 0, _project.Scenes.Count);
        _project.Scenes.Insert(insertAt, s);
    }

