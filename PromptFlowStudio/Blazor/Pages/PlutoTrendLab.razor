@page "/pluto-trends"
@implements IDisposable
@using PromptFlowStudio.Services.Pluto
@inject PlutoTrendEngine Engine
@inject PlutoLearningService Learning
@inject PlutoSocialRadarEngine Radar
@inject PlutoIdentityVault IdentityVault
@inject PromptDraftService Draft
@inject NavigationManager Nav
@inject PromptFlowStudio.Services.Platform.IClipboardService Clipboard

@* [PromptFlow Studio] 🪐 플루토 트렌드 랩 — 4대 테마 트렌드 카드 · 🚀 스튜디오 주입 · 📋 해시태그 복사 · 👍/👎 즉시 학습 · 📈 SNS 트렌드 레이더(채널 공식 학습 +2 XP). *@

<div class="pl">
    <div class="pl-head">
        <h1 class="pl-title">🪐 플루토 <span class="pl-title-g">트렌드 랩</span></h1>
        <div class="pl-sub">플루토가 고른 쇼츠·릴스 트렌드 — 채택·내보내기·평가할수록 취향을 학습합니다.</div>
        <button class="pl-identity@(_identity is not null ? " on" : "")" data-pluto-identity-open="1" title="아기/반려동물 프로필 — 외모 특징이 새 트렌드 프롬프트에 캐릭터 일관성 앵커로 반영됩니다" @onclick="() => _identityModal = true">@(_identity is { } ip ? ip.FormatBadge(DateTime.Today) : "🍼 우리 아이 프로필 만들기")</button>
    </div>

    <div class="pl-brain" data-pluto-hud="1" title="채택 1 · 내보내기 3 · 👍 1 · 📈 SNS 공식 학습 2 XP — 10 XP 마다 레벨 업">
        @{ var xp = Learning.CurrentXP; var lv = PlutoLearningService.LevelFor(xp); var next = lv * PlutoLearningService.XpPerLevel; var floor = next - PlutoLearningService.XpPerLevel; var pct = (xp - floor) * 100 / PlutoLearningService.XpPerLevel; }
        <span>🧠 플루토 AI 두뇌: Lv.@(lv) (@(xp)/@(next) XP) · @(Learning.TotalInteractions)회 피드백 학습 완료</span>
        <div class="pl-brain-bar"><div class="pl-brain-fill" style="width:@(pct.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div></div>
    </div>

    <div class="pl-views" role="tablist" data-pluto-view-toggle="1">
        <button class="pl-view@(_view == LabView.Curation ? " on" : "")" role="tab" aria-selected="@(_view == LabView.Curation ? "true" : "false")" data-pluto-view="curation" @onclick="() => SwitchViewAsync(LabView.Curation)">🪐 플루토 큐레이션</button>
        <span class="pl-view-sep">|</span>
        <button class="pl-view@(_view == LabView.Radar ? " on" : "")" role="tab" aria-selected="@(_view == LabView.Radar ? "true" : "false")" data-pluto-view="radar" @onclick="() => SwitchViewAsync(LabView.Radar)">📈 실시간 SNS 트렌드 레이더</button>
    </div>

    @if (_view == LabView.Radar)
    {
        <div class="pl-radar" data-social-radar="1">
            <div class="pl-pills" role="tablist">
                <button class="pl-pill yt@(_radarPlatform == SocialPlatform.YouTubeShorts ? " on" : "")" role="tab" aria-selected="@(_radarPlatform == SocialPlatform.YouTubeShorts ? "true" : "false")" data-radar-tab="yt" @onclick="() => SwitchRadarAsync(SocialPlatform.YouTubeShorts)">🔴 YouTube Shorts 급상승 공식</button>
                <button class="pl-pill ig@(_radarPlatform == SocialPlatform.InstagramReels ? " on" : "")" role="tab" aria-selected="@(_radarPlatform == SocialPlatform.InstagramReels ? "true" : "false")" data-radar-tab="ig" @onclick="() => SwitchRadarAsync(SocialPlatform.InstagramReels)">🟣 Instagram Reels 감성 무드</button>
                <button class="pl-btn sm pl-radar-refresh" disabled="@_radarLoading" title="레이더 다시 스캔" @onclick="RefreshRadarAsync">🔄</button>
            </div>
            <div class="pl-fresh-note">@(_radarPlatform == SocialPlatform.YouTubeShorts ? "🔥 Trending YouTube Channel Formulas — 고유지율 훅 · 빠른 컷 페이싱 · 리플레이 루프" : "✨ Trending Instagram Reels Aesthetics — 웜 컬러 그레이딩 · 로파이 BGM · 감성 비네트")@(_radarLlm ? " · 🧠 Gemini 실시간 분석" : " · 📚 검증 벤치마크")</div>

            @if (_radarLoading)
            {
                <div class="pl-empty">📈 플루토가 SNS 트렌드를 스캔하는 중…</div>
            }
            else if (_insights.Count == 0)
            {
                <div class="pl-empty">표시할 SNS 트렌드가 없습니다.</div>
            }
            else
            {
                <div class="pl-grid">
                    @foreach (var ins in _insights)
                    {
                        var s = ins;
                        var learned = Radar.GetLearnedCount(s.Id);
                        <div class="pl-card pl-rcard" data-radar-insight="@s.Id">
                            <div class="pl-tags">
                                @if (s.Platform == SocialPlatform.YouTubeShorts) { <span class="pl-tag yt">🔴 YouTube Shorts</span> } else { <span class="pl-tag ig">🟣 Instagram Reels</span> }
                                <span class="pl-tag cat">@PlutoSocialRadarEngine.CategoryLabel(s.ChannelCategory)</span>
                                @if (s.FromLlm) { <span class="pl-tag gen">🧠 실시간</span> }
                                @if (learned > 0) { <span class="pl-w" title="플루토 채널 친숙도">🧠 학습 @(learned)회</span> }
                            </div>
                            <div class="pl-hook">@s.Title</div>
                            <div class="pl-mech" data-radar-mechanism="1">⚡ @s.ViralMechanism</div>
                            <div class="pl-meta"><span>🎥 @s.RecommendedPromptTags.Camera</span><span>⏱ @s.PacingGuideline</span><span>🎵 @PlutoSocialRadarEngine.BgmLabel(s.TrendingBgmStyle)</span></div>
                            <div class="pl-prompt">💡 @s.RecommendedPromptTags.SubjectAction · @s.RecommendedPromptTags.Lighting</div>
                            <div class="pl-htags">@string.Join(" ", s.ViralHashtagSet)</div>
                            <div class="pl-actions">
                                <button class="pl-btn" data-radar-learn="@s.Id" disabled="@_learningBusy" @onclick="() => LearnStyleAsync(s)">🧠 플루토 학습 (+2 XP)</button>
                                <button class="pl-btn go" data-radar-apply="@s.Id" @onclick="() => ApplyInsight(s)">🚀 이 공식으로 스튜디오 제작</button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
    <div class="pl-pills" role="tablist">
        @foreach (var cat in PlutoTrendEngine.Categories)
        {
            var c = cat;
            <button class="pl-pill@(c == _category ? " on" : "")" role="tab" aria-selected="@(c == _category ? "true" : "false")" data-pluto-cat="@((int)c)" @onclick="() => SwitchAsync(c)">@PlutoTrendEngine.Label(c)</button>
        }
    </div>

    <div class="pl-discover">
        <button class="pl-btn go" data-pluto-discover="1" disabled="@(_loading || !Engine.CanDiscover)" @onclick="DiscoverAsync">✨ 플루토에게 새로운 트렌드 발굴 요청</button>
        @if (_fresh) { <span class="pl-fresh-note">🧬 계절·시간대 + 학습된 프롬프트 DNA 로 방금 합성한 카드예요</span> }
    </div>

    @if (_loading)
    {
        <div class="pl-empty">🪐 플루토가 트렌드를 고르는 중…</div>
    }
    else if (_trends.Count == 0)
    {
        <div class="pl-empty">추천할 트렌드가 없습니다.</div>
    }
    else
    {
        <div class="pl-grid">
            @foreach (var tr in _trends)
            {
                var t = tr;
                <div class="pl-card" data-pluto-trend="@t.Id">
                    <div class="pl-tags">
                        @if ((t.Platforms & SocialPlatform.YouTubeShorts) != 0) { <span class="pl-tag yt">🔴 YouTube Shorts</span> }
                        @if ((t.Platforms & SocialPlatform.InstagramReels) != 0) { <span class="pl-tag ig">🟣 Instagram Reels</span> }
                        @if (t.Id.StartsWith(PlutoGenerativeEngine.IdPrefix, StringComparison.Ordinal)) { <span class="pl-tag gen">✨ 플루토 생성</span> }
                        <span class="pl-w" title="플루토 학습 가중치">⚖ @(Learning.GetWeight(t.Id).ToString("+0.00;-0.00;0.00", System.Globalization.CultureInfo.InvariantCulture))</span>
                    </div>
                    <div class="pl-hook">@t.ViralHook</div>
                    <div class="pl-name">@t.Title</div>
                    <div class="pl-prompt" title="@t.VideoPrompt">@Excerpt(t.VideoPrompt)</div>
                    <div class="pl-meta"><span>🎥 @t.CameraMotion</span><span>🎵 @t.BgmStyle</span></div>
                    <div class="pl-actions">
                        <button class="pl-btn go" @onclick="() => ApplyAsync(t)">🚀 스튜디오로 바로 적용</button>
                        <button class="pl-btn" @onclick="() => CopyTags(t)">📋 해시태그 복사</button>
                        <button class="pl-btn sm" title="좋아요 — 플루토에게 알려주기" @onclick="() => RateAsync(t, InteractionType.ThumbsUp)">👍</button>
                        <button class="pl-btn sm" title="별로예요 — 덜 추천" @onclick="() => RateAsync(t, InteractionType.ThumbsDown)">👎</button>
                    </div>
                </div>
            }
        </div>
    }
    }

    @if (_toast is { } msg) { <div class="pl-toast" role="status">@msg</div> }
</div>

<PlutoIdentityModal Open="_identityModal" Vault="IdentityVault" OnClose="() => _identityModal = false" OnSaved="OnIdentitySaved" />

<style>
    .pl { padding: 24px 28px; max-width: 1280px; }
    .pl-title { font-size: 26px; font-weight: 900; margin: 0; }
    .pl-title-g { background: linear-gradient(135deg,#8b7bff,#ff7bc6); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .pl-sub { opacity: .75; margin-top: 6px; font-size: 14px; }
    .pl-identity { margin-top: 10px; padding: 6px 14px; border-radius: 999px; border: 1px dashed rgba(244,114,182,.55); background: transparent; color: inherit; font-weight: 800; font-size: 13px; cursor: pointer; }
    .pl-identity.on { border-style: solid; background: rgba(244,114,182,.14); color: #f472b6; }
    .pl-brain { margin-top: 14px; padding: 10px 14px; border-radius: 14px; background: linear-gradient(90deg, rgba(167,139,250,.18), rgba(244,114,182,.14)); border: 1px solid rgba(167,139,250,.35); font-size: 14px; font-weight: 600; }
    .pl-brain-bar { margin-top: 6px; height: 6px; border-radius: 3px; background: rgba(255,255,255,.12); overflow: hidden; }
    .pl-brain-fill { height: 100%; background: linear-gradient(90deg, #a78bfa, #f472b6); transition: width .4s ease; }
    .pl-views { display: flex; gap: 6px; align-items: center; margin-top: 16px; }
    .pl-view { padding: 8px 14px; border-radius: 10px; border: 0; background: transparent; color: inherit; font-weight: 800; font-size: 14px; cursor: pointer; opacity: .6; }
    .pl-view.on { opacity: 1; background: rgba(139,123,255,.16); color: #8b7bff; }
    .pl-view-sep { opacity: .35; }
    .pl-pill.yt.on { background: linear-gradient(135deg,#ef4444,#f97316); }
    .pl-pill.ig.on { background: linear-gradient(135deg,#a855f7,#ec4899); }
    .pl-radar-refresh { margin-left: auto; }
    .pl-tag.cat { background: rgba(148,163,184,.15); }
    .pl-mech { display: inline-block; align-self: flex-start; font-size: 12px; font-weight: 800; padding: 4px 10px; border-radius: 999px; background: rgba(251,191,36,.15); color: #d97706; }
    .pl-htags { font-size: 12px; opacity: .65; word-break: break-all; }
    .pl-pills { display: flex; gap: 8px; flex-wrap: wrap; margin: 18px 0; }
    .pl-pill { padding: 8px 16px; border-radius: 999px; border: 1px solid var(--line,rgba(148,163,184,.3)); background: transparent; color: inherit; font-weight: 800; cursor: pointer; }
    .pl-pill.on { background: linear-gradient(135deg,#8b7bff,#6d5efc); color: #fff; border-color: transparent; }
    .pl-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 14px; }
    .pl-card { border: 1px solid var(--line,rgba(148,163,184,.25)); border-radius: 14px; padding: 16px; display: flex; flex-direction: column; gap: 8px; }
    .pl-tags { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
    .pl-tag { font-size: 11px; font-weight: 800; padding: 3px 8px; border-radius: 6px; }
    .pl-tag.yt { background: rgba(239,68,68,.15); color: #ef4444; }
    .pl-tag.ig { background: rgba(168,85,247,.15); color: #a855f7; }
    .pl-tag.gen { background: rgba(244,114,182,.15); color: #f472b6; }
    .pl-discover { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-bottom: 14px; }
    .pl-fresh-note { font-size: 12px; opacity: .75; }
    .pl-w { margin-left: auto; font-size: 11px; opacity: .6; }
    .pl-hook { font-size: 17px; font-weight: 900; }
    .pl-name { font-size: 12px; opacity: .7; }
    .pl-prompt { font-size: 13px; opacity: .85; }
    .pl-meta { display: flex; gap: 12px; flex-wrap: wrap; font-size: 12px; opacity: .75; }
    .pl-actions { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 4px; }
    .pl-btn { padding: 8px 12px; border-radius: 10px; border: 1px solid var(--line,rgba(148,163,184,.25)); background: transparent; color: inherit; font-weight: 800; font-size: 13px; cursor: pointer; }
    .pl-btn.go { border: 0; color: #fff; background: linear-gradient(135deg,#8b7bff,#6d5efc); }
    .pl-btn.sm { padding: 8px 10px; }
    .pl-empty { opacity: .7; padding: 40px 0; text-align: center; }
    .pl-toast { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); background: rgba(15,23,42,.92); color: #fff; padding: 10px 18px; border-radius: 10px; font-weight: 700; z-index: 50; }
    @@media (max-width: 900px) { .pl-grid { grid-template-columns: 1fr; } }
</style>

@code {
    private StudioThemeCategory _category = StudioThemeCategory.BabyParenting;
    private IReadOnlyList<PlutoTrend> _trends = Array.Empty<PlutoTrend>();
    private bool _loading = true;
    private bool _fresh;
    private string? _toast;
    private System.Threading.Timer? _toastTimer;
    private readonly CancellationTokenSource _cts = new();
    private PlutoIdentityProfile? _identity;
    private bool _identityModal;

    // ── 📈 SNS 트렌드 레이더 ──
    private enum LabView { Curation, Radar }
    private LabView _view = LabView.Curation;
    private SocialPlatform _radarPlatform = SocialPlatform.YouTubeShorts;
    private IReadOnlyList<SocialTrendInsight> _insights = Array.Empty<SocialTrendInsight>();
    private readonly Dictionary<SocialPlatform, IReadOnlyList<SocialTrendInsight>> _radarCache = new();
    private readonly Dictionary<SocialPlatform, bool> _radarLlmCache = new();
    private bool _radarLoading;
    private bool _radarLlm;
    private bool _learningBusy;

    protected override async Task OnInitializedAsync()
    {
        Learning.Changed += OnLearningChanged;
        Radar.Changed += OnLearningChanged;
        try { await Learning.EnsureLoadedAsync(_cts.Token); }   // 🧠 HUD 레벨/XP 표시용 메모리 선적재
        catch (OperationCanceledException) { }
        catch (Exception ex) { Program.Log("PlutoTrendLab.Brain", ex); }
        try { _identity = await IdentityVault.GetActiveProfileAsync(_cts.Token); }   // 🍼 프로필 칩 표시용
        catch (OperationCanceledException) { }
        catch (Exception ex) { Program.Log("PlutoTrendLab.Identity", ex); }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _fresh = false;
        try { _trends = await Engine.GetCuratedTrendsAsync(_category, _cts.Token); }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Program.Log("PlutoTrendLab.Load", ex); _trends = Array.Empty<PlutoTrend>(); }
        finally { _loading = false; }
    }

    /// <summary>✨ 생성형 엔진으로 새 카드 4건 합성(실패 시 엔진이 고정 카탈로그로 폴백).</summary>
    private async Task DiscoverAsync()
    {
        if (_loading) return;
        _loading = true;
        try { _trends = await Engine.DiscoverFreshTrendsAsync(_category, 4, _cts.Token); _fresh = true; }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Program.Log("PlutoTrendLab.Discover", ex); }
        finally { _loading = false; }
        if (_fresh) Toast("✨ 플루토가 새로운 트렌드 " + _trends.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) + "개를 발굴했어요");
    }

    private async Task SwitchAsync(StudioThemeCategory c)
    {
        if (c == _category && !_loading) return;
        _category = c;
        await LoadAsync();
    }

    private async Task SwitchViewAsync(LabView v)
    {
        if (_view == v) return;
        _view = v;
        if (v == LabView.Radar) await LoadRadarAsync(false);
    }

    private async Task SwitchRadarAsync(SocialPlatform p)
    {
        if (_radarPlatform == p && _insights.Count > 0) return;
        _radarPlatform = p;
        await LoadRadarAsync(false);
    }

    private Task RefreshRadarAsync() => LoadRadarAsync(true);

    /// <summary>📈 플랫폼 인사이트 적재(Gemini 우선 · 엔진이 벤치마크로 무중단 폴백) — 플랫폼별 캐시.</summary>
    private async Task LoadRadarAsync(bool force)
    {
        if (_radarLoading) return;
        var p = _radarPlatform;
        if (!force && _radarCache.TryGetValue(p, out var cached))
        {
            _insights = cached;
            _radarLlm = _radarLlmCache.TryGetValue(p, out var l) && l;
            return;
        }
        _radarLoading = true;
        try
        {
            var list = await Radar.GetTrendingSocialInsightsAsync(p, _cts.Token);
            _radarCache[p] = list;
            _radarLlmCache[p] = Radar.LastUsedLlm;
            _insights = list;
            _radarLlm = Radar.LastUsedLlm;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Program.Log("PlutoTrendLab.Radar", ex); _insights = PlutoSocialRadarEngine.BenchmarksFor(p); _radarLlm = false; }
        finally { _radarLoading = false; }
    }

    /// <summary>🧠 채널 공식 학습 — 친숙도 가중치 영속 + XP +2.</summary>
    private async Task LearnStyleAsync(SocialTrendInsight s)
    {
        if (_learningBusy) return;
        _learningBusy = true;
        try
        {
            await Radar.LearnChannelStyleAsync(s.Id, _cts.Token);
            Toast("🧠 플루토가 '" + s.Title + "' 공식을 학습했어요 (+" + PlutoSocialRadarEngine.LearnXp.ToString(System.Globalization.CultureInfo.InvariantCulture) + " XP)");
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Program.Log("PlutoTrendLab.RadarLearn", ex); Toast("⚠ 학습 실패 — 다시 시도해 주세요"); }
        finally { _learningBusy = false; }
    }

    /// <summary>🚀 공식 → 작업실 프롬프트(주체·조명·훅·페이싱·카메라) + 감성 BGM 주입 후 이동.</summary>
    private void ApplyInsight(SocialTrendInsight s)
    {
        Draft.Send(s.BuildStudioPrompt());
        Draft.SendBgm(s.BgmTrack);
        Nav.NavigateTo("workspace");
    }

    private static string Excerpt(string s) => s.Length <= 110 ? s : s[..107] + "…";

    private async Task ApplyAsync(PlutoTrend t)
    {
        Draft.Send(PlutoTrendEngine.EnglishName(t.Category) + " theme, " + t.BuildStudioPrompt());   // 작업실 진입 시 프롬프트로 흡수
        Draft.SendPlutoTrend(t.Id);   // 🪐 내보내기 성공 시 ExportCompleted(+0.15) 보상 대상
        try { await Learning.RecordInteractionAsync(t.Id, InteractionType.Adopted, _cts.Token); }
        catch (Exception ex) when (ex is not OperationCanceledException) { Program.Log("PlutoTrendLab.Adopt", ex); }
        catch (OperationCanceledException) { }
        Nav.NavigateTo("workspace");
    }

    private void CopyTags(PlutoTrend t)
    {
        bool ok;
        try { ok = Clipboard.SetText(t.BuildCopyText()); }
        catch (Exception ex) { Program.Log("PlutoTrendLab.Copy", ex); ok = false; }
        Toast(ok ? "📋 제목 & 해시태그를 복사했어요" : "⚠ 복사 실패 — 다시 시도해 주세요");
    }

    private async Task RateAsync(PlutoTrend t, InteractionType type)
    {
        try
        {
            await Learning.RecordInteractionAsync(t.Id, type, _cts.Token);
            Toast(type == InteractionType.ThumbsDown ? "👎 플루토가 덜 추천할게요" : "👍 플루토가 기억했어요");
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Program.Log("PlutoTrendLab.Rate", ex); }
    }

    private void Toast(string msg)
    {
        _toast = msg;
        _toastTimer?.Dispose();
        _toastTimer = new System.Threading.Timer(_ =>
        {
            _toast = null;
            try { _ = InvokeAsync(StateHasChanged); } catch (Exception ex) { Program.Log("PlutoTrendLab.Toast", ex); }
        }, null, 2500, System.Threading.Timeout.Infinite);
    }

    private void OnIdentitySaved(PlutoIdentityProfile? p)
    {
        _identity = p;
        _identityModal = false;
        Toast(p is null ? "🗑 우리 아이 프로필을 삭제했어요" : "💾 " + p.FormatBadge(DateTime.Today) + " — 새 트렌드에 캐릭터 앵커를 반영할게요");
    }

    private void OnLearningChanged()
    {
        try { _ = InvokeAsync(StateHasChanged); }
        catch (Exception ex) { Program.Log("PlutoTrendLab.Changed", ex); }
    }

    public void Dispose()
    {
        Learning.Changed -= OnLearningChanged;
        Radar.Changed -= OnLearningChanged;
        try { _cts.Cancel(); } catch (ObjectDisposedException) { }
        _cts.Dispose();
        _toastTimer?.Dispose();
        _toastTimer = null;
    }
}
