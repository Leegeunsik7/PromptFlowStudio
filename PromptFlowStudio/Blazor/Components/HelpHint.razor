@using PromptFlowStudio.Services.Help
@inject HelpState Help
@inject NavigationManager Nav

@* ═══════════════════════════════════════════════════════════════════════════
   페이지 제목 옆 미니 도움말 아이콘

   상단 헤더 버튼과 같은 드로어를 연다(HelpState 공유). 두 개를 둔 이유:
     · 상단 버튼 — 화면 어디서나 손에 닿는 상시 진입점
     · 이 아이콘 — "이 화면이 뭐 하는 데지?" 라는 의문이 생기는 바로 그 자리

   ⚠ 아이콘만 두면 장식으로 보인다. title 과 aria-label 에 화면 이름을 넣어
     "무엇에 대한 도움말인지" 가 마우스오버·스크린리더 양쪽에서 드러나게 한다.
   ══════════════════════════════════════════════════════════════════════════ *@

<button type="button" class="help-hint"
        title="@Tip"
        aria-label="@Tip"
        aria-expanded="@(Help.IsOpen ? "true" : "false")"
        @onclick="Help.Toggle"
        @onclick:stopPropagation="true">
    <span aria-hidden="true">?</span>
</button>

@code {
    /// <summary>제목을 직접 넘기고 싶을 때. 비워 두면 현재 URL 로 알아낸다.</summary>
    [Parameter] public string? For { get; set; }

    private string Tip
    {
        get
        {
            var t = string.IsNullOrWhiteSpace(For)
                ? HelpContent.ForPath(Nav.ToBaseRelativePath(Nav.Uri))
                : HelpContent.ForPath(For);
            return t is null
                ? "사용자 도움말 (F1)"
                : $"‘{t.Title}’ 사용법 보기 (F1)";
        }
    }
}
