@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private const int RadarSlots = 2 * SpatialAcousticsStudioRunner.Slots;
    private static readonly AcousticSurface[] Surfaces = { AcousticSurface.Floor, AcousticSurface.Ceiling, AcousticSurface.BackWall, AcousticSurface.WindowWall, AcousticSurface.SideWall, AcousticSurface.FrontWall, AcousticSurface.Pillars, AcousticSurface.Crates };
    private static readonly AcousticMaterial[] Materials = { AcousticMaterial.Concrete, AcousticMaterial.Wood, AcousticMaterial.Fabric, AcousticMaterial.Glass, AcousticMaterial.AcousticPanel, AcousticMaterial.Plaster };
    private System.Threading.Timer? _timer;

    private RealtimeAcousticRayTracingEngine T => Runner.Tracer;
    private Hrtf6DoFBinauralSpatialAudioSynthesizer S => Runner.Synth;
    private DopplerDiffractionOcclusionPhaseGuard G => Runner.Guard;
    private Vector3 Fwd => Vector3.Transform(Vector3.UnitZ, Runner.HeadOrientation);

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("SpatialAcoustics.Modal.Timer", ex); }
        }, null, 250, 250);
    }

    private static string Pct(double v) => (Math.Clamp(double.IsFinite(v) ? v : 0, 0, 1) * 100).ToString("0.##", CultureInfo.InvariantCulture) + "%";
    private static string F0(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "0" : v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0.00", CultureInfo.InvariantCulture);
    private static double Num(ChangeEventArgs e, double fallback) => double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : fallback;
    private static double Y(double v, double max, double h) => 2 + (h - 4) * Math.Clamp(v / max, 0, 1);
    private static double Db(double v) => 20 * Math.Log10(Math.Max(v, 1e-6));
    private static double Cents(double ratio) => 1200 * Math.Log2(Math.Max(ratio, 1e-6));
    private static string HzLabel(int k) { var hz = AcousticMaterials.CenterHz[k]; return hz >= 1000 ? (hz / 1000).ToString("0", CultureInfo.InvariantCulture) + " kHz" : hz.ToString("0", CultureInfo.InvariantCulture) + " Hz"; }

    private static string Px(float x) => F1((x - RealtimeAcousticRayTracingEngine.X0) * 30);
    private static string Pz(float z) => F1((z - RealtimeAcousticRayTracingEngine.Z0) * 30);
    private static string Pt(Vector3 p) => Px(p.X) + "," + Pz(p.Z);

    private string RayPoints(int r)
    {
        var n = T.VizCount(r);
        if (n < 2) return "";
        var sb = new System.Text.StringBuilder(n * 14);
        for (var k = 0; k < n; k++) sb.Append(Pt(T.VizPoint(r, k))).Append(' ');
        return sb.ToString();
    }

    private string DecayPoints(int band)
    {
        var sb = new System.Text.StringBuilder(RealtimeAcousticRayTracingEngine.DecayBins * 7);
        var d0 = T.DecayDb(0, band);
        for (var i = 0; i < RealtimeAcousticRayTracingEngine.DecayBins; i += 2)
            sb.Append(F1(360.0 * i / RealtimeAcousticRayTracingEngine.DecayBins)).Append(',').Append(F1(Y(d0 - T.DecayDb(i, band), 60, 110))).Append(' ');
        return sb.ToString();
    }

    private string EchoPoints()
    {
        var mx = -120.0;
        for (var i = 0; i < RealtimeAcousticRayTracingEngine.EchoBins; i++) mx = Math.Max(mx, T.EchoDb(i));
        var sb = new System.Text.StringBuilder(RealtimeAcousticRayTracingEngine.EchoBins * 12);
        var span = RealtimeAcousticRayTracingEngine.DecayBins * RealtimeAcousticRayTracingEngine.DecayBinMs;
        for (var i = 0; i < RealtimeAcousticRayTracingEngine.EchoBins; i++)
            sb.Append(F1(360.0 * i * RealtimeAcousticRayTracingEngine.EchoBinMs / span)).Append(',').Append(F1(Y(mx - T.EchoDb(i), 60, 110))).Append(' ');
        return sb.ToString();
    }

    private string Series(Func<int, float> f, double lo, double hi, double h)
    {
        var n = Runner.SeriesCount;
        if (n < 2) return "";
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = n - 1; i >= 0; i--)
            sb.Append(F1(360.0 * (n - 1 - i) / (SpatialAcousticsStudioRunner.SeriesLen - 1))).Append(',').Append(F1(h - Y(f(i) - lo, hi - lo, h))).Append(' ');
        return sb.ToString();
    }

    private string Scope(bool left)
    {
        var sb = new System.Text.StringBuilder(Hrtf6DoFBinauralSpatialAudioSynthesizer.ScopeLen * 12);
        for (var i = 0; i < Hrtf6DoFBinauralSpatialAudioSynthesizer.ScopeLen; i++)
            sb.Append(F1(360.0 * i / (Hrtf6DoFBinauralSpatialAudioSynthesizer.ScopeLen - 1))).Append(',').Append(F1(25 - 23 * Math.Clamp(left ? S.ScopeL(i) : S.ScopeR(i), -1f, 1f))).Append(' ');
        return sb.ToString();
    }

    private static string RadarClass(int i) => i % SpatialAcousticsStudioRunner.Slots == 0 ? (i == 0 ? "d0" : "d1") : (i < SpatialAcousticsStudioRunner.Slots ? "r0" : "r1");
    private static double RadarRadius(AcousticPath p) => 14 + 90 * Math.Clamp(p.LengthM / 343.0 * 1000.0 / 60.0, 0, 1);
    private string RadarX(int i, AcousticPath p) => F1(110 + RadarRadius(p) * Math.Sin(S.PathAzimuth(i) * Math.PI / 180));
    private string RadarY(int i, AcousticPath p) => F1(110 - RadarRadius(p) * Math.Cos(S.PathAzimuth(i) * Math.PI / 180));
    private static string RadarR(AcousticPath p) => F1(1.5 + 5 * Math.Clamp((Db(Math.Max(p.GainLow, p.GainHigh)) + 40) / 40, 0, 1));

    private void OnMaterial(AcousticSurface s, ChangeEventArgs e)
    {
        var v = (int)Num(e, (int)T.Material(s));
        if (v >= 0 && v < AcousticMaterials.Count) Runner.SetMaterial(s, (AcousticMaterial)v);
    }

    private void ToggleRun() { if (Runner.IsRunning) Runner.Stop(); else Runner.Start(); }
    private void Step30() { for (var i = 0; i < SpatialAcousticsStudioRunner.Hz / 2; i++) Runner.Step(); }

    private Task Close() => OnClose.InvokeAsync();

    /// <summary>가동 중 갱신은 250 ms 타이머가 처리 — 정지 상태 변경만 즉시 반영.</summary>
    private void OnServiceChanged() { if (!Runner.IsRunning) _ = InvokeAsync(StateHasChanged); }

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
