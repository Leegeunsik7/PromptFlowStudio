@inject MemberRegistryService Members
@inject SessionState Session
@implements IDisposable

@* [PromptFlowStudio] 관리자 자격 명부(RBAC) — 계정별 권한(Admin/Operator/Viewer) 부여·회수 + 관리자 빠른 추가.
   기존 MemberRegistryService(회원 원장 · PBKDF2 · GSLEE 시드) 재사용 — 이 명부의 Admin 권한이 실제로 /admin·환경설정 관리 기능을 통제한다. *@
<section class="ar-card">
    <div class="ar-head">
        <span class="ar-ico">🛡️</span>
        <div class="ar-hgrow">
            <div class="ar-title">관리자 자격 명부 (RBAC)</div>
            <div class="ar-desc"><b>Admin</b>=전체 관리 · <b>Operator</b>=운용 · <b>Viewer</b>=조회. 여기서 부여한 <b>Admin</b> 권한이 사용자 설정·환경설정 관리 기능 접근을 통제합니다.</div>
        </div>
    </div>

    <div class="ar-stats">
        <div class="ar-stat"><b>@Members.Count</b><span>등록 계정</span></div>
        <div class="ar-stat"><b>@_adminCount</b><span>관리자(Admin)</span></div>
        <div class="ar-stat"><b>@Members.PendingCount</b><span>승인 대기</span></div>
    </div>

    @if (_temp is { } t)
    {
        <div class="ar-temp">🔑 <b>@t.Item1</b> 임시 비밀번호: <b class="v">@t.Item2</b> — 사용자에게 안전하게 전달하세요.</div>
    }
    @if (_msg is not null)
    {
        <div class="ar-msg @(_msgOk ? "ok" : "bad")">@_msg</div>
    }

    <div class="ar-wrap">
        <table class="ar-tbl">
            <thead><tr><th>아이디</th><th>이름 · 연락처 · 소속</th><th>권한</th><th>상태</th><th>관리</th></tr></thead>
            <tbody>
                @foreach (var u in Members.Members)
                {
                    <tr>
                        <td class="ar-id">@u.Id</td>
                        <td>
                            <div><b>@u.Name</b><span class="ar-mut"> · @u.Email · @u.Phone</span></div>
                            @if (!string.IsNullOrWhiteSpace(u.Company)) { <div class="ar-mut2">🏢 @u.Company</div> }
                        </td>
                        <td>
                            <select class="ar-role @(u.Role == "Admin" ? "adm" : null)" value="@u.Role" @onchange="e => SetMemberRole(u.Id, e.Value?.ToString())">
                                <option value="Admin">Admin</option><option value="Operator">Operator</option><option value="Viewer">Viewer</option>
                            </select>
                        </td>
                        <td><span class="ar-bdg @StatusCls(u.Status)">@StatusKo(u.Status)</span></td>
                        <td class="ar-acts">
                            @if (u.Status == "pending")
                            {
                                <button class="ar-b ok" @onclick="() => Members.Approve(u.Id)">승인</button>
                            }
                            else
                            {
                                <button class="ar-b" @onclick="() => Members.ToggleStatus(u.Id)">@(u.Status == "active" ? "잠금" : "해제")</button>
                            }
                            <button class="ar-b" @onclick="() => Reset(u.Id)">비번 리셋</button>
                            @if (u.Role != "Admin")
                            {
                                <button class="ar-b del" @onclick="() => Members.Delete(u.Id)">삭제</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ── 관리자 빠른 추가 ── *@
    <div class="ar-add">
        <div class="ar-add-h">➕ 관리자 빠른 추가 <span>등록 즉시 Admin 권한 + 활성 상태로 생성됩니다.</span></div>
        <div class="ar-add-grid">
            <input class="ar-in" @bind="_nId" placeholder="아이디(3자+)" spellcheck="false" autocomplete="off" />
            <input class="ar-in" @bind="_nName" placeholder="이름" autocomplete="off" />
            <input class="ar-in" @bind="_nEmail" placeholder="이메일" spellcheck="false" autocomplete="off" />
            <input class="ar-in" @bind="_nPhone" placeholder="연락처" spellcheck="false" autocomplete="off" />
            <input class="ar-in" type="password" @bind="_nPass" placeholder="비밀번호(4자+)" autocomplete="new-password" />
            <button class="ar-add-btn" @onclick="AddAdmin" disabled="@_adding">@(_adding ? "추가 중…" : "관리자 추가")</button>
        </div>
    </div>

    <div class="ar-path">🔒 발급자 관리자(GSLEE)는 시드 계정으로 삭제할 수 없습니다. 명부는 로컬 members.json(PBKDF2 해시)에 보관됩니다.</div>
</section>

<style>
    .ar-card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 18px; margin-bottom: 14px; }
    .ar-head { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
    .ar-ico { width: 42px; height: 42px; flex: 0 0 auto; display: grid; place-items: center; font-size: 20px; border-radius: 11px; background: color-mix(in srgb, var(--accent) 12%, transparent); border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent); }
    .ar-hgrow { min-width: 0; flex: 1; }
    .ar-title { font-size: 15px; font-weight: 800; color: var(--ink); }
    .ar-desc { font-size: 11.5px; color: var(--sub); margin-top: 2px; line-height: 1.5; } .ar-desc b { color: var(--accent); }
    .ar-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 14px; }
    .ar-stat { background: var(--card-2); border: 1px solid var(--line); border-radius: 11px; padding: 10px 14px; }
    .ar-stat b { display: block; font-size: 22px; font-weight: 800; color: var(--ink); line-height: 1; font-variant-numeric: tabular-nums; }
    .ar-stat span { display: block; font-size: 11px; color: var(--sub); margin-top: 5px; }
    .ar-temp { padding: 11px 15px; margin-bottom: 12px; border-radius: 11px; background: color-mix(in srgb, var(--up) 12%, transparent); border: 1px solid color-mix(in srgb, var(--up) 42%, transparent); color: var(--up); font-size: 12.5px; } .ar-temp b.v { font-family: var(--mono); }
    .ar-msg { padding: 10px 14px; margin-bottom: 12px; border-radius: 10px; font-size: 12.5px; font-weight: 700; }
    .ar-msg.ok { color: var(--up); background: color-mix(in srgb, var(--up) 12%, transparent); border: 1px solid color-mix(in srgb, var(--up) 40%, transparent); }
    .ar-msg.bad { color: var(--down); background: color-mix(in srgb, var(--down) 12%, transparent); border: 1px solid color-mix(in srgb, var(--down) 40%, transparent); }
    .ar-wrap { overflow-x: auto; }
    .ar-tbl { width: 100%; border-collapse: collapse; font-size: 13px; }
    .ar-tbl th { text-align: left; color: var(--sub); font-weight: 700; padding: 9px 10px; border-bottom: 1px solid var(--line); white-space: nowrap; font-size: 11.5px; }
    .ar-tbl td { padding: 11px 10px; border-bottom: 1px solid var(--hairline); color: var(--ink); vertical-align: middle; }
    .ar-tbl tbody tr:hover td { background: color-mix(in srgb, var(--accent) 5%, transparent); }
    .ar-id { font-weight: 800; color: var(--ink); }
    .ar-mut { color: var(--sub); font-size: 12px; } .ar-mut2 { color: var(--sub); font-size: 12px; margin-top: 3px; }
    .ar-role { background: var(--card-2); border: 1px solid var(--line); border-radius: 8px; padding: 6px 9px; color: var(--ink); font-size: 12.5px; cursor: pointer; font-family: inherit; }
    .ar-role.adm { border-color: color-mix(in srgb, var(--accent) 55%, transparent); color: var(--accent); font-weight: 800; }
    .ar-bdg { font-size: 10.5px; font-weight: 800; padding: 3px 10px; border-radius: 999px; white-space: nowrap; }
    .ar-bdg.ok { color: var(--up); background: color-mix(in srgb, var(--up) 14%, transparent); border: 1px solid color-mix(in srgb, var(--up) 40%, transparent); }
    .ar-bdg.bad { color: var(--down); background: color-mix(in srgb, var(--down) 13%, transparent); border: 1px solid color-mix(in srgb, var(--down) 38%, transparent); }
    .ar-bdg.warn { color: var(--warn); background: color-mix(in srgb, var(--warn) 14%, transparent); border: 1px solid color-mix(in srgb, var(--warn) 42%, transparent); }
    .ar-acts { display: flex; gap: 6px; flex-wrap: wrap; }
    .ar-b { font-size: 11.5px; font-weight: 700; padding: 6px 11px; border-radius: 8px; border: 1px solid var(--line); background: var(--card-2); color: var(--sub); cursor: pointer; white-space: nowrap; font-family: inherit; transition: border-color .14s ease, color .14s ease; }
    .ar-b:hover { border-color: var(--accent); color: var(--ink); }
    .ar-b.ok { border-color: color-mix(in srgb, var(--up) 50%, transparent); background: color-mix(in srgb, var(--up) 14%, transparent); color: var(--up); }
    .ar-b.del { border-color: color-mix(in srgb, var(--down) 40%, transparent); background: color-mix(in srgb, var(--down) 10%, transparent); color: var(--down); }
    .ar-add { margin-top: 16px; background: var(--card-2); border: 1px solid var(--line); border-radius: 12px; padding: 13px 15px; }
    .ar-add-h { font-size: 12.5px; font-weight: 800; color: var(--ink); margin-bottom: 10px; } .ar-add-h span { font-size: 11px; font-weight: 600; color: var(--sub); margin-left: 6px; }
    .ar-add-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 9px; align-items: center; }
    .ar-in { box-sizing: border-box; width: 100%; background: var(--card); border: 1px solid var(--field-line, var(--line)); border-radius: 9px; padding: 8px 11px; color: var(--ink); font-size: 12.5px; font-family: inherit; outline: none; }
    .ar-in:focus { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent); }
    .ar-add-btn { border: none; border-radius: 9px; padding: 9px 16px; font-weight: 800; font-size: 12.5px; cursor: pointer; color: var(--accent-ink, #1a1204); background: linear-gradient(135deg, var(--accent-2), var(--accent)); white-space: nowrap; font-family: inherit; }
    .ar-add-btn:disabled { opacity: .55; cursor: not-allowed; }
    .ar-path { margin-top: 12px; font-size: 11px; color: var(--sub); line-height: 1.5; opacity: .9; }
</style>

@code {
    private (string, string)? _temp;
    private string? _msg;
    private bool _msgOk;

    private string _nId = "", _nName = "", _nEmail = "", _nPhone = "", _nPass = "";
    private bool _adding;

    private int _adminCount => Members.Members.Count(m => m.Role == "Admin");

    protected override void OnInitialized() { Members.Changed += OnCh; Session.OnChange += OnCh; }
    private void OnCh() => InvokeAsync(StateHasChanged);

    private void SetMemberRole(string id, string? role)
    {
        if (role is null) return;
        // [안전장치] 마지막 남은 관리자를 강등하면 아무도 관리 기능에 접근할 수 없게 된다 — 차단.
        var cur = Members.Members.FirstOrDefault(m => m.Id.Equals(id, StringComparison.OrdinalIgnoreCase));
        if (cur is not null && cur.Role == "Admin" && role != "Admin" && _adminCount <= 1)
        {
            Notify("마지막 관리자는 강등할 수 없습니다. 다른 계정에 Admin 권한을 먼저 부여하세요.", false);
            return;
        }
        Members.SetRole(id, role);
        Notify($"'{id}' 권한을 {role} 로 변경했습니다.", true);
    }

    private void Reset(string id) { var t = Members.ForceReset(id); if (t.Length > 0) { _temp = (id, t); _msg = null; } }

    private void AddAdmin()
    {
        _adding = true;
        try
        {
            var id = (_nId ?? "").Trim();
            if (id.Length < 3 || (_nPass ?? "").Length < 4) { Notify("아이디 3자·비밀번호 4자 이상 입력하세요.", false); return; }
            if (Members.Exists(id)) { Notify("이미 존재하는 아이디입니다.", false); return; }

            var req = new MemberRegisterRequest(
                id, _nPass!, (_nName ?? "").Trim(), "", "",
                (_nEmail ?? "").Trim(), (_nPhone ?? "").Trim(), "", "",
                "", "", "", "", "", "");
            var res = Members.RegisterFull(req);
            if (!res.Ok) { Notify(res.Message, false); return; }

            Members.SetRole(id, "Admin");   // RegisterFull 은 Viewer 로 생성 → Admin 승격
            Members.Approve(id);            // 활성 상태 보장
            Notify($"관리자 '{id}' 가 추가되었습니다(Admin · 활성).", true);
            _nId = _nName = _nEmail = _nPhone = _nPass = "";
        }
        catch (Exception ex) { Notify("추가 실패: " + ex.Message, false); }
        finally { _adding = false; }
    }

    private void Notify(string m, bool ok) { _msg = m; _msgOk = ok; _temp = null; }

    private static string StatusKo(string s) => s switch { "active" => "활성", "locked" => "잠김", _ => "승인 대기" };
    private static string StatusCls(string s) => s switch { "active" => "ok", "locked" => "bad", _ => "warn" };

    public void Dispose() { Members.Changed -= OnCh; Session.OnChange -= OnCh; }
}
