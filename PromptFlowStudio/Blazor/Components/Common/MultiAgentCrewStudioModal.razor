@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private System.Threading.Timer? _timer;

    private MultiAgentVirtualProductionCrewOrchestratorEngine Crew => Runner.Crew;
    private AutonomousDirectorialConsensusEvaluator C => Runner.Consensus;
    private RealtimeProductionSwarmExecutionGuard G => Runner.Guard;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("Crew.Modal.Timer", ex); }
        }, null, 200, 200);
    }

    private static string F0(double v) => v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => v.ToString("0.00", CultureInfo.InvariantCulture);
    private static string F3(double v) => v.ToString("0.000", CultureInfo.InvariantCulture);

    private static string Fmt(int topic, float v) => topic switch
    {
        1 or 6 => F0(v) + MultiAgentVirtualProductionCrewOrchestratorEngine.TopicUnits[topic],
        2 => F0(v) + "mm", 4 => F1(v) + "°", 5 => F1(v) + "s", 3 => F2(v) + "m/s", _ => F2(v),
    };

    private static (float X, float Y) Node(int r)
    {
        if (r == 0) return (0f, 0f);
        var a = -MathF.PI / 2f + (r - 1) * MathF.Tau / 6f;
        return (MathF.Cos(a) * 78f, MathF.Sin(a) * 74f);
    }

    private float Load(int r) { var c = Crew.Capacity((CrewRole)r); return c > 0f ? Math.Clamp(Crew.Busy((CrewRole)r) / c, 0f, 1f) : 0f; }

    private RenderFragment Emo(string name, float target, float predicted) => __builder =>
    {
        <div class="row">
            <span>@name</span>
            <div class="tr"><i class="pd" style="width:@(F0(Math.Clamp(predicted, 0f, 1f) * 100))%"></i><i class="tg" style="left:@(F0(Math.Clamp(target, 0f, 1f) * 100))%"></i></div>
            <span>목표 <b>@(F2(target))</b> · 예측 <b>@(F2(predicted))</b></span>
        </div>
    };

    private void ToggleLock(CrewTopic t)
    {
        if (C.IsLocked(t)) Runner.Override(t, null);
        else Runner.Override(t, Crew.DecidedValue(t));
    }

    private void OverrideSlider(CrewTopic t, ChangeEventArgs e)
    {
        if (!float.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v)) return;
        Runner.Override(t, MultiAgentVirtualProductionCrewOrchestratorEngine.Denormalize((int)t, v / 100f));
    }

    private void ClearAll() { C.ClearOverrides(); }

    private void ToggleModule(int i, bool running)
    {
        if (running) G.Module(i).Stop(); else G.RequestStart(i);
    }

    private static bool TryF(ChangeEventArgs e, out float v) => float.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out v);
    private void SetF(ChangeEventArgs e, Action<float> apply) { if (TryF(e, out var v)) apply(v); }

    private void Step() { for (var k = 0; k < MultiAgentCrewStudioRunner.Hz; k++) Runner.TickOnce(); }

    private void ToggleRun() { if (Runner.IsRunning) Runner.Stop(); else Runner.Start(); }

    private Task Close() => OnClose.InvokeAsync();

    private void OnServiceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
