@using System.Globalization
@using PromptFlowStudio.Services.LiveShowroom
@using PromptFlowStudio.Services.BroadcastMcr
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable
@inject LiveCommerceStudioRunner Runner

@* [PromptFlow Studio v17.68.0] 🛍️ 버추얼 라이브 커머스 스튜디오 — 3DGS 상품 카탈로그 · 실적 대시보드 · 구매자 피드 · 품절 임박 · 광고 심의 로그. *@
<div class="vlc-scrim" @onclick="Close">
    <div class="vlc-modal" @onclick:stopPropagation="true">
        <div class="vlc-h">
            <div>
                <div class="vlc-title">🛍️ 버추얼 라이브 커머스 스튜디오 @(Runner.IsRunning ? "· ▶ MCR 60 Hz" : null) · @(LiveSalesPitchReactionSynthesizer.PhaseName(Runner.Sales.Phase))</div>
                <div class="vlc-sub"><b>쇼룸 인스펙션 엔진</b>이 3DGS 상품(최대 5만 스플랫)을 호스트 아바타 오른손 손목 관절에 로컬 변환으로 결합하고, 쇼케이스 모드에서는 360° 절차 회전과 카메라 기준 광택 · 금속성 · 프레넬 림으로 재질을 보여주며 v17.66 MCR에 상품 클로즈업을 요청합니다. <b>세일즈 피치 FSM</b>은 구매 이벤트에 박수 · 엄지척과 감사 멘트를 즉시 끼워 넣고 타임세일 카운트다운 · 잔여 재고 · 품절 배너를 자동 송출하며, <b>광고 심의 가드</b>는 대본과 애드리브의 과장 · 의료 효능 표현을 치환하거나 차단하고 할인율 계산이 맞지 않으면 쇼핑 배너를 내립니다.</div>
            </div>
            <button class="vlc-x" @onclick="Close">✕</button>
        </div>
        <div class="vlc-bar">
            <button class="vlc-btn @(Runner.IsRunning ? "on" : "go")" @onclick="ToggleRun">@(Runner.IsRunning ? "⏸ 정지" : "▶ 방송 시작")</button>
            <button class="vlc-btn" @onclick="Runner.StartPitch">🎙 소개</button>
            <button class="vlc-btn @(Runner.Inspection.Showcase ? "on" : null)" @onclick="Runner.BeginShowcase">🔄 360° 쇼케이스</button>
            <button class="vlc-btn hot" @onclick="() => Runner.StartTimeSale(180)">⏱ 3분 특가</button>
            <button class="vlc-btn @(Runner.LinkGateway ? "on" : null)" disabled="@(!Runner.GatewayAvailable)" @onclick="() => Runner.SetLinkGateway(!Runner.LinkGateway)">🔗 v17.62 `!buy`</button>
            <span class="vlc-sep"></span>
            <input class="vlc-in" placeholder="구매자" @bind="_buyer" />
            <input class="vlc-in num" type="number" min="1" max="99" @bind="_qty" />
            <button class="vlc-btn go" @onclick="Buy">🛒 구매 시뮬</button>
        </div>
        <div class="vlc-main">
            <div class="vlc-col">
                <div class="vlc-card">
                    <div class="vlc-sec">🗂️ 3DGS 상품 카탈로그</div>
                    <div class="vlc-catalog">
                        @for (var i = 0; i < LiveCommerceStudioRunner.Catalog.Length; i++)
                        {
                            var idx = i; var p = LiveCommerceStudioRunner.Catalog[i];
                            <button class="vlc-item @(Runner.SelectedIndex == i ? "sel" : null)" @onclick="() => Runner.Select(idx)">
                                <i style="background:@(Css(p.Color))"></i>
                                <b>@(p.Name)</b>
                                <span>@(ShowroomProductInspectionEngine.ShapeName(p.Shape)) · @(p.Splats.ToString("N0", CultureInfo.InvariantCulture)) 스플랫 · 광택 @(F0(p.Gloss)) · 금속 @(F2(p.Metallic))</span>
                                <em>₩@(p.SalePrice.ToString("N0", CultureInfo.InvariantCulture)) <s>₩@(p.ListPrice.ToString("N0", CultureInfo.InvariantCulture))</s> @(p.DisplayedPercent)%</em>
                            </button>
                        }
                    </div>
                    <div class="vlc-price">
                        <label>정가 <input type="number" @bind="_list" /></label>
                        <label>할인가 <input type="number" @bind="_sale" /></label>
                        <label>표시 % <input type="number" @bind="_pct" /></label>
                        <button class="vlc-btn sm" @onclick="ApplyPrice">💲 적용</button>
                        <span class="@(Runner.Banner.PriceBlocked ? "bad" : "ok")">@(Runner.Banner.PriceBlocked ? "⛔ " + EcommerceAdComplianceSafetyGuard.PriceName(Runner.Compliance.LastPrice) + " — 배너 차단" : "✔ 가격 정합")</span>
                    </div>
                </div>
                <div class="vlc-card">
                    <div class="vlc-sec">📺 PGM · @(BroadcastMcrMasterControlSynthesizer.SourceName(Runner.Mcr.Mcr.Program)) · 상품 @(ShowroomProductInspectionEngine.PoseName(Runner.Inspection.Pose))</div>
                    <div class="vlc-view">@if (_pgm.Length > 0) { <img src="@_pgm" alt="PGM" /> } else { <div class="ph">대기 — 방송 시작</div> }</div>
                    <div class="vlc-kv">회전 yaw @(F0(Runner.Inspection.Yaw * 57.2958f))° · pitch @(F0(Runner.Inspection.Pitch * 57.2958f))° · 스페큘러 최대 @(F2(Runner.Inspection.PeakSpecular)) · 기록 @(F0(Runner.Inspection.LastUs)) µs · 클로즈업 @(Runner.CloseUps) · 레이어 최대 @(F2(Runner.MaxLayerMs)) ms</div>
                </div>
            </div>
            <div class="vlc-col">
                <div class="vlc-card">
                    <div class="vlc-sec">📈 실시간 실적</div>
                    <div class="vlc-kpis">
                        <span><b>₩@(Runner.Sales.Revenue.ToString("N0", CultureInfo.InvariantCulture))</b>누적 판매액</span>
                        <span><b>@(Runner.Sales.UnitsSold)</b>판매 수량</span>
                        <span><b>@(Runner.Sales.Orders)</b>주문</span>
                        <span><b class="@(Runner.Sales.LowStock || Runner.Sales.SoldOut ? "bad" : null)">@(Runner.Sales.SoldOut ? "품절" : Runner.Sales.Stock.ToString(CultureInfo.InvariantCulture))</b>잔여 재고</span>
                        <span><b>@(Timer())</b>타임세일</span>
                        <span><b>@(F0(Runner.Sales.MaxReactionMs)) ms</b>리액션 최대</span>
                    </div>
                    <div class="vlc-stock @(Runner.Sales.LowStock ? "low" : null)"><div style="width:@(Pct(Runner.Sales.StockRatio))%"></div><span>@(Runner.Sales.LowStock && !Runner.Sales.SoldOut ? "🔥 품절 임박" : Runner.Sales.SoldOut ? "SOLD OUT" : "재고 " + Pct(Runner.Sales.StockRatio) + "%")</span></div>
                    <svg class="vlc-plot" viewBox="0 0 600 50" preserveAspectRatio="none"><polyline points="@(RevenuePoints())" /></svg>
                </div>
                <div class="vlc-card">
                    <div class="vlc-sec">🧾 구매자 피드 · 거부 @(Runner.Sales.Refused)</div>
                    @if (Runner.Sales.FeedCount == 0) { <div class="vlc-empty">구매 대기</div> }
                    else
                    {
                        <div class="vlc-feed">
                            @for (var i = 0; i < Math.Min(10, Runner.Sales.FeedCount); i++)
                            {
                                var f = Runner.Sales.Feed(i);
                                <div><b>@(Mask(Runner.Sales.FeedUser(i)))</b><span>@(f.Qty)개</span><em>₩@(f.AmountWon.ToString("N0", CultureInfo.InvariantCulture))</em></div>
                            }
                        </div>
                    }
                </div>
                <div class="vlc-card">
                    <div class="vlc-sec">⚖️ 광고 심의 로그 · 검사 @(Runner.Compliance.Scanned) · 치환 @(Runner.Compliance.Replaced) · 차단 @(Runner.Compliance.Blocked) · 가격 거부 @(Runner.Compliance.PriceRejected)</div>
                    <div class="vlc-row"><input class="vlc-in wide" placeholder="심의 테스트 멘트(예: 국내 유일 100% 보장)" @bind="_probe" /><button class="vlc-btn sm" @onclick="Probe">🔎 검사</button><span class="vlc-probe">@(_probeResult)</span></div>
                    @if (Runner.Compliance.LogCount == 0) { <div class="vlc-empty">위반 없음</div> }
                    else
                    {
                        <div class="vlc-log">
                            @for (var i = 0; i < Math.Min(10, Runner.Compliance.LogCount); i++)
                            {
                                var v = Runner.Compliance.Log(i);
                                <div class="@(v.Action == ComplianceAction.Block ? "blk" : null)"><i>@(v.Action == ComplianceAction.Block ? "차단" : "치환")</i><b>@(EcommerceAdComplianceSafetyGuard.RuleCategory(v.Rule))</b><span>@(new string(Runner.Compliance.LogText(i)))</span></div>
                            }
                        </div>
                    }
                </div>
                <div class="vlc-act">@(Runner.LastAction ?? "대기")</div>
            </div>
        </div>
    </div>
</div>

<style>
    .vlc-scrim { position: fixed; inset: 0; z-index: var(--z-studio-modal); background: rgba(0,0,0,.62); display: flex; align-items: center; justify-content: center; }
    .vlc-modal { width: min(1300px, 96vw); max-height: 94vh; overflow-y: auto; background: var(--card); border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 20px 60px rgba(0,0,0,.45); padding: 14px 16px; color: var(--text-primary); }
    .vlc-h { display: flex; justify-content: space-between; gap: 12px; } .vlc-title { font-size: 17px; font-weight: 800; } .vlc-sub { font-size: 11.5px; color: var(--text-muted); margin-top: 4px; line-height: 1.5; }
    .vlc-x { background: none; border: 0; color: var(--text-muted); font-size: 18px; cursor: pointer; }
    .vlc-bar { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin: 10px 0; }
    .vlc-btn { background: #1e293b; color: var(--text-primary); border: 1px solid var(--line); border-radius: 7px; padding: 5px 10px; font-size: 12px; cursor: pointer; }
    .vlc-btn.go { border-color: #22c55e; } .vlc-btn.on { background: color-mix(in srgb, #ec4899 28%, #1e293b); border-color: #ec4899; } .vlc-btn.hot { border-color: #f97316; } .vlc-btn:disabled { opacity: .45; cursor: default; } .vlc-btn.sm { padding: 3px 8px; font-size: 11px; }
    .vlc-sep { flex: 1; } .vlc-in { background: #0f172a; color: var(--text-primary); border: 1px solid var(--line); border-radius: 7px; padding: 4px 6px; font-size: 12px; width: 110px; } .vlc-in.num { width: 56px; } .vlc-in.wide { flex: 1; width: auto; }
    .vlc-main { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 12px; }
    .vlc-col { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
    .vlc-card { border: 1px solid var(--line); border-radius: 10px; padding: 10px; background: #0b1324; }
    .vlc-sec { font-size: 12.5px; font-weight: 700; margin-bottom: 8px; }
    .vlc-catalog { display: flex; flex-direction: column; gap: 5px; }
    .vlc-item { display: grid; grid-template-columns: 14px 1fr auto; gap: 2px 8px; align-items: center; text-align: left; background: #0f172a; border: 1px solid var(--line); border-radius: 8px; padding: 6px 8px; color: var(--text-primary); cursor: pointer; }
    .vlc-item.sel { border-color: #ec4899; } .vlc-item i { width: 12px; height: 12px; border-radius: 50%; grid-row: span 2; } .vlc-item b { font-size: 12px; } .vlc-item span { grid-column: 2; font-size: 10px; color: var(--text-muted); }
    .vlc-item em { grid-row: 1 / span 2; grid-column: 3; font: 700 11px var(--mono); font-style: normal; color: #fde047; } .vlc-item s { color: var(--text-muted); font-weight: 400; }
    .vlc-price { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-top: 8px; font-size: 11px; color: var(--text-muted); }
    .vlc-price input { width: 86px; background: #0f172a; color: var(--text-primary); border: 1px solid var(--line); border-radius: 6px; padding: 2px 5px; font: 600 11px var(--mono); }
    .vlc-price .ok { color: #86efac; } .vlc-price .bad { color: #f87171; font-weight: 700; }
    .vlc-view { border-radius: 8px; overflow: hidden; background: #05070c; aspect-ratio: 5 / 3; border: 3px solid #ef4444; } .vlc-view img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .vlc-view .ph { display: flex; align-items: center; justify-content: center; height: 100%; font-size: 12px; color: var(--text-muted); }
    .vlc-kv { font-size: 10.5px; color: var(--text-muted); margin-top: 6px; }
    .vlc-kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; } .vlc-kpis span { display: flex; flex-direction: column; font-size: 10px; color: var(--text-muted); background: #0f172a; border-radius: 6px; padding: 5px 7px; }
    .vlc-kpis b { font: 800 14px var(--mono); color: var(--text-primary); } .vlc-kpis .bad { color: #f87171; }
    .vlc-stock { position: relative; height: 16px; background: #1e293b; border-radius: 8px; overflow: hidden; margin-top: 8px; } .vlc-stock div { height: 100%; background: #22c55e; } .vlc-stock.low div { background: #ef4444; }
    .vlc-stock span { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font: 700 10px var(--mono); }
    .vlc-plot { width: 100%; height: 50px; background: #0f172a; border-radius: 6px; display: block; margin-top: 6px; } .vlc-plot polyline { fill: none; stroke: #fde047; stroke-width: 1.5; }
    .vlc-empty { font-size: 11px; color: var(--text-muted); padding: 4px 0; }
    .vlc-feed, .vlc-log { display: flex; flex-direction: column; gap: 3px; max-height: 180px; overflow-y: auto; }
    .vlc-feed div { display: grid; grid-template-columns: 1fr auto auto; gap: 8px; font-size: 11px; background: #0f172a; border-radius: 5px; padding: 3px 6px; } .vlc-feed em { font: 700 10.5px var(--mono); font-style: normal; color: #86efac; }
    .vlc-log div { display: grid; grid-template-columns: 30px 70px 1fr; gap: 6px; font-size: 11px; background: #0f172a; border-radius: 5px; padding: 3px 6px; border-left: 3px solid #f59e0b; } .vlc-log div.blk { border-left-color: #ef4444; }
    .vlc-log i { font-style: normal; font-weight: 700; color: #fbbf24; } .vlc-log div.blk i { color: #f87171; } .vlc-log span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-muted); }
    .vlc-row { display: flex; gap: 6px; align-items: center; margin-bottom: 6px; } .vlc-probe { font-size: 11px; color: #fde047; }
    .vlc-act { font-size: 11px; color: var(--text-muted); }
    @@media (max-width: 960px) { .vlc-main { grid-template-columns: 1fr; } .vlc-kpis { grid-template-columns: repeat(2, 1fr); } }
</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private readonly byte[] _bmp = new byte[BroadcastMcrStudioRunner.PreviewBytes];
    private System.Threading.Timer? _timer;
    private string _pgm = "", _buyer = "시청자", _probe = "", _probeResult = "";
    private int _qty = 1, _pct;
    private long _list, _sale;

    protected override void OnInitialized()
    {
        var p = Runner.Sales.Product;
        if (p is not null) { _list = p.ListPrice; _sale = p.SalePrice; _pct = p.DisplayedPercent; }
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("Commerce.Modal.Timer", ex); }
        }, null, 200, 200);
    }

    protected override bool ShouldRender()
    {
        if (Runner.Mcr.Compositor is not null && Runner.Mcr.Mcr.VideoFrames > 0)
        {
            Runner.Mcr.WritePreviews();
            Runner.Mcr.CopyPreview(true, _bmp);
            _pgm = "data:image/bmp;base64," + Convert.ToBase64String(_bmp);
        }
        return true;
    }

    private static string F0(double v) => double.IsFinite(v) ? v.ToString("0", CultureInfo.InvariantCulture) : "—";
    private static string F2(double v) => double.IsFinite(v) ? v.ToString("0.00", CultureInfo.InvariantCulture) : "—";
    private static string Pct(float v) => Math.Clamp(v * 100.0, 0, 100).ToString("0", CultureInfo.InvariantCulture);
    private static string Css(System.Numerics.Vector3 c) => "rgb(" + ((int)(c.X * 255)).ToString(CultureInfo.InvariantCulture) + "," + ((int)(c.Y * 255)).ToString(CultureInfo.InvariantCulture) + "," + ((int)(c.Z * 255)).ToString(CultureInfo.InvariantCulture) + ")";
    private static string Mask(ReadOnlySpan<char> u) => u.Length <= 1 ? u.ToString() : string.Concat(u[..1], new string('*', Math.Min(3, u.Length - 1)));

    private string Timer()
    {
        var s = (int)MathF.Ceiling(Runner.Sales.RemainingSeconds);
        return s <= 0 ? "—" : (s / 60).ToString(CultureInfo.InvariantCulture) + ":" + (s % 60).ToString("00", CultureInfo.InvariantCulture);
    }

    private string RevenuePoints()
    {
        var n = Runner.SeriesCount;
        if (n < 2) return "";
        var max = 1f; for (var i = 0; i < n; i++) max = MathF.Max(max, Runner.RevenueSeries(i));
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = 0; i < n; i++)
            sb.Append((600.0 * i / (n - 1)).ToString("0.#", CultureInfo.InvariantCulture)).Append(',').Append((48 - 46 * Runner.RevenueSeries(n - 1 - i) / max).ToString("0.#", CultureInfo.InvariantCulture)).Append(' ');
        return sb.ToString();
    }

    private void Buy() { if (!string.IsNullOrWhiteSpace(_buyer)) Runner.Purchase(_buyer.Trim(), Math.Clamp(_qty, 1, 99)); }
    private void ApplyPrice() => Runner.EditPrice(_list, _sale, _pct);

    private void Probe()
    {
        var dst = new char[512];
        var n = Runner.Compliance.Sanitize(_probe, dst, out var rule, out var block);
        _probeResult = rule < 0 ? "✔ 위반 없음" : block ? "⛔ 차단 · " + EcommerceAdComplianceSafetyGuard.RuleCategory(rule) : "↺ " + new string(dst, 0, n);
    }

    private void ToggleRun()
    {
        if (Runner.IsRunning) Runner.Stop(); else Runner.Start();
    }

    private Task Close() => OnClose.InvokeAsync();

    private void OnServiceChanged()
    {
        if (!Runner.IsRunning) _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
    }
}
