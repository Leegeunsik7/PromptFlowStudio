@using System.Globalization
@using PromptFlowStudio.Services.BroadcastMcr
@using PromptFlowStudio.Services.StreamGateway
@using PromptFlowStudio.Services.Talkshow
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable
@inject BroadcastMcrStudioRunner Runner

@* [PromptFlow Studio v17.66.0] 🎛️ 브로드캐스트 주조정실(MCR) 스튜디오 — PGM/PVW 통합 3DGS 듀얼 뷰포트 · 멀티캠 버스 · 오디오 마스터 · PPL 노출률. *@
<div class="bmc-scrim" @onclick="Close">
    <div class="bmc-modal" @onclick:stopPropagation="true">
        <div class="bmc-h">
            <div>
                <div class="bmc-title">🎛️ 브로드캐스트 주조정실(MCR) 스튜디오 @(Runner.IsRunning ? "· ▶ 60 Hz" : null) @(Runner.Mcr.EncoderOpen ? "· 🔴 ON-AIR" : null)</div>
                <div class="bmc-sub"><b>통합 씬 컴포지터</b>가 v17.55 3DGS 세트와 토크쇼 아바타 2~3 기(v17.57 DQS 몸체 · v17.58 안면) · 스폰서 소품을 하나의 버퍼에 병합하고, 카메라 프러스텀 컬링 후 단일 깊이 래딕스 큐로 정렬해 메쉬 z-버퍼 없이 상호 차폐와 v17.56 접지 그림자를 합성합니다. <b>MCR 스위처</b>는 v17.65 자동 멀티캠과 v17.41 DMX 키 라이트를 받아 PGM/PVW 이중 버스를 Cut · Mix · Wipe로 전환하고 프레임마다 정확히 800 샘플의 v17.64 다국어 오디오와 함께 v17.62 인코더 탭으로 송출하며, <b>PPL 가드</b>는 소품 가림률이 60 %를 넘거나 아바타가 관통하면 즉시 데스크 위 다른 자리로 옮깁니다.</div>
            </div>
            <button class="bmc-x" @onclick="Close">✕</button>
        </div>
        <div class="bmc-bar">
            <button class="bmc-btn @(Runner.IsRunning ? "on" : "go")" @onclick="ToggleRun">@(Runner.IsRunning ? "⏸ 정지" : "▶ MCR 시작")</button>
            <button class="bmc-btn @(Runner.Mcr.EncoderOpen ? "rec" : null)" @onclick="ToggleAir">@(Runner.Mcr.EncoderOpen ? "⏹ 송출 정지" : "🔴 ON-AIR")</button>
            <label class="bmc-lbl"><input type="checkbox" @bind="_tap" disabled="@(!Runner.GatewayAvailable || Runner.Mcr.EncoderOpen)" /> v17.62 링 탭</label>
            <button class="bmc-btn @(Runner.AutoDirect ? "on" : null)" @onclick="() => Runner.SetAutoDirect(!Runner.AutoDirect)">🤖 자동 디렉팅</button>
            <button class="bmc-btn @(Runner.LinkLights ? "on" : null)" disabled="@(!Runner.LightsAvailable)" @onclick="() => Runner.SetLinkLights(!Runner.LinkLights)">💡 v17.41 DMX</button>
            <button class="bmc-btn @(Runner.Ppl.Enabled ? "on" : null)" @onclick="() => Runner.SetPplEnabled(!Runner.Ppl.Enabled)">🛡 PPL 가드</button>
            <button class="bmc-btn" @onclick="Runner.ResetMetrics">♻ 지표</button>
            <span class="bmc-sep"></span>
            <span class="bmc-kv">세트 @(Runner.EnvSplats.ToString("N0", CultureInfo.InvariantCulture)) · 병합 @((Runner.Compositor?.Merged ?? 0).ToString("N0", CultureInfo.InvariantCulture)) 스플랫</span>
        </div>
        <div class="bmc-views">
            <div class="bmc-view pvw">
                <div class="tag">PVW · @(BroadcastMcrMasterControlSynthesizer.SourceName(Runner.Mcr.Preview))</div>
                @if (_pvw.Length > 0) { <img src="@_pvw" alt="PVW" /> } else { <div class="ph">대기 — MCR 시작</div> }
            </div>
            <div class="bmc-view pgm">
                <div class="tag">PGM · @(BroadcastMcrMasterControlSynthesizer.SourceName(Runner.Mcr.Program)) @(Runner.Mcr.Transitioning ? "· " + BroadcastMcrMasterControlSynthesizer.TransitionName(Runner.Mcr.ActiveTransition) + " " + Pct(Runner.Mcr.Progress) + "%" : null)</div>
                @if (_pgm.Length > 0) { <img src="@_pgm" alt="PGM" /> } else { <div class="ph">대기 — MCR 시작</div> }
                <div class="ppl @(Runner.Ppl.OcclusionRatio > DynamicPplOcclusionBrandGuard.Threshold ? "bad" : null)">PPL 노출 @(Pct(Runner.Ppl.Exposure))%</div>
            </div>
        </div>
        <div class="bmc-main">
            <div class="bmc-card">
                <div class="bmc-sec">🎚️ 멀티캠 버스</div>
                <div class="bmc-bus"><span>PVW</span>
                    @for (var s = 0; s < BroadcastMcrMasterControlSynthesizer.Sources; s++)
                    {
                        var src = s;
                        <button class="bmc-src @(Runner.Mcr.Preview == s ? "pvw" : null)" @onclick="() => Runner.SetPreview(src)">@(s + 1)</button>
                    }
                </div>
                <div class="bmc-bus"><span>PGM</span>
                    @for (var s = 0; s < BroadcastMcrMasterControlSynthesizer.Sources; s++)
                    {
                        <span class="bmc-src ro @(Runner.Mcr.Program == s ? "pgm" : null)">@(s + 1)</span>
                    }
                </div>
                <div class="bmc-trans">
                    <button class="bmc-btn" @onclick="() => Runner.Take(McrTransition.Cut)">✂ CUT</button>
                    <button class="bmc-btn" @onclick="() => Runner.Take(McrTransition.Mix, _frames)">◐ MIX</button>
                    <button class="bmc-btn" @onclick="() => Runner.Take(McrTransition.Wipe, _frames)">▶ WIPE</button>
                    <label class="bmc-lbl">@(_frames) f</label>
                    <input class="bmc-rng" type="range" min="4" max="60" value="@_frames" @oninput="OnFrames" />
                </div>
                <div class="bmc-kv">테이크 @(Runner.Mcr.Takes) · CUT @(Runner.Mcr.CutsTaken) · MIX @(Runner.Mcr.Mixes) · WIPE @(Runner.Mcr.Wipes) · 토크쇼 @(TalkshowMultiCamDeadlockGuard.ShotName(Runner.Talkshow.Guard.Shot))</div>
                <div class="bmc-kv">렌더 PGM @(Runner.Mcr.PgmRenders) / PVW @(Runner.Mcr.PvwRenders) · 컴포지트 @(F2(Runner.Compositor?.LastRenderMs ?? 0)) ms · 가시 @((Runner.Compositor?.Raster.Visible ?? 0).ToString("N0", CultureInfo.InvariantCulture)) · 틱 최대 @(F2(Runner.MaxTickMs)) ms · 초과 @(Runner.FramesOverBudget)</div>
            </div>
            <div class="bmc-card">
                <div class="bmc-sec">🔊 오디오 마스터 · A/V @(Runner.Mcr.AvSyncFrames) f (최대 @(Runner.Mcr.MaxAbsAvSync))</div>
                <div class="bmc-audio">
                    <div class="bmc-vu"><div class="fill @(Runner.Mcr.PeakDb > -3f ? "hot" : null)" style="height:@(Pct(Level(Runner.Mcr.RmsDb)))%"></div><div class="pk" style="bottom:@(Pct(Level(Runner.Mcr.PeakDb)))%"></div></div>
                    <div class="bmc-vu"><div class="fill @(Runner.Mcr.PeakDb > -3f ? "hot" : null)" style="height:@(Pct(Level(Runner.Mcr.RmsDb)))%"></div><div class="pk" style="bottom:@(Pct(Level(Runner.Mcr.PeakDb)))%"></div></div>
                    <div class="bmc-fader">
                        <input type="range" min="0" max="200" value="@((int)(Runner.Mcr.MasterGain * 100))" @oninput="OnGain" />
                        <span>@(F1(20 * Math.Log10(Math.Max(1e-3, Runner.Mcr.MasterGain)))) dB</span>
                    </div>
                    <div class="bmc-akv">
                        <div>RMS <b>@(F1(Runner.Mcr.RmsDb))</b> dBFS · 피크 <b>@(F1(Runner.Mcr.PeakDb))</b></div>
                        <div>송출 @(Runner.Mcr.VideoFrames) f · @(Runner.Mcr.AudioSamples.ToString("N0", CultureInfo.InvariantCulture)) 샘플 · 언더런 @(Runner.Mcr.Underruns)</div>
                        <div>인코더 @(Runner.Mcr.EncoderName) · @(Runner.Mcr.EncodedFrames) f @(Runner.TapGateway ? "· → v17.62 링" : null)</div>
                        <div class="row">
                            <button class="bmc-btn sm @(Runner.Mcr.Mute ? "rec" : null)" @onclick="() => Runner.SetMute(!Runner.Mcr.Mute)">🔇</button>
                            <button class="bmc-btn sm @(Runner.TestTone ? "on" : null)" @onclick="() => Runner.SetTestTone(!Runner.TestTone)">🎵 톤</button>
                            <button class="bmc-btn sm @(Runner.LinkDubbing ? "on" : null)" disabled="@(!Runner.DubbingAvailable)" @onclick="() => Runner.SetLinkDubbing(!Runner.LinkDubbing)">🌍 v17.64</button>
                            <select class="bmc-sel" value="@((int)Runner.AudioPlatform)" @onchange="OnPlat">
                                @for (var p = 0; p < 3; p++)
                                {
                                    <option value="@(p)">@(MultiPlatformLiveChatGatewaySynthesizer.PlatformName((ChatPlatform)p))</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="bmc-card">
                <div class="bmc-sec">🏷️ 가상 PPL · 가림 @(Pct(Runner.Ppl.OcclusionRatio))% / 60 % @(Runner.Ppl.Penetrating ? "· ⚠ 관통" : null)</div>
                <div class="bmc-meter"><div class="@(Runner.Ppl.OcclusionRatio > DynamicPplOcclusionBrandGuard.Threshold ? "bad" : "ok")" style="width:@(Pct(Runner.Ppl.OcclusionRatio))%"></div><i style="left:60%"></i></div>
                <svg class="bmc-plot" viewBox="0 0 600 60" preserveAspectRatio="none">
                    <line class="gate" x1="0" x2="600" y1="@(Yv(0.6))" y2="@(Yv(0.6))" />
                    <polyline class="occ" points="@(Series())" />
                </svg>
                <div class="bmc-kv">노출 @(Pct(Runner.Ppl.Exposure))% · 누적 @(F1(Runner.Ppl.ExposureSeconds)) s · 화면 @(F0(Runner.Ppl.ScreenPx)) px · 초과 @(Runner.Ppl.OverFrames) f · 회피 발동률 @(Pct(Runner.Ppl.AvoidRate))% · 재배치 @(Runner.Ppl.Relocations) · 관통 @(Runner.Ppl.Penetrations)</div>
                <div class="bmc-kv">위치 (@(F2(Runner.Ppl.Position.X)), @(F2(Runner.Ppl.Position.Z))) → (@(F2(Runner.Ppl.Target.X)), @(F2(Runner.Ppl.Target.Z))) · 가드 @(F1(Runner.Ppl.LastUs)) µs</div>
            </div>
        </div>
        <div class="bmc-act">@(Runner.LastAction ?? "대기")</div>
    </div>
</div>

<style>
    .bmc-scrim { position: fixed; inset: 0; z-index: var(--z-studio-modal); background: rgba(0,0,0,.62); display: flex; align-items: center; justify-content: center; }
    .bmc-modal { width: min(1320px, 96vw); max-height: 94vh; overflow-y: auto; background: var(--card); border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 20px 60px rgba(0,0,0,.45); padding: 14px 16px; color: var(--text-primary); }
    .bmc-h { display: flex; justify-content: space-between; gap: 12px; } .bmc-title { font-size: 17px; font-weight: 800; } .bmc-sub { font-size: 11.5px; color: var(--text-muted); margin-top: 4px; line-height: 1.5; }
    .bmc-x { background: none; border: 0; color: var(--text-muted); font-size: 18px; cursor: pointer; }
    .bmc-bar { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin: 10px 0; }
    .bmc-btn { background: #1e293b; color: var(--text-primary); border: 1px solid var(--line); border-radius: 7px; padding: 5px 10px; font-size: 12px; cursor: pointer; }
    .bmc-btn.go { border-color: #22c55e; } .bmc-btn.on { background: color-mix(in srgb, #0ea5e9 30%, #1e293b); border-color: #0ea5e9; } .bmc-btn.rec { background: color-mix(in srgb, #ef4444 35%, #1e293b); border-color: #ef4444; }
    .bmc-btn:disabled { opacity: .45; cursor: default; } .bmc-btn.sm { padding: 3px 8px; font-size: 11px; }
    .bmc-sep { flex: 1; } .bmc-lbl, .bmc-kv { font-size: 11px; color: var(--text-muted); } .bmc-lbl { display: flex; gap: 4px; align-items: center; }
    .bmc-views { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .bmc-view { position: relative; border-radius: 8px; overflow: hidden; background: #05070c; aspect-ratio: 5 / 3; border: 3px solid #334155; }
    .bmc-view.pvw { border-color: #22c55e; } .bmc-view.pgm { border-color: #ef4444; }
    .bmc-view img { width: 100%; height: 100%; object-fit: cover; display: block; image-rendering: auto; }
    .bmc-view .tag { position: absolute; top: 6px; left: 6px; font: 800 11px var(--mono); background: rgba(0,0,0,.6); padding: 2px 6px; border-radius: 4px; }
    .bmc-view.pvw .tag { color: #86efac; } .bmc-view.pgm .tag { color: #fca5a5; }
    .bmc-view .ph { display: flex; align-items: center; justify-content: center; height: 100%; font-size: 12px; color: var(--text-muted); }
    .bmc-view .ppl { position: absolute; right: 6px; bottom: 6px; font: 700 10px var(--mono); background: rgba(0,0,0,.6); padding: 2px 6px; border-radius: 4px; color: #fde047; } .bmc-view .ppl.bad { color: #f87171; }
    .bmc-main { display: grid; grid-template-columns: 1.1fr 1fr 1fr; gap: 12px; margin-top: 12px; }
    .bmc-card { border: 1px solid var(--line); border-radius: 10px; padding: 10px; background: #0b1324; min-width: 0; }
    .bmc-sec { font-size: 12.5px; font-weight: 700; margin-bottom: 8px; }
    .bmc-bus { display: flex; gap: 5px; align-items: center; margin-bottom: 6px; } .bmc-bus > span:first-child { width: 36px; font: 800 11px var(--mono); color: var(--text-muted); }
    .bmc-src { width: 34px; height: 30px; border-radius: 6px; border: 1px solid var(--line); background: #1e293b; color: var(--text-primary); font: 800 12px var(--mono); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
    .bmc-src.ro { cursor: default; } .bmc-src.pvw { background: #166534; border-color: #22c55e; } .bmc-src.pgm { background: #991b1b; border-color: #ef4444; }
    .bmc-trans { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; margin: 6px 0; } .bmc-rng { width: 110px; }
    .bmc-audio { display: grid; grid-template-columns: 14px 14px 46px 1fr; gap: 8px; align-items: stretch; }
    .bmc-vu { position: relative; height: 130px; background: #0f172a; border-radius: 4px; overflow: hidden; }
    .bmc-vu .fill { position: absolute; left: 0; right: 0; bottom: 0; background: linear-gradient(to top, #22c55e 60%, #eab308 85%, #ef4444); } .bmc-vu .pk { position: absolute; left: 0; right: 0; height: 2px; background: #f8fafc; }
    .bmc-fader { display: flex; flex-direction: column; align-items: center; gap: 4px; } .bmc-fader input { writing-mode: vertical-lr; direction: rtl; height: 110px; width: 22px; } .bmc-fader span { font: 700 10px var(--mono); color: var(--text-muted); }
    .bmc-akv { font-size: 10.5px; color: var(--text-muted); display: flex; flex-direction: column; gap: 4px; } .bmc-akv b { color: var(--text-primary); } .bmc-akv .row { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 4px; }
    .bmc-sel { background: #1e293b; color: var(--text-primary); border: 1px solid var(--line); border-radius: 6px; font-size: 11px; }
    .bmc-meter { position: relative; height: 12px; background: #1e293b; border-radius: 6px; overflow: hidden; } .bmc-meter div { height: 100%; } .bmc-meter .ok { background: #22c55e; } .bmc-meter .bad { background: #ef4444; }
    .bmc-meter i { position: absolute; top: 0; bottom: 0; width: 2px; background: #f8fafc; }
    .bmc-plot { width: 100%; height: 60px; background: #0f172a; border-radius: 6px; display: block; margin-top: 6px; } .bmc-plot .occ { fill: none; stroke: #fde047; stroke-width: 1.4; } .bmc-plot .gate { stroke: #ef4444; stroke-dasharray: 4 3; }
    .bmc-act { font-size: 11px; color: var(--text-muted); margin-top: 8px; }
    @@media (max-width: 1100px) { .bmc-main { grid-template-columns: 1fr; } .bmc-views { grid-template-columns: 1fr; } }
</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private readonly byte[] _bmp = new byte[BroadcastMcrStudioRunner.PreviewBytes];
    private System.Threading.Timer? _timer;
    private string _pgm = "", _pvw = "";
    private int _frames = 12;
    private bool _tap = true;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("Mcr.Modal.Timer", ex); }
        }, null, 200, 200);
    }

    protected override bool ShouldRender()
    {
        if (Runner.Compositor is not null && Runner.Mcr.VideoFrames > 0)
        {
            Runner.WritePreviews();
            Runner.CopyPreview(true, _bmp); _pgm = "data:image/bmp;base64," + Convert.ToBase64String(_bmp);
            Runner.CopyPreview(false, _bmp); _pvw = "data:image/bmp;base64," + Convert.ToBase64String(_bmp);
        }
        return true;
    }

    private static string F0(double v) => double.IsFinite(v) ? v.ToString("0", CultureInfo.InvariantCulture) : "—";
    private static string F1(double v) => double.IsFinite(v) ? v.ToString("0.0", CultureInfo.InvariantCulture) : "—";
    private static string F2(double v) => double.IsFinite(v) ? v.ToString("0.00", CultureInfo.InvariantCulture) : "—";
    private static string Pct(float v) => Math.Clamp(v * 100.0, 0, 100).ToString("0.#", CultureInfo.InvariantCulture);
    private static float Level(float db) => Math.Clamp((db + 60f) / 60f, 0f, 1f);
    private static string Yv(double v) => (58 - 56 * Math.Clamp(v, 0, 1)).ToString("0.#", CultureInfo.InvariantCulture);

    private string Series()
    {
        var n = Runner.SeriesCount;
        if (n < 2) return "";
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = 0; i < n; i++)
            sb.Append((600.0 * i / (n - 1)).ToString("0.#", CultureInfo.InvariantCulture)).Append(',').Append(Yv(Runner.OcclusionSeries(n - 1 - i))).Append(' ');
        return sb.ToString();
    }

    private void OnFrames(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var v)) _frames = v; }
    private void OnGain(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var v)) Runner.SetMasterGain(v / 100f); }
    private void OnPlat(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var v)) Runner.SetAudioPlatform((ChatPlatform)v); }

    private void ToggleRun()
    {
        if (Runner.IsRunning) Runner.Stop(); else Runner.Start();
    }

    private void ToggleAir()
    {
        if (Runner.Mcr.EncoderOpen) Runner.StopOnAir(); else Runner.StartOnAir(_tap);
    }

    private Task Close() => OnClose.InvokeAsync();

    private void OnServiceChanged()
    {
        if (!Runner.IsRunning) _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
    }
}
