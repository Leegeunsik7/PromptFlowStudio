@using PromptFlowStudio.Services.Ui
@inject CommandPaletteService Palette
@inject UserPreferenceService Prefs
@inject IJSRuntime JS
@implements IDisposable

@* ═══════════════════════════════════════════════════════════════════════════
   전역 커맨드 팔레트 — Ctrl+K · /

   ⚠ MainLayout 에 딱 하나만 둔다. 명령 목록은 CommandPaletteService 가
     들고 있으므로 이 컴포넌트는 화면일 뿐이다.

   ⚠ 키보드만으로 끝나야 한다. 마우스로 골라야 하면 팔레트를 쓸 이유가 없다 —
     ↑↓ 이동, Enter 실행, Esc 닫기, Tab 은 가두지 않는다(목록이 하나뿐이라
     가둘 필요가 없고, 가두면 오히려 빠져나갈 길이 막힌다).
   ══════════════════════════════════════════════════════════════════════════ *@

@if (_mounted)
{
    <div class="cp-scrim @(_open ? "on" : "")" @onclick="Close" aria-hidden="true"></div>

    <div class="cp-wrap @(_open ? "on" : "")" role="dialog" aria-modal="true"
         aria-label="명령 팔레트" @onkeydown="OnKey">

        <div class="cp">
            <div class="cp-in">
                <span class="cp-in-ic" aria-hidden="true">⚡</span>
                <input id="cp-input" class="cp-in-f" type="text" autocomplete="off"
                       placeholder="명령·메뉴 검색 (영문 자판으로 쳐도 찾습니다)"
                       aria-label="명령 검색"
                       aria-controls="cp-list"
                       aria-activedescendant="@(Hits.Count > 0 ? $"cp-i-{_cursor}" : null)"
                       value="@_query" @oninput="OnInput" />
                <kbd class="cp-kbd">Esc</kbd>
            </div>

            @if (Converted is { } conv)
            {
                @* 한/영 오타 보정이 실제로 걸렸을 때만 알려 준다.
                   조용히 바꿔치기하면 사용자는 왜 이게 나왔는지 모른다. *@
                <div class="cp-conv">
                    <span aria-hidden="true">⌨</span> 한글로 <b>@conv</b> 로 읽어 찾았습니다
                </div>
            }

            <div class="cp-list" id="cp-list" role="listbox" aria-label="명령 목록">
                @if (Hits.Count == 0)
                {
                    <div class="cp-empty">
                        일치하는 명령이 없습니다.<br />
                        <span>메뉴 이름(<i>카메라</i>, <i>생체</i>)이나 동작(<i>이동</i>, <i>복사</i>)으로 찾아보십시오.</span>
                    </div>
                }
                else
                {
                    var recentN = string.IsNullOrWhiteSpace(_query) ? Palette.RecentCount(Hits) : 0;

                    @for (var i = 0; i < Hits.Count; i++)
                    {
                        var idx = i;
                        var c = Hits[idx];
                        var can = c.CanRun is null || c.CanRun();

                        @if (idx == 0 && recentN > 0)
                        {
                            <div class="cp-sec" role="presentation">최근 실행</div>
                        }
                        @if (idx == recentN && recentN > 0)
                        {
                            <div class="cp-sec" role="presentation">전체 명령</div>
                        }

                        <button type="button" id="@($"cp-i-{idx}")" @key="c.Id"
                                class="@($"cp-i {(idx == _cursor ? "on" : "")} {(can ? "" : "off")}")"
                                role="option" aria-selected="@(idx == _cursor ? "true" : "false")"
                                disabled="@(!can)"
                                @onmouseenter="() => _cursor = idx"
                                @onclick="() => Run(c)">
                            <span class="cp-i-ic" aria-hidden="true">@c.Icon</span>
                            <span class="cp-i-t">@c.Title</span>
                            @if (c.IsSensitive)
                            {
                                <span class="cp-i-warn">확인 필요</span>
                            }
                            @if (c.Hint is { } h)
                            {
                                <span class="cp-i-h">@h</span>
                            }
                            <span class="cp-i-g">@c.Group</span>
                        </button>
                    }
                }
            </div>

            <div class="cp-foot">
                <span><kbd class="cp-kbd">↑</kbd><kbd class="cp-kbd">↓</kbd> 이동</span>
                <span><kbd class="cp-kbd">Enter</kbd> 실행</span>
                <span><kbd class="cp-kbd">Esc</kbd> 닫기</span>
                <span class="cp-foot-r">@Hits.Count / @Palette.All.Count</span>
            </div>
        </div>
    </div>
}

@code {
    private bool _open, _mounted, _disposed;
    private string _query = "";
    private int _cursor;
    private DotNetObjectReference<CommandPalette>? _self;
    private bool _pendingFocus;

    private IReadOnlyList<PaletteCommand> Hits = Array.Empty<PaletteCommand>();

    /// <summary>오타 보정이 실제로 결과를 바꾼 경우에만 표시할 문자열.</summary>
    private string? Converted
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_query)) return null;
            var conv = KoreanSearch.LatinToHangul(_query);
            if (conv == _query) return null;
            // 원문으로도 결과가 나오면 굳이 알리지 않는다
            var direct = Palette.All.Any(c => KoreanSearch.Score(c.Haystack, _query) > 0);
            return direct ? null : conv;
        }
    }

    protected override void OnInitialized()
    {
        Palette.OnChange += OnPaletteState;
        _open = Palette.IsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            await SafeJs("siteMaticUi.register", _self);
        }
        if (_pendingFocus && _open)
        {
            _pendingFocus = false;
            await SafeJs("siteMaticUi.focus", "cp-input");
        }
    }

    public void Dispose()
    {
        _disposed = true;
        Palette.OnChange -= OnPaletteState;
        _self?.Dispose();
        _self = null;
    }

    private void OnPaletteState() => InvokeAsync(() =>
    {
        if (_disposed) return;
        var next = Palette.IsOpen;
        if (next == _open) return;
        _open = next;
        if (_open)
        {
            _mounted = true;
            _query = ""; _cursor = 0;
            Recompute();
            _pendingFocus = true;
        }
        StateHasChanged();
    });

    [JSInvokable]
    public Task OnPaletteHotkey()
    {
        if (_disposed) return Task.CompletedTask;
        return InvokeAsync(Palette.Toggle);
    }

    private void Close() => Palette.Close();

    private void OnInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";
        _cursor = 0;
        Recompute();
    }

    private void Recompute() => Hits = Palette.Search(_query);

    /// <summary>
    /// ⚠ 실행 불가 항목은 건너뛰며 이동한다. 흐린 항목에 커서가 멈추면
    ///   Enter 를 눌러도 아무 일이 없어 고장으로 보인다.
    /// </summary>
    private void Move(int delta)
    {
        if (Hits.Count == 0) return;
        var i = _cursor;
        for (var n = 0; n < Hits.Count; n++)
        {
            i = (i + delta + Hits.Count) % Hits.Count;
            var c = Hits[i];
            if (c.CanRun is null || c.CanRun()) { _cursor = i; return; }
        }
        _cursor = i;   // 전부 불가면 그냥 이동
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape": Close(); break;
            case "ArrowDown": Move(1); break;
            case "ArrowUp": Move(-1); break;
            case "Home": _cursor = 0; break;
            case "End": _cursor = Math.Max(0, Hits.Count - 1); break;
            case "Enter":
                if (_cursor >= 0 && _cursor < Hits.Count) await Run(Hits[_cursor]);
                break;
        }
    }

    private async Task Run(PaletteCommand c)
    {
        if (!string.IsNullOrWhiteSpace(_query))
            Prefs.PushRecent(UserPreferenceService.Keys.RecentSearches, _query);
        await Palette.RunAsync(c);
    }

    private async Task SafeJs(string fn, params object?[] args)
    {
        try { await JS.InvokeVoidAsync(fn, args); }
        catch (Exception) { /* 프리렌더·종료 중 — 팔레트 때문에 앱이 죽으면 안 된다 */ }
    }
}
