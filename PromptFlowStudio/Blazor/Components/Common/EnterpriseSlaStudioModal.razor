@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private System.Threading.Timer? _timer;
    private bool? _verified;
    private string? _exportPath;

    private ThreadDeadlockAutoProbingEngine E => Runner.Engine;
    private ZeroDowntimeProcessFailoverSynthesizer S => Runner.Synth;
    private EnterpriseSlaAvailabilityGuard G => Runner.Guard;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("Sla.Modal.Timer", ex); }
        }, null, 250, 250);
    }

    private static string F0(double v) => v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => v.ToString("0.00", CultureInfo.InvariantCulture);
    private static string Pct(double v) => (v * 100).ToString("0", CultureInfo.InvariantCulture) + "%";
    private static string Mb(long b) => (b / (1024d * 1024d)).ToString("0", CultureInfo.InvariantCulture) + " MB";
    private static string Short(string h) => h.Length > 12 ? h.Substring(0, 12) : h;
    private static string Dur(double ms) => ms >= 60_000 ? (ms / 60_000).ToString("0.0", CultureInfo.InvariantCulture) + " 분" : (ms / 1000).ToString("0.0", CultureInfo.InvariantCulture) + " s";
    private string AvailText() => (G.Availability * 100).ToString("0.0000", CultureInfo.InvariantCulture) + "%";

    // 미터: 0~9 nines → 반원 각도(π → 0)
    private static double Angle(double nines) => Math.PI * (1 - Math.Clamp(nines / 9.0, 0, 1));
    private string MeterArc()
    {
        var a = Angle(G.Nines);
        return "M 20 112 A 90 90 0 0 1 " + F1(110 + 90 * Math.Cos(a)) + " " + F1(112 - 90 * Math.Sin(a));
    }
    private static double TargetX(int k) => 110 + (k == 0 ? 78 : 102) * Math.Cos(Angle(5));
    private static double TargetY(int k) => 112 - (k == 0 ? 78 : 102) * Math.Sin(Angle(5));
    private string BudgetPct() => (G.ErrorBudgetMs <= 0 ? 100 : Math.Clamp(100 * G.BudgetRemainingMs / G.ErrorBudgetMs, 0, 100)).ToString("0.0", CultureInfo.InvariantCulture);

    private string NinesPoints()
    {
        var n = G.SeriesCount;
        if (n < 2) return "";
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = n - 1; i >= 0; i--)
            sb.Append(F1(360d * (n - 1 - i) / (EnterpriseSlaAvailabilityGuard.SeriesLen - 1))).Append(',').Append(F1(40 - 40 * Math.Clamp(G.Series(i) / 9.0, 0, 1))).Append(' ');
        return sb.ToString();
    }

    // 토폴로지 좌표
    private static int LX(int lane) => lane % 2 == 0 ? 96 : 424;
    private static int LY(int lane) => lane < 2 ? 70 : 200;
    private const int LockX = 260;
    private static int LockY(int l) => l == 0 ? 26 : 244;

    private string LaneClass(int lane)
    {
        var sub = Runner.Sub(lane); var slot = Runner.Slot(lane);
        if (S.IsDown(sub)) return "down";
        if (E.WaitingLock(slot) >= 0) return "wait";
        if (E.IsBusy(slot) && (E.SinceBeatMs(slot) > E.Timeout(slot) || E.OpElapsedMs(slot) > E.Timeout(slot) * E.SpinFactor)) return "hang";
        return "ok";
    }

    private string LaneState(int lane)
    {
        var slot = Runner.Slot(lane);
        if (S.IsDown(Runner.Sub(lane))) return "서비스 중단";
        if (E.WaitingLock(slot) >= 0) return "락 대기 " + F0(E.OpElapsedMs(slot)) + " ms";
        if (E.IsBusy(slot)) return "작업 " + F0(E.OpElapsedMs(slot)) + " ms";
        return "완료 " + E.Completed(slot);
    }

    private string FindingText(HangFinding f)
    {
        var who = f.Slot >= 0 ? E.Name(f.Slot) + " (T" + f.ThreadId + ")" : "프로세스";
        return f.Kind switch
        {
            HangKind.Stalled => who + " · 무진행 " + F0(f.DurationMs) + " ms · 진행 " + F0(f.Metric),
            HangKind.Spinning => who + " · 작업 " + F0(f.DurationMs) + " ms 미완료 · 진행 " + F0(f.Metric),
            HangKind.Deadlock => who + " ⇄ " + (f.Partner >= 0 ? E.Name(f.Partner) : "?") + " · " + E.LockName(f.LockId) + " 대기 " + F0(f.DurationMs) + " ms · 사이클 " + f.CycleLength,
            HangKind.Starvation => "스레드 풀 큐 지연 " + F0(f.DurationMs) + " ms · 대기 " + F0(f.Metric),
            HangKind.MemoryPressure => "관리 힙 " + F0(f.Metric) + " MB > 예산",
            _ => who,
        };
    }

    private void ToggleRun() { if (Runner.IsRunning) Runner.Stop(); else Runner.Start(); }

    private void TogglePool()
    {
        G.ApplyThreadPool = !G.ApplyThreadPool;
        if (!G.ApplyThreadPool) G.RestoreThreadPool();
    }

    private void Export()
    {
        try { _exportPath = G.Export(); _verified = EnterpriseSlaAvailabilityGuard.VerifyFile(_exportPath); }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException) { _exportPath = "⚠ " + ex.Message; }
    }

    private void Verify() => _verified = G.VerifyManifest();

    private Task Close() => OnClose.InvokeAsync();

    private void OnServiceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
