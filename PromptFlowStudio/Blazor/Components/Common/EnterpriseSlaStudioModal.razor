    .esm-log .k1 { border-color: #ef4444; } .esm-log .k2 { border-color: #f97316; } .esm-log .k3 { border-color: #eab308; } .esm-log .k4 { border-color: #818cf8; } .esm-log .k5 { border-color: #ec4899; }
