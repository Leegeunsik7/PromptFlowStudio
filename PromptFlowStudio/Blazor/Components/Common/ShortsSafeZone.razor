@* [PromptFlow Studio] 숏츠 세이프존(Safe Zone) 오버레이 — 세로 영상 위에 YouTube Shorts/Reels UI(우측 반응 버튼 · 하단 제목·사운드)를
   반투명 목업으로 겹쳐, 플랫폼 UI 가 실제로 가리는 영역을 미리 보여준다. 순수 오버레이(pointer-events:none) — 아래 영상 컨트롤 방해 없음.
   사용: <ShortsSafeZone Handle="@내채널" Caption="영상 제목"><video .../></ShortsSafeZone> — 자식으로 넘긴 미디어를 감싼다.
   ⚠ 시각 가이드 전용 — 실제 영상에 합성되지 않는다(자막·안전영역 확인용). 세로(쇼츠) 비율에서만 켜는 것을 권장. *@

<div class="szw">
    @ChildContent

    <div class="sz-ov" aria-hidden="true">
        @* 우측 반응 버튼 레일(구독/좋아요/댓글/공유/더보기 + 사운드 디스크) *@
        <div class="sz-rail">
            <div class="sz-ic sz-sub"><span class="sz-gl">＋</span><small>구독</small></div>
            <div class="sz-ic"><span class="sz-gl">♥</span><small>좋아요</small></div>
            <div class="sz-ic"><span class="sz-gl">💬</span><small>댓글</small></div>
            <div class="sz-ic"><span class="sz-gl">↪</span><small>공유</small></div>
            <div class="sz-ic"><span class="sz-gl">⋯</span></div>
            <div class="sz-disc">🎵</div>
        </div>

        @* 하단 제목·사운드 영역 *@
        <div class="sz-bottom">
            <div class="sz-handle">@(string.IsNullOrWhiteSpace(Handle) ? "@내채널" : Handle)</div>
            @if (!string.IsNullOrWhiteSpace(Caption))
            {
                <div class="sz-cap">@Caption</div>
            }
            <div class="sz-sound"><span class="sz-note">🎵</span><span class="sz-marq">원본 오디오 · @(string.IsNullOrWhiteSpace(Handle) ? "@내채널" : Handle)</span></div>
        </div>

        @* 가려지는 영역 가이드(점선) *@
        <div class="sz-guide sz-guide-r"><span>우측 버튼 영역</span></div>
        <div class="sz-guide sz-guide-b"><span>제목·사운드 영역</span></div>

        <div class="sz-badge">🛡️ 숏츠 UI 가이드</div>
    </div>
</div>

<style>
    .szw { position: relative; display: block; line-height: 0; }
    .szw > :not(.sz-ov) { display: block; width: 100%; }

    /* 오버레이 — 시각 가이드 전용(클릭 통과) */
    .sz-ov { position: absolute; inset: 0; pointer-events: none; z-index: 4; font-family: var(--mono, system-ui); line-height: 1.2;
        border-radius: inherit; overflow: hidden; }

    /* 우측 반응 레일 */
    .sz-rail { position: absolute; right: 3.5%; bottom: 13%; display: flex; flex-direction: column; align-items: center; gap: 6.5%; }
    .sz-ic { display: flex; flex-direction: column; align-items: center; gap: 3px; color: #fff; filter: drop-shadow(0 1px 3px rgba(0,0,0,.7)); }
    .sz-gl { width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,.16); backdrop-filter: blur(2px);
        display: flex; align-items: center; justify-content: center; font-size: 19px; }
    .sz-sub .sz-gl { background: #ef4444; }
    .sz-ic small { font-size: 9.5px; font-weight: 700; }
    .sz-disc { width: 34px; height: 34px; border-radius: 9px; background: rgba(0,0,0,.55); border: 2px solid rgba(255,255,255,.85);
        display: flex; align-items: center; justify-content: center; font-size: 15px; animation: sz-spin 3.5s linear infinite; }

    /* 하단 제목·사운드 */
    .sz-bottom { position: absolute; left: 4%; right: 20%; bottom: 4.5%; color: #fff; text-shadow: 0 1px 4px rgba(0,0,0,.85); }
    .sz-handle { font-size: 13px; font-weight: 900; margin-bottom: 5px; }
    .sz-cap { font-size: 11.5px; font-weight: 600; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .sz-sound { display: flex; align-items: center; gap: 6px; margin-top: 7px; font-size: 10.5px; font-weight: 700; opacity: .95; overflow: hidden; white-space: nowrap; }
    .sz-note { animation: sz-bob 1.4s ease-in-out infinite; }

    /* 가려짐 가이드(점선 박스 + 라벨) */
    .sz-guide { position: absolute; border: 1.5px dashed rgba(255,255,255,.55); border-radius: 10px; }
    .sz-guide span { position: absolute; top: -1px; left: 50%; transform: translate(-50%, -115%); white-space: nowrap;
        font-size: 9px; font-weight: 800; color: #fff; background: rgba(139,92,246,.92); padding: 2px 7px; border-radius: 999px; }
    .sz-guide-r { right: 1.5%; bottom: 10%; top: 30%; width: 20%; }
    .sz-guide-r span { top: -2px; }
    .sz-guide-b { left: 2.5%; right: 2.5%; bottom: 2.5%; height: 22%; }

    .sz-badge { position: absolute; top: 8px; left: 8px; font-size: 10px; font-weight: 800; color: #fff;
        background: linear-gradient(135deg, var(--flow-violet, #8b5cf6), var(--flow-magenta, #d946ef));
        padding: 4px 9px; border-radius: 999px; box-shadow: 0 4px 12px rgba(0,0,0,.4); }

    @@keyframes sz-spin { to { transform: rotate(360deg); } }
    @@keyframes sz-bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-2px); } }
    @@media (prefers-reduced-motion: reduce) { .sz-disc, .sz-note { animation: none; } }
</style>

@code {
    /// <summary>감쌀 미디어(보통 &lt;video&gt;). 오버레이가 이 위에 겹쳐진다.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>목업 채널 핸들(기본 "@내채널").</summary>
    [Parameter] public string? Handle { get; set; }

    /// <summary>목업 제목/캡션(비면 숨김).</summary>
    [Parameter] public string? Caption { get; set; }
}
