@using System.Globalization
@using System.Numerics
@using PromptFlowStudio.Services.Microclimate
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable
@inject AtmosphericWeatherStudioRunner Runner

@* [PromptFlow Studio v17.28.0] ⛈ AI 대기 기상 & 미기후 스튜디오 — 3D 풍향/풍속 나침반 · 운량/강수 지도 · 연직 단면 · 헤어/망토 항력 뷰 · 기상 프리셋 · 강우(mm/h)/기온(°C) 슬라이더 · 발산/마하 가드. *@

<div class="amw-scrim" @onclick="Close">
    <div class="amw-modal" @onclick:stopPropagation="true">
        <div class="amw-h">
            <div>
                <div class="amw-title">⛈️ AI 대기 기상 &amp; 미기후 스튜디오</div>
                <div class="amw-sub"><b>기상 엔진</b>이 v17.27 생성형 월드 지형 위 @(RealtimeAtmosphericWeatherSimulationEngine.NX)×@(RealtimeAtmosphericWeatherSimulationEngine.NY)×@(RealtimeAtmosphericWeatherSimulationEngine.NZ) 복셀(@(F0(RealtimeAtmosphericWeatherSimulationEngine.H)) m)에서 비압축 나비에-스톡스 이류 · 기온 감률 · 기압 경도력 · 응결 잠열로 풍장과 구름/안개/강수를 만들고, <b>미기후 합성기</b>가 머리 높이 풍속을 헤어 가이드 · 망토 프록시에 공기역학 항력으로 투영하며 강우 젖음(v17.19 막 두께) · 적설과 v17.26 마찰각 안식각 이완을 합성합니다. <b>가드</b>는 헬름홀츠-호지 무발산 투영 · 마하 0.3 · NaN 격리 · CFL · 에너지 클램프로 폭주를 막습니다.</div>
            </div>
            <button class="amw-x" @onclick="Close">✕</button>
        </div>
        <div class="amw-bar">
            <button class="amw-btn @(Runner.IsRunning ? "on" : null)" @onclick="ToggleRun">@(Runner.IsRunning ? "⏸ 정지" : "▶ 가동")</button>
            <button class="amw-btn" @onclick="Step30" disabled="@Runner.IsRunning">⏭ 0.5초</button>
            <button class="amw-btn @(G.Enabled ? "on" : null)" @onclick="() => Runner.SetGuard(!G.Enabled)">🛡 가드</button>
            <button class="amw-btn @(M.AeroEnabled ? "on" : null)" @onclick="() => Runner.SetAero(!M.AeroEnabled)">🌬 항력</button>
            <button class="amw-btn @(M.PrecipEnabled ? "on" : null)" @onclick="() => Runner.SetPrecip(!M.PrecipEnabled)">🌧 강수</button>
            <button class="amw-btn @(E.UseSimd ? "on" : null)" @onclick="() => Runner.SetSimd(!E.UseSimd)">⚡ SIMD</button>
            <button class="amw-btn warn" @onclick="Runner.InjectFault">💥 NaN 주입</button>
            <span class="amw-chip @(Runner.LastTickMs <= 16.7 ? "ok" : "warn")">프레임 @(F2(Runner.LastTickMs)) ms(최대 @(F1(Runner.MaxTickMs))) · 투영 @(F2(G.LastProjectUs / 1000)) ms × @(G.LastSubsteps)</span>
            <span class="amw-chip">시뮬 @(F0(E.SimTime)) s · ×@(F0(Runner.TimeScale))</span>
        </div>
        <div class="amw-main">
            <div class="amw-col">
                <div class="amw-card">
                    <div class="amw-sec">🌦 기상 프리셋</div>
                    <div class="amw-presets">
                        @for (var i = 0; i < RealtimeAtmosphericWeatherSimulationEngine.Presets.Length; i++)
                        {
                            var pr = (WeatherPreset)i;
                            var sp = RealtimeAtmosphericWeatherSimulationEngine.Presets[i];
                            <button class="amw-pre @(E.Preset == pr ? "on" : null)" @onclick="() => Runner.SetPreset(pr)">
                                <b>@(PresetIcon(pr)) @(sp.Name)</b>
                                <span>@(F0(sp.SurfaceC)) °C · RH @(F0(sp.Humidity * 100))% · @(F0(sp.WindMs)) m/s</span>
                            </button>
                        }
                    </div>
                    <div class="amw-ctl">
                        <label class="amw-sl">🌡 기온 <b>@(F1(E.SurfaceC)) °C</b><input type="range" min="-30" max="45" step="0.5" value="@(F1(E.SurfaceC))" @onchange="e => Runner.SetTemperature((float)Num(e, 20))" /></label>
                        <label class="amw-sl">🌧 강우 강도 <b>@(F1(M.RainOverrideMmH)) mm/h</b><input type="range" min="0" max="150" step="1" value="@(F0(M.RainOverrideMmH))" @onchange="e => Runner.SetRain((float)Num(e, 0))" /></label>
                        <label class="amw-sl">🧭 지균풍 <b>@(F1(E.WindMs)) m/s</b><input type="range" min="0" max="60" step="1" value="@(F0(E.WindMs))" @onchange="e => Runner.SetWind((float)Num(e, 5))" /></label>
                        <label class="amw-sl">↻ 풍향 <b>@(F0(E.WindDirDeg))°</b><input type="range" min="0" max="355" step="5" value="@(F0(E.WindDirDeg))" @onchange="e => Runner.SetWindDir((float)Num(e, 0))" /></label>
                        <label class="amw-sl">💧 습도 <b>@(F0(E.Humidity * 100))%</b><input type="range" min="0.05" max="1" step="0.01" value="@(F2(E.Humidity))" @onchange="e => Runner.SetHumidity((float)Num(e, 0.6))" /></label>
                        <label class="amw-sl">🌀 기압 스트레스 <b>×@(F1(E.PressureStress))</b><input type="range" min="0.5" max="8" step="0.5" value="@(F1(E.PressureStress))" @onchange="e => Runner.SetStress((float)Num(e, 1))" /></label>
                        <label class="amw-sl">⏱ 시간 <b>×@(F0(Runner.TimeScale))</b><input type="range" min="1" max="60" step="1" value="@(F0(Runner.TimeScale))" @onchange="e => Runner.SetTimeScale((float)Num(e, 20))" /></label>
                    </div>
                </div>

                <div class="amw-card">
                    <div class="amw-sec">🧭 3D 풍향/풍속 나침반(머리 높이) · <b>@(F1(Wind.Length())) m/s</b> · 연직 @(F2(Wind.Y)) m/s · 기압 경도 @(F2(E.PressureGradientHpaKm)) hPa/km</div>
                    <div class="amw-compass-row">
                        <svg class="amw-compass" viewBox="0 0 200 200">
                            <circle class="ring" cx="100" cy="100" r="88" /><circle class="ring in" cx="100" cy="100" r="44" />
                            <text x="100" y="20">N</text><text x="186" y="104">E</text><text x="100" y="192">S</text><text x="14" y="104">W</text>
                            <line class="arrow" x1="100" y1="100" x2="@(F1(100 + CompassX * 84))" y2="@(F1(100 - CompassZ * 84))" />
                            <circle class="tip" cx="@(F1(100 + CompassX * 84))" cy="@(F1(100 - CompassZ * 84))" r="@(F1(4 + Math.Clamp(Wind.Y * 3, -3, 6)))" />
                        </svg>
                        <svg class="amw-aero" viewBox="-0.45 -2.0 0.9 2.1">
                            <line class="body" x1="0" y1="-0.1" x2="0" y2="-1.45" />
                            <circle class="head" cx="0" cy="@(F2(-1.65f))" r="@(F2(MicroclimateAeroPrecipitationSynthesizer.HeadR))" />
                            @for (var s = 0; s < MicroclimateAeroPrecipitationSynthesizer.Strands; s += 2)
                            {
                                <polyline class="hair" points="@(HairPoints(s))" />
                            }
                            @for (var i = 0; i < MicroclimateAeroPrecipitationSynthesizer.CapeW; i += 3)
                            {
                                <polyline class="cape" points="@(CapePoints(i))" />
                            }
                        </svg>
                    </div>
                    <div class="amw-stats">
                        <span><b>@(F0(M.HairDeflectionDeg))°</b>헤어 편향</span><span><b>@(F0(M.CapeLiftDeg))°</b>망토 들림</span><span><b>@(F1(M.MaxNodeSpeed))</b>노드 최대 속도(m/s)</span>
                    </div>
                </div>
            </div>

            <div class="amw-col">
                <div class="amw-card">
                    <div class="amw-sec">☁ 운량 · 강수 지도(@(RealtimeAtmosphericWeatherSimulationEngine.NX)² 기둥) · 운량 <b>@(F0(E.CloudCover * 100))%</b> · 강수 평균 @(F1(E.MeanPrecipMmH)) / 최대 @(F1(E.MaxPrecipMmH)) mm/h · 가시거리 @(F0(E.FogVisibilityM)) m</div>
                    <div class="amw-maps">
                        <svg class="amw-map" viewBox="0 0 32 32">
                            @for (var c = 0; c < RealtimeAtmosphericWeatherSimulationEngine.Columns; c++)
                            {
                                <rect x="@(c % RealtimeAtmosphericWeatherSimulationEngine.NX)" y="@(RealtimeAtmosphericWeatherSimulationEngine.NZ - 1 - c / RealtimeAtmosphericWeatherSimulationEngine.NX)" width="1.02" height="1.02" fill="@(CloudFill(c))" />
                            }
                            <circle class="actor" cx="16.5" cy="15.5" r="0.7" />
                        </svg>
                        <svg class="amw-map" viewBox="0 0 32 16" preserveAspectRatio="none">
                            @for (var y = 0; y < RealtimeAtmosphericWeatherSimulationEngine.NY; y++)
                            {
                                for (var x = 0; x < RealtimeAtmosphericWeatherSimulationEngine.NX; x++)
                                {
                                    var i = RealtimeAtmosphericWeatherSimulationEngine.Idx(x, y, RealtimeAtmosphericWeatherSimulationEngine.NZ / 2);
                                    <rect x="@(x)" y="@(RealtimeAtmosphericWeatherSimulationEngine.NY - 1 - y)" width="1.02" height="1.02" fill="@(SliceFill(i))" />
                                }
                            }
                        </svg>
                    </div>
                    <div class="amw-legend"><i class="cl"></i>운수량 <i class="rn"></i>강수 <i class="sn"></i>적설 <i class="wt"></i>젖음 · 우: 연직 단면(z 중앙 · 기온 색 + 구름 흰색) · 공중 입자 @(M.Airborne)(눈 @(M.AirborneSnow)) · 입자당 @(F2(M.ParticleMm)) mm</div>
                    <div class="amw-stats">
                        <span><b>@(F0(M.MeanWetness * 100))%</b>지면 젖음</span><span><b>@(F0(M.ActorWetness * 100))%</b>액터 젖음</span><span><b>@(F2(M.MeanSnowCm))</b>평균 적설(cm)</span>
                        <span><b>@(F2(M.PatchSnowM3 * 1000))</b>액터 주변 적설(L)</span><span><b>@(F2(M.PatchMaxSlope))</b>최대 경사(tan · 한계 @(F2(MicroclimateAeroPrecipitationSynthesizer.ReposeTan)))</span><span><b>@(M.Avalanches)</b>사태 이완</span>
                    </div>
                </div>

                <div class="amw-card">
                    <div class="amw-sec">🛡 열역학 에너지 발산 · 기압 폭주 가드 @(G.Enabled ? "ON" : "OFF")</div>
                    <svg class="amw-ser" viewBox="0 0 360 80" preserveAspectRatio="none">
                        <line class="mach" x1="0" y1="@(F1(78 - 76 * ThermodynamicEnergyDivergenceWeatherGuard.MaxSpeed / SpeedScale))" x2="360" y2="@(F1(78 - 76 * ThermodynamicEnergyDivergenceWeatherGuard.MaxSpeed / SpeedScale))" />
                        <polyline class="mx" points="@(Series(0, SpeedScale))" /><polyline class="wd" points="@(Series(1, SpeedScale))" /><polyline class="rn" points="@(Series(2, Math.Max(10, E.MaxPrecipMmH * 1.2)))" />
                    </svg>
                    <div class="amw-legend"><i class="mxl"></i>격자 최대 풍속 <i class="wdl"></i>머리 높이 풍속(0–@(F0(SpeedScale)) m/s) <i class="machl"></i>마하 0.3 <i class="rnl"></i>평균 강수</div>
                    <div class="amw-stats">
                        <span><b class="@(G.DivergenceAfter < 1e-3f ? "ok" : "warn")">@(Sci(G.DivergenceBefore)) → @(Sci(G.DivergenceAfter))</b>RMS 발산(1/s)</span><span><b>@(F1(E.MaxSpeed))</b>최대 풍속(m/s)</span><span><b>@(G.MachClamps)</b>마하 클램프</span>
                        <span><b class="@(E.Nan > 0 ? "bad" : "ok")">@(E.Nan)</b>NaN 셀(격리 @(G.NanScrubbed))</span><span><b>@(G.EnergyClamps)</b>에너지 클램프</span><span><b>@(F1(E.KineticEnergy / 1e9f))</b>운동 에너지(GJ)</span>
                    </div>
                    <div class="amw-ctl"><button class="amw-btn sm" @onclick="Runner.ResetMetrics">↺ 지표 초기화</button></div>
                </div>
                <div class="amw-note">@(Runner.LastAction ?? "대기")</div>
            </div>
        </div>
    </div>
</div>

<style>
    .amw-scrim { position: fixed; inset: 0; z-index: var(--z-studio-modal); background: rgba(0,0,0,.62); display: flex; align-items: center; justify-content: center; padding: 20px; }
    .amw-modal { width: min(1640px, 97vw); max-height: 94vh; display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--line); border-radius: 16px; box-shadow: 0 24px 60px rgba(0,0,0,.45); overflow: hidden; }
    .amw-h { display: flex; justify-content: space-between; gap: 12px; padding: 14px 18px; border-bottom: 1px solid var(--line); background: linear-gradient(120deg, color-mix(in srgb, #64748b 16%, var(--card)), color-mix(in srgb, #38bdf8 12%, var(--card))); }
    .amw-title { font-size: 17px; font-weight: 900; color: var(--text-primary); }
    .amw-sub { font-size: 12px; color: var(--text-secondary); margin-top: 4px; line-height: 1.5; }
    .amw-sub b { color: var(--text-primary); }
    .amw-x { background: none; border: none; color: var(--text-muted); font-size: 18px; cursor: pointer; border-radius: 8px; height: 32px; width: 32px; }
    .amw-bar { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 18px; border-bottom: 1px solid var(--line); align-items: center; }
    .amw-btn { font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 8px; border: 1px solid var(--line); background: var(--card); color: var(--text-primary); cursor: pointer; }
    .amw-btn:disabled { opacity: .45; cursor: default; }
    .amw-btn.sm { font-size: 11px; padding: 3px 8px; }
    .amw-btn.on { background: color-mix(in srgb, #38bdf8 22%, var(--card)); border-color: #38bdf8; }
    .amw-btn.warn { border-color: #f87171; }
    .amw-chip { font: 700 11px var(--mono); padding: 4px 8px; border-radius: 999px; border: 1px solid var(--line); color: var(--text-secondary); }
    .amw-chip.ok { border-color: #22c55e; color: #22c55e; }
    .amw-chip.warn { border-color: #f59e0b; color: #f59e0b; }
    .amw-main { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 12px 18px 16px; min-height: 0; flex: 1; overflow-y: auto; }
    .amw-col { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
    .amw-card { border: 1px solid var(--line); border-radius: 12px; padding: 12px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
    .amw-sec { font-weight: 800; font-size: 13px; color: var(--text-primary); display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
    .amw-presets { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
    .amw-pre { display: flex; flex-direction: column; gap: 2px; align-items: flex-start; text-align: left; padding: 7px 8px; border-radius: 10px; border: 1px solid var(--line); background: var(--card); color: var(--text-secondary); cursor: pointer; font-size: 10.5px; }
    .amw-pre b { font-size: 12px; color: var(--text-primary); }
    .amw-pre.on { border-color: #38bdf8; background: color-mix(in srgb, #38bdf8 16%, var(--card)); }
    .amw-ctl { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; }
    .amw-sl { display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--text-secondary); }
    .amw-sl b { font-family: var(--mono); color: var(--text-primary); }
    .amw-compass-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .amw-compass, .amw-aero { width: 100%; aspect-ratio: 1; background: #030712; border-radius: 8px; }
    .amw-compass .ring { fill: none; stroke: #334155; stroke-width: 1.2; } .amw-compass .ring.in { stroke-dasharray: 3 3; }
    .amw-compass text { fill: #94a3b8; font: 700 11px var(--mono); text-anchor: middle; }
    .amw-compass .arrow { stroke: #38bdf8; stroke-width: 4; stroke-linecap: round; }
    .amw-compass .tip { fill: #fbbf24; }
    .amw-aero .body { stroke: #64748b; stroke-width: .12; stroke-linecap: round; }
    .amw-aero .head { fill: #fca5a5; }
    .amw-aero .hair { fill: none; stroke: #fbbf24; stroke-width: .012; }
    .amw-aero .cape { fill: none; stroke: #a78bfa; stroke-width: .02; }
    .amw-maps { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; align-items: center; }
    .amw-map { width: 100%; background: #030712; border-radius: 6px; }
    .amw-map:first-child { aspect-ratio: 1; }
    .amw-map:last-child { aspect-ratio: 2 / 1; }
    .amw-map .actor { fill: none; stroke: #f472b6; stroke-width: .25; }
    .amw-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px 10px; font-size: 10.5px; color: var(--text-muted); }
    .amw-stats span { display: flex; flex-direction: column; gap: 1px; }
    .amw-stats b { font: 800 13px var(--mono); color: var(--text-primary); }
    .amw-stats b.ok { color: #22c55e; } .amw-stats b.warn { color: #f59e0b; } .amw-stats b.bad { color: #ef4444; }
    .amw-ser { width: 100%; height: 80px; background: #030712; border-radius: 6px; }
    .amw-ser polyline { fill: none; stroke-width: 1.5; vector-effect: non-scaling-stroke; }
    .amw-ser .mach { stroke: #ef4444; stroke-dasharray: 4 3; stroke-width: 1; vector-effect: non-scaling-stroke; }
    .amw-ser .mx { stroke: #f87171; } .amw-ser .wd { stroke: #38bdf8; } .amw-ser .rn { stroke: #22c55e; }
    .amw-legend { display: flex; flex-wrap: wrap; gap: 4px 10px; font-size: 11px; line-height: 1.45; color: var(--text-secondary); align-items: center; min-width: 0; overflow-wrap: anywhere; }
    .amw-legend i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 3px; }
    .amw-legend .cl { background: #e2e8f0; } .amw-legend .rn, .amw-legend .rnl { background: #22c55e; } .amw-legend .sn { background: #a5f3fc; } .amw-legend .wt { background: #1d4ed8; }
    .amw-legend .mxl { background: #f87171; } .amw-legend .wdl { background: #38bdf8; } .amw-legend .machl { background: #ef4444; }
    .amw-note { font-size: 11px; color: var(--text-muted); word-break: break-all; }
    @@media (max-width: 1100px) { .amw-main { grid-template-columns: 1fr; } .amw-presets { grid-template-columns: repeat(2, 1fr); } }
</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private System.Threading.Timer? _timer;
    private RealtimeAtmosphericWeatherSimulationEngine E => Runner.Engine;
    private ThermodynamicEnergyDivergenceWeatherGuard G => Runner.Guard;
    private MicroclimateAeroPrecipitationSynthesizer M => Runner.Micro;
    private Vector3 Wind => M.WindAtHead;
    private float SpeedScale => MathF.Max(20f, MathF.Min(200f, MathF.Max(E.MaxSpeed, ThermodynamicEnergyDivergenceWeatherGuard.MaxSpeed) * 1.15f));
    private float CompassX { get { var h = new Vector2(Wind.X, Wind.Z); var l = h.Length(); return l < 1e-4f ? 0f : h.X / l * MathF.Min(1f, l / 15f); } }
    private float CompassZ { get { var h = new Vector2(Wind.X, Wind.Z); var l = h.Length(); return l < 1e-4f ? 0f : h.Y / l * MathF.Min(1f, l / 15f); } }

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("Microclimate.Modal.Timer", ex); }
        }, null, 250, 250);
    }

    private static string F0(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "0" : v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0.00", CultureInfo.InvariantCulture);
    private static string Sci(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0.0E0", CultureInfo.InvariantCulture);
    private static double Num(ChangeEventArgs e, double fallback) => double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : fallback;
    private static string Rgb(float r, float g, float b) => "rgb(" + ((int)(255 * Math.Clamp(r, 0f, 1f))).ToString(CultureInfo.InvariantCulture) + "," + ((int)(255 * Math.Clamp(g, 0f, 1f))).ToString(CultureInfo.InvariantCulture) + "," + ((int)(255 * Math.Clamp(b, 0f, 1f))).ToString(CultureInfo.InvariantCulture) + ")";

    private static string PresetIcon(WeatherPreset p) => p switch { WeatherPreset.Clear => "☀️", WeatherPreset.Typhoon => "🌀", WeatherPreset.Blizzard => "❄️", _ => "🌫️" };

    private string CloudFill(int c)
    {
        var cl = Math.Clamp(E.ColumnCloud(c) / 0.4f, 0f, 1f);
        var rn = Math.Clamp(E.ColumnPrecip(c) / 40f, 0f, 1f);
        var sn = Math.Clamp(M.SnowCm(c) / 2f, 0f, 1f);
        var wt = M.Wetness(c);
        var g = 0.12f + 0.15f * (E.GroundLevel(c) / 4f);
        float r = g * (1 - wt * 0.6f), gg = g * (1 - wt * 0.4f), b = g + wt * 0.35f;
        r += (0.85f - r) * sn; gg += (0.95f - gg) * sn; b += (1f - b) * sn;
        r += (0.9f - r) * cl * 0.85f; gg += (0.92f - gg) * cl * 0.85f; b += (0.95f - b) * cl * 0.85f;
        gg += rn * 0.35f;
        return Rgb(r, gg, b);
    }

    private string SliceFill(int i)
    {
        if (E.Solid(i)) return "#3f3f46";
        var t = Math.Clamp((E.Temperature(i) + 20f) / 50f, 0f, 1f);
        var cl = Math.Clamp(E.CloudWater(i) / 1f, 0f, 1f);
        float r = 0.15f + 0.75f * t, g = 0.25f + 0.25f * (1 - MathF.Abs(t - 0.5f) * 2), b = 0.85f - 0.7f * t;
        return Rgb(r + (1 - r) * cl, g + (1 - g) * cl, b + (1 - b) * cl);
    }

    // 측면 투영(x–y · 액터 기준 상대)
    private string HairPoints(int s)
    {
        var sb = new System.Text.StringBuilder(160);
        var o = M.ActorBase;
        for (var k = 0; k < MicroclimateAeroPrecipitationSynthesizer.Nodes; k++)
        {
            var p = M.HairNode(s, k) - o;
            sb.Append(F2(p.X)).Append(',').Append(F2(-p.Y)).Append(' ');
        }
        return sb.ToString();
    }

    private string CapePoints(int i)
    {
        var sb = new System.Text.StringBuilder(200);
        var o = M.ActorBase;
        for (var j = 0; j < MicroclimateAeroPrecipitationSynthesizer.CapeH; j++)
        {
            var p = M.CapeVertex(i, j) - o;
            sb.Append(F2(p.Z + p.X * 0.3f)).Append(',').Append(F2(-p.Y)).Append(' ');
        }
        return sb.ToString();
    }

    private string Series(int kind, double full)
    {
        var n = Runner.SeriesCount;
        if (n < 2) return "";
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = n - 1; i >= 0; i--)
        {
            double v = kind switch { 0 => Runner.MaxWindSeries(i), 1 => Runner.WindSeries(i), _ => Runner.RainSeries(i) };
            if (!double.IsFinite(v)) v = full;
            sb.Append(F1(360.0 * (n - 1 - i) / (AtmosphericWeatherStudioRunner.SeriesLen - 1))).Append(',').Append(F1(78 - 76 * Math.Clamp(v / full, 0, 1))).Append(' ');
        }
        return sb.ToString();
    }

    private void ToggleRun()
    {
        if (Runner.IsRunning) Runner.Stop(); else Runner.Start();
    }

    private void Step30()
    {
        for (var i = 0; i < AtmosphericWeatherStudioRunner.Hz / 2; i++) Runner.Step();
    }

    private Task Close() => OnClose.InvokeAsync();

    /// <summary>가동 중 갱신은 250 ms 타이머가 처리 — 정지 상태 변경만 즉시 반영.</summary>
    private void OnServiceChanged()
    {
        if (!Runner.IsRunning) _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
