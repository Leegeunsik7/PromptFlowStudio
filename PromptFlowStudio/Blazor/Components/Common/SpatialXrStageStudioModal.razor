@using System.Globalization
@using System.Threading
@using PromptFlowStudio.Services.Xr
@using PromptFlowStudio.Services.DigitalTwin
@implements IDisposable
@inject VolumetricVideoHologramStreamer Holo
@inject VirtualConcertStageOrchestrator Stage
@inject MultiUserVirtualAudienceBridge Crowd
@inject RealtimeWebcamMotionCaptureTracker Tracker

@*
    [PromptFlow Studio v16.40.0] 🥽 AI 공간 XR & 홀로그램 스테이지 — 볼류메트릭 소스/송출(WebXR SSE · RTP) · 3D 무대 프리뷰(홀로그램 포인트 · 무빙헤드 빔 · 레이저 · 스모크 · 파이로) ·
    특수효과 파이어링 · 관객 호응도 열지도 스펙트럼 · 1-Click XR 라이브. 서비스(싱글턴) OnChange 구독 + 가동 중 100ms UI 틱.
*@

<div class="xr-scrim" @onclick="Close">
    <div class="xr-modal" @onclick:stopPropagation="true">
        <div class="xr-h">
            <div>
                <div class="xr-title">🥽 AI 공간 XR &amp; 홀로그램 스테이지</div>
                <div class="xr-sub">모캡·디지털 트윈을 <b>볼류메트릭 홀로그램</b>으로 실시간 트랜스코딩하고, 음악 비트에 맞춘 <b>가상 콘서트 무대 연출</b>과 <b>관객 응원 인터랙션</b>을 1-Click 으로 WebXR 송출합니다.</div>
            </div>
            <button class="xr-x" @onclick="Close">✕</button>
        </div>

        <div class="xr-bar">
            <span class="xr-chip @(Holo.IsRunning ? "live" : "")">@(Holo.IsRunning ? "● XR LIVE " + F0(Holo.Fps) + "FPS" : "XR 대기")</span>
            <span class="xr-chip @(Stage.IsPlaying ? "ok" : "")">🎼 @(Stage.Timecode) · @(F0(Stage.Bpm)) BPM</span>
            <span class="xr-chip @(Crowd.IsRunning ? "ok" : "")">🙌 관객 @(Crowd.Connected.ToString(CultureInfo.InvariantCulture))</span>
            <span class="xr-chip">점 @(Holo.LastPoints.ToString(CultureInfo.InvariantCulture)) · 압축 @(F1(Holo.CompressionRatio))x</span>
            @if (Holo.IsRunning)
            {
                <span class="xr-mut">WebXR 뷰어 <code>@(Holo.Url)</code> · 시청 @(Holo.Clients.ToString(CultureInfo.InvariantCulture))</span>
            }
            @if (Crowd.UdpActive)
            {
                <span class="xr-mut">관객 UDP <code>127.0.0.1:@(Crowd.UdpPort.ToString(CultureInfo.InvariantCulture))</code></span>
            }
        </div>

        <div class="xr-main">
            <div class="xr-side">
                <div class="xr-sec">볼류메트릭 소스</div>
                <div class="xr-row">
                    <button class="xr-tg @(_source == HoloSource.Mocap ? "on" : "")" @onclick="() => _source = HoloSource.Mocap">🕺 모캡</button>
                    <button class="xr-tg @(_source == HoloSource.Twin ? "on" : "")" @onclick="() => _source = HoloSource.Twin">🧍 디지털 트윈</button>
                    <button class="xr-tg @(_source == HoloSource.Rgbd ? "on" : "")" @onclick="() => _source = HoloSource.Rgbd">🎞 RGB-D</button>
                </div>
                @if (_source == HoloSource.Mocap)
                {
                    <label class="xr-ck"><input type="checkbox" @bind="_synthPerformer" /> 모캡 미가동 시 합성 퍼포머 자동 가동</label>
                }
                <div class="xr-sec">FPS 목표 · 볼륨 밀도 <b>@(_density)</b></div>
                <div class="xr-row">
                    <select class="xr-in" @bind="_fps"><option value="24">24</option><option value="30">30</option><option value="60">60</option></select>
                    <input class="grow" type="range" min="8" max="48" step="4" @bind="_density" @bind:event="oninput" />
                </div>
                <div class="xr-sec">RTP 송출 (RTSP 서버 인제스트)</div>
                <div class="xr-row">
                    <input class="xr-in grow" @bind="_rtpHost" placeholder="127.0.0.1 (비우면 미사용)" />
                    <input class="xr-in w70" type="number" @bind="_rtpPort" />
                </div>

                <div class="xr-sec">가상 관객 시뮬레이터 <b>@(_simCount)명 · @(Pct(_simHype))</b></div>
                <input type="range" min="0" max="2048" step="64" @bind="_simCount" @bind:event="oninput" @bind:after="ApplySim" />
                <input type="range" min="0" max="1" step="0.05" @bind="_simHype" @bind:event="oninput" @bind:after="ApplySim" />
                <label class="xr-ck"><input type="checkbox" @bind="_autoTriggers" @bind:after="ApplyTriggers" /> 하이프 돌파 시 무대 자동 폭죽</label>

                <div class="xr-sec">큐시트</div>
                <div class="xr-row">
                    <button class="xr-btn sm" @onclick="LoadCues">🎼 음악/안무 분석 로드</button>
                    <button class="xr-btn sm" disabled="@(Stage.CueCount == 0)" @onclick="ExportAtmos">🔊 Atmos 등록</button>
                </div>
                <div class="xr-note">큐 @(Stage.CueCount.ToString(CultureInfo.InvariantCulture))개 · 발화 @(Stage.Fired.ToString(CultureInfo.InvariantCulture)) · 수동 @(Stage.ManualFired.ToString(CultureInfo.InvariantCulture))</div>

                @if (!Holo.IsRunning)
                {
                    <button class="xr-btn go big" @onclick="GoLive">🚀 1-Click XR 라이브 방송 가동</button>
                }
                else
                {
                    <button class="xr-btn danger big" @onclick="StopAll">⏹ XR 라이브 종료</button>
                }
                @if (!string.IsNullOrEmpty(Holo.Sdp))
                {
                    <div class="xr-sec">SDP</div>
                    <pre class="xr-sdp">@(Holo.Sdp)</pre>
                }
            </div>

            <div class="xr-panel">
                <div class="xr-card">
                    <div class="xr-kv"><span>3D 스테이지 프리뷰</span><b>@(Stage.LastFx == StageFx.Wash ? "—" : VirtualConcertStageOrchestrator.FxLabel(Stage.LastFx))</b></div>
                    <svg class="xr-view" viewBox="0 0 640 340" preserveAspectRatio="xMidYMid meet">
                        <rect x="0" y="0" width="640" height="340" fill="#04060f" />
                        <polygon points="60,330 580,330 500,230 140,230" fill="#0c1426" stroke="#1e3a5f" />
                        <line x1="70" y1="36" x2="570" y2="36" stroke="#475569" stroke-width="4" />
                        @for (var i = 0; i < VirtualConcertStageOrchestrator.Heads; i++)
                        {
                            var hx = 90 + i * 460.0 / (VirtualConcertStageOrchestrator.Heads - 1);
                            var lv = _lv[i];
                            <g>
                                @if (lv > 0.02f)
                                {
                                    <polygon points="@(F1(hx - 5)),40 @(F1(hx + 5)),40 @(F1(hx + 48)),300 @(F1(hx - 48)),300" fill="@(Hsl(_hu[i]))" opacity="@(F2(lv * 0.5f))" />
                                }
                                <rect x="@(F1(hx - 7))" y="32" width="14" height="12" rx="3" fill="@(lv > 0.02f ? Hsl(_hu[i]) : "#334155")" />
                            </g>
                        }
                        @for (var l = 0; l < 4; l++)
                        {
                            var lv = _lv[VirtualConcertStageOrchestrator.LaserBase + l];
                            if (lv <= 0.02f) continue;
                            var lx = 150 + l * 113;
                            <g opacity="@(F2(lv))">
                                @for (var k = -3; k <= 3; k++)
                                {
                                    <line x1="@(lx)" y1="236" x2="@(F1(lx + k * 70 + Math.Sin(_tick * 0.3 + l) * 40))" y2="0" stroke="#22ff88" stroke-width="1.4" />
                                }
                            </g>
                        }
                        @for (var s = 0; s < 2; s++)
                        {
                            var lv = _lv[VirtualConcertStageOrchestrator.SmokeBase + s];
                            if (lv <= 0.02f) continue;
                            <ellipse cx="@(s == 0 ? 170 : 470)" cy="300" rx="@(F1(80 + (1 - lv) * 90))" ry="@(F1(26 + (1 - lv) * 20))" fill="#cbd5e1" opacity="@(F2(lv * 0.35f))" />
                        }
                        @for (var p = 0; p < 4; p++)
                        {
                            var lv = _lv[VirtualConcertStageOrchestrator.PyroBase + p];
                            if (lv <= 0.02f) continue;
                            var px = 110 + p * 140;
                            <polygon points="@(px - 12),322 @(px + 12),322 @(px),@(F1(322 - lv * 140))" fill="#fb923c" opacity="@(F2(lv))" />
                        }
                        @if (_lv[VirtualConcertStageOrchestrator.ConfettiFx] > 0.02f)
                        {
                            var lvc = _lv[VirtualConcertStageOrchestrator.ConfettiFx];
                            for (var c = 0; c < 40; c++)
                            {
                                var cx = (c * 97 + 31) % 620 + 10;
                                var cy = ((c * 53) % 200 + (1 - lvc) * 160) % 320 + 10;
                                <rect x="@(cx)" y="@(F1(cy))" width="5" height="5" fill="@(Hsl((c % 6) / 6f))" opacity="@(F2(lvc))" />
                            }
                        }
                        @if (_lv[VirtualConcertStageOrchestrator.Co2Fx] > 0.02f)
                        {
                            <rect x="300" y="@(F1(330 - _lv[VirtualConcertStageOrchestrator.Co2Fx] * 220))" width="40" height="@(F1(_lv[VirtualConcertStageOrchestrator.Co2Fx] * 220))" fill="#e0f2fe" opacity="0.35" />
                        }
                        @for (var i = 0; i < _pts; i++)
                        {
                            var depth = 3.2 - _xyz[i * 3 + 2];
                            var sx = 320 + _xyz[i * 3] * 300 / depth;
                            var sy = 318 - _xyz[i * 3 + 1] * 300 / depth * 0.62;
                            <circle cx="@(F1(sx))" cy="@(F1(sy))" r="1.3" fill="@(Rgb(_rgb[i]))" />
                        }
                        <g><text x="12" y="20" fill="#94a3b8" font-size="12" font-family="monospace">@(Stage.Timecode)</text></g>
                    </svg>
                </div>

                <div class="xr-grid2">
                    <div class="xr-card">
                        <div class="xr-sec">특수효과 파이어링</div>
                        <div class="xr-fx">
                            @foreach (var fx in _fxButtons)
                            {
                                var f = fx;
                                <button class="xr-btn fx" @onclick="() => FireFx(f)">@(VirtualConcertStageOrchestrator.FxLabel(f))</button>
                            }
                        </div>
                        <div class="xr-sec">다가오는 큐</div>
                        <div class="xr-log">
                            @foreach (var c in UpcomingCues())
                            {
                                <div class="xr-line"><b>@(F2(c.T))s</b><span>@(VirtualConcertStageOrchestrator.FxLabel(c.Fx))</span><i>@(c.Fixture == VirtualConcertStageOrchestrator.AllWash ? "ALL" : c.Fixture.ToString(CultureInfo.InvariantCulture))</i></div>
                            }
                        </div>
                    </div>
                    <div class="xr-card">
                        <div class="xr-sec">관객 호응도 열지도 스펙트럼</div>
                        <svg class="xr-heat" viewBox="0 0 320 96" preserveAspectRatio="none">
                            @for (var s = 0; s < MultiUserVirtualAudienceBridge.Sections; s++)
                            {
                                for (var h = 0; h < MultiUserVirtualAudienceBridge.History; h++)
                                {
                                    var v = _heat[s * MultiUserVirtualAudienceBridge.History + h];
                                    <rect x="@(h * 10)" y="@(s * 12)" width="10" height="12" fill="@(HeatColor(v))" />
                                }
                            }
                        </svg>
                        <div class="xr-kv"><span>하이프</span><b>@(Pct(Crowd.Hype))</b></div>
                        <div class="xr-meter"><i style="width:@(Pct(Crowd.Hype));background:linear-gradient(90deg,#22d3ee,#f472b6)"></i></div>
                        <div class="xr-kv"><span>응원봉 동기화</span><b>@(Pct(Crowd.SyncRatio))</b></div>
                        <div class="xr-meter"><i style="width:@(Pct(Crowd.SyncRatio));background:#a78bfa"></i></div>
                        <div class="xr-kv"><span>함성</span><b>@(F1(Crowd.CheerDb)) dB</b></div>
                        <div class="xr-meter"><i style="width:@(Pct(Crowd.CheerLevel));background:#fbbf24"></i></div>
                        <div class="xr-emotes">
                            @for (var e = 0; e < MultiUserVirtualAudienceBridge.EmoteKinds; e++)
                            {
                                <span>@(MultiUserVirtualAudienceBridge.EmoteIcons[e]) <b>@(F0(Crowd.EmoteRate((AudienceEmote)e)))</b></span>
                            }
                        </div>
                        <div class="xr-note">처리 @(Crowd.Processed.ToString(CultureInfo.InvariantCulture)) · 드롭 @(Crowd.Dropped.ToString(CultureInfo.InvariantCulture)) · 무대 트리거 @(Crowd.Triggers.ToString(CultureInfo.InvariantCulture))</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="xr-f">
            <span class="xr-mut">@(_msg ?? Crowd.LastAction ?? Stage.LastAction ?? Holo.LastAction ?? "XR 스테이지 대기")</span>
            <button class="xr-btn" @onclick="Close">닫기</button>
        </div>
    </div>
</div>

<style>
    .xr-scrim { position: fixed; inset: 0; z-index: var(--z-studio-modal); background: rgba(0,0,0,.6); display: flex; align-items: center; justify-content: center; padding: 20px; }
    .xr-modal { width: min(1320px, 97vw); max-height: 94vh; display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--line); border-radius: 18px; box-shadow: 0 24px 60px rgba(0,0,0,.45); overflow: hidden; }
    .xr-h { display: flex; justify-content: space-between; gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--line); background: linear-gradient(120deg, color-mix(in srgb, #38bdf8 14%, var(--card)), color-mix(in srgb, #f472b6 14%, var(--card))); }
    .xr-title { font-size: 17px; font-weight: 900; color: var(--text-primary); }
    .xr-sub { font-size: 12px; color: var(--text-secondary); margin-top: 4px; line-height: 1.5; } .xr-sub b { color: var(--text-primary); }
    .xr-x { width: 30px; height: 30px; border: none; background: none; color: var(--text-muted); cursor: pointer; font-size: 15px; border-radius: 8px; }
    .xr-bar { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 8px 18px; border-bottom: 1px solid var(--line); }
    .xr-chip { font: 700 11px var(--mono); padding: 3px 8px; border-radius: 999px; border: 1px solid var(--line); color: var(--text-muted); }
    .xr-chip.ok { color: #4ade80; } .xr-chip.live { color: #fff; background: #ef4444; border-color: #ef4444; animation: xr-pulse 1.2s infinite; }
    @@keyframes xr-pulse { 50% { opacity: .65; } }
    .xr-main { display: grid; grid-template-columns: 290px 1fr; min-height: 0; flex: 1; overflow: hidden; }
    .xr-side { border-right: 1px solid var(--line); padding: 12px; display: flex; flex-direction: column; gap: 6px; overflow-y: auto; }
    .xr-panel { padding: 12px 18px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; }
    .xr-sec { font: 800 12px Pretendard,'Malgun Gothic',sans-serif; color: var(--text-primary); margin: 2px 0; } .xr-sec b { color: #38bdf8; }
    .xr-row { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; } .xr-row .grow { flex: 1; }
    .xr-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .xr-card { border: 1px solid var(--line); border-radius: 10px; padding: 10px; display: flex; flex-direction: column; gap: 6px; }
    .xr-tg { font: 700 11.5px Pretendard,'Malgun Gothic',sans-serif; border: 1px solid var(--line); background: var(--card); color: var(--text-secondary); border-radius: 8px; padding: 6px 8px; cursor: pointer; }
    .xr-tg.on { color: var(--text-primary); border-color: #38bdf8; box-shadow: 0 0 0 1px #38bdf8 inset; }
    .xr-in { font-size: 12px; background: var(--bg); color: var(--text-primary); border: 1px solid var(--line); border-radius: 7px; padding: 4px 6px; min-width: 0; } .xr-in.grow { flex: 1; } .xr-in.w70 { width: 74px; }
    .xr-ck { font-size: 12px; color: var(--text-secondary); display: flex; align-items: center; gap: 6px; }
    .xr-kv { display: flex; justify-content: space-between; gap: 8px; font-size: 12px; color: var(--text-muted); } .xr-kv b { color: var(--text-primary); font-family: var(--mono); }
    .xr-view { width: 100%; border-radius: 8px; background: #04060f; }
    .xr-heat { width: 100%; height: 110px; border-radius: 6px; background: #0b1020; }
    .xr-meter { height: 8px; border-radius: 6px; background: #1e293b; overflow: hidden; } .xr-meter i { display: block; height: 100%; transition: width .15s linear; }
    .xr-emotes { display: flex; flex-wrap: wrap; gap: 8px; font-size: 13px; } .xr-emotes b { font: 11px var(--mono); color: var(--text-primary); }
    .xr-fx { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
    .xr-log { display: flex; flex-direction: column; gap: 3px; max-height: 170px; overflow-y: auto; }
    .xr-line { display: grid; grid-template-columns: 64px 1fr auto; gap: 8px; font-size: 12px; color: var(--text-secondary); border-bottom: 1px solid var(--line); padding: 2px 0; }
    .xr-line b { font: 10px var(--mono); color: var(--text-muted); } .xr-line i { font: 10px var(--mono); color: #f472b6; font-style: normal; }
    .xr-mut { font-size: 11px; color: var(--text-muted); display: inline-flex; align-items: center; gap: 4px; flex-wrap: wrap; } .xr-mut code { font: 11px var(--mono); color: #38bdf8; user-select: all; }
    .xr-note { font-size: 11.5px; color: var(--text-secondary); }
    .xr-sdp { font: 10px var(--mono); color: var(--text-secondary); background: var(--bg); border-radius: 6px; padding: 6px; white-space: pre-wrap; margin: 0; user-select: all; }
    .xr-f { display: flex; align-items: center; justify-content: flex-end; gap: 8px; padding: 12px 18px; border-top: 1px solid var(--line); } .xr-f .xr-mut { margin-right: auto; }
    .xr-btn { font: 700 11.5px Pretendard,'Malgun Gothic',sans-serif; border: 1px solid var(--line); background: var(--card); color: var(--text-primary); border-radius: 8px; padding: 6px 11px; cursor: pointer; }
    .xr-btn.sm { padding: 3px 8px; font-size: 11px; } .xr-btn.big { padding: 10px; font-size: 13px; margin-top: 6px; } .xr-btn.fx { padding: 8px 4px; }
    .xr-btn.go { background: linear-gradient(135deg,#38bdf8,#f472b6); color: #fff; border: 0; } .xr-btn.danger { color: #f87171; border-color: #f87171; }
    .xr-btn:disabled { opacity: .45; cursor: not-allowed; }
    @@media (max-width: 900px) { .xr-main { grid-template-columns: 1fr; } .xr-grid2 { grid-template-columns: 1fr; } }
</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private const int PreviewPoints = 700;
    private static readonly StageFx[] _fxButtons = { StageFx.Laser, StageFx.Pyro, StageFx.Fireworks, StageFx.Smoke, StageFx.Strobe, StageFx.Confetti, StageFx.Co2, StageFx.Wash, StageFx.Beam };
    private readonly float[] _xyz = new float[PreviewPoints * 3];
    private readonly uint[] _rgb = new uint[PreviewPoints];
    private readonly float[] _lv = new float[VirtualConcertStageOrchestrator.Fixtures];
    private readonly float[] _hu = new float[VirtualConcertStageOrchestrator.Fixtures];
    private readonly float[] _heat = new float[MultiUserVirtualAudienceBridge.Sections * MultiUserVirtualAudienceBridge.History];
    private HoloSource _source = HoloSource.Mocap;
    private int _fps = 30, _density = 24, _rtpPort = 5004, _simCount = 512, _pts;
    private double _simHype = 0.6;
    private long _tick;
    private bool _synthPerformer = true, _autoTriggers = true, _startedTracker;
    private string _rtpHost = "";
    private string? _msg;
    private CancellationTokenSource? _ui;

    protected override void OnInitialized()
    {
        Holo.OnChange += OnServiceChanged;
        Stage.OnChange += OnServiceChanged;
        Crowd.OnChange += OnServiceChanged;
        _autoTriggers = Crowd.AutoStageTriggers;
        if (Crowd.SimulatedAudience > 0) _simCount = Crowd.SimulatedAudience;
        if (Holo.IsRunning) _source = Holo.Source;
        Refresh();
        if (Holo.IsRunning || Stage.IsPlaying || Crowd.IsRunning) StartUi();
    }

    private void GoLive()
    {
        try
        {
            if (_source == HoloSource.Mocap && _synthPerformer && !Tracker.IsRunning) { Tracker.Start(Tracker.Synthetic); _startedTracker = true; }
            if (_source == HoloSource.Rgbd) Holo.SetRgbdFrame(BuildDemoRgba(160, 120), 160, 120);
            var rtp = string.IsNullOrWhiteSpace(_rtpHost) ? null : _rtpHost.Trim();
            Holo.Start(new HoloStreamOptions(_source, _fps, VolumetricVideoHologramStreamer.DefaultPort, rtp, rtp is null ? 0 : _rtpPort, 30, _density));
            if (Stage.CueCount == 0) Stage.Load();
            Stage.Play();
            Crowd.Start();
            ApplySim();
            _msg = "🚀 XR 라이브 가동 · " + Holo.Url;
            StartUi();
        }
        catch (Exception ex)
        {
            Program.Log("XrStudio.GoLive", ex);
            _msg = "⚠ 가동 실패: " + ex.Message;
        }
    }

    private void StopAll()
    {
        Crowd.Stop();
        Stage.Stop();
        Holo.Stop();
        if (_startedTracker) { Tracker.Stop(); _startedTracker = false; }
        StopUi();
        _msg = "⏹ XR 라이브 종료";
    }

    private void LoadCues()
    {
        var n = Stage.Load();
        _msg = "🎼 큐시트 " + n.ToString(CultureInfo.InvariantCulture) + "개 로드";
    }

    private void ExportAtmos()
    {
        var n = Stage.ExportFxToAtmos();
        _msg = n > 0 ? "🔊 Atmos 오브젝트 " + n.ToString(CultureInfo.InvariantCulture) + "개 등록" : "Atmos 등록 대상 없음(파이로/폭죽 큐 없음 또는 상한)";
    }

    private void FireFx(StageFx fx)
    {
        Stage.Fire(fx);
        Refresh();
    }

    private void ApplySim() { if (Crowd.IsRunning) Crowd.Simulate(_simCount, _simHype); }

    private void ApplyTriggers() => Crowd.AutoStageTriggers = _autoTriggers;

    private IEnumerable<StageCue> UpcomingCues()
    {
        var cues = Stage.Cues;
        var t = Stage.Playhead;
        var n = 0;
        for (var i = 0; i < cues.Count && n < 8; i++)
        {
            if (cues[i].T < t || cues[i].Fx == StageFx.Beam) continue;
            n++;
            yield return cues[i];
        }
    }

    private static byte[] BuildDemoRgba(int w, int h)
    {
        var px = new byte[w * h * 4];
        for (var y = 0; y < h; y++)
            for (var x = 0; x < w; x++)
            {
                var dx = (x - w / 2.0) / (w * 0.22); var dy = (y - h * 0.55) / (h * 0.4);
                if (dx * dx + dy * dy > 1) continue;
                var o = (y * w + x) * 4;
                px[o] = (byte)(120 + x % 120); px[o + 1] = (byte)(180 - y); px[o + 2] = 230; px[o + 3] = 255;
            }
        return px;
    }

    private void Refresh()
    {
        _pts = Holo.CopyPreview(_xyz, _rgb);
        Stage.Evaluate(Stage.Playhead, _lv, _hu);
        Crowd.CopyHeatmap(_heat);
        _tick++;
    }

    private static string F0(double v) => v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => v.ToString("0.#", CultureInfo.InvariantCulture);
    private static string F2(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
    private static string Pct(double v) => (Math.Clamp(v, 0, 1) * 100).ToString("0", CultureInfo.InvariantCulture) + "%";
    private static string Hsl(float hue) => "hsl(" + ((int)(hue * 360) % 360).ToString(CultureInfo.InvariantCulture) + ",90%,60%)";
    private static string Rgb(uint c) => "#" + (c & 0xFFFFFF).ToString("x6", CultureInfo.InvariantCulture);

    private static string HeatColor(float v)
    {
        var t = Math.Clamp(v, 0f, 1f);
        var hue = (int)(240 - t * 240);
        return "hsl(" + hue.ToString(CultureInfo.InvariantCulture) + ",85%," + (12 + t * 48).ToString("0", CultureInfo.InvariantCulture) + "%)";
    }

    private void StartUi()
    {
        if (_ui is not null) return;
        var cts = new CancellationTokenSource();
        _ui = cts;
        _ = UiLoopAsync(cts.Token);
    }

    private void StopUi()
    {
        var cts = Interlocked.Exchange(ref _ui, null);
        if (cts is null) return;
        try { cts.Cancel(); } catch (ObjectDisposedException) { }
        cts.Dispose();
    }

    private async Task UiLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                Refresh();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Program.Log("XrStudio.Ui", ex); }
    }

    private Task Close() => OnClose.InvokeAsync();

    private void OnServiceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Holo.OnChange -= OnServiceChanged;
        Stage.OnChange -= OnServiceChanged;
        Crowd.OnChange -= OnServiceChanged;
        StopUi();
    }
}
