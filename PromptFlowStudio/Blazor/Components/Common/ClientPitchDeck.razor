@using PromptFlowStudio.Services.Trade
@using PromptFlowStudio.Services.Studio
@inject PitchScriptSyncService Sync
@inject SpecSheetPdfExporter Pdf
@inject StudioFolderLinkService FolderLink
@inject ILocalMediaService Media

@* [PromptFlow Studio] v3.2.0 클라이언트 피치 캔버스 — CAD 3D 회전·텔레메트리 HUD 토글·사옥 3색 조명·PDF·승인 반영. *@

<div class="pd">
    @* ── 캔버스 목적 안내 패널(v3.6.0) ── *@
    <div class="pd-purpose">
        <div class="pd-purpose-t">💡 B2B 바이어 수주 프리젠테이션 캔버스</div>
        <div class="pd-purpose-b">렌더링 대기 없이 <b>CAD 3D 분해도</b> · <b>텔레메트리 HUD</b> · <b>사옥 3색 조명</b> 옵션을 실시간으로 시연하고, <b>[✔ 승인]</b> 한 번으로 즉시 스토리보드에 반영합니다.</div>
    </div>

    <div class="pd-grid">
        @* ── ① CAD 3D 와이어프레임 회전 + 분해도(Exploded) 뷰어 ── *@
        <div class="pd-card pd-stage">
            <div class="pd-ct">🧊 CAD 3D 홀로그램 <span class="pd-tag">@(_explode > 0 ? "exploded" : "rotating")</span></div>
            <div class="pd-cube-wrap" style="--neon:@NeonHex; --exp:@(ExpPx.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))px">
                <div class="pd-cube ax-@AxisClass">
                    <div class="pd-face f1"></div><div class="pd-face f2"></div><div class="pd-face f3"></div>
                    <div class="pd-face f4"></div><div class="pd-face f5"></div><div class="pd-face f6"></div>
                </div>
            </div>
            <div class="pd-neon">
                <span class="pd-lbl">네온</span>
                @foreach (var (key, hex, name) in Neons)
                {
                    <button class="pd-sw @(_neon == key ? "on" : null)" style="--sw:@hex" @onclick="() => _neon = key">@name</button>
                }
            </div>
            @* 분해도 축 제어 + 분해량 슬라이더 (StlExplodedView) *@
            <div class="pd-exp">
                <div class="pd-exp-h"><span>💥 분해도 · 축 제어</span><span class="pd-exp-v">@(_explode)%</span></div>
                <div class="pd-exp-axes">
                    @foreach (var (axis, label) in StlExplodedView.Axes)
                    {
                        <button class="pd-exp-ax @(_axis == axis ? "on" : null)" @onclick="() => _axis = axis">@label</button>
                    }
                </div>
                <input class="pd-exp-range" type="range" min="0" max="100" step="1" value="@_explode" @oninput="OnExplode" />
            </div>
        </div>

        @* ── ② 텔레메트리 HUD 오버레이 토글 ── *@
        <div class="pd-card">
            <div class="pd-ct">📊 텔레메트리 HUD</div>
            <div class="pd-hudtabs">
                @foreach (var (key, name) in Huds)
                {
                    <button class="pd-hudtab @(_hud == key ? "on" : null)" @onclick="() => _hud = key">@name</button>
                }
            </div>
            <div class="pd-hud pd-hud-@_hud">
                <div class="pd-hud-top"><span>TELEMETRY · @_hud.ToUpperInvariant()</span><span class="pd-pass">PASS</span></div>
                @if (_hud == "gauge") { <div class="pd-row"><span>FORCE</span><b>128 N</b></div><div class="pd-track"><i class="pd-g"></i></div> }
                else if (_hud == "scope") { <div class="pd-row"><span>VOLT</span><b>12.4 V</b></div><div class="pd-scope"><i class="pd-sweep"></i></div> }
                else { <div class="pd-row"><span>RPM</span><b class="pd-dyno">3450</b></div><div class="pd-track"><i class="pd-d"></i></div> }
            </div>
            @* 실시간 경고 펄스 시뮬레이터 (TelemetrySimulator) *@
            <div class="pd-sim">
                <div class="pd-sim-h">
                    <span>🚨 실시간 경고 시뮬레이터</span>
                    <span class="pd-sim-badge" style="--lv:@_pulse.Hex">@_pulse.Label</span>
                </div>
                <div class="pd-sim-row">
                    <span class="pd-sim-dot" style="--lv:@_pulse.Hex; --pi:@_pulse.Pulse.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"></span>
                    <span class="pd-sim-val" style="--lv:@_pulse.Hex">@_rpm RPM</span>
                    <span class="pd-sim-th">경고 5000 · 위험 6500</span>
                </div>
                <input class="pd-sim-range" type="range" min="0" max="8000" step="50" value="@_rpm" @oninput="OnRpm" />
            </div>
        </div>

        @* ── ③ 사옥 3색 조명 미리보기 ── *@
        <div class="pd-card">
            <div class="pd-ct">🏢 사옥 3색 조명 <label class="pd-toggle"><input type="checkbox" checked="@_multiLight" @onchange="e => _multiLight = e.Value is true" /> 적용</label></div>
            <div class="pd-lights">
                <div class="pd-light day"><div class="pd-bld">🏢</div><span>☀️ 주간</span></div>
                <div class="pd-light golden"><div class="pd-bld">🏢</div><span>🌇 노을</span></div>
                <div class="pd-light night"><div class="pd-bld">🏢</div><span>🌃 야경</span></div>
            </div>
        </div>

        @* ── ④ 더빙 + ROI + 승인 + PDF ── *@
        <div class="pd-card">
            <div class="pd-ct">🌐 글로벌 더빙</div>
            <div class="pd-dubs">
                @foreach (var (code, flag, name) in Dubs)
                {
                    <button class="pd-dub @(_dubs.Contains(code) ? "on" : null)" @onclick="() => ToggleDub(code)">@flag @name</button>
                }
            </div>
            <div class="pd-roi">💰 @_roi.Summary</div>
            <div class="pd-actions">
                <button class="pd-btn pdf" @onclick="ExportPdf" disabled="@_busy">📄 바이어 제출용 PDF 스펙 시트</button>
                <button class="pd-btn approve" @onclick="Approve">✔ 승인 &amp; 스토리보드 반영</button>
            </div>
            @if (_msg is not null) { <div class="pd-msg">@_msg</div> }
        </div>
    </div>
</div>

<style>
    .pd { color: var(--text-primary); font-family: Pretendard, 'Malgun Gothic', sans-serif; }
    /* v3.6.0 캔버스 목적 안내 패널 */
    .pd-purpose { margin-bottom: 14px; padding: 14px 16px; border-radius: 14px; border: 1px solid color-mix(in srgb,#f5c451 30%,var(--line));
        background: linear-gradient(120deg, color-mix(in srgb,#f5c451 12%,transparent), color-mix(in srgb,#0ea5e9 9%,transparent)); }
    .pd-purpose-t { font-size: 18px; font-weight: 800; color: #f1f5f9; letter-spacing: -.01em; word-break: keep-all; }
    .pd-purpose-b { font-size: 14px; color: #dbe4f5; margin-top: 6px; line-height: 1.65em; word-break: keep-all; } .pd-purpose-b b { color: #fde68a; }
    .pd-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .pd-card { border: 1px solid color-mix(in srgb, #f5c451 22%, var(--line)); border-radius: 14px; background: rgba(18,20,31,.6); padding: 14px; }
    .pd-ct { font: 800 13px var(--mono); display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
    .pd-tag { font: 700 9px var(--mono); color: #7dd3fc; background: color-mix(in srgb,#0ea5e9 14%,transparent); border-radius: 20px; padding: 2px 7px; }
    /* CAD cube */
    .pd-stage { grid-row: span 1; }
    .pd-cube-wrap { height: 180px; display: grid; place-items: center; perspective: 700px; }
    .pd-cube { width: 100px; height: 100px; position: relative; transform-style: preserve-3d; animation: pd-spin-y 7s linear infinite; }
    .pd-cube.ax-x { animation-name: pd-spin-x; } .pd-cube.ax-z { animation-name: pd-spin-z; }
    @@keyframes pd-spin-y { from { transform: rotateX(-18deg) rotateY(0); } to { transform: rotateX(-18deg) rotateY(360deg); } }
    @@keyframes pd-spin-x { from { transform: rotateY(-18deg) rotateX(0); } to { transform: rotateY(-18deg) rotateX(360deg); } }
    @@keyframes pd-spin-z { from { transform: rotateX(-18deg) rotateZ(0); } to { transform: rotateX(-18deg) rotateZ(360deg); } }
    .pd-face { position: absolute; width: 100px; height: 100px; border: 1.5px solid var(--neon); box-shadow: 0 0 12px var(--neon), inset 0 0 12px color-mix(in srgb,var(--neon) 40%,transparent); background: color-mix(in srgb,var(--neon) 6%,transparent); transition: transform .28s cubic-bezier(.34,1.3,.5,1); }
    .pd-face.f1 { transform: translateZ(calc(50px + var(--exp,0px))); } .pd-face.f2 { transform: rotateY(180deg) translateZ(calc(50px + var(--exp,0px))); } .pd-face.f3 { transform: rotateY(90deg) translateZ(calc(50px + var(--exp,0px))); }
    .pd-face.f4 { transform: rotateY(-90deg) translateZ(calc(50px + var(--exp,0px))); } .pd-face.f5 { transform: rotateX(90deg) translateZ(calc(50px + var(--exp,0px))); } .pd-face.f6 { transform: rotateX(-90deg) translateZ(calc(50px + var(--exp,0px))); }
    /* 분해도 컨트롤 */
    .pd-exp { margin-top: 12px; border-top: 1px solid var(--line); padding-top: 10px; }
    .pd-exp-h { display: flex; justify-content: space-between; align-items: center; font: 800 11px var(--mono); color: var(--text-secondary); } .pd-exp-v { color: #f5c451; }
    .pd-exp-axes { display: flex; gap: 5px; margin: 8px 0; }
    .pd-exp-ax { flex: 1; font: 700 10.5px Pretendard,'Malgun Gothic',sans-serif; color: var(--text-secondary); background: var(--card-2); border: 1px solid var(--line); border-radius: 8px; padding: 6px 4px; cursor: pointer; }
    .pd-exp-ax.on { color: #fff; border-color: transparent; background: linear-gradient(135deg,#0ea5e9,#6366f1); }
    .pd-exp-range { width: 100%; accent-color: #f5c451; cursor: pointer; }
    .pd-neon { display: flex; align-items: center; gap: 6px; margin-top: 8px; } .pd-lbl { font: 700 10px var(--mono); color: var(--text-muted); }
    .pd-sw { font: 700 10.5px var(--mono); color: var(--text-secondary); background: var(--card-2); border: 1px solid var(--line); border-radius: 8px; padding: 5px 10px; cursor: pointer; }
    .pd-sw.on { color: var(--text-primary); border-color: var(--sw); box-shadow: 0 0 0 1px var(--sw); }
    /* HUD */
    .pd-hudtabs { display: flex; gap: 5px; margin-bottom: 8px; }
    .pd-hudtab { font: 800 10.5px var(--mono); color: var(--text-secondary); background: var(--card-2); border: 1px solid var(--line); border-radius: 8px; padding: 6px 11px; cursor: pointer; }
    .pd-hudtab.on { color: #fff; background: linear-gradient(135deg,#0ea5e9,#6366f1); }
    .pd-hud { border: 1px solid color-mix(in srgb,#22d3ee 40%,var(--line)); border-radius: 12px; background: linear-gradient(160deg,#0b0d14,#12141f); padding: 12px; }
    .pd-hud-top { display: flex; justify-content: space-between; font: 800 10px var(--mono); color: #e6edff; margin-bottom: 8px; }
    .pd-pass { color: #22c55e; border: 1.5px solid #22c55e; border-radius: 6px; padding: 1px 7px; }
    .pd-row { display: flex; justify-content: space-between; align-items: baseline; } .pd-row span { font: 700 10px var(--mono); color: #9aa6c8; } .pd-row b { font: 800 15px var(--mono); color: #22d3ee; } .pd-dyno { color: #39ff14 !important; font-size: 22px !important; }
    .pd-track { height: 12px; border-radius: 7px; background: #1a1d2b; margin-top: 8px; overflow: hidden; border: 1px solid var(--line); }
    .pd-g { display: block; height: 100%; background: linear-gradient(90deg,#0ea5e9,#22d3ee); animation: pd-gauge 2.6s ease-in-out infinite; }
    @@keyframes pd-gauge { 0%,100% { width: 28%; } 50% { width: 82%; } }
    .pd-d { display: block; height: 100%; background: linear-gradient(90deg,#39ff14,#a3e635); animation: pd-dyno 1.6s ease-in-out infinite; }
    @@keyframes pd-dyno { 0%,100% { width: 45%; } 50% { width: 92%; } }
    .pd-scope { position: relative; height: 60px; border-radius: 8px; background: #0b0d14; margin-top: 8px; overflow: hidden; border: 1px solid var(--line); }
    .pd-sweep { position: absolute; top: 0; bottom: 0; width: 3px; background: #39ff14; box-shadow: 0 0 8px #39ff14; animation: pd-sw 2s linear infinite; }
    @@keyframes pd-sw { from { left: 0; } to { left: calc(100% - 3px); } }
    /* lights */
    .pd-lights { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; }
    .pd-light { border: 1px solid var(--line); border-radius: 10px; overflow: hidden; text-align: center; } .pd-light span { display: block; font: 700 9.5px var(--mono); padding: 4px; color: var(--text-secondary); }
    .pd-bld { height: 60px; display: grid; place-items: center; font-size: 26px; }
    .pd-light.day .pd-bld { background: linear-gradient(180deg,#7dd3fc,#64748b); } .pd-light.golden .pd-bld { background: linear-gradient(180deg,#fb923c,#7c2d12); } .pd-light.night .pd-bld { background: linear-gradient(180deg,#0f172a,#312e81); text-shadow: 0 0 14px #22d3ee; }
    .pd-toggle { margin-left: auto; font: 700 10.5px var(--mono); color: var(--text-secondary); display: inline-flex; align-items: center; gap: 5px; cursor: pointer; }
    /* dubs + actions */
    .pd-dubs { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-bottom: 10px; }
    .pd-dub { font: 700 11px var(--mono); color: var(--text-secondary); background: var(--card-2); border: 1px solid var(--line); border-radius: 9px; padding: 7px 9px; cursor: pointer; text-align: left; }
    .pd-dub.on { color: #fff; border-color: transparent; box-shadow: 0 0 0 2px #6366f1; background: color-mix(in srgb,#6366f1 10%,var(--card-2)); }
    .pd-roi { font: 700 11px var(--mono); color: #86efac; background: color-mix(in srgb,#22c55e 10%,transparent); border-radius: 9px; padding: 8px 10px; margin-bottom: 10px; }
    .pd-actions { display: flex; gap: 8px; flex-wrap: wrap; }
    .pd-btn { font: 800 17px Pretendard,'Malgun Gothic',sans-serif; letter-spacing: -.01em; word-break: keep-all; padding: 12px 16px; border: none; border-radius: 11px; cursor: pointer; }
    .pd-btn.pdf { color: #1a1206; background: linear-gradient(135deg,#fde68a,#f5c451); text-shadow: 0 1px 0 rgba(255,255,255,.45); box-shadow: 0 3px 10px color-mix(in srgb,#f5c451 30%,transparent), inset 0 1px 0 rgba(255,255,255,.55); }
    .pd-btn.approve { color: #fff; background: linear-gradient(135deg,#0ea5e9,#6366f1); text-shadow: 0 1px 2px rgba(0,0,0,.42); box-shadow: 0 3px 10px color-mix(in srgb,#6366f1 34%,transparent), inset 0 1px 0 rgba(255,255,255,.28); }
    .pd-btn:disabled { opacity: .5; cursor: not-allowed; } .pd-btn:hover:not(:disabled) { filter: brightness(1.07); }
    .pd-msg { font: 600 10.5px var(--mono); color: #7dd3fc; margin-top: 8px; }
    /* 실시간 경고 펄스 시뮬레이터 */
    .pd-sim { margin-top: 10px; border-top: 1px solid var(--line); padding-top: 10px; }
    .pd-sim-h { display: flex; justify-content: space-between; align-items: center; font: 800 11px var(--mono); color: var(--text-secondary); }
    .pd-sim-badge { font: 900 10px var(--mono); color: #0b0d14; background: var(--lv); border-radius: 20px; padding: 2px 9px; box-shadow: 0 0 10px color-mix(in srgb, var(--lv) 55%, transparent); }
    .pd-sim-row { display: flex; align-items: center; gap: 8px; margin: 9px 0; }
    .pd-sim-dot { width: 12px; height: 12px; border-radius: 50%; background: var(--lv); box-shadow: 0 0 calc(4px + var(--pi,0) * 16px) var(--lv); animation: pd-pulse calc(1.5s - var(--pi,0) * 1s) ease-in-out infinite; }
    @@keyframes pd-pulse { 0%,100% { transform: scale(1); opacity: .85; } 50% { transform: scale(1.55); opacity: 1; } }
    .pd-sim-val { font: 900 15px var(--mono); color: var(--lv); }
    .pd-sim-th { margin-left: auto; font: 600 9.5px var(--mono); color: var(--text-muted); }
    .pd-sim-range { width: 100%; accent-color: #ef4444; cursor: pointer; }
    @@media (max-width: 820px) { .pd-grid { grid-template-columns: 1fr; } }
</style>

@code {
    [Parameter, EditorRequired] public StoryboardProject Project { get; set; } = default!;

    private string _neon = "gold";
    private string _hud = "gauge";
    private bool _multiLight = true;
    private readonly HashSet<string> _dubs = new();
    private RoiResult _roi = B2bRoiCalculator.Compute(B2bRoiCalculator.Default);
    private bool _busy;
    private string? _msg;

    // v3.6.0 CAD 분해도(축 제어) · 텔레메트리 실시간 경고 시뮬레이터
    private int _explode;
    private ExplodeAxis _axis = ExplodeAxis.Y;
    private int _rpm = 3450;
    private TelemetryPulse _pulse = TelemetrySimulator.Evaluate(3450, 5000, 6500, 8000);

    private string AxisClass => _axis.ToString().ToLowerInvariant();
    private double ExpPx => StlExplodedView.FaceOffsetPx(_explode / 100.0);

    private static readonly (string Key, string Hex, string Name)[] Neons = { ("cyan", "#22d3ee", "시안"), ("magenta", "#d946ef", "마젠타"), ("gold", "#f5c451", "골드") };
    private static readonly (string Key, string Name)[] Huds = { ("gauge", "게이지"), ("scope", "스코프"), ("dyno", "다이나모") };
    private static readonly (string Code, string Flag, string Name)[] Dubs = { ("en", "🇺🇸", "영어"), ("de", "🇩🇪", "독일어"), ("zh", "🇨🇳", "중국어"), ("ja", "🇯🇵", "일본어") };

    private string NeonHex => Neons.FirstOrDefault(n => n.Key == _neon).Hex ?? "#f5c451";

    protected override void OnInitialized()
    {
        var o = Sync.ReadFromProject(Project);
        _neon = PitchScriptSyncService.NeonColors.Contains(o.NeonColor) ? o.NeonColor : "gold";
        _hud = string.IsNullOrEmpty(o.HudStyle) ? "gauge" : o.HudStyle;
        _multiLight = o.MultiLighting;
        foreach (var c in o.DubLanguages) _dubs.Add(c);
    }

    private void ToggleDub(string code) { if (!_dubs.Add(code)) _dubs.Remove(code); }

    private void OnExplode(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var v)) _explode = Math.Clamp(v, 0, 100); }
    private void OnRpm(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v)) { _rpm = Math.Clamp(v, 0, 8000); _pulse = TelemetrySimulator.Evaluate(_rpm, 5000, 6500, 8000); }
    }

    private PitchOptions CurrentOptions() => new(_neon, _dubs.ToList(), _multiLight, _hud, Project.VirtualStudioTemplate ?? "");

    private void Approve()
    {
        var r = Sync.ApplyToProject(Project, CurrentOptions());
        _msg = "✅ " + r.Summary;
    }

    private void ExportPdf()
    {
        _busy = true; _msg = null;
        try
        {
            Sync.ApplyToProject(Project, CurrentOptions());   // 최신 피치 옵션 반영 후 스펙 시트 발급
            var dir = System.IO.Path.Combine(Media.MediaRoot, Project.Id);
            var path = System.IO.Path.Combine(dir, "spec_sheet_pitch.pdf");
            var outp = Pdf.Export(Project, path);
            if (outp is not null) { FolderLink.Reveal(outp); _msg = "📄 스펙 시트 PDF 발급 완료 — 탐색기에서 열림"; }
            else _msg = "⚠ PDF 발급 실패";
        }
        catch (Exception ex) { _msg = "⚠ " + ex.Message; }
        finally { _busy = false; }
    }
}
