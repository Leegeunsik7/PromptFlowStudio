@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private const float Scale = 330f, PxPerN = 8f;
    static readonly HapticMaterial[] Garments = { HapticMaterial.Silk, HapticMaterial.Cotton, HapticMaterial.Denim, HapticMaterial.Leather };
    private System.Threading.Timer? _timer;
    private RealtimeKinestheticForceFeedbackEngine E => Runner.Engine;
    private VibrotactileMicroTextureSynthesizer V => Runner.Vibro;
    private DualRatePassivityAntiBuzzingGuard G => Runner.Guard;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("SpatialHaptics.Modal.Timer", ex); }
        }, null, 250, 250);
    }

    private static string Pct(double v) => (Math.Clamp(double.IsFinite(v) ? v : 0, 0, 1) * 100).ToString("0.##", CultureInfo.InvariantCulture) + "%";
    private static string F0(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "0" : v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0.00", CultureInfo.InvariantCulture);
    private static double Num(ChangeEventArgs e, double fallback) => double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : fallback;
    private static double Db(double v) => 20 * Math.Log10(Math.Max(v, 1e-6));
    private static string MatClass(HapticMaterial m) => "m" + ((int)m).ToString(CultureInfo.InvariantCulture);

    // 정면: x −0.45..0.45 · y 0.9..1.8 / 측면: z −0.1..0.8
    private static float Sx(float x) => 150f + x * Scale;
    private static float Sz(float z) => (z + 0.1f) * Scale;
    private static float Sy(float y) => 300f - (y - 0.88f) * Scale;
    private static string FX(float x) => F1(Sx(x));
    private static string FZ(float z) => F1(Sz(z));
    private static string FY(float y) => F1(Sy(y));

    private static string Heat(float db)
    {
        var t = Math.Clamp((db + 60f) / 60f, 0f, 1f);
        var r = (int)(255 * Math.Clamp(t * 1.6f, 0f, 1f));
        var g = (int)(255 * Math.Clamp(t * 1.6f - 0.6f, 0f, 1f));
        var b = (int)(255 * Math.Clamp(0.35f + 0.9f * t - 1.2f * t * t, 0f, 1f));
        return "rgb(" + r.ToString(CultureInfo.InvariantCulture) + "," + g.ToString(CultureInfo.InvariantCulture) + "," + b.ToString(CultureInfo.InvariantCulture) + ")";
    }

    private double EnergyScale() => Math.Max(1.0, G.GeneratedJ * 1000 * 1.2);

    private string Series(int kind, double full, double h)
    {
        var n = Runner.SeriesCount;
        if (n < 2) return "";
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = n - 1; i >= 0; i--)
        {
            double v = kind switch { 0 => Runner.NormalSeries(i), 1 => Runner.FrictionSeries(i), 2 => Runner.EnergySeries(i), _ => Runner.BuzzSeries(i) };
            sb.Append(F1(360.0 * (n - 1 - i) / (SpatialHapticsStudioRunner.SeriesLen - 1))).Append(',').Append(F1(h - 2 - (h - 4) * Math.Clamp(v / full, 0, 1))).Append(' ');
        }
        return sb.ToString();
    }

    private string ScopePoints()
    {
        const int n = 400;
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = 0; i < n; i++) sb.Append(F1(360.0 * i / (n - 1))).Append(',').Append(F1(25 - 23 * Math.Clamp(V.Sample(n - 1 - i), -1, 1))).Append(' ');
        return sb.ToString();
    }

    private void OnGarment(ChangeEventArgs e)
    {
        var v = (int)Num(e, (int)E.Garment);
        if (v >= 0 && v < HapticMaterials.Count) Runner.SetGarment((HapticMaterial)v);
    }

    private void ToggleRun()
    {
        if (Runner.IsRunning) Runner.Stop(); else Runner.Start();
    }

    private void Step30()
    {
        for (var i = 0; i < SpatialHapticsStudioRunner.Hz / 2; i++) Runner.Step();
    }

    private Task Close() => OnClose.InvokeAsync();

    /// <summary>가동 중 갱신은 250 ms 타이머가 처리 — 정지 상태 변경만 즉시 반영.</summary>
    private void OnServiceChanged()
    {
        if (!Runner.IsRunning) _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
