@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private const float Kx = 150f, Kz = 62f, Ky = 110f;
    private int _viewer;
    private System.Threading.Timer? _timer;
    private NeuralVolumetricGaussianStreamingEngine S => Runner.Stream;
    private MultiUserCrossModalInteractionSynthesizer I => Runner.Interaction;
    private DeterministicRollbackStateResimulationGuard R => Runner.Rollback;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("Telepresence.Modal.Timer", ex); }
        }, null, 250, 250);
    }

    private static string Pct(double v) => (Math.Clamp(double.IsFinite(v) ? v : 0, 0, 1) * 100).ToString("0.##", CultureInfo.InvariantCulture) + "%";
    private static string F0(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "0" : v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0.00", CultureInfo.InvariantCulture);
    private static double Num(ChangeEventArgs e, double fallback) => double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : fallback;

    // 사선 투영: 화면 x ← 월드 x · 화면 y ← 깊이 z(원근 축소) − 높이 y
    private static float PX(float x, float z) => 200f + x * Kx;
    private static float PY(float x, float y, float z) => 150f + z * Kz - (y - TelepresenceScenario.TableY) * Ky;

    private double MbpsScale() => Math.Max(50.0, Runner.TotalMbps * 1.3);

    private string Series(int kind, double full, double h)
    {
        var n = Runner.SeriesCount;
        if (n < 2) return "";
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = n - 1; i >= 0; i--)
        {
            double v = kind switch { 0 => Runner.RttSeries(i), 1 => Runner.RollbackSeries(i), 2 => Runner.MbpsSeries(i), 3 => Runner.ErleSeries(i), _ => Runner.WarpSeries(i) };
            sb.Append(F1(360.0 * (n - 1 - i) / (NeuralTelepresenceStudioRunner.SeriesLen - 1))).Append(',').Append(F1(h - 2 - (h - 4) * Math.Clamp(v / full, 0, 1))).Append(' ');
        }
        return sb.ToString();
    }

    private static string Wave(ReadOnlySpan<float> s)
    {
        const int n = 200;
        var sb = new System.Text.StringBuilder(n * 12);
        var step = s.Length / n;
        for (var i = 0; i < n; i++) sb.Append(F1(360.0 * i / (n - 1))).Append(',').Append(F1(25 - 23 * Math.Clamp(s[i * step] * 2.5, -1, 1))).Append(' ');
        return sb.ToString();
    }

    private void ToggleRun()
    {
        if (Runner.IsRunning) Runner.Stop(); else Runner.Start();
    }

    private void Step30()
    {
        for (var i = 0; i < NeuralTelepresenceStudioRunner.Hz / 2; i++) Runner.Step();
    }

    private Task Close() => OnClose.InvokeAsync();

    /// <summary>가동 중 갱신은 250 ms 타이머가 처리 — 정지 상태 변경만 즉시 반영.</summary>
    private void OnServiceChanged()
    {
        if (!Runner.IsRunning) _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
