@inject KoreanPromptLocalizer Localizer

@* [PromptFlow Studio] 프롬프트 한국어 시각화 카드 — 영어 프롬프트 위에 한글 연출 요약+태그를 기본 표시하고 🇰🇷/🇺🇸 탭으로 전환. *@

<div class="ssc">
    <div class="ssc-tabs">
        <button type="button" class="ssc-tab @(_tab == 0 ? "on" : null)" @onclick="() => _tab = 0">🇰🇷 한글 연출 가이드</button>
        <button type="button" class="ssc-tab @(_tab == 1 ? "on" : null)" @onclick="() => _tab = 1">🇺🇸 영문 AI 프롬프트</button>
    </div>

    @if (_tab == 0)
    {
        <div class="ssc-summary">@_loc.KoreanSummary</div>
        @if (_loc.DirectionTags.Count > 0)
        {
            <div class="ssc-tags">
                @foreach (var t in _loc.DirectionTags) { <span class="ssc-tag">@t</span> }
            </div>
        }
    }
    else
    {
        <div class="ssc-en">@(_loc.HasEnglish ? _loc.EnglishPrompt : "(영문 프롬프트가 아직 없어요 — 아래에 입력하거나 [⚡ 부스팅]을 눌러 보세요.)")</div>
    }
</div>

<style>
    .ssc { border: 1px solid var(--line); border-radius: 11px; background: color-mix(in srgb, var(--flow-violet) 5%, var(--card-2)); overflow: hidden; margin-bottom: 8px; }
    .ssc-tabs { display: flex; gap: 4px; padding: 7px 8px 0; }
    .ssc-tab { flex: 1; font: 800 10.5px var(--mono); padding: 6px 8px; border-radius: 8px 8px 0 0; cursor: pointer;
        border: 1px solid var(--line); border-bottom: none; background: var(--card); color: var(--text-secondary); white-space: nowrap; }
    .ssc-tab.on { color: var(--text-primary); background: color-mix(in srgb, var(--flow-violet) 12%, var(--card)); box-shadow: inset 0 2px 0 var(--flow-violet); }
    .ssc-summary { padding: 10px 12px 4px; font-size: 12.5px; line-height: 1.55; color: var(--text-primary); }
    .ssc-tags { display: flex; flex-wrap: wrap; gap: 5px; padding: 6px 12px 11px; }
    .ssc-tag { font: 700 10.5px var(--mono); color: var(--flow-cyan, #22d3ee); background: color-mix(in srgb, var(--flow-cyan, #22d3ee) 10%, transparent);
        border: 1px solid color-mix(in srgb, var(--flow-cyan, #22d3ee) 30%, var(--line)); border-radius: 999px; padding: 3px 9px; }
    .ssc-en { padding: 10px 12px 12px; font: 12px var(--mono); line-height: 1.55; color: var(--text-secondary); white-space: pre-wrap; word-break: break-word; }
</style>

@code {
    /// <summary>대상 컷(프롬프트·나레이션을 읽어 현지화).</summary>
    [Parameter, EditorRequired] public StoryboardScene Scene { get; set; } = default!;

    private int _tab;
    private LocalizedPrompt _loc = new("", Array.Empty<string>(), "", false);

    // 프롬프트/나레이션이 바뀌면(부모 재렌더) 다시 현지화.
    protected override void OnParametersSet() => _loc = Localizer.Localize(Scene.Prompt, Scene.VoiceText);
}
