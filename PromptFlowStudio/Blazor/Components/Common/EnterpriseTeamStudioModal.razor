@code {
    [Parameter, EditorRequired] public StoryboardProject Project { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnReveal { get; set; }

    private int _tab, _port = 8790;
    private string? _msg, _invite, _lastProtected;
    private string _nodeUrl = "", _nodeRegion = "", _preset = "1080", _tenant = "studio", _user = "owner", _display = "Owner";
    private string _inviteUser = "", _inviteName = "", _joinUrl = "", _joinToken = "";
    private CloudProvider _prov = CloudProvider.Aws;
    private TeamRole _inviteRole = TeamRole.Reviewer;
    private double _tc;
    private string[] _draft = Array.Empty<string>();
    private ProvenanceVerification? _verify;
    private CancellationTokenSource? _cts;

    private bool Busy => _cts is not null || Farm.IsRunning || C2pa.IsBusy;

    private int CompletedCuts
    {
        get
        {
            var n = 0;
            foreach (var s in Project.Scenes) if (!string.IsNullOrWhiteSpace(s.LocalPath) && File.Exists(s.LocalPath)) n++;
            return n;
        }
    }

    protected override void OnInitialized()
    {
        Farm.OnChange += OnServiceChanged;
        Team.OnChange += OnServiceChanged;
        C2pa.OnChange += OnServiceChanged;
        _tenant = Team.Tenant; _user = Team.UserId; _display = Team.Display;
    }

    protected override void OnParametersSet()
    {
        if (_draft.Length != Math.Max(1, Project.Scenes.Count)) _draft = new string[Math.Max(1, Project.Scenes.Count)];
    }

    private static string MemberTitle(TeamMember m) => m.Display + " · " + TeamCollaborationSessionBridge.RoleLabel(m.Role) + (m.Online ? "" : " · 오프라인");

    private List<string> CutIds()
    {
        var ids = new List<string>(Project.Scenes.Count);
        foreach (var s in Project.Scenes) ids.Add(s.Id);
        return ids;
    }

    private void AddNode()
    {
        _msg = Farm.AddNode(new RenderNode { Provider = _prov, Endpoint = _nodeUrl.Trim().TrimEnd('/'), Region = _nodeRegion.Trim() })
            ? "➕ 노드 등록 — 🩺 헬스 체크로 GPU/슬롯을 확인하세요." : "⚠ 노드 URL 은 https://(또는 로컬 http) 주소여야 하며 중복/상한(32) 불가입니다.";
        if (_msg.StartsWith("➕", StringComparison.Ordinal)) _nodeUrl = "";
    }

    private Task ProbeAsync() => RunAsync(ct => Farm.ProbeAllAsync(ct));

    private void StartFarm()
    {
        var preset = _preset == "2160" ? FarmPreset.Uhd60 : new FarmPreset();
        var root = !string.IsNullOrWhiteSpace(Project.FinalVideoPath) ? Path.GetDirectoryName(Path.GetFullPath(Project.FinalVideoPath))!
            : Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyVideos), "PromptFlowStudio");
        var output = Path.Combine(root, "farm_" + DateTime.Now.ToString("yyyyMMdd_HHmmss", CultureInfo.InvariantCulture) + ".mp4");
        _msg = Farm.StartJob(Project, output, preset) ? "☁️ 분산 렌더 시작 — 백그라운드에서 진행됩니다(모달을 닫아도 계속)." : "⚠ 이미 실행 중입니다.";
    }

    private async Task ActAsync(string cutId, string type, string? text = null, string? refId = null)
    {
        var r = await Team.ActAsync(type, cutId, text, _tc, refId);
        _msg = r.Ok ? null : "⛔ " + r.Reason;
    }

    private async Task CommentAsync(string cutId, int idx, bool changes)
    {
        if ((uint)idx >= (uint)_draft.Length || string.IsNullOrWhiteSpace(_draft[idx])) { _msg = "⚠ 코멘트를 입력하세요."; return; }
        await ActAsync(cutId, changes ? "changes" : "comment", _draft[idx]);
        if (_msg is null) _draft[idx] = "";
    }

    private Task SetPolicy(string? v) => int.TryParse(v, NumberStyles.Integer, CultureInfo.InvariantCulture, out var n) ? Team.ActAsync("policy", n: Math.Clamp(n, 1, 10)) : Task.CompletedTask;

    private void StartHost() => _msg = Team.StartHost(_port) ? "🛰 세션 열림 · " + Team.Endpoint : "⚠ " + Team.LastError;

    private void SetIdentity()
    {
        _msg = Team.SetIdentity(_tenant.Trim(), _user.Trim(), _display, TeamRole.Owner) ? "👤 신원 적용" : "⚠ tenant/user 는 영문·숫자·_-.@ 1~64자";
    }

    private void Invite()
    {
        _invite = Team.CreateInvite(_inviteUser.Trim(), _inviteName, _inviteRole, TimeSpan.FromHours(24));
        _msg = _invite is null ? "⚠ Owner 호스트만 발급 가능 · user-id 형식 확인" : "✉ 초대 토큰 발급 — 안전한 채널로 전달하세요.";
    }

    private Task JoinAsync() => RunAsync(async ct =>
    {
        var ok = await Team.ConnectAsync(_joinUrl.Trim(), _joinToken.Trim(), ct);
        _msg = ok ? "🔗 접속 완료" : "⚠ " + Team.LastError;
    });

    private void IssueCert(bool force)
    {
        try
        {
            var c = C2pa.EnsureCertificate(Team.Tenant + " PromptFlow Signer", force);
            _msg = "🪪 인증서 준비 · " + c.GetNameInfo(System.Security.Cryptography.X509Certificates.X509NameType.SimpleName, false);
        }
        catch (Exception ex) { Program.Log("EnterpriseStudio.Cert", ex); _msg = "⚠ 인증서 발급 실패: " + ex.Message; }
    }

    private Task ProtectAsync()
    {
        var req = C2paContentProvenanceEngine.RequestFromProject(Project, Team.Tenant, Team.Display, Team.AllApproved(CutIds()));
        var input = Project.FinalVideoPath!;
        return RunAsync(async ct =>
        {
            var r = await C2pa.ProtectAsync(input, req, null, ct);
            _msg = (r.Ok ? "🔏 " : "⚠ ") + r.Message + (r.VideoPath is null ? "" : " · " + r.VideoPath);
            if (r.Ok && r.VideoPath is not null) { _lastProtected = r.VideoPath; await OnReveal.InvokeAsync(r.VideoPath); }
        });
    }

    private Task VerifyAsync() => RunAsync(async ct => { _verify = await C2pa.Verify(_lastProtected!, null, ct); });

    private async Task RunAsync(Func<CancellationToken, Task> work)
    {
        var cts = new CancellationTokenSource();
        if (Interlocked.CompareExchange(ref _cts, cts, null) is not null) { cts.Dispose(); return; }
        try { await work(cts.Token); }
        catch (OperationCanceledException) { _msg = "⚠ 취소됨"; }
        catch (Exception ex) { Program.Log("EnterpriseStudio.Run", ex); _msg = "⚠ 실패: " + ex.Message; }
        finally
        {
            Interlocked.CompareExchange(ref _cts, null, cts);
            cts.Dispose();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Cancel()
    {
        try { _cts?.Cancel(); } catch (ObjectDisposedException) { }
    }

    private Task Close() => _cts is not null || C2pa.IsBusy ? Task.CompletedTask : OnClose.InvokeAsync();

    private void OnServiceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Farm.OnChange -= OnServiceChanged;
        Team.OnChange -= OnServiceChanged;
        C2pa.OnChange -= OnServiceChanged;
        Cancel();   // 진행 중 작업은 RunAsync finally 에서 CTS 정리 · 렌더 팜 잡은 서비스 소유(계속 진행)
    }
}
