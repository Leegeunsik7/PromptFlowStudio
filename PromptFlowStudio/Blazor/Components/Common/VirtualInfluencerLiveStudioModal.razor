@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private readonly byte[] _bmp = new byte[AvatarActingDirectorStudioRunner.PreviewBytes];
    private System.Threading.Timer? _timer;
    private string _img = "";
    private string _user = "me";
    private string _text = "";
    private int _amount;
    private string? _saved;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        if (!Runner.IsRunning) Runner.Step();
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("InfluencerLive.Modal.Timer", ex); }
        }, null, 150, 150);
    }

    protected override bool ShouldRender()
    {
        Runner.Acting.WritePreviewBmp(_bmp);
        _img = "data:image/bmp;base64," + Convert.ToBase64String(_bmp);
        return true;
    }

    private static string F1(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0.00", CultureInfo.InvariantCulture);
    private static string F3(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0.000", CultureInfo.InvariantCulture);
    private static string Pct(float v) => Math.Clamp(v * 100.0, 0, 100).ToString("0.#", CultureInfo.InvariantCulture);
    private static string Pct0(float v) => float.IsFinite(v) ? (v * 100f).ToString("0", CultureInfo.InvariantCulture) : "—";
    private static string PlatformLabel(int p) => p switch { 0 => "📸 Reels", 1 => "▶ Shorts", _ => "🎵 TikTok" };
    private static string StateName(ClipJobState s) => s switch { ClipJobState.Armed => "🔥 무장(포스트롤)", ClipJobState.Encoding => "✂ 합성 중", _ => "감시" };
    private static string Mask(ReadOnlySpan<char> s) => s.Length <= 2 ? "**" : s[0] + new string('*', Math.Min(12, s.Length - 1));

    private string Series(int kind)
    {
        var c = Runner.Clipper;
        var n = c.SeriesCount;
        if (n < 2) return "";
        var max = 30.0;
        for (var i = 0; i < n; i++) max = Math.Max(max, Math.Max(c.VelocitySeries(i), c.BaselineSeries(i) * LiveEngagementHighlightClippingSynthesizer.SpikeRatio));
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = 0; i < n; i++)
        {
            var k = n - 1 - i;
            var v = kind switch { 0 => c.VelocitySeries(k) / max, 1 => c.RmsSeries(k) / 0.4, _ => Math.Max(c.BaselineSeries(k), LiveEngagementHighlightClippingSynthesizer.ChatFloor) * LiveEngagementHighlightClippingSynthesizer.SpikeRatio / max };
            sb.Append((600.0 * i / (n - 1)).ToString("0.#", CultureInfo.InvariantCulture)).Append(',').Append((78 - 76 * Math.Clamp(v, 0, 1)).ToString("0.#", CultureInfo.InvariantCulture)).Append(' ');
        }
        return sb.ToString();
    }

    private void OnRate(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var v)) Runner.SetChatRate(v / 10f); }

    private void Send()
    {
        if (string.IsNullOrWhiteSpace(_text)) return;
        Runner.SendChat(_user, _text, _amount);
        _text = ""; _amount = 0;
    }

    private void Save(int id) => _saved = Runner.SaveClip(id) ?? "저장 실패";

    private void ToggleRun()
    {
        if (Runner.IsRunning) Runner.Stop(); else { Runner.Prepare(); Runner.Start(); }
    }

    private Task Close() => OnClose.InvokeAsync();

    private void OnServiceChanged()
    {
        if (!Runner.IsRunning) _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
