    @@media (max-width: 1200px) { .dhp-main { grid-template-columns: 1fr; } .dhp-sl, .dhp-sl.four { grid-template-columns: 1fr 1fr; } }
</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private const int VW = 480, VH = 480, GW = 240, GH = 180;
    private const float Focal = 1050f;
    private static readonly FacePreset[] Presets = { FacePreset.Neutral, FacePreset.Joy, FacePreset.Sadness, FacePreset.Anger, FacePreset.Surprise, FacePreset.Fear, FacePreset.Disgust };
    private static readonly SkinLook[] Looks = { SkinLook.Natural, SkinLook.Fair, SkinLook.Deep, SkinLook.Oily, SkinLook.Aged };
    private float _yaw = 18f;
    private string? _line;
    private int _manual = (int)ArkitBlendshape.JawOpen;
    private System.Threading.Timer? _timer;
    private Vector3 _eye, _f, _r, _u;
    private readonly int[] _idx = new int[NeuralFacialMuscleSimulator.VertexCount + 2 * DigitalHumanPerformanceStudioRunner.EyePoints];
    private readonly float[] _depth = new float[NeuralFacialMuscleSimulator.VertexCount + 2 * DigitalHumanPerformanceStudioRunner.EyePoints];

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        UpdateCamera();
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("DigitalHuman.Modal.Timer", ex); }
        }, null, 200, 200);
    }

    private static string F0(double v) => v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => v.ToString("0.00", CultureInfo.InvariantCulture);
    private static string F3(double v) => v.ToString("0.000", CultureInfo.InvariantCulture);

    private static string PresetIcon(FacePreset p) => p switch
    {
        FacePreset.Joy => "😊", FacePreset.Sadness => "😢", FacePreset.Anger => "😠", FacePreset.Surprise => "😲", FacePreset.Fear => "😨", FacePreset.Disgust => "🤢", _ => "😐",
    };

    private string TargetName(int t) => t < 0 ? "시선 회피" : Runner.Gaze.TargetIsCamera(t) ? "🎥 카메라 응시" : "👥 관객 " + t.ToString(CultureInfo.InvariantCulture);

    private void UpdateCamera()
    {
        var a = _yaw * MathF.PI / 180f;
        var target = new Vector3(0f, -0.005f, 0.02f);
        _eye = target + new Vector3(MathF.Sin(a) * 0.55f, 0.03f, MathF.Cos(a) * 0.55f);
        _f = Vector3.Normalize(target - _eye); _r = Vector3.Normalize(Vector3.Cross(_f, Vector3.UnitY)); _u = Vector3.Cross(_r, _f);
    }

    private Vector3 Proj(Vector3 p)
    {
        var d = p - _eye; var z = Vector3.Dot(d, _f);
        if (z < 0.05f) return new Vector3(-100, -100, 1f);
        return new Vector3(VW * 0.5f + Focal * Vector3.Dot(d, _r) / z, VH * 0.5f - Focal * Vector3.Dot(d, _u) / z, z);
    }

    /// <summary>가시 스플랫(후면 컬링) 수집 + 깊이 정렬(먼 것 → 가까운 것 · 선할당 버퍼).</summary>
    private int Collect()
    {
        var sc = Runner.Splats; var n = Math.Min(sc.Count, _idx.Length); var m = 0;
        for (var i = 0; i < n; i++)
        {
            var p = sc.Position(i);
            if (i < NeuralFacialMuscleSimulator.VertexCount)
            {
                if (Vector3.Dot(Runner.Face.Normal(i), _eye - p) <= 0f) continue;
            }
            else if (sc.Opacity[i] < 0.08f) continue;
            _idx[m] = i; _depth[m] = -Vector3.Dot(p - _eye, _f); m++;
        }
        Array.Sort(_depth, _idx, 0, m);
        return m;
    }

    private static string Rgb(float r, float g, float b) =>
        "rgb(" + ((int)(Math.Clamp(r, 0f, 1f) * 255f)).ToString(CultureInfo.InvariantCulture) + "," + ((int)(Math.Clamp(g, 0f, 1f) * 255f)).ToString(CultureInfo.InvariantCulture) + "," + ((int)(Math.Clamp(b, 0f, 1f) * 255f)).ToString(CultureInfo.InvariantCulture) + ")";

    private static float GX(float yaw) => GW * 0.5f + yaw / 45f * GW * 0.5f;
    private static float GY(float pitch) => GH * 0.5f - pitch / 35f * GH * 0.5f;

    private string Trail()
    {
        var sb = new StringBuilder();
        for (var k = 0; k < AutonomousDigitalHumanGazeGuard.HistoryLen; k++)
            sb.Append(F1(GX(Runner.Gaze.HistoryYaw(k)))).Append(',').Append(F1(GY(Runner.Gaze.HistoryPitch(k)))).Append(' ');
        return sb.ToString();
    }

    private string Spark(int kind)
    {
        var sb = new StringBuilder();
        for (var k = 0; k < AutonomousDigitalHumanGazeGuard.HistoryLen; k++)
        {
            var y = kind == 0 ? 38f - 34f * Runner.Gaze.HistoryBlink(k) : 38f - 34f * Math.Clamp((Runner.Gaze.HistoryPupil(k) - 2f) / 6f, 0f, 1f);
            sb.Append(k.ToString(CultureInfo.InvariantCulture)).Append(',').Append(F1(y)).Append(' ');
        }
        return sb.ToString();
    }

    private static string Kernel(ReadOnlySpan<float> k)
    {
        var max = 0f; foreach (var x in k) max = MathF.Max(max, x);
        var sb = new StringBuilder();
        for (var t = 0; t < k.Length; t++)
            sb.Append(F1(5 + t * 120f / (k.Length - 1))).Append(',').Append(F1(56 - 50 * k[t] / MathF.Max(max, 1e-6f))).Append(' ');
        return sb.ToString();
    }

    private static bool TryF(ChangeEventArgs e, out float v) => float.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out v);

    private void OnYaw(ChangeEventArgs e) { if (TryF(e, out var v)) { _yaw = v; UpdateCamera(); } }
    private void OnCam(ChangeEventArgs e) { if (TryF(e, out var v)) Runner.SetCameraOffset(v / 100f); }
    private void OnLum(ChangeEventArgs e) { if (TryF(e, out var v)) Runner.SetLuminance(MathF.Pow(10f, (v - 200f) / 100f)); }
    private void OnManual(ChangeEventArgs e) { if (TryF(e, out var v)) Runner.SetManual((ArkitBlendshape)_manual, v / 100f); }
    private void OnIdentity(int k, ChangeEventArgs e) { if (TryF(e, out var v)) Runner.SetIdentity(k, v / 100f); }
    private void SetSkin(ChangeEventArgs e, Action<float> apply) { if (TryF(e, out var v)) apply(v); }

    private void Step() { for (var k = 0; k < DigitalHumanPerformanceStudioRunner.Hz; k++) Runner.TickOnce(); }

    private void ToggleRun() { if (Runner.IsRunning) Runner.Stop(); else Runner.Start(); }

    private Task Close() => OnClose.InvokeAsync();

    private void OnServiceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
