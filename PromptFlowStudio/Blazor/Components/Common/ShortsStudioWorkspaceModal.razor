@using System.Globalization
@using PromptFlowStudio.Services.Ui
@implements IDisposable
@inject ShortsFactoryOneClickRenderOrchestrator OneClick

@* [PromptFlow Studio v18.0.0] 🏭 원스톱 숏폼 AI 팩토리 — v17.77 세이프존 훅 · v17.78 키네틱 자막 · v17.82 다국어 더빙 · v17.84 킬러클립 · v17.85 예측/익스포터 ·
   v17.91 저작권 · v17.98 리텐션 리먹서를 4 단계 탭으로 통합. 각 엔진 모달은 그대로 하위 탭에 주입하고, 탭 간 값은 ShortsFactoryWorkspaceContext 1 개로 공유한다. *@
@* [v18.0.1] ShortsFactoryPipelineContext 가 상단 바 값을 4 단계 엔진 파라미터로 관통 → 하위 엔진 모달에 CascadingValue 로 전달 · Alt+1~4 단계 전환. *@
@* [v18.0.2] ⚡ 원클릭 숏폼 렌더 — ShortsFactoryOneClickRenderOrchestrator 가 ①~④ 를 실 소스 슬라이스로 단일 비동기 패스 실행 · 통합 진행률 · 완료 시 ④ 탭 포커스. *@
@* [v18.0.3] ① 📁 로컬 비디오 열기 — MP4 실 NALU/AAC 를 소스 링에 주입(120 s 리허설 자동 비활성) · 파일 배지(이름 · 해상도 · 길이) · 절삭 슬라이더 = 파일 길이. *@
<div class="sw-docked" style="--sw-dock-h: @(ShowProgress ? "150px" : "128px")" tabindex="-1" @onkeydown="OnStageKey">
    <StudioWorkspaceDock Workspace="_ws" Tab="_tab" Member="_member" OnRoute="Go" OnClose="Close">
        <div class="swd-row sfw-ctx">
            @for (var i = 0; i < ShortsFactoryWorkspaceContext.StageCount; i++)
            {
                var s = i;
                <span class='sfw-pill @(Ctx.IsCommitted(s) ? "ok" : null) @(s == _tab ? "cur" : null)'>@(Ctx.IsCommitted(s) ? "✔" : "•") @(StageSummary(s))</span>
            }
            <span class="sfw-sep"></span>
            @switch (_tab)
            {
                case 0:
                    <label class='sfw-open @(_importing || OneClick.Busy ? "dis" : null)' title="로컬 MP4(H.264 · AAC)를 열어 120초 리허설 대신 실제 비트스트림으로 ①~④ 를 구동합니다">@(_importing ? "⏳ 불러오는 중…" : "📁 로컬 비디오 열기")<InputFile class="sfw-file" OnChange="OnVideoPicked" accept="video/mp4,.mp4,.m4v,.mov" disabled="@(_importing || OneClick.Busy)" aria-label="로컬 비디오 파일 선택" /></label>
                    @if (OneClick.SourceName is { } srcName)
                    {
                        <span class="sfw-hy ok" title="실 파일 소스(리허설 비활성) · 링 주입 V@(OneClick.Importer.InjectedVideo)/A@(OneClick.Importer.InjectedAudio)">🎞 @(srcName) · @(OneClick.Importer.Width)×@(OneClick.Importer.Height) · @(Sec(OneClick.Importer.DurationMs))</span>
                    }
                    else
                    {
                        <span class="sfw-hy" title="파일 미선택 시 120초 리허설 캡처로 렌더합니다">🧪 리허설 소스</span>
                    }
                    @if (_importError is { } importErr)
                    {
                        <span class="sfw-hy bad" role="alert">⚠ @(importErr)</span>
                    }
                    <label class="sfw-f">시작 @(Sec(Ctx.ClipInMs))<input type="range" min="0" max="@(Math.Max(0, (SourceSpanMs - Ctx.DurationMs) / 1000))" value="@(Ctx.ClipInMs / 1000)" aria-label="클립 시작(초)" @oninput="OnClipStart" /></label>
                    <label class="sfw-f">길이 @(Sec(Ctx.DurationMs))<input type="range" min="3" max="60" value="@(Ctx.DurationMs / 1000)" aria-label="클립 길이(초)" @oninput="OnClipLength" /></label>
                    <label class="sfw-f">9:16 중심 @(Ctx.ReframeCenterPermille / 10)%<input type="range" min="0" max="100" value="@(Ctx.ReframeCenterPermille / 10)" aria-label="리프레임 중심(%)" @oninput="OnReframe" /></label>
                    <span class="sfw-hy" title="9:16 바운딩 박스(원본 1920×1080 기준)">⬚ X @(Pipeline.Reframe.BoxX) · @(Pipeline.Reframe.BoxWidth)×@(Pipeline.Reframe.BoxHeight)</span>
                    break;
                case 1:
                    <select class="sfw-sel" value="@(Ctx.CaptionPreset)" aria-label="자막 프리셋" @onchange="OnPreset">
                        <option value="0">옐로우 하이라이트</option>
                        <option value="1">네온 사이버</option>
                        <option value="2">미니멀 화이트</option>
                    </select>
                    <button type="button" class='sfw-tg @(Ctx.HasLanguage(ShortsFactoryWorkspaceContext.LangEn) ? "on" : null)' aria-pressed='@(Ctx.HasLanguage(ShortsFactoryWorkspaceContext.LangEn) ? "true" : "false")' aria-label="더빙 EN" @onclick="() => Ctx.ToggleLanguage(ShortsFactoryWorkspaceContext.LangEn)">EN</button>
                    <button type="button" class='sfw-tg @(Ctx.HasLanguage(ShortsFactoryWorkspaceContext.LangEs) ? "on" : null)' aria-pressed='@(Ctx.HasLanguage(ShortsFactoryWorkspaceContext.LangEs) ? "true" : "false")' aria-label="더빙 ES" @onclick="() => Ctx.ToggleLanguage(ShortsFactoryWorkspaceContext.LangEs)">ES</button>
                    <button type="button" class='sfw-tg @(Ctx.HasLanguage(ShortsFactoryWorkspaceContext.LangJa) ? "on" : null)' aria-pressed='@(Ctx.HasLanguage(ShortsFactoryWorkspaceContext.LangJa) ? "true" : "false")' aria-label="더빙 JA" @onclick="() => Ctx.ToggleLanguage(ShortsFactoryWorkspaceContext.LangJa)">JA</button>
                    <span class="sfw-hy" title="① 절삭 구간 대본만 자막 엔진에 재슬라이싱">📝 대본 @(Pipeline.Caption.WordCount)단어</span>
                    break;
                case 2:
                    <label class="sfw-f">줌 펀치 @(Ctx.ZoomPunchCount)회<input type="range" min="0" max="@(ShortsFactoryWorkspaceContext.MaxZoomPunches)" value="@(Ctx.ZoomPunchCount)" aria-label="줌 펀치 횟수" @oninput="OnPunches" /></label>
                    <button type="button" class='sfw-tg @(Ctx.BgmSafe ? "on" : null)' aria-pressed='@(Ctx.BgmSafe ? "true" : "false")' aria-label="안전 BGM 치환" @onclick="() => Ctx.SetBgmSafe(!Ctx.BgmSafe)">🛡 안전 BGM 치환</button>
                    <span class="sfw-hy" title="절삭 구간 내 이탈 슬럼프 → NaluSmartReMuxer 컷 · 펀치 타임코드">📉 슬럼프 @(Pipeline.RetentionAudio.SlumpCount)곳 · 펀치 @(Pipeline.RetentionAudio.PunchCount)</span>
                    break;
                default:
                    <label class="sfw-f">썸네일 @(Sec(Ctx.ThumbnailAtMs))<input type="range" min="0" max="100" value="@(Ctx.ThumbnailPermille / 10)" aria-label="썸네일 위치(%)" @oninput="OnThumb" /></label>
                    <span class="sfw-hy" title="fMP4 인출 예상 길이 · 썸네일 피크 프레임">⏱ @(Sec(Pipeline.Manifest.DurationMs)) · 피크 #@(Pipeline.Manifest.ThumbnailPeakFrame)</span>
                    @if (Rendered)
                    {
                        <span class="sfw-hy ok" title="원클릭 렌더 fMP4 실제 바이트 · 비디오/오디오 샘플">🎬 fMP4 @(Mb(OneClick.LastExport.Bytes)) MB · V@(OneClick.LastExport.VideoSamples)/A@(OneClick.LastExport.AudioSamples)</span>
                        @if (OneClick.ThumbnailDataUrl is { } thumb)
                        {
                            <img class="sfw-th" src="@thumb" alt="고CTR 썸네일 미리보기" />
                        }
                    }
                    break;
            }
            <button type="button" class="sfw-go" disabled="@(!Ctx.CanCommit(_tab))" title="@(Ctx.CanCommit(_tab) ? "이 단계 값을 확정합니다" : "앞 단계를 먼저 확정하세요")" @onclick="CommitStage">@(CommitLabel())</button>
            <button type="button" class="sfw-rs" aria-label="컨텍스트 초기화" disabled="@(OneClick.Busy)" @onclick="Ctx.Reset">♻</button>
            <button type="button" class='sfw-1c @(OneClick.Busy ? "busy" : null)' title="①~④ 를 현재 값으로 한 번에 렌더합니다(실 소스 슬라이스 → 자막 → 줌 펀치/BGM 덕킹 → fMP4·썸네일)" @onclick="OnOneClick">@(OneClick.Busy ? "⏹ 렌더 취소" : "⚡ 원클릭 숏폼 렌더")</button>
            @if (ShowProgress)
            {
                <div class='sfw-prog @(OneClick.Stage == OneClickRenderStage.Failed ? "bad" : null)' role="progressbar" aria-label="원클릭 렌더 진행률" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@(OneClick.TotalPercent)">
                    <div class="sfw-bar" style="width: @(OneClick.TotalPercent)%"></div>
                    @for (var i = 1; i <= ShortsFactoryWorkspaceContext.StageCount; i++)
                    {
                        var st = (OneClickRenderStage)i;
                        <span class='sfw-ps @((int)OneClick.Stage > i ? "ok" : null) @(OneClick.Stage == st ? "cur" : null)'>@(ShortsFactoryOneClickRenderOrchestrator.StageName(st))</span>
                    }
                    <span class="sfw-pt">@(ShortsFactoryOneClickRenderOrchestrator.StageName(OneClick.Stage)) @(OneClick.TotalPercent)%@(OneClick.LastError is { } err ? " · " + err : null)</span>
                </div>
            }
        </div>
    </StudioWorkspaceDock>

    <CascadingValue Value="Pipeline" IsFixed="true">
    @switch (MemberKey)
    {
        case "_liveAutoClipper":
            <LiveToShortsAutoClipperStudioModal OnClose="Close" />
            break;
        case "_visualHooks":
            <KineticVisualHookStudioModal OnClose="Close" />
            break;
        case "_brollSubtitles":
            <KineticTypographyBRollStudioModal OnClose="Close" />
            break;
        case "_multilingualDubbing":
            <PolyglotDubbingLipSyncStudioModal OnClose="Close" />
            break;
        case "_retentionHeatmapReEditor":
            <AudienceRetentionHeatmapStudioModal OnClose="Close" />
            break;
        case "_copyrightCompliance":
            <CopyrightComplianceAuditStudioModal OnClose="Close" />
            break;
        case "_viralPredictorExport":
            <ViralPredictorShortsExportStudioModal OnClose="Close" />
            break;
        default:
            <ReelsVisualPolishStudioModal OnClose="Close" />
            break;
    }
    </CascadingValue>
</div>

<style>
    .sfw-ctx { flex-wrap: wrap; row-gap: 4px; }
    .sfw-pill { background: #0f172a; border: 1px solid #334155; border-radius: 999px; padding: 2px 8px; font-size: 10.5px; color: #94a3b8; white-space: nowrap; }
    .sfw-pill.ok { color: #86efac; border-color: #166534; }
    .sfw-pill.cur { border-color: #38bdf8; color: #e0f2fe; }
    .sfw-sep { flex: 0 0 1px; height: 18px; background: #334155; margin: 0 4px; }
    .sfw-f { display: flex; align-items: center; gap: 6px; font-size: 11px; color: #cbd5e1; white-space: nowrap; }
    .sfw-f input[type=range] { width: 110px; }
    .sfw-sel { background: #1e293b; color: #e2e8f0; border: 1px solid #334155; border-radius: 6px; padding: 3px 6px; font-size: 11px; }
    .sfw-tg { background: #1e293b; color: #cbd5e1; border: 1px solid #334155; border-radius: 6px; padding: 3px 9px; font-size: 11px; cursor: pointer; }
    .sfw-tg.on { background: #155e75; border-color: #22d3ee; color: #fff; }
    .sfw-go { background: #0369a1; color: #fff; border: 1px solid #0ea5e9; border-radius: 6px; padding: 4px 11px; font-size: 11px; font-weight: 700; cursor: pointer; }
    .sfw-go:disabled { opacity: .45; cursor: not-allowed; }
    .sfw-hy { font-size: 10.5px; color: #7dd3fc; white-space: nowrap; }
    .sfw-rs { background: none; border: 1px solid #334155; color: #94a3b8; border-radius: 6px; padding: 3px 7px; cursor: pointer; }
    .sfw-1c { background: linear-gradient(90deg, #a21caf, #db2777); color: #fff; border: 1px solid #f472b6; border-radius: 6px; padding: 4px 12px; font-size: 11px; font-weight: 800; cursor: pointer; }
    .sfw-1c.busy { background: #7f1d1d; border-color: #f87171; }
    .sfw-prog { position: relative; flex: 1 0 100%; display: flex; align-items: center; gap: 6px; height: 18px; background: #0f172a; border: 1px solid #334155; border-radius: 999px; overflow: hidden; padding: 0 8px; }
    .sfw-prog.bad { border-color: #ef4444; }
    .sfw-bar { position: absolute; left: 0; top: 0; bottom: 0; background: linear-gradient(90deg, #0ea5e9, #db2777); opacity: .45; transition: width .15s linear; }
    .sfw-ps, .sfw-pt { position: relative; font-size: 10px; color: #94a3b8; white-space: nowrap; }
    .sfw-ps.ok { color: #86efac; }
    .sfw-ps.cur { color: #fff; font-weight: 700; }
    .sfw-pt { margin-left: auto; color: #e2e8f0; }
    .sfw-hy.ok { color: #86efac; }
    .sfw-th { height: 40px; width: auto; border-radius: 4px; border: 1px solid #334155; }
    .sfw-open { background: #1e293b; color: #e2e8f0; border: 1px solid #38bdf8; border-radius: 6px; padding: 3px 10px; font-size: 11px; font-weight: 700; cursor: pointer; white-space: nowrap; }
    .sfw-open.dis { opacity: .5; cursor: progress; }
    .sfw-file { display: none; }
    .sfw-hy.bad { color: #fca5a5; }
</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>딥링크 진입 탭 · 엔진(기존 175 키 → ResolveWorkspaceSubTabRoute). RouteStamp 가 바뀔 때만 재적용(열린 채 재요청 대응).</summary>
    [Parameter] public int InitialTab { get; set; }
    [Parameter] public int InitialMember { get; set; }
    [Parameter] public int RouteStamp { get; set; }
    /// <summary>탭 · 엔진 전환 통지(레이아웃 도움말 서랍이 현재 엔진을 가리키도록).</summary>
    [Parameter] public EventCallback<WorkspaceSubTabRoute> OnRouteChanged { get; set; }

    /// <summary>4 단계 탭 공유 컨텍스트 — 모달 수명 동안 1 개(탭 전환 시 재생성 없음).</summary>
    public ShortsFactoryWorkspaceContext Ctx { get; } = new();
    /// <summary>[v18.0.1] Ctx → ①~④ 엔진 파라미터 관통 상태 — 하위 엔진 모달에 CascadingValue 로 주입.</summary>
    public ShortsFactoryPipelineContext Pipeline { get; } = new();

    private readonly int _ws = StudioWorkspaceCatalog.IndexOfModal(StudioWorkspaceCatalog.ShortsModalKey);
    private int _tab, _member, _stamp = -1, _renderedRev = -1;
    private CancellationTokenSource? _renderCts;
    private bool _disposed, _importing;
    private string? _importError;
    /// <summary>로컬 비디오 상한(세그먼트 스트림 · 300 MB) — 링 창(120 s) 밖 샘플은 주입하지 않는다.</summary>
    private const long MaxImportBytes = 300L * 1024 * 1024;

    /// <summary>절삭 가능한 소스 길이(파일 = 실제 길이 · 리허설 = 120 s).</summary>
    private int SourceSpanMs => Math.Min(ShortsFactoryWorkspaceContext.SourceMs, OneClick.SourceDurationMs);

    private bool ShowProgress => OneClick.Busy || OneClick.Stage is OneClickRenderStage.Failed or OneClickRenderStage.Cancelled || (OneClick.Stage == OneClickRenderStage.Done && Rendered);
    /// <summary>원클릭 렌더 결과가 현재 컨텍스트 값과 같은지(값이 바뀌면 낡은 결과 표시 중단).</summary>
    private bool Rendered => _renderedRev == Ctx.Revision && OneClick.LastExport.Status == PromptFlowStudio.Services.ViralExport.ExportStatus.Ready;

    protected override void OnInitialized() => OneClick.OnChange += OnRenderChanged;

    private void OnRenderChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>⚡ 원클릭 — 실행 중이면 취소 · 완료 시 ①~④ 확정 후 ④ 인출 탭 포커스.</summary>
    private async Task OnOneClick()
    {
        if (OneClick.Busy) { _renderCts?.Cancel(); return; }
        _renderCts?.Dispose();
        _renderCts = new CancellationTokenSource();
        Pipeline.Hydrate(Ctx);
        var ok = await OneClick.RenderAsync(Pipeline, _renderCts.Token);
        if (!ok || _disposed) return;
        for (var s = 0; s < ShortsFactoryWorkspaceContext.StageCount; s++) Ctx.Commit(s);
        _renderedRev = Ctx.Revision;
        await Go(new WorkspaceSubTabRoute(_ws, ShortsFactoryWorkspaceContext.StageCount - 1, 0));
    }

    /// <summary>[v18.0.3] 📁 로컬 MP4 → 세그먼트 버퍼(탐색 가능) → 소스 링 주입(스레드 풀) · 절삭 구간을 파일 길이 안으로 보정 · 이전 렌더 결과 무효화.</summary>
    private async Task OnVideoPicked(InputFileChangeEventArgs e)
    {
        if (_importing || OneClick.Busy) return;
        _importing = true; _importError = null;
        try
        {
            using var buf = new PromptFlowStudio.Services.VerticalTranscode.SegmentedChunkStream(MaxImportBytes);
            await using (var src = e.File.OpenReadStream(MaxImportBytes)) await src.CopyToAsync(buf);
            buf.Position = 0;
            var name = e.File.Name;
            var st = await Task.Run(() => OneClick.ImportLocalVideo(buf, name));
            if (_disposed) return;
            if (st != LocalVideoImportStatus.Injected)
            {
                _importError = "불러오기 실패(" + st.ToString() + ")" + (OneClick.Importer.LastError is { } why ? ": " + why : null);
                return;
            }
            _renderedRev = -1;
            var span = SourceSpanMs;
            if (Ctx.ClipOutMs > span) Ctx.SetClip(0, Math.Min(Ctx.DurationMs, span));
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException or OperationCanceledException or ObjectDisposedException)
        {
            _importError = "불러오기 실패: " + ex.Message;
        }
        finally { _importing = false; }
    }

    public void Dispose()
    {
        _disposed = true;
        OneClick.OnChange -= OnRenderChanged;
        _renderCts?.Cancel();
        _renderCts?.Dispose();
    }

    private string MemberKey => StudioWorkspaceCatalog.MemberKey(new WorkspaceSubTabRoute(_ws, _tab, _member));

    protected override void OnParametersSet()
    {
        Pipeline.Hydrate(Ctx);
        if (_stamp == RouteStamp) return;
        _stamp = RouteStamp;
        Apply(InitialTab, InitialMember);
    }

    /// <summary>모든 Ctx 변경(슬라이더 · 토글 · 초기화 · 확정)은 이벤트 → 재렌더를 거치므로 렌더 직전에 관통한다(Revision 동일 시 no-op).</summary>
    protected override bool ShouldRender()
    {
        Pipeline.Hydrate(Ctx);
        return true;
    }

    /// <summary>Alt+1~4 — 단계 탭 전환(셸 단축키 Alt+0/H 와 겹치지 않음).</summary>
    private Task OnStageKey(KeyboardEventArgs e)
    {
        if (!e.AltKey || e.Key is not { Length: 1 } k || k[0] < '1' || k[0] >= '1' + ShortsFactoryWorkspaceContext.StageCount) return Task.CompletedTask;
        var tab = k[0] - '1';
        return tab == _tab ? Task.CompletedTask : Go(new WorkspaceSubTabRoute(_ws, tab, 0));
    }

    private Task Go(WorkspaceSubTabRoute r)
    {
        Apply(r.Tab, r.Member);
        return OnRouteChanged.InvokeAsync(new WorkspaceSubTabRoute(_ws, _tab, _member));
    }

    private void Apply(int tab, int member)
    {
        var tabs = StudioWorkspaceCatalog.Workspaces[_ws].Tabs;
        _tab = (uint)tab < (uint)tabs.Length ? tab : 0;
        _member = (uint)member < (uint)tabs[_tab].Members.Length ? member : 0;
    }

    private Task CommitStage()
    {
        // ④ 까지 확정되면 다음 단계(배포)는 소셜 퍼블리셔 워크스페이스 — 여기서는 단계 진행만 한다.
        return Ctx.Commit(_tab) && _tab < ShortsFactoryWorkspaceContext.StageCount - 1 ? Go(new WorkspaceSubTabRoute(_ws, _tab + 1, 0)) : Task.CompletedTask;
    }

    private string CommitLabel() => _tab switch
    {
        0 => Ctx.IsCommitted(0) ? "✔ 절삭 확정됨" : "✔ 절삭 확정",
        1 => Ctx.IsCommitted(1) ? "✔ 자막·더빙 확정됨" : "✔ 자막·더빙 확정",
        2 => Ctx.IsCommitted(2) ? "✔ 리텐션 확정됨" : "✔ 리텐션 확정",
        _ => Ctx.IsCommitted(3) ? "📦 인출 완료 " + (Ctx.ExportBytes / 1_048_576.0).ToString("0.0", CultureInfo.InvariantCulture) + " MB" : "📦 인출 확정",
    };

    private string StageSummary(int s) => s switch
    {
        0 => "✂ " + Sec(Ctx.ClipInMs) + "–" + Sec(Ctx.ClipOutMs),
        1 => "💬 " + PresetName(Ctx.CaptionPreset) + " · " + LangText(),
        2 => "📈 펀치 " + Ctx.ZoomPunchCount.ToString(CultureInfo.InvariantCulture) + (Ctx.BgmSafe ? " · 안전 BGM" : " · 원음"),
        _ => "📦 썸네일 " + Sec(Ctx.ThumbnailAtMs),
    };

    private static string PresetName(int p) => p switch { 1 => "네온", 2 => "미니멀", _ => "옐로우" };

    private string LangText()
    {
        if (Ctx.DubLanguageMask == 0) return "KO 원음";
        return (Ctx.HasLanguage(ShortsFactoryWorkspaceContext.LangEn) ? "EN " : null)
             + (Ctx.HasLanguage(ShortsFactoryWorkspaceContext.LangEs) ? "ES " : null)
             + (Ctx.HasLanguage(ShortsFactoryWorkspaceContext.LangJa) ? "JA" : null);
    }

    private static string Mb(long bytes) => (bytes / 1_048_576.0).ToString("0.00", CultureInfo.InvariantCulture);

    private static string Sec(int ms) => (ms / 1000.0).ToString("0.0", CultureInfo.InvariantCulture) + "s";

    private static int Num(ChangeEventArgs e) => int.TryParse(Convert.ToString(e.Value, CultureInfo.InvariantCulture), NumberStyles.Integer, CultureInfo.InvariantCulture, out var v) ? v : 0;

    private void OnClipStart(ChangeEventArgs e) => Ctx.SetClip(Num(e) * 1000, Ctx.DurationMs);
    private void OnClipLength(ChangeEventArgs e) => Ctx.SetClip(Ctx.ClipInMs, Num(e) * 1000);
    private void OnReframe(ChangeEventArgs e) => Ctx.SetReframeCenter(Num(e) * 10);
    private void OnPreset(ChangeEventArgs e) => Ctx.SetCaptionPreset(Num(e));
    private void OnPunches(ChangeEventArgs e) => Ctx.SetZoomPunches(Num(e));
    private void OnThumb(ChangeEventArgs e) => Ctx.SetThumbnail(Num(e) * 10);

    private Task Close() => OnClose.InvokeAsync();
}
