@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private System.Threading.Timer? _timer;
    private int _viewer;
    private static readonly string[] HeatHex = BuildHeat();

    private DeterministicRollbackNetcodeEngine R => Runner.Rollback;
    private MassiveSpatialInterestManagementSynthesizer A => Runner.Aoi;
    private ClientSpatialPredictionClockSyncGuard G => Runner.Guard;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("Arena.Modal.Timer", ex); }
        }, null, 300, 300);
    }

    /// <summary>열 지도 64단계(남색 → 청록 → 노랑 → 빨강).</summary>
    private static string[] BuildHeat()
    {
        var h = new string[64];
        for (var i = 0; i < 64; i++)
        {
            var t = i / 63.0;
            double r, g, b;
            if (t < 0.33) { var u = t / 0.33; r = 20; g = 40 + 140 * u; b = 90 + 110 * u; }
            else if (t < 0.66) { var u = (t - 0.33) / 0.33; r = 20 + 230 * u; g = 180 + 40 * u; b = 200 - 170 * u; }
            else { var u = (t - 0.66) / 0.34; r = 250; g = 220 - 170 * u; b = 30; }
            h[i] = "#" + ((int)r).ToString("X2", CultureInfo.InvariantCulture) + ((int)g).ToString("X2", CultureInfo.InvariantCulture) + ((int)b).ToString("X2", CultureInfo.InvariantCulture);
        }
        return h;
    }

    private string Heat(int n) => HeatHex[Math.Clamp((int)(Math.Log(1 + n) / Math.Log(1 + Math.Max(4, A.MaxCellCount * 4)) * 63), 0, 63)];
    private static string F0(double v) => v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => double.IsNaN(v) ? "—" : v.ToString("0.00", CultureInfo.InvariantCulture);
    private static double Num(ChangeEventArgs e, double fallback) => double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : fallback;

    /// <summary>시청자 FoV 원뿔(부채꼴) 경로 — 360° 는 원.</summary>
    private string Cone(int v)
    {
        double x = A.ViewerX(v), z = A.ViewerZ(v), r = A.ViewerRadius(v), yaw = A.ViewerYaw(v), half = A.ViewerFovDeg(v) * Math.PI / 360.0;
        if (half >= Math.PI - 1e-3)
            return "M " + F1(x - r) + " " + F1(z) + " a " + F1(r) + " " + F1(r) + " 0 1 0 " + F1(2 * r) + " 0 a " + F1(r) + " " + F1(r) + " 0 1 0 " + F1(-2 * r) + " 0";
        double x1 = x + r * Math.Cos(yaw - half), z1 = z + r * Math.Sin(yaw - half), x2 = x + r * Math.Cos(yaw + half), z2 = z + r * Math.Sin(yaw + half);
        return "M " + F1(x) + " " + F1(z) + " L " + F1(x1) + " " + F1(z1) + " A " + F1(r) + " " + F1(r) + " 0 " + (half > Math.PI / 2 ? "1" : "0") + " 1 " + F1(x2) + " " + F1(z2) + " Z";
    }

    private float MaxKbps()
    {
        var m = 0f;
        for (var i = 0; i < Runner.SeriesCount; i++) m = Math.Max(m, Runner.KbpsSeries(i));
        return m * 1.1f;
    }

    private string Series(Func<int, float> f, double max, double h)
    {
        var n = Runner.SeriesCount;
        if (n < 2) return "";
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = n - 1; i >= 0; i--)
            sb.Append(F1(360.0 * (n - 1 - i) / (VirtualArenaNetcodeStudioRunner.SeriesLen - 1))).Append(',').Append(F1(h - 2 - (h - 4) * Math.Clamp(f(i) / max, 0, 1))).Append(' ');
        return sb.ToString();
    }

    private void ToggleRun() { if (Runner.IsRunning) Runner.Stop(); else Runner.Start(); }
    private void Step60() { for (var i = 0; i < VirtualArenaNetcodeStudioRunner.Hz; i++) Runner.Step(); }

    private Task Close() => OnClose.InvokeAsync();

    /// <summary>가동 중(10 Hz 이벤트)은 300 ms 타이머가 처리 — 정지 상태 액션만 즉시 반영.</summary>
    private void OnServiceChanged() { if (!Runner.IsRunning) _ = InvokeAsync(StateHasChanged); }

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
