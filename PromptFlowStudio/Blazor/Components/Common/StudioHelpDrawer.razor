@using PromptFlowStudio.Services.Ui
@implements IDisposable

@* [PromptFlow Studio v17.89.0] 📘 스튜디오 공통 도움말 서랍 — 모달 헤더 ✕ 좌측 ? 버튼(promptflow.js siteMaticStudioHelp 주입)이 열고,
   StudioCatalogHelpRegistry 에서 현재 모달 키의 [개요 · 핵심 조작 · 3단계 작업 순서 · 연관 메뉴]를 렌더한다. 연관 메뉴 클릭 = 현재 모달 닫고 즉시 전환. *@
<div class="shd-scrim" @onclick="Close"></div>
<aside class="shd-panel" role="dialog" aria-modal="false" aria-label="스튜디오 도움말" @onkeydown="OnKey">
    <div class="shd-h">
        <div class="shd-t">
            <span class="shd-ic">@(_entry?.Icon ?? "📘")</span>
            <div>
                <div class="shd-title">@(_entry?.Title ?? "도움말")</div>
                <div class="shd-cat">@(_entry is null ? "카탈로그 외 화면" : StudioWorkspaceCatalog.RouteLabel(_entry.Key) is { Length: > 0 } wsLabel ? wsLabel : StudioCatalog.Categories[_entry.Category])</div>
            </div>
        </div>
        <button class="shd-x" @onclick="Close" aria-label="도움말 닫기">✕</button>
    </div>

    <div class="shd-body">
        @if (_help is null)
        {
            <div class="shd-sec">
                <div class="shd-sh">개요</div>
                <p>이 화면은 스튜디오 카탈로그에 등록되지 않은 보조 대화상자입니다@(string.IsNullOrWhiteSpace(HeaderText) ? null : " (" + Trim(HeaderText) + ")"). 원하는 작업을 문장으로 입력하면 알맞은 스튜디오를 찾아 드립니다.</p>
            </div>
        }
        else
        {
            <div class="shd-sec">
                <div class="shd-sh">개요</div>
                <p class="shd-role">@(_help.RoleSummary)</p>
            </div>
            <div class="shd-sec">
                <div class="shd-sh">핵심 조작</div>
                <ul class="shd-ul">
                    @foreach (var c in _help.KeyControlsGuide)
                    {
                        <li>@(c)</li>
                    }
                </ul>
            </div>
            <div class="shd-sec">
                <div class="shd-sh">3단계 작업 순서</div>
                <ol class="shd-steps">
                    @foreach (var s in _help.QuickWorkflow)
                    {
                        <li>@(s)</li>
                    }
                </ol>
            </div>
            <div class="shd-sec">
                <div class="shd-sh">연관 메뉴</div>
                <div class="shd-rel">
                    @foreach (var r in _help.RelatedMenuIds)
                    {
                        var rk = r;
                        var re = StudioCatalogHelpRegistry.Entry(rk);
                        if (re is null) continue;
                        <button class="shd-rb" title="현재 화면을 닫고 이동" @onclick="() => Navigate(rk)"><span>@(re.Icon)</span>@(re.Title)<b>➔</b></button>
                    }
                </div>
            </div>
            <div class="shd-kw">#@(_help.IntentKeywords.Replace(" ", " #", StringComparison.Ordinal))</div>
        }
        @if (_guide is not null)
        {
            @* v18.0.0 슈퍼-워크스페이스 종합 가이드 — 현재 기능이 속한 워크스페이스의 탭별 역할 · 워크플로(현재 탭 강조). *@
            <div class="shd-sec shd-ws">
                <div class="shd-sh">🧩 워크스페이스 가이드 · @(_guide.Title)</div>
                <p>@(_guide.Overview)</p>
                <ul class="shd-ul">
                    @for (var i = 0; i < _guide.TabGuides.Length; i++)
                    {
                        <li class='@(i == _route.Tab ? "cur" : null)'>@(_guide.TabGuides[i])</li>
                    }
                </ul>
                <ol class="shd-steps">
                    @foreach (var s in _guide.Workflow)
                    {
                        <li>@(s)</li>
                    }
                </ol>
            </div>
        }
    </div>

    <div class="shd-f">
        <button class="shd-btn go" @onclick="OpenHub">🧭 목적으로 메뉴 찾기 (Ctrl+K)</button>
    </div>
</aside>

<style>
    .shd-scrim { position: fixed; inset: 0; z-index: calc(var(--z-submodal-dialog) + 4); background: rgba(0,0,0,.18); }
    .shd-panel { position: fixed; top: 0; right: 0; bottom: 0; width: min(400px, 92vw); z-index: calc(var(--z-submodal-dialog) + 5); display: flex; flex-direction: column; background: var(--card); border-left: 1px solid var(--line); box-shadow: -18px 0 50px rgba(0,0,0,.45); color: var(--text-primary); animation: shd-in .22s ease-out; }
    @@keyframes shd-in { from { transform: translateX(40px); opacity: 0; } to { transform: none; opacity: 1; } }
    .shd-h { position: sticky; top: 0; flex: 0 0 auto; display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; padding: 14px 16px 10px; border-bottom: 1px solid var(--line); background: var(--card); }
    .shd-t { display: flex; gap: 10px; align-items: center; min-width: 0; }
    .shd-ic { font-size: 22px; }
    .shd-title { font-size: 14.5px; font-weight: 800; line-height: 1.35; }
    .shd-cat { font-size: 10.5px; color: var(--text-muted); margin-top: 2px; }
    .shd-x { background: none; border: 0; color: var(--text-muted); font-size: 17px; cursor: pointer; }
    .shd-body { flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 6px 16px 12px; font-size: 12px; line-height: 1.6; }
    .shd-sec { margin-top: 12px; }
    .shd-sh { font-size: 11px; font-weight: 800; letter-spacing: .04em; color: #93c5fd; margin-bottom: 4px; }
    .shd-sec p { margin: 0; }
    .shd-role { color: var(--text-primary); }
    .shd-ul, .shd-steps { margin: 0; padding-left: 18px; }
    .shd-ul li, .shd-steps li { margin-bottom: 4px; }
    .shd-rel { display: flex; flex-direction: column; gap: 5px; }
    .shd-rb { display: flex; align-items: center; gap: 6px; text-align: left; background: #0f172a; color: var(--text-primary); border: 1px solid var(--line); border-radius: 8px; padding: 6px 9px; font-size: 11.5px; cursor: pointer; }
    .shd-rb:hover { border-color: #38bdf8; }
    .shd-rb b { margin-left: auto; color: #38bdf8; }
    .shd-ws { border-top: 1px dashed var(--line); padding-top: 10px; }
    .shd-ws p { margin-bottom: 6px; }
    .shd-ws li.cur { color: #7dd3fc; font-weight: 700; }
    .shd-kw { margin-top: 14px; font-size: 10.5px; color: var(--text-muted); }
    .shd-f { position: sticky; bottom: 0; flex: 0 0 auto; padding: 10px 16px 14px; border-top: 1px solid var(--line); background: var(--card); }
    .shd-btn { width: 100%; background: #1e293b; color: var(--text-primary); border: 1px solid var(--line); border-radius: 8px; padding: 7px 10px; font-size: 12px; cursor: pointer; }
    .shd-btn.go { background: #0369a1; border-color: #0ea5e9; font-weight: 700; color: #fff; }
</style>

@code {
    /// <summary>카탈로그 키(MainLayout 가 열린 플래그 · 헤더 텍스트로 해석). null = 카탈로그 외 화면.</summary>
    [Parameter] public string? Key { get; set; }
    /// <summary>? 를 누른 모달 헤더의 텍스트(카탈로그 외 화면 안내용).</summary>
    [Parameter] public string? HeaderText { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnNavigate { get; set; }
    [Parameter] public EventCallback OnHub { get; set; }

    private StudioEntry? _entry;
    private StudioHelpEntry? _help;
    private StudioWorkspaceGuide? _guide;
    private WorkspaceSubTabRoute _route;
    private bool _disposed;

    protected override void OnParametersSet()
    {
        _entry = Key is null ? null : StudioCatalogHelpRegistry.Entry(Key);
        _help = StudioCatalogHelpRegistry.Find(Key);
        _guide = StudioCatalogHelpRegistry.WorkspaceGuideFor(Key);
        if (!StudioWorkspaceCatalog.ResolveWorkspaceSubTabRoute(Key, out _route)) _route = default;
    }

    private static string Trim(string s) { var t = s.Trim(); return t.Length > 40 ? t[..40] + "…" : t; }

    private Task Close() => _disposed ? Task.CompletedTask : OnClose.InvokeAsync();

    private Task Navigate(string key) => _disposed ? Task.CompletedTask : OnNavigate.InvokeAsync(key);

    private Task OpenHub() => _disposed ? Task.CompletedTask : OnHub.InvokeAsync();

    private Task OnKey(KeyboardEventArgs e) => e.Key == "Escape" ? Close() : Task.CompletedTask;

    public void Dispose() => _disposed = true;
}
