@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private System.Threading.Timer? _timer;
    private int _uni;

    private RoboticMoCoInverseKinematicsEngine R => Runner.Robot;
    private PhysicalStageDmxActuatorSynthesizer S => Runner.Stage;
    private HardwareInTheLoopSafetyEStopGuard G => Runner.Guard;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("MoCo.Modal.Timer", ex); }
        }, null, 300, 300);
    }

    private static string F0(double v) => v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => double.IsNaN(v) ? "—" : v.ToString("0.00", CultureInfo.InvariantCulture);
    private static string F3(double v) => v.ToString("0.###", CultureInfo.InvariantCulture);
    private static string Kb(long b) => (b / 1024d).ToString("0.0", CultureInfo.InvariantCulture) + " KB";
    private static string SepText(float m) => float.IsInfinity(m) ? "—" : F2(m) + " m";
    private static double Num(ChangeEventArgs e, double fallback) => double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : fallback;
    private static string StatusName(IkStatus s) => s switch { IkStatus.Ok => "정상", IkStatus.Clamped => "도달 경계", IkStatus.LimitViolation => "관절 한계", _ => "손목 특이" };
    private static string ModeName(RobotMode m) => m switch { RobotMode.Tracking => "추종", RobotMode.Stopping => "정지 궤적", _ => "브레이크" };

    private int Owner(int address)
    {
        for (var i = 0; i < S.FixtureCount; i++)
        {
            ref readonly var f = ref S.Fixture(i);
            if (f.Universe == _uni && address >= f.Address && address < f.Address + PhysicalStageDmxActuatorSynthesizer.Footprint(f.Kind)) return i;
        }
        return -1;
    }

    private string Values(in StageFixture f)
    {
        var sb = new System.Text.StringBuilder(64);
        var n = PhysicalStageDmxActuatorSynthesizer.Footprint(f.Kind);
        for (var c = 0; c < n; c++) { if (c > 0) sb.Append(' '); sb.Append(S.Channel(f.Universe, f.Address + c).ToString("000", CultureInfo.InvariantCulture)); }
        return sb.ToString();
    }

    private string Header()
    {
        var p = S.LastPacket;
        var sb = new System.Text.StringBuilder(80);
        sb.Append("ArtDmx ");
        for (var i = 0; i < PhysicalStageDmxActuatorSynthesizer.ArtHeader; i++) sb.Append(p[i].ToString("X2", CultureInfo.InvariantCulture)).Append(' ');
        return sb.ToString();
    }

    private string Series(Func<int, float> f, double max, double h)
    {
        var n = Runner.SeriesCount;
        if (n < 2) return "";
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = n - 1; i >= 0; i--)
            sb.Append(F1(360.0 * (n - 1 - i) / (RoboticMoCoStudioRunner.SeriesLen - 1))).Append(',').Append(F1(h - 2 - (h - 4) * Math.Clamp(f(i) / max, 0, 1))).Append(' ');
        return sb.ToString();
    }

    private RenderFragment Person(float x, double height) => __builder =>
    {
        <rect class="pb" x="@(F3(x - 0.25))" y="@(F3(-height))" width="0.5" height="@(F3(height))" rx="0.2" />
    };

    private void ToggleRun() { if (Runner.IsRunning) Runner.Stop(); else Runner.Start(); }
    private void Step100() { for (var i = 0; i < RoboticMoCoStudioRunner.Hz; i++) Runner.Step(); }
    private void DoReset() => Runner.Reset();

    private Task Close() => OnClose.InvokeAsync();

    /// <summary>가동 중(10 Hz 이벤트)은 300 ms 타이머가 처리 — 정지 상태 액션만 즉시 반영.</summary>
    private void OnServiceChanged() { if (!Runner.IsRunning) _ = InvokeAsync(StateHasChanged); }

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
