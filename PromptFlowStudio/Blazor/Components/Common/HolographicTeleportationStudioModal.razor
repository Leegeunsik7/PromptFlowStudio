@using System.Globalization
@using System.Numerics
@using PromptFlowStudio.Services.Holo
@using PromptFlowStudio.Services.Mocap
@implements IDisposable
@inject HolographicTeleportationStudioRunner Runner

@*
    [PromptFlow Studio v16.77.0] 📡 AI 홀로그래픽 텔레포테이션 & 3D 텔레프레젠스 스튜디오 — 수신 홀로그램 3D 뷰포트(궤도 회전 · 시선 레이 · 시청자 위치) ·
    공간 압축률 스펙트럼 슬라이더(8~16 bit/축) · 시선 교정 토글/강도 · BCI 미세 표정 블렌드셰이프 · 바이노럴 음성/립싱크 · 공유 월드 앵커/P2P 메시 관제.
*@

<div class="htp-scrim" @onclick="Close">
    <div class="htp-modal" @onclick:stopPropagation="true">
        <div class="htp-h">
            <div>
                <div class="htp-title">📡 AI 홀로그래픽 텔레포테이션 &amp; 3D 텔레프레젠스 스튜디오</div>
                <div class="htp-sub"><b>3DGS · OpenUSD · 모캡</b> 볼류메트릭 데이터를 SIMD <b>공간 양자화</b>로 압축해 서브 50ms 로 송수신하고, 원격 인물 홀로그램에
                    <b>Eye-Contact 시선 교정 · BCI 미세 표정 · 바이노럴 음성</b>을 합성해 <b>공유 앵커 월드</b>에 P2P 동기화합니다.</div>
            </div>
            <button class="htp-x" @onclick="Close">✕</button>
        </div>

        <div class="htp-bar">
            <button class="htp-btn @(Runner.IsRunning ? "on" : null)" @onclick="ToggleRun">@(Runner.IsRunning ? "⏸ 텔레포테이션 정지" : "▶ 실시간 텔레포테이션")</button>
            <button class="htp-btn" @onclick="Step">⏭ 1프레임</button>
            <span class="htp-chip @(Runner.WithinBudget ? "ok" : "warn")">지연 @(F1(Runner.LatencyMs))ms / @(F0(HolographicTeleportationStudioRunner.LatencyBudgetMs))ms</span>
            <span class="htp-chip">압축 ×@(F1(Runner.Streamer.CompressionRatio)) · @(F0(Runner.Kbps))kbps</span>
            <span class="htp-chip">@(Runner.Streamer.LastWasKeyframe ? "🔑 키프레임" : "Δ 델타") · 조각 @(Runner.Streamer.LastFragments) · SIMD @(RealtimeVolumetricHologramStreamerEngine.SimdLanes)레인</span>
            <span class="htp-chip">디코드 @(Runner.Streamer.FramesDecoded) · 드롭 @(Runner.Streamer.FramesDropped) · PLI @(Runner.Streamer.KeyframeRequests)</span>
        </div>

        <div class="htp-main">
            <div class="htp-col">
                <div class="htp-card">
                    <div class="htp-sec">🧊 홀로그램 3D 뷰포트 — 궤도 <input type="range" min="-180" max="180" step="5" value="@(F0(_orbit))" @oninput="e => _orbit = P(e)" /> @(F0(_orbit))°</div>
                    <svg class="htp-view" viewBox="-1.9 -2.25 3.8 2.45" preserveAspectRatio="xMidYMid meet">
                        <line x1="-1.9" y1="0" x2="1.9" y2="0" class="floor" />
                        @for (var i = 0; i < Runner.Received.Count; i += 2)
                        {
                            var p = Proj(Runner.Received.Position(i));
                            var c = Runner.Received.BaseColor(i);
                            <circle cx="@(F3(p.X))" cy="@(F3(p.Y))" r="0.022" style="fill:@(Rgb(c))" />
                        }
                        @{ var joints = _joints; var jn = Runner.Streamer.CopyReceivedJoints(joints); }
                        @if (jn == MocapSkeleton.Body)
                        {
                            for (var j = 1; j < MocapSkeleton.Body; j++)
                            {
                                var a = Proj(joints[MocapSkeleton.Parent[j]]); var b = Proj(joints[j]);
                                <line x1="@(F3(a.X))" y1="@(F3(a.Y))" x2="@(F3(b.X))" y2="@(F3(b.Y))" class="bone" />
                            }
                            var h = Proj(Runner.Avatar.HeadPosition); var g = Proj(Runner.Avatar.HeadPosition + Runner.Avatar.GazeDirection * 0.8f);
                            <line x1="@(F3(h.X))" y1="@(F3(h.Y))" x2="@(F3(g.X))" y2="@(F3(g.Y))" class="gaze" />
                        }
                        @{ var ve = Proj(Runner.ViewerEye); var rc = Proj(Runner.RemoteCamera); }
                        <g>
                            <circle cx="@(F3(ve.X))" cy="@(F3(ve.Y))" r="0.06" class="viewer" />
                            <text x="@(F3(ve.X + 0.08f))" y="@(F3(ve.Y))">시청자</text>
                        </g>
                        <g>
                            <rect x="@(F3(rc.X - 0.05f))" y="@(F3(rc.Y - 0.04f))" width="0.1" height="0.08" class="cam" />
                            <text x="@(F3(rc.X + 0.08f))" y="@(F3(rc.Y + 0.1f))">원격 카메라</text>
                        </g>
                    </svg>
                    <div class="htp-legend"><span><i class="gaze"></i>교정 시선</span><span><i class="viewer"></i>시청자 눈</span><span><i class="cam"></i>원격 카메라</span>
                        <span>스플랫 @(Runner.Received.Count) (USD 프림 @(Runner.PropSplats)) · 관절 @(Runner.Streamer.ReceivedJoints) · 메시 @(Runner.Streamer.ReceivedMesh)</span></div>
                </div>

                <div class="htp-card">
                    <div class="htp-sec">📊 공간 압축률 스펙트럼 — 양자화 <b>@(Runner.Streamer.QuantBits) bit/축</b> · 격자 @(F2(Runner.Streamer.StepMm))mm · 최대 오차 @(F2(Runner.Streamer.MaxErrorMm))mm</div>
                    <input class="htp-range" type="range" min="@(RealtimeVolumetricHologramStreamerEngine.MinBits)" max="@(RealtimeVolumetricHologramStreamerEngine.MaxBits)" step="1" value="@(Runner.Streamer.QuantBits)" @onchange="e => Runner.SetQuantBits((int)P(e))" />
                    <div class="htp-spec">
                        @for (var b = RealtimeVolumetricHologramStreamerEngine.MinBits; b <= RealtimeVolumetricHologramStreamerEngine.MaxBits; b++)
                        {
                            var ratio = KeyRatio(b);
                            <div class="@(b == Runner.Streamer.QuantBits ? "cur" : null)">
                                <i style="height:@(F0(Math.Clamp(ratio / 8f, 0f, 1f) * 100))%"></i>
                                <em>@(b)b</em><b>×@(F1(ratio))</b>
                            </div>
                        }
                    </div>
                    <div class="htp-row">
                        <label class="htp-slider"><span>패킷 손실 <b>@(F1(Runner.LossRate * 100))%</b></span><input type="range" min="0" max="20" step="0.5" value="@(F1(Runner.LossRate * 100))" @onchange="e => Runner.LossRate = P(e) / 100f" /></label>
                        <label class="htp-slider"><span>망 지연(편도) <b>@(F0(Runner.NetworkLatencyMs))ms</b></span><input type="range" min="2" max="60" step="1" value="@(F0(Runner.NetworkLatencyMs))" @onchange="e => Runner.NetworkLatencyMs = P(e)" /></label>
                        <label class="htp-slider"><span>키프레임 간격 <b>@(Runner.Streamer.KeyframeInterval)</b></span><input type="range" min="5" max="120" step="5" value="@(Runner.Streamer.KeyframeInterval)" @onchange="e => Runner.Streamer.KeyframeInterval = (int)P(e)" /></label>
                    </div>
                    <div class="htp-note">막대 = 키프레임 예상 압축률(float32 원본 대비) · 현재 프레임 @(Runner.Streamer.LastEncodedBytes)B / 원본 @(Runner.Streamer.LastRawBytes)B · 인코드 @(F2(Runner.Streamer.EncodeMs))ms · 디코드 @(F2(Runner.Streamer.DecodeMs))ms</div>
                </div>
            </div>

            <div class="htp-col">
                <div class="htp-card">
                    <div class="htp-sec">👁 Eye-Contact 시선 교정
                        <label class="htp-tg"><input type="checkbox" checked="@Runner.Avatar.EyeContact" @onchange="e => Runner.SetEyeContact(e.Value is true)" /> 교정</label>
                    </div>
                    <div class="htp-row">
                        <label class="htp-slider"><span>교정 강도 <b>@(F0(Runner.Avatar.GazeStrength * 100))%</b></span><input type="range" min="0" max="100" step="5" value="@(F0(Runner.Avatar.GazeStrength * 100))" @oninput="e => Runner.Avatar.GazeStrength = P(e) / 100f" /></label>
                        <label class="htp-slider"><span>시청자 방위 <b>@(F0(Runner.ViewerAngleDeg))°</b></span><input type="range" min="-80" max="80" step="5" value="@(F0(Runner.ViewerAngleDeg))" @oninput="e => Runner.ViewerAngleDeg = P(e)" /></label>
                    </div>
                    <div class="htp-kv">
                        <span>시선 오차 <b>@(F1(Runner.Avatar.GazeErrorBeforeDeg))° → @(F1(Runner.Avatar.GazeErrorAfterDeg))°</b></span>
                        <span>머리 교정 <b>요 @(F1(Runner.Avatar.HeadYawCorrDeg))° · 피치 @(F1(Runner.Avatar.HeadPitchCorrDeg))°</b></span>
                        <span>안구 <b>요 @(F1(Runner.Avatar.EyeYawDeg))° · 피치 @(F1(Runner.Avatar.EyePitchDeg))°</b></span>
                    </div>
                </div>

                <div class="htp-card">
                    <div class="htp-sec">🧠 BCI 미세 표정 · 🎧 바이노럴 음성 — @(Runner.Avatar.Emotion.Dominant)</div>
                    <div class="htp-bs">
                        @for (var b = 0; b < AiTelepresenceAvatarSynthesizer.BlendShapes; b++)
                        {
                            <div><em>@(AiTelepresenceAvatarSynthesizer.BlendNames[b])</em><i style="width:@(F0(Runner.Avatar.Weights[b] * 100))%"></i><b>@(F2(Runner.Avatar.Weights[b]))</b></div>
                        }
                    </div>
                    <div class="htp-kv">
                        <span>정서가 <b>@(F2(Runner.Avatar.Emotion.Valence))</b></span>
                        <span>각성 <b>@(F2(Runner.Avatar.Emotion.Arousal))</b></span>
                        <span>음성 엔벨로프 <b>@(F3(Runner.Avatar.VoiceEnvelope))</b></span>
                        <span>립싱크 지연 <b>@(F1(Runner.Avatar.AvSyncDelayMs))ms</b></span>
                        <span>바이노럴 <b>@(Db(Runner.RmsOut))</b></span>
                        <span>깜빡임 <b>@(Runner.Avatar.Blinks)</b></span>
                    </div>
                </div>

                <div class="htp-card">
                    <div class="htp-sec">⚓ 공유 월드 앵커 · P2P 메시
                        <button class="htp-btn @(Runner.LinkFault ? "warn" : null)" @onclick="Runner.ToggleLinkFault">@(Runner.LinkFault ? "🔗 링크 복구" : "⚡ LA↔런던 링크 장애")</button>
                        <label class="htp-tg"><input type="checkbox" checked="@Runner.Router.DeadReckoning" @onchange="e => Runner.Router.DeadReckoning = e.Value is true" /> 데드 레커닝</label>
                    </div>
                    <table class="htp-peers">
                        <thead><tr><th>피어</th><th>앵커 정렬</th><th>요</th><th>잔차</th><th>렌더 위치(로컬)</th></tr></thead>
                        <tbody>
                            @for (var p = 0; p < Runner.Router.PeerCount; p++)
                            {
                                var rp = Runner.Router.RenderPosition(p, 0);
                                <tr>
                                    <td>@(Runner.Router.PeerName(p))</td>
                                    <td>@(Runner.Router.IsSolved(p) ? "✅" : "…")</td>
                                    <td>@(F1(Runner.Router.PeerYawDeg(p)))°</td>
                                    <td>@(F2(Runner.Router.ResidualMm(p)))mm</td>
                                    <td>@(F2(rp.X)), @(F2(rp.Y)), @(F2(rp.Z))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="htp-links">
                        @for (var a = 0; a < Runner.Router.PeerCount; a++)
                        {
                            for (var b = a + 1; b < Runner.Router.PeerCount; b++)
                            {
                                <span class="@(Runner.Router.LinkUp(a, b) ? null : "down")">@(a)↔@(b) @(Runner.Router.LinkUp(a, b) ? F0(Runner.Router.LinkLatencyMs(a, b)) + "ms" : "단절")</span>
                            }
                        }
                    </div>
                    <div class="htp-kv">
                        <span>배달 <b>@(Runner.Router.Delivered)</b></span>
                        <span>릴레이 <b>@(Runner.Router.Relayed)</b></span>
                        <span>손실 <b>@(Runner.Router.Lost)</b></span>
                        <span>최대 노후 <b>@(F0(Runner.Router.MaxStalenessMs))ms</b></span>
                        <span>예측 오차 <b>@(F1(Runner.Router.PredictionErrorMm))mm</b></span>
                        <span>앵커 잔차 <b>@(F2(Runner.Router.MeanResidualMm))mm</b></span>
                    </div>
                </div>
                <div class="htp-note">@(Runner.LastAction ?? "대기") · 실 네트워크 소켓/캡처 장치 미결선(손실 링크 시뮬레이션)</div>
            </div>
        </div>
    </div>
</div>

<style>
    .htp-scrim { position: fixed; inset: 0; z-index: var(--z-studio-modal); background: rgba(0,0,0,.62); display: flex; align-items: center; justify-content: center; padding: 20px; }
    .htp-modal { width: min(1600px, 97vw); max-height: 94vh; display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--line); border-radius: 18px; box-shadow: 0 24px 60px rgba(0,0,0,.45); overflow: hidden; }
    .htp-h { display: flex; justify-content: space-between; gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--line); background: linear-gradient(120deg, color-mix(in srgb, #06b6d4 18%, var(--card)), color-mix(in srgb, #a855f7 14%, var(--card))); }
    .htp-title { font-size: 17px; font-weight: 900; color: var(--text-primary); }
    .htp-sub { font-size: 12px; color: var(--text-secondary); margin-top: 4px; line-height: 1.5; }
    .htp-sub b { color: var(--text-primary); }
    .htp-x { background: none; border: none; color: var(--text-muted); font-size: 18px; cursor: pointer; border-radius: 8px; }
    .htp-bar { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 20px; border-bottom: 1px solid var(--line); align-items: center; }
    .htp-btn { font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 8px; border: 1px solid var(--line); background: transparent; color: var(--text-primary); cursor: pointer; }
    .htp-btn.on { background: color-mix(in srgb, #06b6d4 24%, transparent); border-color: #06b6d4; } .htp-btn.warn { border-color: #f97316; color: #fdba74; }
    .htp-chip { font: 700 11px var(--mono); padding: 4px 9px; border-radius: 999px; border: 1px solid var(--line); color: var(--text-secondary); }
    .htp-chip.ok { border-color: #22c55e; color: #86efac; } .htp-chip.warn { border-color: #f97316; color: #fdba74; }
    .htp-main { display: grid; grid-template-columns: 1.15fr 1fr; gap: 14px; padding: 14px 20px; min-height: 0; flex: 1; overflow-y: auto; }
    .htp-col { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
    .htp-card { border: 1px solid var(--line); border-radius: 12px; padding: 12px; display: flex; flex-direction: column; gap: 8px; }
    .htp-sec { font-weight: 800; font-size: 13px; color: var(--text-primary); display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .htp-sec input[type=range] { width: 140px; accent-color: #06b6d4; }
    .htp-view { width: 100%; height: 420px; border-radius: 10px; background: radial-gradient(ellipse at 50% 80%, #0e2a3a, #050b14 70%); }
    .htp-view .floor { stroke: #1e3a5f; stroke-width: .01; } .htp-view circle { opacity: .85; }
    .htp-view .bone { stroke: #67e8f9; stroke-width: .012; opacity: .7; } .htp-view .gaze { stroke: #facc15; stroke-width: .016; stroke-dasharray: .05 .03; }
    .htp-view .viewer { fill: #f472b6; } .htp-view .cam { fill: #94a3b8; } .htp-view text { font-size: .07px; fill: #cbd5e1; }
    .htp-legend { display: flex; flex-wrap: wrap; gap: 12px; font-size: 10.5px; color: var(--text-muted); }
    .htp-legend i { display: inline-block; width: 14px; height: 3px; margin-right: 4px; vertical-align: middle; } .htp-legend i.gaze { background: #facc15; } .htp-legend i.viewer { background: #f472b6; } .htp-legend i.cam { background: #94a3b8; }
    .htp-range { width: 100%; accent-color: #a855f7; }
    .htp-spec { display: grid; grid-template-columns: repeat(9, 1fr); gap: 5px; height: 110px; }
    .htp-spec div { position: relative; display: flex; align-items: flex-end; background: #0f172a; border-radius: 4px; padding: 0 4px 28px; }
    .htp-spec div.cur { outline: 2px solid #a855f7; }
    .htp-spec i { width: 100%; background: linear-gradient(0deg, #06b6d4, #a855f7); border-radius: 2px; }
    .htp-spec em { position: absolute; bottom: 14px; left: 0; right: 0; text-align: center; font: 700 10px var(--mono); color: #94a3b8; font-style: normal; }
    .htp-spec b { position: absolute; bottom: 1px; left: 0; right: 0; text-align: center; font: 700 10px var(--mono); color: var(--text-primary); }
    .htp-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .htp-slider { display: flex; flex-direction: column; gap: 2px; font-size: 11px; color: var(--text-secondary); min-width: 140px; flex: 1; }
    .htp-slider b { color: var(--text-primary); font-family: var(--mono); } .htp-slider input { width: 100%; accent-color: #06b6d4; }
    .htp-tg { font-size: 11.5px; color: var(--text-secondary); display: flex; gap: 4px; align-items: center; font-weight: 600; }
    .htp-kv { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 11px; color: var(--text-secondary); }
    .htp-kv b { color: var(--text-primary); font-family: var(--mono); }
    .htp-bs div { display: grid; grid-template-columns: 80px 1fr 40px; gap: 6px; align-items: center; font-size: 11px; color: var(--text-secondary); margin-top: 3px; }
    .htp-bs em { font-style: normal; } .htp-bs i { display: block; height: 8px; background: linear-gradient(90deg, #06b6d4, #f472b6); border-radius: 4px; } .htp-bs b { font: 700 10.5px var(--mono); color: var(--text-primary); }
    .htp-peers { width: 100%; border-collapse: collapse; font-size: 11px; }
    .htp-peers th, .htp-peers td { text-align: left; padding: 3px 6px; border-bottom: 1px solid var(--line); color: var(--text-secondary); }
    .htp-peers td { font-family: var(--mono); color: var(--text-primary); }
    .htp-links { display: flex; flex-wrap: wrap; gap: 6px; } .htp-links span { font: 700 10.5px var(--mono); padding: 2px 7px; border-radius: 999px; border: 1px solid #0e7490; color: #67e8f9; }
    .htp-links span.down { border-color: #ef4444; color: #fca5a5; }
    .htp-note { font-size: 11px; color: var(--text-muted); }
    @@media (max-width: 1200px) { .htp-main { grid-template-columns: 1fr; } }
</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private float _orbit = 25f;
    private readonly Vector3[] _joints = new Vector3[MocapSkeleton.Body];
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("Holo.Modal.Timer", ex); }
        }, null, 200, 200);
    }

    private static string F0(double v) => v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => v.ToString("0.00", CultureInfo.InvariantCulture);
    private static string F3(double v) => v.ToString("0.000", CultureInfo.InvariantCulture);
    private static float P(ChangeEventArgs e) => float.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : 0;
    private static string Db(float rms) => F0(20 * MathF.Log10(MathF.Max(rms, 1e-6f))) + " dBFS";
    private static string Rgb(Vector3 c) => "rgb(" + F0(Math.Clamp(c.X, 0f, 1f) * 255) + "," + F0(Math.Clamp(c.Y, 0f, 1f) * 255) + "," + F0(Math.Clamp(c.Z, 0f, 1f) * 255) + ")";

    /// <summary>궤도 요 회전 후 정사영(화면 y = −높이).</summary>
    private Vector2 Proj(Vector3 p)
    {
        var r = _orbit * (MathF.PI / 180f);
        return new Vector2(p.X * MathF.Cos(r) - p.Z * MathF.Sin(r), -p.Y);
    }

    /// <summary>키프레임 예상 압축률: float32(위치 12B + 속성 44B) ÷ (비트 패킹 위치 + 속성 11B + 헤더).</summary>
    private float KeyRatio(int bits)
    {
        var splats = Runner.Received.Count;
        var n = splats + Runner.Streamer.ReceivedJoints + Runner.Streamer.ReceivedMesh;
        if (n == 0) return 0;
        var raw = n * 12f + splats * 44f;
        var enc = RealtimeVolumetricHologramStreamerEngine.FrameHeader + n * 3f * bits / 8f + splats * RealtimeVolumetricHologramStreamerEngine.AttrBytes;
        return raw / enc;
    }

    private void Step() { if (!Runner.IsRunning) Runner.TickOnce(); }

    private void ToggleRun() { if (Runner.IsRunning) Runner.Stop(); else Runner.Start(); }

    private Task Close() => OnClose.InvokeAsync();

    private void OnServiceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
