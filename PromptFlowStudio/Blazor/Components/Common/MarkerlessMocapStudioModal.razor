@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private const float SrcX = 0.85f, DstX = 0.85f;
    private System.Threading.Timer? _timer;
    private double _yaw = 25, _pitch = 12;
    private float _zoom = 150f;
    private bool _showRaw = true, _showGt;

    private MarkerlessMultiViewPoseTriangulationEngine E => Runner.Engine;
    private KinematicJointLimitBonePenetrationGuard G => Runner.Guard;
    private BiomechanicalSkeletonRetargetingSynthesizer R => Runner.Retarget;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("MarkerlessMocap.Modal.Timer", ex); }
        }, null, 200, 200);
    }

    private static string F0(double v) => v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "0" : v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0.00", CultureInfo.InvariantCulture);
    private static string F3(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0.000", CultureInfo.InvariantCulture);
    private static double Num(ChangeEventArgs e, double fallback) => double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : fallback;

    /// <summary>궤도 정사영(골반 중심 · 화면 X 오프셋 = 좌/우 패널). 원점 = 각 스켈레톤 골반 수평 위치.</summary>
    private Vector2 P(Vector3 w, float panel)
    {
        var root = panel < 0 ? G.Out(0) : R.Out(0);
        var p = new Vector3(w.X - root.X, w.Y, w.Z - root.Z);
        float yaw = (float)(_yaw * Math.PI / 180), pitch = (float)(_pitch * Math.PI / 180);
        float cy = MathF.Cos(yaw), sy = MathF.Sin(yaw), cp = MathF.Cos(pitch), sp = MathF.Sin(pitch);
        var x = p.X * cy + p.Z * sy;
        var z = -p.X * sy + p.Z * cy;
        var y = p.Y * cp + z * sp;
        return new Vector2(320 + panel * 190 + x * _zoom, 345 - y * _zoom);
    }

    private string Series(Func<int, float> f, double max, double h)
    {
        var n = Runner.SeriesCount;
        if (n < 2) return "";
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = n - 1; i >= 0; i--)
            sb.Append(F1(360.0 * (n - 1 - i) / (MarkerlessMocapStudioRunner.SeriesLen - 1))).Append(',').Append(F1(h - 2 - (h - 4) * Math.Clamp(f(i) / max, 0, 1))).Append(' ');
        return sb.ToString();
    }

    private void ToggleRun() { if (Runner.IsRunning) Runner.Stop(); else Runner.Start(); }
    private void Step60() { for (var i = 0; i < MarkerlessMocapStudioRunner.Hz; i++) Runner.Step(); }

    private Task Close() => OnClose.InvokeAsync();

    /// <summary>가동 중(10 Hz 이벤트)은 200 ms 타이머가 처리 — 정지 상태 액션만 즉시 반영.</summary>
    private void OnServiceChanged() { if (!Runner.IsRunning) _ = InvokeAsync(StateHasChanged); }

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
