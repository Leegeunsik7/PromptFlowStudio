</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private const int PW = 560, PH = 300;
    private static readonly CameraMove[] Moves = { CameraMove.Follow, CameraMove.Orbit, CameraMove.Dolly, CameraMove.Crane, CameraMove.Handheld };
    private static readonly ShotScale[] Scales = { ShotScale.Wide, ShotScale.Full, ShotScale.Medium, ShotScale.MediumCloseUp, ShotScale.CloseUp };
    private string? _prompt;
    private float _isoYaw = 35f;
    private System.Threading.Timer? _timer;
    private long _urlFrame = -1;
    private string _url = "";
    private readonly StringBuilder _sb = new();

    private NeuralCameraTrajectoryEngine Tr => Runner.Trajectory;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("Cinematography.Modal.Timer", ex); }
        }, null, 200, 200);
    }

    private static string F0(double v) => v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => v.ToString("0.00", CultureInfo.InvariantCulture);
    private static string F3(double v) => v.ToString("0.000", CultureInfo.InvariantCulture);
    private static string Pc(float v) => F0(Math.Clamp(v, 0f, 1f) * 100) + "%";

    /// <summary>렌즈 출력 → BMP data URL(새 렌더 프레임일 때만 재인코딩).</summary>
    private string FrameUrl()
    {
        var rf = Runner.RenderedFrames;
        if (rf != _urlFrame && Runner.FrameWidth > 0)
        {
            _url = PromptFlowStudio.Services.Spatial.SpatialImageCodec.BmpDataUrl(Runner.Lens.Output, Runner.FrameWidth, Runner.FrameHeight);
            _urlFrame = rf;
        }
        return _url;
    }

    /// <summary>등각 투영(방위 회전 · 30° 부감).</summary>
    private Vector2 Iso(Vector3 p)
    {
        var a = _isoYaw * MathF.PI / 180f;
        float x = p.X * MathF.Cos(a) - p.Z * MathF.Sin(a), z = p.X * MathF.Sin(a) + p.Z * MathF.Cos(a);
        return new Vector2(PW * 0.5f + x * 19f, PH * 0.62f + z * 9.5f - p.Y * 17f);
    }

    private string PathPts(ReadOnlySpan<Vector3> path)
    {
        _sb.Clear();
        for (var k = 0; k < path.Length; k++) { var s = Iso(path[k]); _sb.Append(F1(s.X)).Append(',').Append(F1(s.Y)).Append(' '); }
        return _sb.ToString();
    }

    private string Hist(bool subject)
    {
        _sb.Clear();
        var n = Tr.HistoryCount;
        for (var k = 0; k < n; k += 2)
        {
            var s = Iso(subject ? Tr.SubjectHistory(k) : Tr.CameraHistory(k));
            _sb.Append(F1(s.X)).Append(',').Append(F1(s.Y)).Append(' ');
        }
        return _sb.ToString();
    }

    private static string Arc(float score)
    {
        var a = MathF.PI * (1f - Math.Clamp(score, 0f, 100f) / 100f);
        float x = 60f + 50f * MathF.Cos(a), y = 60f - 50f * MathF.Sin(a);
        return "M10,60 A50,50 0 0 1 " + F1(x) + "," + F1(y);
    }

    private static bool TryF(ChangeEventArgs e, out float v) => float.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out v);
    private void SetF(ChangeEventArgs e, Action<float> apply) { if (TryF(e, out var v)) apply(v); }

    private void Step() { for (var k = 0; k < NeuralCinematographyStudioRunner.Hz; k++) Runner.TickOnce(); }

    private void ToggleRun() { if (Runner.IsRunning) Runner.Stop(); else Runner.Start(); }

    private Task Close() => OnClose.InvokeAsync();

    private void OnServiceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
