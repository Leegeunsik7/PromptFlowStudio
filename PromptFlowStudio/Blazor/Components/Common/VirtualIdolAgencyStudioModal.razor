@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private readonly float[] _blend = new float[VrmBlend.Count];
    private CancellationTokenSource? _ui;
    private List<RecalledMemory> _recall = new();
    private int _tab, _kind = -1, _idle = 25, _vmcPort = 39539;
    private double _goal = 1_000_000;
    private long _followGoal = 1000;
    private bool _debut, _useLlm = true, _useTts = true, _demo = true, _connecting;
    private string? _sel, _msg;
    private string _nName = "", _nConcept = "", _nLore = "", _nCatch = "", _nSpeech = "밝고 다정한 반말", _query = "", _queryFan = "", _newLore = "", _twitch = "";
    private string _vmcHost = "127.0.0.1", _vtsUrl = "ws://127.0.0.1:8001", _obsUrl = "ws://127.0.0.1:4455", _obsPw = "", _tFan = "테스트팬", _tMsg = "오늘도 응원해!";
    private NarrationTone _nVoice = NarrationTone.Bright;
    private DanceStyle _nDance = DanceStyle.KPop;

    private VTuberPersona? Selected => _sel is null ? null : Memory.Find(_sel);

    protected override void OnInitialized()
    {
        Memory.OnChange += OnServiceChanged;
        Bridge.OnChange += OnServiceChanged;
        Fans.OnChange += OnServiceChanged;
        _sel = Fans.SessionPersonaId ?? Memory.Personas.FirstOrDefault()?.Id;
        _vmcHost = Bridge.VmcHost; _vmcPort = Bridge.VmcPort;
        if (Fans.InSession) SetTab(2);
    }

    private string Uptime() => Fans.Uptime.ToString(@"hh\:mm\:ss", CultureInfo.InvariantCulture);

    private static string Arc(double frac)
    {
        var f = Math.Clamp(frac, 0, 1);
        var a = Math.PI * (1 - f);
        var x = 60 + 50 * Math.Cos(a); var y = 60 - 50 * Math.Sin(a);
        return f <= 0 ? "" : "M10 60 A50 50 0 0 1 " + x.ToString("0.##", CultureInfo.InvariantCulture) + " " + y.ToString("0.##", CultureInfo.InvariantCulture);
    }

    private void Select(string id) { _sel = id; _recall.Clear(); _msg = null; }

    private void SetTab(int t)
    {
        _tab = t;
        if (t == 2) StartUi(); else StopUi();
    }

    private void Debut()
    {
        var lore = _nLore.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var cps = _nCatch.Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var p = Memory.CreatePersona(_nName, _nConcept, lore, cps, _nVoice, _nDance, string.IsNullOrWhiteSpace(_nSpeech) ? "밝고 다정한 반말" : _nSpeech);
        _sel = p.Id; _debut = false; _nName = _nConcept = _nLore = _nCatch = "";
        _msg = "🌟 " + p.Name + " 데뷔!";
    }

    private void Remove()
    {
        if (_sel is null) return;
        Memory.RemovePersona(_sel);
        _sel = Memory.Personas.FirstOrDefault()?.Id;
    }

    private void OnQueryKey(KeyboardEventArgs e) { if (e.Key == "Enter") Search(); }

    private void Search()
    {
        if (_sel is null || string.IsNullOrWhiteSpace(_query)) return;
        _recall = Memory.Recall(_sel, _query, string.IsNullOrWhiteSpace(_queryFan) ? null : _queryFan.Trim(), 8);
        if (_recall.Count == 0) _msg = "⚠ 관련 기억 없음";
    }

    private void AddLore()
    {
        if (_sel is null) return;
        Memory.AddMemory(_sel, MemoryKind.Lore, null, null, _newLore, 0, 1f);
        Memory.Save(_sel);
        _newLore = "";
    }

    private void Reset(bool keepLore)
    {
        if (_sel is null) return;
        var n = Memory.ResetMemory(_sel, keepLore);
        _recall.Clear();
        _msg = "🧹 " + n.ToString(CultureInfo.InvariantCulture) + "건 삭제" + (keepLore ? "(세계관 유지)" : "");
    }

    private void StartSession()
    {
        if (_sel is null) return;
        Bridge.VmcHost = _vmcHost.Trim(); Bridge.VmcPort = Math.Clamp(_vmcPort, 1, 65535);
        var tw = string.IsNullOrWhiteSpace(_twitch) ? null : _twitch.Trim();
        var ok = Fans.StartSession(_sel, new SessionOptions(_useLlm && Memory.LlmAvailable, _useTts, _demo, Math.Clamp(_idle, 5, 300), 2500, tw));
        _msg = ok ? "🔴 자율 방송 시작 — OBS 브라우저 소스에 오버레이 URL 을 추가하세요." : "⚠ 시작 실패";
        StartUi();
    }

    private void StopSession()
    {
        Fans.StopSession();
        Bridge.Stop();
        _msg = "⏹ 방송 종료";
    }

    private async Task ConnectVts()
    {
        if (!Uri.TryCreate(_vtsUrl, UriKind.Absolute, out var u)) { _msg = "⚠ URL 형식 오류"; return; }
        _connecting = true;
        try { var (ok, _, m) = await Bridge.ConnectVtsAsync(u); _msg = ok ? "🔗 " + m : "⚠ " + m; }
        finally { _connecting = false; }
    }

    private async Task ConnectObs()
    {
        if (!Uri.TryCreate(_obsUrl, UriKind.Absolute, out var u)) { _msg = "⚠ URL 형식 오류"; return; }
        _connecting = true;
        try { var (ok, m) = await Bridge.ConnectObsAsync(u, string.IsNullOrEmpty(_obsPw) ? null : _obsPw); _msg = ok ? "🔗 " + m : m; }
        finally { _connecting = false; _obsPw = ""; }
    }

    private void SendChat()
    {
        if (string.IsNullOrWhiteSpace(_tMsg)) return;
        Fans.ReceiveChat(new ChatMessage("ui_" + _tFan, _tFan, _tMsg));
    }

    private void Donate(int amount)
    {
        if (!Bridge.IsRunning && _sel is not null && !Fans.InSession) { _msg = "⚠ 방송 시작 후 후원 테스트가 가능합니다(오버레이/안무 송출 필요)."; return; }
        Fans.ReceiveDonation(new DonationEvent(Guid.NewGuid(), "ui_" + _tFan, _tFan, amount, "KRW", _tMsg, "test"));
    }

    private void StartUi()
    {
        if (_ui is not null) return;
        var cts = new CancellationTokenSource();
        _ui = cts;
        _ = UiLoopAsync(cts.Token);
    }

    private void StopUi()
    {
        var cts = Interlocked.Exchange(ref _ui, null);
        if (cts is null) return;
        try { cts.Cancel(); } catch (ObjectDisposedException) { }
        cts.Dispose();
    }

    private async Task UiLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(150));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (_tab != 2 || !Bridge.IsRunning) continue;
                Bridge.CopyBlend(_blend);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Program.Log("AgencyStudio.Ui", ex); }
    }

    private Task Close() => OnClose.InvokeAsync();

    private void OnServiceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Memory.OnChange -= OnServiceChanged;
        Bridge.OnChange -= OnServiceChanged;
        Fans.OnChange -= OnServiceChanged;
        StopUi();
    }
}
