@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private const float W = 720f, H = 190f;
    private readonly System.Text.StringBuilder _sb = new(1024);
    private bool _ingesting;

    private int SrcMs => Math.Max(1, Runner.Detector.DurationSec * 1000);

    protected override void OnInitialized() => Runner.OnChange += OnServiceChanged;

    private void RescueNow() => Guard(() => Runner.Rescue(), "Rescue");
    private void Reanalyze() => Guard(() => Runner.SetThresholdTenths(Runner.ThresholdTenths), "Analyze");
    private void Plus6h() => Guard(() => Runner.AdvanceHours(6), "Plus6h");
    private void ResetAll() => Guard(Runner.Reset, "Reset");
    private void RemuxNow() => Guard(() => Runner.Remux(), "Remux");

    private async Task IngestNow()
    {
        if (_ingesting) return;
        _ingesting = true;
        try { await Runner.IngestAsync(); }
        catch (Exception ex) { PromptFlowStudio.Program.Log("RetentionHeatmap.Modal.Ingest", ex); }
        finally { _ingesting = false; }
    }

    private void OnPreset(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var p)) Runner.SetPreset(p);
    }

    private void OnThreshold(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var t)) Runner.SetThresholdTenths(t);
    }

    private static string F(float v) => v.ToString("0.0", CultureInfo.InvariantCulture);
    private string X(int sec) => F(sec * W / Math.Max(1, Runner.Detector.DurationSec));
    private string Xms(int ms) => F(ms * W / SrcMs);
    private string Cell() => F(W / Math.Max(1, Runner.Detector.DurationSec) + 0.5f);
    private static string Pct(int v, int total) => (Math.Clamp(v * 100.0 / total, 0, 100)).ToString("0.00", CultureInfo.InvariantCulture) + "%";
    private static string Sec(int ms) => (ms / 1000.0).ToString("0.0", CultureInfo.InvariantCulture) + "s";

    private string Points(ReadOnlySpan<float> curve)
    {
        _sb.Clear();
        var dur = Math.Max(1, curve.Length - 1);
        for (var i = 0; i < curve.Length; i++)
        {
            if (i > 0) _sb.Append(' ');
            _sb.Append(F(i * W / dur)).Append(',').Append(F((1f - curve[i]) * H));
        }
        return _sb.ToString();
    }

    private static void Guard(Action a, string tag)
    {
        try { a(); }
        catch (Exception ex) { PromptFlowStudio.Program.Log("RetentionHeatmap.Modal." + tag, ex); }
    }

    private Task Close() => OnClose.InvokeAsync();

    private void OnServiceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Runner.OnChange -= OnServiceChanged;
}
