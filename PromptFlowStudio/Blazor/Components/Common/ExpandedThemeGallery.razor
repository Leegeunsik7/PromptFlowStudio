@inject BabyThemeDatabase Db
@inject ThemeInstantGeneratorService Instant
@inject ThemeSearchFilterService Search
@inject ThemePinService Pins
@inject SmartThemeMatcherService Matcher
@inject CustomThemeRegistryService Custom
@implements IDisposable

@* [PromptFlow Studio] 아기 테마 백과사전 — 10대 카테고리 탭 + 소분류 테마 카드 + 숏츠/롱폼 포맷 토글.
   선택 후 [✨ 자동 구성] 시 부모(Storyboard)가 VideoFormatFactory 로 포맷에 맞는 스토리보드를 즉시 생성. *@
<div class="eg-scrim" @onclick="OnCloseClick">
    <div class="eg-modal" @onclick:stopPropagation="true">
        <div class="eg-h">
            <div class="eg-h-txt">
                <div class="eg-title">📚 아기 테마 백과사전 <span class="eg-badge">@(Db.AllThemes.Count)개 테마</span> <HelpBadge Topic="@HelpContentService.Keys.BabyThemes" /></div>
                <div class="eg-sub">@(Db.Categories.Count)대 카테고리 × @(Db.AllThemes.Count)종 소분류 테마(🎠놀이터·🎈키즈카페·🎡놀이공원·🌿일상 나들이 포함). 사진 1장 + 테마 + <b>포맷</b>만 고르면 대본·프롬프트·키네틱·텐션·폴리가 자동 완성됩니다.</div>
            </div>
            <button class="eg-btn ghost eg-studio" @onclick="() => OpenEditor(null)" title="직접 테마를 만들고 .pftheme 로 공유">🛠️ 커스텀 테마 만들기</button>
            <button class="eg-x" @onclick="OnCloseClick" title="닫기">✕</button>
        </div>

        @* ── 포맷 토글: 숏츠 vs 롱폼(브이로그) ── *@
        <div class="eg-fmt">
            <div class="eg-seg">
                <button class="eg-segbtn @(_format == VideoFormat.Shorts ? "on" : null)" @onclick="() => _format = VideoFormat.Shorts">📱 숏츠 모드</button>
                <button class="eg-segbtn @(_format == VideoFormat.Longs ? "on" : null)" @onclick="() => _format = VideoFormat.Longs">🖥️ 롱폼(브이로그) 모드</button>
            </div>
            <HelpBadge Topic="@HelpContentService.Keys.FormatSwitch" />
            <div class="eg-fmt-note">@FormatNote</div>
        </div>

        @if (!HasAnchor)
        {
            <div class="eg-warn">💡 <b>팁:</b> 먼저 <b>[⚓ 메인 캐릭터/스타일 앵커]</b>에 아기 사진을 등록하면 그 아기의 특징을 유지한 채(전 컷 i2v) 적용됩니다. 사진 없이도 구성은 가능해요.</div>
        }

        <div class="eg-search">
            <ThemeSearchBar Query="@_query" QueryChanged="OnQuery" ResultCount="@Search.Count(Db.AllThemes, _query)" TotalCount="Db.AllThemes.Count"
                            Placeholder="아기 테마·연출 키워드 검색 (레몬, 요정, 백일, 우주…)" />
        </div>

        @* v16.7.0 💡 앵커 사진 색감/구도 → 추천 테마 퀵 칩 *@
        @if (_reco.Count > 0)
        {
            <div class="eg-reco">
                <span class="eg-reco-h">💡 이 사진에 추천하는 테마</span>
                @foreach (var r in _reco)
                {
                    <button class="eg-reco-chip @(_selectedKey == r.Key ? "on" : null)" @onclick="() => PickRecommended(r.Key)" title="@r.Reason" @key="r.Key">
                        <span>@r.Emoji</span> @r.Title <em>@r.Reason</em>
                    </button>
                }
            </div>
        }

        <div class="eg-body">
            @* ── 좌: 카테고리 탭 ── *@
            <div class="eg-tabs">
                @foreach (var c in Db.Categories)
                {
                    <button class="eg-tab @(_activeCat == c.Key ? "on" : null)" @onclick="() => _activeCat = c.Key" @key="c.Key">
                        <span class="eg-tab-emoji">@c.Emoji</span>
                        <span class="eg-tab-name">@c.Name</span>
                        <span class="eg-tab-cnt">@(c.Themes.Count)</span>
                    </button>
                }
            </div>

            @* ── 우: 소분류 테마 카드 ── *@
            <div class="eg-cards">
                <div class="eg-cards-h">@(Searching ? "🔍 검색 결과" : $"{ActiveCat.Emoji} {ActiveCat.Name}") <span class="eg-cards-desc">@(Searching ? $"\"{_query}\" · {DisplayThemes.Count}종" : ActiveCat.Desc)</span></div>
                <div class="eg-grid" @key="GridKey">
                    @if (DisplayThemes.Count == 0) { <div class="eg-none">🔍 "@_query" 검색 결과가 없습니다.</div> }
                    @{ var idx = 0; }
                    @foreach (var t in DisplayThemes)
                    {
                        <div class="eg-card @(_selectedKey == t.Key ? "on" : null)" style="@Stagger(idx++)" @key="t.Key">
                            <button class="eg-pin @(Pins.IsPinned(t.Key) ? "on" : null)" @onclick="() => Pins.Toggle(t.Key)" @onclick:stopPropagation="true" title="즐겨찾기 고정">📌</button>
                            <button class="eg-cardbtn" @onclick="() => _selectedKey = t.Key">
                                <div class="eg-thumb" style="@ThumbStyle(t.CategoryKey)"><span>@t.Emoji</span></div>
                                <div class="eg-info">
                                    <div class="eg-name">@t.Title</div>
                                    <div class="eg-hook">@t.Hook</div>
                                    <div class="eg-ex">@t.Example</div>
                                    <ThemeCinematicBadges Cine="@t.Cinematics" Expanded="@(_selectedKey == t.Key)" />
                                </div>
                                @if (_selectedKey == t.Key) { <div class="eg-check">✓</div> }
                            </button>
                            @if (Custom.IsCustom(t.Key))
                            {
                                <button class="eg-edit" @onclick="() => OpenEditor(t.Key)" @onclick:stopPropagation="true" title="커스텀 테마 편집">✏️</button>
                            }
                            <div class="eg-tip">@foreach (var line in ThemePreviewBuilder.BuildLines(t)) { <div class="eg-tip-l">@line</div> }</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (_offer)
        {
            <div class="eg-offer">
                <div class="eg-offer-txt">
                    <b>👶 @_readiness.Headline</b>
                    <span>@_readiness.Detail</span>
                </div>
                <div class="eg-offer-btns">
                    <label class="eg-btn run">📁 사진 선택 후 시작<InputFile class="eg-hidden-input" OnChange="OnPhotoPicked" accept="image/*" /></label>
                    <button class="eg-btn go" @onclick="StartT2v">텍스트(T2V)로 바로 시작</button>
                    <button class="eg-btn ghost" @onclick="() => _offer = false">취소</button>
                </div>
            </div>
        }

        @if (_editorOpen)
        {
            <CustomThemeEditorModal InitialKey="@_editorKey" OnClose="() => _editorOpen = false" OnSaved="OnCustomSaved" />
        }

        @* v5.3.5: 초개인화 아기 하이퍼 스튜디오는 상단 [✨ 아기 하이퍼 스튜디오] 전용 모달로 분리(테마 백과사전 혼잡 완화). *@

        <div class="eg-foot">
            <div class="eg-foot-note">
                @if (Selected is { } sel)
                {
                    <span>선택: <b>@sel.Emoji @sel.Title</b> · @sel.Cinematics.CameraChip.Icon @sel.Cinematics.CameraChip.Label · @sel.Cinematics.LightingLabel · <b>@FormatLabel @(CutCount)컷</b> 자동 생성 · 스마트 트랜지션·키네틱·감정선 BGM·폴리 ON</span>
                }
                else { <span>카테고리 탭에서 테마를 선택하세요.</span> }
            </div>
            <div class="eg-foot-btns">
                <button class="eg-btn ghost" @onclick="OnCloseClick">취소</button>
                <button class="eg-btn go" @onclick="Apply" disabled="@(_selectedKey is null)">✨ 이 테마로 @FormatLabel 자동 구성</button>
                <button class="eg-btn run" @onclick="OnRunClick" disabled="@(_selectedKey is null)" title="아기 사진 레퍼런스 연동 + 테마 구성 + 제작을 한 번에 시작합니다">🚀 이 테마로 즉시 생성 시작</button>
            </div>
        </div>
    </div>
</div>

<style>
    .eg-scrim{position:fixed; inset:0; z-index:var(--z-studio-modal); background:rgba(0,0,0,.55); display:flex; align-items:center; justify-content:center; padding:20px}
    .eg-modal{width:min(1200px,97vw); max-height:92vh; display:flex; flex-direction:column; background:var(--card); border:1px solid var(--line); border-radius:18px; box-shadow:0 24px 60px rgba(0,0,0,.4); overflow:hidden}
    .eg-h{display:flex; align-items:flex-start; justify-content:space-between; gap:12px; padding:18px 20px 14px; border-bottom:1px solid var(--line)}
    .eg-title{font-size:17px; font-weight:900; color:var(--text-primary); display:flex; align-items:center; gap:9px}
    .eg-badge{font:700 10.5px var(--mono); color:var(--accent-2); background:color-mix(in srgb,var(--accent-2) 12%,transparent); border:1px solid color-mix(in srgb,var(--accent-2) 30%,var(--line)); border-radius:20px; padding:3px 9px}
    .eg-sub{font-size:12px; color:var(--text-secondary); margin-top:4px; line-height:1.55; max-width:66ch} .eg-sub b{color:var(--text-primary)}
    .eg-x{flex:0 0 auto; width:30px; height:30px; border:none; background:none; color:var(--text-muted); cursor:pointer; font-size:15px; border-radius:8px}
    .eg-x:hover{background:var(--card-2); color:var(--text-primary)}
    /* 최상단 소스 토글(아기 ↔ B2B) */
    .eg-source{display:flex; gap:6px; padding:12px 20px 0}
    .eg-srcbtn{flex:1; font:800 13px inherit; padding:11px 14px; border-radius:12px; border:1px solid var(--line); background:var(--card-2); color:var(--text-secondary); cursor:pointer}
    .eg-srcbtn:hover{border-color:var(--accent); color:var(--text-primary)}
    .eg-srcbtn.on{color:#fff; border-color:transparent; background:linear-gradient(135deg,var(--flow-violet),var(--flow-magenta)); box-shadow:0 4px 14px color-mix(in srgb,var(--flow-magenta) 24%,transparent)}
    .eg-srcbtn.b2b.on{background:linear-gradient(135deg,#0ea5e9,#6366f1); box-shadow:0 4px 14px color-mix(in srgb,#6366f1 26%,transparent)}
    .eg-warn.b2b{background:color-mix(in srgb,#6366f1 10%,var(--card-2)); border-color:color-mix(in srgb,#6366f1 34%,var(--line))}
    /* 포맷 토글 */
    .eg-fmt{display:flex; align-items:center; gap:14px; padding:12px 20px; border-bottom:1px solid var(--line); flex-wrap:wrap}
    .eg-seg{display:inline-flex; background:var(--card-2); border:1px solid var(--line); border-radius:12px; padding:3px; gap:3px}
    .eg-segbtn{font:800 12.5px inherit; padding:8px 15px; border-radius:9px; border:none; background:none; color:var(--text-secondary); cursor:pointer; white-space:nowrap}
    .eg-segbtn.on{color:#fff; background:linear-gradient(135deg,var(--flow-violet),var(--flow-magenta)); box-shadow:0 4px 12px color-mix(in srgb,var(--flow-magenta) 24%,transparent)}
    .eg-fmt-note{font-size:11.5px; color:var(--text-muted); line-height:1.45; flex:1; min-width:220px}
    .eg-warn{margin:12px 18px 0; padding:10px 13px; border-radius:10px; font-size:12px; line-height:1.55; color:var(--text-secondary);
        background:color-mix(in srgb,#f5a623 10%,var(--card-2)); border:1px solid color-mix(in srgb,#f5a623 34%,var(--line))} .eg-warn b{color:var(--text-primary)}
    /* 본문: 좌 탭 + 우 카드 */
    .eg-body{display:flex; gap:0; flex:1; min-height:0; padding:14px 18px}
    .eg-tabs{flex:0 0 220px; min-width:220px; display:flex; flex-direction:column; gap:4px; overflow-y:auto; padding-right:12px; border-right:1px solid var(--line)}
    .eg-tab{display:flex; align-items:center; gap:9px; text-align:left; padding:10px 11px; border-radius:11px; border:1px solid transparent; background:none; color:var(--text-secondary); cursor:pointer; font-family:inherit}
    .eg-tab:hover{background:var(--card-2)}
    .eg-tab.on{background:color-mix(in srgb,var(--accent) 10%,var(--card-2)); border-color:color-mix(in srgb,var(--accent) 40%,var(--line)); color:var(--text-primary)}
    .eg-tab-emoji{font-size:17px; flex:0 0 auto}
    .eg-tab-name{font-size:12.5px; font-weight:800; flex:1; min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
    .eg-tab-cnt{font:700 10px var(--mono); color:var(--text-muted); background:var(--card); border:1px solid var(--line); border-radius:20px; padding:1px 7px}
    .eg-cards{flex:1; min-width:0; display:flex; flex-direction:column; padding-left:16px; overflow:hidden}
    .eg-cards-h{font-size:13px; font-weight:800; color:var(--text-primary); padding:2px 2px 10px; display:flex; align-items:baseline; gap:9px; flex-wrap:wrap}
    .eg-cards-desc{font-size:11.5px; font-weight:600; color:var(--text-muted)}
    .eg-grid{display:grid; grid-template-columns:1fr 1fr; gap:10px; overflow-y:auto; padding-right:4px; align-content:start}
    @@media(max-width:720px){.eg-body{flex-direction:column} .eg-tabs{flex:0 0 auto; min-width:0; flex-direction:row; overflow-x:auto; border-right:none; border-bottom:1px solid var(--line); padding:0 0 10px} .eg-tab{flex:0 0 auto} .eg-tab-name{display:none} .eg-cards{padding-left:0; padding-top:12px} .eg-grid{grid-template-columns:1fr}}
    .eg-card{position:relative; border-radius:13px; border:1px solid var(--line); background:var(--card-2); transition:border-color .12s}
    .eg-card:hover{border-color:var(--accent)}
    .eg-card.on{border-color:transparent; box-shadow:0 0 0 2px var(--accent); background:color-mix(in srgb,var(--accent) 8%,var(--card-2))}
    .eg-cardbtn{display:flex; gap:11px; width:100%; text-align:left; padding:10px; background:none; border:none; cursor:pointer; font-family:inherit}
    .eg-pin{position:absolute; top:7px; left:8px; z-index:2; width:22px; height:22px; border:none; border-radius:7px; background:var(--card); color:var(--text-muted); cursor:pointer; font-size:11px; opacity:.5}
    .eg-pin:hover{opacity:1} .eg-pin.on{opacity:1; color:#fbbf24; background:color-mix(in srgb,#fbbf24 16%,var(--card))}
    .eg-none{grid-column:1 / -1; font:600 11.5px var(--mono); color:var(--text-muted); padding:22px 8px; text-align:center}
    .eg-search{padding:0 18px}
    .eg-tip{position:absolute; left:8px; right:8px; top:calc(100% - 4px); z-index:20; display:none; background:#0b0d14; border:1px solid color-mix(in srgb,var(--accent) 45%,var(--line)); border-radius:10px; padding:9px 11px; box-shadow:0 12px 30px rgba(0,0,0,.5)}
    .eg-card:hover .eg-tip{display:block}
    .eg-tip-l{font:600 10.5px var(--mono); color:var(--text-secondary); line-height:1.5}
    /* v16.7.0 하이엔드 Glassmorphism 인스펙터 · 추천 칩 · 필터 반응 애니메이션 */
    .eg-card{animation:egIn .32s cubic-bezier(.2,.8,.2,1) both}
    .eg-card:hover{transform:translateY(-2px); box-shadow:0 10px 26px rgba(0,0,0,.18)}
    .eg-card{transition:border-color .12s, transform .18s, box-shadow .18s}
    @@keyframes egIn{from{opacity:0; transform:translateY(8px) scale(.985)} to{opacity:1; transform:none}}
    @@keyframes egChip{from{opacity:0; transform:scale(.9)} to{opacity:1; transform:none}}
    @@media(prefers-reduced-motion:reduce){.eg-card,.eg-reco-chip{animation:none}}
    .eg-studio{margin-left:auto; align-self:center; white-space:nowrap}
    .eg-edit{position:absolute; top:7px; right:34px; z-index:2; width:24px; height:24px; border-radius:7px; border:1px solid var(--line); background:var(--card); cursor:pointer; font-size:11px}
    .eg-edit:hover{border-color:var(--accent)}
    .eg-reco{display:flex; align-items:center; gap:7px; flex-wrap:wrap; margin:0 16px 10px; padding:9px 12px; border-radius:13px;
        background:linear-gradient(135deg,color-mix(in srgb,var(--flow-violet) 14%,transparent),color-mix(in srgb,var(--flow-magenta) 10%,transparent));
        border:1px solid color-mix(in srgb,var(--accent) 30%,var(--line)); backdrop-filter:blur(10px) saturate(1.3); -webkit-backdrop-filter:blur(10px) saturate(1.3)}
    .eg-reco-h{font-size:12px; font-weight:800; color:var(--text-primary); margin-right:3px}
    .eg-reco-chip{display:inline-flex; align-items:center; gap:5px; font:700 12px inherit; padding:5px 11px; border-radius:999px; cursor:pointer; color:var(--text-primary);
        background:color-mix(in srgb,var(--card) 62%,transparent); border:1px solid rgba(255,255,255,.22); animation:egChip .3s ease both; transition:transform .15s, box-shadow .15s}
    .eg-reco-chip:hover{transform:translateY(-1px); box-shadow:0 4px 14px color-mix(in srgb,var(--accent) 30%,transparent)}
    .eg-reco-chip.on{box-shadow:0 0 0 2px var(--accent)}
    .eg-reco-chip em{font-style:normal; font-weight:600; font-size:10.5px; color:var(--text-muted)}
    .tci{display:flex; flex-wrap:wrap; gap:4px; margin-top:6px; max-height:20px; overflow:hidden; transition:max-height .25s ease}
    .eg-card:hover .tci, .tci.open{max-height:80px}
    .tci-b{display:inline-flex; align-items:center; gap:3px; font:700 10px var(--mono); padding:2px 7px; border-radius:999px; white-space:nowrap; color:var(--text-secondary);
        background:color-mix(in srgb,var(--card) 55%,transparent); border:1px solid rgba(255,255,255,.18); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px)}
    .tci-b.cam{color:var(--text-primary); border-color:color-mix(in srgb,var(--accent) 40%,transparent)}
    .tci-b.sfx i{font-style:normal}
    .tci-mot-l{font-size:8.5px; letter-spacing:.06em; color:var(--text-muted); margin-right:2px}
    .tci-dot{width:6px; height:6px; border-radius:50%; background:color-mix(in srgb,var(--text-muted) 35%,transparent)}
    .tci-dot.on{background:linear-gradient(135deg,var(--flow-violet),var(--flow-magenta)); box-shadow:0 0 6px color-mix(in srgb,var(--flow-magenta) 55%,transparent)}
    .eg-thumb{flex:0 0 auto; width:52px; height:52px; border-radius:11px; display:grid; place-items:center; font-size:25px; border:1px solid rgba(255,255,255,.22); margin-left:20px}
    .eg-info{min-width:0; flex:1}
    .eg-name{font-size:13.5px; font-weight:800; color:var(--text-primary)}
    .eg-hook{font-size:11.5px; color:var(--accent-2); margin-top:3px; line-height:1.4}
    .eg-ex{font-size:11px; color:var(--text-muted); margin-top:3px; line-height:1.42; overflow:hidden; text-overflow:ellipsis; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical}
    .eg-check{position:absolute; top:8px; right:9px; width:19px; height:19px; border-radius:50%; background:var(--accent); color:#fff; display:grid; place-items:center; font-size:11px; font-weight:900}
    .eg-foot{display:flex; align-items:center; justify-content:space-between; gap:12px; padding:13px 18px; border-top:1px solid var(--line); flex-wrap:wrap}
    .eg-foot-note{font-size:12px; color:var(--text-secondary); flex:1; min-width:220px} .eg-foot-note b{color:var(--text-primary)}
    .eg-foot-btns{display:flex; gap:8px}
    .eg-btn{font:800 13px inherit; padding:10px 16px; border-radius:11px; cursor:pointer; border:1px solid var(--line); background:var(--card-2); color:var(--text-secondary)}
    .eg-btn.ghost:hover{border-color:var(--accent); color:var(--text-primary)}
    .eg-btn.go{border:none; color:#fff; background:linear-gradient(135deg,var(--flow-violet),var(--flow-magenta)); box-shadow:0 6px 16px color-mix(in srgb,var(--flow-magenta) 26%,transparent)}
    .eg-btn.go:hover:not(:disabled){filter:brightness(1.07)} .eg-btn.go:disabled{opacity:.45; cursor:not-allowed; box-shadow:none}
    .eg-btn.run{border:none; color:#fff; background:linear-gradient(135deg,#f5a623,#ff6b6b); box-shadow:0 6px 16px color-mix(in srgb,#ff6b6b 28%,transparent)}
    .eg-btn.run:hover:not(:disabled){filter:brightness(1.07)} .eg-btn.run:disabled{opacity:.45; cursor:not-allowed; box-shadow:none}
    /* 즉시 생성 — 사진 등록 제안 배너 */
    .eg-offer{display:flex; align-items:center; justify-content:space-between; gap:14px; flex-wrap:wrap; margin:0 18px; padding:12px 15px; border-radius:12px;
        background:linear-gradient(135deg,color-mix(in srgb,#f5a623 12%,var(--card-2)),color-mix(in srgb,#ff6b6b 8%,var(--card-2))); border:1px solid color-mix(in srgb,#f5a623 34%,var(--line))}
    .eg-offer-txt{display:flex; flex-direction:column; gap:3px; min-width:220px; flex:1}
    .eg-offer-txt b{font-size:13px; color:var(--text-primary)} .eg-offer-txt span{font-size:11.5px; color:var(--text-secondary); line-height:1.5}
    .eg-offer-btns{display:flex; gap:8px; flex-wrap:wrap}
    .eg-offer-btns .eg-btn{position:relative; overflow:hidden}
    .eg-hidden-input{position:absolute; inset:0; width:100%; height:100%; opacity:0; cursor:pointer}
</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<(string Key, VideoFormat Format)> OnApply { get; set; }
    /// <summary>즉시 생성(레퍼런스 연동 + 테마 + 원스톱 실행) 요청 — 부모(Storyboard)가 등록/적용/시작을 수행.</summary>
    [Parameter] public EventCallback<ThemeInstantRequest> OnInstantStart { get; set; }
    /// <summary>등록된 아기 얼굴 앵커 유무.</summary>
    [Parameter] public bool HasAnchor { get; set; }
    /// <summary>생성 엔진(Wan API 키) 준비 여부 — 즉시 생성 사전 점검.</summary>
    [Parameter] public bool EngineReady { get; set; }
    /// <summary>v16.7.0 앵커 이미지 로컬 경로 — 있으면 스마트 매처가 추천 칩(상위 3)을 노출.</summary>
    [Parameter] public string? AnchorPath { get; set; }

    private IReadOnlyList<ThemeMatch> _reco = Array.Empty<ThemeMatch>();
    private string? _recoFor;

    protected override void OnParametersSet()
    {
        if (string.Equals(_recoFor, AnchorPath, StringComparison.OrdinalIgnoreCase)) return;
        _recoFor = AnchorPath;
        try { _reco = Matcher.RecommendForImage(AnchorPath); }
        catch (Exception ex) { _reco = Array.Empty<ThemeMatch>(); PromptFlowStudio.Program.Log("ExpandedThemeGallery.Recommend", ex); }
    }

    private void PickRecommended(string key)
    {
        _selectedKey = key;
        _query = "";
        if (Db.CategoryOf(key) is { } c) _activeCat = c.Key;
    }

    // 필터/카테고리 변경 시 그리드 재마운트 → 카드 진입 애니메이션 재생(스태거 지연은 사전 생성 문자열 · 렌더마다 포맷 0).
    private string GridKey => Searching ? "q:" + _query : "c:" + _activeCat;
    private static readonly string[] StaggerStyles = BuildStagger();
    private static string[] BuildStagger()
    {
        var a = new string[13];
        for (var i = 0; i < a.Length; i++) a[i] = "animation-delay:" + (i * 28).ToString(System.Globalization.CultureInfo.InvariantCulture) + "ms";
        return a;
    }
    private static string Stagger(int i) => StaggerStyles[Math.Min(i, StaggerStyles.Length - 1)];

    private string _activeCat = "food";
    private string? _selectedKey;
    private string _query = "";
    private VideoFormat _format = VideoFormat.Shorts;

    private bool _offer;
    private InstantReadiness _readiness = new(InstantAction.OfferPhoto, false, true, "", "", "");

    // v3.1.0 검색: 질의 있으면 전 카테고리 교차 필터, 없으면 활성 카테고리. 즐겨찾기 우선.
    private bool Searching => !string.IsNullOrWhiteSpace(_query);
    private IReadOnlyList<BabyThemeDef> DisplayThemes => Searching
        ? Pins.SortPinnedFirst(Search.Filter(Db.AllThemes, _query))
        : Pins.SortPinnedFirst(ActiveCat.Themes);

    protected override void OnInitialized() { Pins.OnChange += OnPins; Custom.OnChange += OnPins; }
    private void OnPins() => InvokeAsync(StateHasChanged);
    private void OnQuery(string q) => _query = q ?? "";
    public void Dispose() { Pins.OnChange -= OnPins; Custom.OnChange -= OnPins; }

    // ── v16.8.0 🛠️ 커스텀 테마 저작도구 ──
    private bool _editorOpen;
    private string? _editorKey;
    private void OpenEditor(string? key) { _editorKey = key; _editorOpen = true; }
    private void OnCustomSaved(string key)
    {
        _selectedKey = key;
        _query = "";
        _activeCat = CustomThemeRegistryService.CategoryKey;
        _recoFor = null;   // 병합 후 추천 재계산(커스텀도 동일 알고리즘)
        OnParametersSet();
    }

    private BabyCategory ActiveCat => Db.Categories.FirstOrDefault(c => c.Key == _activeCat) ?? Db.Categories[0];
    private BabyThemeDef? Selected => _selectedKey is null ? null : Db.Get(_selectedKey);
    private int CutCount => VideoFormatFactory.CutCountOf(_format);
    private string FormatLabel => _format == VideoFormat.Shorts ? "숏츠" : "롱폼";

    private string FormatNote => _format == VideoFormat.Shorts
        ? "6컷 · 세로 1080×1920 · 빠른 배속 · 3초 반전 무한 루프 · 급상승 스파이크 텐션"
        : $"{VideoFormatFactory.LongsCuts}컷 · 가로 1920×1080 · 원본 배속 · 기승전결 서사 · 완만한 빌드업 · 인트로/아웃트로 포함";

    private async Task OnCloseClick() => await OnClose.InvokeAsync();

    private async Task Apply()
    {
        if (_selectedKey is null) return;
        await OnApply.InvokeAsync((_selectedKey, _format));
    }

    // ── [🚀 즉시 생성] 사전 점검 → 앵커 있으면 바로 진행, 없으면 사진 등록 제안(또는 T2V) ──
    private async Task OnRunClick()
    {
        if (_selectedKey is null) return;
        _readiness = Instant.Evaluate(HasAnchor, EngineReady);
        if (_readiness.Action == InstantAction.OfferPhoto) { _offer = true; return; }   // 사진 등록 제안 배너 노출
        await OnInstantStart.InvokeAsync(new ThemeInstantRequest(_selectedKey, _format, null, false));   // Proceed/NoEngine → 부모가 처리
    }

    private async Task OnPhotoPicked(InputFileChangeEventArgs e)
    {
        if (_selectedKey is null) return;
        _offer = false;
        await OnInstantStart.InvokeAsync(new ThemeInstantRequest(_selectedKey, _format, e.File, false));   // 사진 등록 + 즉시 생성
    }

    private async Task StartT2v()
    {
        if (_selectedKey is null) return;
        _offer = false;
        await OnInstantStart.InvokeAsync(new ThemeInstantRequest(_selectedKey, _format, null, true));       // T2V 폴백 즉시 생성
    }

    // 카테고리별 썸네일 그라데이션(밝은 자연광 톤).
    private static string ThumbStyle(string catKey) => catKey switch
    {
        "food"     => "background:linear-gradient(135deg,#fff1b8,#ffd23f)",
        "sleep"    => "background:linear-gradient(135deg,#dfeaff,#b7c9f0)",
        "body"     => "background:linear-gradient(135deg,#ffe0e0,#ff9f9f)",
        "emotion"  => "background:linear-gradient(135deg,#ffe6f2,#ffb3d6)",
        "outdoor"  => "background:linear-gradient(135deg,#dcf7e6,#a6e6c3)",
        "daily"    => "background:linear-gradient(135deg,#d9f5ff,#8fd8ef)",
        "costume"  => "background:linear-gradient(135deg,#ece4ff,#c3b4f0)",
        "family"   => "background:linear-gradient(135deg,#ffeccf,#ffcf9a)",
        "mischief" => "background:linear-gradient(135deg,#e7ecf3,#b9c3d1)",
        "special"  => "background:linear-gradient(135deg,#ffe1ec,#ffc0d4)",
        CustomThemeRegistryService.CategoryKey  => "background:linear-gradient(135deg,#efe7ff,#ffd6ec)",
        BabyEverydayThemeDatabase.Playground    => "background:linear-gradient(135deg,#fff4d6,#ffc96b)",
        BabyEverydayThemeDatabase.KidsCafe      => "background:linear-gradient(135deg,#ffe3f1,#c9b8ff)",
        BabyEverydayThemeDatabase.AmusementPark => "background:linear-gradient(135deg,#ffe0e6,#ffb38a)",
        BabyEverydayThemeDatabase.Everyday      => "background:linear-gradient(135deg,#e4f8e0,#9edfb5)",
        _          => "background:linear-gradient(135deg,#fff1b8,#ffd23f)",
    };
}
