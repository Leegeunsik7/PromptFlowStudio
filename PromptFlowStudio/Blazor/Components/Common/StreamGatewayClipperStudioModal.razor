@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private readonly byte[] _bmp = new byte[StreamGatewayClipperStudioRunner.PreviewBytes];
    private readonly string[] _ids = { "", "", "" };
    private System.Threading.Timer? _timer;
    private string _img = "";
    private string? _saved;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("Gateway.Modal.Timer", ex); }
        }, null, 200, 200);
    }

    protected override bool ShouldRender()
    {
        Runner.WritePreviewBmp(_bmp);
        _img = _bmp[1] == (byte)'M' ? "data:image/bmp;base64," + Convert.ToBase64String(_bmp) : "";
        return true;
    }

    private static string F0(double v) => double.IsFinite(v) ? v.ToString("0", CultureInfo.InvariantCulture) : "—";
    private static string F1(double v) => double.IsFinite(v) ? v.ToString("0.0", CultureInfo.InvariantCulture) : "—";
    private static string F2(double v) => double.IsFinite(v) ? v.ToString("0.00", CultureInfo.InvariantCulture) : "—";
    private static string Pct(float v) => Math.Clamp(v * 100.0, 0, 100).ToString("0.#", CultureInfo.InvariantCulture);
    private static string PlatIcon(ChatPlatform p) => p switch { ChatPlatform.Twitch => "🟣", ChatPlatform.YouTube => "🔴", _ => "🟢" };
    private static string Hint(ChatPlatform p) => p switch { ChatPlatform.Twitch => "채널명", ChatPlatform.YouTube => "videoId(PF_YOUTUBE_API_KEY)", _ => "채널 ID" };

    private double KeyX(long index)
    {
        var newest = Runner.Ring.NewestVideo;
        var span = 30.0 * Math.Max(1, Runner.Ring.Fps);
        return Math.Clamp(600 - 600 * (newest - index) / span, 0, 600);
    }

    private string Series(int kind)
    {
        var n = Runner.SeriesCount;
        if (n < 2) return "";
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = 0; i < n; i++)
        {
            var k = n - 1 - i;
            var v = kind switch { 0 => Runner.RateSeries(k) / 1000.0, 1 => Runner.DropSeries(k) / 30.0, _ => Runner.FrameMsSeries(k) / 33.4 };
            sb.Append((600.0 * i / (n - 1)).ToString("0.#", CultureInfo.InvariantCulture)).Append(',').Append((58 - 56 * Math.Clamp(v, 0, 1)).ToString("0.#", CultureInfo.InvariantCulture)).Append(' ');
        }
        return sb.ToString();
    }

    private void OnRate(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var v)) Runner.SetTrafficRate(v / 10f); }
    private void OnSec(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var v)) Runner.SetClipSeconds(v); }

    private async Task ConnectLive(ChatPlatform p) => await Runner.ConnectLiveAsync(p, _ids[(int)p]);

    private void Clip() => Runner.ClipNow(Runner.ClipSeconds);

    private void Save(int id) => _saved = Runner.SaveClip(id) ?? "저장 실패";

    private void ToggleRun()
    {
        if (Runner.IsRunning) Runner.Stop(); else Runner.Start();
    }

    private void ToggleEncoder()
    {
        if (Runner.IsEncoding) Runner.StopEncoder(); else Runner.StartEncoder();
    }

    private Task Close() => OnClose.InvokeAsync();

    private void OnServiceChanged()
    {
        if (!Runner.IsRunning) _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
    }
}
