@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private System.Threading.Timer? _timer;

    private RealtimeAcesColorTransformEngine E => Runner.Engine;
    private OnSetLiveDitGradingColorDecisionSynthesizer S => Runner.Synth;
    private LedSpectralMetamerismGamutClippingGuard G => Runner.Guard;

    /// <summary>스킨 톤 라인(벡터스코프 · Cb/Cr 평면 약 123°).</summary>
    private static readonly double SkinAngle = Math.PI * 123.0 / 180.0;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("LiveDitColor.Modal.Timer", ex); }
        }, null, 300, 300);
    }

    private static string F0(double v) => v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0.00", CultureInfo.InvariantCulture);
    private static string F3(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0.000", CultureInfo.InvariantCulture);
    private static double Num(ChangeEventArgs e, double fallback) => double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : fallback;

    private static string WheelName(int w) => w switch { 0 => "Lift (Offset)", 1 => "Gamma (Power)", _ => "Gain (Slope)" };
    private static string WheelMin(int w) => w == 0 ? "-0.1" : "0.5";
    private static string WheelMax(int w) => w == 0 ? "0.1" : "2";

    private void WheelClick(int w, MouseEventArgs e)
    {
        float x = (float)((e.OffsetX - 55) / 55.0), y = (float)(-(e.OffsetY - 55) / 55.0);
        Runner.SetWheel(w, x, y, S.Wheel(w).Master);
    }

    /// <summary>75% 컬러 바 타깃(Cb/Cr → SVG · 반경 63 = |0.5|).</summary>
    private static void Target(int t, out double x, out double y)
    {
        double r = t is 0 or 1 or 5 ? 0.75 : 0, g = t is 3 or 4 or 5 ? 0.75 : 0, b = t is 1 or 2 or 3 ? 0.75 : 0;   // R · Mg · B · Cy · G · Yl
        var l = 0.2126 * r + 0.7152 * g + 0.0722 * b;
        double cb = (b - l) / 1.8556, cr = (r - l) / 1.5748;
        x = cb * 126; y = -cr * 126;
    }

    private string PatchCss(int p)
    {
        float r = G.PatchRef(p, 0), g = G.PatchRef(p, 1), b = G.PatchRef(p, 2);
        E.Matrix(AcesSpace.AcesCg, AcesSpace.Rec709).Transform(ref r, ref g, ref b);
        return "rgb(" + F0(Math.Clamp(AcesColorMath.Bt1886Inverse(r) * 255, 0, 255)) + "," + F0(Math.Clamp(AcesColorMath.Bt1886Inverse(g) * 255, 0, 255)) + "," + F0(Math.Clamp(AcesColorMath.Bt1886Inverse(b) * 255, 0, 255)) + ")";
    }

    private static double Bar(float de) => Math.Clamp(de / 12.0, 0, 1) * 48;

    /// <summary>스펙트럼 폴리라인(-1 키 · 0–2 LED · 10–12 카메라 SSF · 각 최대 1 정규화).</summary>
    private string Spectrum(int which)
    {
        const int n = LedSpectralMetamerismGamutClippingGuard.Samples;
        var mx = 1e-9f;
        for (var i = 0; i < n; i++) mx = MathF.Max(mx, Sample(which, i));
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = 0; i < n; i++)
            sb.Append(F1(400.0 * i / (n - 1))).Append(',').Append(F1(98 - 94 * Sample(which, i) / mx)).Append(' ');
        return sb.ToString();
    }

    private float Sample(int which, int i) => which < 0 ? G.KeySpectrum(i) : which < 10 ? G.LedSpectrum(which, i) : G.CameraSsf(which - 10, i);

    private string Locus()
    {
        var sb = new System.Text.StringBuilder(LedSpectralMetamerismGamutClippingGuard.Samples * 12);
        for (var i = 0; i < LedSpectralMetamerismGamutClippingGuard.Samples - 12; i++)
        {
            G.LocusXy(i, out var x, out var y);
            sb.Append(F1(x * 300)).Append(',').Append(F1(270 - y * 300)).Append(' ');
        }
        G.LocusXy(0, out var x0, out var y0);
        sb.Append(F1(x0 * 300)).Append(',').Append(F1(270 - y0 * 300));
        return sb.ToString();
    }

    private static string Tri(double rx, double ry, double gx, double gy, double bx, double by) =>
        F1(rx * 300) + "," + F1(270 - ry * 300) + " " + F1(gx * 300) + "," + F1(270 - gy * 300) + " " + F1(bx * 300) + "," + F1(270 - by * 300);

    private string Series(Func<int, float> f, double max, double h)
    {
        var n = Runner.SeriesCount;
        if (n < 2) return "";
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = n - 1; i >= 0; i--)
            sb.Append(F1(360.0 * (n - 1 - i) / (LiveDitColorStudioRunner.SeriesLen - 1))).Append(',').Append(F1(h - 2 - (h - 4) * Math.Clamp(f(i) / max, 0, 1))).Append(' ');
        return sb.ToString();
    }

    private void ToggleRun() { if (Runner.IsRunning) Runner.Stop(); else Runner.Start(); }
    private void Step24() { for (var i = 0; i < LiveDitColorStudioRunner.Hz; i++) Runner.Step(); }

    private Task Close() => OnClose.InvokeAsync();

    /// <summary>가동 중(8 Hz 이벤트)은 300 ms 타이머가 처리 — 정지 상태 액션만 즉시 반영.</summary>
    private void OnServiceChanged() { if (!Runner.IsRunning) _ = InvokeAsync(StateHasChanged); }

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
