@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private const int VW = 640, VH = 400, SkyCols = 40, SkyRows = 20, MaxDrops = 500, CloudView = 128;
    private const int At_NAz = AtmosphericScatteringLightingEngine.NAz, At_NEl = AtmosphericScatteringLightingEngine.NEl;
    private const float Focal = 520f;
    private string? _prompt;
    private System.Threading.Timer? _timer;
    private Vector3 _eye, _f, _r, _u;

    private AtmosphericScatteringLightingEngine At => Runner.Atmosphere;
    private DynamicMicroWeatherSimulatorEngine Wx => Runner.Weather;
    private WeatherScenario T => Runner.Weather.Target;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("Environment.Modal.Timer", ex); }
        }, null, 200, 200);
    }

    private static string F0(double v) => v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => v.ToString("0.00", CultureInfo.InvariantCulture);
    private static string F3(double v) => v.ToString("0.000", CultureInfo.InvariantCulture);
    private static string Sci(double v) => v.ToString("0.0E0", CultureInfo.InvariantCulture);
    private static string Dist(float m) => m >= 1000f ? F1(m / 1000f) + " km" : F0(m) + " m";

    private static string Rgb(float r, float g, float b) =>
        "rgb(" + ((int)(Math.Clamp(r, 0f, 1f) * 255f)).ToString(CultureInfo.InvariantCulture) + "," + ((int)(Math.Clamp(g, 0f, 1f) * 255f)).ToString(CultureInfo.InvariantCulture) + "," + ((int)(Math.Clamp(b, 0f, 1f) * 255f)).ToString(CultureInfo.InvariantCulture) + ")";

    private string Disp(Vector3 radiance) { var d = At.ToDisplay(radiance); return Rgb(d.X, d.Y, d.Z); }

    private void UpdateCamera()
    {
        _eye = Runner.Eye;
        _f = Vector3.Normalize(Runner.LookTarget - _eye); _r = Vector3.Normalize(Vector3.Cross(Vector3.UnitY, _f)); _u = Vector3.Cross(_f, _r);
    }

    private Vector3 Ray(float sx, float sy) => Vector3.Normalize(_f + _r * ((sx - VW * 0.5f) / Focal) + _u * ((VH * 0.5f - sy) / Focal));

    private Vector3 Proj(Vector3 p)
    {
        var d = p - _eye; var z = Vector3.Dot(d, _f);
        if (z < 0.05f) return new Vector3(-100, -100, -1f);
        return new Vector3(VW * 0.5f + Focal * Vector3.Dot(d, _r) / z, VH * 0.5f - Focal * Vector3.Dot(d, _u) / z, z);
    }

    private Vector3 CellPos(int c)
    {
        var h = Runner.Wet.Height(c);
        return EnvironmentalBiomeWetnessGuard.CellCenter(c, Runner.Wet.BiomeOf(c) == Biome.Ocean ? MathF.Max(h, 0f) : h);
    }

    private RenderFragment Cell(int c) => __builder =>
    {
        const int N = EnvironmentalBiomeWetnessGuard.N;
        var a = Proj(CellPos(c)); var b = Proj(CellPos(c + 1)); var d = Proj(CellPos(c + N + 1)); var e = Proj(CellPos(c + N));
        if (a.Z <= 0f || b.Z <= 0f || d.Z <= 0f || e.Z <= 0f) return;
        var pts = F1(a.X) + "," + F1(a.Y) + " " + F1(b.X) + "," + F1(b.Y) + " " + F1(d.X) + "," + F1(d.Y) + " " + F1(e.X) + "," + F1(e.Y);
        var col = Rgb(Runner.TerrainR[c], Runner.TerrainG[c], Runner.TerrainB[c]);
        <polygon points="@pts" style="fill:@(col);stroke:@(col);stroke-width:.5" />
    };

    private string Bolt()
    {
        var sb = new System.Text.StringBuilder();
        var bx = Wx.BoltX; var by = Wx.BoltY;
        var horizonY = Proj(_eye + new Vector3(_f.X, 0f, _f.Z) * 1000f).Y;
        for (var k = 0; k < bx.Length; k++)
            sb.Append(F1(bx[k] * VW)).Append(',').Append(F1(by[k] * MathF.Max(horizonY, 40f))).Append(' ');
        return sb.ToString();
    }

    private void Preset(float precip, float cloud, float temp, float storm, float fog)
    {
        var s = Runner.Weather.Target;
        s.Precipitation = precip; s.CloudCoverage = cloud; s.Temperature = temp; s.Storm = storm; s.Fog = fog;
        s.Humidity = precip > 0f || fog > 0.5f ? 0.92f : 0.45f;
        Runner.SetScenario(s);
    }

    private static bool TryF(ChangeEventArgs e, out float v) => float.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out v);
    private void SetF(ChangeEventArgs e, Action<float> apply) { if (TryF(e, out var v)) apply(v); }

    private void ToggleAuto()
    {
        if (!Runner.ClockMode) Runner.SetClock(Runner.Hour, Runner.DayOfYear, Runner.Latitude);
        Runner.AutoTime = !Runner.AutoTime;
    }

    private void Step() { for (var k = 0; k < GenerativeEnvironmentStudioRunner.Hz; k++) Runner.TickOnce(); }

    private void ToggleRun() { if (Runner.IsRunning) Runner.Stop(); else Runner.Start(); }

    private Task Close() => OnClose.InvokeAsync();

    private void OnServiceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
