@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private System.Threading.Timer? _timer;
    private int _view = HolographicLightFieldTelepresenceEngine.Views / 2;
    private readonly byte[] _bmp = new byte[HolographicLightFieldTelepresenceEngine.ViewBmpBytes];

    private HolographicLightFieldTelepresenceEngine H => Runner.Holo;
    private UniversalAgiCinematicDirectorSynthesizer D => Runner.Director;
    private SpatialHapticCognitiveInteractionGuard G => Runner.Guard;
    private DirectorCue Q => Runner.Director.Cue;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("HoloTele.Modal.Timer", ex); }
        }, null, 300, 300);
    }

    private static string F0(double v) => v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => double.IsNaN(v) ? "—" : v.ToString("0.00", CultureInfo.InvariantCulture);
    private static string F3(double v) => v.ToString("0.000", CultureInfo.InvariantCulture);
    private static string Kb(long b) => (b / 1048576d).ToString("0.0", CultureInfo.InvariantCulture) + " MB";
    private static double Num(ChangeEventArgs e, double fallback) => double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : fallback;
    private static string FaceName(PromptFlowStudio.Services.DigitalHuman.FacePreset p) => p switch
    {
        PromptFlowStudio.Services.DigitalHuman.FacePreset.Joy => "기쁨", PromptFlowStudio.Services.DigitalHuman.FacePreset.Sadness => "슬픔",
        PromptFlowStudio.Services.DigitalHuman.FacePreset.Anger => "분노", PromptFlowStudio.Services.DigitalHuman.FacePreset.Surprise => "놀람",
        PromptFlowStudio.Services.DigitalHuman.FacePreset.Fear => "공포", PromptFlowStudio.Services.DigitalHuman.FacePreset.Disgust => "혐오", _ => "중립",
    };

    private string ViewSrc(int view)
    {
        var n = H.WriteViewBmp(view, _bmp);
        return "data:image/bmp;base64," + Convert.ToBase64String(_bmp, 0, n);
    }

    private double MbpsMax() => Math.Max(H.BudgetMbps * 1.25, Math.Max(1, H.PeakMbps));

    private string Series(Func<int, float> f, double max, double h)
    {
        var n = Runner.SeriesCount;
        if (n < 2) return "";
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = n - 1; i >= 0; i--)
            sb.Append(F1(360.0 * (n - 1 - i) / (HolographicTelepresenceStudioRunner.SeriesLen - 1))).Append(',').Append(F1(h - 2 - (h - 4) * Math.Clamp(f(i) / max, 0, 1))).Append(' ');
        return sb.ToString();
    }

    private string Wave(int h)
    {
        var w = G.Waveform(h);
        var sb = new System.Text.StringBuilder(w.Length * 12);
        for (var i = 0; i < w.Length; i++) sb.Append(F1(160.0 * i / (w.Length - 1))).Append(',').Append(F1(20 - 18 * w[i])).Append(' ');
        return sb.ToString();
    }

    private double X(int b) => 20 + 360 * D.LayoutX(b);
    private double Y(int b) => 14 + 160 * D.LayoutY(b);

    private bool OnPath(int from, int to)
    {
        for (var i = 0; i + 1 < Math.Min(6, D.PathCount); i++) if (D.PathBeat(i) == to && D.PathBeat(i + 1) == from) return true;
        return false;
    }

    private string BeatColor(int b)
    {
        var v = D.BeatValence(b); var t = D.BeatTension(b);
        var r = (int)(120 + 120 * Math.Max(0, -v) + 60 * t); var g = (int)(90 + 140 * Math.Max(0, v)); var bl = (int)(200 - 120 * t);
        return "rgb(" + Math.Clamp(r, 0, 255).ToString(CultureInfo.InvariantCulture) + "," + Math.Clamp(g, 0, 255).ToString(CultureInfo.InvariantCulture) + "," + Math.Clamp(bl, 0, 255).ToString(CultureInfo.InvariantCulture) + ")";
    }

    private RenderFragment Stage(string name, double us, string cls) => __builder =>
    {
        var total = Math.Max(1, H.FrameUs);
        <div class="htp-stage @cls">@name<b>@(F0(us)) µs</b><i style="width:@(F1(100 * us / total))%"></i></div>
    };

    private RenderFragment Meter(string name, float v) => __builder =>
    {
        <div class="htp-meter">@name <b>@(F0(v * 100))%</b><i><s style="width:@(F1(100 * Math.Clamp(v, 0, 1)))%"></s></i></div>
    };

    private void ToggleRun() { if (Runner.IsRunning) Runner.Stop(); else Runner.Start(); }
    private void Step60() { for (var i = 0; i < HolographicTelepresenceStudioRunner.Hz; i++) Runner.Step(); }

    private Task Close() => OnClose.InvokeAsync();

    /// <summary>가동 중(10 Hz 이벤트)은 300 ms 타이머가 처리 — 정지 상태 액션만 즉시 반영.</summary>
    private void OnServiceChanged() { if (!Runner.IsRunning) _ = InvokeAsync(StateHasChanged); }

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
