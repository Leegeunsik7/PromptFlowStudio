@using System.Globalization
@using System.Numerics
@using PromptFlowStudio.Services.Mocap
@implements IDisposable
@inject MotionCaptureStudioRunner Runner

@*
    [PromptFlow Studio v16.75.0] 💃 AI 신경망 마커리스 모션 캡처 스튜디오 — 3D 스켈레톤 스틱 비주얼라이저(캡처 · 참값 고스트 · 손/표정 · 리타겟 캐릭터 · 스킨 점군) ·
    포즈 신뢰도 게이지/관절별 신뢰도 · 카메라별 2D 검출 · 풋슬라이딩 방지/지면/자기충돌/관성 토글 · 대사·BCI 표정 연기 · 캐릭터 체형 프리셋.
*@

<div class="nmc-scrim" @onclick="Close">
    <div class="nmc-modal" @onclick:stopPropagation="true">
        <div class="nmc-h">
            <div>
                <div class="nmc-title">💃 AI 신경망 마커리스 모션 캡처 스튜디오</div>
                <div class="nmc-sub">다중 카메라 2D 키포인트를 <b>SIMD 삼각측량</b>해 전신 24관절 · 손가락 42점 · 표정 10점을 3D 로 복원하고, 이종 체형 캐릭터에
                    <b>오토 리깅 · 관절 한계 리타겟</b> 후 <b>발 고정 IK · 지면/충돌/관성 가드</b>와 대사·BCI 기반 <b>표정 연기</b>를 입힙니다.</div>
            </div>
            <button class="nmc-x" @onclick="Close">✕</button>
        </div>

        <div class="nmc-bar">
            <button class="nmc-btn @(Runner.IsRunning ? "on" : null)" @onclick="ToggleRun">@(Runner.IsRunning ? "⏸ 캡처 정지" : "▶ 캡처 시작")</button>
            <span class="nmc-chip">프레임 @(Runner.Frame)</span>
            <span class="nmc-chip">MPJPE @(F0(Runner.MpjpeMm))mm · 손 @(F0(Runner.HandErrorMm))mm</span>
            <span class="nmc-chip">재투영 @(F2(Runner.Pose.MeanReprojectionPx))px</span>
            <span class="nmc-chip">이상치 제거 @(Runner.Pose.OutliersRejected) · 단일 시점 @(Runner.Pose.MonocularJoints)</span>
            <span class="nmc-chip">추정 @(F2(Runner.Pose.LastMs))ms · SIMD @(NeuralMarkerlessPoseEstimationEngine.SimdLanes)레인</span>
            <span class="nmc-chip warn">입력: 합성 연기자 4시점(실 웹캠은 2D 검출기 결선 필요)</span>
        </div>

        <div class="nmc-main">
            <div class="nmc-col">
                <div class="nmc-card">
                    <div class="nmc-sec">🦴 3D 스켈레톤 — 시점 회전 <input type="range" min="-180" max="180" step="5" value="@(F0(_yaw))" @onchange="e => _yaw = P(e)" /> @(F0(_yaw))°</div>
                    <div class="nmc-views">
                        <svg class="nmc-view" viewBox="-1.1 -2.0 2.2 2.2">
                            <rect x="-1.1" y="-2.0" width="2.2" height="2.2" class="bg" />
                            <line x1="-1.1" y1="0" x2="1.1" y2="0" class="floor" />
                            @for (var j = 1; j < MocapSkeleton.Body; j++)
                            {
                                var a = Proj(Runner.GroundTruth[MocapSkeleton.Parent[j]]); var b = Proj(Runner.GroundTruth[j]);
                                <line x1="@(F3(a.X))" y1="@(F3(a.Y))" x2="@(F3(b.X))" y2="@(F3(b.Y))" class="gt" />
                            }
                            @for (var j = 1; j < MocapSkeleton.Body; j++)
                            {
                                var a = Proj(Runner.Pose.Position(MocapSkeleton.Parent[j])); var b = Proj(Runner.Pose.Position(j));
                                <line x1="@(F3(a.X))" y1="@(F3(a.Y))" x2="@(F3(b.X))" y2="@(F3(b.Y))" class="est" style="opacity:@(F2(0.35f + 0.65f * Runner.Pose.Confidence(j)))" />
                            }
                            @for (var k = MocapSkeleton.Body; k < MocapSkeleton.Keypoints; k++)
                            {
                                var q = Proj(Runner.Pose.Position(k));
                                <circle cx="@(F3(q.X))" cy="@(F3(q.Y))" r="0.008" class="@(k >= MocapSkeleton.FaceBase ? "face" : "hand")" />
                            }
                        </svg>
                        <svg class="nmc-view" viewBox="-1.1 -2.0 2.2 2.2">
                            <rect x="-1.1" y="-2.0" width="2.2" height="2.2" class="bg" />
                            <line x1="-1.1" y1="0" x2="1.1" y2="0" class="floor" />
                            @{ var sk = Runner.Skinned; }
                            @for (var i = 0; i < sk.Length; i += 6)
                            {
                                var q = Proj(sk[i]);
                                <circle cx="@(F3(q.X))" cy="@(F3(q.Y))" r="0.006" class="skin" />
                            }
                            @for (var j = 1; j < MocapSkeleton.Body; j++)
                            {
                                var a = Proj(Runner.Character[MocapSkeleton.Parent[j]]); var b = Proj(Runner.Character[j]);
                                <line x1="@(F3(a.X))" y1="@(F3(a.Y))" x2="@(F3(b.X))" y2="@(F3(b.Y))" class="chr" />
                            }
                            @for (var s = 0; s < 2; s++)
                            {
                                var toe = Proj(Runner.Character[s == 0 ? MocapSkeleton.LFoot : MocapSkeleton.RFoot]);
                                <circle cx="@(F3(toe.X))" cy="@(F3(toe.Y))" r="0.03" class="@(Runner.Guard.IsLocked(s) ? "lock" : "free")" />
                            }
                        </svg>
                    </div>
                    <div class="nmc-legend"><span><i class="gt"></i>참값</span><span><i class="est"></i>추정(신뢰도 투명도)</span><span><i class="chr"></i>리타겟 캐릭터</span><span><i class="lock"></i>발 고정</span></div>
                </div>

                <div class="nmc-card">
                    <div class="nmc-sec">📷 카메라별 2D 검출</div>
                    <div class="nmc-cams">
                        @for (var c = 0; c < MotionCaptureStudioRunner.Cameras; c++)
                        {
                            var dets = Runner.Detections(c);
                            <svg class="nmc-cam" viewBox="0 0 640 480">
                                <rect x="0" y="0" width="640" height="480" class="bg" />
                                @for (var k = 0; k < dets.Length; k++)
                                {
                                    var d = dets[k];
                                    if (d.Z <= 0) continue;
                                    <circle cx="@(F0(d.X))" cy="@(F0(d.Y))" r="@(k < MocapSkeleton.Body ? "6" : "3")" class="@(k < MocapSkeleton.Body ? "b" : "h")" />
                                }
                                <g><text x="10" y="30">CAM @(c + 1)</text></g>
                            </svg>
                        }
                    </div>
                    <div class="nmc-row">
                        <label class="nmc-slider"><span>픽셀 잡음 <b>@(F1(Runner.NoisePx))px</b></span><input type="range" min="0" max="6" step="0.2" value="@(F1(Runner.NoisePx))" @onchange="e => Runner.NoisePx = P(e)" /></label>
                        <label class="nmc-slider"><span>가림/드롭아웃 <b>@(F0(Runner.Dropout * 100))%</b></span><input type="range" min="0" max="40" step="1" value="@(F0(Runner.Dropout * 100))" @onchange="e => Runner.Dropout = P(e) / 100f" /></label>
                        <label class="nmc-tg"><input type="checkbox" checked="@Runner.InjectOutliers" @onchange="e => Runner.InjectOutliers = e.Value is true" /> 이상치 주입</label>
                    </div>
                </div>
            </div>

            <div class="nmc-col">
                <div class="nmc-card">
                    <div class="nmc-sec">🎯 포즈 추정 신뢰도</div>
                    <div class="nmc-gauge-row">
                        <svg class="nmc-gauge" viewBox="-60 -58 120 70">
                            <path d="M-48,0 A48,48 0 0 1 48,0" class="bg" />
                            <path d="@GaugeArc(Runner.Pose.MeanConfidence)" class="val @(Runner.Pose.MeanConfidence < 0.6f ? "low" : null)" />
                            <g><text x="0" y="-8" class="v">@(F0(Runner.Pose.MeanConfidence * 100))%</text></g>
                            <g><text x="0" y="8" class="l">전신 평균 신뢰도</text></g>
                        </svg>
                        <div class="nmc-jconf">
                            @for (var j = 0; j < MocapSkeleton.Body; j++)
                            {
                                var cf = Runner.Pose.Confidence(j);
                                <div title="@(MocapSkeleton.Names[j]) · @(Runner.Pose.Views(j))시점"><i style="height:@(F0(cf * 100))%" class="@(cf < 0.5f ? "low" : null)"></i></div>
                            }
                        </div>
                    </div>
                </div>

                <div class="nmc-card">
                    <div class="nmc-sec">🦶 물리 제약 가드</div>
                    <div class="nmc-row">
                        <label class="nmc-tg"><input type="checkbox" checked="@Runner.Guard.FootLock" @onchange="e => Runner.Guard.FootLock = e.Value is true" /> 풋슬라이딩 방지</label>
                        <label class="nmc-tg"><input type="checkbox" checked="@Runner.Guard.GroundClamp" @onchange="e => Runner.Guard.GroundClamp = e.Value is true" /> 지면 관통 차단</label>
                        <label class="nmc-tg"><input type="checkbox" checked="@Runner.Guard.SelfCollision" @onchange="e => Runner.Guard.SelfCollision = e.Value is true" /> 자기 충돌</label>
                        <label class="nmc-tg"><input type="checkbox" checked="@Runner.Guard.Inertia" @onchange="e => Runner.Guard.Inertia = e.Value is true" /> 루트 관성</label>
                        <label class="nmc-tg"><input type="checkbox" checked="@Runner.Rig.EnforceLimits" @onchange="e => Runner.Rig.EnforceLimits = e.Value is true" /> 관절 한계(DOF)</label>
                    </div>
                    <div class="nmc-stats">
                        <span><b>@(F1(Runner.Guard.SlideBeforeMm)) → @(F1(Runner.Guard.SlideAfterMm))</b>발 미끄럼 mm/프레임</span>
                        <span><b>@(F1(Runner.Guard.PenetrationBeforeMm)) → @(F1(Runner.Guard.PenetrationAfterMm))</b>지면 관통 mm</span>
                        <span><b>@(Runner.Rig.ClampedJoints)</b>한계 클램프 관절</span>
                        <span><b>@(Runner.Guard.Collisions)</b>자기 충돌 해소</span>
                        <span><b>@(Runner.Guard.RootClamps)</b>관성 제한</span>
                        <span><b>@(Runner.Guard.IsLocked(0) ? "●" : "○") @(Runner.Guard.IsLocked(1) ? "●" : "○")</b>발 고정 L/R</span>
                    </div>
                    <div class="nmc-row">
                        <span class="nmc-note">캐릭터 체형</span>
                        <button class="nmc-btn" @onclick="@(() => Runner.BuildCharacter(1f, 1f, 1f, 1f, "표준 성인"))">표준 성인</button>
                        <button class="nmc-btn" @onclick="@(() => Runner.BuildCharacter(0.75f, 0.8f, 1f, 1.6f, "대두 단신 캐릭터"))">대두 단신</button>
                        <button class="nmc-btn" @onclick="@(() => Runner.BuildCharacter(1.1f, 1.15f, 1.25f, 0.9f, "장신 롱암"))">장신 롱암</button>
                        <span class="nmc-note">@(Runner.Rig.Target.Name) · @(F2(Runner.Rig.Target.Height))m · 정점 @(Runner.Rig.Target.Vertices.Length)</span>
                    </div>
                </div>

                <div class="nmc-card">
                    <div class="nmc-sec">🎭 표정 연기 — @(Emotion())</div>
                    <div class="nmc-row">
                        <input class="nmc-in" @bind="_line" placeholder="대사 입력: 예) 정말 기뻐요! / 너무 슬퍼… / 화가 나!!" />
                        <button class="nmc-btn on" @onclick="Speak">🗣 말하기</button>
                    </div>
                    <div class="nmc-row">
                        <label class="nmc-tg"><input type="checkbox" checked="@_bciOn" @onchange="e => { _bciOn = e.Value is true; PushBci(); }" /> BCI 신호</label>
                        <label class="nmc-slider"><span>정서가 <b>@(F2(_val))</b></span><input type="range" min="-1" max="1" step="0.05" value="@(F2(_val))" @onchange="e => { _val = P(e); PushBci(); }" /></label>
                        <label class="nmc-slider"><span>각성 <b>@(F2(_aro))</b></span><input type="range" min="0" max="1" step="0.05" value="@(F2(_aro))" @onchange="e => { _aro = P(e); PushBci(); }" /></label>
                        <label class="nmc-slider"><span>주의 <b>@(F2(_att))</b></span><input type="range" min="0" max="1" step="0.05" value="@(F2(_att))" @onchange="e => { _att = P(e); PushBci(); }" /></label>
                    </div>
                    <div class="nmc-blend">
                        @for (var i = 0; i < FaceShapes.Count; i++)
                        {
                            var w = Runner.FaceWeights[i];
                            <div><span>@(FaceShapes.Names[i])</span><i style="width:@(F0(w * 100))%"></i><b>@(F2(w))</b></div>
                        }
                    </div>
                    <div class="nmc-note">표정 캡처 오차 @(F2(Runner.FaceError)) · 캡처 신뢰도로 캡처/생성 보간 · 발화 중 비셈 우선</div>
                </div>
                <div class="nmc-note">@(Runner.LastAction ?? "대기")</div>
            </div>
        </div>
    </div>
</div>

<style>
    .nmc-scrim { position: fixed; inset: 0; z-index: var(--z-studio-modal); background: rgba(0,0,0,.62); display: flex; align-items: center; justify-content: center; padding: 20px; }
    .nmc-modal { width: min(1600px, 97vw); max-height: 94vh; display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--line); border-radius: 18px; box-shadow: 0 24px 60px rgba(0,0,0,.45); overflow: hidden; }
    .nmc-h { display: flex; justify-content: space-between; gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--line); background: linear-gradient(120deg, color-mix(in srgb, #ec4899 18%, var(--card)), color-mix(in srgb, #22d3ee 14%, var(--card))); }
    .nmc-title { font-size: 17px; font-weight: 900; color: var(--text-primary); }
    .nmc-sub { font-size: 12px; color: var(--text-secondary); margin-top: 4px; line-height: 1.5; }
    .nmc-sub b { color: var(--text-primary); }
    .nmc-x { background: none; border: none; color: var(--text-muted); font-size: 18px; cursor: pointer; border-radius: 8px; }
    .nmc-bar { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 20px; border-bottom: 1px solid var(--line); align-items: center; }
    .nmc-btn { font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 8px; border: 1px solid var(--line); background: transparent; color: var(--text-primary); cursor: pointer; }
    .nmc-btn.on { background: color-mix(in srgb, #ec4899 24%, transparent); border-color: #ec4899; }
    .nmc-chip { font: 700 11px var(--mono); padding: 4px 9px; border-radius: 999px; border: 1px solid var(--line); color: var(--text-secondary); }
    .nmc-chip.warn { border-color: #f59e0b; color: #fcd34d; }
    .nmc-main { display: grid; grid-template-columns: 1.2fr 1fr; gap: 14px; padding: 14px 20px; min-height: 0; flex: 1; overflow-y: auto; }
    .nmc-col { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
    .nmc-card { border: 1px solid var(--line); border-radius: 12px; padding: 12px; display: flex; flex-direction: column; gap: 8px; }
    .nmc-sec { font-weight: 800; font-size: 13px; color: var(--text-primary); display: flex; gap: 8px; align-items: center; }
    .nmc-sec input { width: 140px; accent-color: #ec4899; }
    .nmc-views { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .nmc-view { width: 100%; aspect-ratio: 1; border-radius: 10px; }
    .nmc-view .bg, .nmc-cam .bg { fill: #0b1220; } .nmc-view .floor { stroke: #334155; stroke-width: .01; }
    .nmc-view .gt { stroke: #64748b; stroke-width: .012; stroke-dasharray: .03 .02; } .nmc-view .est { stroke: #22d3ee; stroke-width: .025; stroke-linecap: round; }
    .nmc-view .chr { stroke: #fb923c; stroke-width: .028; stroke-linecap: round; } .nmc-view .skin { fill: #fdba74; opacity: .35; }
    .nmc-view .hand { fill: #a5f3fc; } .nmc-view .face { fill: #f9a8d4; }
    .nmc-view .lock { fill: none; stroke: #22c55e; stroke-width: .015; } .nmc-view .free { fill: none; stroke: #475569; stroke-width: .01; }
    .nmc-legend { display: flex; flex-wrap: wrap; gap: 10px; font-size: 10.5px; color: var(--text-muted); }
    .nmc-legend i { display: inline-block; width: 14px; height: 3px; margin-right: 4px; vertical-align: middle; } .nmc-legend i.gt { background: #64748b; } .nmc-legend i.est { background: #22d3ee; } .nmc-legend i.chr { background: #fb923c; } .nmc-legend i.lock { background: #22c55e; }
    .nmc-cams { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
    .nmc-cam { width: 100%; border-radius: 6px; } .nmc-cam .b { fill: #22d3ee; } .nmc-cam .h { fill: #f9a8d4; } .nmc-cam text { font: 700 28px var(--mono); fill: #94a3b8; }
    .nmc-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .nmc-slider { display: flex; flex-direction: column; gap: 2px; font-size: 11px; color: var(--text-secondary); min-width: 120px; flex: 1; }
    .nmc-slider b { color: var(--text-primary); font-family: var(--mono); } .nmc-slider input { width: 100%; accent-color: #ec4899; }
    .nmc-tg { font-size: 11.5px; color: var(--text-secondary); display: flex; gap: 3px; align-items: center; padding: 3px 7px; border: 1px solid var(--line); border-radius: 7px; }
    .nmc-gauge-row { display: grid; grid-template-columns: 150px 1fr; gap: 10px; align-items: center; }
    .nmc-gauge .bg { fill: none; stroke: #1e293b; stroke-width: 10; } .nmc-gauge .val { fill: none; stroke: #22c55e; stroke-width: 10; stroke-linecap: round; } .nmc-gauge .val.low { stroke: #f97316; }
    .nmc-gauge .v { font: 800 15px var(--mono); fill: var(--text-primary); text-anchor: middle; } .nmc-gauge .l { font-size: 7.5px; fill: var(--text-muted); text-anchor: middle; }
    .nmc-jconf { display: grid; grid-template-columns: repeat(24, 1fr); gap: 2px; height: 70px; align-items: end; }
    .nmc-jconf div { height: 100%; display: flex; align-items: flex-end; background: #0f172a; border-radius: 2px; } .nmc-jconf i { width: 100%; background: #22c55e; border-radius: 2px; } .nmc-jconf i.low { background: #f97316; }
    .nmc-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
    .nmc-stats span { display: flex; flex-direction: column; font-size: 10.5px; color: var(--text-muted); padding: 5px 7px; border: 1px solid color-mix(in srgb, var(--line) 60%, transparent); border-radius: 8px; }
    .nmc-stats b { font: 800 13px var(--mono); color: var(--text-primary); }
    .nmc-in { flex: 1; min-width: 160px; font-size: 12px; padding: 5px 8px; border-radius: 8px; border: 1px solid var(--line); background: var(--card); color: var(--text-primary); }
    .nmc-blend { display: grid; grid-template-columns: 1fr 1fr; gap: 3px 10px; }
    .nmc-blend div { position: relative; display: flex; justify-content: space-between; font-size: 10.5px; color: var(--text-secondary); padding: 2px 5px; border-radius: 4px; overflow: hidden; border: 1px solid color-mix(in srgb, var(--line) 60%, transparent); }
    .nmc-blend i { position: absolute; left: 0; top: 0; bottom: 0; background: color-mix(in srgb, #ec4899 26%, transparent); z-index: 0; }
    .nmc-blend span, .nmc-blend b { position: relative; z-index: 1; } .nmc-blend b { font-family: var(--mono); color: var(--text-primary); }
    .nmc-note { font-size: 11px; color: var(--text-muted); }
    @@media (max-width: 1200px) { .nmc-main { grid-template-columns: 1fr; } .nmc-cams { grid-template-columns: repeat(2, 1fr); } }
</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private float _yaw = 25f, _val, _aro = 0.5f, _att = 0.5f;
    private bool _bciOn;
    private string _line = "";
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        if (Runner.Frame == 0) Runner.TickOnce();
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("Mocap.Modal.Timer", ex); }
        }, null, 100, 100);
    }

    private static string F0(double v) => v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => v.ToString("0.00", CultureInfo.InvariantCulture);
    private static string F3(double v) => v.ToString("0.000", CultureInfo.InvariantCulture);
    private static float P(ChangeEventArgs e) => float.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : 0;

    /// <summary>요 회전 직교 투영(화면 y 아래 = −월드 y).</summary>
    private Vector2 Proj(Vector3 p)
    {
        var a = _yaw * MathF.PI / 180f;
        var x = p.X * MathF.Cos(a) + p.Z * MathF.Sin(a);
        return new Vector2(x, -p.Y);
    }

    private static string GaugeArc(float v)
    {
        var a = MathF.PI * (1 - Math.Clamp(v, 0.001f, 1f));
        return "M-48,0 A48,48 0 0 1 " + F1(MathF.Cos(a) * 48) + "," + F1(-MathF.Sin(a) * 48);
    }

    private string Emotion()
    {
        var (v, a) = Runner.Guard.Mood;
        return GenerativeCharacterPerformanceGuard.Classify(v, a) switch
        {
            CharacterEmotion.Joy => "😊 기쁨", CharacterEmotion.Sadness => "😢 슬픔", CharacterEmotion.Anger => "😠 분노", CharacterEmotion.Surprise => "😲 놀람", CharacterEmotion.Fear => "😨 두려움", _ => "😐 중립",
        } + " (정서가 " + F2(v) + " · 각성 " + F2(a) + ")";
    }

    private void Speak()
    {
        if (string.IsNullOrWhiteSpace(_line)) return;
        Runner.SetDialogue(_line.Trim());
    }

    private void PushBci() => Runner.Guard.SetBci(new BciSignal { Valence = _val, Arousal = _aro, Attention = _att, Valid = _bciOn });

    private void ToggleRun() { if (Runner.IsRunning) Runner.Stop(); else Runner.Start(); }

    private Task Close() => OnClose.InvokeAsync();

    private void OnServiceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
