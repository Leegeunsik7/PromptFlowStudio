@code {
    [Parameter, EditorRequired] public StoryboardProject Project { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnReveal { get; set; }

    private int _tab;
    private string? _msg, _voteNode, _tagNode, _previewTag;
    private string _tagName = "", _tagUrl = "", _tagPrice = "", _tagCoupon = "";
    private double _tagStart, _tagEnd = 5, _previewT;
    private CancellationTokenSource? _cts;

    private bool Busy => _cts is not null || Branch.IsBusy || Shop.IsBusy;

    protected override void OnInitialized()
    {
        Branch.OnChange += OnServiceChanged;
        Shop.OnChange += OnServiceChanged;
        Analytics.OnChange += OnServiceChanged;
        if (Branch.NodeCount == 0) Branch.SeedFromProject(Project);
    }

    private static string F(double v) => v.ToString("0.#", CultureInfo.InvariantCulture);

    private static string Cut(string s, int max) => s.Length <= max ? s : s[..max] + "…";

    /// <summary>깊이(열) × 순번(행) 배치 — 도달 불가 노드는 마지막 열.</summary>
    private static Dictionary<string, (double X, double Y)> Layout(IReadOnlyList<ChoiceNode> nodes, Dictionary<string, int> depths, out int vw, out int vh)
    {
        var maxDepth = 0;
        foreach (var d in depths.Values) if (d > maxDepth) maxDepth = d;
        var orphan = maxDepth + 1;
        var rows = new Dictionary<int, int>();
        var pos = new Dictionary<string, (double X, double Y)>(nodes.Count, StringComparer.Ordinal);
        int maxRow = 0, maxCol = 0;
        foreach (var n in nodes)
        {
            var col = depths.TryGetValue(n.Id, out var d) ? d : orphan;
            rows.TryGetValue(col, out var row);
            rows[col] = row + 1;
            pos[n.Id] = (12 + col * 200, 12 + row * 60);
            if (row > maxRow) maxRow = row;
            if (col > maxCol) maxCol = col;
        }
        vw = 24 + (maxCol + 1) * 200;
        vh = 24 + (maxRow + 1) * 60;
        return pos;
    }

    private void Seed()
    {
        var n = Branch.SeedFromProject(Project);
        _msg = n == 0 ? "⚠ 완성된 컷 영상이 없습니다 — 빈 노드로 시작하세요." : "🎬 컷 " + n.ToString(CultureInfo.InvariantCulture) + "개를 선형 체인으로 시드했습니다. 선택지를 추가해 분기를 만드세요.";
    }

    private void AddNode()
    {
        var k = Branch.NodeCount + 1;
        Branch.AddNode(new ChoiceNode { Title = "노드 " + k.ToString(CultureInfo.InvariantCulture), VideoPath = Project.FinalVideoPath });
    }

    private void LinkTo(string fromId, string? targetId)
    {
        if (string.IsNullOrEmpty(targetId)) return;
        var from = Branch.NodeOf(fromId);
        var label = from is null ? "" : "선택 " + InteractiveChoiceBranchingService.OptionLetter(from.Options.Count);
        if (!Branch.LinkOption(fromId, label, targetId)) _msg = "⚠ 선택지를 추가할 수 없습니다(최대 4개).";
    }

    private void AddTag()
    {
        var tag = new ShoppableTag
        {
            NodeId = _tagNode!, ProductName = _tagName.Trim(), Url = _tagUrl.Trim(),
            PriceText = string.IsNullOrWhiteSpace(_tagPrice) ? null : _tagPrice.Trim(),
            CouponCode = string.IsNullOrWhiteSpace(_tagCoupon) ? null : _tagCoupon.Trim(),
            StartSeconds = Math.Max(0, _tagStart), EndSeconds = Math.Max(_tagStart + 0.5, _tagEnd),
        };
        if (!Shop.AddTag(tag)) { _msg = "⚠ 태그 상한(" + ShoppableVideoOverlayEngine.MaxTags.ToString(CultureInfo.InvariantCulture) + ")"; return; }
        if (ShoppableVideoOverlayEngine.Validate(tag) is { } e2) _msg = "⚠ " + e2;
        else { _msg = "🏷 태그 추가 — 🎯 추적으로 피사체 이동 경로를 따라가게 할 수 있습니다."; _tagName = _tagUrl = _tagPrice = _tagCoupon = ""; }
    }

    private void SeedBrand()
    {
        if (Shop.Brand?.Last is not { } last || string.IsNullOrEmpty(_tagNode)) return;
        var tag = ShoppableVideoOverlayEngine.SeedFromCampaign(last, _tagNode);
        if (!string.IsNullOrWhiteSpace(_tagUrl)) tag.Url = _tagUrl.Trim();
        if (Shop.AddTag(tag)) _msg = "🤝 '" + last.Name + "' 캠페인 제품 위치로 태그를 만들었습니다" + (ShoppableVideoOverlayEngine.IsSafeUrl(tag.Url) ? "." : " — 구매 링크(https)를 입력하세요.");
    }

    private Task TrackAsync(ShoppableTag tag)
    {
        var video = Branch.NodeOf(tag.NodeId)?.VideoPath;
        return RunAsync(async ct =>
        {
            var r = await Shop.TrackAsync(tag, video ?? "", ct);
            _msg = (r.Ok ? "🎯 " : "⚠ ") + r.Message + (r.Ok ? " · 키 " + r.Keyframes.ToString(CultureInfo.InvariantCulture) + " · 신뢰도 " + r.MeanConfidence.ToString("0.00", CultureInfo.InvariantCulture) : "");
        });
    }

    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        try
        {
            using var s = e.File.OpenReadStream(20 * 1024 * 1024);
            using var rd = new StreamReader(s);
            var r = Analytics.ImportEventLog(await rd.ReadToEndAsync());
            _msg = r is { } v ? "📥 " + v.Accepted.ToString(CultureInfo.InvariantCulture) + "건 반영 · " + v.Skipped.ToString(CultureInfo.InvariantCulture) + "건 건너뜀" : "⚠ 이벤트 로그 형식이 아닙니다.";
        }
        catch (Exception ex) { Program.Log("InteractiveStudio.Import", ex); _msg = "⚠ 가져오기 실패: " + ex.Message; }
    }

    private async Task ExportCsv()
    {
        var root = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyVideos), "PromptFlowStudio", "Interactive");
        var p = Analytics.ExportCsv(root);
        _msg = p is null ? "⚠ CSV 저장 실패" : "📤 " + p;
        if (p is not null) await OnReveal.InvokeAsync(p);
    }

    private Task ExportAsync()
    {
        var root = !string.IsNullOrWhiteSpace(Project.FinalVideoPath) ? Path.GetDirectoryName(Path.GetFullPath(Project.FinalVideoPath))!
            : Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyVideos), "PromptFlowStudio", "Interactive");
        return RunAsync(async ct =>
        {
            var r = await Branch.ExportPackageAsync(root, ct);
            _msg = (r.Ok ? "✅ " : "⚠ ") + r.Message + (r.Folder is null ? "" : " · " + r.Folder);
            if (r.Ok && r.Folder is not null) await OnReveal.InvokeAsync(r.Folder);
        });
    }

    private async Task RunAsync(Func<CancellationToken, Task> work)
    {
        var cts = new CancellationTokenSource();
        if (Interlocked.CompareExchange(ref _cts, cts, null) is not null) { cts.Dispose(); return; }
        _msg = null;
        try { await work(cts.Token); }
        catch (OperationCanceledException) { _msg = "⚠ 취소됨"; }
        catch (Exception ex) { Program.Log("InteractiveStudio.Run", ex); _msg = "⚠ 실패: " + ex.Message; }
        finally
        {
            Interlocked.CompareExchange(ref _cts, null, cts);
            cts.Dispose();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Cancel()
    {
        try { _cts?.Cancel(); } catch (ObjectDisposedException) { }
    }

    private Task Close() => Busy ? Task.CompletedTask : OnClose.InvokeAsync();

    private void OnServiceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Branch.OnChange -= OnServiceChanged;
        Shop.OnChange -= OnServiceChanged;
        Analytics.OnChange -= OnServiceChanged;
        Cancel();   // 진행 중 작업은 RunAsync finally 에서 CTS 정리
    }
}
