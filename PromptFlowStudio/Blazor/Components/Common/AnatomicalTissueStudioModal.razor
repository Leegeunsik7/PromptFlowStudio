@using System.Globalization
@using System.Numerics
@using PromptFlowStudio.Services.AnatomicalTissue
@using PromptFlowStudio.Services.Mocap
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable
@inject AnatomicalTissueStudioRunner Runner

@*
    [PromptFlow Studio v17.14.0] 💪 AI 해부학 근육 & 연조직 스튜디오 — 골격-근육-피부 3-Layer 투시 뷰포트 · 근육 응력 히트맵 ·
    연조직 탄성/감쇄 슬라이더 · 관성 지글 · 압축 주름 법선 맵 · 체적/자가 교차 가드.
*@

<div class="atis-scrim" @onclick="Close">
    <div class="atis-modal" @onclick:stopPropagation="true">
        <div class="atis-h">
            <div>
                <div class="atis-title">💪 AI 해부학 근육 &amp; 연조직 스튜디오</div>
                <div class="atis-sub"><b>근육/근막 엔진</b>이 v17.11 골격 관절 각·각속도·착지 감속으로 13개 근육(이두·삼두·대퇴사두·햄스트링·비복근·승모근·복직근)의 활성과 기시–정지 길이를 계산해 등체적 방추형 팽창과 근막 위 피부 슬라이딩을 1,920 정점 피부에 SIMD 로 적용합니다.
                    <b>연조직 합성기</b>는 복부·대퇴·상완 후면의 감쇠 질량-스프링 관성 지글과 굴곡 압축 변형률 기반 절차적 주름 법선 맵을 만들고,
                    <b>가드</b>는 5,520 사면체 체적 하한(단조 단면 팽창 보상)과 팔꿈치/무릎 주름면·팔–몸통 자가 교차 락을 수행합니다. 연기자는 인프로세스 시뮬레이션입니다.</div>
            </div>
            <button class="atis-x" @onclick="Close">✕</button>
        </div>

        <div class="atis-bar">
            <button class="atis-btn @(Runner.IsRunning ? "on" : null)" @onclick="ToggleRun">@(Runner.IsRunning ? "⏸ 정지" : "▶ 연조직 가동")</button>
            <button class="atis-btn" @onclick="Step60" disabled="@Runner.IsRunning">⏭ 1초</button>
            <button class="atis-btn @(Runner.Motion ? "on" : null)" @onclick="() => Runner.Motion = !Runner.Motion">🎬 연기</button>
            <span class="atis-chip">단계 @(Runner.Phase) · t @(F1(Runner.Time % AnatomicalTissueStudioRunner.Cycle)) s</span>
            <select class="atis-sel" value="@((int)E.Skinning)" @onchange="e => Runner.SetSkinning((TissueSkinning)(int)Num(e, 0))">
                <option value="0">스키닝: 관절 중심 회전(DQS 등가)</option><option value="1">스키닝: LBS(붕괴 재현)</option>
            </select>
            <span class="atis-chip">틱 @(Runner.Tick) · @(F2(Runner.LastTickMs)) ms · 근육 @(F0(E.LastUpdateUs)) (SIMD @(F0(E.LastSimdUs))) · 지글 @(F0(T.LastJiggleUs)) · 체적 @(F0(G.LastVolumeUs)) · 교차 @(F0(G.LastIntersectionUs)) · 주름 @(F0(T.LastWrinkleUs)) µs · @(E.Path)</span>
            <span class="atis-chip @(Runner.LastTickMs < 16.7 ? "ok" : "warn")">@(Runner.LastTickMs < 16.7 ? "60 FPS 예산 내" : "예산 초과")</span>
        </div>

        <div class="atis-main">
            <div class="atis-col">
                <div class="atis-card">
                    <div class="atis-sec">🩻 해부학 3-Layer 투시 뷰포트
                        <button class="atis-btn sm @(_skel ? "on" : null)" @onclick="() => _skel = !_skel">🦴 골격</button>
                        <button class="atis-btn sm @(_muscle ? "on" : null)" @onclick="() => _muscle = !_muscle">💪 근육</button>
                        <button class="atis-btn sm @(_skin ? "on" : null)" @onclick="() => _skin = !_skin">🧍 피부</button>
                        <select class="atis-sel" value="@(_skinColor)" @onchange="e => _skinColor = (int)Num(e, 0)">
                            <option value="0">피부 색: 근육 영향 응력</option><option value="1">피부 색: 압축 주름</option><option value="2">피부 색: 지글 변위</option><option value="3">피부 색: 체적비</option>
                        </select>
                    </div>
                    <svg class="atis-vp" viewBox="0 0 520 560">
                        <line class="ground" x1="20" y1="@(F1(P(new Vector3(0, 0.04f, 0)).Y))" x2="500" y2="@(F1(P(new Vector3(0, 0.04f, 0)).Y))" />
                        @if (_skin)
                        {
                            for (var r = 0; r < NeuralAnatomicalMuscleFasciaEngine.RingCount; r++)
                            {
                                <g><path class="ring" d="@(RingPath(r))" /></g>
                            }
                            for (var t = 0; t < NeuralAnatomicalMuscleFasciaEngine.Tubes; t++)
                            {
                                for (var j = 0; j < NeuralAnatomicalMuscleFasciaEngine.Segs; j += 2)
                                {
                                    <g><path class="lon" style="stroke:@(LonColor(t, j))" d="@(LonPath(t, j))" /></g>
                                }
                            }
                        }
                        @if (_muscle)
                        {
                            for (var m = 0; m < NeuralAnatomicalMuscleFasciaEngine.MuscleCount; m++)
                            {
                                var o = P(E.Origin(m)); var ins = P(E.Insertion(m));
                                var w = (NeuralAnatomicalMuscleFasciaEngine.Muscles[m].Radius + E.BulgeMm(m) * 0.001f) * Zoom * 0.9f;
                                <g><line class="mus" x1="@(F1(o.X))" y1="@(F1(o.Y))" x2="@(F1(ins.X))" y2="@(F1(ins.Y))" stroke-width="@(F1(Math.Max(2, w)))" style="stroke:@(Heat(E.Stress(m) / 1.2))" /></g>
                            }
                        }
                        @if (_skel)
                        {
                            for (var j = 1; j < MocapSkeleton.Body; j++)
                            {
                                var a = P(E.Joint(MocapSkeleton.Parent[j])); var b = P(E.Joint(j));
                                <g><line class="bone" x1="@(F1(a.X))" y1="@(F1(a.Y))" x2="@(F1(b.X))" y2="@(F1(b.Y))" /><circle class="jt" cx="@(F1(b.X))" cy="@(F1(b.Y))" r="2.4" /></g>
                            }
                        }
                    </svg>
                    <div class="atis-ctl">
                        <label class="atis-sl">회전 <b>@(F0(_yaw))°</b><input type="range" min="-180" max="180" step="5" value="@(F0(_yaw))" @oninput="e => _yaw = Num(e, 30)" /></label>
                        <label class="atis-sl">부감 <b>@(F0(_pitch))°</b><input type="range" min="-20" max="60" step="5" value="@(F0(_pitch))" @oninput="e => _pitch = Num(e, 8)" /></label>
                    </div>
                    <div class="atis-legend"><span class="grad"></span><span>근육 응력 0 → 1.2(σ = a·L/L₀ + 2·신장)</span><span>최대 응력 <b>@(NeuralAnatomicalMuscleFasciaEngine.Muscles[E.PeakMuscle].Name)</b> @(F2(E.PeakStress))</span></div>
                </div>

                <div class="atis-card">
                    <div class="atis-sec">🔥 실시간 근육 응력(Muscle Stress) 히트맵 <span class="atis-dim">가로 = 최근 2 초 · 세로 = 근육</span></div>
                    <div class="atis-heat">
                        <div class="names">@for (var m = 0; m < NeuralAnatomicalMuscleFasciaEngine.MuscleCount; m++) { <span>@(NeuralAnatomicalMuscleFasciaEngine.Muscles[m].Name)</span> }</div>
                        <img src="data:image/bmp;base64,@(Runner.MonitorBase64(0))" alt="stress" />
                    </div>
                    <div class="atis-mtab">
                        <div class="hd"><span>근육</span><span>활성</span><span>L/L₀</span><span>팽창</span><span>근막</span></div>
                        @for (var m = 0; m < NeuralAnatomicalMuscleFasciaEngine.MuscleCount; m++)
                        {
                            <div class="rw"><span class="nm">@(NeuralAnatomicalMuscleFasciaEngine.Muscles[m].Name)</span>
                                <span class="bar"><span style="width:@(F1(E.Activation(m) * 100))%;background:@(Heat(E.Stress(m) / 1.2))"></span></span>
                                <span class="v">@(F2(E.LengthRatio(m)))</span><span class="v">@(F1(E.BulgeMm(m))) mm</span><span class="v">@(F1(E.SlideMm(m))) mm</span></div>
                        }
                    </div>
                    <div class="atis-ctl">
                        <label class="atis-sl">근육 팽창 게인 <b>@(F2(E.MuscleGain))</b><input type="range" min="0" max="2.5" step="0.05" value="@(F2(E.MuscleGain))" @onchange="e => Runner.SetMuscleGain((float)Num(e, 1))" /></label>
                        <button class="atis-btn sm @(E.FasciaSliding ? "on" : null)" @onclick="() => Runner.SetFascia(!E.FasciaSliding)">🧵 근막 슬라이딩</button>
                    </div>
                </div>
            </div>

            <div class="atis-col">
                <div class="atis-card">
                    <div class="atis-sec">🫧 연조직 관성 지글 <button class="atis-btn sm @(T.JiggleEnabled ? "on" : null)" @onclick="() => Runner.SetJiggle(!T.JiggleEnabled)">지글</button>
                        <span class="atis-chip">착지 감속 @(F0(Runner.LandingAccel)) m/s² · 최대 변위 @(F1(T.MaxJiggleMm)) mm</span></div>
                    <div class="atis-ctl">
                        <label class="atis-sl">탄성 <b>@(F1(T.FrequencyHz)) Hz</b><input type="range" min="0.8" max="10" step="0.1" value="@(F1(T.FrequencyHz))" @onchange="e => Runner.SetFrequency((float)Num(e, 3.2))" /></label>
                        <label class="atis-sl">감쇄비 ζ <b>@(F2(T.Damping))</b><input type="range" min="0.03" max="1.2" step="0.01" value="@(F2(T.Damping))" @onchange="e => Runner.SetDamping((float)Num(e, 0.18))" /></label>
                        <label class="atis-sl">게인 <b>@(F2(T.JiggleGain))</b><input type="range" min="0" max="3" step="0.05" value="@(F2(T.JiggleGain))" @onchange="e => Runner.SetJiggleGain((float)Num(e, 0.3))" /></label>
                    </div>
                    <div class="atis-regions">
                        @for (var r = 0; r < SoftTissueInertialDynamicsWrinkleSynthesizer.Regions; r++)
                        {
                            var x = T.Offset(r);
                            <div class="atis-rg"><span class="nm">@(SoftTissueInertialDynamicsWrinkleSynthesizer.RegionNames[r])</span>
                                <svg viewBox="-32 -32 64 64"><circle class="lim" r="30" /><circle class="cr" r="1.5" /><line class="vec" x1="0" y1="0" x2="@(F1(x.X * 1000))" y2="@(F1(-x.Y * 1000))" /><circle class="pt" cx="@(F1(x.X * 1000))" cy="@(F1(-x.Y * 1000))" r="3" /></svg>
                                <span class="v">@(F1(T.OffsetMm(r))) mm</span></div>
                        }
                    </div>
                    <svg class="atis-spark" viewBox="0 0 360 50" preserveAspectRatio="none">
                        <polyline class="jig" points="@(Series(Runner.JiggleSeries, 30, 50))" />
                        <polyline class="land" points="@(Series(Runner.LandingSeries, 150, 50))" />
                        <polyline class="bic" points="@(Series(Runner.BicepsSeries, 1, 50))" />
                    </svg>
                    <div class="atis-legend"><i class="jig"></i>지글 최대 변위(0–30 mm) <i class="land"></i>착지 감속(0–150 m/s²) <i class="bic"></i>오른 이두 활성</div>
                </div>

                <div class="atis-card">
                    <div class="atis-sec">〽 동적 압축 주름 법선 맵 <button class="atis-btn sm @(T.WrinkleEnabled ? "on" : null)" @onclick="() => Runner.SetWrinkles(!T.WrinkleEnabled)">주름</button>
                        <select class="atis-sel" value="@(Runner.MapTube)" @onchange="e => Runner.MapTube = (int)Num(e, 0)">
                            @for (var t = 0; t < NeuralAnatomicalMuscleFasciaEngine.Tubes; t++) { <option value="@(t)">@(NeuralAnatomicalMuscleFasciaEngine.TubeNames[t])</option> }
                        </select></div>
                    <div class="atis-wmap">
                        <img src="data:image/bmp;base64,@(Runner.MonitorBase64(1))" alt="wrinkle normal map" />
                        <div class="atis-ctl col">
                            <label class="atis-sl">주름 진폭 <b>@(F1(T.WrinkleAmplitude * 1000)) mm</b><input type="range" min="0" max="6" step="0.1" value="@(F1(T.WrinkleAmplitude * 1000))" @onchange="e => Runner.SetWrinkleAmplitude((float)Num(e, 2.5))" /></label>
                            <div class="atis-kv">최대 압축 변형률 <b>@(F2(T.MaxStrain))</b> · 주름 정점 <b>@(T.WrinkledVertices)</b> · 파장 @(F0(SoftTissueInertialDynamicsWrinkleSynthesizer.Lambda * 1000)) mm</div>
                            <div class="atis-dim">탄젠트 공간 RGB(x = 둘레 · y = 축) · 튜브 전개 @(SoftTissueInertialDynamicsWrinkleSynthesizer.MapW)×@(SoftTissueInertialDynamicsWrinkleSynthesizer.MapH)</div>
                        </div>
                    </div>
                </div>

                <div class="atis-card">
                    <div class="atis-sec">🧊 체적 비압축 · 자가 교차 가드
                        <button class="atis-btn sm @(G.VolumeGuard ? "on" : null)" @onclick="() => Runner.SetVolumeGuard(!G.VolumeGuard)">체적 보존</button>
                        <button class="atis-btn sm @(G.IntersectionGuard ? "on" : null)" @onclick="() => Runner.SetIntersectionGuard(!G.IntersectionGuard)">교차 락</button>
                        <span class="atis-chip @(G.InvertedAfter == 0 ? "ok" : "bad")">역전 사면체 @(G.InvertedBefore) → @(G.InvertedAfter)</span>
                    </div>
                    <div class="atis-ctl"><label class="atis-sl">체적 하한 α <b>@(F2(G.MinRatio))</b><input type="range" min="0.3" max="1" step="0.01" value="@(F2(G.MinRatio))" @onchange="e => Runner.SetMinRatio((float)Num(e, 0.75))" /></label></div>
                    <div class="atis-kv">최소 체적비 <b>@(F2(G.MinVolumeRatioBefore)) → @(F2(G.MinFreeRatioAfter))</b>(비접촉) · 붕괴 사면체 <b>@(G.CollapsedBefore) → @(G.CollapsedAfter)</b> · 주름면 접촉 압착 @(G.ContactCompressed) · 총 @(TissueVolumePreservationSelfIntersectionGuard.TetCount)</div>
                    <div class="atis-kv">튜브 체적비 @for (var t = 0; t < NeuralAnatomicalMuscleFasciaEngine.Tubes; t++) { <span>@(NeuralAnatomicalMuscleFasciaEngine.TubeNames[t]) <b>@(F2(G.TubeVolumeRatio(t)))</b></span> }</div>
                    <div class="atis-kv">자가 교차 <b>@(G.IntersectionsBefore) → @(G.IntersectionsAfter)</b> 정점 · 최대 깊이 @(F1(G.MaxIntersectionMm)) → @(F2(G.ResidualIntersectionMm)) mm · 락 @(G.LockedVertices)</div>
                    <svg class="atis-spark" viewBox="0 0 360 50" preserveAspectRatio="none">
                        <polyline class="vb" points="@(Series(Runner.VolumeBeforeSeries, 1, 50))" />
                        <polyline class="va" points="@(Series(Runner.VolumeAfterSeries, 1, 50))" />
                    </svg>
                    <div class="atis-legend"><i class="vb"></i>최소 체적비(가드 전 · 0–1) <i class="va"></i>가드 후</div>
                </div>
                <div class="atis-note">@(Runner.LastAction ?? "대기")</div>
            </div>
        </div>
    </div>
</div>

<style>
    .atis-scrim { position: fixed; inset: 0; z-index: var(--z-studio-modal); background: rgba(0,0,0,.62); display: flex; align-items: center; justify-content: center; padding: 20px; }
    .atis-modal { width: min(1680px, 97vw); max-height: 94vh; display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--line); border-radius: 18px; box-shadow: 0 24px 60px rgba(0,0,0,.45); overflow: hidden; }
    .atis-h { display: flex; justify-content: space-between; gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--line); background: linear-gradient(120deg, color-mix(in srgb, #ef4444 13%, var(--card)), color-mix(in srgb, #f59e0b 12%, var(--card))); }
    .atis-title { font-size: 17px; font-weight: 900; color: var(--text-primary); }
    .atis-sub { font-size: 12px; color: var(--text-secondary); margin-top: 4px; line-height: 1.5; } .atis-sub b { color: var(--text-primary); }
    .atis-x { background: none; border: none; color: var(--text-muted); font-size: 18px; cursor: pointer; border-radius: 8px; }
    .atis-bar { display: flex; flex-wrap: wrap; gap: 6px 10px; padding: 10px 20px; border-bottom: 1px solid var(--line); align-items: center; }
    .atis-btn { font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 8px; border: 1px solid var(--line); background: transparent; color: var(--text-primary); cursor: pointer; } .atis-btn:disabled { opacity: .4; cursor: default; }
    .atis-btn.sm { font-size: 10px; padding: 2px 8px; } .atis-btn.on { background: color-mix(in srgb, #ef4444 22%, transparent); border-color: #f87171; }
    .atis-chip { font: 700 11px var(--mono); padding: 3px 8px; border-radius: 999px; border: 1px solid var(--line); color: var(--text-secondary); }
    .atis-chip.ok { border-color: #22c55e; color: #86efac; } .atis-chip.bad { border-color: #ef4444; color: #fca5a5; } .atis-chip.warn { border-color: #eab308; color: #fde68a; }
    .atis-sl { display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--text-secondary); } .atis-sl b { font-family: var(--mono); color: var(--text-primary); } .atis-sl input { width: 90px; }
    .atis-sel { font-size: 11px; background: transparent; color: var(--text-primary); border: 1px solid var(--line); border-radius: 6px; padding: 3px 6px; }
    .atis-dim { font-size: 11px; font-weight: 500; color: var(--text-muted); }
    .atis-main { display: grid; grid-template-columns: 1.05fr 1fr; gap: 14px; padding: 14px 20px; min-height: 0; flex: 1; overflow-y: auto; }
    .atis-col { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
    .atis-card { border: 1px solid var(--line); border-radius: 12px; padding: 12px; display: flex; flex-direction: column; gap: 8px; }
    .atis-sec { font-weight: 800; font-size: 13px; color: var(--text-primary); display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
    .atis-ctl { display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: center; } .atis-ctl.col { flex-direction: column; align-items: flex-start; }
    .atis-vp { width: 100%; max-height: 560px; aspect-ratio: 520 / 560; background: radial-gradient(ellipse at 50% 40%, #1c1917, #020617); border-radius: 10px; }
    .atis-vp .ground { stroke: rgba(148,163,184,.3); stroke-dasharray: 6 4; }
    .atis-vp .ring { fill: none; stroke: rgba(253,224,200,.28); stroke-width: .8; } .atis-vp .lon { fill: none; stroke-width: 1.2; }
    .atis-vp .mus { stroke-linecap: round; opacity: .72; } .atis-vp .bone { stroke: #e2e8f0; stroke-width: 2.4; stroke-linecap: round; } .atis-vp .jt { fill: #f8fafc; }
    .atis-heat { display: grid; grid-template-columns: 96px 1fr; gap: 6px; align-items: stretch; }
    .atis-heat .names { display: flex; flex-direction: column; justify-content: space-around; font-size: 10px; color: var(--text-secondary); }
    .atis-heat img { width: 100%; height: 210px; image-rendering: pixelated; border-radius: 6px; }
    .atis-mtab { display: flex; flex-direction: column; gap: 2px; font-size: 10px; }
    .atis-mtab .hd, .atis-mtab .rw { display: grid; grid-template-columns: 96px 1fr 44px 60px 60px; gap: 6px; align-items: center; }
    .atis-mtab .hd { color: var(--text-muted); font-weight: 700; } .atis-mtab .nm { color: var(--text-secondary); } .atis-mtab .v { font-family: var(--mono); color: var(--text-primary); text-align: right; }
    .atis-mtab .bar { height: 8px; background: #1e293b; border-radius: 4px; overflow: hidden; } .atis-mtab .bar span { display: block; height: 100%; }
    .atis-regions { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }
    .atis-rg { display: flex; flex-direction: column; align-items: center; gap: 2px; font-size: 10px; } .atis-rg .nm { color: var(--text-secondary); font-weight: 700; } .atis-rg .v { font-family: var(--mono); color: var(--text-primary); }
    .atis-rg svg { width: 64px; height: 64px; background: #030712; border-radius: 50%; }
    .atis-rg .lim { fill: none; stroke: rgba(148,163,184,.35); stroke-dasharray: 3 2; } .atis-rg .cr { fill: #64748b; } .atis-rg .vec { stroke: #f472b6; stroke-width: 1.5; } .atis-rg .pt { fill: #f9a8d4; }
    .atis-wmap { display: grid; grid-template-columns: 128px 1fr; gap: 10px; align-items: start; } .atis-wmap img { width: 128px; height: 192px; image-rendering: pixelated; border-radius: 6px; }
    .atis-spark { width: 100%; height: 50px; background: #030712; border-radius: 6px; }
