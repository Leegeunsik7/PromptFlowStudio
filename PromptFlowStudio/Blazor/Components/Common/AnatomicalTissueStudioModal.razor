@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private const float Zoom = 300f;
    private System.Threading.Timer? _timer;
    private double _yaw = 30, _pitch = 8;
    private bool _skel = true, _muscle = true, _skin = true;
    private int _skinColor;

    private NeuralAnatomicalMuscleFasciaEngine E => Runner.Engine;
    private SoftTissueInertialDynamicsWrinkleSynthesizer T => Runner.Tissue;
    private TissueVolumePreservationSelfIntersectionGuard G => Runner.Guard;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("AnatomicalTissue.Modal.Timer", ex); }
        }, null, 250, 250);
    }

    private static string F0(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "0" : v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0.00", CultureInfo.InvariantCulture);
    private static double Num(ChangeEventArgs e, double fallback) => double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : fallback;

    /// <summary>궤도 정사영(몸 중심 · 골반 수평 추종).</summary>
    private Vector2 P(Vector3 w)
    {
        var root = E.Joint(0);
        var p = new Vector3(w.X - root.X, w.Y - 0.9f, w.Z - root.Z);
        float yaw = (float)(_yaw * Math.PI / 180), pitch = (float)(_pitch * Math.PI / 180);
        float cy = MathF.Cos(yaw), sy = MathF.Sin(yaw), cp = MathF.Cos(pitch), sp = MathF.Sin(pitch);
        var x = p.X * cy + p.Z * sy;
        var z = -p.X * sy + p.Z * cy;
        var y = p.Y * cp + z * sp;
        return new Vector2(260 + x * Zoom, 290 - y * Zoom);
    }

    private static string Heat(double t)
    {
        t = Math.Clamp(t, 0, 1);
        double r = Math.Clamp(1.5 - Math.Abs(4 * t - 3), 0, 1), g = Math.Clamp(1.5 - Math.Abs(4 * t - 2), 0, 1), b = Math.Clamp(1.5 - Math.Abs(4 * t - 1), 0, 1);
        if (t < 0.12) { var k = t / 0.12; r *= k; g *= k; b *= k; }
        return "rgb(" + F0(r * 255) + "," + F0(g * 255) + "," + F0(b * 255) + ")";
    }

    private string RingPath(int ring)
    {
        var sb = new System.Text.StringBuilder(NeuralAnatomicalMuscleFasciaEngine.Segs * 14);
        for (var j = 0; j <= NeuralAnatomicalMuscleFasciaEngine.Segs; j++)
        {
            var q = P(E.Position(ring * NeuralAnatomicalMuscleFasciaEngine.Segs + j % NeuralAnatomicalMuscleFasciaEngine.Segs));
            sb.Append(j == 0 ? 'M' : 'L').Append(F1(q.X)).Append(',').Append(F1(q.Y));
        }
        return sb.ToString();
    }

    private string LonPath(int tube, int seg)
    {
        var sb = new System.Text.StringBuilder(NeuralAnatomicalMuscleFasciaEngine.Rings * 14);
        for (var i = 0; i < NeuralAnatomicalMuscleFasciaEngine.Rings; i++)
        {
            var q = P(E.Position(NeuralAnatomicalMuscleFasciaEngine.Vertex(tube, i, seg)));
            sb.Append(i == 0 ? 'M' : 'L').Append(F1(q.X)).Append(',').Append(F1(q.Y));
        }
        return sb.ToString();
    }

    /// <summary>경선 색(중간 링 정점 기준 선택 지표).</summary>
    private string LonColor(int tube, int seg)
    {
        double mx = 0;
        for (var i = 0; i < NeuralAnatomicalMuscleFasciaEngine.Rings; i++)
        {
            var v = NeuralAnatomicalMuscleFasciaEngine.Vertex(tube, i, seg);
            double val = _skinColor switch
            {
                1 => T.Strain(v) * 4,
                2 => (E.Position(v) - E.BasePosition(v)).Length() * 40,
                3 => 1 - VertexVolume(v),
                _ => StressAt(v),
            };
            if (val > mx) mx = val;
        }
        return Heat(mx);
    }

    private double StressAt(int v)
    {
        double s = 0;
        for (var m = 0; m < NeuralAnatomicalMuscleFasciaEngine.MuscleCount; m++) s += E.Influence(m, v) * E.Stress(m);
        return s / 1.2;
    }

    private double VertexVolume(int v)
    {
        var ring = v / NeuralAnatomicalMuscleFasciaEngine.Segs;
        var t = ring / NeuralAnatomicalMuscleFasciaEngine.Rings; var i = ring % NeuralAnatomicalMuscleFasciaEngine.Rings;
        if (i >= NeuralAnatomicalMuscleFasciaEngine.Rings - 1) return 1;
        var k = ((t * (NeuralAnatomicalMuscleFasciaEngine.Rings - 1) + i) * NeuralAnatomicalMuscleFasciaEngine.Segs + v % NeuralAnatomicalMuscleFasciaEngine.Segs) * 3;
        return Math.Clamp(Math.Min(G.TetRatio(k), Math.Min(G.TetRatio(k + 1), G.TetRatio(k + 2))), 0, 1);
    }

    private string Series(Func<int, float> f, double max, double h)
    {
        var n = Runner.SeriesCount;
        if (n < 2) return "";
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = n - 1; i >= 0; i--)
            sb.Append(F1(360.0 * (n - 1 - i) / (AnatomicalTissueStudioRunner.SeriesLen - 1))).Append(',').Append(F1(h - 2 - (h - 4) * Math.Clamp(f(i) / max, 0, 1))).Append(' ');
        return sb.ToString();
    }

    private void ToggleRun() { if (Runner.IsRunning) Runner.Stop(); else Runner.Start(); }
    private void Step60() { for (var i = 0; i < AnatomicalTissueStudioRunner.Hz; i++) Runner.Step(); }

    private Task Close() => OnClose.InvokeAsync();

    /// <summary>가동 중(10 Hz 이벤트)은 250 ms 타이머가 처리 — 정지 상태 액션만 즉시 반영.</summary>
    private void OnServiceChanged() { if (!Runner.IsRunning) _ = InvokeAsync(StateHasChanged); }

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
