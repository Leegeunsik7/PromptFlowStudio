@using System.Globalization
@using PromptFlowStudio.Services.Production
@implements IDisposable
@inject EnterpriseProductionReleaseStudioRunner Runner

@*
    [PromptFlow Studio v16.66.0] 🚀 AI 엔터프라이즈 상용 릴리스 스튜디오 — 클라우드-에지 OTA 델타 동기화 현황 · 링크 단절/패킷 변조 ·
    AI 자율 복구 게이지 · 결함 주입(예외/누수/데드락/행) · 서명 진단 리포트 · 1-Click 5 플랫폼 패키징/무결성 검증.
*@

<div class="erl-scrim" @onclick="Close">
    <div class="erl-modal" @onclick:stopPropagation="true">
        <div class="erl-h">
            <div>
                <div class="erl-title">🚀 AI 엔터프라이즈 상용 릴리스 스튜디오</div>
                <div class="erl-sub"><b>로컬 · 에지 · 클라우드</b> 간 스토리보드/4D 월드/AI 핫패치를 <b>바이트 델타 OTA</b>로 무단절 동기화하고,
                    런타임 결함은 <b>AI 자율 복구</b>로 격리·재시작합니다. 5개 플랫폼 산출물은 <b>ECDSA 서명 · 변조 · 트림/AOT</b> 규칙으로 검증합니다.</div>
            </div>
            <button class="erl-x" @onclick="Close">✕</button>
        </div>

        <div class="erl-bar">
            <span class="erl-chip @(Runner.IsRunning ? "ok" : null)">@(Runner.IsRunning ? "● 라이브" : "○ 정지") · #@(Runner.FrameSeq)</span>
            <span class="erl-chip">델타 @(Pct(S.DeltaRatio)) · 전송 @(Kb(S.BytesSent)) / 전체 @(Kb(S.FullBytesEquivalent))</span>
            <span class="erl-chip">동기화 @(S.Syncs) · 수렴 @(S.Converges) · @(F1(S.LastConvergeMs))ms</span>
            <span class="erl-chip @(S.Rollbacks > 0 ? "hot" : null)">롤백 @(S.Rollbacks) · 재비교 @(S.Restarts) · 일시정지 @(S.PausedTicks)</span>
            <span class="erl-chip @(Q.HealthGauge >= 0.99f ? "ok" : "hot")">자율 복구 @(Q.Healed) · 격리 @(Q.Quarantines)</span>
            <span class="erl-chip">패키징 @(P.Packaged) · 검증 @(P.Verified) · 실패 @(P.Failed)</span>
        </div>

        <div class="erl-main">
            <div class="erl-col">
                <div class="erl-card">
                    <div class="erl-row erl-between">
                        <span class="erl-sec">☁ 클라우드-에지 OTA 동기화</span>
                        <span class="erl-row">
                            <button class="erl-btn @(Runner.IsRunning ? "on" : null)" @onclick="Toggle">@(Runner.IsRunning ? "⏸ 정지" : "▶ 라이브")</button>
                            <button class="erl-btn sm" @onclick="Step">⏭ 1틱</button>
                        </span>
                    </div>
                    <table class="erl-tbl">
                        <thead><tr><th>자산</th>@for (var t = 0; t < GlobalCloudEdgeOtaSyncEngine.Tiers; t++) { <th>@(GlobalCloudEdgeOtaSyncEngine.TierLabel((SyncTier)t))</th> }<th></th></tr></thead>
                        <tbody>
                            @for (var a = 0; a < S.AssetCount; a++)
                            {
                                var id = a;
                                <tr>
                                    <td><b>@(GlobalCloudEdgeOtaSyncEngine.KindLabel(S.KindOf(id)))</b><em>@(S.NameOf(id)) · @(Kb(S.LengthOf(id)))</em></td>
                                    @for (var t = 0; t < GlobalCloudEdgeOtaSyncEngine.Tiers; t++)
                                    {
                                        var st = S.StatusOf(id, (SyncTier)t);
                                        <td>
                                            <span class="erl-ver">v@(st.Version)</span>
                                            @if (st.Transferring)
                                            {
                                                <div class="erl-mbar @(st.Paused ? "pause" : null)"><i style="width:@(Pc(st.Progress))"></i></div>
                                                <em>← @(GlobalCloudEdgeOtaSyncEngine.TierLabel(st.From))@(st.Paused ? " · 일시정지" : "")</em>
                                            }
                                        </td>
                                    }
                                    <td>@(S.IsConverged(id) ? "✅" : "⟳")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="erl-links">
                        @foreach (var (a, b) in Links)
                        {
                            var la = a; var lb = b;
                            var up = S.IsLinkUp(la, lb);
                            <button class="erl-link @(up ? null : "down")" @onclick="() => S.SetLinkUp(la, lb, !up)">
                                @(GlobalCloudEdgeOtaSyncEngine.TierLabel(la)) ↔ @(GlobalCloudEdgeOtaSyncEngine.TierLabel(lb))
                                <em>@(F0(S.LatencyOf(la, lb)))ms · @(F0(S.MbpsOf(la, lb)))Mbps · @(up ? "연결" : "✂ 단절")</em>
                            </button>
                        }
                    </div>
                    <div class="erl-row">
                        <button class="erl-btn sm" @onclick="Runner.PublishHotPatch">🩹 클라우드 핫패치 발행</button>
                        <button class="erl-btn sm hot" @onclick="S.CorruptNextPacket">☣ 패킷 변조 주입</button>
                    </div>
                    <div class="erl-note">OTA1 패킷 @(S.Packets) · 동일 블록 생략 @(S.SkippedBlocks) · 불량 @(S.BadPackets) — 섀도 슬롯 SHA-256 검증 후 원자 교체(독자 무단절)</div>
                </div>

                <div class="erl-card">
                    <div class="erl-row erl-between">
                        <span class="erl-sec">📦 1-Click 엔터프라이즈 패키징 · 무결성 검증</span>
                        <button class="erl-btn @(Runner.IsPackaging ? "on" : null)" @onclick="Runner.TogglePackaging">@(Runner.IsPackaging ? "⏹ 취소" : "📦 1-Click 패키징")</button>
                    </div>
                    <table class="erl-tbl">
                        <thead><tr><th>플랫폼</th><th>판정</th><th>서명</th><th>파일</th><th>변조/누락/추가</th><th>포맷</th><th>트림/AOT</th></tr></thead>
                        <tbody>
                            @foreach (var r in Runner.Reports)
                            {
                                <tr class="@(r.Passed ? null : "bad")">
                                    <td><b>@(EnterpriseProductionPackagingVerifier.PlatformLabel(r.Platform))</b></td>
                                    <td>@(r.Passed ? "✅ 통과" : "❌ 실패")</td>
                                    <td>@(r.SignatureValid && r.ManifestConsistent ? "ECDSA ✓" : "✗")</td>
                                    <td>@(r.Files) · @(Kb(r.TotalBytes))</td>
                                    <td>@(r.Modified)/@(r.Missing)/@(r.Extra)</td>
                                    <td>@(r.FormatMismatches == 0 ? "✓" : r.FormatMismatches.ToString(CultureInfo.InvariantCulture))</td>
                                    <td>@(OptionNote(r))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (Runner.Reports.Count == 0)
                    {
                        <div class="erl-note">Windows는 실행 폴더 실 산출물(*.dll/*.exe), 그 외는 플랫폼 매직이 맞는 데모 산출물로 패키징합니다.</div>
                    }
                </div>
            </div>

            <div class="erl-col">
                <div class="erl-card">
                    <div class="erl-sec">🛡 AI 자율 복구 게이지</div>
                    <div class="erl-gauge-wrap">
                        <svg class="erl-gauge" viewBox="0 0 120 70">
                            <path d="M10,60 A50,50 0 0 1 110,60" class="bg" />
                            <path d="M10,60 A50,50 0 0 1 110,60" class="fg" style="stroke-dasharray:@(F1(157 * Q.HealthGauge)) 200; stroke:@(GaugeColor(Q.HealthGauge))" />
                            <g><text x="60" y="56" class="v">@(Pc(Q.HealthGauge))</text></g>
                        </svg>
                        <div class="erl-note">복구 @(Q.Healed) · 예외 @(Q.Exceptions) · 누수 @(Q.Leaks) · 데드락 @(Q.Deadlocks) · 행 @(Q.Hangs)<br />평균 격리 복구 @(F0(Q.MeanRecoveryMs))ms · 핸들러 결함 @(Q.HandlerFaults)</div>
                    </div>
                    <table class="erl-tbl">
                        <thead><tr><th>모듈</th><th>상태</th><th>재시작</th><th>결함 주입</th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < EnterpriseProductionReleaseStudioRunner.ModuleNames.Length; i++)
                            {
                                var mi = i;
                                var m = Runner.ModuleId(mi);
                                var h = Q.HealthOf(m);
                                <tr>
                                    <td>@(EnterpriseProductionReleaseStudioRunner.ModuleNames[mi])</td>
                                    <td><span class="erl-hs h@((int)h)">@(AiSelfHealingQaTelemetryAuditor.HealthLabel(h))</span></td>
                                    <td>@(Q.RestartsOf(m))</td>
                                    <td class="erl-inj">
                                        <button class="erl-btn sm" title="예외 버스트" @onclick="() => Runner.InjectExceptionBurst(mi)">💥</button>
                                        <button class="erl-btn sm @(Runner.IsLeaking(mi) ? "on" : null)" title="메모리 누수" @onclick="() => Runner.InjectLeak(mi)">💧</button>
                                        <button class="erl-btn sm @(Runner.IsHung(mi) ? "on" : null)" title="행" @onclick="() => Runner.InjectHang(mi)">🧊</button>
                                        <button class="erl-btn sm" title="다음 모듈과 데드락" @onclick="() => Runner.InjectDeadlock(mi, (mi + 1) % EnterpriseProductionReleaseStudioRunner.ModuleNames.Length)">🔒</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="erl-card">
                    <div class="erl-row erl-between">
                        <span class="erl-sec">🧾 사고 로그 · 제로 트러스트 진단 리포트</span>
                        <button class="erl-btn sm" @onclick="BuildReport">🔏 서명 리포트 생성</button>
                    </div>
                    <div class="erl-inc">
                        @for (var i = 0; i < _incCount; i++)
                        {
                            var x = _inc[i];
                            <div class="@(x.Healed ? "ok" : null)">#@(x.Seq) <b>@(AiSelfHealingQaTelemetryAuditor.KindLabel(x.Kind))</b> · @(Q.NameOf(x.Module)) · @(F0(x.AtMs))ms @(x.Healed ? "· 복구됨" : "")</div>
                        }
                    </div>
                    @if (_report is not null)
                    {
                        <div class="erl-note">리포트 @(_report.Payload.Length)B · 사고 @(_report.Incidents) · 기밀 마스킹 <b>@(_report.Redactions)</b> · HMAC-SHA256 @(_reportOk ? "검증 ✓" : "✗")</div>
                        <div class="erl-out">@_reportPreview</div>
                    }
                </div>
                @if (Runner.LastAction is not null)
                {
                    <div class="erl-note">@Runner.LastAction</div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .erl-scrim { position: fixed; inset: 0; z-index: var(--z-studio-modal); background: rgba(0,0,0,.6); display: flex; align-items: center; justify-content: center; padding: 20px; }
    .erl-modal { width: min(1560px, 97vw); max-height: 94vh; display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--line); border-radius: 18px; box-shadow: 0 24px 60px rgba(0,0,0,.45); overflow: hidden; }
    .erl-h { display: flex; justify-content: space-between; gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--line); background: linear-gradient(120deg, color-mix(in srgb, #6366f1 18%, var(--card)), color-mix(in srgb, #06b6d4 14%, var(--card))); }
    .erl-title { font-size: 17px; font-weight: 900; color: var(--text-primary); }
    .erl-sub { font-size: 12px; color: var(--text-secondary); margin-top: 4px; line-height: 1.5; }
    .erl-sub b { color: var(--text-primary); }
    .erl-x { background: none; border: none; color: var(--text-muted); font-size: 18px; cursor: pointer; border-radius: 8px; }
    .erl-bar { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 20px; border-bottom: 1px solid var(--line); }
    .erl-chip { font: 700 11px var(--mono); padding: 3px 8px; border-radius: 999px; border: 1px solid var(--line); color: var(--text-muted); }
    .erl-chip.ok { color: #22c55e; border-color: #22c55e; }
    .erl-chip.hot { color: #f97316; border-color: #f97316; }
    .erl-main { display: grid; grid-template-columns: 1.15fr 1fr; gap: 14px; padding: 14px 20px; min-height: 0; flex: 1; overflow-y: auto; }
    .erl-col { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
    .erl-card { border: 1px solid var(--line); border-radius: 12px; padding: 12px; display: flex; flex-direction: column; gap: 8px; }
    .erl-sec { font-weight: 800; font-size: 13px; color: var(--text-primary); }
    .erl-row { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
    .erl-between { justify-content: space-between; }
    .erl-btn { font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 8px; border: 1px solid var(--line); background: transparent; color: var(--text-primary); cursor: pointer; }
    .erl-btn.on { background: color-mix(in srgb, #6366f1 22%, transparent); border-color: #6366f1; }
    .erl-btn.hot { background: color-mix(in srgb, #ef4444 20%, transparent); border-color: #ef4444; }
    .erl-btn.sm { font-size: 11px; padding: 3px 8px; }
    .erl-tbl { width: 100%; border-collapse: collapse; font-size: 11px; }
    .erl-tbl th, .erl-tbl td { padding: 4px 5px; border-bottom: 1px solid var(--line); text-align: left; color: var(--text-secondary); vertical-align: top; }
    .erl-tbl th { color: var(--text-muted); font-weight: 700; }
    .erl-tbl td b { color: var(--text-primary); display: block; }
    .erl-tbl td em { font-style: normal; font-size: 10px; color: var(--text-muted); display: block; }
    .erl-tbl tr.bad td { color: #f97316; }
    .erl-ver { font: 800 11px var(--mono); color: var(--text-primary); }
    .erl-mbar { height: 5px; min-width: 50px; border-radius: 3px; background: color-mix(in srgb, var(--line) 70%, transparent); overflow: hidden; margin-top: 2px; }
    .erl-mbar i { display: block; height: 100%; background: linear-gradient(90deg, #6366f1, #06b6d4); }
    .erl-mbar.pause i { background: #f97316; }
    .erl-links { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
    .erl-link { font-size: 11px; font-weight: 700; padding: 6px; border-radius: 8px; border: 1px solid #06b6d4; background: color-mix(in srgb, #06b6d4 10%, transparent); color: var(--text-primary); cursor: pointer; display: flex; flex-direction: column; gap: 2px; }
    .erl-link em { font-style: normal; font-weight: 600; font-size: 10px; color: var(--text-muted); }
    .erl-link.down { border-color: #ef4444; background: color-mix(in srgb, #ef4444 14%, transparent); }
    .erl-gauge-wrap { display: flex; gap: 12px; align-items: center; }
    .erl-gauge { width: 150px; flex-shrink: 0; }
    .erl-gauge path { fill: none; stroke-width: 10; stroke-linecap: round; }
    .erl-gauge .bg { stroke: color-mix(in srgb, var(--line) 80%, transparent); }
    .erl-gauge .fg { transition: stroke-dasharray .3s; }
    .erl-gauge .v { fill: var(--text-primary); font: 900 15px var(--mono); text-anchor: middle; }
    .erl-hs.h0 { color: #22c55e; } .erl-hs.h1 { color: #eab308; } .erl-hs.h2 { color: #ef4444; font-weight: 800; } .erl-hs.h3 { color: #06b6d4; }
    .erl-inj { display: flex; gap: 3px; }
    .erl-inc { max-height: 150px; overflow-y: auto; font: 10.5px var(--mono); color: #f97316; display: flex; flex-direction: column; gap: 2px; }
    .erl-inc .ok { color: var(--text-muted); }
    .erl-inc b { color: var(--text-primary); }
    .erl-note { font-size: 11px; color: var(--text-muted); }
    .erl-note b { color: var(--text-primary); }
    .erl-out { font: 10px var(--mono); color: #67e8f9; background: color-mix(in srgb, #06b6d4 10%, transparent); border-radius: 8px; padding: 6px 8px; max-height: 120px; overflow: auto; white-space: pre-wrap; word-break: break-all; }
    @@media (max-width: 1200px) { .erl-main { grid-template-columns: 1fr; } }
</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private static readonly (SyncTier, SyncTier)[] Links = { (SyncTier.Local, SyncTier.Edge), (SyncTier.Edge, SyncTier.Cloud), (SyncTier.Local, SyncTier.Cloud) };
    private readonly QaIncident[] _inc = new QaIncident[12];
    private int _incCount;
    private SignedDiagnosticReport? _report;
    private bool _reportOk;
    private string _reportPreview = "";
    private long _shownSeq = -1;
    private System.Threading.Timer? _timer;

    private GlobalCloudEdgeOtaSyncEngine S => Runner.Sync;
    private AiSelfHealingQaTelemetryAuditor Q => Runner.Qa;
    private EnterpriseProductionPackagingVerifier P => Runner.Packager;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        S.OnChange += OnServiceChanged;
        Q.OnChange += OnServiceChanged;
        P.OnChange += OnServiceChanged;
        if (Runner.FrameSeq == 0) Runner.TickOnce(1000.0 / EnterpriseProductionReleaseStudioRunner.TickHz);
        Refresh();
        _timer = new System.Threading.Timer(_ =>
        {
            try { if (Runner.FrameSeq != _shownSeq) _ = InvokeAsync(() => { Refresh(); StateHasChanged(); }); }
            catch (ObjectDisposedException) { }
        }, null, 250, 250);
    }

    private static string F0(double v) => double.IsNaN(v) ? "—" : v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => double.IsNaN(v) ? "—" : v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string Pc(float v) => (Math.Clamp(v, 0f, 1f) * 100f).ToString("0", CultureInfo.InvariantCulture) + "%";
    private static string Pct(float v) => (v * 100f).ToString("0.0", CultureInfo.InvariantCulture) + "%";
    private static string Kb(long b) => b >= 1024 * 1024 ? (b / 1048576.0).ToString("0.0", CultureInfo.InvariantCulture) + "MB" : (b / 1024.0).ToString("0.0", CultureInfo.InvariantCulture) + "KB";
    private static string GaugeColor(float g) => "hsl(" + ((int)(g * 130)).ToString(CultureInfo.InvariantCulture) + ",80%,50%)";

    private static string OptionNote(PlatformVerifyReport r)
    {
        foreach (var f in r.Findings) if (f.Code is not ("TAMPER" or "MISSING" or "EXTRA" or "FMT" or "SIG" or "MANIFEST")) return (f.Error ? "❌ " : "⚠ ") + f.Code;
        return "✓";
    }

    private void Refresh()
    {
        _shownSeq = Runner.FrameSeq;
        _incCount = Q.CopyIncidents(_inc);
    }

    private void Toggle() { if (Runner.IsRunning) Runner.Stop(); else Runner.Start(); }
    private void Step() { Runner.TickOnce(1000.0 / EnterpriseProductionReleaseStudioRunner.TickHz); Refresh(); }

    private void BuildReport()
    {
        _report = Q.BuildReport();
        _reportOk = Q.VerifyReport(_report.Payload, _report.Signature);
        var text = System.Text.Encoding.UTF8.GetString(_report.Payload);
        _reportPreview = text.Length > 1200 ? text[..1200] + "…" : text;
    }

    private Task Close() => OnClose.InvokeAsync();

    private void OnServiceChanged() => _ = InvokeAsync(() => { Refresh(); StateHasChanged(); });

    public void Dispose()
    {
        _timer?.Dispose();
        Runner.OnChange -= OnServiceChanged;
        S.OnChange -= OnServiceChanged;
        Q.OnChange -= OnServiceChanged;
        P.OnChange -= OnServiceChanged;
    }
}
