@using System.Globalization
@using PromptFlowStudio.Services.ProceduralFoley
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable
@inject ProceduralFoleyStudioRunner Runner

@* [PromptFlow Studio v17.38.0] 🔊 AI 절차적 물리 폴리 스튜디오 — 모달 스펙트럼 · 재질 매트릭스 · 충격 에너지 vs 피크 · 마찰/스침 · 리미터/LUFS. *@

<div class="pfm-scrim" @onclick="Close">
    <div class="pfm-modal" @onclick:stopPropagation="true">
        <div class="pfm-h">
            <div>
                <div class="pfm-title">🔊 AI 절차적 물리 폴리 스튜디오 @(Runner.IsRunning ? "· ▶ 60 Hz · 48 kHz" : null)</div>
                <div class="pfm-sub"><b>모달 폴리 엔진</b>이 v17.37 래그돌 착지·강타와 v17.36 파지·낙하 접촉을 헤르츠 접촉(F_max · 접촉 시간 τ · 접촉 반경)으로 풀어 재질별 16 모드 바이쿼드 공진기 뱅크를 샘플 단위로 여기하고, <b>마찰/스침 합성기</b>가 쿨롱 슬립·지면 미끄럼 속도를 샷 노이즈 요철음으로, 관절 각가속도·의상 스트레인을 직물별 크래클로 합성합니다. <b>소프트 리미터 가드</b>는 4× 트루 피크 전방 예측 이득과 2차 소프트 클립으로 0 dBFS 초과를 막고 LUFS 를 감시한 뒤 v17.23 바이노럴 합성기로 공급합니다.</div>
            </div>
            <button class="pfm-x" @onclick="Close">✕</button>
        </div>
        <div class="pfm-bar">
            <button class="pfm-btn @(Runner.IsRunning ? "on" : null)" @onclick="ToggleRun">@(Runner.IsRunning ? "⏸ 정지" : "▶ 시작")</button>
            <button class="pfm-btn" @onclick="Step60" disabled="@Runner.IsRunning">⏭ 1초</button>
            <button class="pfm-btn @(Runner.AutoDemo ? "on" : null)" @onclick="() => Runner.SetAutoDemo(!Runner.AutoDemo)">🤖 자동 데모</button>
            <button class="pfm-btn warn" @onclick="() => Runner.Ragdoll.InjectImpulse(PromptFlowStudio.Services.NeuralRagdoll.RagdollJoint.Chest, 160f, 0f)">🤸 전도 강타</button>
            <button class="pfm-btn warn" @onclick="() => Runner.Dex.InjectImpulse()">🤲 소품 충격</button>
            <button class="pfm-btn warn" @onclick="() => Runner.CrowdBurst(300, 6f)">👥 군중 300 동시 충돌</button>
            <button class="pfm-btn @(Runner.Limiter.Enabled ? "on" : null)" @onclick="() => Runner.SetLimiter(!Runner.Limiter.Enabled)">🛡 소프트 리미터</button>
            <button class="pfm-btn @(Runner.SpatialFeed ? "on" : null)" @onclick="() => Runner.SpatialFeed = !Runner.SpatialFeed">🎧 v17.23 공간 공급</button>
            <button class="pfm-btn" @onclick="Runner.ResetMetrics">↺ 지표</button>
            <span class="pfm-chip @(Runner.LastTickMs <= 16.7 ? "ok" : "warn")">프레임 @(F2(Runner.LastTickMs)) ms(최대 @(F1(Runner.MaxTickMs))) · 모달 @(F0(Runner.Modal.LastRenderUs)) µs · 보이스 @(Runner.Modal.ActiveVoices)/@(RealtimeModalContactFoleyEngine.MaxVoices)</span>
        </div>
        <div class="pfm-main">
            <div class="pfm-col">
                <div class="pfm-card">
                    <div class="pfm-sec">📊 실시간 모달 주파수 스펙트럼(마스터 · 60 Hz–16 kHz 로그 48 대역) · 여기 모드 마커</div>
                    <svg class="pfm-spec" viewBox="0 0 480 160" preserveAspectRatio="none">
                        @for (var db = -100; db <= 0; db += 20)
                        {
                            var y = Y(db);
                            <line class="gr" x1="0" y1="@(F1(y))" x2="480" y2="@(F1(y))" />
                        }
                        @for (var b = 0; b < ProceduralFoleyStudioRunner.Bands; b++)
                        {
                            var lv = Runner.BandLevelDb(b);
                            var y = Y(lv);
                            <rect class="bar" x="@(F1(b * 10 + 1))" y="@(F1(y))" width="8" height="@(F1(160 - y))" />
                        }
                        @for (var k = 0; k < RealtimeModalContactFoleyEngine.Modes; k++)
                        {
                            var hz = FoleyMaterials.ModeHz(_mat, k);
                            if (hz < 60f || hz > 16000f) continue;
                            var x = X(hz); var lv = Runner.Modal.SpectrumLevel(_mat, k);
                            <line class="@(lv > 1e-6f ? "mk on" : "mk")" x1="@(F1(x))" y1="0" x2="@(F1(x))" y2="160" />
                        }
                    </svg>
                    <div class="pfm-axis"><span>60 Hz</span><span>250</span><span>1 k</span><span>4 k</span><span>16 kHz</span></div>
                </div>
                <div class="pfm-card">
                    <div class="pfm-sec">🧱 충돌체 재질 매트릭스(행 = 표면 · 열 = 충돌체 · 클릭 = 타격) · 속도 @(F1(_speed)) m/s</div>
                    <div class="pfm-matrix">
                        <span></span>
                        @foreach (var c in Matrix) { <b>@(Short(c))</b> }
                        @foreach (var rr in Matrix)
                        {
                            var row = rr;
                            <b>@(Short(row))</b>
                            @foreach (var c in Matrix)
                            {
                                var col = c;
                                RealtimeModalContactFoleyEngine.Hertz(row, col, 0.3f, 0.02f, _speed, out _, out var tau, out _, out _);
                                <button class="pfm-cell @(_mat == row && _imp == col ? "on" : null)" @onclick="() => Hit(row, col)">τ @(F2(tau * 1000)) ms</button>
                            }
                        }
                    </div>
                    <div class="pfm-row">
                        <span class="pfm-lbl">속도</span><input type="range" min="0.2" max="8" step="0.1" value="@(F1(_speed))" @oninput="e => _speed = (float)Num(e, 2)" />
                        <span class="pfm-lbl">바닥</span>
                        @foreach (var f in Floors)
                        {
                            var ff = f;
                            <button class="pfm-btn sm @(Runner.Floor == ff ? "on" : null)" @onclick="() => Runner.SetFloor(ff)">@(Short(ff))</button>
                        }
                        <span class="pfm-lbl">직물</span>
                        @foreach (var f in Fabrics)
                        {
                            var ff = f;
                            <button class="pfm-btn sm @(Runner.Friction.Fabric == ff ? "on" : null)" @onclick="() => Runner.SetFabric(ff)">@(FabricName(ff))</button>
                        }
                    </div>
                    <div class="pfm-mut">@(FoleyMaterials.Name(_mat)) · f₀ @(F0(FoleyMaterials.ModeHz(_mat, 0))) Hz · T60 @(F2(FoleyMaterials.T60(_mat, FoleyMaterials.ModeHz(_mat, 0)))) s · 최근 F @(F0(Runner.Modal.LastForceN)) N · τ @(F2(Runner.Modal.LastTauMs)) ms · 접촉 면적 @(F1(Runner.Modal.LastAreaMm2)) mm²</div>
                </div>
                <div class="pfm-card">
                    <div class="pfm-sec">〰 마스터 파형(최근 2048 샘플 · 천장 −1 dBTP 점선)</div>
                    <svg class="pfm-wave" viewBox="0 0 512 100" preserveAspectRatio="none">
                        <line class="ce" x1="0" y1="@(F1(50 - 45 * AcousticEnergyPeakSoftLimiterGuard.Ceiling))" x2="512" y2="@(F1(50 - 45 * AcousticEnergyPeakSoftLimiterGuard.Ceiling))" />
                        <line class="ce" x1="0" y1="@(F1(50 + 45 * AcousticEnergyPeakSoftLimiterGuard.Ceiling))" x2="512" y2="@(F1(50 + 45 * AcousticEnergyPeakSoftLimiterGuard.Ceiling))" />
                        <polyline class="wv" points="@(Wave())" />
                    </svg>
                </div>
            </div>
            <div class="pfm-col">
                <div class="pfm-card">
                    <div class="pfm-sec">⚡ 충격 에너지(J) vs 피크 음압(dBFS) · 4 s</div>
                    <svg class="pfm-spark" viewBox="0 0 360 90" preserveAspectRatio="none">
                        @((MarkupString)ScatterSvg())
                    </svg>
                    <div class="pfm-kv grid">
                        <div>최대 충격 <b>@(F1(Runner.Modal.MaxEnergyJ)) J</b> · 접촉 @(Runner.Modal.Contacts)</div>
                        <div>피크 @(F1(Runner.Modal.LastPeakDbfs)) dBFS(가드 전)</div>
                        <div>발 착지 @(Runner.Footsteps) · 전신 강타 @(Runner.BodyThuds)</div>
                        <div>파지 탭 @(Runner.GraspTaps) · 소품 낙하 @(Runner.PropDrops) · 군중 @(Runner.Bursts)</div>
                        <div>보이스 스틸 @(Runner.Modal.Steals) · 해제 @(Runner.Modal.Released)</div>
                        <div>렌더 최대 @(F0(Runner.Modal.MaxRenderUs)) µs · @(Runner.Modal.UseSimd ? "SIMD" : "스칼라")</div>
                    </div>
                </div>
                <div class="pfm-card">
                    <div class="pfm-sec">🧣 마찰 슬립 · 의상 스침 @(Runner.GarmentLinked ? "(v17.16 의상 스트레인 결선)" : "(관절 굴곡 대리 스트레인)")</div>
                    <div class="pfm-kv grid">
                        <div>손 슬립 A/B @(F1(Runner.Friction.SlipSpeed(0) * 1000)) / @(F1(Runner.Friction.SlipSpeed(1) * 1000)) mm/s</div>
                        <div>지면 스크레이프 @(F2(Runner.Friction.SlipSpeed(2))) m/s · N @(F0(Runner.Friction.NormalForce(2)))</div>
                        <div>마찰 RMS <b>@(F1(Runner.Friction.FrictionRmsDb)) dB</b> · 샷 @(Runner.Friction.Shots)</div>
                        <div>스침 RMS <b>@(F1(Runner.Friction.ClothRmsDb)) dB</b> · 크래클 @(Runner.Friction.Crackles)</div>
                        <div>스트레인 변화율 @(F3(Runner.ClothStrainRate)) /s</div>
                        <div>관절 각가속도 @(F0(Runner.ClothAngularAccel)) rad/s² · 구동 @(F2(Runner.Friction.ClothDrive))</div>
                    </div>
                </div>
                <div class="pfm-card">
                    <div class="pfm-sec">🛡 소프트 리미터 · LUFS 가드 @(Runner.Limiter.Enabled ? "ON" : "OFF(하드 클램프)")</div>
                    <div class="pfm-meters">
                        @Meter("트루 피크", Runner.Limiter.TruePeakOutDbtp, -60, 3, "dBTP")
                        @Meter("감쇄", -Runner.Limiter.GainReductionDb, -30, 0, "dB")
                        @Meter("모멘터리", Runner.Limiter.MomentaryLufs, -60, 0, "LUFS")
                        @Meter("숏텀", Runner.Limiter.ShortTermLufs, -60, 0, "LUFS")
                    </div>
                    <div class="pfm-kv grid">
                        <div>입력 초과 샘플 <b class="@(Runner.Limiter.OversIn == 0 ? "ok" : "warn")">@(Runner.Limiter.OversIn)</b> · 입력 TP 최대 @(F1(Runner.Limiter.MaxTruePeakInDbtp)) dBTP</div>
                        <div>출력 하드 클립 <b class="@(Runner.Limiter.HardClipsOut == 0 ? "ok" : "warn")">@(Runner.Limiter.HardClipsOut)</b> · 출력 TP 최대 @(F2(Runner.Limiter.MaxTruePeakOutDbtp)) dBTP</div>
                        <div>최대 감쇄 @(F1(Runner.Limiter.MaxGainReductionDb)) dB · 소프트 클립 @(Runner.Limiter.SoftClipSamples)</div>
                        <div>통합 @(F1(Runner.Limiter.IntegratedLufs)) LUFS · 메이크업 @(F1(Runner.Limiter.MakeupDb)) dB</div>
                        <div>공간 합성 클립 @(Runner.Spatial.Clips) · ITD @(F0(Runner.Spatial.ItdUs)) µs</div>
                        <div>가드 처리 @(F0(Runner.Limiter.LastProcessUs)) µs</div>
                    </div>
                </div>
                <div class="pfm-act">@(Runner.LastAction ?? "대기")</div>
            </div>
        </div>
    </div>
</div>

<style>
    .pfm-scrim { position: fixed; inset: 0; z-index: var(--z-studio-modal); background: rgba(0,0,0,.62); display: flex; align-items: center; justify-content: center; padding: 20px; }
    .pfm-modal { width: min(1640px, 97vw); max-height: 94vh; display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--line); border-radius: 16px; box-shadow: 0 24px 60px rgba(0,0,0,.45); overflow: hidden; }
    .pfm-h { display: flex; justify-content: space-between; gap: 12px; padding: 14px 18px; border-bottom: 1px solid var(--line); background: linear-gradient(120deg, color-mix(in srgb, #22d3ee 14%, var(--card)), color-mix(in srgb, #f59e0b 12%, var(--card))); }
    .pfm-title { font-size: 17px; font-weight: 900; color: var(--text-primary); }
    .pfm-sub { font-size: 12px; color: var(--text-secondary); margin-top: 4px; line-height: 1.5; }
    .pfm-sub b { color: var(--text-primary); }
    .pfm-x { background: none; border: none; color: var(--text-muted); font-size: 18px; cursor: pointer; border-radius: 8px; height: 32px; width: 32px; }
    .pfm-bar { display: flex; flex-wrap: wrap; gap: 6px; padding: 8px 18px; border-bottom: 1px solid var(--line); align-items: center; }
    .pfm-btn { font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 8px; border: 1px solid var(--line); background: var(--card); color: var(--text-primary); cursor: pointer; }
    .pfm-btn.sm { font-size: 10px; padding: 3px 7px; }
    .pfm-btn:disabled { opacity: .45; cursor: default; }
    .pfm-btn.on { background: color-mix(in srgb, #22c55e 20%, var(--card)); border-color: #22c55e; }
    .pfm-btn.warn { border-color: #f59e0b; }
    .pfm-chip { font: 700 11px var(--mono); padding: 4px 8px; border-radius: 999px; border: 1px solid var(--line); color: var(--text-secondary); }
    .pfm-chip.ok { border-color: #22c55e; color: #22c55e; } .pfm-chip.warn { border-color: #f59e0b; color: #f59e0b; }
    .pfm-main { display: grid; grid-template-columns: 1.15fr 1fr; gap: 12px; padding: 12px 18px 16px; min-height: 0; flex: 1; overflow-y: auto; }
    .pfm-col { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
    .pfm-card { border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; background: color-mix(in srgb, var(--card) 92%, #000); }
    .pfm-sec { font-size: 12px; font-weight: 800; color: var(--text-primary); margin-bottom: 8px; }
    .pfm-spec, .pfm-wave, .pfm-spark { width: 100%; background: radial-gradient(circle at 50% 20%, #1e293b, #020617); border-radius: 8px; }
    .pfm-spec { height: 160px; } .pfm-wave { height: 100px; } .pfm-spark { height: 90px; }
    .pfm-spec .gr { stroke: #334155; stroke-width: .5; } .pfm-spec .bar { fill: #22d3ee; opacity: .75; }
    .pfm-spec .mk { stroke: rgba(148,163,184,.25); stroke-width: 1; stroke-dasharray: 2 3; } .pfm-spec .mk.on { stroke: #f59e0b; stroke-dasharray: none; }
    .pfm-wave .wv { fill: none; stroke: #a78bfa; stroke-width: 1; } .pfm-wave .ce { stroke: #ef4444; stroke-width: .8; stroke-dasharray: 4 3; }
    .pfm-spark .pt { fill: #f59e0b; } .pfm-spark .ax { stroke: #334155; stroke-width: .6; }
    .pfm-axis { display: flex; justify-content: space-between; font-size: 10px; color: var(--text-muted); margin-top: 2px; }
    .pfm-matrix { display: grid; grid-template-columns: 70px repeat(6, 1fr); gap: 4px; align-items: center; font-size: 10px; }
    .pfm-matrix b { color: var(--text-primary); font-size: 10px; text-align: center; }
    .pfm-cell { font: 700 9px var(--mono); padding: 5px 2px; border-radius: 6px; border: 1px solid var(--line); background: #0f172a; color: #cbd5e1; cursor: pointer; }
    .pfm-cell.on { border-color: #f59e0b; color: #fff; background: color-mix(in srgb, #f59e0b 25%, #0f172a); }
    .pfm-row { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; margin-top: 8px; }
    .pfm-lbl { font-size: 11px; color: var(--text-muted); font-weight: 700; margin-left: 4px; }
    .pfm-mut { font-size: 11px; color: var(--text-muted); margin-top: 6px; }
    .pfm-meters { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 8px; }
    .pfm-m { display: flex; flex-direction: column; gap: 3px; font-size: 10px; color: var(--text-muted); }
    .pfm-m b { font: 700 12px var(--mono); color: var(--text-primary); }
    .pfm-mbar { height: 8px; border-radius: 4px; background: #1e293b; overflow: hidden; }
    .pfm-mbar i { display: block; height: 100%; background: linear-gradient(90deg, #22c55e, #facc15 75%, #ef4444); }
    .pfm-kv { font-size: 11px; color: var(--text-secondary); display: flex; flex-direction: column; gap: 3px; }
    .pfm-kv.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3px 12px; }
    .pfm-kv b { color: var(--text-primary); } .pfm-kv b.ok { color: #22c55e; } .pfm-kv b.warn { color: #f59e0b; }
    .pfm-act { font-size: 11px; color: var(--text-muted); }
</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private static readonly FoleyMaterial[] Matrix = { FoleyMaterial.Wood, FoleyMaterial.Metal, FoleyMaterial.Glass, FoleyMaterial.Concrete, FoleyMaterial.Flesh, FoleyMaterial.Cloth };
    private static readonly FoleyMaterial[] Floors = { FoleyMaterial.Wood, FoleyMaterial.Concrete, FoleyMaterial.Metal, FoleyMaterial.Glass };
    private static readonly FabricKind[] Fabrics = { FabricKind.Silk, FabricKind.Cotton, FabricKind.Leather };
    private System.Threading.Timer? _timer;
    private readonly float[] _scope = new float[ProceduralFoleyStudioRunner.Scope];
    private FoleyMaterial _mat = FoleyMaterial.Wood, _imp = FoleyMaterial.Metal;
    private float _speed = 2f;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("ProceduralFoley.Modal.Timer", ex); }
        }, null, 100, 100);
    }

    private static string F0(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "0" : v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0.00", CultureInfo.InvariantCulture);
    private static string F3(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0.000", CultureInfo.InvariantCulture);
    private static double Num(ChangeEventArgs e, double fallback) => double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : fallback;
    private static float Y(float db) => 160f - 160f * Math.Clamp((db + 100f) / 100f, 0f, 1f);
    private static float X(float hz) => 480f * MathF.Log(hz / 60f) / MathF.Log(16000f / 60f);
    private static string Short(FoleyMaterial m) => m switch { FoleyMaterial.Wood => "목재", FoleyMaterial.Metal => "금속", FoleyMaterial.Glass => "유리", FoleyMaterial.Concrete => "콘크리트", FoleyMaterial.Flesh => "신체", _ => "직물" };
    private static string FabricName(FabricKind f) => f == FabricKind.Silk ? "실크" : f == FabricKind.Leather ? "가죽" : "면";

    private RenderFragment Meter(string name, float v, float lo, float hi, string unit) => __builder =>
    {
        <div class="pfm-m"><span>@(name)</span><div class="pfm-mbar"><i style="width:@(F1(Math.Clamp((v - lo) / (hi - lo), 0f, 1f) * 100))%"></i></div><b>@(F1(v)) @(unit)</b></div>
    };

    private void Hit(FoleyMaterial surface, FoleyMaterial impactor)
    {
        _mat = surface; _imp = impactor;
        Runner.Strike(surface, impactor, _speed);
    }

    private string Wave()
    {
        Runner.CopyScope(_scope);
        var sb = new System.Text.StringBuilder(256 * 12);
        for (var i = 0; i < 256; i++)
        {
            var a = 0f; var j0 = i * 8;
            for (var k = 0; k < 8; k++) { var v = _scope[j0 + k]; if (MathF.Abs(v) > MathF.Abs(a)) a = v; }
            sb.Append(F1(i * 2.0)).Append(',').Append(F1(50 - 45 * Math.Clamp(a, -1.1f, 1.1f))).Append(' ');
        }
        return sb.ToString();
    }

    private string ScatterSvg()
    {
        var sb = new System.Text.StringBuilder(4000);
        sb.Append("<line class=\"ax\" x1=\"0\" y1=\"45\" x2=\"360\" y2=\"45\"/>");
        var n = Runner.Modal.SeriesCount;
        for (var i = 0; i < n; i++)
        {
            var e = Runner.Modal.EnergySeries(i);
            if (e <= 0f) continue;
            var x = 360f * Math.Clamp((MathF.Log10(e) + 3f) / 5f, 0f, 1f);
            var y = 90f - 90f * Math.Clamp((Runner.Modal.PeakSeries(i) + 80f) / 90f, 0f, 1f);
            sb.Append("<circle class=\"pt\" cx=\"").Append(F1(x)).Append("\" cy=\"").Append(F1(y)).Append("\" r=\"2.2\"/>");
        }
        return sb.ToString();
    }

    private void ToggleRun()
    {
        if (Runner.IsRunning) Runner.Stop(); else Runner.Start();
    }

    private void Step60()
    {
        for (var i = 0; i < ProceduralFoleyStudioRunner.Hz; i++) Runner.Step();
    }

    private Task Close() => OnClose.InvokeAsync();

    private void OnServiceChanged()
    {
        if (!Runner.IsRunning) _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
