@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private static readonly TransitionKind[] Kinds = { TransitionKind.Cut, TransitionKind.Mix, TransitionKind.WipeH, TransitionKind.WipeV, TransitionKind.WipeCircle, TransitionKind.WipeDiamond };
    private readonly char[] _tc = new char[SmpteTimecode.Length];
    private System.Threading.Timer? _timer;

    private RealtimeBroadcastVisionSwitcherEngine S => Runner.Switcher;
    private AutonomousLiveInstantReplaySynthesizer R => Runner.Replay;
    private OnAirBroadcastSignalFailSafeGuard G => Runner.Guard;
    private PtpSlaveServo P => Runner.Guard.Ptp;
    private float TBarPos => S.TBarFlipped ? 1f - S.Progress : S.Progress;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("MasterControl.Modal.Timer", ex); }
        }, null, 300, 300);
    }

    private static string F0(double v) => v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => double.IsNaN(v) ? "—" : v.ToString("0.00", CultureInfo.InvariantCulture);
    private static double Num(ChangeEventArgs e, double fallback) => double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : fallback;

    private static string KindName(TransitionKind k) => k switch
    {
        TransitionKind.Cut => "컷", TransitionKind.Mix => "디졸브", TransitionKind.WipeH => "와이프 ↔", TransitionKind.WipeV => "와이프 ↕", TransitionKind.WipeCircle => "와이프 ◯", _ => "와이프 ◇",
    };

    private static string EvName(ArenaEventKind k) => k switch { ArenaEventKind.Goal => "⚽ 골", ArenaEventKind.Collision => "💥 충돌", ArenaEventKind.Drama => "🔥 찬스", _ => "⭐ 마크" };

    private static string SkewClass(double us) => us <= 10_000 ? "Class A(저지연차)" : us <= 50_000 ? "Class B(중간)" : "Class C(고지연차)";

    private string Tc(long frame)
    {
        if (frame < 0) return "--:--:--:--";
        var n = SmpteTimecode.Format(frame, AutonomousLiveInstantReplaySynthesizer.Hz, _tc);
        return new string(_tc, 0, n);
    }

    /// <summary>링 프레임 → 타임라인 x(가장 오래된 프레임 = 0 · 라이브 = 600).</summary>
    private double Tx(double frame)
    {
        double lo = R.OldestFrame, hi = Math.Max(lo + 1, R.LastFrame);
        return Math.Clamp((frame - lo) / (hi - lo), 0, 1) * 600;
    }

    private RenderFragment PathRow(string name, NetworkPath p, long won, int path) => __builder =>
    {
        var down = p.IsDown(Runner.NowUs);
        <div class="mcr-path"><b class="@(down ? "dn" : null)">@name @(down ? "DOWN" : "UP")</b>
            <label>손실 <b>@(F1(p.LossRate * 100))%</b><input type="range" min="0" max="0.3" step="0.005" value="@(p.LossRate.ToString("0.000", CultureInfo.InvariantCulture))" @onchange="e => Runner.SetLoss(path, (float)Num(e, 0))" />
                <span class="mono">송신 @(p.Sent) · 드롭 @(p.Dropped) · 비행 @(p.InFlight) · 첫 도착 채택 @(won)</span></label></div>
    };

    private string Series(Func<int, float> f, double max, double h)
    {
        var n = Runner.SeriesCount;
        if (n < 2) return "";
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = n - 1; i >= 0; i--)
            sb.Append(F1(360.0 * (n - 1 - i) / (BroadcastMasterControlStudioRunner.SeriesLen - 1))).Append(',').Append(F1(h - 2 - (h - 4) * Math.Clamp(f(i) / max, 0, 1))).Append(' ');
        return sb.ToString();
    }

    private string SeriesSigned(Func<int, float> f, double range, double h)
    {
        var n = Runner.SeriesCount;
        if (n < 2) return "";
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = n - 1; i >= 0; i--)
            sb.Append(F1(360.0 * (n - 1 - i) / (BroadcastMasterControlStudioRunner.SeriesLen - 1))).Append(',').Append(F1(h / 2 - (h / 2 - 2) * Math.Clamp(f(i) / range, -1, 1))).Append(' ');
        return sb.ToString();
    }

    private void ToggleRun() { if (Runner.IsRunning) Runner.Stop(); else Runner.Start(); }
    private void Step60() { for (var i = 0; i < BroadcastMasterControlStudioRunner.Hz; i++) Runner.Step(); }

    private Task Close() => OnClose.InvokeAsync();

    /// <summary>가동 중(10 Hz 이벤트)은 300 ms 타이머가 처리 — 정지 상태 액션만 즉시 반영.</summary>
    private void OnServiceChanged() { if (!Runner.IsRunning) _ = InvokeAsync(StateHasChanged); }

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
