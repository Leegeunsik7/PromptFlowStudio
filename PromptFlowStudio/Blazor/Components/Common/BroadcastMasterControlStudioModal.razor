@using System.Globalization
@using PromptFlowStudio.Services.MasterControl
@implements IDisposable
@inject BroadcastMasterControlStudioRunner Runner

@*
    [PromptFlow Studio v17.05.0] 📺 AI 방송 비전 스위처 & 마스터 컨트롤 스튜디오 — 16분할 멀티뷰어(탤리) · PGM/PVW 모니터 · 크로스포인트 패널 ·
    T-바/트랜지션 · 리플레이 타임라인(ISO 링 · 클립 인/아웃 · 송출 큐 · 120 fps 슈퍼 슬로모션) · ST 2110/2022-7 이중 경로 · PTP · 신호 페일세이프.
*@

<div class="mcr-scrim" @onclick="Close">
    <div class="mcr-modal" @onclick:stopPropagation="true">
        <div class="mcr-h">
            <div>
                <div class="mcr-title">📺 AI 방송 비전 스위처 &amp; 마스터 컨트롤 스튜디오</div>
                <div class="mcr-sub"><b>비전 스위처</b>가 MoCo · 가상 드론 · 볼류메트릭 16 입력을 핀 고정 메모리 맵 위에서 PGM/PVW 컷 · 디졸브 · 와이프로 같은 프레임에 합성하고,
                    <b>리플레이 합성기</b>는 ISO 링버퍼에서 골/충돌/찬스를 자동 클립화해 움직임 보상 보간 120 fps 슬로모션을 송출 큐에 넣습니다.
                    <b>세이프 가드</b>는 SMPTE ST 2110 -20/-30/-40 패킷을 ST 2022-7 메인/서브 경로로 무결절 병합하고 PTP 동기 · 신호 결손/블랙 시 백업 비상 컷으로 블랙아웃을 막습니다. 경로·경기는 인프로세스 시뮬레이션입니다.</div>
            </div>
            <button class="mcr-x" @onclick="Close">✕</button>
        </div>

        <div class="mcr-bar">
            <button class="mcr-btn @(Runner.IsRunning ? "on" : null)" @onclick="ToggleRun">@(Runner.IsRunning ? "⏸ 정지" : "▶ 주조정실 가동")</button>
            <button class="mcr-btn" @onclick="Step60" disabled="@Runner.IsRunning">⏭ 1초</button>
            <button class="mcr-btn @(Runner.AutoReplay ? "on" : null)" @onclick="() => Runner.AutoReplay = !Runner.AutoReplay">🤖 자율 리플레이</button>
            <button class="mcr-btn" @onclick="Runner.MarkHighlight">⭐ 하이라이트 마크</button>
            <button class="mcr-btn" @onclick="Runner.RollReplay" disabled="@(R.QueueCount == 0 || R.IsOnAir)">🎬 리플레이 송출</button>
            <label class="mcr-sl">슬로 <b>@(F2(R.Speed))×</b><input type="range" min="0.1" max="1" step="0.05" value="@(F2(R.Speed))" @onchange="e => R.Speed = (float)Num(e, 0.25)" /></label>
            <button class="mcr-btn stop @(S.FadeToBlack ? "on" : null)" @onclick="Runner.Ftb">⬛ FTB</button>
            <span class="mcr-chip">틱 @(Runner.Tick) · @(F1(Runner.LastTickMs)) ms · 렌더 @(F0(S.RenderUs)) · 합성 @(F0(S.CompositeUs)) · MV @(F0(S.MultiviewUs)) · 패킷화 @(F0(Runner.Sender.PacketizeUs)) · 슬로모 @(F0(R.LastSynthUs)) µs</span>
            <span class="mcr-chip @(G.AirBlackFrames == 0 ? "ok" : "bad")">ON-AIR @(F0(G.AirFrames)) 프레임 · 블랙 @(G.AirBlackFrames)</span>
        </div>

        <div class="mcr-main">
            <div class="mcr-col">
                <div class="mcr-card">
                    <div class="mcr-sec">🖥 16분할 멀티뷰어 <span class="mcr-kv">입력→PGM 지연 <b>@(S.LatencyFrames) 프레임</b> · 메모리 맵 <b>@(F0(S.MemoryMapBytes / 1024.0)) KB</b> · @(S.Width)×@(S.Height) 프록시</span></div>
                    <div class="mcr-mv">
                        <img src="data:image/bmp;base64,@(Runner.MonitorBase64(2))" alt="멀티뷰어" />
                        <div class="mcr-mvgrid">
                            @for (var i = 0; i < RealtimeBroadcastVisionSwitcherEngine.Inputs; i++)
                            {
                                var ii = i;
                                <div class="t@(S.Tally(ii)) @(Runner.IsLost(ii) || Runner.IsBlack(ii) ? "fault" : null)" @onclick="() => Runner.Preview(ii)">
                                    <span>@(RealtimeBroadcastVisionSwitcherEngine.Names[ii])</span>
                                    @if (Runner.IsLost(ii)) { <em>NO SIGNAL · 프레임 싱크</em> }
                                    else if (Runner.IsBlack(ii)) { <em>BLACK</em> }
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="mcr-mons">
                    <div class="mcr-mon pvw"><div class="lab">PVW · @(RealtimeBroadcastVisionSwitcherEngine.Names[S.Pvw])</div><img src="data:image/bmp;base64,@(Runner.MonitorBase64(1))" alt="PVW" /></div>
                    <div class="mcr-mon pgm"><div class="lab">PGM · @(RealtimeBroadcastVisionSwitcherEngine.Names[S.Pgm]) @(S.InTransition ? "→ " + RealtimeBroadcastVisionSwitcherEngine.Names[S.Pvw] + " " + F0(S.Progress * 100) + "%" : null)</div><img src="data:image/bmp;base64,@(Runner.MonitorBase64(0))" alt="PGM" /></div>
                </div>
                <div class="mcr-card">
                    <div class="mcr-sec">🎛 크로스포인트 · 트랜지션 <span class="mcr-kv">컷 <b>@(S.Cuts)</b> · 트랜지션 <b>@(S.Transitions)</b> · 비상 컷 <b>@(S.EmergencyCuts)</b> · PGM 오디오 <b>@(F1(S.ProgramPeakDbfs)) dBFS</b></span></div>
                    <div class="mcr-xp">
                        <div class="mcr-xprow"><b class="pg">PGM</b>
                            @for (var i = 0; i < RealtimeBroadcastVisionSwitcherEngine.Inputs; i++)
                            {
                                var ii = i;
                                <button class="xp @(S.Pgm == ii ? "pg" : null)" @onclick="() => Runner.Program(ii)">@(RealtimeBroadcastVisionSwitcherEngine.Names[ii])</button>
                            }
                        </div>
                        <div class="mcr-xprow"><b class="pv">PVW</b>
                            @for (var i = 0; i < RealtimeBroadcastVisionSwitcherEngine.Inputs; i++)
                            {
                                var ii = i;
                                <button class="xp @(S.Pvw == ii ? "pv" : null)" @onclick="() => Runner.Preview(ii)">@(RealtimeBroadcastVisionSwitcherEngine.Names[ii])</button>
                            }
                        </div>
                    </div>
                    <div class="mcr-trans">
                        <div class="kinds">
                            @foreach (var k in Kinds)
                            {
                                var kk = k;
                                <button class="mcr-btn sm @(S.Transition == kk ? "on" : null)" @onclick="() => Runner.SetTransition(kk)">@(KindName(kk))</button>
                            }
                            <label class="mcr-sl">레이트 <b>@(S.RateFrames)f</b><input type="range" min="5" max="120" step="5" value="@(S.RateFrames)" @onchange="e => Runner.SetRate((int)Num(e, 30))" /></label>
                        </div>
                        <div class="go">
                            <button class="mcr-big cut" @onclick="Runner.Cut">CUT</button>
                            <button class="mcr-big auto @(S.InTransition ? "on" : null)" @onclick="Runner.Auto">AUTO</button>
                        </div>
                        <div class="tbar">
                            <input type="range" min="0" max="1" step="0.01" value="@(F2(TBarPos))" @oninput="e => Runner.SetTBar((float)Num(e, 0))" />
                            <span>T-BAR @(F0(S.Progress * 100))%</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mcr-col">
                <div class="mcr-card">
                    <div class="mcr-sec">🎬 인스턴트 리플레이 타임라인
                        <span class="mcr-kv">출력 <b>@(R.OutputFps) fps</b> · 유효 <b>@(F0(R.EffectiveFps)) fps</b> · 합성 <b>@(R.SynthesizedFrames)</b> · 보간 <b>@(R.InterpolatedFrames)</b> · ME @(F0(R.LastMeUs)) µs · 평균 움직임 @(F1(R.MeanMotion)) px · 가림 블록 @(R.OccludedBlocks)</span></div>
                    <svg class="mcr-tl" viewBox="0 0 600 110" preserveAspectRatio="none">
                        @for (var c = 0; c < AutonomousLiveInstantReplaySynthesizer.Channels; c++)
                        {
                            <g><rect class="lane" x="0" y="@(8 + c * 26)" width="600" height="20" /><text x="4" y="@(22 + c * 26)">@(AutonomousLiveInstantReplaySynthesizer.ChannelNames[c])</text></g>
                        }
                        @for (var k = 0; k < AutonomousLiveInstantReplaySynthesizer.MaxClips; k++)
                        {
                            var cl = R.Clip(k);
                            if (cl.State == ClipState.Free || cl.OutFrame < R.OldestFrame) continue;
                            var x0 = Tx(cl.InFrame); var x1 = Tx(cl.OutFrame); var ex = Tx(cl.EventFrame);
                            <g><rect class="clip s@((int)cl.State)" x="@(F1(x0))" y="@(9 + cl.Channel * 26)" width="@(F1(Math.Max(2, x1 - x0)))" height="18" /><line class="ev" x1="@(F1(ex))" x2="@(F1(ex))" y1="@(6 + cl.Channel * 26)" y2="@(30 + cl.Channel * 26)" /><text class="cl" x="@(F1(x0 + 3))" y="@(21 + cl.Channel * 26)">#@(cl.Id) @(EvName(cl.Kind))</text></g>
                        }
                        @if (R.IsOnAir)
                        {
                            var ph = Tx(R.Playhead);
                            <line class="ph" x1="@(F1(ph))" x2="@(F1(ph))" y1="2" y2="86" />
                        }
                        <text class="tc" x="4" y="104">@(Tc(R.OldestFrame))</text>
                        <text class="tc" x="596" y="104" text-anchor="end">@(Tc(R.LastFrame)) LIVE</text>
                    </svg>
                    <div class="mcr-rpl">
                        <div class="mcr-mon rpl"><div class="lab">RPL @(R.IsOnAir ? "ON-AIR #" + R.OnAirClip.Id + " " + F2(R.OnAirClip.Speed) + "×" : "대기")</div><img src="data:image/bmp;base64,@(Runner.MonitorBase64(4))" alt="RPL" /></div>
                        <div class="mcr-q">
                            <div class="qh">송출 큐 @(R.QueueCount) · 마크 @(R.ClipsMarked) · 병합 @(R.MergedEvents) · 송출 @(R.ClipsAired)</div>
                            @for (var q = 0; q < R.QueueCount; q++)
                            {
                                var cl = R.Clip(R.QueuedSlot(q));
                                <div><b>#@(cl.Id)</b> @(EvName(cl.Kind)) · @(AutonomousLiveInstantReplaySynthesizer.ChannelNames[cl.Channel]) · @(Tc(cl.InFrame))→@(Tc(cl.OutFrame)) · @(F2(cl.Speed))×</div>
                            }
                            <div class="sc">⚽ 홈 @(Runner.Scene.Score0) : @(Runner.Scene.Score1) 원정 · 흥분 @(F0(Runner.Scene.Excitement * 100))% · 이벤트 @(Runner.Scene.EventCount)</div>
                        </div>
                    </div>
                </div>

                <div class="mcr-card">
                    <div class="mcr-sec">🌐 SMPTE ST 2110 · ST 2022-7 무결절 이중화
                        <span class="mcr-chip @(G.ConcealedLines == 0 && G.FrozenFrames == 0 ? "ok" : "warn")">완전 프레임 @(G.CompleteFrames)/@(G.AirFrames) · 은닉 라인 @(G.ConcealedLines) · 프리즈 @(G.FrozenFrames)</span></div>
                    <div class="mcr-air">
                        <div class="mcr-mon air"><div class="lab">ON-AIR 수신(2022-7 병합 · 2 프레임 플레이아웃) · TC @(Tc(G.LastTimecode))</div><img src="data:image/bmp;base64,@(Runner.MonitorBase64(3))" alt="AIR" /></div>
                        <div class="mcr-paths">
                            @PathRow("A 메인", Runner.PathA, G.Video.WonA, 0)
                            @PathRow("B 서브", Runner.PathB, G.Video.WonB, 1)
                            <div class="mcr-kv">무결절 복구 <b>@(G.HitlessRecovered)</b> · 중복 폐기 <b>@(G.Video.Duplicates + G.Audio.Duplicates)</b> · 지연차 PD <b>@(F2(G.Video.SkewUs / 1000)) ms</b> (최대 @(F2(G.Video.MaxSkewUs / 1000))) · @(SkewClass(G.Video.MaxSkewUs))</div>
                            <div class="mcr-kv">-20 <b>@(Runner.Sender.VideoPackets)</b> pkt · @(F1(Runner.Sender.VideoMbps)) Mb/s · -30 <b>@(Runner.Sender.AudioPackets)</b> (은닉 @(G.AudioConcealed)) · @(F1(G.AirAudioPeakDbfs)) dBFS · -40 ATC <b>@(Runner.Sender.AncPackets)</b> (오류 @(G.AncErrors)) · 지각 @(G.LatePackets)</div>
                            <div class="mcr-ctl">
                                <label class="mcr-sl">B 지연 <b>@(F1(Runner.PathB.BaseDelayUs / 1000)) ms</b><input type="range" min="0" max="40" step="0.5" value="@(F1(Runner.PathB.BaseDelayUs / 1000))" @onchange="e => Runner.SetSkewMs(Num(e, 2.4))" /></label>
                                <label class="mcr-sl">지터 <b>@(F0(Runner.PathA.JitterUs)) µs</b><input type="range" min="0" max="3000" step="50" value="@(F0(Runner.PathA.JitterUs))" @onchange="e => Runner.SetJitterUs(Num(e, 200))" /></label>
                                <button class="mcr-btn stop" @onclick="() => Runner.OutageA()">🔌 A 단절 3초</button>
                                <button class="mcr-btn stop" @onclick="() => Runner.OutageB()">🔌 B 단절 3초</button>
                                <button class="mcr-btn @(Runner.BurstActive ? "warn" : null)" @onclick="Runner.DualBurst">⚡ 양 경로 버스트</button>
                            </div>
                        </div>
                    </div>
                    <svg class="mcr-spark" viewBox="0 0 360 60" preserveAspectRatio="none">
                        <polyline class="la" points="@(Series(Runner.LossASeries, 40, 60))" />
                        <polyline class="lb" points="@(Series(Runner.LossBSeries, 40, 60))" />
                        <polyline class="cc" points="@(Series(Runner.ConcealSeries, 40, 60))" />
                    </svg>
                    <div class="mcr-legend"><i class="la"></i>A 손실/틱 <i class="lb"></i>B 손실/틱 <i class="cc"></i>은닉 라인/틱(양 경로 동시 손실만)</div>
                </div>

                <div class="mcr-card">
                    <div class="mcr-sec">🛰 PTP (IEEE 1588 · ST 2059-2)
                        <span class="mcr-chip @(P.State == PtpState.Locked ? "ok" : P.State == PtpState.Holdover ? "bad" : "warn")">@(P.State) · @(PtpSlaveServo.GmNames[P.Selected]) · 오프셋 @(F0(P.OffsetNs)) ns · 보정 @(F0(P.FrequencyAdjPpb)) ppb · 스위칭 클록 @(P.ClockOk ? "PTP" : "플라이휠")</span></div>
                    <div class="mcr-ctl">
                        @for (var g = 0; g < 2; g++)
                        {
                            var gg = g;
                            <button class="mcr-btn @(P.GmAlive(gg) ? "on" : "stop")" @onclick="() => Runner.ToggleGm(gg)">@(PtpSlaveServo.GmNames[gg]) @(P.GmAlive(gg) ? "정상" : "장애")</button>
                        }
                        <span class="mcr-kv">Sync @(P.Syncs) · 스텝 @(P.Steps) · GM 전환 @(P.GmChanges) · 홀드오버 @(F1(P.HoldoverUs / 1e6)) s · 드리프트 @(F1(P.DriftPpm)) ppm</span>
                    </div>
                    <svg class="mcr-spark" viewBox="0 0 360 60" preserveAspectRatio="none">
                        <line class="mid" x1="0" x2="360" y1="30" y2="30" />
                        <polyline class="pt" points="@(SeriesSigned(Runner.PtpSeries, 2000, 60))" />
                    </svg>
                </div>

                <div class="mcr-card">
                    <div class="mcr-sec">🛡 신호 페일세이프
                        <span class="mcr-chip @(G.Failovers == 0 ? "ok" : "warn")">비상 컷 @(G.Failovers) · 결손 @(G.LossFaults) · 블랙 @(G.BlackFaults) @(G.LastFaultInput >= 0 ? "· 최근 " + RealtimeBroadcastVisionSwitcherEngine.Names[G.LastFaultInput] + " → " + RealtimeBroadcastVisionSwitcherEngine.Names[Math.Max(0, G.LastBackup)] : null)</span></div>
                    <div class="mcr-ctl">
                        <button class="mcr-btn stop" @onclick="() => Runner.LoseSource(S.Pgm)">📵 PGM 소스 신호 결손</button>
                        <button class="mcr-btn stop" @onclick="() => Runner.BlackSource(S.Pgm)">⬛ PGM 소스 블랙</button>
                        <label class="mcr-sl">백업 <b>@(RealtimeBroadcastVisionSwitcherEngine.Names[G.BackupInput])</b>
                            <select value="@(G.BackupInput)" @onchange="e => G.BackupInput = (int)Num(e, 6)">
                                @for (var i = 0; i < RealtimeBroadcastVisionSwitcherEngine.Inputs; i++) { <option value="@i">@(RealtimeBroadcastVisionSwitcherEngine.Names[i])</option> }
                            </select></label>
                        <span class="mcr-kv">결손 ≥ @(G.LossFrames) 프레임 · 블랙 ≥ @(G.BlackFrames) 프레임 → 프레임 경계 비상 컷 · 결손 중 프레임 싱크 홀드</span>
                    </div>
                </div>
                <div class="mcr-note">@(Runner.LastAction ?? "대기")</div>
            </div>
        </div>
    </div>
</div>

<style>
    .mcr-scrim { position: fixed; inset: 0; z-index: var(--z-studio-modal); background: rgba(0,0,0,.62); display: flex; align-items: center; justify-content: center; padding: 20px; }
    .mcr-modal { width: min(1640px, 97vw); max-height: 94vh; display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--line); border-radius: 18px; box-shadow: 0 24px 60px rgba(0,0,0,.45); overflow: hidden; }
    .mcr-h { display: flex; justify-content: space-between; gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--line); background: linear-gradient(120deg, color-mix(in srgb, #ef4444 14%, var(--card)), color-mix(in srgb, #22c55e 12%, var(--card))); }
    .mcr-title { font-size: 17px; font-weight: 900; color: var(--text-primary); }
    .mcr-sub { font-size: 12px; color: var(--text-secondary); margin-top: 4px; line-height: 1.5; } .mcr-sub b { color: var(--text-primary); }
    .mcr-x { background: none; border: none; color: var(--text-muted); font-size: 18px; cursor: pointer; border-radius: 8px; }
    .mcr-bar { display: flex; flex-wrap: wrap; gap: 6px 10px; padding: 10px 20px; border-bottom: 1px solid var(--line); align-items: center; }
    .mcr-btn { font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 8px; border: 1px solid var(--line); background: transparent; color: var(--text-primary); cursor: pointer; } .mcr-btn:disabled { opacity: .4; cursor: default; }
    .mcr-btn.sm { font-size: 10px; padding: 2px 8px; } .mcr-btn.on { background: color-mix(in srgb, #22c55e 22%, transparent); border-color: #4ade80; } .mcr-btn.warn { background: color-mix(in srgb, #eab308 24%, transparent); border-color: #facc15; }
    .mcr-btn.stop { background: #7f1d1d; border-color: #ef4444; color: #fff; } .mcr-btn.stop.on { background: #b91c1c; }
    .mcr-chip { font: 700 11px var(--mono); padding: 3px 8px; border-radius: 999px; border: 1px solid var(--line); color: var(--text-secondary); }
    .mcr-chip.ok { border-color: #22c55e; color: #86efac; } .mcr-chip.bad { border-color: #ef4444; color: #fca5a5; } .mcr-chip.warn { border-color: #eab308; color: #fde68a; }
    .mcr-sl { display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--text-secondary); } .mcr-sl b { font-family: var(--mono); color: var(--text-primary); } .mcr-sl input { width: 90px; }
    .mcr-sl select { font-size: 11px; background: transparent; color: var(--text-primary); border: 1px solid var(--line); border-radius: 6px; }
    .mcr-main { display: grid; grid-template-columns: 1.05fr 1fr; gap: 14px; padding: 14px 20px; min-height: 0; flex: 1; overflow-y: auto; }
    .mcr-col { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
    .mcr-card { border: 1px solid var(--line); border-radius: 12px; padding: 12px; display: flex; flex-direction: column; gap: 8px; }
    .mcr-sec { font-weight: 800; font-size: 13px; color: var(--text-primary); display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .mcr-mv { position: relative; width: 100%; aspect-ratio: 16 / 9; background: #000; border-radius: 8px; overflow: hidden; }
    .mcr-mv img, .mcr-mon img { width: 100%; height: 100%; display: block; image-rendering: auto; }
    .mcr-mvgrid { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(4, 1fr); grid-template-rows: repeat(4, 1fr); }
    .mcr-mvgrid > div { border: 2px solid rgba(15,23,42,.9); position: relative; cursor: pointer; }
    .mcr-mvgrid > div.t1 { border-color: #22c55e; } .mcr-mvgrid > div.t2 { border-color: #ef4444; } .mcr-mvgrid > div.t3 { border-color: #f59e0b; }
    .mcr-mvgrid > div.fault { background: repeating-linear-gradient(45deg, rgba(239,68,68,.15) 0 6px, transparent 6px 12px); }
    .mcr-mvgrid span { position: absolute; left: 50%; bottom: 3px; transform: translateX(-50%); font: 800 10px var(--mono); color: #fff; background: rgba(0,0,0,.65); padding: 0 5px; border-radius: 3px; }
