@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private System.Threading.Timer? _timer;
    private int[] _top = Array.Empty<int>();
    private long _topStamp = -1;
    private int _sev = 1, _rule = -1;

    private CloudSourceCodeIntegrityVerifierEngine S => Runner.Source;
    private FullUiInteractiveMenuAutomatedDriver D => Runner.Driver;
    private RealtimeUiExceptionSelfHealingGuard G => Runner.Guard;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("CloudVerify.Modal.Timer", ex); }
        }, null, 250, 250);
    }

    private static string F0(double v) => v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => v.ToString("0.00", CultureInfo.InvariantCulture);
    private static string F3(double v) => v.ToString("0.000", CultureInfo.InvariantCulture);

    private static int Heat(int n) => n <= 0 ? 0 : n < 3 ? 1 : n < 10 ? 2 : 3;

    private static string ShortPath(string p)
    {
        var k = p.LastIndexOf('/');
        if (k < 0) return p;
        var k2 = k > 0 ? p.LastIndexOf('/', k - 1) : -1;
        return k2 >= 0 ? p[(k2 + 1)..] : p;
    }

    private static string KindIcon(UiControlKind k) => k switch
    {
        UiControlKind.StudioButton => "🎛", UiControlKind.Toggle => "⏻", UiControlKind.Switch => "🔀", UiControlKind.Slider => "🎚", _ => "⚙",
    };

    private static string OutcomeName(UiStepOutcome o) => o switch
    {
        UiStepOutcome.Pass => "통과", UiStepOutcome.BindingMismatch => "불일치", UiStepOutcome.Exception => "예외", UiStepOutcome.Timeout => "지연", UiStepOutcome.Quarantined => "격리", _ => "대기",
    };

    /// <summary>발견 상위 16개 파일(스캔 진행 변화 시에만 재계산).</summary>
    private int[] TopFiles()
    {
        var stamp = S.TotalFindings * 100_000 + S.FileCount;
        if (stamp == _topStamp) return _top;
        var n = S.FileCount;
        var totals = new int[n]; var idx = new int[n];
        for (var i = 0; i < n; i++) { idx[i] = i; totals[i] = S.FileTotal(i); }
        Array.Sort(totals, idx);
        var take = 0;
        for (var i = n - 1; i >= 0 && take < 16 && totals[i] > 0; i--) take++;
        var top = new int[take];
        for (var i = 0; i < take; i++) top[i] = idx[n - 1 - i];
        _top = top; _topStamp = stamp;
        return _top;
    }

    private string TileClass(int i)
    {
        var t = D.Target(i);
        var cur = Runner.Phase == VerificationPhase.UiDriving && D.Cursor == i ? " cur" : "";
        var q = G.IsQuarantined(i) ? " q" : "";
        return "tl o" + ((int)t.Outcome).ToString(CultureInfo.InvariantCulture) + cur + q;
    }

    private string TileTip(int i)
    {
        var t = D.Target(i);
        var tip = t.Group + " · " + t.Name;
        if (t.LastNote is not null) tip += " — " + t.LastNote;
        return G.IsQuarantined(i) ? tip + " (클릭: 격리 해제)" : tip;
    }

    private static string TileSub(UiControlTarget t) => t.Runs > 0 ? t.Group + " · " + OutcomeName(t.Outcome) + " · " + F1(t.LastMs) + "ms" : t.Group + " · " + OutcomeName(t.Outcome);

    private string TargetName(int t) => t >= 0 && t < D.Count ? D.Target(t).Name : "전역";

    private static string Seq(long s) => "#" + s.ToString(CultureInfo.InvariantCulture);

    private string DigestShort() => G.LastDigest is { Length: >= 16 } d ? d[..16] : "";

    private string ManifestPreview() { var mf = G.LastManifest ?? ""; return mf.Length > 1800 ? mf[..1800] + "\n…" : mf; }

    private int LogShown => Math.Min(G.LogCount, 40);

    private bool Visible(SourceFinding f) => (int)f.Severity >= _sev && (_rule < 0 || (int)f.Rule == _rule);

    private int MaxRule()
    {
        var m = 0;
        for (var r = 0; r < CloudSourceCodeIntegrityVerifierEngine.Rules; r++) m = Math.Max(m, S.RuleCount((VerifyRule)r));
        return m;
    }

    private void ToggleRule(int r) { _rule = _rule == r ? -1 : r; if (_rule >= 0) _sev = 0; }

    private void SetDelay(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var v)) Runner.StepDelayMs = Math.Clamp(v, 0, 500);
    }

    private void BuildManifest() => G.BuildManifest(S, D);

    private Task Close() => OnClose.InvokeAsync();

    private void OnServiceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
