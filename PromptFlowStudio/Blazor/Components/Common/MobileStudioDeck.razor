    // v5.7.0: 카드 터치 → 대표 프롬프트를 생성 닥 입력창에 주입(Google Flow 템플릿 패턴).
    private void HandleCardAction(string key)
    {
        var card = System.Array.Find(FlowCards, c => c.Key == key);
        if (card is null) return;
        // v5.8.0: 배치/자이로 카드는 전용 독립 화면으로 스위칭, 그 외는 대표 프롬프트를 닥에 시드 주입.
        switch (key)
        {
            case "batch": SwitchInternal(MobileInternalView.Batch); _msg = "🏭 B2B 대량 양산 — 템플릿과 변수 목록으로 수십 건을 일괄 렌더하세요."; return;
            case "gyro":  SwitchInternal(MobileInternalView.Gyro);  _msg = "📱 3D 자이로 모션 — 조이스틱으로 카메라 앵글을 조율하세요."; return;
            case "audio": SwitchInternal(MobileInternalView.AudioSync); _msg = "🎼 오디오 립싱크 — 보컬 트랙을 업로드하면 강도에 맞춰 컷별 립싱크 수식어가 주입됩니다."; return;
        }
        _session.DraftPrompt = card.Seed;   // v5.7.5 세션 초안에 주입(뷰 전환에도 보존)
        _view = MobileView.Workspace;
        _internalView = MobileInternalView.Workspace;
        _msg = $"💡 «{card.Label}» 대표 프롬프트를 생성 닥에 주입 — 편집 후 ➔ 로 생성";
    }

    // ── v5.8.0: B2B 대량 양산 실행(각 배치 항목 = 독립 1컷 렌더 · 완료 즉시 갤러리/씬 자산화 = 부분 보존 · CTS 취소) ──
    private async Task HandleBatchStart(List<BatchTemplateItem> items)
    {
        if (_dockRunning || items is null || items.Count == 0) return;
        _dockCts?.Cancel(); _dockCts?.Dispose();
        _dockCts = new System.Threading.CancellationTokenSource();
        var ct = _dockCts.Token;

        _dockRunning = true; _msg = null; _completedThumbs = new();
        _currentTotalSteps = items.Count; _currentStepIndex = 1; _completedStepThumbs.Clear();
        var ok = 0;
        StateHasChanged();
        try
        {
            for (var i = 0; i < items.Count; i++)
            {
                ct.ThrowIfCancellationRequested();
                _currentStepIndex = i + 1; _dockPercent = i * 100 / items.Count;
                _liveStep = $"🏭 배치 {i + 1}/{items.Count} — {items[i].VariableValue}";
                StateHasChanged();

                var build = new WanPromptBuild(items[i].InterpolatedPrompt, 30, System.Array.Empty<string>(), null);
                var r = await Wan.SubmitAsync(build, Project, ct);
                var url = r.VideoUrl ?? r.LastFrameUrl;
                if (!string.IsNullOrEmpty(url) && Project is not null)
                {
                    ok++;
                    var img = WanSampleFactory.IsImageUrl(url!);
                    Project.Gallery.Insert(0, new GalleryAsset { Url = url!, Kind = img ? GalleryAssetKind.Image : GalleryAssetKind.Video, Label = $"배치 {items[i].VariableValue}", CreatedMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() });
                    Project.Scenes.Add(new StoryboardScene { Prompt = items[i].InterpolatedPrompt, Status = SceneStatus.Completed, VideoUrl = img ? null : url, PosterUrl = img ? url : null });
                    _completedThumbs.Add(url!); _completedStepThumbs[i + 1] = url!;
                    FireVideoWebhook(url, $"배치 {items[i].VariableValue}");   // v6.1.0: 배치 항목 완공 → B2B Webhook 자동 발화
                }
            }
            _dockPercent = 100;
            _msg = $"✅ 대량 양산 완료 — {ok}/{items.Count}건 생성 · 갤러리 자산화";
        }
        catch (OperationCanceledException) { _msg = $"⏹ 대량 양산 중단 — {ok}건 부분 보존(갤러리)"; }
        catch (Exception ex) { _msg = "⚠ 대량 양산 오류: " + ex.Message; }
        finally { _dockRunning = false; _dockPercent = 0; StateHasChanged(); }
    }

    // ── v6.1.0: 완공 비디오 자산 → B2B Webhook 자동 발화(FireAndForget · 비블로킹) + 라이브 프리뷰 프레임 제공자 ──
    private void FireVideoWebhook(string? url, string label)
    {
        if (string.IsNullOrWhiteSpace(url)) return;
        Webhook.FireAndForget("video.completed",
            new VideoCompletedWebhookPayload(
                string.IsNullOrWhiteSpace(Project?.Title) ? "PromptFlow" : Project!.Title,
                label,
                url,
                WanSampleFactory.IsImageUrl(url!) ? "image" : "video",
                DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()),
            PromptFlowWireJsonContext.Default.VideoCompletedWebhookPayload);
    }

    // 라이브 프리뷰 스틸 프레임 제공자 — 최신 결과/완료 썸네일(없으면 null → 스트리머가 합성 스틸 폴백).
    private string? LatestFrameProvider()
        => _dockResultUrl ?? (_completedThumbs.Count > 0 ? _completedThumbs[^1] : ActualUrl);

    // v5.8.0: 자이로 뷰어 카메라 모션 태그 → 세션 초안(닥/예상 프레임)에 콤마 부착 주입.
    private void HandleGyroMotion(string tag)
    {
        if (string.IsNullOrWhiteSpace(tag)) return;
        _session.DraftPrompt = string.IsNullOrWhiteSpace(_session.DraftPrompt) ? tag : $"{_session.DraftPrompt}, {tag}";
        _msg = "🎥 카메라 모션 태그를 생성 닥 초안에 주입했습니다.";
