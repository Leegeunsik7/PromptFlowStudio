    // ── v5.7.5 라이브 DAG 스텝퍼(SegmentProgress 1:1) + 정체성 드리프트 얼럿 ──
    private int _currentStepIndex;
    private int _currentTotalSteps;
    private readonly Dictionary<int, string> _completedStepThumbs = new();
    private bool _driftWarn;
    private static readonly string[] DriftKw = { "변신", "변형", "다른 얼굴", "얼굴 교체", "합성", "morph", "transform", "face swap", "deepfake" };

    // ✨ AI 부스팅 — 원격 델리게이트 우선, 없거나 실패 시 BCL 휴리스틱 폴백(오프라인·1/60초).
    private async Task ApplyAiBoost()
    {
        var draft = (_session.DraftPrompt ?? "").Trim();
        if (_isBoosting || string.IsNullOrWhiteSpace(draft)) return;
        _isBoosting = true; StateHasChanged();
        try { _session.DraftPrompt = OnBoostPrompt is not null ? await OnBoostPrompt(draft) : WanPromptCompiler.EnhancePromptHeuristic(draft); }
        catch { _session.DraftPrompt = WanPromptCompiler.EnhancePromptHeuristic(draft); }   // 원격 실패 → BCL 폴백
        finally { _isBoosting = false; }
    }

    // 생성 닥 제출(➔) → WanRenderClient.SubmitAsync 직결(백엔드 미구성 시 WanLocalStubEngine 폴백) + 인라인 프로그레스.
    private string _liveStep = "";               // v5.7.2 라이브 세그먼트 단계 메시지
    private List<string> _completedThumbs = new();  // v5.7.2 완성 컷 썸네일 스트립
    private System.Threading.CancellationTokenSource? _dockCts;   // v5.7.3 닥 체인 취소

    // v5.7.1~v5.7.3: 세그먼트 수(1/3/4)만큼 FlowExecutionPipeline 연쇄 생성 + Concat 병합 · SegmentProgress 라이브 바인딩 · CTS 취소.
    private async Task HandleDockSubmit(MobilePromptDock.ChainSubmit sub)
    {
        if (_dockRunning || string.IsNullOrWhiteSpace(sub.Prompt)) return;

        // v6.0.3: [⚡ GPU 그리드 분산 가동] ON + 가용 노드 존재 → 컷 세그먼트를 분산 노드로 즉시 이관(멀티모달 파이프라인 브리지).
        //   가용 노드가 없으면 조용히 로컬 파이프라인으로 폴백(Graceful) — 기존 RunShortsChainAsync 흐름 무손상.
        if (_useGpuGrid && Grid.UsableNodeCount > 0)
        {
            await RunViaGpuGridAsync(sub);
            return;
        }

        _dockCts?.Cancel(); _dockCts?.Dispose();
        _dockCts = new System.Threading.CancellationTokenSource();
        var ct = _dockCts.Token;

        _lastDockPrompt = sub.Prompt; _msg = null;   // v5.7.5: 초안(_session)은 제출/뷰 전환 후에도 보존
        _dockRunning = true; _dockPercent = 3; _liveStep = "🎬 파이프라인 가동 중…"; _completedThumbs = new();
        // v5.7.5 라이브 스텝퍼 초기화 + 정체성 드리프트 사전 판정(변형 키워드 → Strict 자율 격상).
        _currentTotalSteps = sub.Segments; _currentStepIndex = 1; _completedStepThumbs.Clear();
        _lastChainSegments = sub.Segments;   // v5.7.7: 이어보기 총 컷 추정용(세션 보존)
        var lower = sub.Prompt.ToLowerInvariant();
        _driftWarn = System.Array.Exists(DriftKw, k => lower.Contains(k));
        if (_driftWarn) _guardPreset = QualityGuardrailPreset.Strict;
        StateHasChanged();

        var progress = new Progress<FlowExecutionPipeline.SegmentProgress>(sp =>
        {
            _dockPercent = sp.ProgressPercent;
            _liveStep = sp.StepMessage;
            _currentStepIndex = sp.StepIndex;
            // 완료 통지 → 스텝퍼(딕셔너리)·닥 스트립(리스트) 동시 누적(스텝당 첫 완료만 · 최종 병합 결과 제외).
            if (sp.Completed && !string.IsNullOrEmpty(sp.CompletedThumbUrl))
            {
                if (!_completedStepThumbs.ContainsKey(sp.StepIndex)) _completedStepThumbs[sp.StepIndex] = sp.CompletedThumbUrl!;
                if (_completedThumbs.Count < sp.StepIndex) _completedThumbs.Add(sp.CompletedThumbUrl!);
            }
            _ = InvokeAsync(StateHasChanged);
        });

        try
        {
            // v5.7.6 컷별 오버라이드 전달 · v6.0.2 닥 자체 오버라이드가 없으면 오디오 립싱크 컷 프롬프트를 폴백으로 사용(기존 동작 무손상 · 추가 결선).
            var cutOverride = sub.CutPrompts is { Count: > 0 } ? sub.CutPrompts : _audioCutPrompts;
            var r = await Pipeline.RunShortsChainAsync(sub.Prompt, sub.Segments, Project, progress, ct, cutOverride);
            _dockPercent = 100;
            _dockResultUrl = r.MergedUrl;   // 병합 결과(스텁=이미지 data URL) → 3단 실측 [🎞️ 실제 결과]
            var snip = sub.Prompt.Length > 24 ? sub.Prompt[..24] + "…" : sub.Prompt;
            _msg = (r.Ok ? "✅ " : "⚠ ") + $"\"{snip}\" ({sub.Segments}컷) · {r.Message}";
            if (!string.IsNullOrEmpty(_dockResultUrl) && Project is not null)
            {
                Project.Gallery.Insert(0, new GalleryAsset { Url = _dockResultUrl!, Kind = GalleryAssetKind.Image, Label = snip, CreatedMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() });
                FireVideoWebhook(_dockResultUrl, snip);   // v6.1.0: 파이프라인 완공 → B2B Webhook 자동 발화
            }
        }
        catch (OperationCanceledException) { _msg = "⏹ 생성 파이프라인이 사용자에 의해 중단되었습니다."; }
        catch (Exception ex) { _msg = "⚠ 생성 오류: " + ex.Message; }
        finally { _dockRunning = false; _dockPercent = 0; StateHasChanged(); }
    }

    // v5.7.3: 닥 [⏹ 취소] → 실행 중 체인 CTS 취소(RunShortsChainAsync·GPU 분산 공통 조기 탈출).
    private void HandleDockCancel() { try { _dockCts?.Cancel(); } catch { } }

    // ── v6.0.3: 오디오 립싱크 컷 ↔ GPU 분산 그리드 실행 브리지 ──
    private bool _useGpuGrid;   // ⚡ GPU 그리드 분산 가동 토글(세션 인스턴스 필드 → 뷰 전환에도 보존)
    private void OnToggleGpuGrid(ChangeEventArgs e) => _useGpuGrid = e.Value is true;

    // 컷 프롬프트 우선순위(닥 오버라이드 > 오디오 립싱크 컷 > 기저 프롬프트 N등분) → 노드 세그먼트 요청 배열로 변환.
    private List<WanRenderRequest> BuildGridRequests(string basePrompt, int segments, IReadOnlyList<string>? cutPrompts)
    {
        var n = Math.Clamp(segments, 1, FlowExecutionPipeline.ConcatInputs);
        var list = new List<WanRenderRequest>(n);
        for (var i = 0; i < n; i++)
        {
            var prompt = cutPrompts is { Count: > 0 } && i < cutPrompts.Count ? cutPrompts[i] : basePrompt;
            list.Add(WanRenderClient.BuildRequest(new WanPromptBuild(prompt, 30, System.Array.Empty<string>(), null), Project));
        }
        return list;
    }

    // 닥 제출을 분산 그리드로 이관 — 컷 세그먼트를 워커 노드에 병렬 배정(페일오버 포함)하고 완료분을 자산화한다.
    private async Task RunViaGpuGridAsync(MobilePromptDock.ChainSubmit sub)
    {
        _dockCts?.Cancel(); _dockCts?.Dispose();
        _dockCts = new System.Threading.CancellationTokenSource();
        var ct = _dockCts.Token;

        _lastDockPrompt = sub.Prompt; _msg = null;   // 초안(_session)은 보존
        _dockRunning = true; _dockPercent = 2; _liveStep = "⚡ GPU 그리드 분산 배정 중…"; _completedThumbs = new();
        _currentTotalSteps = sub.Segments; _currentStepIndex = 1; _completedStepThumbs.Clear();
        _lastChainSegments = sub.Segments;
        var lower = sub.Prompt.ToLowerInvariant();
        _driftWarn = System.Array.Exists(DriftKw, k => lower.Contains(k));
        if (_driftWarn) _guardPreset = QualityGuardrailPreset.Strict;
        StateHasChanged();

        // 컷 프롬프트 결정: 닥 자체 오버라이드 > 오디오 립싱크 컷(_audioCutPrompts) > 기저 프롬프트.
        var cutPrompts = sub.CutPrompts is { Count: > 0 } ? sub.CutPrompts
                       : _audioCutPrompts is { Count: > 0 } ? _audioCutPrompts
                       : null;
        var requests = BuildGridRequests(sub.Prompt, sub.Segments, cutPrompts);

        // ⚠ 그리드 스케줄러/하트비트는 백그라운드 스레드 → InvokeAsync 마샬링(제3헌장).
        var progress = new Progress<GridProgress>(gp =>
        {
            _dockPercent = gp.Percent;
            _liveStep = $"⚡ 분산 렌더 {gp.Completed}/{gp.Total} · 가동 {gp.Dispatched} · 대기 {gp.Queued}" + (gp.Failed > 0 ? $" · 실패 {gp.Failed}" : "");
            _currentStepIndex = Math.Clamp(gp.Completed + gp.Dispatched, 1, Math.Max(1, gp.Total));
            _ = InvokeAsync(StateHasChanged);
        });

        try
        {
            var r = await Grid.DispatchAsync(requests, progress, ct);
            _dockPercent = 100;

            // 완료 세그먼트 URL → 라이브 스트립/스텝퍼 + 갤러리·씬 자산화(부분 보존).
            if (Project is not null && r.OrderedVideoUrls.Count > 0)
            {
                _dockResultUrl = r.OrderedVideoUrls[^1];   // 대표 프레임(3단 실측 [🎞️ 실제 결과])
                for (var i = 0; i < r.OrderedVideoUrls.Count; i++)
                {
                    var url = r.OrderedVideoUrls[i];
                    if (string.IsNullOrWhiteSpace(url)) continue;
                    var img = WanSampleFactory.IsImageUrl(url);
                    Project.Gallery.Insert(0, new GalleryAsset { Url = url, Kind = img ? GalleryAssetKind.Image : GalleryAssetKind.Video, Label = $"GPU 분산 컷 {i + 1}", CreatedMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() });
                    Project.Scenes.Add(new StoryboardScene { Prompt = $"GPU 분산 컷 {i + 1}", Status = SceneStatus.Completed, VideoUrl = img ? null : url, PosterUrl = img ? url : null });
                    if (_completedThumbs.Count < i + 1) _completedThumbs.Add(url);
                    _completedStepThumbs[i + 1] = url;
                    FireVideoWebhook(url, $"GPU 분산 컷 {i + 1}");   // v6.1.0: 세그먼트 완공 → B2B Webhook 자동 발화
                }
            }
            _msg = (r.Ok ? "✅ " : "⚠ ") + $"GPU 그리드 분산 렌더 — 성공 {r.Completed}/{r.Total} · 실패 {r.Failed} · {r.Message}";
        }
        catch (OperationCanceledException) { _msg = "⏹ GPU 분산 렌더가 중단되었습니다(완료 세그먼트는 보존)."; }
        catch (Exception ex) { _msg = "⚠ GPU 분산 오류: " + ex.Message; }
        finally { _dockRunning = false; _dockPercent = 0; StateHasChanged(); }
    }

    // ── v5.7.7: 끊긴 체인 이어보기(부분 구제된 컷 계승 → 남은 컷만 이어 렌더 + 종합 병합) ──
    private const string RescueMarker = "[부분 구제]";
    private int _lastChainSegments;   // 마지막 체인 요청 세그먼트 수(이어보기 총 컷 추정 · 세션 보존)

    // RescuePartial 이 컷 순서대로 Scenes.Add → "[부분 구제]" 마커 씬이 곧 재개 시그널(순서 보존).
    private List<StoryboardScene> RescuedScenes => Project?.Scenes
        .Where(s => s.Status == SceneStatus.Completed && (s.Prompt?.StartsWith(RescueMarker, StringComparison.Ordinal) ?? false) && !string.IsNullOrEmpty(s.PosterUrl ?? s.VideoUrl))
        .ToList() ?? new List<StoryboardScene>();
    private List<string> CompletedResumableUrls => RescuedScenes.Select(s => (s.PosterUrl ?? s.VideoUrl)!).ToList();
    private int ResumableCount => CompletedResumableUrls.Count;
    private int ResumeTotalSegments => _lastChainSegments > 1 ? _lastChainSegments : Math.Max(ResumableCount + 1, 3);
    // 부분 완성(≥1) + 목표 미달일 때만 배너 노출(완전 완료/무체인은 숨김).
    private bool HasResumableCuts => ResumableCount > 0 && ResumableCount < ResumeTotalSegments && ResumableCount < FlowExecutionPipeline.ConcatInputs;

    // 배너 [▶ 이어서 생성] → 계승 컷을 시드로 남은 컷만 이어 렌더 후 전체 Concat(성공 시 구제 씬 정리→배너 자동 해제).
    private async Task ResumeShortsChain()
    {
        if (_dockRunning) return;
        var resumeUrls = CompletedResumableUrls;
        if (resumeUrls.Count == 0) return;
        var total = ResumeTotalSegments;

        var prompt = !string.IsNullOrWhiteSpace(_session.DraftPrompt) ? _session.DraftPrompt
            : !string.IsNullOrWhiteSpace(WorkspaceSeed) ? WorkspaceSeed : "cinematic continuation, consistent identity";

        _dockCts?.Cancel(); _dockCts?.Dispose();
        _dockCts = new System.Threading.CancellationTokenSource();
        var ct = _dockCts.Token;

        _dockRunning = true; _msg = null;
        _currentTotalSteps = total; _currentStepIndex = resumeUrls.Count;
        _completedThumbs = new List<string>(resumeUrls);          // 계승 컷을 라이브 스트립에 선반영(연속성)
        _completedStepThumbs.Clear();
        for (var k = 0; k < resumeUrls.Count; k++) _completedStepThumbs[k + 1] = resumeUrls[k];
        _dockPercent = resumeUrls.Count * 80 / Math.Max(total, 1);
        _liveStep = $"🎬 컷 #{resumeUrls.Count + 1}부터 이어서 가동 중…";
        StateHasChanged();

        var progress = new Progress<FlowExecutionPipeline.SegmentProgress>(sp =>
        {
            _dockPercent = sp.ProgressPercent; _liveStep = sp.StepMessage; _currentStepIndex = sp.StepIndex;
            if (sp.Completed && !string.IsNullOrEmpty(sp.CompletedThumbUrl))
            {
                if (!_completedStepThumbs.ContainsKey(sp.StepIndex)) _completedStepThumbs[sp.StepIndex] = sp.CompletedThumbUrl!;
                if (_completedThumbs.Count < sp.StepIndex) _completedThumbs.Add(sp.CompletedThumbUrl!);
            }
            _ = InvokeAsync(StateHasChanged);
        });

        try
        {
            // v5.7.7: existingCompletedUrls 로 계승분 전달 → 파이프라인이 startIdx 이후만 렌더 후 종합 병합.
            var r = await Pipeline.RunShortsChainAsync(prompt, total, Project, progress, ct, null, resumeUrls);
            _dockPercent = 100;
            _dockResultUrl = r.MergedUrl;
            _msg = (r.Ok ? "✅ " : "⚠ ") + $"({total}컷 이어서 완공) · {r.Message}";
            if (r.Ok && Project is not null)
            {
                foreach (var sc in RescuedScenes) Project.Scenes.Remove(sc);   // 병합 완료 → 구제 컷 정리(배너 자동 해제)
                if (!string.IsNullOrEmpty(_dockResultUrl))
                    Project.Gallery.Insert(0, new GalleryAsset { Url = _dockResultUrl!, Kind = WanSampleFactory.IsImageUrl(_dockResultUrl!) ? GalleryAssetKind.Image : GalleryAssetKind.Video, Label = "이어보기 최종", CreatedMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() });
            }
        }
        catch (OperationCanceledException) { _msg = "⏹ 이어보기가 중단되었습니다."; }
        catch (Exception ex) { _msg = "⚠ 이어보기 오류: " + ex.Message; }
        finally { _dockRunning = false; _dockPercent = 0; StateHasChanged(); }
    }

    // 3:4 카셀 카드 커버 — 최신 갤러리 이미지 자산(없으면 null → 그라디언트+이모지 폴백).
    private string? GalleryCover(int index)
    {
        if (Project?.Gallery is null || Project.Gallery.Count == 0) return null;
        var imgs = Project.Gallery.Where(a => a.Kind == GalleryAssetKind.Image || WanSampleFactory.IsImageUrl(a.Url))
                                  .OrderByDescending(a => a.CreatedMs).Select(a => a.Url).ToList();
        return index >= 0 && index < imgs.Count ? imgs[index] : null;
    }

    // 3:4 카셀 카드(외부 에셋 0 · 그라디언트/갤러리 커버 + 이모지 + 대표 시드 프롬프트).
