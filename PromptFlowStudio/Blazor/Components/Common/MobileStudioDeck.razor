    // ── v6.0.2: 오디오 파형 스튜디오 결선 — 보컬 싱크 계획을 초안(대표 립싱크 수식어·멱등) + 컷 오버라이드로 반영 ──
    private IReadOnlyList<string>? _audioCutPrompts;   // 컷별 립싱크 프롬프트(닥 자체 오버라이드가 없을 때 폴백으로 사용)
    private void HandleAudioSync(VocalSyncPlan plan)
    {
        if (plan is null || plan.CutCount == 0) return;
        // 대표 다이내믹 수식어를 초안에 멱등 주입(닥 SeedText·예상 프레임에 즉시 반영 · 뷰 전환에도 보존).
        _session.DraftPrompt = VocalSyncNode.AppendLipSync(_session.DraftPrompt, VocalSyncNode.DominantModifier(plan));
        // 컷별 립싱크 프롬프트를 파이프라인 컷 오버라이드 폴백으로 보관(닥이 자체 컷 프롬프트를 주면 그쪽이 우선).
        _audioCutPrompts = VocalSyncNode.BuildCutPrompts(_session.DraftPrompt, plan);
        _msg = $"🎼 오디오 {plan.CutCount}컷 립싱크 수식어 주입 — 생성 닥 ➔ 로 렌더하면 컷별로 적용됩니다.";
    }

    private double _rotX = -20, _rotY = 20;
    private bool _dragging;
    private double _lastX, _lastY;

    protected override void OnInitialized() => _memToken = MemAudit.Track("MobileStudioDeck");

    private static string N(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private static MobilePermission PermFor(CaptureKind kind) => kind == CaptureKind.Audio ? MobilePermission.Microphone : MobilePermission.Camera;

    private async Task Capture(CaptureKind kind)
    {
        _busy = true; _msg = null;
        try
        {
            if (!await Bridge.EnsurePermissionAsync(PermFor(kind))) { _msg = "⚠ 권한이 거부되었습니다."; return; }
            var r = await Bridge.CaptureAsync(kind);
            if (r.Ok && r.Path is not null)
            {
                if (kind == CaptureKind.Photo) { Project.AnchorImagePath = r.Path; Project.MobileCaptureSource = "camera"; _msg = "📷 촬영 완료 — 앵커 이미지로 설정(전 컷 i2v 일관성)."; }
                else _msg = $"✅ 캡처 완료: {System.IO.Path.GetFileName(r.Path)}";
            }
            else _msg = r.Message;
        }
        catch (Exception ex) { _msg = "⚠ " + ex.Message; }
        finally { _busy = false; }
    }

    private void OnWorker(ChangeEventArgs e) => Project.RemoteWorkerUrl = e.Value?.ToString() ?? "";
    private void OnRemoteToggle(ChangeEventArgs e) => Project.RemoteRenderEnabled = e.Value is true;
    private void OnChromaToggle(ChangeEventArgs e) => Project.ChromaAutoKey = e.Value is true;

    private void Offload()
    {
        if (!RemoteRenderClient.IsValidWorkerUrl(Project.RemoteWorkerUrl)) { _msg = "⚠ 워커 URL 이 유효하지 않습니다 (http/https/ws/wss)."; return; }
        var env = RemoteRenderClient.BuildEnvelope(Project);
        Project.RemoteRenderEnabled = true;
        var head = env.Checksum.Length >= 8 ? env.Checksum[..8] : env.Checksum;
        _msg = $"☁️ 오프로딩 준비 — 잡 {env.JobId} · {Project.Scenes.Count}컷 · 체크섬 {head}… · AES-256 암호화. [✨ 전체 생성] 시 PC 워커로 위임되어 60fps MP4 + PDF 를 수신합니다.";
    }

    private void SeparateBg()
    {
        Project.ChromaAutoKey = true;
        _msg = string.IsNullOrWhiteSpace(Project.AnchorImagePath)
            ? "✂️ 먼저 카메라/갤러리로 사진을 등록하면 배경이 1초 만에 알파로 분리됩니다."
            : "✂️ 온디바이스 배경 분리 활성 — 순수 BCL 색거리 매트 + FFmpegKit chromakey 로 크로마 알파 컷아웃을 생성합니다.";
    }

    private void ResetCube() { _rotX = -20; _rotY = 20; }
    private void OnDown(PointerEventArgs e) { _dragging = true; _lastX = e.ClientX; _lastY = e.ClientY; }
    private void OnMove(PointerEventArgs e)
    {
        if (!_dragging) return;
        _rotY += (e.ClientX - _lastX) * 0.6;
        _rotX -= (e.ClientY - _lastY) * 0.6;
        _lastX = e.ClientX; _lastY = e.ClientY;
    }
    private void OnUp(PointerEventArgs e) => _dragging = false;

    // ══════════════════ v5.4 인터랙티브 플로우 오버레이 ══════════════════
