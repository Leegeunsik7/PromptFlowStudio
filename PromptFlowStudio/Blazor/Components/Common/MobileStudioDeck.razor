@using PromptFlowStudio.Services.Mobile
@using PromptFlowStudio.Services.Wan
@using PromptFlowStudio.Services.Flow
@using PromptFlowStudio.Services
@using PromptFlowStudio.Services.Integration
@implements IDisposable
@inject IMobilePlatformBridge Bridge
@inject RemoteRenderClient Remote
@inject ILocalMediaService Media
@inject ISpatialVoicePrompter Voice
@inject WanRenderClient Wan
@inject FlowExecutionPipeline Pipeline
@inject DistributedRenderGrid Grid
@inject PromptFlowStudio.Services.Integration.WebhookDispatcher Webhook
@inject PromptFlowStudio.Services.Integration.WebRtcStreamer Rtc
@* v6.0.1-b~v6.1.0: 분산 GPU 그리드/Webhook 디스패처/WebRTC 스트리머 — 부모(셸)가 주입, 서브 패널엔 [Parameter] 로 전달(모바일 무주입 원칙). *@
@inject PromptFlowStudio.Services.Ui.StudioMemoryAudit MemAudit
@* v5.7.3: PC NavigationManager 주입 제거 — 모바일은 MobileInternalView 내부 라우팅만 사용(PC 화면 전환 차단) *@

@* [PromptFlow Studio] v4.0.0 모바일 제어반(Task 4) — 삼성 DeX/갤럭시 S26 반응형 + 터치 드래그 CAD 3D · 카메라 캡처 · 리모트 오프로딩 · 온디바이스 배경 분리(네온 글래스모피즘). *@

<div class="msd">
    @* v5.6.7: 부팅 시네마틱 히어로(진입 후 숨김) *@
    @if (_showHero) { <FlowLandingHero OnEnterStudio="EnterStudio" /> }
    <div class="msd-h">
        @* v5.6.1: PC 사이드바 대칭 햄버거 드로어 · v5.6.5: 모바일 특화 액션 결선 *@
        <MobileNavDrawer OnMobileAction="HandleMobileAction" OnInternalNav="HandleDrawerNav" CurrentInternalView="_internalView" />
        <span class="msd-title">📱 모바일 · DeX 스튜디오</span><span class="msd-badge">v4.0.0</span>
        <span class="msd-plat">@Bridge.Info.Platform · @Bridge.Info.FfmpegBackend</span>
    </div>

    @* v5.6.5: 워크스페이스 ↔ 스튜디오 탭(모바일 부팅 기본 = 🏠 워크스페이스 · PC 워크스페이스 대칭) *@
    <div class="msd-tabs">
        <button class="msd-tab @(_view == MobileView.Workspace ? "on" : null)" @onclick="() => _view = MobileView.Workspace">🏠 워크스페이스</button>
        <button class="msd-tab @(_view == MobileView.Studio ? "on" : null)" @onclick="() => _view = MobileView.Studio">📱 스튜디오</button>
    </div>

    @* v5.7.6(2차): 독립 스크롤 본문(flex:1 1 auto) — 헤더/탭 고정 + 닥은 스크롤 외부 absolute 풋터 레이어로 격리(하단 130px 여백=닥 겹침 해소) *@
    <div class="msd-scroll-body">
    @if (_view == MobileView.Workspace)
    {
        @* 부팅 대시보드 — 프로젝트 요약 + 예상 첫 프레임(전역 시뮬레이터) + PC 라우트 퀵런치 *@
        @* v5.7.3: 수직(full-width) 컬럼 흐름 — 카드 겹침/찌그러짐 0 *@
        <div class="msd-ws">
            @if (_internalView == MobileInternalView.Workspace)
            {
                <div class="msd-ws-hero">
                    <span class="msd-ws-ic">🏠</span>
                    <div class="msd-ws-tt">
                        <div class="msd-ws-t">워크스페이스</div>
                        <div class="msd-ws-s">@(string.IsNullOrWhiteSpace(Project?.Title) ? "새 프로젝트" : Project!.Title) · @(Project?.Scenes.Count ?? 0)컷</div>
                    </div>
                </div>

                @* v6.2.x: PC 공용 테마 퀵스위치를 워크스페이스 상단(히어로 직하단)으로 이동 — 세로 스크롤 없이 즉시 노출. 호스트 ThemeService 위임(무주입). *@
                @if (ThemeNames is { Count: > 0 })
                {
                    <div class="msd-theme">
                        <span class="msd-theme-t">🎨 테마 (PC 공용 · @(ThemeNames.Count)종)</span>
                        <div class="msd-theme-chips">
                            <button type="button" class="msd-theme-chip @(string.IsNullOrEmpty(ActiveThemeName) ? "on" : null)" @onclick='() => ApplyThemePick("")'>기본</button>
                            @foreach (var t in ThemeNames)
                            {
                                <button type="button" class="msd-theme-chip @(t == ActiveThemeName ? "on" : null)" @onclick="() => ApplyThemePick(t)" @key="t">@t</button>
                            }
                        </div>
                    </div>
                }

                @* v5.7.7: 부분 완성(중단/실패 후 구제) 컷 감지 시 이어보기 스마트 배너(성공 병합 후 자동 해제) *@
                @if (HasResumableCuts && !_dockRunning)
                {
                    <div class="msd-resume-banner">
                        <div class="rb-info"><span class="rb-ic">🔄</span><span>중단된 숏츠 — 완성 <b>@ResumableCount</b>컷 계승, <b>#@(ResumableCount + 1)</b>컷부터 이어서 생성할 수 있습니다.</span></div>
                        <button type="button" class="msd-resume-run" @onclick="ResumeShortsChain">▶ 이어서 생성</button>
                    </div>
                }

                @* 3:4 가로 스크롤 퀵 카셀(카드 터치=닥/프리뷰 시드 주입 · PC 전환 없음) *@
                <div class="msd-carousel">
                    @foreach (var (c, ci) in FlowCards.Select((c, i) => (c, i)))
                    {
                        <button class="msd-card34" style="--acc:@c.Accent" @onclick="() => HandleCardAction(c.Key)" @key="c.Key">
                            <span class="msd-card34-media">
                                @if (GalleryCover(ci) is { } cover) { <img class="msd-card34-cover" src="@cover" alt="@c.Label" /> }
                                else { <span class="msd-card34-emoji">@c.Emoji</span> }
                                <span class="msd-card34-tag">@c.Tag</span>
                            </span>
                            <span class="msd-card34-lbl">@c.Label</span>
                        </button>
                    }
                </div>

                @* 프로젝트 구획 + [＋ 신규](모바일 내부 전환) *@
                <div class="msd-proj-head">
                    <span class="msd-proj-title">스토리보드 프로젝트</span>
                    <button class="msd-proj-new" @onclick="() => SwitchInternal(MobileInternalView.Prompt)">＋ 신규</button>
                </div>
                <div class="msd-proj-list">
                    @if (Project is not null && (Project.Scenes.Count > 0 || !string.IsNullOrWhiteSpace(Project.Title)))
                    {
                        <div class="msd-proj-item">
                            <span class="msd-proj-thumb">🎬</span>
                            <span class="msd-proj-info">
                                <span class="pn">@(string.IsNullOrWhiteSpace(Project.Title) ? "새 프로젝트" : Project.Title)</span>
                                <span class="pm">@(Project.Scenes.Count)컷 · Wan 3.0</span>
                            </span>
                            <span class="msd-proj-more">⋮</span>
                        </div>
                    }
                    else
                    {
                        <div class="msd-proj-empty">아직 프로젝트가 없습니다. 아래 생성 닥에서 첫 장면을 시작하세요.</div>
                    }
                </div>

                @* v5.7.3 Task3: 스토리보드 카드 직하단 full-width 단독 수직 구획(겹침·찌그러짐 근본 해소) *@
                <section class="msd-preview-wrap">
                    <FirstFramePreviewDeck Prompt="@(string.IsNullOrWhiteSpace(_session.DraftPrompt) ? WorkspaceSeed : _session.DraftPrompt)" AnchorImageUrl="@AnchorUrl" ActualOutputUrl="@(_dockResultUrl ?? ActualUrl)" OnRegisterAnchor="() => Capture(CaptureKind.Photo)" />
                </section>

                @* 퀵런치 — 전 모바일 내부 뷰를 워크스페이스에 직접 타일로 노출(세로에서 카셀 가로스크롤·드로어 없이 즉시 진입). v6.2.x: 자이로/대량양산/오디오/GPU 그리드 추가. *@
                <div class="msd-ws-quick-h">빠른 메뉴</div>
                <div class="msd-ws-quick">
                    <button class="msd-ws-q" @onclick="() => SwitchInternal(MobileInternalView.Prompt)">✍️<span>프롬프트</span></button>
                    <button class="msd-ws-q" @onclick="() => SwitchInternal(MobileInternalView.Storyboard)">🎞️<span>스토리보드</span></button>
                    <button class="msd-ws-q" @onclick="() => SwitchInternal(MobileInternalView.Flow)">🕹️<span>노드 플로우</span></button>
                    <button class="msd-ws-q" @onclick="() => SwitchInternal(MobileInternalView.Gyro)">🌀<span>자이로 3D</span></button>
                    <button class="msd-ws-q" @onclick="() => SwitchInternal(MobileInternalView.Batch)">🏭<span>대량 양산</span></button>
                    <button class="msd-ws-q" @onclick="() => SwitchInternal(MobileInternalView.AudioSync)">🎼<span>오디오 립싱크</span></button>
                    <button class="msd-ws-q" @onclick="() => SwitchInternal(MobileInternalView.NodeGrid)">⚡<span>GPU 그리드</span></button>
                    <button class="msd-ws-q" @onclick="() => _view = MobileView.Studio">📱<span>스튜디오</span></button>
                </div>

                @* v6.0.1-b: [⚡ GPU 그리드 분산 가동] 원클릭 전환 CTA — 가용 노드 수 배지 동반 *@
                <button class="msd-grid-cta" @onclick="() => SwitchInternal(MobileInternalView.NodeGrid)">
                    <span class="msd-grid-cta-ic">⚡</span>
                    <span class="msd-grid-cta-tx">GPU 그리드 분산 가동<span class="msd-grid-cta-sub">원격 워커에 대량 양산·세그먼트 큐 분산 + 페일오버</span></span>
                    <span class="msd-grid-cta-badge @(Grid.UsableNodeCount > 0 ? "on" : null)">노드 @Grid.UsableNodeCount</span>
                </button>

                @* v6.0.3: 생성 시 GPU 그리드로 분산 렌더 토글 — ON+가용노드면 닥 제출이 컷 세그먼트를 분산 노드로 즉시 이관 *@
                <label class="msd-grid-toggle @(_useGpuGrid ? "on" : null)">
                    <input type="checkbox" checked="@_useGpuGrid" @onchange="OnToggleGpuGrid" disabled="@(Grid.UsableNodeCount == 0)" />
                    <span class="msd-grid-toggle-tx">⚡ 생성 시 GPU 그리드로 컷 분산 렌더 @(Grid.UsableNodeCount == 0 ? "(노드 등록 필요)" : $"({Grid.UsableNodeCount}노드 병렬)")</span>
                </label>

            }
            else
            {
                @* v5.7.4: 모바일 내부 독립 서브 스튜디오(실체화 · PC 전환 없음) *@
                <div class="msd-sub">
                    <div class="msd-sub-head">
                        <button class="msd-sub-back" @onclick="() => SwitchInternal(MobileInternalView.Workspace)" title="워크스페이스로">←</button>
                        <span class="msd-sub-t">@InternalIcon @InternalTitle</span>
                    </div>

                    @if (_internalView == MobileInternalView.Storyboard)
                    {
                        @* 1. 컴팩트 스토리보드 컷 뷰어(썸네일+인라인 편집+추가/삭제) *@
                        <div class="msd-sub-actions">
                            <span class="msd-sub-count">총 @(Project?.Scenes.Count ?? 0)컷</span>
                            <button class="msd-sub-add" @onclick="AddCompactCut">＋ 컷 추가</button>
                        </div>
                        <div class="msd-cutlist">
                            @if (Project?.Scenes is { Count: > 0 })
                            {
                                @foreach (var (scene, idx) in Project.Scenes.Select((s, i) => (s, i)))
                                {
                                    <div class="msd-cutcard" @key="scene.Id">
                                        @if (!string.IsNullOrEmpty(scene.PosterUrl)) { <img class="msd-cut-thumb" src="@scene.PosterUrl" alt="컷" /> }
                                        else { <div class="msd-cut-thumb ph">🎬</div> }
                                        <div class="msd-cut-mid">
                                            <span class="msd-cut-no">컷 #@(idx + 1)</span>
                                            <input class="msd-cut-in" @bind="scene.Prompt" @bind:event="oninput" placeholder="장면 프롬프트…" />
                                        </div>
                                        <button class="msd-cut-del" @onclick="() => RemoveCut(scene)" title="컷 삭제">✕</button>
                                    </div>
                                }
                            }
                            else { <div class="msd-sub-empty">등록된 컷이 없습니다. [＋ 컷 추가]로 시작하세요.</div> }
                        </div>
                    }
                    else if (_internalView == MobileInternalView.Prompt)
                    {
                        @* 2. AI 프롬프트 부스터 — 초안 편집 + 칩 부착 + ✨ AI 부스팅(원격 델리게이트 or BCL 폴백) *@
                        <div class="msd-boost-head">
                            <p class="msd-sub-desc">초안을 적고 칩으로 살을 붙인 뒤 [✨ AI 부스팅]으로 고밀도 시네마틱 구문으로 증강하세요.</p>
                            <button class="msd-boost-btn" @onclick="ApplyAiBoost" disabled="@(_isBoosting || string.IsNullOrWhiteSpace(_session.DraftPrompt))">
                                @(_isBoosting ? "✨ 증강 중…" : "✨ AI 부스팅 주입")
                            </button>
                        </div>
                        <textarea class="msd-draft-ta" rows="3" @bind="_session.DraftPrompt" @bind:event="oninput"
                                  placeholder="장면 구상을 자유롭게 적으세요… (칩·부스팅이 여기에 합성됩니다)"></textarea>
                        @foreach (var grp in PromptChipGroups)
                        {
                            <div class="msd-chip-grp" @key="grp.Title">
                                <span class="msd-chip-gtitle">@grp.Title</span>
                                <div class="msd-chip-row">
                                    @foreach (var chip in grp.Chips)
                                    {
                                        <button class="msd-chip" @onclick="() => AppendPromptChip(chip.Text)" @key="chip.Label">@chip.Label</button>
                                    }
                                </div>
                            </div>
                        }
                        <div class="msd-boost-foot">이 초안은 화면 전환 후에도 세션에 보존되며 하단 생성 닥·예상 프레임에 자동 반영됩니다.</div>
                    }
                    else if (_internalView == MobileInternalView.Flow)
                    {
                        @* 3. 라이브 DAG 스텝퍼 — RunShortsChainAsync SegmentProgress와 1:1 바인딩(컷별 대기/가동/완공 + 썸네일) *@
                        <p class="msd-sub-desc">컷별 I2V 연쇄 렌더 상태 — @(_dockRunning ? $"진행 {_dockPercent}%" : "대기 중")</p>
                        <div class="msd-dagstep">
                            @for (var i = 1; i <= Math.Max(_currentTotalSteps, 1); i++)
                            {
                                var step = i;
                                var done = _completedStepThumbs.ContainsKey(step);
                                var running = _dockRunning && _currentStepIndex == step && !done;
                                <div class="msd-dagstep-item @(running ? "run" : done ? "done" : "idle")" @key="step">
                                    <span class="msd-dagstep-no">컷 #@step</span>
                                    <div class="msd-dagstep-mid">
                                        <span class="msd-dagstep-lbl">I2V 세그먼트 @step/@Math.Max(_currentTotalSteps, 1)</span>
                                        <span class="msd-dagstep-st">
                                            @if (running) { <span class="pulse">⚡ 렌더링 가동 중…</span> }
                                            else if (done) { <span class="ok">✓ 완공</span> }
                                            else { <span class="muted">· 대기</span> }
                                        </span>
                                    </div>
                                    @if (done && _completedStepThumbs.TryGetValue(step, out var thumb) && !string.IsNullOrEmpty(thumb))
                                    {
                                        <img class="msd-dagstep-thumb" src="@thumb" alt="컷 @step 결과" />
                                    }
                                </div>
                            }
                        </div>
                        @if (_driftWarn)
                        {
                            <div class="msd-drift-banner">🛡️ 정체성 이탈 주의 — 가드레일이 <b>Strict</b> 로 자율 격상되었습니다(변형 키워드 감지).</div>
                        }
                    }
                    else if (_internalView == MobileInternalView.Batch)
                    {
                        @* v5.8.0: B2B 대량 양산 팩토리(템플릿 변수 치환 → 세그먼트 큐 렌더 · 완료 즉시 자산화) *@
                        <BatchFactoryMobileView IsRunning="_dockRunning" ProgressPercent="_dockPercent" LiveStep="@_liveStep" OnStartBatchRequest="HandleBatchStart" />
                    }
                    else if (_internalView == MobileInternalView.Gyro)
                    {
                        @* v5.8.0: 3D 자이로 모션 라이브 뷰어(가상 조이스틱 → 카메라 모션 태그 주입) *@
                        <MobileGyroViewer OnApplyMotionTag="HandleGyroMotion" />
                    }
                    else if (_internalView == MobileInternalView.NodeGrid)
                    {
                        @* v6.0.1-b: 원격 GPU 워커 분산 렌더 노드 HUD(그리드 싱글턴 [Parameter] 전달 · 무주입) *@
                        <DistributedNodeHudPanel Grid="Grid" />
                    }
                    else if (_internalView == MobileInternalView.AudioSync)
                    {
                        @* v6.0.2: 오디오 파형 스튜디오 — 보컬 립싱크 컷 분할 → 컷별 프롬프트 주입(무주입 · EventCallback) *@
                        <AudioWaveformStudioView OnApplySync="HandleAudioSync" />
                    }
                    else if (_internalView == MobileInternalView.WebhookLog)
                    {
                        @* v6.1.0: B2B Webhook 발송 로그(디스패처 싱글턴 [Parameter] 전달 · 무주입) *@
                        <WebhookLogView Dispatcher="Webhook" />
                    }
                    else if (_internalView == MobileInternalView.LiveStream)
                    {
                        @* v6.1.0: WebRTC 초저지연 라이브 프리뷰(스트리머 [Parameter] 전달 · 최신 프레임 제공자 · 무주입) *@
                        <MobileLivePreviewPlayer Streamer="Rtc" SignalUrl="@Project?.RemoteWorkerUrl" StillFrameProvider="LatestFrameProvider" />
                    }
                    else
                    {
                        <div class="msd-sub-empty">@InternalTitle 뷰는 준비 중입니다 — 워크스페이스에서 계속하세요.</div>
                    }
                </div>
            }
        </div>
    }
    else
    {
    @* v5.3.4: PromptFlow 모바일 스튜디오 덱(프롬프트/씬/렌더큐/자이로 3D 구도) 상단 마운트 · 프로젝트 전달 *@
    <div class="msd-supremacy"><MobileSupremacyDeck Project="Project" /></div>

    <div class="msd-grid">
        @* ── ① 네이티브 캡처 ── *@
        <div class="msd-card">
            <div class="msd-ct">📷 즉석 캡처 <span class="msd-sub">@(Bridge.Info.IsMobile ? "카메라/마이크 권한 연동" : "데스크톱=파일 선택")</span></div>
            <div class="msd-caps">
                <button class="msd-cap" @onclick="() => Capture(CaptureKind.Photo)" disabled="@(Disabled || _busy)"><span class="msd-cap-e">📷</span>사옥/아기 촬영</button>
                <button class="msd-cap" @onclick="() => Capture(CaptureKind.Video)" disabled="@(Disabled || _busy)"><span class="msd-cap-e">🎬</span>영상 클립</button>
                <button class="msd-cap" @onclick="() => Capture(CaptureKind.Audio)" disabled="@(Disabled || _busy)"><span class="msd-cap-e">🎤</span>음성 지시(NLU)</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(Project.AnchorImagePath)) { <div class="msd-anchor">⚓ 앵커: @System.IO.Path.GetFileName(Project.AnchorImagePath)</div> }
        </div>

        @* ── ② 리모트 렌더 오프로딩 ── *@
        <div class="msd-card">
            <div class="msd-ct">☁️ 리모트 렌더 오프로딩 <span class="msd-sub">PC RTX 워커</span></div>
            <input class="msd-in" value="@Project.RemoteWorkerUrl" @oninput="OnWorker" placeholder="워커 주소 (예: http://192.168.0.10:8080)" disabled="@Disabled" inputmode="url" />
            <label class="msd-tg"><input type="checkbox" checked="@Project.RemoteRenderEnabled" @onchange="OnRemoteToggle" disabled="@Disabled" /> 스마트폰 렌더를 PC 워커로 위임(AES-256 암호화 전송)</label>
            <button class="msd-btn go" @onclick="Offload" disabled="@(Disabled || _busy)">☁️ PC 워커로 60fps 오프로딩</button>
        </div>

        @* ── ③ 3D 씬 구도 프리뷰(드래그 회전) ── *@
        <div class="msd-card">
            <div class="msd-ct">🧊 3D 씬 구도 프리뷰 <span class="msd-sub">드래그로 회전</span><button class="msd-mini" @onclick="ResetCube">↺</button></div>
            <div class="msd-cube-wrap" @onpointerdown="OnDown" @onpointermove="OnMove" @onpointerup="OnUp" @onpointerleave="OnUp">
                <div class="msd-cube" style="--rx:@(N(_rotX))deg; --ry:@(N(_rotY))deg">
                    <div class="msd-face f1"></div><div class="msd-face f2"></div><div class="msd-face f3"></div>
                    <div class="msd-face f4"></div><div class="msd-face f5"></div><div class="msd-face f6"></div>
                </div>
            </div>
            <div class="msd-rot">X @(N(_rotX))° · Y @(N(_rotY))°</div>
        </div>

        @* ── ④ 온디바이스 배경 분리 ── *@
        <div class="msd-card">
            <div class="msd-ct">✂️ 온디바이스 배경 분리 <span class="msd-sub">1초 크로마 알파</span></div>
            <label class="msd-tg"><input type="checkbox" checked="@Project.ChromaAutoKey" @onchange="OnChromaToggle" disabled="@Disabled" /> 촬영 배경을 자동 알파 컷아웃</label>
            <button class="msd-btn cut" @onclick="SeparateBg" disabled="@(Disabled || _busy)">✂️ 배경 1초 분리</button>
            <div class="msd-note">순수 BCL 색거리 매트(GPU 불필요) + FFmpegKit chromakey 고품질 경로. 버추얼 스튜디오/기념 카드 합성에 재사용됩니다.</div>
        </div>
    </div>

    @* ── v5.4 인터랙티브 플로우 런처(구글 Flow 초월 4대 모바일 UX) ── *@
    <div class="msd-flow54">
        <div class="msd-ct">🚀 v5.4 인터랙티브 플로우 <span class="msd-sub">제스처·모션·음성·햅틱</span></div>
        <div class="msd-flow-btns">
            <button class="msd-flow-b canvas" @onclick="() => OpenFlow(FlowScreen.Canvas)">🕹️<span>노드 오케스트레이터</span></button>
            <button class="msd-flow-b motion" @onclick="() => OpenFlow(FlowScreen.Motion)">🎯<span>모션 벡터</span></button>
            <button class="msd-flow-b voice" @onclick="() => OpenFlow(FlowScreen.Voice)">🎙️<span>공간 음성</span></button>
            <button class="msd-flow-b scrub" @onclick="() => OpenFlow(FlowScreen.Scrub)">🎞️<span>햅틱 스크러버</span></button>
        </div>
    </div>
    }

    @if (_msg is not null) { <div class="msd-msg">@_msg</div> }
    </div>@* /.msd-scroll-body *@

    @* ── v5.4 풀-블리드 오버레이(선택 플로우를 폰 프레임 내부에 전체 표시) ── *@
    @if (_flow != FlowScreen.None)
    {
        <div class="msd-ov">
            <div class="msd-ov-h">
                <button class="msd-ov-back" @onclick="CloseFlow">‹ 뒤로</button>
                <span class="msd-ov-t">@FlowTitle</span>
            </div>
            <div class="msd-ov-bd">
                @if (_flow == FlowScreen.Canvas)
                {
                    <TrueFlowCanvas Project="Project" />
                }
                else if (_flow == FlowScreen.Motion)
                {
                    <MotionVectorPainter Project="Project" OnPrompt="OnMotionPrompt" OnVectors="v => _lastMotion = v" />
                }
                else if (_flow == FlowScreen.Scrub)
                {
                    <HapticFrameScrubber Project="Project" />
                }
                else if (_flow == FlowScreen.Voice)
                {
                    <div class="msd-voice">
                        <div class="msd-voice-ct">🎙️ 공간 음성-비전 앵커링 <span class="msd-sub">@(Voice.IsSupported ? "실시간 음성 인식" : "데스크톱=데모 구조화")</span></div>
                        <div class="msd-voice-pad" @onpointerdown="SetAnchor" title="탭하여 사물 인식 앵커 지정">
                            <span class="msd-voice-cam">📷 현장 프리뷰 — 탭하여 앵커 지정</span>
                            <div class="msd-voice-anchor" style="left:@F(_anchorPx.X)px; top:@F(_anchorPx.Y)px">◎</div>
                        </div>
                        <textarea class="msd-voice-in" @bind="_voiceText" @bind:event="oninput" rows="2"
                                  placeholder="음성 명령 또는 직접 입력 (예: 이 기계 뒤에서 안개가 피어오르고 붉은 조명이 비추는 비디오 생성)"></textarea>
                        <div class="msd-voice-act">
                            <button class="msd-btn go" @onclick="VoiceCapture" disabled="@_voiceBusy">🎤 음성 캡처</button>
                            <button class="msd-btn cut" @onclick="VoiceStructure" disabled="@_voiceBusy">🧩 구조화</button>
                        </div>
                        @if (_voiceNode is not null)
                        {
                            <div class="msd-voice-node">
                                <div class="msd-voice-row"><b>주체</b> @_voiceNode.Subject</div>
                                <div class="msd-voice-row"><b>분위기</b> @_voiceNode.Atmosphere</div>
                                <div class="msd-voice-row"><b>조명</b> @_voiceNode.Lighting</div>
                                <div class="msd-voice-row"><b>카메라</b> @_voiceNode.Camera</div>
                                <div class="msd-voice-row"><b>앵커</b> (@F(_voiceNode.Anchor.ScreenX), @F(_voiceNode.Anchor.ScreenY)) · @SpatialPromptStructurer.Bearing(_voiceNode.Anchor.HeadingDeg)</div>
                                <code class="msd-voice-wan">@_voiceNode.WanPrompt</code>
                            </div>
                        }
                        @if (_voiceMsg is not null) { <div class="msd-voice-msg">@_voiceMsg</div> }

                        @* v5.4.1 — 모션 벡터 + 공간 음성 → WanPromptCompiler → WanRenderClient(백엔드 직결/오프라인 큐) *@
                        <div class="msd-wan">
                            <div class="msd-wan-sum">🚀 Wan 3.0 전송 대기 — 음성 @(_voiceNode is null ? "미구성" : "구성됨") · 모션 @(_lastMotion.Count)벡터 · 강도 @WanIntensity</div>
                            <button class="msd-btn go" @onclick="SendToWan" disabled="@_wanBusy">🚀 Wan 3.0 렌더 전송</button>
                            @if (_wanMsg is not null) { <div class="msd-voice-msg">@_wanMsg</div> }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* v5.6.7: Google Flow 플로팅 바텀 생성 닥(워크스페이스 · 히어로/오버레이 없을 때만) *@
    @if (_view == MobileView.Workspace && _flow == FlowScreen.None && !_showHero)
    {
        <MobilePromptDock AnchorImageUrl="@AnchorUrl" GuardEnabled="_guardEnabled" GuardPreset="_guardPreset"
                          IsRunning="_dockRunning" ProgressPercent="_dockPercent" SeedText="@_session.DraftPrompt"
                          LiveStepMessage="@_liveStep" CompletedThumbs="_completedThumbs"
                          OnSubmit="HandleDockSubmit" OnAttachAnchorRequest="() => Capture(CaptureKind.Photo)" OnToggleGuard="ToggleGuard" OnCancelRequest="HandleDockCancel" />
    }
</div>

<style>
    .msd { position: relative; display: flex; flex-direction: column; height: 100%; box-sizing: border-box; border: 1px solid color-mix(in srgb, #34d399 34%, var(--line)); border-radius: 16px; overflow: hidden; font-family: Pretendard, 'Malgun Gothic', sans-serif;
        background: linear-gradient(160deg, color-mix(in srgb, #34d399 9%, var(--card)), var(--card)); backdrop-filter: blur(16px) saturate(150%); -webkit-backdrop-filter: blur(16px) saturate(150%); }
    /* v5.7.6(2차): 뷰포트 Flexbox 3층 격리 — 헤더/탭 고정(flex:0 0 auto) · 본문 독립 스크롤(flex:1 1 auto, 하단 130px 여백) · 닥은 absolute 풋터(.msd position:relative 종속). height:100% 미확정 부모(B2B .bg-pane)에선 auto 폴백 → 종전 동작 유지. */
    .msd > .msd-h, .msd > .msd-tabs { flex: 0 0 auto; }
    .msd-scroll-body { flex: 1 1 auto; min-height: 0; overflow-y: auto; overflow-x: hidden; padding-bottom: 130px; scrollbar-width: thin; scrollbar-color: color-mix(in srgb,#34d399 40%,transparent) transparent; }
    /* v6.2.x: 시뮬 가로(short) — 컴팩트 닥(≈90px) 높이에 맞춰 하단 여백 축소(과다 여백/겹침 동시 방지). */
    .msp-viewport.land .msd-scroll-body { padding-bottom: 104px; }
    .msd-scroll-body::-webkit-scrollbar { width: 7px; }
    .msd-scroll-body::-webkit-scrollbar-thumb { background: color-mix(in srgb,#34d399 38%,transparent); border-radius: 4px; }
    .msd-h { display: flex; align-items: center; gap: 8px; padding: 12px 15px; border-bottom: 1px solid color-mix(in srgb, #34d399 22%, var(--line)); background: linear-gradient(120deg, color-mix(in srgb, #34d399 14%, transparent), transparent 62%); flex-wrap: wrap; }
    .msd-title { font: 900 14px Pretendard,'Malgun Gothic',sans-serif; background: linear-gradient(90deg, #6ee7b7, #7dd3fc); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .msd-badge { font: 800 10px var(--mono); color: #fff; background: linear-gradient(135deg, #10b981, #0ea5e9); border-radius: 20px; padding: 2px 8px; }
    /* v6.2.x(A): 세로 좁은 폭에서 우측 잘림 방지 — 남는 폭 안에서 말줄임(shrink 허용). */
    .msd-plat { margin-left: auto; flex: 0 1 auto; min-width: 0; font: 600 10px var(--mono); color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .msd-supremacy { padding: 0 15px 13px; }
    /* 반응형: 모바일 세로 1열 → 태블릿/DeX 2열 → DeX 대형 모니터 3열 */
    .msd-grid { display: grid; grid-template-columns: 1fr; gap: 12px; padding: 13px 15px; }
    @@media (min-width: 720px) { .msd-grid { grid-template-columns: 1fr 1fr; } }
    @@media (min-width: 1200px) { .msd-grid { grid-template-columns: 1fr 1fr 1fr 1fr; } }
    .msd-card { border: 1px solid var(--line); border-radius: 13px; background: var(--card-2); padding: 12px; display: flex; flex-direction: column; gap: 10px; }
    .msd-ct { font: 800 12px Pretendard,'Malgun Gothic',sans-serif; display: flex; align-items: center; gap: 8px; color: var(--text-primary); }
    .msd-sub { font: 600 10px var(--mono); color: var(--text-muted); }
    .msd-mini { margin-left: auto; width: 30px; height: 30px; font-size: 14px; color: var(--text-secondary); background: var(--card-2); border: 1px solid var(--line); border-radius: 8px; cursor: pointer; }
    /* 캡처(터치 타깃 크게) */
    .msd-caps { display: flex; flex-direction: column; gap: 7px; }
    .msd-cap { display: flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 14px; border-radius: 11px; border: 1px solid var(--line); background: var(--card-2); color: var(--text-secondary); cursor: pointer; font: 700 12.5px Pretendard,'Malgun Gothic',sans-serif; }
    .msd-cap:hover:not(:disabled) { border-color: #34d399; color: var(--text-primary); } .msd-cap:disabled { opacity: .5; cursor: not-allowed; }
    .msd-cap-e { font-size: 20px; }
    .msd-anchor { font: 700 10.5px var(--mono); color: #6ee7b7; word-break: break-all; }
    /* 리모트 */
    .msd-in { min-height: 46px; background: var(--card-2); border: 1px solid var(--line); border-radius: 10px; padding: 0 12px; color: var(--text-primary); font: 700 12.5px var(--mono); outline: none; }
    .msd-in:focus { border-color: #34d399; } .msd-in:disabled { opacity: .55; }
    .msd-tg { font: 700 11px Pretendard,'Malgun Gothic',sans-serif; color: var(--text-secondary); display: inline-flex; align-items: flex-start; gap: 7px; cursor: pointer; line-height: 1.45; word-break: keep-all; }
    .msd-tg input { margin-top: 2px; }
    .msd-btn { min-height: 48px; font: 800 13.5px Pretendard,'Malgun Gothic',sans-serif; padding: 0 16px; border: none; border-radius: 12px; cursor: pointer; word-break: keep-all; }
    .msd-btn.go { color: #fff; background: linear-gradient(135deg, #10b981, #0ea5e9); box-shadow: 0 6px 16px color-mix(in srgb, #10b981 30%, transparent), inset 0 1px 0 rgba(255,255,255,.28); }
    .msd-btn.cut { color: #fff; background: linear-gradient(135deg, #6366f1, #a855f7); box-shadow: 0 6px 16px color-mix(in srgb, #6366f1 30%, transparent); }
    .msd-btn:hover:not(:disabled) { filter: brightness(1.07); } .msd-btn:disabled { opacity: .5; cursor: not-allowed; box-shadow: none; }
    /* 터치 CAD 큐브 */
    .msd-cube-wrap { height: 150px; display: grid; place-items: center; perspective: 620px; touch-action: none; cursor: grab; user-select: none; -webkit-user-select: none; }
    .msd-cube-wrap:active { cursor: grabbing; }
    .msd-cube { width: 92px; height: 92px; position: relative; transform-style: preserve-3d; transform: rotateX(var(--rx,-20deg)) rotateY(var(--ry,20deg)); }
    .msd-face { position: absolute; width: 92px; height: 92px; border: 1.5px solid #34d399; box-shadow: 0 0 12px #34d399, inset 0 0 12px #34d39955; background: #34d3990f; }
    .msd-face.f1 { transform: translateZ(46px); } .msd-face.f2 { transform: rotateY(180deg) translateZ(46px); } .msd-face.f3 { transform: rotateY(90deg) translateZ(46px); }
    .msd-face.f4 { transform: rotateY(-90deg) translateZ(46px); } .msd-face.f5 { transform: rotateX(90deg) translateZ(46px); } .msd-face.f6 { transform: rotateX(-90deg) translateZ(46px); }
    .msd-rot { text-align: center; font: 700 10px var(--mono); color: var(--text-muted); }
    .msd-note { font: 600 10.5px Pretendard,'Malgun Gothic',sans-serif; color: var(--text-muted); line-height: 1.5; word-break: keep-all; }
    .msd-msg { margin: 0 15px 14px; padding: 9px 12px; border-radius: 10px; background: var(--card); border: 1px solid color-mix(in srgb,#34d399 30%,var(--line)); font: 700 11px Pretendard,'Malgun Gothic',sans-serif; color: #6ee7b7; word-break: keep-all; line-height: 1.5; }
    /* v5.4 런처 */
    .msd-flow54 { margin: 0 15px 14px; padding: 12px; border-radius: 13px; border: 1px solid color-mix(in srgb, #7c5cff 30%, var(--line)); background: linear-gradient(135deg, color-mix(in srgb, #7c5cff 12%, transparent), transparent 70%); }
    .msd-flow-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 10px; }
    .msd-flow-b { display: flex; flex-direction: column; align-items: center; gap: 5px; min-height: 66px; padding: 10px; border-radius: 12px; border: 1px solid var(--line); background: var(--card-2); color: var(--text-secondary); cursor: pointer; font: 800 11px Pretendard,'Malgun Gothic',sans-serif; }
    .msd-flow-b { font-size: 21px; } .msd-flow-b span { font-size: 11px; }
    .msd-flow-b:hover { color: var(--text-primary); }
    .msd-flow-b.canvas:hover { border-color: #7c5cff; box-shadow: 0 0 12px color-mix(in srgb, #7c5cff 40%, transparent); }
    .msd-flow-b.motion:hover { border-color: #22d3ee; box-shadow: 0 0 12px color-mix(in srgb, #22d3ee 40%, transparent); }
    .msd-flow-b.voice:hover { border-color: #34d399; box-shadow: 0 0 12px color-mix(in srgb, #34d399 40%, transparent); }
    .msd-flow-b.scrub:hover { border-color: #f5c451; box-shadow: 0 0 12px color-mix(in srgb, #f5c451 40%, transparent); }
    /* v5.4 오버레이(폰 프레임 내부 전체) */
    .msd-ov { position: absolute; inset: 0; z-index: 30; display: flex; flex-direction: column; background: rgba(8,10,18,.98); backdrop-filter: blur(6px); }
    .msd-ov-h { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-bottom: 1px solid var(--line); flex: 0 0 auto; }
    .msd-ov-back { font: 800 12px Pretendard,'Malgun Gothic',sans-serif; padding: 8px 12px; border-radius: 9px; border: 1px solid var(--line); background: var(--card-2); color: #6ee7b7; cursor: pointer; min-height: 38px; }
    .msd-ov-back:hover { border-color: #34d399; color: var(--text-primary); }
    .msd-ov-t { font: 900 13px Pretendard,'Malgun Gothic',sans-serif; color: var(--text-primary); }
    .msd-ov-bd { flex: 1; min-height: 0; overflow-y: auto; padding: 12px; }
    /* v5.4 공간 음성 패널 */
    .msd-voice { display: flex; flex-direction: column; gap: 10px; }
    .msd-voice-ct { font: 800 12.5px Pretendard,'Malgun Gothic',sans-serif; color: var(--text-primary); display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .msd-voice-pad { position: relative; height: 130px; border-radius: 12px; overflow: hidden; cursor: crosshair; touch-action: none;
        background: radial-gradient(60% 60% at 50% 40%, color-mix(in srgb, #34d399 14%, transparent), transparent 70%), linear-gradient(135deg, #0b1020, #161a2e); border: 1px solid color-mix(in srgb, #34d399 26%, var(--line)); }
    .msd-voice-cam { position: absolute; left: 10px; top: 10px; font: 700 10px var(--mono); color: #6ee7b7; }
    .msd-voice-anchor { position: absolute; transform: translate(-50%, -50%); font-size: 22px; color: #34d399; text-shadow: 0 0 10px #34d399; pointer-events: none; }
    .msd-voice-in { width: 100%; box-sizing: border-box; resize: none; background: var(--card-2); border: 1px solid var(--line); border-radius: 10px; padding: 9px 11px; color: var(--text-primary); font: 600 11.5px Pretendard,'Malgun Gothic',sans-serif; line-height: 1.5; outline: none; }
    .msd-voice-act { display: flex; gap: 8px; }
    .msd-voice-node { border: 1px solid color-mix(in srgb, #34d399 26%, var(--line)); border-radius: 11px; padding: 11px; background: rgba(11,13,20,.5); display: flex; flex-direction: column; gap: 5px; }
    .msd-voice-row { font: 600 11px Pretendard,'Malgun Gothic',sans-serif; color: var(--text-secondary); } .msd-voice-row b { color: #6ee7b7; margin-right: 7px; font-weight: 800; }
    .msd-voice-wan { margin-top: 5px; font: 600 10.5px var(--mono); color: #a7f3d0; background: rgba(52,211,153,.08); border: 1px solid color-mix(in srgb, #34d399 22%, var(--line)); border-radius: 8px; padding: 8px 10px; word-break: break-word; line-height: 1.5; }
    .msd-voice-msg { font: 700 11px Pretendard,'Malgun Gothic',sans-serif; color: #6ee7b7; word-break: keep-all; line-height: 1.5; }
    /* v5.4.1 Wan 전송 블록 */
    .msd-wan { display: flex; flex-direction: column; gap: 8px; margin-top: 4px; padding: 11px; border-radius: 11px; border: 1px solid color-mix(in srgb, #7c5cff 30%, var(--line)); background: linear-gradient(135deg, color-mix(in srgb, #7c5cff 12%, transparent), transparent 70%); }
    .msd-wan-sum { font: 700 10.5px var(--mono); color: #c4b5fd; word-break: keep-all; line-height: 1.5; }
    /* v5.6.5 워크스페이스/스튜디오 탭 */
    .msd-tabs { display: flex; gap: 6px; padding: 10px 15px 0; }
    .msd-tab { flex: 1; min-height: 40px; border-radius: 11px 11px 0 0; border: 1px solid var(--line); border-bottom: none; background: var(--card-2); color: var(--text-muted); cursor: pointer; font: 800 12px Pretendard,'Malgun Gothic',sans-serif; }
    .msd-tab.on { color: #fff; background: linear-gradient(135deg, color-mix(in srgb,#34d399 22%,transparent), color-mix(in srgb,#0ea5e9 22%,transparent)); border-color: color-mix(in srgb,#34d399 40%,var(--line)); }
    /* v5.6.5 워크스페이스 부팅 대시보드 */
    .msd-ws { padding: 12px 15px 14px; display: flex; flex-direction: column; gap: 16px; width: 100%; box-sizing: border-box; }
    /* v6.2.x(B): 세로 도킹 — 워크스페이스 상하 여백/간격 압축으로 한 화면 가시영역 확장. */
