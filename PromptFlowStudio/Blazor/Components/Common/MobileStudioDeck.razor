            case "audiosync": SwitchInternal(MobileInternalView.AudioSync); _msg = "🎼 오디오 파형 스튜디오 — 보컬 트랙 강도에 맞춰 컷별 립싱크 수식어가 자동 주입됩니다."; break;   // v6.0.2
            case "webhooklog": SwitchInternal(MobileInternalView.WebhookLog); _msg = "🔗 B2B Webhook — 완공 비디오 자산이 HMAC-SHA256 서명 후 외부 엔드포인트로 자동 발송됩니다."; break;   // v6.1.0
            case "livestream": SwitchInternal(MobileInternalView.LiveStream); _msg = "📡 라이브 프리뷰 — 렌더 노드의 생성 프레임을 초저지연으로 미러링합니다(불가 시 스틸 폴백)."; break;   // v6.1.0
