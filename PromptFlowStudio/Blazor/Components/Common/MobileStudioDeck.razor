@code {
    [Parameter, EditorRequired] public StoryboardProject Project { get; set; } = default!;
    [Parameter] public bool Disabled { get; set; }

    private bool _busy;
    private string? _msg;
    private long _memToken;

    // v5.6.5: 모바일 부팅 기본 뷰 = 🏠 워크스페이스(PC 대칭) · 스튜디오 뷰로 전환 가능.
    private enum MobileView { Workspace, Studio }
    private MobileView _view = MobileView.Workspace;

    // v5.7.3~v5.7.4: 모바일 내부 독립 라우팅(공용 MobileInternalView · PC NavigationManager 미사용 · 드로어와 활성 상태 공유).
    private MobileInternalView _internalView = MobileInternalView.Workspace;
    private void SwitchInternal(MobileInternalView v) { _internalView = v; _view = MobileView.Workspace; }
    // 드로어 라우트 문자열 → 내부 뷰 매핑(PC 라우팅 대체).
    private void HandleDrawerNav(string route)
    {
        _view = MobileView.Workspace;
        _internalView = route switch
        {
            "storyboard" => MobileInternalView.Storyboard,
            "workspace" => MobileInternalView.Prompt,
            "flow" => MobileInternalView.Flow,
            "gallery" => MobileInternalView.Gallery,
            "settings" or "user-settings" => MobileInternalView.Settings,
            "batch" => MobileInternalView.Batch,     // v5.8.0: 대량 양산 팩토리
            "motion" => MobileInternalView.Gyro,     // v5.8.0: 모션·카메라 → 3D 자이로 뷰어
            "nodegrid" => MobileInternalView.NodeGrid,   // v6.0.1-b: 분산 GPU 노드 그리드 HUD
            "audiosync" => MobileInternalView.AudioSync, // v6.0.2: 오디오 립싱크 파형 스튜디오
            "webhooklog" => MobileInternalView.WebhookLog, // v6.1.0: B2B Webhook 로그
            "livestream" => MobileInternalView.LiveStream, // v6.1.0: WebRTC 라이브 프리뷰
            _ => MobileInternalView.Workspace,   // queue 등 전용 내부 페이지 없음 → 워크스페이스
        };
    }
    private string InternalIcon => _internalView switch
    {
        MobileInternalView.Storyboard => "🎞️", MobileInternalView.Prompt => "✍️", MobileInternalView.Flow => "🕹️",
        MobileInternalView.Gallery => "🖼️", MobileInternalView.Settings => "⚙️",
        MobileInternalView.Batch => "🏭", MobileInternalView.Gyro => "📱",
        MobileInternalView.NodeGrid => "⚡", MobileInternalView.AudioSync => "🎼",
        MobileInternalView.WebhookLog => "🔗", MobileInternalView.LiveStream => "📡", _ => "🏠",
    };
    private string InternalTitle => _internalView switch
    {
        MobileInternalView.Storyboard => "모바일 스토리보드", MobileInternalView.Prompt => "프롬프트 입력",
        MobileInternalView.Flow => "노드 오케스트레이터", MobileInternalView.Gallery => "갤러리",
        MobileInternalView.Settings => "설정",
        MobileInternalView.Batch => "B2B 대량 양산", MobileInternalView.Gyro => "3D 자이로 모션",
        MobileInternalView.NodeGrid => "GPU 노드 그리드", MobileInternalView.AudioSync => "오디오 립싱크 스튜디오",
        MobileInternalView.WebhookLog => "B2B Webhook 로그", MobileInternalView.LiveStream => "라이브 프리뷰", _ => "워크스페이스",
    };

    // ── v5.7.4 모바일 서브 스튜디오(무주입 · Project 파라미터·정적 데이터만) ──
    private void AddCompactCut() => Project?.Scenes.Add(new StoryboardScene { Prompt = "" });
    private void RemoveCut(StoryboardScene s) => Project?.Scenes.Remove(s);

    // 칩 터치 → 세션 초안에 부착(닥 SeedText·예상 프레임에 즉시 반영 · 뷰 전환에도 보존).
    private void AppendPromptChip(string text)
        => _session.DraftPrompt = string.IsNullOrWhiteSpace(_session.DraftPrompt) ? text : $"{_session.DraftPrompt}, {text}";

    private sealed record PromptChip(string Label, string Text);
    private sealed record ChipGroup(string Title, PromptChip[] Chips);
    private static readonly ChipGroup[] PromptChipGroups =
    {
        new("시네마틱 구도", new[]
        {
            new PromptChip("🌅 골든아워 85mm", "85mm lens, golden hour backlight"),
            new PromptChip("🎥 슬로우 모션", "slow motion 60fps, smooth tracking shot"),
            new PromptChip("🎬 시네마틱 조명", "hyper-realistic cinematic lighting, volumetric"),
            new PromptChip("🛰️ 드론 부감", "aerial drone shot, sweeping wide angle"),
        }),
        new("스타일·무드", new[]
        {
            new PromptChip("🎞️ 필름 그레인", "35mm film grain, analog color"),
            new PromptChip("🌫️ 몽환적", "dreamy soft focus, ethereal atmosphere"),
            new PromptChip("⚡ 하이 콘트라스트", "high contrast, dramatic shadows"),
            new PromptChip("🎨 파스텔", "soft pastel palette, gentle tones"),
        }),
    };

    private string? _lastDockPrompt;   // v5.6.7 생성 닥 입력(예상 첫 프레임 시드 우선)
    // 예상 첫 프레임 시드 — 생성 닥 입력 → 첫 유효 프롬프트 컷 → 프로젝트 제목.
    private string WorkspaceSeed => !string.IsNullOrWhiteSpace(_lastDockPrompt) ? _lastDockPrompt!
        : Project?.Scenes?.FirstOrDefault(s => !string.IsNullOrWhiteSpace(s.Prompt))?.Prompt ?? Project?.Title ?? "";

    // v5.6.6: 프로젝트 앵커 이미지의 표시 가능한 URL(가상호스트) — 없으면 null(등록 유도).
    private string? AnchorUrl => string.IsNullOrWhiteSpace(Project?.AnchorImagePath) ? null : Media.ToPlaybackUrl(Project!.AnchorImagePath!);

    // v5.6.7: 실제 생성 결과 첫 프레임 — 완료된 첫 컷의 포스터(있으면). 3단 실측 대조 활성.
    private string? ActualUrl => Project?.Scenes?.FirstOrDefault(s => s.Status == SceneStatus.Completed && !string.IsNullOrEmpty(s.PosterUrl))?.PosterUrl;

    // ── v5.6.7 Google Flow 모바일 UI ──
    private bool _showHero = true;                 // 부팅 시네마틱 히어로(진입 후 숨김)
    private void EnterStudio() => _showHero = false;

    // 가드레일 표시 상태(로컬 · 시뮬 프리뷰용). ⚠ UserPreferenceService 는 데스크톱 DI 전용 → 모바일 컴포넌트 무주입 유지.
    private bool _guardEnabled = true;
    private QualityGuardrailPreset _guardPreset = QualityGuardrailPreset.Balanced;
    private void ToggleGuard() => _guardEnabled = !_guardEnabled;

    // ── v5.7.0 플로팅 닥 파이프라인 실결선 ──
    private bool _dockRunning;
    private int _dockPercent;
    private string? _dockResultUrl;   // 생성 결과 프레임(스텁=이미지 data URL) → 3단 실측 [🎞️ 실제 결과] 바인딩

    // ── v5.7.5 세션 메모리 보존(뷰 전환 간 초안/설정 유지 · 인스턴스 필드라 스위칭에도 상시 보존) ──
    private sealed class DraftMemorySession { public string DraftPrompt { get; set; } = ""; }
    private readonly DraftMemorySession _session = new();
    private bool _isBoosting;
    /// <summary>v5.7.5 원격 부스터 델리게이트(데스크톱 부모 주입 · 없으면 BCL 폴백) — 모바일 무주입 원칙.</summary>
    [Parameter] public Func<string, Task<string>>? OnBoostPrompt { get; set; }

    // ── v6.2.x: PC 공용 테마 퀵스위치(호스트 ThemeService 위임 · 무주입 델리게이트 체인) ──
    /// <summary>선택 가능한 테마 이름 목록(부모가 ThemeService.BuiltIns 등에서 전달). null/빈 목록이면 테마 UI 숨김.</summary>
    [Parameter] public IReadOnlyList<string>? ThemeNames { get; set; }
    /// <summary>현재 활성 테마 이름(빈 문자열/null = 기본). 활성 칩 하이라이트.</summary>
    [Parameter] public string? ActiveThemeName { get; set; }
    /// <summary>테마 선택 → 부모(호스트)가 ThemeService.ApplyByName 실행(전역 재테마 · 시뮬 즉시 반영).</summary>
