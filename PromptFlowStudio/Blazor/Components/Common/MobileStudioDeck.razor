    private void OnMotionPrompt(string prompt)
    {
        var snip = string.IsNullOrWhiteSpace(prompt) ? "" : (prompt.Length > 90 ? prompt[..90] + "…" : prompt);
        _msg = "🎯 모션 프롬프트 생성 — " + snip;
