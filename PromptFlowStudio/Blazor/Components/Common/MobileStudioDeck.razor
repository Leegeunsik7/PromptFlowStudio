    // ── 공간 음성-비전 앵커링 상태 ──
    private string _voiceText = "";
    private SpatialPromptNode? _voiceNode;
    private bool _voiceBusy;
    private string? _voiceMsg;
    private SpatialAnchor _anchor = SpatialAnchor.Center;
    private (double X, double Y) _anchorPx = (150, 65);

    private void SetAnchor(PointerEventArgs e)
    {
        _anchorPx = (e.OffsetX, e.OffsetY);
        // 패드(가로≈300 · 세로 130px 가정) → 정규화 0~1 앵커(사물 인식 좌표 근사).
        _anchor = _anchor with { ScreenX = Math.Clamp(e.OffsetX / 300.0, 0, 1), ScreenY = Math.Clamp(e.OffsetY / 130.0, 0, 1) };
        _voiceMsg = $"◎ 앵커 지정 — ({F(_anchor.ScreenX)}, {F(_anchor.ScreenY)})";
    }

    private async Task VoiceCapture()
    {
        _voiceBusy = true; _voiceMsg = null; StateHasChanged();
        try
        {
            var r = await Voice.CaptureAsync(_anchor);
            if (r.Ok)
            {
                _voiceNode = r.Node;
                if (!string.IsNullOrWhiteSpace(r.Transcript)) _voiceText = r.Transcript;
            }
            _voiceMsg = r.Message;
        }
        catch (Exception ex) { _voiceMsg = "⚠ " + ex.Message; }
        finally { _voiceBusy = false; }
    }

    private void VoiceStructure()
    {
        _voiceNode = SpatialPromptStructurer.Structure(_voiceText, _anchor);
        _voiceMsg = "🧩 구조화 완료 — Wan 워크플로우 노드가 생성되었습니다.";
    }

    // ── v5.4.1 Wan 3.0 백엔드 직결(모션 벡터 + 공간 음성 합성 전송) ──
    private IReadOnlyList<MotionVector> _lastMotion = System.Array.Empty<MotionVector>();
    private bool _wanBusy;
    private string? _wanMsg;
    private int WanIntensity => WanPromptCompiler.AggregateIntensity(_lastMotion);

    private async Task SendToWan()
    {
        _wanBusy = true; _wanMsg = null; StateHasChanged();
        try
        {
            var build = WanPromptCompiler.Compile(_voiceNode, _lastMotion, Project?.Title);
            var r = await Wan.SubmitAsync(build, Project);
            _wanMsg = (r.Ok ? "✅ " : r.Queued ? "📥 " : "⚠ ") + r.Message + $" · job {r.JobId}";
        }
        catch (Exception ex) { _wanMsg = "⚠ " + ex.Message; }
        finally { _wanBusy = false; }
    }

    private static string F(double v) => (double.IsNaN(v) || double.IsInfinity(v) ? 0 : v).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    public void Dispose()
    {
        try { if (_voiceBusy) _ = Voice.CancelAsync(); } catch { }
        try { _dockCts?.Cancel(); _dockCts?.Dispose(); } catch { }   // v5.7.3 닥 체인 취소 정리
        MemAudit.Release(_memToken);
    }
