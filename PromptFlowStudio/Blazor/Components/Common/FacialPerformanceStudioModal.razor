@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private System.Threading.Timer? _timer;
    private double _yaw = 20;

    private NeuralFacialLandmarkBlendshapeEngine E => Runner.Engine;
    private AudioToFaceVisemeMotionSynthesizer A => Runner.A2F;
    private BiologicalEyeGazeMicroTremorGuard G => Runner.Guard;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("FacialPerformance.Modal.Timer", ex); }
        }, null, 200, 200);
    }

    private static string F0(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "0" : v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0.00", CultureInfo.InvariantCulture);
    private static string F3(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0.000", CultureInfo.InvariantCulture);
    private static double Num(ChangeEventArgs e, double fallback) => double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : fallback;

    private static string VisName(Viseme v) => v switch { Viseme.Rest => "휴지", Viseme.M => "P/B/M", Viseme.F => "F/V", _ => v.ToString() };

    private static string? Group(int k)
    {
        var b = (ArkitBlendshape)k;
        return b switch
        {
            <= ArkitBlendshape.BrowOuterUpRight => "brow",
            >= ArkitBlendshape.EyeBlinkLeft and <= ArkitBlendshape.EyeWideRight => "eye",
            >= ArkitBlendshape.JawForward and <= ArkitBlendshape.JawRight => "jaw",
            >= ArkitBlendshape.MouthClose and <= ArkitBlendshape.MouthUpperUpRight => "mouth",
            _ => null,
        };
    }

    /// <summary>요 회전 정사영(정규 좌표 m → 화면).</summary>
    private Vector2 P(Vector3 p)
    {
        var y = (float)(_yaw * Math.PI / 180);
        float c = MathF.Cos(y), s = MathF.Sin(y);
        var x = p.X * c + p.Z * s;
        return new Vector2(160 + x * 1500, 190 - p.Y * 1500);
    }

    private static double FX(float f2) => 12 + Math.Clamp((2600 - f2) / 2000.0, 0, 1) * 216;
    private static double FY(float f1) => 12 + Math.Clamp((f1 - 200) / 700.0, 0, 1) * 146;

    private string Trail()
    {
        var n = Math.Min(40, A.HistoryCount);
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = n - 1; i >= 0; i--)
        {
            if (A.VisemeHistory(i) is Viseme.Rest or Viseme.F) continue;
            sb.Append(F1(FX(A.F2History(i)))).Append(',').Append(F1(FY(A.F1History(i)))).Append(' ');
        }
        return sb.ToString();
    }

    private string Wave()
    {
        const int cols = 300, per = AudioToFaceVisemeMotionSynthesizer.WaveLen / cols;
        var sb = new System.Text.StringBuilder(cols * 24);
        for (var c = 0; c < cols; c++)
        {
            float mn = 0, mx = 0;
            for (var k = 0; k < per; k++) { var v = A.WaveSample((cols - 1 - c) * per + k); mn = MathF.Min(mn, v); mx = MathF.Max(mx, v); }
            var x = F1(c * 360.0 / cols);
            sb.Append(c == 0 ? 'M' : 'L').Append(x).Append(',').Append(F1(30 - Math.Clamp(mx * 60, -29, 29))).Append('L').Append(x).Append(',').Append(F1(30 - Math.Clamp(mn * 60, -29, 29)));
        }
        return sb.ToString();
    }

    private string Env()
    {
        float mx = -1e9f, mn = 1e9f;
        for (var f = 0; f < AudioToFaceVisemeMotionSynthesizer.EnvBins; f++) { mx = MathF.Max(mx, A.Envelope(f)); mn = MathF.Min(mn, A.Envelope(f)); }
        var span = MathF.Max(1f, mx - mn);
        var sb = new System.Text.StringBuilder(AudioToFaceVisemeMotionSynthesizer.EnvBins * 12);
        for (var f = 0; f < AudioToFaceVisemeMotionSynthesizer.EnvBins; f++)
            sb.Append(F1(f)).Append(',').Append(F1(48 - 46 * (A.Envelope(f) - mn) / span)).Append(' ');
        return sb.ToString();
    }

    private string Series(Func<int, float> f, double max, double h)
    {
        var n = Runner.SeriesCount;
        if (n < 2) return "";
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = n - 1; i >= 0; i--)
            sb.Append(F1(360.0 * (n - 1 - i) / (FacialPerformanceStudioRunner.SeriesLen - 1))).Append(',').Append(F1(h - 2 - (h - 4) * Math.Clamp(f(i) / max, 0, 1))).Append(' ');
        return sb.ToString();
    }

    private string SeriesSigned(Func<int, float> f, double max, double h)
    {
        var n = Runner.SeriesCount;
        if (n < 2) return "";
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = n - 1; i >= 0; i--)
            sb.Append(F1(360.0 * (n - 1 - i) / (FacialPerformanceStudioRunner.SeriesLen - 1))).Append(',').Append(F1(h / 2 - (h / 2 - 2) * Math.Clamp(f(i) / max, -1, 1))).Append(' ');
        return sb.ToString();
    }

    private void ToggleRun() { if (Runner.IsRunning) Runner.Stop(); else Runner.Start(); }
    private void Step60() { for (var i = 0; i < FacialPerformanceStudioRunner.Hz; i++) Runner.Step(); }

    private Task Close() => OnClose.InvokeAsync();

    /// <summary>가동 중(10 Hz 이벤트)은 200 ms 타이머가 처리 — 정지 상태 액션만 즉시 반영.</summary>
    private void OnServiceChanged() { if (!Runner.IsRunning) _ = InvokeAsync(StateHasChanged); }

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
