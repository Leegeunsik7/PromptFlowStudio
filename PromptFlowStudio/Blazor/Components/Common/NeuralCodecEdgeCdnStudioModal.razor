@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private System.Threading.Timer? _timer;
    private readonly float[] _pv = new float[NeuralCodecEdgeCdnStudioRunner.PreviewW * NeuralCodecEdgeCdnStudioRunner.PreviewH];
    private bool _showSource;
    private static readonly string[] GrayHex = BuildGray();

    private NeuralVolumetricVideoCodecEngine K => Runner.Codec;
    private GlobalEdgeCdnRoutingSynthesizer C => Runner.Cdn;
    private PacketLossConcealmentFecGuard G => Runner.Guard;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("NeuralCodec.Modal.Timer", ex); }
        }, null, 300, 300);
    }

    private static string[] BuildGray()
    {
        var g = new string[256];
        for (var i = 0; i < 256; i++) g[i] = "#" + i.ToString("X2", CultureInfo.InvariantCulture) + i.ToString("X2", CultureInfo.InvariantCulture) + i.ToString("X2", CultureInfo.InvariantCulture);
        return g;
    }

    private static string Gray(int v) => GrayHex[v];
    private static string F0(double v) => v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => double.IsNaN(v) ? "—" : v.ToString("0.00", CultureInfo.InvariantCulture);
    private static string F3(double v) => v.ToString("0.###", CultureInfo.InvariantCulture);
    private static string Kb(int bits) => (bits / 8192d).ToString("0.00", CultureInfo.InvariantCulture) + " KB";
    private static double Num(ChangeEventArgs e, double fallback) => double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : fallback;
    private static string UtilClass(float u) => u > 0.95f ? "bad" : u > 0.85f ? "hot" : u > 0.6f ? "warm" : "ok";
    private static double X(float lon) => lon + 180.0;
    private static double Y(float lat) => (90.0 - lat) * 170.0 / 180.0;

    /// <summary>P2P 스웜은 지역 좌표 아래로 살짝 오프셋(에지와 겹침 방지).</summary>
    private static double NodeX(int j) => X(GlobalEdgeCdnRoutingSynthesizer.NodeLon[j]) + (j >= GlobalEdgeCdnRoutingSynthesizer.PeerBase ? -5 : j == 6 ? 4 : 0);
    private static double NodeY(int j) => Y(GlobalEdgeCdnRoutingSynthesizer.NodeLat[j]) + (j >= GlobalEdgeCdnRoutingSynthesizer.PeerBase ? 7 : j == 6 ? 4 : 0);

    private string Series(Func<int, float> f, double max, double h)
    {
        var n = Runner.SeriesCount;
        if (n < 2) return "";
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = n - 1; i >= 0; i--)
            sb.Append(F1(360.0 * (n - 1 - i) / (NeuralCodecEdgeCdnStudioRunner.SeriesLen - 1))).Append(',').Append(F1(h - 2 - (h - 4) * Math.Clamp(f(i) / max, 0, 1))).Append(' ');
        return sb.ToString();
    }

    /// <summary>반원 게이지(0~1 정규화 · 호 길이 dasharray).</summary>
    private RenderFragment Gauge(string label, double value, double lo, double hi, string text) => __builder =>
    {
        var k = Math.Clamp((value - lo) / (hi - lo), 0, 1);
        const double len = Math.PI * 40;
        <div class="ncd-gauge">
            <svg viewBox="0 0 100 58">
                <path class="bg" d="M 10 52 A 40 40 0 0 1 90 52" />
                <path class="fg" d="M 10 52 A 40 40 0 0 1 90 52" style="stroke-dasharray:@(F1(len * k)) @(F1(len))" />
            </svg>
            <b>@text</b>
            <span>@label</span>
        </div>
    };

    private void ToggleRun() { if (Runner.IsRunning) Runner.Stop(); else Runner.Start(); }
    private void Step30() { for (var i = 0; i < NeuralCodecEdgeCdnStudioRunner.Hz; i++) Runner.Step(); }

    private Task Close() => OnClose.InvokeAsync();

    /// <summary>가동 중(10 Hz 이벤트)은 300 ms 타이머가 처리 — 정지 상태 액션만 즉시 반영.</summary>
    private void OnServiceChanged() { if (!Runner.IsRunning) _ = InvokeAsync(StateHasChanged); }

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
