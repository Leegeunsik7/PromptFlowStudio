@using System.Globalization
@using PromptFlowStudio.Services.NeuralCodec
@implements IDisposable
@inject NeuralCodecEdgeCdnStudioRunner Runner

@*
    [PromptFlow Studio v17.02.0] 📡 AI 신경망 코덱 & 글로벌 에지 CDN 스튜디오 — 압축 품질 게이지(PSNR/SSIM · 압축률 · 16K 환산 Mbps) · 디코드 화면/MB 모드 맵 ·
    글로벌 에지 노드 트래픽 토폴로지 맵(오리진 · 에지 PoP · P2P 스웜 · 지역 ABR) · 패킷 드롭 복원율 미터(FEC · 은닉 · PLI · 지터 버퍼).
*@

<div class="ncd-scrim" @onclick="Close">
    <div class="ncd-modal" @onclick:stopPropagation="true">
        <div class="ncd-h">
            <div>
                <div class="ncd-title">📡 AI 신경망 코덱 &amp; 글로벌 에지 CDN 스튜디오</div>
                <div class="ncd-sub"><b>코덱 엔진</b>이 평면 프레임(256×144 프록시 · 16K 환산)과 3DGS 스플랫 클라우드의 시공간 중복을 움직임 보상 · 변환 잔차 양자화(SIMD)로 압축하고 온라인 학습 R-Q 모델로 목표 비트에 맞춥니다.
                    <b>CDN 합성기</b>는 지역 부하 · RTT · 라스트마일 대역폭을 분석해 오리진/에지/P2P 경로를 분배하고 ABR 래더를 고르며,
                    <b>FEC 가드</b>는 리드-솔로몬 패리티 · 인터리빙 · 적응형 지터 버퍼로 손실을 복원하고 복원 불가 프레임은 움직임 외삽으로 은닉한 뒤 키프레임을 요청합니다. 네트워크 · 노드 · 시청자는 인프로세스 시뮬레이션입니다.</div>
            </div>
            <button class="ncd-x" @onclick="Close">✕</button>
        </div>

        <div class="ncd-bar">
            <button class="ncd-btn @(Runner.IsRunning ? "on" : null)" @onclick="ToggleRun">@(Runner.IsRunning ? "⏸ 정지" : "▶ 스트리밍")</button>
            <button class="ncd-btn" @onclick="Step30" disabled="@Runner.IsRunning">⏭ 1초</button>
            <select class="ncd-sel" value="@(C.ViewerRegion)" @onchange="e => C.ViewerRegion = (int)Num(e, 0)">
                @for (var r = 0; r < GlobalEdgeCdnRoutingSynthesizer.Regions; r++)
                {
                    <option value="@r">👁 @(GlobalEdgeCdnRoutingSynthesizer.RegionNames[r])</option>
                }
            </select>
            <button class="ncd-btn warn" @onclick="Runner.Storm">🌩 손실 폭풍</button>
            <button class="ncd-btn" @onclick="Runner.FailPrimary">⛔ 주 PoP 장애</button>
            <button class="ncd-btn" @onclick="Runner.FlashCrowd">👥 플래시 크라우드</button>
            <button class="ncd-btn" @onclick="Runner.BandwidthDrop">📉 대역폭 급락</button>
            <button class="ncd-btn" @onclick="Runner.ForceKey">🔑 IDR</button>
            <button class="ncd-btn @(G.FecEnabled ? "on" : null)" @onclick="() => G.FecEnabled = !G.FecEnabled">FEC</button>
            <button class="ncd-btn @(G.Interleave ? "on" : null)" @onclick="() => G.Interleave = !G.Interleave">인터리빙</button>
            <button class="ncd-btn @(G.ConcealEnabled ? "on" : null)" @onclick="() => G.ConcealEnabled = !G.ConcealEnabled">은닉</button>
            <button class="ncd-btn @(Runner.RateControl ? "on" : null)" @onclick="() => Runner.RateControl = !Runner.RateControl">ABR 레이트</button>
            <button class="ncd-btn @(Runner.UseSplatStudio ? "on" : null)" @onclick="() => Runner.UseSplatStudio = !Runner.UseSplatStudio" disabled="@(!Runner.SplatStudioBound)">🧊 v16.58 3DGS</button>
            <span class="ncd-chip">틱 @(Runner.Tick) · @(F2(Runner.LastTickMs)) ms · 인코드 @(F0(K.EncodeUs)) µs · 디코드 @(F0(K.DecodeUs)) µs · 라우팅 @(F1(C.LastStepUs)) µs · 복원 @(F1(G.LastRecoverUs)) µs</span>
        </div>

        <div class="ncd-main">
            <div class="ncd-col">
                <div class="ncd-card">
                    <div class="ncd-sec">🧠 볼류메트릭 코덱 <span class="ncd-kv">@(K.LastType == NvcFrameType.Intra ? "I" : "P") 프레임 · QP @(K.LastQp) · 키 @(K.KeyFrames) / @(K.Frames)</span></div>
                    <div class="ncd-gauges">
                        @Gauge("PSNR", Runner.ViewerPsnr, 20, 50, F1(Runner.ViewerPsnr) + " dB")
                        @Gauge("SSIM", Runner.ViewerSsim, 0.5, 1, F3(Runner.ViewerSsim))
                        @Gauge("압축률", Math.Log10(Math.Max(1, K.CompressionRatio)), 0, 3, F0(K.CompressionRatio) + ":1")
                        @Gauge("16K 환산", K.Mbps16K, 0, 1400, F0(K.Mbps16K) + " Mbps")
                    </div>
                    <div class="ncd-views">
                        <svg class="ncd-frame" viewBox="0 0 @(NeuralCodecEdgeCdnStudioRunner.PreviewW) @(NeuralCodecEdgeCdnStudioRunner.PreviewH)" preserveAspectRatio="none" shape-rendering="crispEdges">
                            @{ Runner.Preview(_pv, _showSource); }
                            @for (var y = 0; y < NeuralCodecEdgeCdnStudioRunner.PreviewH; y++)
                            {
                                for (var x = 0; x < NeuralCodecEdgeCdnStudioRunner.PreviewW; x++)
                                {
                                    var v = (int)Math.Clamp(_pv[y * NeuralCodecEdgeCdnStudioRunner.PreviewW + x], 0, 255);
                                    <rect x="@x" y="@y" width="1.05" height="1.05" fill="@(Gray(v))" />
                                }
                            }
                        </svg>
                        <svg class="ncd-frame" viewBox="0 0 @(NeuralVolumetricVideoCodecEngine.MbCols) @(NeuralVolumetricVideoCodecEngine.MbRows)" preserveAspectRatio="none">
                            @for (var mb = 0; mb < NeuralVolumetricVideoCodecEngine.MbCount; mb++)
                            {
                                var mx = mb % NeuralVolumetricVideoCodecEngine.MbCols; var my = mb / NeuralVolumetricVideoCodecEngine.MbCols;
                                <rect class="mb m@((int)K.EncoderMode(mb))" x="@mx" y="@my" width="0.94" height="0.94" />
                                if (K.EncoderMode(mb) == NvcMbMode.Inter)
                                {
                                    <line class="mv" x1="@(F3(mx + 0.47))" y1="@(F3(my + 0.47))" x2="@(F3(mx + 0.47 + K.EncoderMvX(mb) / 16.0 * 2))" y2="@(F3(my + 0.47 + K.EncoderMvY(mb) / 16.0 * 2))" />
                                }
                            }
                        </svg>
                    </div>
                    <div class="ncd-legend">
                        <button class="ncd-btn sm @(_showSource ? "on" : null)" @onclick="() => _showSource = !_showSource">@(_showSource ? "원본" : "시청자 화면(디코드)")</button>
                        <i class="m0"></i>Skip @(F0(K.SkipRatio * 100))% <i class="m1"></i>Inter <i class="m2"></i>Intra @(F0(K.IntraRatio * 100))% · 선 = 움직임 벡터(×2)
                    </div>
                    <div class="ncd-kv">
                        <span>비디오 <b>@(Kb(K.LastVideoBits))</b> · 스플랫 <b>@(Kb(K.LastSplatBits))</b> (@(K.DecodedSplatCount)개 · 변화 @(F0(K.SplatChangedRatio * 100))%@(Runner.SplatFromStudio ? " · v16.58 씬" : " · 합성 배우"))</span>
                        <span>인터 절감 @(F0(K.InterSavings * 100))% · 인코더 PSNR @(F1(K.EncoderPsnr)) dB · 은닉 PSNR @(F1(Runner.ConcealPsnr)) dB</span>
                        <span>R-Q 모델 a=@(F2(K.RateModelBias)) · 오차 @(F2(K.RateModelError)) · 목표 @(F0(K.TargetBitsPerFrame)) bit/f · 해독 @(K.DecodedFrames) · 오류 @(K.DecodeErrors) · 은닉 @(K.ConcealedFrames)</span>
                    </div>
                    <svg class="ncd-spark" viewBox="0 0 360 60" preserveAspectRatio="none">
                        <polyline class="ps" points="@(Series(i => Runner.PsnrSeries(i) - 20, 30, 60))" />
                        <polyline class="mb" points="@(Series(i => Runner.MbpsSeries(i), 1400, 60))" />
                    </svg>
                    <div class="ncd-legend"><i class="ps"></i>시청자 PSNR(20~50 dB) <i class="mbl"></i>16K 환산 비트레이트(0~1400 Mbps)</div>
                </div>

                <div class="ncd-card">
                    <div class="ncd-sec">🛡 패킷 드롭 복원 <span class="ncd-state o@((int)G.LastOutcome)">@(PacketLossConcealmentFecGuard.OutcomeNames[(int)G.LastOutcome])</span>
                        @if (G.StormActive) { <span class="ncd-chip bad">폭풍</span> }
                        @if (G.Drifting) { <span class="ncd-chip warn">드리프트 · IDR 대기</span> }</div>
                    <div class="ncd-meter">
                        <div><span>FEC 패킷 복원율</span><div class="bar"><i style="width:@(F1(G.RecoveryRate * 100))%"></i></div><b>@(F1(G.RecoveryRate * 100))%</b></div>
                        <div><span>무결 프레임율</span><div class="bar"><i class="ok" style="width:@(F1(G.IntactRate * 100))%"></i></div><b>@(F1(G.IntactRate * 100))%</b></div>
                        <div><span>원시 손실(지연 포함)</span><div class="bar"><i class="bad" style="width:@(F1(Math.Min(1, G.RawLossRate * 5) * 100))%"></i></div><b>@(F2(G.RawLossRate * 100))%</b></div>
                        <div><span>FEC 오버헤드</span><div class="bar"><i class="warm" style="width:@(F1(Math.Min(1, G.FecOverhead) * 100))%"></i></div><b>@(F0(G.FecOverhead * 100))%</b></div>
                    </div>
                    <svg class="ncd-strip" viewBox="0 0 @(NeuralCodecEdgeCdnStudioRunner.SeriesLen) 10" preserveAspectRatio="none">
                        @for (var i = 0; i < Runner.SeriesCount; i++)
                        {
                            <rect class="o@((int)Runner.OutcomeSeries(i))" x="@(NeuralCodecEdgeCdnStudioRunner.SeriesLen - 1 - i)" y="0" width="1" height="10" />
                        }
                    </svg>
                    <div class="ncd-legend"><i class="o0"></i>무결 <i class="o1"></i>FEC 복원 <i class="o2"></i>은닉 <i class="o3"></i>드리프트 <i class="o4"></i>프리즈 · 최근 6 s</div>
                    <div class="ncd-kv">
                        <span>송신 @(G.PacketsSent) · 손실 @(G.Lost) · 지연 손실 @(G.Late) · 복원 @(G.Recovered) · 잔여 @(G.Unrecovered) · 최대 버스트 @(G.MaxBurst)</span>
                        <span>블록 @(G.LastBlocks) × (k @(G.LastK) + m @(G.LastM)) · 손실 추정 @(F2(G.LossEstimate * 100))% · 지터 @(F1(G.JitterEstimateMs)) ms · 지터 버퍼 @(F1(G.JitterBufferMs)) ms</span>
                        <span>프레임 무결 @(G.FramesClean) · 복원 @(G.FramesRepaired) · 은닉 @(G.FramesConcealed) · 드리프트 @(G.FramesDrift) · 프리즈 @(G.FramesFrozen) · PLI @(G.PliSent)</span>
                    </div>
                </div>
            </div>

            <div class="ncd-col">
                <div class="ncd-card">
                    <div class="ncd-sec">🌐 글로벌 에지 트래픽 토폴로지 <span class="ncd-kv">총 @(F0(C.TotalDemandGbps)) Gbps · 에지 @(F0(C.EdgeShare * 100))% · P2P @(F0(C.PeerShare * 100))% · 오리진 @(F0(C.OriginShare * 100))% · 평균 RTT @(F1(C.AvgRttMs)) ms</span></div>
                    <svg class="ncd-map" viewBox="0 0 360 170" preserveAspectRatio="xMidYMid meet">
                        @for (var lon = -150; lon <= 150; lon += 30)
                        {
                            <line class="grid" x1="@(lon + 180)" y1="0" x2="@(lon + 180)" y2="170" />
                        }
                        @for (var lat = -60; lat <= 60; lat += 30)
                        {
                            <line class="grid" x1="0" y1="@(Y(lat))" x2="360" y2="@(Y(lat))" />
                        }
                        @for (var r = 0; r < GlobalEdgeCdnRoutingSynthesizer.Regions; r++)
                        {
                            var rx = X(GlobalEdgeCdnRoutingSynthesizer.RegionLon[r]); var ry = Y(GlobalEdgeCdnRoutingSynthesizer.RegionLat[r]);
                            var d = Math.Max(1e-6f, C.DemandGbps(r));
                            for (var j = 0; j < GlobalEdgeCdnRoutingSynthesizer.Nodes; j++)
                            {
                                var a = C.Alloc(r, j);
                                if (a <= 0f) continue;
                                var nx = NodeX(j); var ny = NodeY(j);
                                <line class="fl t@((int)C.Tier(j)) @(r == C.ViewerRegion ? "me" : null)" x1="@(F1(rx))" y1="@(F1(ry))" x2="@(F1(nx))" y2="@(F1(ny))" style="stroke-width:@(F2(0.4 + 3.2 * a / d))" />
                            }
                        }
                        @for (var j = 0; j < GlobalEdgeCdnRoutingSynthesizer.Nodes; j++)
                        {
                            if (C.Tier(j) == CdnTier.Spare) continue;
                            var u = C.NodeUtil(j);
                            <circle class="nd t@((int)C.Tier(j)) @(C.NodeUp(j) ? UtilClass(u) : "down")" cx="@(F1(NodeX(j)))" cy="@(F1(NodeY(j)))" r="@(C.Tier(j) == CdnTier.Peer ? "2.4" : C.Tier(j) == CdnTier.Origin ? "5" : "3.6")" />
                        }
                        @for (var r = 0; r < GlobalEdgeCdnRoutingSynthesizer.Regions; r++)
                        {
                            <g>
                                <text class="@(r == C.ViewerRegion ? "me" : null)" x="@(F1(X(GlobalEdgeCdnRoutingSynthesizer.RegionLon[r]) + 4))" y="@(F1(Y(GlobalEdgeCdnRoutingSynthesizer.RegionLat[r]) - 4))">@(GlobalEdgeCdnRoutingSynthesizer.RegionNames[r]) @(F0(GlobalEdgeCdnRoutingSynthesizer.RungMbps[C.Rung(r)]))</text>
                            </g>
                        }
                    </svg>
                    <div class="ncd-legend"><i class="t0"></i>오리진 <i class="t1"></i>에지 PoP <i class="t2"></i>P2P 스웜 · 선 굵기 = 지역 수요 분배 비율 · 원 색 = 이용률(초록 → 빨강 · 회색 장애)</div>
                    <div class="ncd-nodes">
                        @for (var j = 0; j < GlobalEdgeCdnRoutingSynthesizer.PeerBase; j++)
                        {
                            var jj = j; var u = C.NodeUtil(j);
                            <div class="@(C.NodeUp(j) ? null : "down")">
                                <b>@(GlobalEdgeCdnRoutingSynthesizer.NodeNames[j])</b>
                                <div class="bar"><i class="@(UtilClass(u))" style="width:@(F1(Math.Min(1, u) * 100))%"></i></div>
                                <span class="mono">@(F0(C.NodeLoadGbps(j)))/@(F0(C.NodeCapacityGbps(j))) G</span>
                                @if (j > 0)
                                {
                                    <button class="ncd-btn sm" @onclick="() => Runner.ToggleNode(jj)">@(C.NodeUp(j) ? "장애" : "복구")</button>
                                }
                                else
                                {
                                    <span></span>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="ncd-card">
                    <div class="ncd-sec">📶 지역별 ABR · 경로 <span class="ncd-kv">재경로 @(C.Reroutes) · 래더 전환 @(C.Switches) · 페일오버 @(C.Failovers) · 버퍼링 @(C.TotalStalls)</span></div>
                    <table class="ncd-tbl">
                        <thead><tr><th>지역</th><th>시청자</th><th>주 경로</th><th>RTT</th><th>손실</th><th>처리량/추정</th><th>래더</th><th>버퍼</th><th>정지</th></tr></thead>
                        <tbody>
                            @for (var r = 0; r < GlobalEdgeCdnRoutingSynthesizer.Regions; r++)
                            {
                                var p = C.Primary(r);
                                <tr class="@(r == C.ViewerRegion ? "me" : null)">
                                    <td>@(GlobalEdgeCdnRoutingSynthesizer.RegionNames[r])@(C.CrowdActive(r) ? " 👥" : null)@(C.DropActive(r) ? " 📉" : null)</td>
                                    <td class="mono">@(F0(C.Viewers(r)))</td>
                                    <td>@(p >= 0 ? GlobalEdgeCdnRoutingSynthesizer.NodeNames[p] : "—")</td>
                                    <td class="mono">@(F1(C.RegionRttMs(r)))</td>
                                    <td class="mono">@(F2(C.RegionLoss(r) * 100))%</td>
                                    <td class="mono">@(F0(C.ThroughputMbps(r)))/@(F0(C.EstimateMbps(r)))</td>
                                    <td class="mono">@(F0(GlobalEdgeCdnRoutingSynthesizer.RungMbps[C.Rung(r)]))</td>
                                    <td><div class="bar buf"><i class="@(C.Stalled(r) ? "bad" : C.BufferSec(r) < 4 ? "warm" : "ok")" style="width:@(F1(C.BufferSec(r) / GlobalEdgeCdnRoutingSynthesizer.MaxBufferSec * 100))%"></i></div></td>
                                    <td class="mono">@(C.Stalls(r))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <svg class="ncd-spark" viewBox="0 0 360 60" preserveAspectRatio="none">
                        <polyline class="rt" points="@(Series(i => Runner.RttSeries(i), 300, 60))" />
                        <polyline class="ls" points="@(Series(i => Runner.LossSeries(i), 6, 60))" />
                    </svg>
                    <div class="ncd-legend"><i class="rt"></i>감시 경로 RTT(0~300 ms) <i class="ls"></i>프레임당 손실 패킷(0~6)</div>
                </div>
                <div class="ncd-note">@(Runner.Action ?? "대기")</div>
            </div>
        </div>
    </div>
</div>

<style>
    .ncd-scrim { position: fixed; inset: 0; z-index: var(--z-studio-modal); background: rgba(0,0,0,.62); display: flex; align-items: center; justify-content: center; padding: 20px; }
    .ncd-modal { width: min(1600px, 97vw); max-height: 94vh; display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--line); border-radius: 18px; box-shadow: 0 24px 60px rgba(0,0,0,.45); overflow: hidden; }
    .ncd-h { display: flex; justify-content: space-between; gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--line); background: linear-gradient(120deg, color-mix(in srgb, #06b6d4 16%, var(--card)), color-mix(in srgb, #6366f1 14%, var(--card))); }
    .ncd-title { font-size: 17px; font-weight: 900; color: var(--text-primary); }
    .ncd-sub { font-size: 12px; color: var(--text-secondary); margin-top: 4px; line-height: 1.5; } .ncd-sub b { color: var(--text-primary); }
    .ncd-x { background: none; border: none; color: var(--text-muted); font-size: 18px; cursor: pointer; border-radius: 8px; }
    .ncd-bar { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 20px; border-bottom: 1px solid var(--line); align-items: center; }
    .ncd-btn { font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 8px; border: 1px solid var(--line); background: transparent; color: var(--text-primary); cursor: pointer; } .ncd-btn:disabled { opacity: .4; cursor: default; }
    .ncd-btn.sm { font-size: 10px; padding: 2px 8px; } .ncd-btn.on { background: color-mix(in srgb, #06b6d4 24%, transparent); border-color: #22d3ee; } .ncd-btn.warn { border-color: #facc15; }
    .ncd-sel { font-size: 12px; padding: 4px 8px; border-radius: 8px; border: 1px solid var(--line); background: var(--card); color: var(--text-primary); }
    .ncd-chip { font: 700 11px var(--mono); padding: 3px 8px; border-radius: 999px; border: 1px solid var(--line); color: var(--text-secondary); }
    .ncd-chip.bad { border-color: #ef4444; color: #fca5a5; } .ncd-chip.warn { border-color: #eab308; color: #fde68a; }
    .ncd-main { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; padding: 14px 20px; min-height: 0; flex: 1; overflow-y: auto; }
    .ncd-col { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
    .ncd-card { border: 1px solid var(--line); border-radius: 12px; padding: 12px; display: flex; flex-direction: column; gap: 8px; }
    .ncd-sec { font-weight: 800; font-size: 13px; color: var(--text-primary); display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .ncd-gauges { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .ncd-gauge { display: flex; flex-direction: column; align-items: center; gap: 2px; } .ncd-gauge svg { width: 100%; max-width: 130px; height: 74px; }
    .ncd-gauge .bg { fill: none; stroke: #1f2937; stroke-width: 9; } .ncd-gauge .fg { fill: none; stroke: #22d3ee; stroke-width: 9; stroke-linecap: round; }
    .ncd-gauge b { font: 800 13px var(--mono); color: var(--text-primary); margin-top: -26px; } .ncd-gauge span { font-size: 10px; color: var(--text-muted); }
    .ncd-views { display: grid; grid-template-columns: 1.6fr 1fr; gap: 8px; } .ncd-frame { width: 100%; aspect-ratio: 16 / 9; background: #030712; border-radius: 8px; }
    .ncd-frame .mb.m0 { fill: #1e293b; } .ncd-frame .mb.m1 { fill: #0e7490; } .ncd-frame .mb.m2 { fill: #b45309; } .ncd-frame .mv { stroke: #e0f2fe; stroke-width: .08; }
