@code {
    [Parameter] public StoryboardProject Project { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>v16.15.0 결과 폴더/ZIP 탐색기 열기(호스트 주입 · 미지정 시 버튼 숨김).</summary>
    [Parameter] public Action<string>? OnReveal { get; set; }

    private const string PackTab = "__pack__";
    private readonly List<OsmuTarget> _targets = new() { OsmuTarget.YouTubeShorts, OsmuTarget.InstagramReels, OsmuTarget.TikTok, OsmuTarget.InstagramFeed, OsmuTarget.Pinterest, OsmuTarget.NaverClip };
    private OsmuFraming _framing = OsmuFraming.BlurBackground;
    private bool _useAi = true;
    private bool _zip;
    private int _packPct;
    private string _packStage = "";
    private OsmuExportResult? _packResult;
    private System.Threading.CancellationTokenSource? _packCts;
    private bool Running => _packCts is not null;
    private bool HasMaster => !string.IsNullOrWhiteSpace(Project?.FinalVideoPath) && File.Exists(Project.FinalVideoPath);
    private bool CanPack => !Running && HasMaster && _targets.Count > 0 && Packager.IsAvailable && !Packager.IsBusy;

    // ── v16.17.0 🔍 AI 품질 검수 ──
    private const string QaTab = "__qa__";
    private const string PublishTab = "__publish__";
    private DirectSocialPublisherBridge? _bridge;   // 데스크톱 전용(모바일 미등록 → 게시 탭 숨김 · @inject 대신 선택적 해석)
    private QaInspectionReport? _qaReport;
    private SafePlatform _qaTarget = SafePlatform.YouTubeShorts;
    private System.Threading.CancellationTokenSource? _qaCts;
    private bool QaRunning => _qaCts is not null;
    private bool HasSidecar => HasMaster && File.Exists(Path.ChangeExtension(Project.FinalVideoPath!, ".ass"));

    /// <summary>현재 프로젝트 최종 영상의 검수 결과(모달 실행분 우선 · 없으면 검수기 최근 결과 중 같은 영상).</summary>
    private QaInspectionReport? CurrentQa
    {
        get
        {
            var r = _qaReport ?? Qa.LastReport;
            return r is not null && HasMaster && string.Equals(r.VideoPath, Project.FinalVideoPath, StringComparison.OrdinalIgnoreCase) ? r : null;
        }
    }

    private bool QaRejected => CurrentQa is { CanPublish: false };

    private static string VerdictCss(QaVerdict v) => v switch { QaVerdict.Pass => "qa-pass", QaVerdict.Warn => "qa-warn", _ => "qa-reject" };
    private static string VerdictShort(QaVerdict v) => v switch { QaVerdict.Pass => "통과", QaVerdict.Warn => "경고", _ => "거부" };
    private static string VerdictLabel(QaVerdict v) => v switch { QaVerdict.Pass => "✅ 통과", QaVerdict.Warn => "⚠️ 경고", _ => "⛔ 거부" };
    private static string Db(double v) => double.IsNegativeInfinity(v) || double.IsNaN(v) ? "-∞" : v.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);

    private void ShowQaTab() => _active = QaTab;
    private void ShowPublishTab() => _active = PublishTab;

    private async Task RunQaAsync()
    {
        if (!HasMaster || QaRunning) return;
        var cts = new System.Threading.CancellationTokenSource();
        _qaCts = cts;
        try
        {
            var video = Project.FinalVideoPath!;
            var probe = AutomatedVideoQaInspector.TryLoadSidecarProbe(video, _qaTarget);
            _qaReport = await Task.Run(() => Qa.InspectAsync(video, probe, cts.Token));
            if (_qaReport is { CanPublish: true }) _forceQa = false;
        }
        catch (Exception ex) { Program.Log("OsmuModal.Qa", ex); ShowToast("검수 실패: " + ex.Message); }
        finally
        {
            if (ReferenceEquals(System.Threading.Interlocked.CompareExchange(ref _qaCts, null, cts), cts)) cts.Dispose();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CancelQa()
    {
        try { _qaCts?.Cancel(); } catch (ObjectDisposedException) { /* 이미 종료 */ }
    }

    // ── v16.17.0 🚀 소셜 바로 게시 ──
    private sealed class PublishDraft(SocialPublishTarget target, OsmuTarget osmu, SafePlatform safe, string icon, string label)
    {
        public SocialPublishTarget Target { get; } = target;
        public OsmuTarget Osmu { get; } = osmu;
        public SafePlatform Safe { get; } = safe;
        public string Icon { get; } = icon;
        public string Label { get; } = label;
        public bool On { get; set; } = true;
        public string Title { get; set; } = "";
        public string Body { get; set; } = "";
        public string Tags { get; set; } = "";
        public int Pct { get; set; }
        public string Stage { get; set; } = "";
        public SocialPublishResult? Result { get; set; }
    }

    private readonly PublishDraft[] _drafts =
    {
        new(SocialPublishTarget.YouTubeShorts, OsmuTarget.YouTubeShorts, SafePlatform.YouTubeShorts, "▶️", "YouTube Shorts"),
        new(SocialPublishTarget.TikTok, OsmuTarget.TikTok, SafePlatform.TikTok, "🎵", "TikTok"),
        new(SocialPublishTarget.InstagramReels, OsmuTarget.InstagramReels, SafePlatform.InstagramReels, "📸", "Instagram Reels"),
    };
    private static readonly char[] TagSeparators = { ' ', ',', '\n', '\r', '\t' };
    private Func<Task>[] _retry = Array.Empty<Func<Task>>();
    private Action[] _openLink = Array.Empty<Action>();
    private bool _public;
    private bool _forceQa;
    private DateTime? _scheduleLocal;
    private System.Threading.CancellationTokenSource? _pubCts;
    private long _lastPubRender;
    private bool Publishing => _pubCts is not null;
    private int SelectedCount { get { var n = 0; foreach (var d in _drafts) if (d.On) n++; return n; } }
    private bool CanPublish => !Publishing && HasMaster && SelectedCount > 0;

    private void InitPublish()
    {
        _bridge = Services.GetService(typeof(DirectSocialPublisherBridge)) as DirectSocialPublisherBridge;
        var fallbackTitle = Project?.Title ?? "";
        foreach (var m in _metas)
            if (m.Platform == "YouTube Shorts" && !string.IsNullOrWhiteSpace(m.Title)) { fallbackTitle = m.Title; break; }
        foreach (var d in _drafts)
        {
            PlatformMeta? meta = null;
            foreach (var m in _metas) if (m.Platform == d.Label) { meta = m; break; }
            d.Title = meta is not null && !string.IsNullOrWhiteSpace(meta.Title) ? meta.Title : fallbackTitle;
            d.Body = meta?.Body ?? "";
            d.Tags = meta?.HashtagLine ?? "";
        }
        // 루프 내 핸들러 클로저 할당 방지 — 채널 슬롯 수만큼 1회 생성.
        _retry = new Func<Task>[_drafts.Length];
        _openLink = new Action[_drafts.Length];
        for (var i = 0; i < _drafts.Length; i++)
        {
            var d = _drafts[i];
            _retry[i] = () => RetryAsync(d);
            _openLink[i] = () => OpenResultLink(d);
        }
        if (_bridge is not null) _bridge.OnChange += OnBridgeChanged;
    }

    /// <summary>채널 업로드 소스 — 같은 세션 OSMU 패키지 결과(대상 규격 MP4) 우선, 없으면 원본 완성 영상.</summary>
    private string VideoFor(PublishDraft d)
    {
        if (_packResult is { Items: { } items })
            foreach (var it in items)
                if (it.Target == d.Osmu && it.Ok && it.VideoPath is { } vp && File.Exists(vp)) return vp;
        return Project?.FinalVideoPath ?? "";
    }

    private static IReadOnlyList<string> ParseTags(string raw)
    {
        var parts = (raw ?? "").Split(TagSeparators, StringSplitOptions.RemoveEmptyEntries);
        var list = new List<string>(parts.Length);
        foreach (var p in parts) { var t = p.TrimStart('#'); if (t.Length > 0) list.Add(t); }
        return list;
    }

    private void ClearSchedule() => _scheduleLocal = null;

    private DateTime? ScheduleUtc => _scheduleLocal is { } local ? DateTime.SpecifyKind(local, DateTimeKind.Local).ToUniversalTime() : null;

    private async Task PublishAllAsync()
    {
        if (!CanPublish || _bridge is null) return;
        var scheduleUtc = ScheduleUtc;
        if (scheduleUtc is { } su && su <= DateTime.UtcNow.AddMinutes(1)) { ShowToast("예약 시각은 현재보다 이후여야 합니다"); return; }
        var cts = new System.Threading.CancellationTokenSource();
        _pubCts = cts;
        foreach (var d in _drafts) if (d.On) { d.Result = null; d.Pct = 0; d.Stage = "대기"; }
        try
        {
            foreach (var d in _drafts)
            {
                if (!d.On) continue;
                if (cts.IsCancellationRequested) { d.Stage = ""; d.Result = new SocialPublishResult(d.Target, false, SocialPublishState.Canceled, null, null, "취소됨"); continue; }
                await PublishOneAsync(d, scheduleUtc, cts.Token);   // 채널 실패는 건너뛰고 계속([부분 구제])
            }
            int ok = 0, total = 0;
            foreach (var d in _drafts) if (d.On) { total++; if (d.Result is { Ok: true }) ok++; }
            ShowToast("🚀 게시 " + ok.ToString(System.Globalization.CultureInfo.InvariantCulture) + "/" + total.ToString(System.Globalization.CultureInfo.InvariantCulture) + " 성공");
        }
        finally
        {
            if (ReferenceEquals(System.Threading.Interlocked.CompareExchange(ref _pubCts, null, cts), cts)) cts.Dispose();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PublishOneAsync(PublishDraft d, DateTime? scheduleUtc, System.Threading.CancellationToken ct)
    {
        var bridge = _bridge;
        if (bridge is null) return;
        var video = VideoFor(d);
        var req = new SocialPublishRequest(d.Target, video, d.Title, d.Body, ParseTags(d.Tags), scheduleUtc, _public, _forceQa,
            AutomatedVideoQaInspector.TryLoadSidecarProbe(video, d.Safe));
        d.Stage = "QA 검수 · 업로드"; d.Pct = 0;
        await InvokeAsync(StateHasChanged);
        var progress = new Progress<double>(p =>
        {
            d.Pct = (int)Math.Clamp(p, 0, 100);
            ThrottledRender();
        });
        SocialPublishResult result;
        try { result = await Task.Run(() => bridge.PublishAsync(req, progress, ct)); }
        catch (Exception ex) { result = new SocialPublishResult(d.Target, false, SocialPublishState.Failed, null, null, "게시 실패: " + ex.Message); }
        d.Result = result;
        d.Stage = result.Ok ? "완료" : "";
        if (result.Ok) d.Pct = 100;
        if (result.Qa is { } qa && string.Equals(qa.VideoPath, Project?.FinalVideoPath, StringComparison.OrdinalIgnoreCase)) _qaReport = qa;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RetryAsync(PublishDraft d)
    {
        if (Publishing || _bridge is null || !HasMaster) return;
        var cts = new System.Threading.CancellationTokenSource();
        _pubCts = cts;
        try
        {
            var scheduleUtc = ScheduleUtc;
            if (scheduleUtc is { } su && su <= DateTime.UtcNow.AddMinutes(1)) scheduleUtc = null;   // 지난 예약 → 즉시
            await PublishOneAsync(d, scheduleUtc, cts.Token);
        }
        finally
        {
            if (ReferenceEquals(System.Threading.Interlocked.CompareExchange(ref _pubCts, null, cts), cts)) cts.Dispose();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CancelPublish()
    {
        try { _pubCts?.Cancel(); } catch (ObjectDisposedException) { /* 이미 종료 */ }
    }

    private void OpenResultLink(PublishDraft d)
    {
        if (d.Result?.Url is not { } url) return;
        ShowToast(DeepLink.OpenUrl(url) ? "🔗 게시물을 브라우저로 열었어요" : "브라우저를 열지 못했습니다");
    }

    // 업로드 진행률/브릿지 상태(백그라운드 콜백) → 250ms 스로틀 렌더.
    private void ThrottledRender()
    {
        var now = Environment.TickCount64;
        if (now - System.Threading.Interlocked.Read(ref _lastPubRender) < 250) return;
        System.Threading.Interlocked.Exchange(ref _lastPubRender, now);
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnBridgeChanged()
    {
        try { if (Publishing) ThrottledRender(); }
        catch (Exception ex) { Program.Log("OsmuModal.BridgeChanged", ex); }
    }

    private void ShowToast(string text)
    {
        _toast = text;
        _toastTimer?.Dispose();
        _toastTimer = new System.Threading.Timer(_ => { _toast = null; _ = InvokeAsync(StateHasChanged); }, null, 2500, System.Threading.Timeout.Infinite);
    }

    private void ToggleTarget(OsmuTarget t, ChangeEventArgs e)
    {
        if (e.Value is true) { if (!_targets.Contains(t)) _targets.Add(t); }
        else _targets.Remove(t);
    }

    private async Task PackAsync()
    {
        if (!CanPack) return;
        var cts = new System.Threading.CancellationTokenSource();
        _packCts = cts;
        _packPct = 0; _packStage = "준비 중…"; _packResult = null;
        var progress = new Progress<PostProductionProgress>(p =>
        {
            _packPct = p.Percent; _packStage = p.Stage;
            _ = InvokeAsync(StateHasChanged);
        });
        try
        {
            var req = new OsmuExportRequest(Project.FinalVideoPath!, _targets.ToArray(), _framing, _zip, _useAi && Packager.AiEnabled);
            _packResult = await Task.Run(() => Packager.ExportAsync(Project, req, progress, cts.Token));
            if (_packResult.Ok && _packResult.OutputPath is not null) OnReveal?.Invoke(_packResult.OutputPath);
        }
        catch (Exception ex) { _packResult = new OsmuExportResult(false, null, Array.Empty<OsmuExportItem>(), "OSMU 내보내기 실패: " + ex.Message); }
        finally
        {
            if (ReferenceEquals(System.Threading.Interlocked.CompareExchange(ref _packCts, null, cts), cts)) cts.Dispose();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CancelPack()
    {
        try { _packCts?.Cancel(); } catch (ObjectDisposedException) { /* 이미 종료 */ }
    }

    private const string AudioTab = "__audio__";
    private IReadOnlyList<PlatformMeta> _metas = Array.Empty<PlatformMeta>();
    private BabySeoAgent.TrendingAudioTags? _audio;
    private string _active = PackTab;
    private PlatformMeta? ActiveMeta => _metas.FirstOrDefault(x => x.Platform == _active) ?? _metas.FirstOrDefault();
    private string? _toast;
    private System.Threading.Timer? _toastTimer;

    protected override void OnInitialized()
    {
        if (Project is not null)
        {
            _metas = PlatformSeo.PackageAll(Project);           // 8대 플랫폼 재구성
            _audio = BabySeoAgent.GetTrendingAudio(Project);    // metadata_seo.json 과 동일 소스
        }
        InitPublish();
        if (CurrentQa is { CanPublish: false }) _active = QaTab;   // 같은 영상의 최근 검수가 거부면 검수 탭부터
    }

    private void OpenPlatform(string platform)
    {
        var ok = DeepLink.OpenPlatform(platform);
        _toast = ok ? $"🔗 {platform} 페이지를 브라우저로 열었어요" : "브라우저를 열지 못했습니다";
        _toastTimer?.Dispose();
        _toastTimer = new System.Threading.Timer(_ => { _toast = null; _ = InvokeAsync(StateHasChanged); }, null, 2500, System.Threading.Timeout.Infinite);
    }

    private sealed record AudioCard(string Key, string Icon, string Name, string CopyLabel, IReadOnlyList<string> Tags, string Copy, AudioSearchPlatform SearchPlatform, string SearchQuery);

    private IReadOnlyList<AudioCard> AudioCards => _audio is null ? Array.Empty<AudioCard>() : new[]
    {
        new AudioCard("yt", "▶️", "YouTube Shorts", "유튜브 오디오 태그", _audio.YouTubeShorts, string.Join(", ", _audio.YouTubeShorts), AudioSearchPlatform.YouTube, _audio.YouTubeShorts.FirstOrDefault() ?? ""),
        new AudioCard("ig", "📸", "Instagram Reels", "인스타 오디오 태그", _audio.InstagramReels, string.Join(", ", _audio.InstagramReels), AudioSearchPlatform.Instagram, _audio.InstagramReels.FirstOrDefault() ?? ""),
        new AudioCard("tt", "🎵", "TikTok", "틱톡 오디오 태그", _audio.TikTok, string.Join(", ", _audio.TikTok), AudioSearchPlatform.TikTok, _audio.TikTok.FirstOrDefault() ?? ""),
    };

    private void OpenAudioSearch(AudioSearchPlatform platform, string query)
    {
        var ok = DeepLink.OpenSearch(platform, query);
        _toast = ok ? "🔎 브라우저에서 음원 검색을 열었어요" : "브라우저를 열지 못했습니다";
        _toastTimer?.Dispose();
        _toastTimer = new System.Threading.Timer(_ => { _toast = null; _ = InvokeAsync(StateHasChanged); }, null, 2500, System.Threading.Timeout.Infinite);
    }

    private string AudioAllText() => _audio is null ? "" :
        $"🎵 트렌딩 오디오 추천 ({_audio.EnergyLabel})\n\n▶️ YouTube Shorts: {string.Join(", ", _audio.YouTubeShorts)}\n📸 Instagram Reels: {string.Join(", ", _audio.InstagramReels)}\n🎵 TikTok: {string.Join(", ", _audio.TikTok)}\n\n※ {_audio.Note}";

    private async Task Close() => await OnClose.InvokeAsync();

    private void Copy(string label, string text)
    {
        var ok = Clipboard.SetText(text ?? "");
        _toast = ok ? $"✓ {label} 복사됨" : "복사 실패";
        _toastTimer?.Dispose();
        _toastTimer = new System.Threading.Timer(_ => { _toast = null; _ = InvokeAsync(StateHasChanged); }, null, 2500, System.Threading.Timeout.Infinite);
    }

    public void Dispose()
    {
        _toastTimer?.Dispose();
        if (_bridge is not null) _bridge.OnChange -= OnBridgeChanged;
        var qcts = System.Threading.Interlocked.Exchange(ref _qaCts, null);
        if (qcts is not null) { try { qcts.Cancel(); } catch (ObjectDisposedException) { } qcts.Dispose(); }
        var pcts = System.Threading.Interlocked.Exchange(ref _pubCts, null);
        if (pcts is not null) { try { pcts.Cancel(); } catch (ObjectDisposedException) { } pcts.Dispose(); }
        var cts = System.Threading.Interlocked.Exchange(ref _packCts, null);
        if (cts is not null) { try { cts.Cancel(); } catch (ObjectDisposedException) { } cts.Dispose(); }
    }
