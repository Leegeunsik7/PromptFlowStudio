@inject PlatformSeoAgent PlatformSeo
@inject IClipboardService Clipboard
@inject PlatformDeepLinkService DeepLink
@inject OsmuExportPackager Packager
@inject AutomatedVideoQaInspector Qa
@inject IServiceProvider Services
@implements IDisposable

@* [PromptFlow Studio] OSMU 8대 플랫폼 내보내기 — 1회 콘텐츠를 8대 글로벌/국내 플랫폼 포맷으로 재구성 + 플랫폼별 탭 + 원클릭 복사/딥링크. *@
<div class="om-scrim" @onclick="Close">
    <div class="om-modal" @onclick:stopPropagation="true">
        <div class="om-h">
            <div>
                <div class="om-title">🌐 OSMU 멀티 플랫폼 내보내기 <HelpBadge Topic="@HelpContentService.Keys.Osmu" /></div>
                <div class="om-sub">1회 생성 콘텐츠를 <b>유튜브·인스타·틱톡·네이버클립·당근·샤오홍슈·핀터레스트·치지직</b> 8대 플랫폼 최적 포맷으로 재구성했어요. 탭에서 복사·붙여넣거나 [플랫폼 열기]로 바로 이동하세요.</div>
            </div>
            <button class="om-x" @onclick="Close" title="닫기">✕</button>
        </div>

        @if (_metas is { Count: > 0 })
        {
            <div class="om-tabs">
                @* v16.17.0 최종 QC — AI 품질 검수 · 소셜 바로 게시(게시 브릿지는 데스크톱 전용 → 미등록 시 탭 숨김) *@
                <button class="om-tab @(_active == QaTab ? "on" : null)" @onclick="ShowQaTab">
                    <span>🔍</span> AI 품질 검수
                    @if (CurrentQa is { } tq) { <span class="om-qa-dot @VerdictCss(tq.Verdict)">@VerdictShort(tq.Verdict)</span> }
                </button>
                @if (_bridge is not null)
                {
                    <button class="om-tab @(_active == PublishTab ? "on" : null)" @onclick="ShowPublishTab">
                        <span>🚀</span> 소셜 게시
                    </button>
                }
                <button class="om-tab @(_active == PackTab ? "on" : null)" @onclick="() => _active = PackTab">
                    <span>🌐</span> 영상+메타 패키지
                </button>
                @foreach (var p in _metas)
                {
                    <button class="om-tab @(_active == p.Platform ? "on" : null)" @onclick="() => _active = p.Platform" @key="p.Platform">
                        <span>@p.Icon</span> @p.Platform
                    </button>
                }
                <button class="om-tab @(_active == AudioTab ? "on" : null)" @onclick="() => _active = AudioTab">
                    <span>🎵</span> 트렌딩 오디오
                </button>
            </div>

            @if (_active == QaTab)
            {
                @* v16.17.0 🔍 AI 품질 검수 — blackdetect·freezedetect·astats·자막 가림 → 통과/경고/거부 + 결함 타임스탬프 *@
                <div class="om-body">
                    <div class="om-sec">
                        <div class="om-lbl"><span>검수 대상 영상</span></div>
                        <div class="om-box">@(HasMaster ? Path.GetFileName(Project.FinalVideoPath) : "아직 최종 영상이 없습니다 — [🎬 최종 영상 내보내기]를 먼저 실행하세요.")</div>
                    </div>
                    <div class="om-opts">
                        <select class="om-sel" @bind="_qaTarget" disabled="@QaRunning" title="자막 가림 검사 기준 플랫폼 세이프존">
                            <option value="@SafePlatform.YouTubeShorts">▶️ YouTube Shorts 세이프존</option>
                            <option value="@SafePlatform.TikTok">🎵 TikTok 세이프존</option>
                            <option value="@SafePlatform.InstagramReels">📸 Instagram Reels 세이프존</option>
                        </select>
                        <span class="om-audio-note">@(HasSidecar ? "💬 자막 사이드카(.ass) 감지 — 자막 가림 검사 포함" : "💬 자막 사이드카 없음 — 프레임/오디오만 검사")</span>
                    </div>
                    @if (QaRunning)
                    {
                        <div class="om-bar"><div class="om-bar-f indet"></div></div>
                        <div class="om-audio-note">ffmpeg 스캔 중… (블랙·정지 프레임 · 오디오 피크 · 자막 가림)</div>
                    }
                    @if (CurrentQa is { } qr)
                    {
                        <div class="om-qa-head">
                            <span class="om-qa-badge @VerdictCss(qr.Verdict)">@VerdictLabel(qr.Verdict)</span>
                            <span class="om-qa-msg">@qr.Message</span>
                        </div>
                        <div class="om-qa-stats">
                            <span>⏱ @(AutomatedVideoQaInspector.Clock(qr.DurationSeconds))</span>
                            <span>📈 피크 @(Db(qr.PeakDbfs))dBFS</span>
                            <span>🎚 RMS @(Db(qr.RmsDbfs))dBFS</span>
                            <span>@(qr.Scanned ? "🔬 프레임/오디오 스캔 완료" : "⚠ 프레임/오디오 미검사")</span>
                        </div>
                        <div class="om-sec">
                            <div class="om-lbl"><span>결함 리포트 <span class="om-mini">@(qr.Defects.Count)건</span></span></div>
                            @if (qr.Defects.Count == 0)
                            {
                                <div class="om-box">결함이 발견되지 않았습니다.</div>
                            }
                            @for (var di = 0; di < qr.Defects.Count; di++)
                            {
                                var d = qr.Defects[di];
                                <div class="om-qa-row @VerdictCss(d.Severity)" @key="di">
                                    <span class="om-qa-kind">@(AutomatedVideoQaInspector.LabelOf(d.Kind))</span>
                                    <span class="om-qa-ts">@(AutomatedVideoQaInspector.Clock(d.StartSeconds)) – @(AutomatedVideoQaInspector.Clock(d.EndSeconds))</span>
                                    <span class="om-qa-det">@d.Detail</span>
                                    <span class="om-qa-dot @VerdictCss(d.Severity)">@VerdictShort(d.Severity)</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="om-foot">
                    @if (_toast is not null) { <span class="om-toast">@_toast</span> }
                    <div class="om-foot-btns">
                        <button class="om-btn ghost" @onclick="Close">닫기</button>
                        @if (QaRunning)
                        {
                            <button class="om-btn ghost" @onclick="CancelQa">■ 취소</button>
                        }
                        else
                        {
                            <button class="om-btn go" disabled="@(!HasMaster)" @onclick="RunQaAsync"
                                    title="@(Qa.IsAvailable ? "최종 영상의 블랙/정지 프레임 · 오디오 클리핑 · 자막 가림을 자동 검수" : "ffmpeg.exe 가 없어 자막 가림만 검사합니다")">🔍 품질 검수 실행</button>
                        }
                    </div>
                </div>
            }
            else if (_active == PublishTab && _bridge is not null)
            {
                @* v16.17.0 🚀 소셜 바로 게시 — 채널 토글 · 메타 편집 · 공개/예약 · QA 게이트(거부 시 경고 + 강제 진행) · 진행률/링크 *@
                <div class="om-body">
                    @for (var i = 0; i < _drafts.Length; i++)
                    {
                        var dr = _drafts[i];
                        <div class="om-pub @(dr.On ? "on" : null)" @key="dr.Target">
                            <div class="om-pub-h">
                                <label class="om-opt">
                                    <input type="checkbox" @bind="dr.On" disabled="@Publishing" /> @dr.Icon @dr.Label
                                </label>
                                <span class="om-mini">@(_bridge.IsEnabled(dr.Target) ? "🔐 자격 연결됨" : "⚠ 자격 미구성(환경변수/설정)") · @(Path.GetFileName(VideoFor(dr)))</span>
                            </div>
                            @if (dr.On)
                            {
                                <input class="om-box om-in" @bind="dr.Title" disabled="@Publishing" placeholder="제목" maxlength="100" />
                                <textarea class="om-box area" rows="3" @bind="dr.Body" disabled="@Publishing" placeholder="본문/설명"></textarea>
                                <input class="om-box om-in" @bind="dr.Tags" disabled="@Publishing" placeholder="#해시태그 #공백구분" />
                            }
                            @if (dr.Stage.Length > 0)
                            {
                                <div class="om-bar"><div class="om-bar-f" style="width:@(dr.Pct)%"></div></div>
                                <div class="om-audio-note">@dr.Stage · @(dr.Pct)%</div>
                            }
                            @if (dr.Result is { } res)
                            {
                                <div class="om-pub-res @(res.Ok ? "ok" : "bad")">
                                    <span>@(res.Ok ? "✅" : "⚠") @res.Message</span>
                                    @if (res.Url is not null)
                                    {
                                        <button class="om-copy" @onclick="_openLink[i]">🔗 게시물 열기</button>
                                    }
                                    else if (res.PostId is not null)
                                    {
                                        <span class="om-mini">ID @res.PostId</span>
                                    }
                                    @if (!res.Ok && !Publishing)
                                    {
                                        <button class="om-copy" @onclick="_retry[i]">↻ 재시도</button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    <div class="om-opts">
                        <label class="om-opt" title="기본은 비공개(YouTube private · TikTok 나만 보기) — Instagram 은 공개 게시만 지원">
                            <input type="checkbox" @bind="_public" disabled="@Publishing" /> 🌍 공개 게시
                        </label>
                        <label class="om-opt" title="YouTube 는 네이티브 예약 · TikTok/Instagram 은 앱 실행 중 로컬 예약">
                            ⏰ 예약 <input type="datetime-local" class="om-sel" @bind="_scheduleLocal" @bind:format="yyyy-MM-ddTHH:mm" disabled="@Publishing" />
                        </label>
                        @if (_scheduleLocal is not null)
                        {
                            <button class="om-copy" @onclick="ClearSchedule" disabled="@Publishing">✕ 즉시 게시</button>
                        }
                    </div>
                    @if (QaRejected)
                    {
                        <div class="om-qa-warn">
                            ⛔ 최근 AI 품질 검수가 <b>거부</b> 판정입니다 — 결함을 수정하거나 아래 옵션으로 강제 진행하세요.
                            <label class="om-opt"><input type="checkbox" @bind="_forceQa" disabled="@Publishing" /> ⚠ QA 무시하고 강제 진행</label>
                        </div>
                    }
                    else if (!Qa.IsAvailable)
                    {
                        <div class="om-audio-note">ffmpeg 가 없어 게시 전 프레임/오디오 검수는 생략됩니다(자막 가림만 검사).</div>
                    }
                </div>

                <div class="om-foot">
                    @if (_toast is not null) { <span class="om-toast">@_toast</span> }
                    <div class="om-foot-btns">
                        <button class="om-btn ghost" @onclick="Close">닫기</button>
                        @if (Publishing)
                        {
                            <button class="om-btn ghost" @onclick="CancelPublish">■ 취소</button>
                        }
                        else
                        {
                            <button class="om-btn go @(QaRejected && !_forceQa ? "warn" : null)" disabled="@(!CanPublish)" @onclick="PublishAllAsync"
                                    title="@(QaRejected && !_forceQa ? "QA 거부 판정 — 게시 전 검수에서 차단될 수 있습니다" : "선택 채널에 게시 전 QA 검수 후 업로드")">@(QaRejected && !_forceQa ? "⚠️ " : "")🚀 1-Click 게시 (@(SelectedCount)개 채널)</button>
                        }
                    </div>
                </div>
            }
            else if (_active == PackTab)
            {
                @* v16.15.0 OSMU 패키지 — 완성 영상 → 9:16·1:1·4:5 재구성 MP4 + AI 메타데이터 .txt → 폴더/ZIP *@
                <div class="om-body">
                    <div class="om-sec">
                        <div class="om-lbl"><span>원본 완성 영상</span></div>
                        <div class="om-box">@(HasMaster ? Path.GetFileName(Project.FinalVideoPath) : "아직 최종 영상이 없습니다 — [🎬 최종 영상 내보내기]를 먼저 실행하세요.")</div>
                    </div>
                    <div class="om-sec">
                        <div class="om-lbl"><span>플랫폼 규격 <span class="om-mini">@(_targets.Count)개 선택</span></span></div>
                        <div class="om-chips">
                            @foreach (var spec in OsmuSmartReframingService.Specs)
                            {
                                <label class="om-pick @(_targets.Contains(spec.Target) ? "on" : null)" @key="spec.Key">
                                    <input type="checkbox" checked="@_targets.Contains(spec.Target)" disabled="@Running" @onchange="e => ToggleTarget(spec.Target, e)" />
                                    @spec.Icon @spec.Label <span class="om-mini">@spec.Aspect · @(spec.Width)x@(spec.Height)</span>
                                </label>
                            }
                        </div>
                    </div>
                    <div class="om-opts">
                        <select class="om-sel" @bind="_framing" disabled="@Running" title="재구성 방식">
                            <option value="@OsmuFraming.BlurBackground">블러 배경(원본 전체 보존)</option>
                            <option value="@OsmuFraming.CenterCrop">센터 프레이밍(꽉 찬 크롭)</option>
                        </select>
                        <label class="om-opt" title="@(Packager.AiEnabled ? "Gemini 로 플랫폼별 제목·본문·해시태그 생성" : "Gemini API 키가 없어 오프라인 SEO 로 생성합니다")">
                            <input type="checkbox" @bind="_useAi" disabled="@(Running || !Packager.AiEnabled)" /> 🤖 AI 메타데이터
                        </label>
                        <label class="om-opt"><input type="checkbox" @bind="_zip" disabled="@Running" /> 🗜️ ZIP 으로 묶기</label>
                    </div>
                    @if (Running || _packPct > 0)
                    {
                        <div class="om-bar"><div class="om-bar-f" style="width:@(_packPct)%"></div></div>
                        <div class="om-audio-note">@_packStage · @(_packPct)%</div>
                    }
                    @if (_packResult is { } pr)
                    {
                        <div class="om-sec">
                            <div class="om-lbl"><span>@(pr.Ok ? "✅ 완료" : "⚠ 실패")</span></div>
                            <div class="om-box">@pr.Message</div>
                            @foreach (var it in pr.Items)
                            {
                                <div class="om-audio-note" @key="it.Target">@(it.Ok ? "✓" : "✗") @OsmuSmartReframingService.SpecOf(it.Target).Label — @it.Message</div>
                            }
                        </div>
                    }
                </div>

                <div class="om-foot">
                    @if (_toast is not null) { <span class="om-toast">@_toast</span> }
                    <div class="om-foot-btns">
                        <button class="om-btn ghost" @onclick="Close">닫기</button>
                        @if (_packResult is { Ok: true, OutputPath: { } outPath } && OnReveal is not null)
                        {
                            <button class="om-btn ghost" @onclick="() => OnReveal(outPath)">📂 탐색기에서 열기</button>
                        }
                        @if (Running)
                        {
                            <button class="om-btn ghost" @onclick="CancelPack">■ 취소</button>
                        }
                        else
                        {
                            <button class="om-btn go" disabled="@(!CanPack)" @onclick="PackAsync"
                                    title="@(Packager.IsAvailable ? "선택 플랫폼별 MP4 + 메타데이터 .txt 패키지 생성" : "ffmpeg.exe 가 필요합니다")">🌐 OSMU 패키지 내보내기</button>
                        }
                    </div>
                </div>
            }
            else if (_active == AudioTab)
            {
                <div class="om-body">
                    <div class="om-audio-head">
                        <span class="om-energy">🎚️ 에너지: <b>@(_audio?.EnergyLabel)</b> <HelpBadge Topic="@HelpContentService.Keys.TrendingAudio" /></span>
                        <span class="om-audio-note">@(_audio?.Note)</span>
                    </div>
                    @foreach (var a in AudioCards)
                    {
                        <div class="om-sec" @key="a.Key">
                            <div class="om-lbl"><span>@a.Icon @a.Name <span class="om-mini">@(a.Tags.Count)개</span></span>
                                <span class="om-abtns">
                                    <button class="om-copy" @onclick="() => OpenAudioSearch(a.SearchPlatform, a.SearchQuery)" disabled="@string.IsNullOrWhiteSpace(a.SearchQuery)" title="@($"{a.Name} 음원 검색 페이지를 브라우저로 열기")">@a.Icon 음원 검색</button>
                                    <button class="om-copy" @onclick="() => Copy(a.CopyLabel, a.Copy)">📋 복사</button>
                                </span>
                            </div>
                            <div class="om-chips">
                                @foreach (var t in a.Tags) { <span class="om-chip audio">@t</span> }
                            </div>
                        </div>
                    }
                </div>

                <div class="om-foot">
                    @if (_toast is not null) { <span class="om-toast">@_toast</span> }
                    <div class="om-foot-btns">
                        <button class="om-btn ghost" @onclick="Close">닫기</button>
                        <button class="om-btn go" @onclick='() => Copy("전체 오디오 태그", AudioAllText())'>📋 전체 오디오 태그 복사</button>
                    </div>
                </div>
            }
            else if (ActiveMeta is { } m)
            {
                <div class="om-body">
                    @if (!string.IsNullOrWhiteSpace(m.Title))
                    {
                        <div class="om-sec">
                            <div class="om-lbl"><span>제목</span><button class="om-copy" @onclick='() => Copy("제목", m.Title)'>📋 복사</button></div>
                            <div class="om-box">@m.Title</div>
                        </div>
                    }
                    <div class="om-sec">
                        <div class="om-lbl"><span>@(_active is "YouTube Shorts" or "Naver Clip" or "Pinterest" ? "설명란" : "캡션")</span>
                            <button class="om-copy" @onclick='() => Copy("본문", m.Body)'>📋 복사</button></div>
                        <textarea class="om-box area" readonly rows="7">@m.Body</textarea>
                    </div>
                    <div class="om-sec">
                        <div class="om-lbl"><span>해시태그 <span class="om-mini">@(m.Hashtags.Count)개</span></span>
                            <button class="om-copy" @onclick='() => Copy("해시태그", m.HashtagLine)'>📋 복사</button></div>
                        <div class="om-chips">
                            @foreach (var h in m.Hashtags) { <span class="om-chip">#@h</span> }
                        </div>
                    </div>
                </div>

                <div class="om-foot">
                    @if (_toast is not null) { <span class="om-toast">@_toast</span> }
                    <div class="om-foot-btns">
                        <button class="om-btn ghost" @onclick="Close">닫기</button>
                        <button class="om-btn ghost" @onclick="() => OpenPlatform(m.Platform)" title="@($"{m.Platform} 업로드/스튜디오 페이지 열기")">🔗 플랫폼 열기</button>
                        <button class="om-btn go" @onclick='() => Copy(m.Platform + " 전체", m.FullText)'>📋 이 플랫폼 전체 복사</button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="om-empty">메타데이터를 구성하지 못했습니다.</div>
        }
    </div>
</div>

<style>
    .om-scrim{position:fixed; inset:0; z-index:var(--z-studio-modal); background:rgba(0,0,0,.55); display:flex; align-items:center; justify-content:center; padding:20px}
    .om-modal{width:min(720px,96vw); max-height:90vh; display:flex; flex-direction:column; background:var(--card); border:1px solid var(--line); border-radius:18px; box-shadow:0 24px 60px rgba(0,0,0,.4); overflow:hidden}
    .om-h{display:flex; align-items:flex-start; justify-content:space-between; gap:12px; padding:18px 20px; border-bottom:1px solid var(--line)}
    .om-title{font-size:16px; font-weight:900; color:var(--text-primary)}
    .om-sub{font-size:12px; color:var(--text-secondary); margin-top:4px; line-height:1.5; max-width:60ch} .om-sub b{color:var(--text-primary)}
    .om-x{flex:0 0 auto; width:30px; height:30px; border:none; background:none; color:var(--text-muted); cursor:pointer; font-size:15px; border-radius:8px}
    .om-x:hover{background:var(--card-2); color:var(--text-primary)}
    .om-tabs{display:flex; flex-wrap:wrap; gap:6px; padding:14px 18px 4px}
    .om-tab{flex:0 0 auto; font:700 11.5px inherit; padding:8px 12px; border-radius:10px; border:1px solid var(--line); background:var(--card-2); color:var(--text-secondary); cursor:pointer; white-space:nowrap}
    .om-tab:hover{border-color:var(--accent); color:var(--text-primary)}
    .om-tab.on{background:var(--card); color:var(--text-primary); border-color:var(--accent); box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--accent) 40%,transparent)}
    .om-body{padding:16px 18px; overflow-y:auto; display:flex; flex-direction:column; gap:14px}
    .om-sec{display:flex; flex-direction:column; gap:7px}
