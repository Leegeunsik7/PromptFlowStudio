@using PromptFlowStudio.Services.Flow
@using PromptFlowStudio.Services.Wan

@* [PromptFlow Studio v5.6 · Task1] 베이스 프리라이트 & 템플릿 라이브러리 — 순수 Blazor(외부 UI 0).
   ▸ 원클릭 대표 파이프라인 템플릿 배치 + [👁️ 베이스 샘플 미리보기] 토글(렌더 전 대표 레퍼런스 표출 → 무분별 API 호출 방지). *@

<div class="bpd">
    <div class="bpd-h">
        <span class="bpd-t">📚 파이프라인 템플릿</span>
        <label class="bpd-toggle" title="렌더 전 노드 카드에 대표 샘플 프레임 표시">
            <input type="checkbox" checked="@BaseSample" @onchange="OnToggle" /> 👁️ 베이스 샘플 미리보기
        </label>
    </div>
    <div class="bpd-grid">
        @foreach (var t in ChainTemplateLibrary.All)
        {
            <button class="bpd-card" style="--acc:@t.Accent" @onclick="() => OnApplyTemplate.InvokeAsync(t)" @key="t.Key" title="@t.Summary">
                <img class="bpd-thumb" src="@ChainTemplateLibrary.SampleFor(t)" alt="@t.Name" loading="lazy" />
                <span class="bpd-name">@t.Emoji @t.Name</span>
                <span class="bpd-meta">@(t.Segments)컷 · @t.MotionPreset</span>
            </button>
        }
    </div>

    @* v5.6.5 · Task2: 렌더 전 실시간 컴파일 프롬프트 디버거 — 원본 vs AppendCore(현재 가드레일 설정) Before/After *@
    <div class="bpd-dbg">
        <button class="bpd-dbg-tg" @onclick="() => _dbgOpen = !_dbgOpen">
            🔍 최종 프롬프트 확인 <span class="bpd-dbg-caret">@(_dbgOpen ? "▲" : "▼")</span>
        </button>
        @if (_dbgOpen)
        {
            <div class="bpd-dbg-body">
                <div class="bpd-dbg-badge @(GuardEnabled ? "on" : "off")">
                    @(GuardEnabled ? $"🛡️ 현재 적용: On · {GuardPreset}" : "🔓 현재 적용: Off — 원본 100% 통과 (아래는 프리셋별 예상 결과)")
                </div>
                <label class="bpd-dbg-l">원본 프롬프트(테스트 입력)</label>
                <textarea class="bpd-dbg-ta" rows="2" @bind="_dbgInput" @bind:event="oninput"
                          placeholder="프롬프트를 입력하면 프리셋별 컴파일 결과가 실시간 갱신됩니다."></textarea>
                <div class="bpd-dbg-before"><span class="bpd-dbg-bl">Before · 원본</span>@(string.IsNullOrWhiteSpace(_dbgInput) ? "(비어 있음)" : _dbgInput)</div>
                @if (HasCustom)
                {
                    <div class="bpd-dbg-custom">✏️ 커스텀 코어 적용 중 — 3개 프리셋이 모두 커스텀 문구로 대체됩니다.</div>
                }
                @* v5.6.6 · Task3: 동일 원본 → Soft/Balanced/Strict 3열 병렬 대비(현재 프리셋 하이라이트) *@
                <div class="bpd-dbg-grid3">
                    @foreach (var p in DebugPresets)
                    {
                        <div class="bpd-dbg-card @(GuardEnabled && GuardPreset == p ? "active" : null)" @key="p">
                            <div class="bpd-dbg-ph">@PresetIcon(p) @p @(GuardEnabled && GuardPreset == p ? "· 현재" : null)</div>
                            <div class="bpd-dbg-box">@(string.IsNullOrWhiteSpace(CompiledFor(p)) ? "(비어 있음)" : CompiledFor(p))</div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<style>
    .bpd { padding: 8px 13px; border-bottom: 1px solid var(--line); background: color-mix(in srgb, #7c5cff 5%, transparent); }
    .bpd-h { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 8px; flex-wrap: wrap; }
    .bpd-t { font: 900 12px Pretendard,'Malgun Gothic',sans-serif; color: var(--text-primary); }
    .bpd-toggle { font: 800 10.5px Pretendard,'Malgun Gothic',sans-serif; color: #a78bfa; display: inline-flex; align-items: center; gap: 6px; cursor: pointer; }
    .bpd-grid { display: flex; gap: 8px; flex-wrap: wrap; }
    .bpd-card { width: 148px; display: flex; flex-direction: column; gap: 3px; padding: 6px; border-radius: 11px; border: 1px solid var(--line); background: var(--card-2); color: var(--text-secondary); cursor: pointer; text-align: left; border-left: 3px solid var(--acc, #7c5cff); }
    .bpd-card:hover { border-color: var(--acc, #7c5cff); color: var(--text-primary); }
    .bpd-thumb { width: 100%; aspect-ratio: 16/9; object-fit: cover; border-radius: 7px; background: #000; }
    .bpd-name { font: 800 10.5px Pretendard,'Malgun Gothic',sans-serif; color: var(--text-primary); word-break: keep-all; line-height: 1.3; }
    .bpd-meta { font: 700 9px 'JetBrains Mono', ui-monospace, monospace; color: var(--text-muted); }
    /* v5.6.5 프롬프트 디버거 */
    .bpd-dbg { margin-top: 8px; border-top: 1px dashed var(--line); padding-top: 8px; }
    .bpd-dbg-tg { font: 800 11px Pretendard,'Malgun Gothic',sans-serif; color: #22d3ee; background: none; border: none; cursor: pointer; padding: 2px 0; }
    .bpd-dbg-caret { font-size: 9px; }
    .bpd-dbg-body { display: flex; flex-direction: column; gap: 7px; margin-top: 6px; }
    .bpd-dbg-badge { font: 800 10px Pretendard,'Malgun Gothic',sans-serif; border-radius: 8px; padding: 6px 9px; }
    .bpd-dbg-badge.on { color: #052e16; background: linear-gradient(135deg,#34d399,#22d3ee); }
    .bpd-dbg-badge.off { color: #fff; background: linear-gradient(135deg,#f59e0b,#ef4444); }
    .bpd-dbg-l { font: 700 9.5px 'JetBrains Mono', ui-monospace, monospace; color: var(--text-muted); }
    .bpd-dbg-ta { width: 100%; box-sizing: border-box; resize: vertical; background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 7px 9px; color: var(--text-primary); font: 600 11px Pretendard,'Malgun Gothic',sans-serif; line-height: 1.5; outline: none; }
    .bpd-dbg-ta:focus { border-color: #22d3ee; }
    .bpd-dbg-before { font: 600 10.5px 'JetBrains Mono', ui-monospace, monospace; color: var(--text-secondary); background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 7px 10px; line-height: 1.5; word-break: break-word; }
    .bpd-dbg-bl { color: var(--text-muted); font-weight: 800; margin-right: 6px; }
    .bpd-dbg-custom { font: 700 10px Pretendard,'Malgun Gothic',sans-serif; color: #a78bfa; }
    .bpd-dbg-grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    @@media (max-width: 720px) { .bpd-dbg-grid3 { grid-template-columns: 1fr; } }
    .bpd-dbg-card { display: flex; flex-direction: column; gap: 4px; min-width: 0; border: 1px solid var(--line); border-radius: 9px; padding: 7px; background: color-mix(in srgb,#7c5cff 4%,transparent); }
    .bpd-dbg-card.active { border-color: #22d3ee; box-shadow: inset 0 0 0 1px color-mix(in srgb,#22d3ee 40%,transparent), 0 0 12px color-mix(in srgb,#22d3ee 22%,transparent); }
    .bpd-dbg-ph { font: 800 9.5px Pretendard,'Malgun Gothic',sans-serif; color: var(--text-secondary); }
    .bpd-dbg-card.active .bpd-dbg-ph { color: #7dd3fc; }
    .bpd-dbg-box { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; color: var(--text-secondary); font: 600 10px 'JetBrains Mono', ui-monospace, monospace; line-height: 1.5; word-break: break-word; white-space: pre-wrap; min-height: 62px; }
</style>

@code {
    /// <summary>템플릿 원클릭 배치 요청(부모가 엔진에 Apply).</summary>
    [Parameter] public EventCallback<ChainTemplate> OnApplyTemplate { get; set; }
    /// <summary>베이스 샘플 미리보기 토글 상태.</summary>
    [Parameter] public bool BaseSample { get; set; }
    /// <summary>토글 변경 통지.</summary>
    [Parameter] public EventCallback<bool> BaseSampleChanged { get; set; }

    private Task OnToggle(ChangeEventArgs e) => BaseSampleChanged.InvokeAsync(e.Value is true);

    // ── v5.6.5 · Task2: 프롬프트 디버거 ──
    // ⚠ 가드레일 상태는 파라미터로 수신(UserPreferenceService 는 데스크톱 DI 에만 등록 · 모바일 무주입 안전).
    //   단일 진실 공급원은 UserPreferenceService — FlowOrchestrator 가 값을 읽어 캔버스→여기로 흘려보낸다.
    /// <summary>상위(캔버스)에서 전달된 대표 원본 프롬프트(디버거 시드).</summary>
    [Parameter] public string? Prompt { get; set; }
    /// <summary>가드레일 사용 여부(기본 On = 앱 기본값과 일치).</summary>
    [Parameter] public bool GuardEnabled { get; set; } = true;
    /// <summary>가드레일 강도 프리셋(기본 Balanced).</summary>
    [Parameter] public QualityGuardrailPreset GuardPreset { get; set; } = QualityGuardrailPreset.Balanced;
    /// <summary>커스텀 코어(있으면 프리셋 대신 사용).</summary>
    [Parameter] public string? GuardCustom { get; set; }

    private bool _dbgOpen;
    private bool _seeded;
    private string _dbgInput = "노을 지는 해변을 천천히 걷는 골든리트리버, 시네마틱, 부드러운 카메라 팬";

    protected override void OnParametersSet()
    {
        // 상위 프롬프트가 있으면 최초 1회 시드(사용자가 편집한 이후엔 덮어쓰지 않음).
        if (!_seeded && !string.IsNullOrWhiteSpace(Prompt)) { _dbgInput = Prompt!.Trim(); _seeded = true; }
    }

    // v5.6.6 · Task3: 3열 병렬 대비 — 동일 원본에 Soft/Balanced/Strict 프리셋을 각각 적용.
    private static readonly QualityGuardrailPreset[] DebugPresets =
        { QualityGuardrailPreset.Soft, QualityGuardrailPreset.Balanced, QualityGuardrailPreset.Strict };

    private bool HasCustom => !string.IsNullOrWhiteSpace(GuardCustom);

    // 각 프리셋 결과(enabled:true 로 프리셋 차이를 항상 비교 · 커스텀 있으면 3열 동일 = 커스텀 우선 계약 반영).
    private string CompiledFor(QualityGuardrailPreset p) => WanPromptCompiler.AppendCore(_dbgInput, true, p, GuardCustom);

    private static string PresetIcon(QualityGuardrailPreset p) => p switch
    {
        QualityGuardrailPreset.Soft => "🌱",
        QualityGuardrailPreset.Strict => "🛡️",
        _ => "⚖️",
    };
}
