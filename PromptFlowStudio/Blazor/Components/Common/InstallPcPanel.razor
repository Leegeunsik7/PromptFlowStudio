@inject InstallTelemetryService Install

@* [PromptFlowStudio] 설치 PC 정보 — 배포자(관리자)가 프로그램이 설치된 PC 의 호스트·사용자·IP·MAC·OS 를 확인.
   기존 InstallTelemetryService(자동 수집) 재사용 — 이 PC 현재 스냅샷 + 수집 이력 로스터. *@
<section class="ip-card">
    <div class="ip-head">
        <span class="ip-ico">💻</span>
        <div class="ip-hgrow">
            <div class="ip-title">설치 PC 정보</div>
            <div class="ip-desc">프로그램 기동 시마다 호스트·사용자·IP·MAC·OS 가 <b>자동 수집</b>됩니다 · 로컬 IP만 수집 · 완전 오프라인</div>
        </div>
        <button class="ip-rf" @onclick="Refresh" title="새로고침">↻</button>
    </div>

    @if (Install.Info is { } me)
    {
        <div class="ip-me">
            <div class="ip-me-tag">이 PC · 현재 설치본</div>
            <div class="ip-me-grid">
                <div class="ip-kv"><span class="ip-k">호스트</span><span class="ip-v">@me.MachineName</span></div>
                <div class="ip-kv"><span class="ip-k">사용자</span><span class="ip-v">@me.UserName</span></div>
                <div class="ip-kv"><span class="ip-k">앱 버전</span><span class="ip-v">v@me.AppVersion</span></div>
                <div class="ip-kv"><span class="ip-k">수집시각</span><span class="ip-v mono">@me.CapturedAt</span></div>
                <div class="ip-kv wide"><span class="ip-k">IP</span><span class="ip-v mono">@(me.IpAddresses.Length > 0 ? string.Join(", ", me.IpAddresses) : "-")</span></div>
                <div class="ip-kv wide"><span class="ip-k">MAC</span><span class="ip-v mono">@(me.MacAddresses.Length > 0 ? string.Join(", ", me.MacAddresses) : "-")</span></div>
                <div class="ip-kv wide"><span class="ip-k">OS</span><span class="ip-v">@me.OsDescription</span></div>
                <div class="ip-kv wide"><span class="ip-k">데이터 폴더</span><span class="ip-v mono">@me.DataFolder</span></div>
            </div>
        </div>
    }

    <div class="ip-sub-h">📋 수집 이력 <span class="ip-cnt">@_installs.Count 건</span></div>
    @if (_installs.Count == 0)
    {
        <div class="ip-empty">아직 수집된 설치 이력이 없습니다.</div>
    }
    else
    {
        <div class="ip-wrap">
            <table class="ip-tbl">
                <thead><tr><th>호스트</th><th>사용자</th><th>IP</th><th>MAC</th><th>OS</th><th>수집시각</th></tr></thead>
                <tbody>
                    @foreach (var p in _installs)
                    {
                        <tr>
                            <td class="ip-id">@p.MachineName</td>
                            <td>@p.UserName</td>
                            <td class="mono">@(p.IpAddresses.Length > 0 ? string.Join(", ", p.IpAddresses) : "-")</td>
                            <td class="mono">@(p.MacAddresses.Length > 0 ? string.Join(", ", p.MacAddresses) : "-")</td>
                            <td>@p.OsDescription</td>
                            <td class="mono">@p.CapturedAt</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <div class="ip-path">🔒 @Install.FilePath</div>
</section>

<style>
    .ip-card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 18px; margin-bottom: 14px; }
    .ip-head { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
    .ip-ico { width: 42px; height: 42px; flex: 0 0 auto; display: grid; place-items: center; font-size: 20px; border-radius: 11px; background: color-mix(in srgb, var(--accent) 12%, transparent); border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent); }
    .ip-hgrow { min-width: 0; flex: 1; }
    .ip-title { font-size: 15px; font-weight: 800; color: var(--ink); }
    .ip-desc { font-size: 11.5px; color: var(--sub); margin-top: 2px; line-height: 1.5; } .ip-desc b { color: var(--accent); }
    .ip-rf { width: 30px; height: 30px; flex: 0 0 auto; border-radius: 9px; border: 1px solid var(--line); background: var(--card-2); color: var(--sub); cursor: pointer; font-size: 15px; }
    .ip-rf:hover { border-color: var(--accent); color: var(--ink); }
    .ip-me { background: var(--card-2); border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent); border-radius: 12px; padding: 12px 15px; margin-bottom: 16px; }
    .ip-me-tag { font-size: 10.5px; font-weight: 800; letter-spacing: .04em; color: var(--accent); margin-bottom: 10px; }
    .ip-me-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 22px; }
    .ip-kv { display: flex; gap: 10px; align-items: baseline; min-width: 0; } .ip-kv.wide { grid-column: 1 / -1; }
    .ip-k { flex: 0 0 74px; font-size: 11px; font-weight: 700; color: var(--sub); }
    .ip-v { font-size: 12.5px; color: var(--ink); word-break: break-all; } .ip-v.mono { font-family: var(--mono); font-size: 12px; }
    @@media (max-width: 640px) { .ip-me-grid { grid-template-columns: 1fr; } }
    .ip-sub-h { font-size: 12.5px; font-weight: 800; color: var(--ink); margin: 4px 0 10px; display: flex; align-items: center; gap: 8px; }
    .ip-cnt { font-size: 11px; font-weight: 700; color: var(--sub); }
    .ip-empty { font-size: 13px; color: var(--sub); padding: 8px 0; }
    .ip-wrap { overflow-x: auto; }
    .ip-tbl { width: 100%; border-collapse: collapse; font-size: 13px; }
    .ip-tbl th { text-align: left; color: var(--sub); font-weight: 700; padding: 9px 10px; border-bottom: 1px solid var(--line); white-space: nowrap; font-size: 11.5px; }
    .ip-tbl td { padding: 10px; border-bottom: 1px solid var(--hairline); color: var(--ink); vertical-align: middle; }
    .ip-tbl td.mono, .ip-tbl .mono { font-family: var(--mono); font-size: 12px; color: var(--sub); }
    .ip-tbl tbody tr:hover td { background: color-mix(in srgb, var(--accent) 5%, transparent); }
    .ip-id { font-weight: 800; color: var(--ink); }
    .ip-path { font-family: var(--mono); font-size: 11px; color: var(--sub); margin-top: 12px; word-break: break-all; opacity: .85; }
</style>

@code {
    private List<InstallInfo> _installs = new();
    protected override void OnInitialized() => Refresh();
    private void Refresh() => _installs = Install.All();
}
