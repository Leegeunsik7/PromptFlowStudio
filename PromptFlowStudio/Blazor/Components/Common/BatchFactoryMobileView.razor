@* [PromptFlow Studio v5.8.0] B2B 대량 양산 팩토리(모바일) — 프롬프트 템플릿 변수 치환 미리보기 + 일괄 렌더 가동/모니터링.
   ⚠ 무주입(모바일 안전): [Parameter]/EventCallback 만. BatchTemplateEngine(순수 BCL) 사용 · 실행은 부모 파이프라인이 담당. *@

<div class="bfm">
    <div class="bfm-head">
        <span class="bfm-title">🏭 B2B 대량 양산 팩토리</span>
        <span class="bfm-badge">@_items.Count 건 대기</span>
    </div>

    <div class="bfm-field">
        <label>프롬프트 템플릿 <span class="hint">{target}/{location}/{style} 치환</span></label>
        <input type="text" class="bfm-in" @bind="_template" @bind:event="oninput" @bind:after="Rebuild" disabled="@IsRunning"
               placeholder="예: {target}이(가) {location}을 달리는 시네마틱 4K" />
    </div>

    <div class="bfm-field">
        <label>변수 목록 <span class="hint">줄바꿈 구분 · 콤마=열({target},{location},{style})</span></label>
        <textarea class="bfm-ta" rows="3" @bind="_rawVariables" @bind:event="oninput" @bind:after="Rebuild" disabled="@IsRunning"
                  placeholder="골든리트리버, 노을 해변&#10;사이버펑크 스포츠카, 도심 야경&#10;우주비행사, 달 표면"></textarea>
    </div>

    @* 치환 미리보기 스택 *@
    <div class="bfm-preview">
        <span class="bfm-preview-lbl">생성 큐 미리보기 (@_items.Count)</span>
        @if (_items.Count == 0)
        {
            <div class="bfm-empty">템플릿과 변수 목록을 입력하면 큐가 미리 구성됩니다.</div>
        }
        else
        {
            @foreach (var item in _items)
            {
                <div class="bfm-item" @key="item.Index">
                    <span class="no">#@item.Index</span>
                    <span class="val">@item.VariableValue</span>
                    <span class="prompt">@item.InterpolatedPrompt</span>
                </div>
            }
        }
    </div>

    @* 전체 진행률 프로그레스(부모 파이프라인 실행 중) *@
    @if (IsRunning)
    {
        <div class="bfm-run">
            <div class="bfm-run-track"><div class="bfm-run-bar" style="width:@ProgressPercent%"></div></div>
            <span class="bfm-run-step">@(string.IsNullOrWhiteSpace(LiveStep) ? "가동 중…" : LiveStep)</span>
        </div>
    }

    <button type="button" class="bfm-run-btn" @onclick="StartBatch" disabled="@(IsRunning || _items.Count == 0)">
        @(IsRunning ? "⏳ 양산 진행 중…" : $"🚀 대량 양산 일괄 가동 ({_items.Count}건)")
    </button>
</div>

@code {
    /// <summary>대량 양산 실행 요청 — 부모(MobileStudioDeck)가 세그먼트 큐로 순차 렌더.</summary>
    [Parameter] public EventCallback<List<BatchTemplateItem>> OnStartBatchRequest { get; set; }
    /// <summary>부모 파이프라인 실행 중(입력/버튼 잠금 + 진행바 표출).</summary>
    [Parameter] public bool IsRunning { get; set; }
    /// <summary>전체 진행률(0~100).</summary>
    [Parameter] public int ProgressPercent { get; set; }
    /// <summary>현재 렌더 중 배치 라이브 메시지.</summary>
    [Parameter] public string? LiveStep { get; set; }

    private string _template = "{target}이(가) {location}을 달리는 시네마틱 4K 영상, 일관된 브랜드 톤";
    private string _rawVariables = "골든리트리버, 노을 해변\n사이버펑크 스포츠카, 도심 야경\n우주비행사, 달 표면";
    private List<BatchTemplateItem> _items = new();

    protected override void OnInitialized() => Rebuild();

    private void Rebuild() => _items = BatchTemplateEngine.GenerateBatchItems(_template, _rawVariables);

    private async Task StartBatch()
    {
        if (_items.Count > 0 && OnStartBatchRequest.HasDelegate)
            await OnStartBatchRequest.InvokeAsync(_items);
    }
}

<style>
