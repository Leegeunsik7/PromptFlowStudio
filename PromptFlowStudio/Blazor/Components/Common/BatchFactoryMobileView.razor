    .bfm-run-bar { height: 100%; border-radius: 6px; background: linear-gradient(90deg,#38bdf8,#a855f7); transition: width .2s ease; }
    .bfm-run-step { font: 700 10.5px Pretendard,'Malgun Gothic',sans-serif; color: #7dd3fc; word-break: keep-all; }
    .bfm-run-btn { margin-top: 2px; font: 800 13px Pretendard,'Malgun Gothic',sans-serif; color: #fff; background: linear-gradient(135deg,#38bdf8,#a855f7); border: none; border-radius: 14px; padding: 12px; cursor: pointer; }
    .bfm-run-btn:disabled { opacity: .5; cursor: not-allowed; }
</style>
