    .bfm-field { display: flex; flex-direction: column; gap: 6px; }
    .bfm-field label { font: 700 11.5px Pretendard,'Malgun Gothic',sans-serif; color: #94a3b8; display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap; }
    .bfm-field .hint { font: 600 9.5px ui-monospace,monospace; color: #64748b; }
    .bfm-in, .bfm-ta { width: 100%; box-sizing: border-box; background: #121826; border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; color: #fff; padding: 9px 12px; font: 600 12.5px Pretendard,'Malgun Gothic',sans-serif; outline: none; resize: vertical; line-height: 1.5; }
    .bfm-in:focus, .bfm-ta:focus { border-color: #38bdf8; }
    .bfm-in:disabled, .bfm-ta:disabled { opacity: .55; }
    .bfm-preview { display: flex; flex-direction: column; gap: 6px; background: #0b0f19; border: 1px solid rgba(255,255,255,0.06); padding: 10px; border-radius: 12px; max-height: 190px; overflow-y: auto; }
    .bfm-preview-lbl { font: 800 10px ui-monospace,monospace; color: #64748b; }
    .bfm-empty { font: 600 11px Pretendard,'Malgun Gothic',sans-serif; color: #64748b; padding: 8px 2px; }
    .bfm-item { display: flex; align-items: center; gap: 8px; font: 600 11px Pretendard,'Malgun Gothic',sans-serif; background: #161d2f; padding: 6px 10px; border-radius: 8px; }
    .bfm-item .no { flex: 0 0 auto; color: #38bdf8; font-weight: 800; }
    .bfm-item .val { flex: 0 0 auto; max-width: 92px; color: #34d399; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
