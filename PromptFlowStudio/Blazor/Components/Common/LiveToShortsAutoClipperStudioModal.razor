@using System.Globalization
@using PromptFlowStudio.Services.LiveClipper
@using PromptFlowStudio.Services.KineticBRoll
@implements IDisposable
@inject LiveToShortsAutoClipperStudioRunner Runner

@* [PromptFlow Studio v17.84.0] ⚡ 실시간 라이브 킬러클립 오토 클리퍼 — 클라이맥스 스파이크 센서 게이지 · 120 s 타임라인 프리뷰 스트립 · Punch In/Out · 9:16 숏폼 패키징/원클릭 배포. *@
<div class="clp-scrim" @onclick="Close">
    <div class="clp-modal" @onclick:stopPropagation="true">
        <div class="clp-h">
            <div>
                <div class="clp-title">⚡ 실시간 라이브 킬러클립 오토 클리퍼 @(Runner.Running ? "· 🔴 감시 중" : null)</div>
                <div class="clp-sub">라이브 방송의 <b>최근 120초</b>를 디스크에 저장하지 않고 메모리에 계속 보관합니다. 채팅이 평소보다 3배 이상 빨라지거나, 후원이 들어오거나, 환호·웃음이 터지거나,
                    아바타 표정이 놀람/흥분으로 바뀌는 순간을 1초마다 채점해 <b>0.85점</b>을 넘으면 그 직전 20초 + 직후 15초를 자동으로 잘라냅니다.
                    잘라낸 클립은 방송 화질에 영향을 주지 않는 뒷단에서 9:16 세로 화면·키네틱 자막·효과음까지 입혀 바로 배포할 수 있게 준비됩니다.</div>
            </div>
            <button class="clp-x" @onclick="Close">✕</button>
        </div>

        <div class="clp-body">
            <div class="clp-bar">
                <button class="clp-btn @(Runner.Running ? "on" : null)" @onclick="Toggle">@(Runner.Running ? "⏸ 감시 정지" : "▶ 오토 클리퍼 가동")</button>
                <button class="clp-btn" @onclick="() => Advance(10)">⏩ 10초 전진</button>
                <button class="clp-btn hot" @onclick="Hype">🔥 하이라이트 상황 연출</button>
                <span class="clp-sep"></span>
                <button class="clp-btn punch @(Runner.PunchActive ? "rec" : null)" @onclick="Punch">@(Runner.PunchActive ? "⬛ Punch Out (" + Runner.PunchSec.ToString("0", CultureInfo.InvariantCulture) + "초)" : "🔴 Punch In")</button>
                <button class="clp-btn" @onclick="Instant">⚡ 즉석 클립(직전 30초)</button>
                <button class="clp-btn" @onclick="ResetAll">♻ 초기화</button>
            </div>
            <div class="clp-bar">
                <label class="clp-lbl"><input type="checkbox" checked="@(Runner.DetectorEnabled)" @onchange="ToggleDetector" /> 자동 스파이크 감지</label>
                <label class="clp-lbl"><input type="checkbox" checked="@(Runner.AutoHype)" @onchange="ToggleAutoHype" /> 50초마다 자동 연출(리허설)</label>
                @if (Runner.LinkAvailable)
                {
                    <label class="clp-lbl"><input type="checkbox" checked="@(Runner.Linked)" @onchange="ToggleLink" /> 📡 v17.83 라이브 송출 연동</label>
                }
                <label class="clp-lbl">자막 스타일
                    <select value="@(((int)Runner.Packager.Preset).ToString(CultureInfo.InvariantCulture))" @onchange="SetPreset">
                        @for (var p = 0; p < 3; p++)
                        {
                            var pp = p;
                            <option value="@(pp.ToString(CultureInfo.InvariantCulture))">@(WordByWordKineticSubtitleEngine.PresetName((HormoziPreset)pp))</option>
                        }
                    </select>
                </label>
            </div>

            <div class="clp-main">
                <div class="clp-card">
                    <div class="clp-sec">📈 클라이맥스 스파이크 센서</div>
                    @{ var last = Runner.Detector.Last; }
                    <div class="clp-gauge">
                        <svg viewBox="0 0 160 100" width="160" height="100">
                            <path d="M20 88 A60 60 0 0 1 140 88" fill="none" stroke="#1e293b" stroke-width="12" />
                            <path d="@(Arc(last.Score))" fill="none" stroke="@(last.Score >= MultimodalClimaxSpikeDetector.Threshold ? "#f43f5e" : last.Score >= 0.5f ? "#fbbf24" : "#38bdf8")" stroke-width="12" stroke-linecap="round" />
                            <g><text x="80" y="76" text-anchor="middle" fill="#e2e8f0" font-size="20" font-weight="800">@(last.Score.ToString("0.00", CultureInfo.InvariantCulture))</text></g>
                            <g><text x="80" y="94" text-anchor="middle" fill="#94a3b8" font-size="9">복합 스코어 · 임계 0.85</text></g>
                        </svg>
                    </div>
                    <div class="clp-sig"><span>💬 채팅 가속도</span><div class="clp-meter"><i style="width:@(Pct(last.Chat))%"></i></div><b>@(last.ChatRatio.ToString("0.0", CultureInfo.InvariantCulture))×</b></div>
                    <div class="clp-sig"><span>💸 후원</span><div class="clp-meter"><i class="don" style="width:@(Pct(last.Donation))%"></i></div><b>₩@(last.DonationKrw.ToString("#,0", CultureInfo.InvariantCulture))</b></div>
                    <div class="clp-sig"><span>🔊 환호/웃음</span><div class="clp-meter"><i class="aud" style="width:@(Pct(last.Audio))%"></i></div><b>@(last.RmsDb.ToString("0", CultureInfo.InvariantCulture)) dB</b></div>
                    <div class="clp-sig"><span>@(MultimodalClimaxSpikeDetector.EmotionIcon(Runner.Detector.Emotion)) 감정 급변</span><div class="clp-meter"><i class="emo" style="width:@(Pct(last.Emotion))%"></i></div><b>@(MultimodalClimaxSpikeDetector.EmotionName(Runner.Detector.Emotion))</b></div>
                    <div class="clp-kv">고역 비 <b>@(last.HfRatio.ToString("0.00", CultureInfo.InvariantCulture))</b> · 채팅 <b>@(last.ChatCount)</b>/s · 최고 <b>@(Runner.Detector.PeakScore.ToString("0.00", CultureInfo.InvariantCulture))</b></div>
                    <div class="clp-kv">스파이크 <b>@(Runner.Detector.Triggers)</b> · 중복 억제 <b>@(Runner.Detector.Suppressed)</b> · 녹화 대기 <b>@(Runner.Detector.PendingCount)</b> · 하이라이트 <b>@(Runner.Hypes)</b>@(Runner.HypeActive ? " 🔥" : null)</div>
                </div>

                <div class="clp-card">
                    <div class="clp-sec">🎞️ 120초 타임라인 프리뷰</div>
                    <svg viewBox="0 0 240 80" preserveAspectRatio="none" class="clp-strip">
                        @for (var i = 0; i < Runner.Packager.ResultCount; i++)
                        {
                            var r = Runner.Packager.Result(i);
                            var x0 = X(r.StartUs); var x1 = X(r.EndUs);
                            if (x1 > 0)
                            {
                                <rect x="@(F(Math.Max(0f, x0)))" y="0" width="@(F(Math.Max(1f, x1 - Math.Max(0f, x0))))" height="80" fill="@(r.Manual ? "#7c3aed" : "#be123c")" opacity="0.28" />
                            }
                        }
                        @for (var i = 0; i < Runner.Detector.PendingCount; i++)
                        {
                            var c = Runner.Detector.Pending(i);
                            var x0 = Math.Max(0f, X(c.StartUs));
                            <rect x="@(F(x0))" y="0" width="@(F(Math.Max(1f, Math.Min(240f, X(c.EndUs)) - x0)))" height="80" fill="none" stroke="#fbbf24" stroke-dasharray="3 2" />
                        }
                        <line x1="0" x2="240" y1="@(F(78f - 76f * MultimodalClimaxSpikeDetector.Threshold))" y2="@(F(78f - 76f * MultimodalClimaxSpikeDetector.Threshold))" stroke="#f43f5e" stroke-width="0.6" stroke-dasharray="4 2" />
                        <polyline points="@(Spark())" fill="none" stroke="#38bdf8" stroke-width="1.4" />
                    </svg>
                    <div class="clp-legend"><span class="lg auto"></span>자동 클립 <span class="lg man"></span>수동 클립 <span class="lg pend"></span>녹화 대기 <span class="lg thr"></span>임계 0.85</div>
                    <div class="clp-sec sm">⏪ 인메모리 롤링 링버퍼</div>
                    <div class="clp-fill"><i style="width:@(Pct(Runner.Ring.Fill))%"></i></div>
                    <div class="clp-grid">
                        <span>보관 <b>@((Runner.Ring.SpanUs / 1e6).ToString("0.0", CultureInfo.InvariantCulture))s</b></span>
                        <span>프레임 <b>@(Runner.Ring.Frames)</b></span>
                        <span>IDR 인덱스 <b>@(Runner.Ring.Keyframes)</b></span>
                        <span>용량 <b>@((Runner.Ring.Capacity / 1048576.0).ToString("0", CultureInfo.InvariantCulture))MB</b></span>
                        <span>축출 <b>@(Runner.Ring.Evicted)</b></span>
                        <span>슬라이스 <b>@(Runner.Ring.Slices)</b></span>
                        <span>기록 <b>@(Runner.Ring.MaxWriteUs.ToString("0", CultureInfo.InvariantCulture))µs</b></span>
                        <span>소스 <b>@(Runner.Linked ? "v17.83 송출" : "리허설")</b></span>
                    </div>
                    <div class="clp-kv">라이브 틱 <b>@(Runner.LastTickUs.ToString("0", CultureInfo.InvariantCulture))µs</b> (최대 <b>@(Runner.MaxTickUs.ToString("0", CultureInfo.InvariantCulture))</b>) · 16.7ms 초과 <b class="@(Runner.BudgetMisses > 0 ? "warn" : null)">@(Runner.BudgetMisses)</b> · 큐 투입 <b>@(Runner.Packager.MaxEnqueueUs.ToString("0", CultureInfo.InvariantCulture))µs</b> · 핫패스 간섭 <b class="@(Runner.Packager.HotPathInterference > 0 ? "warn" : "okc")">@(Runner.Packager.HotPathInterference)</b></div>
                </div>

                <div class="clp-card">
                    <div class="clp-sec">📦 9:16 숏폼 패키징 큐
                        <button class="clp-btn sm" @onclick="DispatchAll">🚀 전체 원클릭 배포</button>
                    </div>
                    <div class="clp-kv">대기 <b>@(Runner.Packager.Queued)</b> · 완료 <b>@(Runner.Packager.Packaged)</b> · 배포 <b>@(Runner.Packager.Dispatched)</b> · 만료 <b>@(Runner.Packager.Expired)</b> · 실패 <b>@(Runner.Packager.Failed)</b> · 워커 <b>@(Runner.Packager.WorkerRunning ? "BelowNormal ▶" : "정지")</b></div>
                    <div class="clp-list">
                        @if (Runner.Packager.ResultCount == 0)
                        {
                            <div class="clp-empty">아직 클립이 없습니다 — 🔥 하이라이트 연출 후 15초 뒤 자동으로 생성됩니다.</div>
                        }
                        @for (var i = 0; i < Math.Min(10, Runner.Packager.ResultCount); i++)
                        {
                            var r = Runner.Packager.Result(i);
                            var rid = r.Id;
                            <div class="clp-item @(r.Status == ShortStatus.Ready ? "ready" : r.Status == ShortStatus.Dispatched ? "sent" : r.Status is ShortStatus.Expired or ShortStatus.Failed ? "bad" : null)">
                                <div class="clp-thumb"><span style="left:@(F(r.CropX * 100f / InstantShortsPackagingPipelineGuard.SrcW))%"></span></div>
                                <div class="clp-meta">
                                    <div><b>#@(r.Id)</b> @(r.Manual ? "✋ 수동" : "🤖 자동") · <b>@(r.Seconds.ToString("0.0", CultureInfo.InvariantCulture))s</b> · 스코어 <b>@(r.Score.ToString("0.00", CultureInfo.InvariantCulture))</b> · <span class="clp-st">@(InstantShortsPackagingPipelineGuard.StatusName(r.Status))</span></div>
                                    <div class="clp-cap">“@(InstantShortsPackagingPipelineGuard.Captions[r.Caption])” · @(WordByWordKineticSubtitleEngine.PresetName(r.Preset))</div>
                                    <div class="clp-mini">크롭 x=@(r.CropX) · 자막 @(r.Verdict) · 효과음 @(r.Cues)개(피크 @(r.ImpactPeak.ToString("0.00", CultureInfo.InvariantCulture))) · @(r.Decodable ? "IDR ✓" : "IDR ✗") · @((r.Bytes / 1024.0).ToString("0", CultureInfo.InvariantCulture))KB · @(r.PackMs.ToString("0.0", CultureInfo.InvariantCulture))ms</div>
                                    @if (r.Status == ShortStatus.Dispatched)
                                    {
                                        <div class="clp-mini">▶️ Shorts @(When(r.YtAtUnix)) · 📸 Reels @(When(r.IgAtUnix))</div>
                                    }
                                </div>
                                @if (r.Status == ShortStatus.Ready)
                                {
                                    <button class="clp-btn sm" @onclick="() => DispatchOne(rid)">🚀 배포</button>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="clp-act">@(Runner.LastAction ?? "대기") · @(Runner.Summary())</div>
    </div>
</div>

<style>
    .clp-scrim { position: fixed; inset: 0; z-index: var(--z-studio-modal); background: rgba(0,0,0,.62); display: flex; align-items: center; justify-content: center; }
    .clp-modal { width: min(1320px, 96vw); max-height: 94vh; display: flex; flex-direction: column; overflow: hidden; background: var(--card); border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 20px 60px rgba(0,0,0,.45); color: var(--text-primary); }
    .clp-h { position: sticky; top: 0; z-index: 3; flex: 0 0 auto; display: flex; justify-content: space-between; gap: 12px; padding: 14px 16px 8px; background: var(--card); border-bottom: 1px solid var(--line); }
    .clp-body { flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 0 16px 10px; }
    .clp-act { position: sticky; bottom: 0; z-index: 3; flex: 0 0 auto; padding: 8px 16px 14px; background: var(--card); border-top: 1px solid var(--line); font-size: 11px; color: var(--text-muted); }
    .clp-title { font-size: 17px; font-weight: 800; }
    .clp-sub { font-size: 11.5px; color: var(--text-muted); margin-top: 4px; line-height: 1.5; }
    .clp-x { background: none; border: 0; color: var(--text-muted); font-size: 18px; cursor: pointer; }
    .clp-bar { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin: 8px 0 0; }
    .clp-sep { flex: 1; }
    .clp-lbl { display: inline-flex; gap: 6px; align-items: center; font-size: 11.5px; }
    .clp-lbl select { background: #0f172a; color: var(--text-primary); border: 1px solid var(--line); border-radius: 6px; font-size: 11.5px; padding: 2px 6px; }
    .clp-btn { background: #1e293b; color: var(--text-primary); border: 1px solid var(--line); border-radius: 8px; padding: 5px 10px; font-size: 12px; cursor: pointer; }
    .clp-btn.sm { padding: 2px 8px; font-size: 11px; margin-left: auto; }
    .clp-btn.hot { border-color: #f97316; }
    .clp-btn.on { background: color-mix(in srgb, #38bdf8 25%, #1e293b); border-color: #38bdf8; }
    .clp-btn.punch { border-color: #ef4444; font-weight: 700; }
    .clp-btn.punch.rec { background: #7f1d1d; animation: clp-blink 1s infinite; }
    @@keyframes clp-blink { 50% { opacity: .65; } }
    .clp-main { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr) minmax(0, 1.2fr); gap: 10px; margin-top: 10px; }
    .clp-card { background: #0b1220; border: 1px solid var(--line); border-radius: 10px; padding: 10px; min-width: 0; }
    .clp-sec { font-size: 12.5px; font-weight: 700; margin-bottom: 6px; display: flex; align-items: center; gap: 6px; }
    .clp-sec.sm { margin-top: 10px; font-size: 11.5px; }
    .clp-kv { font-size: 11px; color: var(--text-muted); margin: 4px 0; }
    .clp-kv b { font-family: var(--mono); color: var(--text-primary); }
    .clp-gauge { display: flex; justify-content: center; }
    .clp-sig { display: grid; grid-template-columns: 92px 1fr 70px; gap: 6px; align-items: center; font-size: 11px; margin: 4px 0; }
    .clp-sig b { font-family: var(--mono); text-align: right; }
    .clp-meter { height: 8px; background: #1e293b; border-radius: 4px; overflow: hidden; }
    .clp-meter i { display: block; height: 100%; background: #38bdf8; transition: width .2s; }
    .clp-meter i.don { background: #fde047; } .clp-meter i.aud { background: #4ade80; } .clp-meter i.emo { background: #f472b6; }
    .clp-strip { width: 100%; height: 110px; background: #05070c; border-radius: 6px; }
    .clp-legend { display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: center; font-size: 10px; color: var(--text-muted); margin-top: 3px; }
    .clp-legend .lg { display: inline-block; width: 10px; height: 8px; border-radius: 2px; margin-right: -6px; }
    .lg.auto { background: #be123c; } .lg.man { background: #7c3aed; } .lg.pend { border: 1px dashed #fbbf24; } .lg.thr { border-top: 1px dashed #f43f5e; height: 0 !important; }
    .clp-fill { height: 8px; background: #1e293b; border-radius: 4px; overflow: hidden; }
    .clp-fill i { display: block; height: 100%; background: linear-gradient(90deg, #0ea5e9, #a855f7); }
    .clp-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 3px 6px; margin-top: 6px; font-size: 10.5px; color: var(--text-muted); }
    .clp-grid b { font-family: var(--mono); color: var(--text-primary); }
    .warn { color: #fca5a5 !important; } .okc { color: #86efac !important; }
    .clp-list { display: flex; flex-direction: column; gap: 5px; margin-top: 6px; max-height: 360px; overflow-y: auto; }
    .clp-empty { font-size: 11px; color: var(--text-muted); padding: 10px; text-align: center; }
    .clp-item { display: flex; gap: 8px; align-items: center; background: #0f172a; border-radius: 8px; padding: 6px; border-left: 3px solid #334155; }
    .clp-item.ready { border-left-color: #4ade80; } .clp-item.sent { border-left-color: #38bdf8; } .clp-item.bad { border-left-color: #ef4444; }
    .clp-thumb { position: relative; flex: 0 0 64px; height: 36px; background: linear-gradient(135deg, #1e1b4b, #312e81); border-radius: 4px; overflow: hidden; }
    .clp-thumb span { position: absolute; top: 0; width: 31.6%; height: 100%; border: 1.5px solid #fde047; box-sizing: border-box; }
    .clp-meta { flex: 1; min-width: 0; font-size: 11px; }
    .clp-meta b { font-family: var(--mono); }
    .clp-st { color: #fde047; }
    .clp-cap { color: #fef08a; font-weight: 700; margin: 2px 0; }
    .clp-mini { font-size: 10px; color: var(--text-muted); }
    @@media (max-width: 1100px) { .clp-main { grid-template-columns: 1fr 1fr; } }
    @@media (max-width: 760px) { .clp-main { grid-template-columns: 1fr; } }
</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("LiveClipper.Modal.Timer", ex); }
        }, null, 250, 250);
    }

    private static string F(float v) => v.ToString("0.0", CultureInfo.InvariantCulture);

    private static string Pct(float v) => (Math.Clamp(float.IsFinite(v) ? v : 0f, 0f, 1f) * 100f).ToString("0", CultureInfo.InvariantCulture);

    private float X(long us) => 240f - (Runner.NowUs - us) / (float)RollingCircularVideoBufferEngine.WindowUs * 240f;

    private static string When(long unix) => unix <= 0 ? "-" : DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("MM-dd HH:mm", CultureInfo.InvariantCulture);

    private static string Arc(float frac)
    {
        var f = Math.Clamp(float.IsFinite(frac) ? frac : 0f, 0.001f, 1f);
        var a = MathF.PI * (1f - f);
        var x = 80f + 60f * MathF.Cos(a); var y = 88f - 60f * MathF.Sin(a);
        return "M20 88 A60 60 0 0 1 " + x.ToString("0.0", CultureInfo.InvariantCulture) + " " + y.ToString("0.0", CultureInfo.InvariantCulture);
    }

    private string Spark()
    {
        var n = Runner.Detector.HistCount;
        if (n < 2) return "0,78 240,78";
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = 0; i < n; i++)
        {
            var s = Runner.Detector.HistAt(i);
            var x = Math.Clamp(X(s.AtUs), 0f, 240f); var y = 78f - 76f * Math.Clamp(s.Score, 0f, 1f);
            sb.Append(F(x)).Append(',').Append(F(y)).Append(' ');
        }
        return sb.ToString();
    }

    private void Toggle()
    {
        try { if (Runner.Running) Runner.Stop(); else Runner.Start(); }
        catch (Exception ex) { PromptFlowStudio.Program.Log("LiveClipper.Modal.Toggle", ex); }
    }

    private void Advance(float sec)
    {
        try { Runner.Advance(sec); }
        catch (Exception ex) { PromptFlowStudio.Program.Log("LiveClipper.Modal.Advance", ex); }
    }

    private void Hype()
    {
        try { Runner.TriggerHype(); }
        catch (Exception ex) { PromptFlowStudio.Program.Log("LiveClipper.Modal.Hype", ex); }
    }

    private void Punch()
    {
        try { if (Runner.PunchActive) Runner.PunchOut(); else Runner.PunchIn(); }
        catch (Exception ex) { PromptFlowStudio.Program.Log("LiveClipper.Modal.Punch", ex); }
    }

    private void Instant()
    {
        try { Runner.InstantClip(); }
        catch (Exception ex) { PromptFlowStudio.Program.Log("LiveClipper.Modal.Instant", ex); }
    }

    private void ResetAll()
    {
        try { Runner.Reset(); }
        catch (Exception ex) { PromptFlowStudio.Program.Log("LiveClipper.Modal.Reset", ex); }
    }

    private void DispatchAll()
    {
        try { Runner.DispatchAll(); }
        catch (Exception ex) { PromptFlowStudio.Program.Log("LiveClipper.Modal.DispatchAll", ex); }
    }

    private void DispatchOne(long id)
    {
        try { Runner.Dispatch(id); }
        catch (Exception ex) { PromptFlowStudio.Program.Log("LiveClipper.Modal.Dispatch", ex); }
    }

    private void ToggleDetector(ChangeEventArgs e) => Runner.DetectorEnabled = e.Value is bool b ? b : !Runner.DetectorEnabled;

    private void ToggleAutoHype(ChangeEventArgs e) => Runner.AutoHype = e.Value is bool b ? b : !Runner.AutoHype;

    private void ToggleLink(ChangeEventArgs e) => Runner.Linked = e.Value is bool b ? b : !Runner.Linked;

    private void SetPreset(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var v) && v is >= 0 and <= 2) Runner.Packager.Preset = (HormoziPreset)v;
    }

    private Task Close() => OnClose.InvokeAsync();

    private void OnServiceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
    }
}
