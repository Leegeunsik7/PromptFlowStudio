@using System.Globalization
@using System.Numerics
@using PromptFlowStudio.Services.SpatialAudio
@implements IDisposable
@inject SpatialAudioStudioRunner Runner

@*
    [PromptFlow Studio v16.76.0] 🎧 AI 공간 오디오 & 음향 레이트레이싱 스튜디오 — 3D 음원 위치 트랙패드(탑다운 클릭 + 높이) · 음향 반사 레이/초기 반사 비주얼라이저 ·
    대역별 RT60/폐색 · 에너지 감쇠 곡선 · HRTF 프로필 선택 · 머리 추적(요/피치) · 7.1.4 베드 미터 · 사운드스케이프 프롬프트 · 바이노럴 미리듣기.
*@

<div class="spa-scrim" @onclick="Close">
    <div class="spa-modal" @onclick:stopPropagation="true">
        <div class="spa-h">
            <div>
                <div class="spa-title">🎧 AI 공간 오디오 &amp; 음향 레이트레이싱 스튜디오</div>
                <div class="spa-sub"><b>OpenUSD · 3DGS</b> 공간에서 음선을 추적해 대역별 <b>잔향 · 초기 반사 · 회절 폐색</b>을 산출하고, 절차적 사운드스케이프 객체를
                    <b>7.1.4 VBAP</b> 과 <b>HRTF 바이노럴</b>(머리 추적)로 공간화합니다.</div>
            </div>
            <button class="spa-x" @onclick="Close">✕</button>
        </div>

        <div class="spa-bar">
            <button class="spa-btn @(Runner.IsRunning ? "on" : null)" @onclick="ToggleRun">@(Runner.IsRunning ? "⏸ 렌더 정지" : "▶ 실시간 렌더")</button>
            <button class="spa-btn" @onclick="Preview">🔊 미리듣기 4초(바이노럴)</button>
            @foreach (var p in Enum.GetValues<AcousticRoomPreset>())
            {
                var preset = p;
                <button class="spa-btn @(Runner.Room == preset ? "on" : null)" @onclick="() => Runner.SetRoom(preset)">@(RoomLabel(preset))</button>
            }
            <span class="spa-chip">추적 @(F1(Runner.Raytracer.LastMs))ms · 음선 @(Runner.Raytracer.RayCount) · SIMD @(RealtimeAcousticRaytracingEngine.SimdLanes)레인</span>
            <span class="spa-chip">C50 @(F1(Runner.Raytracer.C50))dB · D50 @(F0(Runner.Raytracer.D50 * 100))%</span>
            <span class="spa-chip @(Runner.Raytracer.LineOfSight ? null : "warn")">@(Runner.Raytracer.LineOfSight ? "가시선" : "폐색 · 우회 " + F2(Runner.Raytracer.DetourMeters) + "m")</span>
        </div>
        @if (_audio is not null)
        {
            <audio class="spa-audio" controls autoplay src="@_audio"></audio>
        }

        <div class="spa-main">
            <div class="spa-col">
                <div class="spa-card">
                    <div class="spa-sec">🎯 3D 음원 트랙패드 — 클릭으로 초점 음원 이동 · 높이 <input type="range" min="0" max="3.4" step="0.1" value="@(F1(_height))" @onchange="e => { _height = P(e); MoveTo(_lastX, _lastZ); }" /> @(F1(_height))m</div>
                    <svg class="spa-pad" viewBox="@ViewBox()" preserveAspectRatio="none" @onclick="OnPad">
                        <rect x="@(F2(_min.X))" y="@(F2(_min.Z))" width="@(F2(_max.X - _min.X))" height="@(F2(_max.Z - _min.Z))" class="room" />
                        @for (var r = 0; r < RealtimeAcousticRaytracingEngine.VisRays; r++)
                        {
                            var n = Runner.Raytracer.VisPointCount(r);
                            for (var k = 1; k < n; k++)
                            {
                                var a = Runner.Raytracer.VisPoint(r, k - 1); var b = Runner.Raytracer.VisPoint(r, k);
                                <line x1="@(F2(a.X))" y1="@(F2(a.Z))" x2="@(F2(b.X))" y2="@(F2(b.Z))" class="ray" style="opacity:@(F2(1f - k / 9f))" />
                            }
                        }
                        @for (var k = 0; k < Runner.Raytracer.ReflectionCount; k++)
                        {
                            var refl = Runner.Raytracer.Reflection(k);
                            if (refl.Order != 1) continue;
                            var lp = Runner.Listener; var end = lp + refl.Direction * 1.2f;
                            <line x1="@(F2(lp.X))" y1="@(F2(lp.Z))" x2="@(F2(end.X))" y2="@(F2(end.Z))" class="er" />
                        }
                        @for (var i = 0; i < Runner.Soundscape.ObjectCount; i++)
                        {
                            if (!Runner.Soundscape.IsActive(i)) continue;
                            var p = Runner.Soundscape.Position(i); var idx = i;
                            <g>
                                <circle cx="@(F2(p.X))" cy="@(F2(p.Z))" r="0.28" class="obj @(idx == Runner.Focus ? "focus" : null)" @onclick="() => Runner.SetFocus(idx)" @onclick:stopPropagation="true" />
                                <text x="@(F2(p.X + 0.35f))" y="@(F2(p.Z + 0.1f))">@(Runner.Soundscape.Name(idx))</text>
                            </g>
                        }
                        <g transform="translate(@(F2(Runner.Listener.X)),@(F2(Runner.Listener.Z))) rotate(@(F0(-Runner.HeadYaw)))">
                            <circle r="0.3" class="head" />
                            <path d="M0,-0.55 L0.15,-0.25 L-0.15,-0.25 Z" class="nose" />
                        </g>
                    </svg>
                    <div class="spa-legend"><span><i class="ray"></i>음선 경로</span><span><i class="er"></i>1차 반사 도래 방향</span><span><i class="focus"></i>초점 음원(추적 대상)</span></div>
                </div>

                <div class="spa-card">
                    <div class="spa-sec">📉 대역별 잔향 · 폐색 · 감쇠 곡선</div>
                    <div class="spa-bands">
                        @for (var b = 0; b < AcousticBands.Count; b++)
                        {
                            var rt60 = Runner.Raytracer.Rt60(b);
                            <div>
                                <span class="rt" style="height:@(F0(Math.Clamp(rt60 / 4f, 0f, 1f) * 100))%"></span>
                                <span class="oc" style="height:@(F0(Runner.Raytracer.Occlusion(b) * 100))%"></span>
                                <em>@(AcousticBands.Names[b])</em><b>@(F2(rt60))s</b>
                            </div>
                        }
                    </div>
                    <svg class="spa-edc" viewBox="0 -60 2000 62" preserveAspectRatio="none">
                        @foreach (var b in new[] { 1, 3, 5, 7 })
                        {
                            <polyline points="@EdcPoints(b)" class="@($"b{b}")" />
                        }
                    </svg>
                    <div class="spa-note">감쇠 곡선(EDC 0~−60 dB · 0~2 s): 250 · 1k · 4k · 25k(초음파) · 막대: RT60(파랑) / 폐색 투과(주황)</div>
                </div>
            </div>

            <div class="spa-col">
                <div class="spa-card">
                    <div class="spa-sec">👂 HRTF · 머리 추적</div>
                    <div class="spa-row">
                        @foreach (var p in Enum.GetValues<HrtfProfile>())
                        {
                            var prof = p;
                            <button class="spa-btn @(Runner.Hrtf.Profile == prof ? "on" : null)" @onclick="() => Runner.Hrtf.SetProfile(prof, _customRadius / 100f, _customPinna)">@(ProfileLabel(prof))</button>
                        }
                    </div>
                    @if (Runner.Hrtf.Profile == HrtfProfile.Custom)
                    {
                        <div class="spa-row">
                            <label class="spa-slider"><span>머리 반경 <b>@(F1(_customRadius))cm</b></span><input type="range" min="6" max="12" step="0.1" value="@(F1(_customRadius))" @onchange="e => { _customRadius = P(e); Runner.Hrtf.SetProfile(HrtfProfile.Custom, _customRadius / 100f, _customPinna); }" /></label>
                            <label class="spa-slider"><span>귀바퀴 배율 <b>@(F2(_customPinna))</b></span><input type="range" min="0.7" max="1.4" step="0.01" value="@(F2(_customPinna))" @onchange="e => { _customPinna = P(e); Runner.Hrtf.SetProfile(HrtfProfile.Custom, _customRadius / 100f, _customPinna); }" /></label>
                        </div>
                    }
                    <div class="spa-row">
                        <label class="spa-slider"><span>머리 요 <b>@(F0(Runner.HeadYaw))°</b></span><input type="range" min="-180" max="180" step="5" value="@(F0(Runner.HeadYaw))" @oninput="e => Runner.SetHead(P(e), Runner.HeadPitch)" /></label>
                        <label class="spa-slider"><span>머리 피치 <b>@(F0(Runner.HeadPitch))°</b></span><input type="range" min="-60" max="60" step="5" value="@(F0(Runner.HeadPitch))" @oninput="e => Runner.SetHead(Runner.HeadYaw, P(e))" /></label>
                    </div>
                    <div class="spa-note">반경 @(F1(Runner.Hrtf.HeadRadius * 100))cm · 최대 ITD @(F2(Runner.Hrtf.HeadRadius / 343f * (1 + MathF.PI / 2) * 1000))ms · 귀바퀴 노치 @(F1(6.5f * Runner.Hrtf.PinnaScale))kHz(수평)</div>
                    <div class="spa-lr">
                        <div><span>L</span><i style="width:@(Meter(Runner.RmsL))%"></i><b>@(Db(Runner.RmsL))</b></div>
                        <div><span>R</span><i style="width:@(Meter(Runner.RmsR))%"></i><b>@(Db(Runner.RmsR))</b></div>
                    </div>
                    <label class="spa-tg"><input type="checkbox" checked="@Runner.VirtualizeBed" @onchange="e => Runner.VirtualizeBed = e.Value is true" /> 7.1.4 베드 가상화(Atmos 바이노럴) — 끄면 객체별 HRTF + 초기 반사</label>
                </div>

                <div class="spa-card">
                    <div class="spa-sec">🔈 7.1.4 객체 패닝 베드</div>
                    <div class="spa-bed">
                        @for (var c = 0; c < 12; c++)
                        {
                            <div><i style="height:@(Meter(Runner.Soundscape.Meter(c)))%"></i><em>@(NeuralBinauralHrtfSpatializer.BedNames[c])</em></div>
                        }
                    </div>
                    <div class="spa-note">Atmos 객체 메타데이터 @(Runner.Soundscape.MetadataCount)프레임 · 잔향 송출 @(F0(Runner.Soundscape.ReverbSend * 100))% · LFE @(F0(Runner.Soundscape.LfeSend * 100))%</div>
                </div>

                <div class="spa-card">
                    <div class="spa-sec">🌲 제너레이티브 사운드스케이프</div>
                    <div class="spa-row">
                        <input class="spa-in" @bind="_prompt" placeholder="예: 새소리 가득한 숲 / 비 오는 도시 거리 / 바다 / 카페 / 캠프파이어" />
                        <button class="spa-btn on" @onclick="ApplyPrompt">생성</button>
                    </div>
                    <div class="spa-objs">
                        @for (var i = 0; i < Runner.Soundscape.ObjectCount; i++)
                        {
                            if (!Runner.Soundscape.IsActive(i)) continue;
                            var idx = i; var p = Runner.Soundscape.Position(i);
                            <div class="@(idx == Runner.Focus ? "focus" : null)" @onclick="() => Runner.SetFocus(idx)">
                                <b>@(Runner.Soundscape.Name(idx))</b><em>@(Runner.Soundscape.KindOf(idx)) · (@(F1(p.X)), @(F1(p.Y)), @(F1(p.Z)))</em>
                                <input type="range" min="0" max="1.5" step="0.05" value="@(F2(Runner.Soundscape.Gain(idx)))" @onchange="e => Runner.Soundscape.SetGain(idx, P(e))" @onclick:stopPropagation="true" />
                            </div>
                        }
                    </div>
                </div>
                <div class="spa-note">@(Runner.LastAction ?? "대기") · 실 오디오 장치 출력 미결선(미리듣기는 브라우저 재생)</div>
            </div>
        </div>
    </div>
</div>

<style>
    .spa-scrim { position: fixed; inset: 0; z-index: var(--z-studio-modal); background: rgba(0,0,0,.62); display: flex; align-items: center; justify-content: center; padding: 20px; }
    .spa-modal { width: min(1600px, 97vw); max-height: 94vh; display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--line); border-radius: 18px; box-shadow: 0 24px 60px rgba(0,0,0,.45); overflow: hidden; }
    .spa-h { display: flex; justify-content: space-between; gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--line); background: linear-gradient(120deg, color-mix(in srgb, #14b8a6 18%, var(--card)), color-mix(in srgb, #8b5cf6 14%, var(--card))); }
    .spa-title { font-size: 17px; font-weight: 900; color: var(--text-primary); }
    .spa-sub { font-size: 12px; color: var(--text-secondary); margin-top: 4px; line-height: 1.5; }
    .spa-sub b { color: var(--text-primary); }
    .spa-x { background: none; border: none; color: var(--text-muted); font-size: 18px; cursor: pointer; border-radius: 8px; }
    .spa-bar { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 20px; border-bottom: 1px solid var(--line); align-items: center; }
    .spa-audio { margin: 6px 20px 0; height: 32px; }
    .spa-btn { font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 8px; border: 1px solid var(--line); background: transparent; color: var(--text-primary); cursor: pointer; }
    .spa-btn.on { background: color-mix(in srgb, #14b8a6 24%, transparent); border-color: #14b8a6; }
    .spa-chip { font: 700 11px var(--mono); padding: 4px 9px; border-radius: 999px; border: 1px solid var(--line); color: var(--text-secondary); }
    .spa-chip.warn { border-color: #f97316; color: #fdba74; }
    .spa-main { display: grid; grid-template-columns: 1.2fr 1fr; gap: 14px; padding: 14px 20px; min-height: 0; flex: 1; overflow-y: auto; }
    .spa-col { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
    .spa-card { border: 1px solid var(--line); border-radius: 12px; padding: 12px; display: flex; flex-direction: column; gap: 8px; }
    .spa-sec { font-weight: 800; font-size: 13px; color: var(--text-primary); display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .spa-sec input { width: 120px; accent-color: #14b8a6; }
    .spa-pad { width: 640px; max-width: 100%; height: 380px; border-radius: 10px; background: #0b1220; cursor: crosshair; }
    .spa-pad .room { fill: #111a2e; stroke: #334155; stroke-width: .05; }
    .spa-pad .ray { stroke: #2dd4bf; stroke-width: .03; } .spa-pad .er { stroke: #facc15; stroke-width: .05; stroke-dasharray: .12 .08; }
    .spa-pad .obj { fill: #8b5cf6; opacity: .8; cursor: pointer; } .spa-pad .obj.focus { fill: #f472b6; stroke: #fff; stroke-width: .05; }
    .spa-pad text { font-size: .32px; fill: #cbd5e1; } .spa-pad .head { fill: #e2e8f0; } .spa-pad .nose { fill: #f97316; }
    .spa-legend { display: flex; gap: 12px; font-size: 10.5px; color: var(--text-muted); }
    .spa-legend i { display: inline-block; width: 14px; height: 3px; margin-right: 4px; vertical-align: middle; } .spa-legend i.ray { background: #2dd4bf; } .spa-legend i.er { background: #facc15; } .spa-legend i.focus { background: #f472b6; }
    .spa-bands { display: grid; grid-template-columns: repeat(8, 1fr); gap: 6px; height: 120px; }
    .spa-bands div { position: relative; display: flex; align-items: flex-end; gap: 2px; background: #0f172a; border-radius: 4px; padding: 0 3px 28px; }
    .spa-bands .rt { flex: 1; background: #38bdf8; border-radius: 2px; } .spa-bands .oc { flex: 1; background: #fb923c; border-radius: 2px; }
    .spa-bands em { position: absolute; bottom: 14px; left: 0; right: 0; text-align: center; font: 700 10px var(--mono); color: #94a3b8; font-style: normal; }
    .spa-bands b { position: absolute; bottom: 1px; left: 0; right: 0; text-align: center; font: 700 10px var(--mono); color: var(--text-primary); }
    .spa-edc { width: 100%; height: 90px; background: #0b1220; border-radius: 8px; }
    .spa-edc polyline { fill: none; stroke-width: 8; vector-effect: non-scaling-stroke; } .spa-edc .b1 { stroke: #60a5fa; } .spa-edc .b3 { stroke: #34d399; } .spa-edc .b5 { stroke: #fbbf24; } .spa-edc .b7 { stroke: #f472b6; }
    .spa-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .spa-slider { display: flex; flex-direction: column; gap: 2px; font-size: 11px; color: var(--text-secondary); min-width: 140px; flex: 1; }
    .spa-slider b { color: var(--text-primary); font-family: var(--mono); } .spa-slider input { width: 100%; accent-color: #14b8a6; }
    .spa-tg { font-size: 11.5px; color: var(--text-secondary); display: flex; gap: 4px; align-items: center; }
    .spa-lr div { display: grid; grid-template-columns: 16px 1fr 56px; gap: 6px; align-items: center; font: 700 11px var(--mono); color: var(--text-secondary); margin-top: 3px; }
    .spa-lr i { display: block; height: 8px; background: linear-gradient(90deg, #22c55e, #facc15 75%, #ef4444); border-radius: 4px; }
    .spa-bed { display: grid; grid-template-columns: repeat(12, 1fr); gap: 4px; height: 90px; }
    .spa-bed div { position: relative; display: flex; align-items: flex-end; background: #0f172a; border-radius: 4px; padding-bottom: 16px; }
    .spa-bed i { width: 100%; background: #14b8a6; border-radius: 2px; } .spa-bed em { position: absolute; bottom: 1px; left: 0; right: 0; text-align: center; font: 700 9px var(--mono); color: #94a3b8; font-style: normal; }
    .spa-in { flex: 1; min-width: 160px; font-size: 12px; padding: 5px 8px; border-radius: 8px; border: 1px solid var(--line); background: var(--card); color: var(--text-primary); }
    .spa-objs { display: flex; flex-direction: column; gap: 4px; max-height: 220px; overflow-y: auto; }
    .spa-objs div { display: grid; grid-template-columns: 90px 1fr 110px; gap: 6px; align-items: center; font-size: 11px; color: var(--text-secondary); padding: 3px 6px; border: 1px solid var(--line); border-radius: 6px; cursor: pointer; }
    .spa-objs div.focus { border-color: #f472b6; } .spa-objs b { color: var(--text-primary); } .spa-objs em { font-style: normal; font-family: var(--mono); font-size: 10px; } .spa-objs input { accent-color: #14b8a6; }
    .spa-note { font-size: 11px; color: var(--text-muted); }
    @@media (max-width: 1200px) { .spa-main { grid-template-columns: 1fr; } }
</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private Vector3 _min, _max;
    private float _height = 1.6f, _lastX, _lastZ, _customRadius = 8.75f, _customPinna = 1f;
    private string _prompt = "";
    private string? _audio;
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        if (Runner.Frame == 0) Runner.TickOnce();
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("SpatialAudio.Modal.Timer", ex); }
        }, null, 200, 200);
    }

    private static string F0(double v) => v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => v.ToString("0.00", CultureInfo.InvariantCulture);
    private static float P(ChangeEventArgs e) => float.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : 0;
    private static string Db(float rms) => F0(20 * MathF.Log10(MathF.Max(rms, 1e-6f))) + " dB";
    private static string Meter(float rms) => F0(Math.Clamp((20 * MathF.Log10(MathF.Max(rms, 1e-6f)) + 60f) / 60f, 0f, 1f) * 100);
    private static string RoomLabel(AcousticRoomPreset p) => p switch { AcousticRoomPreset.Studio => "🎙 스튜디오", AcousticRoomPreset.OutdoorForest => "🌳 야외 숲", _ => "🏛 콘크리트 홀" };
    private static string ProfileLabel(HrtfProfile p) => p switch { HrtfProfile.Small => "작은 머리", HrtfProfile.Large => "큰 머리", HrtfProfile.Custom => "사용자 지정", _ => "표준" };

    private string ViewBox()
    {
        if (Runner.Raytracer.IsRoom) (_min, _max) = Runner.Raytracer.Room;
        else { _min = new Vector3(-8, 0, -8); _max = new Vector3(8, 4, 8); }
        return F2(_min.X - 0.5f) + " " + F2(_min.Z - 0.5f) + " " + F2(_max.X - _min.X + 1f) + " " + F2(_max.Z - _min.Z + 1f);
    }

    private string EdcPoints(int band)
    {
        var sb = new System.Text.StringBuilder(4096);
        for (var k = 0; k < RealtimeAcousticRaytracingEngine.Bins; k += 20)
        {
            var db = Math.Clamp(Runner.Raytracer.EnergyDecayDb(band, k), -60f, 0f);
            sb.Append(F0(k)).Append(',').Append(F1(-db - 60)).Append(' ');
        }
        return sb.ToString();
    }

    /// <summary>트랙패드 클릭(640×380 px · preserveAspectRatio=none) → 월드 x/z.</summary>
    private void OnPad(MouseEventArgs e)
    {
        var w = _max.X - _min.X + 1f; var h = _max.Z - _min.Z + 1f;
        MoveTo(_min.X - 0.5f + (float)e.OffsetX * w / 640f, _min.Z - 0.5f + (float)e.OffsetY * h / 380f);
    }

    private void MoveTo(float x, float z)
    {
        _lastX = x; _lastZ = z;
        Runner.MoveFocus(Math.Clamp(x, _min.X + 0.2f, _max.X - 0.2f), _height, Math.Clamp(z, _min.Z + 0.2f, _max.Z - 0.2f));
    }

    private void ApplyPrompt()
    {
        if (string.IsNullOrWhiteSpace(_prompt)) return;
        Runner.ApplyPrompt(_prompt.Trim());
    }

    private void Preview() => _audio = "data:audio/wav;base64," + Convert.ToBase64String(Runner.RenderPreviewWav(4f));

    private void ToggleRun() { if (Runner.IsRunning) Runner.Stop(); else Runner.Start(); }

    private Task Close() => OnClose.InvokeAsync();

    private void OnServiceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
