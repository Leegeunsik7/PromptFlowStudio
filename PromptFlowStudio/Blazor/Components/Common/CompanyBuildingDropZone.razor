@inject ICharacterAnchorService Anchor

@* [PromptFlow Studio] 회사 사옥/공장 사진 드롭존 — 드래그앤드롭/클릭 업로드 → I2V 레퍼런스 → [🚀 이 사옥으로 홍보 영상 생성]. *@

<div class="cbz @(_over ? "over" : null) @(HasBuilding ? "set" : null) @(Disabled ? "off" : null)"
     @ondragenter="() => _over = true" @ondragleave="() => _over = false"
     @ondragover:preventDefault="true" @ondrop:preventDefault="true" @ondrop="() => _over = false">

    @if (HasBuilding)
    {
        <div class="cbz-set">
            <img class="cbz-thumb" src="@Thumb" alt="회사 사옥" />
            <div class="cbz-info">
                <div class="cbz-t">🏢 사옥 이미지 등록됨</div>
                <div class="cbz-s">드론 360°·홀로그램 로고·야경 반사를 입힌 <b>15초 명품 홍보 숏츠</b>를 자동 생성합니다.</div>
            </div>
            <button class="cbz-go" @onclick="OnGenerate" disabled="@Disabled">🚀 이 사옥으로 홍보 영상 생성</button>
            <label class="cbz-change">🔄<InputFile class="cbz-input" OnChange="OnPick" accept="image/*" disabled="@(Disabled || _busy)" /></label>
            <button class="cbz-clear" @onclick="Clear" disabled="@(Disabled || _busy)" title="해제">✕</button>
        </div>
    }
    else
    {
        <label class="cbz-drop">
            <div class="cbz-ic">🏢⬆️</div>
            <div class="cbz-txt"><b>회사 사옥·공장 사진을 끌어다 놓거나 클릭</b>하세요</div>
            <div class="cbz-sub">사진 1장 → AI 드론 궤적·홀로그램 로고·야경 반사로 <b>명품 기업 홍보 영상</b> 자동 생성</div>
            <InputFile class="cbz-input" OnChange="OnPick" accept="image/*" disabled="@(Disabled || _busy)" />
        </label>
    }
    @if (_msg is not null) { <div class="cbz-msg @(_err ? "err" : null)">@_msg</div> }
</div>

<style>
    .cbz { position: relative; border: 2px dashed color-mix(in srgb, #0ea5e9 45%, var(--line)); border-radius: 14px;
        background: linear-gradient(135deg, color-mix(in srgb, #0ea5e9 9%, transparent), transparent 60%), var(--card); padding: 14px 16px; margin-bottom: 14px; transition: .15s; }
    .cbz.over { border-color: #38bdf8; background: color-mix(in srgb, #0ea5e9 12%, var(--card)); box-shadow: 0 0 0 3px color-mix(in srgb, #0ea5e9 18%, transparent); }
    .cbz.set { border-style: solid; border-color: color-mix(in srgb, #6366f1 40%, var(--line)); }
    .cbz.off { opacity: .6; }
    .cbz-drop { display: flex; flex-direction: column; align-items: center; gap: 5px; text-align: center; cursor: pointer; }
    .cbz-ic { font-size: 30px; filter: drop-shadow(0 4px 10px color-mix(in srgb, #0ea5e9 40%, transparent)); }
    .cbz-txt { font-size: 13px; color: var(--text-primary); }
    .cbz-sub { font-size: 11px; color: var(--text-muted); line-height: 1.5; max-width: 54ch; }
    .cbz-input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
    .cbz-set { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .cbz-thumb { width: 60px; height: 44px; flex: none; object-fit: cover; border-radius: 9px; border: 1px solid var(--line); box-shadow: 0 4px 12px rgba(0,0,0,.35); }
    .cbz-info { flex: 1; min-width: 180px; }
    .cbz-t { font: 800 13px var(--mono); color: var(--text-primary); }
    .cbz-s { font-size: 11px; color: var(--text-secondary); margin-top: 2px; line-height: 1.45; }
    .cbz-go { flex: none; font: 800 12.5px var(--mono); padding: 10px 15px; border-radius: 10px; border: none; color: #fff; cursor: pointer;
        background: linear-gradient(135deg, #0ea5e9, #6366f1); box-shadow: 0 6px 16px color-mix(in srgb, #6366f1 28%, transparent); }
    .cbz-go:hover:not(:disabled) { filter: brightness(1.08); } .cbz-go:disabled { opacity: .5; cursor: not-allowed; }
    .cbz-change { position: relative; flex: none; font-size: 13px; padding: 8px 10px; border-radius: 9px; cursor: pointer; border: 1px solid var(--line); background: var(--card-2); overflow: hidden; }
    .cbz-clear { flex: none; width: 28px; height: 28px; border: none; background: none; color: var(--text-muted); cursor: pointer; border-radius: 7px; font-size: 13px; }
    .cbz-clear:hover:not(:disabled) { background: color-mix(in srgb, #ef4444 14%, transparent); color: #ef4444; }
    .cbz-msg { margin-top: 9px; font: 700 11.5px var(--mono); color: #38bdf8; } .cbz-msg.err { color: #ef4444; }
</style>

@code {
    /// <summary>대상 프로젝트(사옥 이미지를 앵커로 등록).</summary>
    [Parameter, EditorRequired] public StoryboardProject Project { get; set; } = default!;
    /// <summary>생성/병합 중이면 잠금.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>[🚀 사옥으로 홍보 영상 생성] 클릭 — 부모가 CorporateBuildingThemeEngine 적용 + 시작.</summary>
    [Parameter] public EventCallback OnGenerate { get; set; }
    /// <summary>등록/해제 시 부모 알림.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool _over, _busy, _err;
    private string? _msg;
    private bool HasBuilding => Anchor.HasAnchor(Project);
    private string? Thumb => Anchor.ThumbUrl(Project);

    private async Task OnPick(InputFileChangeEventArgs e)
    {
        if (_busy || Disabled) return;
        _busy = true; _err = false; _msg = "사옥 이미지 등록 중…"; StateHasChanged();
        try
        {
            var r = await Anchor.RegisterAsync(e.File);   // 사옥은 얼굴 크롭 없이 전체 정경을 I2V 레퍼런스로
            if (r.Ok && r.Path is not null)
            {
                Project.AnchorImagePath = r.Path;
                _err = false; _msg = "✓ 사옥 이미지 등록 — [🚀 홍보 영상 생성]을 누르세요.";
                if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
            }
            else { _err = true; _msg = "등록 실패: " + r.Message; }
        }
        catch (Exception ex) { _err = true; _msg = "등록 실패: " + ex.Message; }
        finally { _busy = false; StateHasChanged(); }
    }

    private async Task Clear()
    {
        if (Disabled) return;
        Project.AnchorImagePath = null;
        _err = false; _msg = "사옥 이미지를 해제했습니다.";
        if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
    }
}
