@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private System.Threading.Timer? _timer;
    private bool _overlay = true;
    private int _panel = 16;

    private InnerFrustumOffAxisProjectionEngine E => Runner.Engine;
    private LedWallMoireSuppressionSynthesizer S => Runner.Synth;
    private PtpGenlockPhaseSyncTearingGuard G => Runner.Genlock;
    private LedVolumeTopology T => Runner.Topology;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("IcvfxLedWall.Modal.Timer", ex); }
        }, null, 300, 300);
    }

    private static string F0(double v) => v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0.00", CultureInfo.InvariantCulture);
    private static string F3(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0.000", CultureInfo.InvariantCulture);
    private static double Num(ChangeEventArgs e, double fallback) => double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : fallback;
    private static string Ns(double ns) => ns < 1000 ? F0(ns) + " ns" : ns < 1e6 ? F2(ns / 1000) + " µs" : F2(ns / 1e6) + " ms";

    private static string DevName(int d) => d switch { 0 => "🖥 렌더 노드", 1 => "🟧 LED 프로세서", _ => "🎥 카메라" };
    private static string StateName(PtpState s) => s switch { PtpState.Locked => "LOCKED", PtpState.Acquiring => "획득 중", PtpState.Holdover => "HOLDOVER", _ => "UNLOCKED" };
    private static string StateCls(PtpState s) => s switch { PtpState.Locked => "ok", PtpState.Unlocked => "bad", _ => "warn" };

    private void Topo(float? r = null, float? a = null, float? h = null, float? pw = null, float? p = null)
    {
        Runner.SetTopology(r ?? T.RadiusM, a ?? T.ArcDeg, h ?? T.HeightM, pw ?? T.PanelWidthM, p ?? T.PitchMm);
        _panel = Math.Clamp(_panel, 0, T.Panels - 1);
    }

    private string WallPlan()
    {
        var sb = new System.Text.StringBuilder(T.Panels * 16);
        for (var i = 0; i <= T.Panels; i++)
        {
            var pt = T.Point(T.Theta0(i), 0);
            sb.Append(F2(pt.X)).Append(',').Append(F2(-pt.Z)).Append(' ');
        }
        return sb.ToString();
    }

    private string FrustumPlan()
    {
        ref readonly var s = ref Runner.Shown;
        var sb = new System.Text.StringBuilder(64);
        var a = s.F - s.R * s.TanX; var b = s.F + s.R * s.TanX;
        float ta = T.Intersect(s.Eye, a, out _, out _, out _, out var t1) ? t1 : 6f, tb = T.Intersect(s.Eye, b, out _, out _, out _, out var t2) ? t2 : 6f;
        var pa = s.Eye + a * ta; var pb = s.Eye + b * tb;
        sb.Append(F2(s.Eye.X)).Append(',').Append(F2(-s.Eye.Z)).Append(' ').Append(F2(pa.X)).Append(',').Append(F2(-pa.Z)).Append(' ').Append(F2(pb.X)).Append(',').Append(F2(-pb.Z));
        return sb.ToString();
    }

    private static double Tx(double ns) => Math.Clamp(ns / PtpGenlockPhaseSyncTearingGuard.FramePeriodNs, 0, 1) * 400;

    private string ExposurePoly()
    {
        var e = G.ExposureNs; var r = G.ReadoutNs;
        return F1(Tx(0)) + ",2 " + F1(Tx(e)) + ",2 " + F1(Tx(r + e)) + ",44 " + F1(Tx(r)) + ",44";
    }

    private static string Arc(double frac)
    {
        var ang = Math.PI * Math.Clamp(frac, 0.001, 1);
        return "M 15 95 A 75 75 0 0 1 " + F1(90 - 75 * Math.Cos(ang)) + " " + F1(95 - 75 * Math.Sin(ang));
    }

    private string Series(Func<int, float> f, double max, double h)
    {
        var n = Runner.SeriesCount;
        if (n < 2) return "";
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = n - 1; i >= 0; i--)
            sb.Append(F1(360.0 * (n - 1 - i) / (IcvfxLedWallStudioRunner.SeriesLen - 1))).Append(',').Append(F1(h - 2 - (h - 4) * Math.Clamp(f(i) / max, 0, 1))).Append(' ');
        return sb.ToString();
    }

    private void ToggleRun() { if (Runner.IsRunning) Runner.Stop(); else Runner.Start(); }
    private void Step24() { for (var i = 0; i < IcvfxLedWallStudioRunner.Hz; i++) Runner.Step(); }

    private Task Close() => OnClose.InvokeAsync();

    /// <summary>가동 중(8 Hz 이벤트)은 300 ms 타이머가 처리 — 정지 상태 액션만 즉시 반영.</summary>
    private void OnServiceChanged() { if (!Runner.IsRunning) _ = InvokeAsync(StateHasChanged); }

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
