@inject BabyThemePresetService Presets

@* [PromptFlow Studio] 아기 숏츠 원클릭 테마 갤러리 — 10개 완성형 테마를 카드로 보여주고,
   선택 후 [✨ 이 테마로 스토리보드 자동 구성] 시 부모(Storyboard)가 ApplyPresetToStoryboard 로 6컷을 즉시 교체 + 4토글 ON. *@
<div class="bg-scrim" @onclick="OnCloseClick">
    <div class="bg-modal" @onclick:stopPropagation="true">
        <div class="bg-h">
            <div>
                <div class="bg-title">👶 아기 숏츠 원클릭 테마</div>
                <div class="bg-sub">사진 1장 등록 → 테마 선택 → <b>대본·Wan 프롬프트·키네틱 자막·텐션·Gen-Foley</b>가 6컷 완성. 3초 반전 & 무한 루프 설계 포함.</div>
            </div>
            <button class="bg-x" @onclick="OnCloseClick" title="닫기">✕</button>
        </div>

        @if (!_hasAnchor)
        {
            <div class="bg-warn">💡 <b>팁:</b> 먼저 스토리보드 우측 <b>[⚓ 메인 캐릭터/스타일 앵커]</b>에 아기 사진을 등록하면, 그 아기의 특징을 유지한 채(전 컷 i2v) 테마가 적용됩니다. 사진 없이도 구성은 가능해요.</div>
        }

        <div class="bg-grid">
            @foreach (var t in Presets.Themes)
            {
                <button class="bg-card @(_selected == t.Key ? "on" : null)" @onclick="() => _selected = t.Key" @key="t.Key">
                    <div class="bg-thumb" style="@ThumbStyle(t.Key)"><span>@t.Emoji</span></div>
                    <div class="bg-info">
                        <div class="bg-name">@t.Title <span class="bg-cuts">@(t.Cuts.Count)컷@(t.Speed > 1.01 ? $" · {Inv(t.Speed)}x" : "")</span></div>
                        <div class="bg-hook">@t.Hook</div>
                        <div class="bg-ex">@t.Example</div>
                        <ThemeCinematicBadges Cine="@t.Cinematics" Expanded="@(_selected == t.Key)" />
                    </div>
                    @if (_selected == t.Key) { <div class="bg-check">✓</div> }
                </button>
            }
        </div>

        <div class="bg-foot">
            <div class="bg-foot-note">
                @if (_selected is not null && Presets.Get(_selected) is { } sel)
                {
                    <span>선택: <b>@sel.Emoji @sel.Title</b> · 적용 시 스마트 트랜지션·키네틱 자막·감정선 BGM·Gen-Foley 자동 ON</span>
                }
                else { <span>테마를 선택하세요.</span> }
            </div>
            <div class="bg-foot-btns">
                <button class="bg-btn ghost" @onclick="OnCloseClick">취소</button>
                <button class="bg-btn go" @onclick="Apply" disabled="@(_selected is null)">✨ 이 테마로 스토리보드 자동 구성</button>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-scrim{position:fixed; inset:0; z-index:var(--z-studio-modal); background:rgba(0,0,0,.55); display:flex; align-items:center; justify-content:center; padding:20px}
    .bg-modal{width:min(760px,96vw); max-height:90vh; display:flex; flex-direction:column; background:var(--card); border:1px solid var(--line); border-radius:18px; box-shadow:0 24px 60px rgba(0,0,0,.4); overflow:hidden}
    .bg-h{display:flex; align-items:flex-start; justify-content:space-between; gap:12px; padding:18px 20px; border-bottom:1px solid var(--line)}
    .bg-title{font-size:17px; font-weight:900; color:var(--text-primary)}
    .bg-sub{font-size:12px; color:var(--text-secondary); margin-top:4px; line-height:1.55; max-width:60ch} .bg-sub b{color:var(--text-primary)}
    .bg-x{flex:0 0 auto; width:30px; height:30px; border:none; background:none; color:var(--text-muted); cursor:pointer; font-size:15px; border-radius:8px}
    .bg-x:hover{background:var(--card-2); color:var(--text-primary)}
    .bg-warn{margin:14px 16px 0; padding:10px 13px; border-radius:10px; font-size:12px; line-height:1.55; color:var(--text-secondary);
        background:color-mix(in srgb,#f5a623 10%,var(--card-2)); border:1px solid color-mix(in srgb,#f5a623 34%,var(--line))} .bg-warn b{color:var(--text-primary)}
    .bg-grid{flex:1 1 auto; min-height:0; overflow-x:hidden; overscroll-behavior:contain; display:grid; grid-template-columns:1fr 1fr; gap:10px; padding:16px; overflow-y:auto}
    @@media(max-width:600px){.bg-grid{grid-template-columns:1fr}}
    .bg-card{display:flex; gap:12px; text-align:left; padding:11px; border-radius:14px; border:1px solid var(--line); background:var(--card-2); cursor:pointer; position:relative; font-family:inherit; transition:border-color .12s, transform .08s}
    .bg-card:hover{border-color:var(--accent)} .bg-card:active{transform:scale(.99)}
    .bg-card.on{border-color:transparent; box-shadow:0 0 0 2px var(--accent); background:color-mix(in srgb,var(--accent) 8%,var(--card-2))}
    .bg-thumb{flex:0 0 auto; width:64px; height:64px; border-radius:12px; display:grid; place-items:center; font-size:30px; border:1px solid rgba(255,255,255,.25)}
    .bg-info{min-width:0; flex:1}
    .bg-name{font-size:14px; font-weight:800; color:var(--text-primary); display:flex; align-items:baseline; gap:7px; flex-wrap:wrap}
    .bg-cuts{font:700 10px var(--mono); color:var(--text-muted)}
    .bg-hook{font-size:12px; color:var(--accent-2); margin-top:3px; line-height:1.4}
    .bg-ex{font-size:11.5px; color:var(--text-muted); margin-top:4px; line-height:1.45; overflow:hidden; text-overflow:ellipsis; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical}
    /* v16.7.0 시네마틱 인스펙터 배지(ThemeCinematicBadges) — Glassmorphism */
    .bg-card{transition:border-color .12s, transform .18s, box-shadow .18s; animation:bgIn .3s cubic-bezier(.2,.8,.2,1) both}
    .bg-card:hover{transform:translateY(-2px); box-shadow:0 10px 24px rgba(0,0,0,.16)}
    @@keyframes bgIn{from{opacity:0; transform:translateY(6px)} to{opacity:1; transform:none}}
    @@media(prefers-reduced-motion:reduce){.bg-card{animation:none}}
    .tci{display:flex; flex-wrap:wrap; gap:4px; margin-top:6px; max-height:20px; overflow:hidden; transition:max-height .25s ease}
    .bg-card:hover .tci, .tci.open{max-height:80px}
    .tci-b{display:inline-flex; align-items:center; gap:3px; font:700 10px var(--mono); padding:2px 7px; border-radius:999px; white-space:nowrap; color:var(--text-secondary);
        background:color-mix(in srgb,var(--card) 55%,transparent); border:1px solid rgba(255,255,255,.18); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px)}
    .tci-b.cam{color:var(--text-primary); border-color:color-mix(in srgb,var(--accent) 40%,transparent)}
    .tci-b.sfx i{font-style:normal}
    .tci-mot-l{font-size:8.5px; letter-spacing:.06em; color:var(--text-muted); margin-right:2px}
    .tci-dot{width:6px; height:6px; border-radius:50%; background:color-mix(in srgb,var(--text-muted) 35%,transparent)}
    .tci-dot.on{background:linear-gradient(135deg,var(--flow-violet),var(--flow-magenta)); box-shadow:0 0 6px color-mix(in srgb,var(--flow-magenta) 55%,transparent)}
    .bg-check{position:absolute; top:9px; right:10px; width:20px; height:20px; border-radius:50%; background:var(--accent); color:#fff; display:grid; place-items:center; font-size:12px; font-weight:900}
    .bg-foot{display:flex; align-items:center; justify-content:space-between; gap:12px; padding:14px 18px; border-top:1px solid var(--line); flex-wrap:wrap}
    .bg-foot-note{font-size:12px; color:var(--text-secondary); flex:1; min-width:200px} .bg-foot-note b{color:var(--text-primary)}
    .bg-foot-btns{display:flex; gap:8px}
    .bg-btn{font:800 13px inherit; padding:10px 16px; border-radius:11px; cursor:pointer; border:1px solid var(--line); background:var(--card-2); color:var(--text-secondary)}
    .bg-btn.ghost:hover{border-color:var(--accent); color:var(--text-primary)}
    .bg-btn.go{border:none; color:#fff; background:linear-gradient(135deg,var(--flow-violet),var(--flow-magenta)); box-shadow:0 6px 16px color-mix(in srgb,var(--flow-magenta) 26%,transparent)}
    .bg-btn.go:hover:not(:disabled){filter:brightness(1.07)} .bg-btn.go:disabled{opacity:.45; cursor:not-allowed; box-shadow:none}
</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnApply { get; set; }
    [Parameter] public bool HasAnchor { get; set; }

    private string? _selected;
    private bool _hasAnchor => HasAnchor;

    private async Task OnCloseClick() => await OnClose.InvokeAsync();

    private async Task Apply()
    {
        if (_selected is null) return;
        await OnApply.InvokeAsync(_selected);
    }

    private static string Inv(double d) => d.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    // 테마별 썸네일 그라데이션(밝은 자연광 톤).
    private static string ThumbStyle(string key) => key switch
    {
        "lemon"    => "background:linear-gradient(135deg,#fff1b8,#ffd23f)",
        "naptime"  => "background:linear-gradient(135deg,#dfeaff,#b7c9f0)",
        "csi"      => "background:linear-gradient(135deg,#e7ecf3,#b9c3d1)",
        "penguin"  => "background:linear-gradient(135deg,#dff3ff,#a9dcf0)",
        "mukbang"  => "background:linear-gradient(135deg,#ffe9c9,#ffcf8f)",
        "gym"      => "background:linear-gradient(135deg,#ffe0e0,#ff9f9f)",
        "ceo"      => "background:linear-gradient(135deg,#e9e4ff,#c3b4f0)",
        "bath"     => "background:linear-gradient(135deg,#d9f5ff,#8fd8ef)",
        "peekaboo" => "background:linear-gradient(135deg,#ffe6f2,#ffb3d6)",
        "snow"     => "background:linear-gradient(135deg,#eef6ff,#cfe6ff)",
        _          => "background:linear-gradient(135deg,#fff1b8,#ffd23f)",
    };
}
