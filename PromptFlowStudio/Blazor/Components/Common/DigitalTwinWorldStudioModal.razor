@using System.Globalization
@using System.Numerics
@using PromptFlowStudio.Services.DigitalTwinWorld
@implements IDisposable
@inject DigitalTwinWorldStudioRunner Runner

@*
    [PromptFlow Studio v16.99.0] 🌐 AI 실시간 디지털 트윈 & 옴니버스 월드 스튜디오 — 실물-가상 좌표 동기화 오차 게이지(노드별 · 시계열) · 탑뷰 월드(실물 ○ / 트윈 ● · 강체 · 천 · 유체) ·
    멀티피직스 부하 스펙트럼(단계별 µs 적층) · 옴니버스 라이브 세션(채널 손실/순서/비트 오류 · NACK · 재동기화 · 다이제스트) · 앵커 락 판정.
*@

<div class="dtw-scrim" @onclick="Close">
    <div class="dtw-modal" @onclick:stopPropagation="true">
        <div class="dtw-h">
            <div>
                <div class="dtw-title">🌐 AI 실시간 디지털 트윈 &amp; 옴니버스 월드 스튜디오</div>
                <div class="dtw-sub"><b>동기화 엔진</b>이 센서 프레임 측정을 Horn 캘리브레이션으로 USD 월드에 SIMD 일괄 변환해 트윈을 갱신하고, 가상 편집은 역변환해 액추에이터 명령으로 돌려보냅니다(노드 권한 · 최신 기록 우선).
                    <b>멀티피직스</b>는 강체 · v16.83 천 · v16.81 유체 · v16.84 기상(바람/기온)을 한 스텝에서 결합하고, <b>라이브 동기화</b>는 USD 델타를 CRC 패킷으로 스트리밍해 손실 채널에서도 NACK 재전송으로 무손실을 보장하며 <b>앵커 락</b>이 지터/드리프트를 차단합니다.
                    실물 공장 셀과 Nucleus 서버는 인프로세스 시뮬레이션입니다.</div>
            </div>
            <button class="dtw-x" @onclick="Close">✕</button>
        </div>

        <div class="dtw-bar">
            <button class="dtw-btn @(Runner.IsRunning ? "on" : null)" @onclick="ToggleRun">@(Runner.IsRunning ? "⏸ 정지" : "▶ 트윈 가동")</button>
            <button class="dtw-btn" @onclick="Step30" disabled="@Runner.IsRunning">⏭ 1초</button>
            <button class="dtw-btn @(Runner.LiveSession ? "on" : "warn")" @onclick="ToggleLive">@(Runner.LiveSession ? "🟢 옴니버스 라이브" : "⚪ 라이브 중단")</button>
            <button class="dtw-btn" @onclick="Recalibrate">📐 재캘리브레이션</button>
            <button class="dtw-btn" @onclick="Runner.DropBalls">⚪ 강체 투하</button>
            <button class="dtw-btn" @onclick="Spray">💧 유체 분사</button>
            <button class="dtw-btn" @onclick="MoveConveyor">🎯 컨베이어 이동(가상→실물)</button>
            <button class="dtw-btn @(Runner.UseSlam ? "on" : null)" @onclick="() => Runner.UseSlam = !Runner.UseSlam">🗺️ SLAM 카메라 결선</button>
            <span class="dtw-chip">틱 @(Runner.Tick) · @(F1(Runner.LastTickMs)) ms · 동기화 @(F0(S.LastSyncUs)) µs(최대 @(F0(S.MaxSyncUs)))</span>
        </div>

        <div class="dtw-main">
            <div class="dtw-col">
                <div class="dtw-card">
                    <div class="dtw-sec">📏 실물-가상 좌표 동기화 오차 <span class="dtw-kv">평균 @(F2(S.MeanErrorMm)) mm · 최대 @(F2(S.MaxErrorMm)) mm · 캘리브레이션 RMS @(F2(S.CalibrationRmsMm)) mm · 실물→가상 @(S.ToVirtual) · 가상→실물 @(S.ToPhysical)</span></div>
                    <div class="dtw-gauges">
                        @for (var i = 0; i < S.Count; i++)
                        {
                            var n = i;
                            @Gauge(S.Name(n), S.ErrorMm(n), 20, AuthName(S.Authority(n)))
                        }
                    </div>
                    <svg class="dtw-spark" viewBox="0 0 360 50" preserveAspectRatio="none"><polyline points="@(ErrPoints())" /></svg>
                    <div class="dtw-note">오차 = |트윈 − 캘리브레이션 적용 실물| (센서 잡음 @(F1(Runner.SensorNoiseMm)) mm) · 가상 우선 노드(컨베이어)는 명령 대기 중 오차가 커짐 = 실물이 아직 따라오는 중. 실물 컨베이어 (@(V(Runner.ConveyorPhysical)))</div>
                </div>

                <div class="dtw-card">
                    <div class="dtw-sec">🗺 트윈 월드 탑뷰 <span class="dtw-kv">강체 @(P.BodyCount) · 유체 @(P.Fluid.Count) · 천 정점 @(PromptFlowStudio.Services.HairCloth.GenerativeGarmentClothCollisionSynthesizer.MaxVerts)</span></div>
                    <svg class="dtw-map" viewBox="-2.4 -2.4 4.8 4.8" preserveAspectRatio="xMidYMid meet">
                        <rect class="floor" x="-2" y="-2" width="4" height="4" />
                        @for (var i = 0; i < P.Fluid.Count; i += 3)
                        {
                            <circle class="fl" cx="@(F2(P.Fluid.X[i]))" cy="@(F2(P.Fluid.Z[i]))" r="0.025" />
                        }
                        @for (var v = 0; v < PromptFlowStudio.Services.HairCloth.GenerativeGarmentClothCollisionSynthesizer.MaxVerts; v += 7)
                        {
                            var cp = P.Cloth.Position(v);
                            <circle class="cl" cx="@(F2(cp.X))" cy="@(F2(cp.Z))" r="0.015" />
                        }
                        @for (var b = 0; b < P.BodyCount; b++)
                        {
                            var bp = P.BodyPosition(b);
                            <circle class="rb @(P.IsKinematic(b) ? "kin" : null)" cx="@(F2(bp.X))" cy="@(F2(bp.Z))" r="@(F2(P.BodyRadius(b)))" />
                        }
                        @for (var i = 0; i < S.Count; i++)
                        {
                            var n = i;
                            var pw = S.PhysicalInWorld(n); var tw = S.Twin(n);
                            if (Math.Abs(pw.X) > 3 || Math.Abs(pw.Z) > 3) continue;
                            <line class="err" x1="@(F2(pw.X))" y1="@(F2(pw.Z))" x2="@(F2(tw.X))" y2="@(F2(tw.Z))" />
                            <circle class="ph" cx="@(F2(pw.X))" cy="@(F2(pw.Z))" r="0.07" />
                            <circle class="tw" cx="@(F2(tw.X))" cy="@(F2(tw.Z))" r="0.04" />
                        }
                        @for (var a = 0; a < L.AnchorCount; a++)
                        {
                            var ap = L.AnchorLocked(a);
                            <rect class="anc" x="@(F2(ap.X - 0.08f))" y="@(F2(ap.Z - 0.08f))" width="0.16" height="0.16" />
                        }
                    </svg>
                    <div class="dtw-legend"><i class="ph"></i>실물(캘리브레이션 적용) <i class="tw"></i>트윈 <i class="rb"></i>강체 <i class="kin"></i>로봇(운동학) <i class="cl"></i>천(v16.83) <i class="fl"></i>유체(v16.81) <i class="anc"></i>앵커</div>
                </div>
            </div>

            <div class="dtw-col">
                <div class="dtw-card">
                    <div class="dtw-sec">📊 멀티피직스 부하 스펙트럼 <span class="dtw-kv">합계 @(F0(P.TotalUs)) µs · 강체 접촉 @(P.RigidContacts) · 천 접촉 @(P.ClothContacts) · 유체 접촉 @(P.FluidContacts)</span></div>
                    <svg class="dtw-spec" viewBox="0 0 360 110" preserveAspectRatio="none">
                        @for (var i = 0; i < Runner.SeriesCount; i += 2)
                        {
                            var ii = i;
                            var x = 360 - (ii + 2) * 3.0;
                            var acc = 0.0;
                            for (var s = 0; s < UnifiedMultiPhysicsWorldDynamicsSynthesizer.Stages; s++)
                            {
                                var h = Runner.StageSeries(ii, (PhysicsStage)s) / SpecMax() * 105;
                                <rect class="s@(s)" x="@(F1(x))" y="@(F1(108 - acc - h))" width="5.4" height="@(F1(h))" />
                                acc += h;
                            }
                        }
                    </svg>
                    <div class="dtw-stages">
                        @for (var s = 0; s < UnifiedMultiPhysicsWorldDynamicsSynthesizer.Stages; s++)
                        {
                            var st = (PhysicsStage)s;
                            <label class="sg s@(s)"><input type="checkbox" checked="@StageOn(st)" @onchange="e => SetStage(st, e.Value is true)" /><i></i>@(UnifiedMultiPhysicsWorldDynamicsSynthesizer.StageNames[s]) <b>@(F0(P.StageUs(st))) µs</b></label>
                        }
                    </div>
                    <div class="dtw-kv">바람 @(V(P.LastWind)) m/s · 기온 @(F1(P.LastTemperature)) °C · 유체 점성 @(F2(P.Fluid.Viscosity)) · 천 반작용 @(F2(P.ClothImpulse.Length() * 1000)) mN·s · 유체 반작용 @(F2(P.FluidImpulse.Length() * 1000)) mN·s · 강체 운동에너지 @(F2(P.RigidKineticEnergy())) J</div>
                </div>

                <div class="dtw-card">
                    <div class="dtw-sec">🛰 옴니버스 라이브 USD 세션 <span class="dtw-kv">seq @(L.Sequence) · 패킷 @(L.SentPackets) · @(Kb(L.SentBytes)) · 레코드 @(L.Records) · 최근 @(L.LastRecords)건/@(L.LastPacketBytes) B · 서버 다이제스트 @(Hex(OmniverseLiveUsdSyncAnchorGuard.Digest(Runner.Layer)))</span></div>
                    <div class="dtw-row">
                        <label class="dtw-sl">손실 <b>@(F0(L.LossRate * 100))%</b><input type="range" min="0" max="50" step="1" value="@(F0(L.LossRate * 100))" @onchange="e => L.LossRate = Pct(e)" /></label>
                        <label class="dtw-sl">순서 뒤바뀜 <b>@(F0(L.ReorderRate * 100))%</b><input type="range" min="0" max="50" step="1" value="@(F0(L.ReorderRate * 100))" @onchange="e => L.ReorderRate = Pct(e)" /></label>
                        <label class="dtw-sl">비트 오류 <b>@(F0(L.CorruptRate * 100))%</b><input type="range" min="0" max="30" step="1" value="@(F0(L.CorruptRate * 100))" @onchange="e => L.CorruptRate = Pct(e)" /></label>
                    </div>
                    <div class="dtw-sessions">
                        @for (var i = 0; i < OmniverseLiveUsdSyncAnchorGuard.MaxSessions; i++)
                        {
                            var ss = L.Session(i);
                            if (ss is null) continue;
                            var id = i;
                            var ok = L.InSync(id);
                            <div class="ss @(ok ? "ok" : "bad")">
                                <div class="sh"><b>@(ss.Name)</b><span class="dtw-chip @(ok ? "ok" : "bad")">@(ok ? "다이제스트 일치" : "동기화 중")</span>
                                    <button class="dtw-btn sm @(ss.Connected ? "on" : "warn")" @onclick="() => L.SetConnected(id, !ss.Connected)">@(ss.Connected ? "연결" : "끊김")</button></div>
                                <div class="dtw-kv">적용 @(ss.Applied) · 손실 @(ss.Dropped) · CRC 폐기 @(ss.Corrupted) · 순서 @(ss.Reordered) · NACK 재전송 @(ss.Nacks) · 전체 재동기화 @(ss.Resyncs) · 기대 seq @(ss.Expected)</div>
                            </div>
                        }
                    </div>
                </div>

                <div class="dtw-card">
                    <div class="dtw-sec">⚓ 공간 앵커 락 가드</div>
                    @for (var a = 0; a < L.AnchorCount; a++)
                    {
                        var aa = a;
                        <div class="dtw-anchor">
                            <b>@(Runner.Layer.Path(L.AnchorPrim(aa)).ToString())</b>
                            <span class="dtw-chip v@((int)L.AnchorLast(aa))">@(VerdictName(L.AnchorLast(aa)))</span>
                            <span class="mono">(@(V(L.AnchorLocked(aa))))</span>
                            <span class="dtw-kv">지터 고정 @(L.AnchorCountOf(aa, AnchorVerdict.JitterSuppressed)) · 이상치 @(L.AnchorCountOf(aa, AnchorVerdict.OutlierRejected)) · 드리프트 복귀 @(L.AnchorCountOf(aa, AnchorVerdict.DriftSnapped)) · 재고정 @(L.AnchorCountOf(aa, AnchorVerdict.Relocked))</span>
                            <button class="dtw-btn sm @(L.AnchorIsLocked(aa) ? "on" : null)" @onclick="() => L.SetLocked(aa, !L.AnchorIsLocked(aa))">@(L.AnchorIsLocked(aa) ? "🔒 잠금" : "🔓 해제")</button>
                        </div>
                    }
                    <div class="dtw-note">데드밴드 @(F0(L.AnchorDeadbandM * 1000)) mm · 점프 상한 @(F0(L.AnchorMaxJumpM * 100)) cm · 재고정 @(L.AnchorRelockFrames)프레임 일관 이동(센서 출처만) · 물리 출처 이탈 = 락 위치 복귀.</div>
                </div>
                <div class="dtw-note">@(Runner.LastAction ?? "대기")</div>
            </div>
        </div>
    </div>
</div>

<style>
    .dtw-scrim { position: fixed; inset: 0; z-index: var(--z-studio-modal); background: rgba(0,0,0,.62); display: flex; align-items: center; justify-content: center; padding: 20px; }
    .dtw-modal { width: min(1600px, 97vw); max-height: 94vh; display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--line); border-radius: 18px; box-shadow: 0 24px 60px rgba(0,0,0,.45); overflow: hidden; }
    .dtw-h { display: flex; justify-content: space-between; gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--line); background: linear-gradient(120deg, color-mix(in srgb, #76b900 16%, var(--card)), color-mix(in srgb, #0ea5e9 14%, var(--card))); }
    .dtw-title { font-size: 17px; font-weight: 900; color: var(--text-primary); }
    .dtw-sub { font-size: 12px; color: var(--text-secondary); margin-top: 4px; line-height: 1.5; } .dtw-sub b { color: var(--text-primary); }
    .dtw-x { background: none; border: none; color: var(--text-muted); font-size: 18px; cursor: pointer; border-radius: 8px; }
    .dtw-bar { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 20px; border-bottom: 1px solid var(--line); align-items: center; }
    .dtw-btn { font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 8px; border: 1px solid var(--line); background: transparent; color: var(--text-primary); cursor: pointer; } .dtw-btn:disabled { opacity: .4; cursor: default; }
    .dtw-btn.sm { font-size: 10px; padding: 2px 8px; } .dtw-btn.on { background: color-mix(in srgb, #76b900 24%, transparent); border-color: #a3e635; } .dtw-btn.warn { background: color-mix(in srgb, #f97316 24%, transparent); border-color: #fb923c; }
    .dtw-chip { font: 700 11px var(--mono); padding: 3px 8px; border-radius: 999px; border: 1px solid var(--line); color: var(--text-secondary); }
    .dtw-chip.ok { border-color: #22c55e; color: #86efac; } .dtw-chip.bad { border-color: #f59e0b; color: #fcd34d; }
    .dtw-chip.v1 { border-color: #38bdf8; color: #7dd3fc; } .dtw-chip.v2 { border-color: #ef4444; color: #fca5a5; } .dtw-chip.v3 { border-color: #f59e0b; color: #fcd34d; } .dtw-chip.v4 { border-color: #a855f7; color: #d8b4fe; }
    .dtw-main { display: grid; grid-template-columns: 1fr 1.1fr; gap: 14px; padding: 14px 20px; min-height: 0; flex: 1; overflow-y: auto; }
    .dtw-col { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
    .dtw-card { border: 1px solid var(--line); border-radius: 12px; padding: 12px; display: flex; flex-direction: column; gap: 8px; }
    .dtw-sec { font-weight: 800; font-size: 13px; color: var(--text-primary); display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .dtw-gauges { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .dtw-gauge { display: flex; flex-direction: column; align-items: center; font-size: 10px; color: var(--text-muted); text-align: center; } .dtw-gauge svg { width: 96px; height: 56px; }
    .dtw-gauge .tr { fill: none; stroke: #1f2937; stroke-width: 8; } .dtw-gauge .vl { fill: none; stroke-width: 8; stroke-linecap: round; } .dtw-gauge b { font: 800 12px var(--mono); color: var(--text-primary); } .dtw-gauge em { font-style: normal; color: #a3e635; }
    .dtw-spark { width: 100%; height: 50px; background: #030712; border-radius: 6px; } .dtw-spark polyline { fill: none; stroke: #a3e635; stroke-width: 1.4; vector-effect: non-scaling-stroke; }
    .dtw-map { width: 100%; height: 340px; background: #030712; border-radius: 10px; }
    .dtw-map .floor { fill: #0b1220; stroke: #334155; stroke-width: .02; } .dtw-map .fl { fill: #38bdf8; opacity: .55; } .dtw-map .cl { fill: #f472b6; opacity: .7; }
    .dtw-map .rb { fill: rgba(203,213,225,.35); stroke: #e2e8f0; stroke-width: .015; } .dtw-map .rb.kin { fill: rgba(249,115,22,.45); stroke: #fb923c; }
    .dtw-map .ph { fill: none; stroke: #facc15; stroke-width: .02; } .dtw-map .tw { fill: #a3e635; } .dtw-map .err { stroke: #ef4444; stroke-width: .02; } .dtw-map .anc { fill: none; stroke: #a855f7; stroke-width: .025; }
    .dtw-legend { display: flex; flex-wrap: wrap; gap: 10px; font-size: 10px; color: var(--text-muted); align-items: center; } .dtw-legend i { display: inline-block; width: 10px; height: 10px; border-radius: 50%; }
    .dtw-legend .ph { border: 2px solid #facc15; } .dtw-legend .tw { background: #a3e635; } .dtw-legend .rb { background: #cbd5e1; } .dtw-legend .kin { background: #fb923c; } .dtw-legend .cl { background: #f472b6; } .dtw-legend .fl { background: #38bdf8; } .dtw-legend .anc { border: 2px solid #a855f7; border-radius: 2px; }
    .dtw-spec { width: 100%; height: 120px; background: #030712; border-radius: 8px; }
    .dtw-spec .s0, .dtw-stages .s0 i { fill: #38bdf8; background: #38bdf8; } .dtw-spec .s1, .dtw-stages .s1 i { fill: #e2e8f0; background: #e2e8f0; } .dtw-spec .s2, .dtw-stages .s2 i { fill: #f472b6; background: #f472b6; }
    .dtw-spec .s3, .dtw-stages .s3 i { fill: #0ea5e9; background: #0ea5e9; } .dtw-spec .s4, .dtw-stages .s4 i { fill: #a3e635; background: #a3e635; }
    .dtw-stages { display: flex; flex-wrap: wrap; gap: 10px; } .dtw-stages .sg { display: flex; gap: 4px; align-items: center; font-size: 11px; color: var(--text-secondary); } .dtw-stages i { display: inline-block; width: 10px; height: 10px; border-radius: 2px; } .dtw-stages b { font-family: var(--mono); color: var(--text-primary); }
    .dtw-row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
    .dtw-sl { display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--text-secondary); } .dtw-sl b { font-family: var(--mono); color: var(--text-primary); } .dtw-sl input { width: 100px; }
    .dtw-sessions { display: flex; flex-direction: column; gap: 6px; } .dtw-sessions .ss { border: 1px solid var(--line); border-left: 4px solid #22c55e; border-radius: 10px; padding: 6px 8px; } .dtw-sessions .ss.bad { border-left-color: #f59e0b; }
    .dtw-sessions .sh { display: flex; gap: 8px; align-items: center; font-size: 12px; color: var(--text-secondary); } .dtw-sessions .sh b { color: var(--text-primary); }
    .dtw-anchor { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 11px; color: var(--text-secondary); border-bottom: 1px dashed var(--line); padding-bottom: 6px; } .dtw-anchor b { color: var(--text-primary); }
    .dtw-kv { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 11px; font-weight: 500; color: var(--text-secondary); align-items: center; }
    .dtw-note { font-size: 11px; color: var(--text-muted); } .mono { font-family: var(--mono); }
    @@media (max-width: 1200px) { .dtw-main { grid-template-columns: 1fr; } .dtw-gauges { grid-template-columns: repeat(2, 1fr); } }
</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private System.Threading.Timer? _timer;
    private int _conveyorStep;

    private RealtimeDigitalTwinSpatialSyncEngine S => Runner.Sync;
    private UnifiedMultiPhysicsWorldDynamicsSynthesizer P => Runner.Physics;
    private OmniverseLiveUsdSyncAnchorGuard L => Runner.Live;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("Twin.Modal.Timer", ex); }
        }, null, 300, 300);
    }

    private static string F0(double v) => v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => double.IsNaN(v) ? "—" : v.ToString("0.00", CultureInfo.InvariantCulture);
    private static string V(Vector3 v) => F2(v.X) + ", " + F2(v.Y) + ", " + F2(v.Z);
    private static string Kb(long b) => (b / 1024d).ToString("0.0", CultureInfo.InvariantCulture) + " KB";
    private static string Hex(ulong h) => h.ToString("x16", CultureInfo.InvariantCulture)[..10];
    private static double Pct(ChangeEventArgs e) => double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? Math.Clamp(v / 100.0, 0, 0.9) : 0;
    private static string AuthName(TwinAuthority a) => a switch { TwinAuthority.Physical => "실물 우선", TwinAuthority.Virtual => "가상 우선", _ => "양방향" };
    private static string VerdictName(AnchorVerdict v) => v switch
    {
        AnchorVerdict.JitterSuppressed => "지터 고정", AnchorVerdict.OutlierRejected => "이상치 거부", AnchorVerdict.DriftSnapped => "드리프트 복귀",
        AnchorVerdict.Relocked => "재고정", AnchorVerdict.Unlocked => "잠금 해제", _ => "이동 관찰 중",
    };

    private double SpecMax()
    {
        double m = 1;
        for (var i = 0; i < Runner.SeriesCount; i++)
        {
            double s = 0;
            for (var k = 0; k < UnifiedMultiPhysicsWorldDynamicsSynthesizer.Stages; k++) s += Runner.StageSeries(i, (PhysicsStage)k);
            m = Math.Max(m, s);
        }
        return m;
    }

    private string ErrPoints()
    {
        var n = Runner.SeriesCount;
        if (n < 2) return "";
        double mx = 1;
        for (var i = 0; i < n; i++) mx = Math.Max(mx, Runner.ErrorSeries(i));
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = n - 1; i >= 0; i--) sb.Append(F1(360.0 * (n - 1 - i) / (DigitalTwinWorldStudioRunner.SeriesLen - 1))).Append(',').Append(F1(48 - 46 * Runner.ErrorSeries(i) / mx)).Append(' ');
        return sb.ToString();
    }

    private RenderFragment Gauge(string name, double mm, double max, string sub) => __builder =>
    {
        var t = Math.Clamp(mm / max, 0, 1);
        var a = Math.PI * (1 - t);
        var x = 48 + 38 * Math.Cos(a); var y = 50 - 38 * Math.Sin(a);
        var col = t < 0.25 ? "#22c55e" : t < 0.6 ? "#f59e0b" : "#ef4444";
        <div class="dtw-gauge">
            <svg viewBox="0 0 96 56">
                <path class="tr" d="M 10 50 A 38 38 0 0 1 86 50" />
                <path class="vl" stroke="@col" d="M 10 50 A 38 38 0 0 1 @(F1(x)) @(F1(y))" />
            </svg>
            <b>@(F1(mm)) mm</b>
            <span>@name</span>
            <em>@sub</em>
        </div>
    };

    private bool StageOn(PhysicsStage s) => s switch
    {
        PhysicsStage.Weather => P.WeatherOn, PhysicsStage.Rigid => P.RigidOn, PhysicsStage.Cloth => P.ClothOn, PhysicsStage.Fluid => P.FluidOn, _ => P.CouplingOn,
    };

    private void SetStage(PhysicsStage s, bool on)
    {
        switch (s)
        {
            case PhysicsStage.Weather: P.WeatherOn = on; break;
            case PhysicsStage.Rigid: P.RigidOn = on; break;
            case PhysicsStage.Cloth: P.ClothOn = on; break;
            case PhysicsStage.Fluid: P.FluidOn = on; break;
            default: P.CouplingOn = on; break;
        }
    }

    private void ToggleRun() { if (Runner.IsRunning) Runner.Stop(); else Runner.Start(); }
    private void Step30() { for (var i = 0; i < DigitalTwinWorldStudioRunner.Hz; i++) Runner.Step(); }
    private void ToggleLive() => Runner.SetLive(!Runner.LiveSession);
    private void Recalibrate() => Runner.Calibrate();
    private void Spray() => Runner.SprayFluid();

    private void MoveConveyor()
    {
        _conveyorStep++;
        var a = _conveyorStep * 1.3f;
        Runner.CommandConveyor(new Vector3(1.4f * MathF.Cos(a), 0.25f, 1.4f * MathF.Sin(a)));
    }

    private Task Close() => OnClose.InvokeAsync();

    /// <summary>가동 중(10 Hz 이벤트)은 300 ms 타이머가 처리 — 정지 상태 액션만 즉시 반영.</summary>
    private void OnServiceChanged() { if (!Runner.IsRunning) _ = InvokeAsync(StateHasChanged); }

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
