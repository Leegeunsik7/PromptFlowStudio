    @* ── v16.18.0: AI 비용 원장 · 예산 한도 + 하드웨어 텔레메트리(VRAM/RAM EWMA · 컷당 렌더 · OOM 신호) ── *@
    <div class="gth-v1618">
        @{ var cbState = CostLedger.State; var hwP = HwTelemetry.Pressure; }
        <div class="gth-v96-card pid @(cbState == BudgetState.Exceeded || hwP == MemoryPressure.Critical ? "warn" : cbState == BudgetState.Ok ? "ok" : null)">
            <div class="gth-v96-h"><b>💰 비용 · 🌡️ 자원</b>
                <span class="gth-v96-be">@(cbState == BudgetState.Ok ? "예산 정상" : cbState == BudgetState.Warning ? "예산 80%" : "한도 도달·생성 정지")</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="acc">$@(ProductionCostTrackerService.Usd(CostLedger.TodayUsd))</b><span>오늘</span></span>
                <span class="gth-v96-m"><b>$@(ProductionCostTrackerService.Usd(CostLedger.MonthUsd))</b><span>이번 달</span></span>
                <span class="gth-v96-m"><b>@((HwTelemetry.RamEwma * 100).ToString("0", CultureInfo.InvariantCulture))%</b><span>RAM</span></span>
                <span class="gth-v96-m"><b>@(HwTelemetry.VramEwma is { } hwVram ? (hwVram * 100).ToString("0", CultureInfo.InvariantCulture) + "%" : "—")</b><span>VRAM</span></span>
            </div>
            <div class="gth-v96-hash">클립 @(CostLedger.TotalClips) · 차단 @(CostLedger.BlockedRequests) · 컷 평균 @(HwTelemetry.AverageCutSeconds.ToString("0.0", CultureInfo.InvariantCulture))초 · OOM 신호 @(HwTelemetry.PressureSignals)</div>
            <div class="gth-v96-act">@(hwP == MemoryPressure.Normal ? "메모리 정상" : HwTelemetry.LastSignal.Reason)</div>
        </div>
    </div>

    @* ── v15.1.0: Wan 품질·속도 거버너(스텝/해상도 래더) + 락-프리 스테이징·60FPS 위상 보간 펌프 ── *@
    <div class="gth-v151">
        @{ var wgSt = WanGov.Snapshot(); var wgStage = VirtualCam.Staging; }
        <div class="gth-v96-card pid @(wgSt.Level >= 3 ? "warn" : wgSt.Samples > 0 ? "ok" : null)">
            <div class="gth-v96-h">
                <b>🎛 Wan 품질·속도 거버너</b>
                <span class="gth-v96-be">L@(wgSt.Level)/@(PromptFlowStudio.Services.AI.Wan.WanQualitySpeedGovernor.MaxLevel) · @(VirtualCam.PumpRunning ? "펌프 가동" : "펌프 정지")</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="acc">@(wgSt.Steps)</b><span>steps</span></span>
                <span class="gth-v96-m"><b>@(wgSt.ResolutionPct)%</b><span>해상도</span></span>
                <span class="gth-v96-m"><b class="@(wgSt.EwmaLatencyMs > WanGov.LatencyBudgetMs ? "warn" : null)">@(wgSt.EwmaLatencyMs.ToString("0", CultureInfo.InvariantCulture))ms</b><span>EWMA</span></span>
                <span class="gth-v96-m"><b>@((wgSt.DropRate * 100).ToString("0.0", CultureInfo.InvariantCulture))%</b><span>드롭률</span></span>
            </div>
            <div class="gth-v96-hash">스테이징 게시 @(wgStage.Published) · 소비 @(wgStage.Consumed) · 덮어씀 @(wgStage.Overwritten) · 역행 @(wgStage.StepRegressions) · 보간 송출 @(VirtualCam.InterpolatedEmits)</div>
            <div class="gth-v96-row">
                <button class="gth-v96-btn" @onclick="WanGov.Reset">↻ 초기화</button>
            </div>
            <div class="gth-v96-act">하향 @(wgSt.Degrades) · 상향 @(wgSt.Upgrades) · 선제 완화 @(wgSt.Preemptions) · @(WanGov.LastAction ?? "대기 중")</div>
        </div>
    </div>

    @* ── v14.3.0: 가변 VLM 샘플링(p95·EWMA → 100~2000ms) + 지연 분포 히스토그램(고정 버퍼 재사용 · 스냅샷 할당 0) ── *@
    <div class="gth-v143">
        @{ var vlmSt = VisionCtx.Sampler.Snapshot(); var vlmHistMax = Math.Max(1, VisionCtx.Sampler.CopyHistogram(_vlmHist)); }
        <div class="gth-v96-card vision @(vlmSt.TimeoutRate >= PromptFlowStudio.Services.AI.Vision.AdaptiveFrameSampler.TimeoutRateThreshold ? "warn" : vlmSt.Count > 0 ? "ok" : null)">
            <div class="gth-v96-h">
                <b>📶 가변 VLM 샘플링 · 지연 분포</b>
                <span class="gth-v96-be">@(VisionCtx.Sampler.TargetFps.ToString("0.0", CultureInfo.InvariantCulture)) FPS · @(VisionCtx.TimerPeriodMs)ms 주기</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="acc">@(vlmSt.P50Ms.ToString("0", CultureInfo.InvariantCulture))ms</b><span>p50</span></span>
                <span class="gth-v96-m"><b>@(vlmSt.P90Ms.ToString("0", CultureInfo.InvariantCulture))ms</b><span>p90</span></span>
                <span class="gth-v96-m"><b class="@(vlmSt.P99Ms >= PromptFlowStudio.Services.AI.Vision.AdaptiveFrameSampler.MaxIntervalMs ? "warn" : null)">@(vlmSt.P99Ms.ToString("0", CultureInfo.InvariantCulture))ms</b><span>p99</span></span>
                <span class="gth-v96-m"><b>@(vlmSt.EwmaMs.ToString("0", CultureInfo.InvariantCulture))ms</b><span>EWMA</span></span>
            </div>
            <div class="gth-v143-hist" title="최근 @(vlmSt.Count)건 E2E 지연 분포">
                @for (var vlmB = 0; vlmB < _vlmHist.Length; vlmB++)
                {
                    <span class="gth-v143-col"><i style="height:@(_vlmHist[vlmB] * 100 / vlmHistMax)%"></i><em>@(VlmBucketLabels[vlmB])</em></span>
                }
            </div>
            <div class="gth-v96-act">창 @(vlmSt.Count)/@(PromptFlowStudio.Services.AI.Vision.AdaptiveFrameSampler.WindowSize) · p95 @(vlmSt.P95Ms.ToString("0", CultureInfo.InvariantCulture))ms · 타임아웃 비율 @((vlmSt.TimeoutRate * 100).ToString("0", CultureInfo.InvariantCulture))% · 스케일 변경 @(VisionCtx.Sampler.ScaleChanges) · 누적 타임아웃 @(VisionCtx.Sampler.Timeouts)</div>
        </div>
    </div>

    @* ── v13.0.0: 비전 컨텍스트 분석(1FPS 샘플 · BCL 휴리스틱 즉시 + 로컬 VLM 보강) → 리액션/모션/프롬프트 변조 ── *@
    <div class="gth-v130f1">
        @{ var vcxRes = VisionCtx.LastResult; var vcxVlm = VisionCtx.Vlm as PromptFlowStudio.Services.AI.Vision.LocalVlmHttpClient; }
        <div class="gth-v96-card vision @(vcxRes is { } vcxR0 && vcxR0.Scene != PromptFlowStudio.Services.AI.Vision.VisionScene.Calm && vcxR0.Scene != PromptFlowStudio.Services.AI.Vision.VisionScene.Unknown ? "ok" : null)">
            <div class="gth-v96-h">
                <b>👁 비전 컨텍스트 분석</b>
                <span class="gth-v96-be">@(VisionCtx.Running ? "가변 샘플링" : "정지") · <b class="@(VisionCtx.VlmHealthState == PromptFlowStudio.Services.AI.Vision.VlmHealth.Offline ? "warn" : VisionCtx.VlmHealthState == PromptFlowStudio.Services.AI.Vision.VlmHealth.Online ? "ok" : null)">@(VlmHealthLabel(VisionCtx.VlmHealthState))</b></span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="acc">@(vcxRes?.Scene.ToString() ?? "-")</b><span>장면(@(vcxRes?.Source.ToString() ?? "-"))</span></span>
                <span class="gth-v96-m"><b>@((vcxRes?.Confidence ?? 0).ToString("0.00", CultureInfo.InvariantCulture))</b><span>신뢰도</span></span>
                <span class="gth-v96-m"><b>@((vcxRes?.MeanLuma ?? 0).ToString("0", CultureInfo.InvariantCulture)) / @((vcxRes?.MotionEnergy ?? 0).ToString("0.0", CultureInfo.InvariantCulture))</b><span>밝기 / 변화량</span></span>
                <span class="gth-v96-m"><b class="ok">@(VisionFx.Reactions)</b><span>리액션 발동</span></span>
            </div>
            <div class="gth-v96-act">
                <button class="gth-v96-btn" @onclick="ToggleVision">@(VisionCtx.Running ? "⏹ 분석 정지" : "▶ 분석 시작")</button>
                <span>샘플 @(VisionCtx.Samples) · 새 프레임 없음 @(VisionCtx.SkippedNoNewFrame) · 쿨다운 억제 @(VisionFx.SuppressedByCooldown)</span>
            </div>
            <div class="gth-v96-act">VLM @(vcxVlm is null ? "-" : vcxVlm.Endpoint + " · " + vcxVlm.Model) · 요청 @(VisionCtx.VlmRequests) · 확정 @(VisionCtx.VlmAccepted) · 폴백 @(VisionCtx.VlmFallbacks)@(vcxVlm?.LastError is { } vcxErr ? " · " + vcxErr : "")</div>
            <div class="gth-v96-act">E2E 지연(샘플→VLM) 최근 @(VisionCtx.LastVlmLatencyMs.ToString("0", CultureInfo.InvariantCulture))ms · 평균 @(VisionCtx.AvgVlmLatencyMs.ToString("0", CultureInfo.InvariantCulture))ms · 최대 @(VisionCtx.MaxVlmLatencyMs.ToString("0", CultureInfo.InvariantCulture))ms · 데드라인 @(VisionCtx.VlmDeadline.TotalSeconds.ToString("0", CultureInfo.InvariantCulture))s</div>
            <div class="gth-v96-act">백프레셔 드롭 @(VisionCtx.VlmDropped) · 드롭률 @((VisionCtx.Samples == 0 ? 0 : VisionCtx.VlmDropped * 100.0 / VisionCtx.Samples).ToString("0.0", CultureInfo.InvariantCulture))% · 오프라인 생략 @(VisionCtx.VlmSkippedOffline) · 타임아웃 @(VisionCtx.VlmTimeouts)</div>
            <div class="gth-v96-act">
                <b class="@(VisionProbe.Last.Status == PromptFlowStudio.Services.AI.Vision.VisionProbeStatus.Ready ? "ok" : VisionProbe.Last.Status == PromptFlowStudio.Services.AI.Vision.VisionProbeStatus.NotProbed ? null : "warn")">@(VisionProbe.Badge)</b>
                <button class="gth-v96-btn" @onclick="ProbeVision" disabled="@(VisionProbe.Busy)">🔎 모델 탐지</button>
                <button class="gth-v96-btn" @onclick="BenchVision" disabled="@(VisionProbe.Busy || VisionProbe.Last.Status != PromptFlowStudio.Services.AI.Vision.VisionProbeStatus.Ready)">@(VisionProbe.Busy ? "⏳ 벤치 중…" : "⏱ 합성 벤치(5프레임)")</button>
            </div>
            <div class="gth-v96-act">
                @if (VisionMap.LastDispatch is { } vcxAct)
                {
                    <b class="@(vcxAct.MotionInjected || vcxAct.StyleSwapped ? "ok" : "warn")">최근 비전 액션: @(PromptFlowStudio.Services.AI.Vision.VisionActionMapper.Label(vcxAct.Match.Motion)) / @(PromptFlowStudio.Services.AI.Vision.VisionActionMapper.Label(vcxAct.Match.Style))</b>
                    <span>쿨다운 @((VisionMap.CooldownRemainingMs(vcxAct.Match.Motion != PromptFlowStudio.Services.AI.Vision.VisionAction.None ? vcxAct.Match.Motion : vcxAct.Match.Style) / 1000.0).ToString("0.0", CultureInfo.InvariantCulture))s@(vcxAct.MotionDeferredToSceneBinder ? " · 모션은 장면 바인더가 처리" : "")@(vcxAct.MotionSuppressed || vcxAct.StyleSuppressed ? " · 쿨다운 차단" : "")</span>
                }
                else
                {
                    <span>최근 비전 액션: 없음(VLM 요약 대기)</span>
                }
                <span>· 스타일 LoRA @(VisionMap.ActiveStyleLora ?? "-") · 모션 @(VisionMap.MotionInjected) · 스왑 @(VisionMap.StyleSwaps) · 쿨다운 차단 @(VisionMap.SuppressedByCooldown)</span>
            </div>
            @if (VisionProbe.LastBenchmark is { } vcxBench)
            {
                <div class="gth-v96-act">벤치 @(vcxBench.Model) · @(vcxBench.Succeeded)/@(vcxBench.Frames) 성공 · p50 @(vcxBench.P50Ms.ToString("0", CultureInfo.InvariantCulture))ms · p95 @(vcxBench.P95Ms.ToString("0", CultureInfo.InvariantCulture))ms · 실효 @(vcxBench.Fps.ToString("0.00", CultureInfo.InvariantCulture)) FPS</div>
            }
            <div class="gth-v96-act">프롬프트 변조: @(VisionFx.ActiveModifierScene == PromptFlowStudio.Services.AI.Vision.VisionScene.Unknown ? "없음(원본 통과)" : VisionFx.ActiveModifierScene.ToString())@(VisionCtx.LastVlmSummary is { } vcxSum ? " · VLM: " + vcxSum : "")</div>
        </div>
    </div>

    @* ── v12.2.0-Phase3: 스트리머 리액션 오버레이(10ms 고정스텝) + P2P 메시 자동 부하분산/원자 페일오버 관제 ── *@
    <div class="gth-v122f3">
        @{ var fx = StreamerFx.Snapshot; }
        <div class="gth-v96-card streamerfx @(fx.Affect >= PromptFlowStudio.Services.AI.Wan.ReactionAffect.Excited ? "ok" : null)">
            <div class="gth-v96-h">
                <b>✨ 스트리머 리액션 오버레이</b>
                <span class="gth-v96-be">@(PromptFlowStudio.Services.AI.Wan.StreamerReactionEngine.AffectLabel(fx.Affect)) · @(StreamerFx.Running ? "10ms 루프 가동" : "정지")</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="acc">@(fx.ActiveParticles)/@(StreamerFx.Capacity)</b><span>활성 파티클</span></span>
                <span class="gth-v96-m"><b>@(fx.BounceScale.ToString("0.000", CultureInfo.InvariantCulture))</b><span>바운스 스케일</span></span>
                <span class="gth-v96-m"><b class="ok">@(StreamerFx.ImpulsesQueued)</b><span>임펄스</span></span>
                <span class="gth-v96-m"><b class="@(StreamerFx.ParticlesDropped > 0 ? "warn" : null)">@(StreamerFx.ParticlesDropped)</b><span>용량 드롭</span></span>
            </div>
            <div class="gth-v122-badge" style="opacity:@(fx.BadgeAlpha.ToString("0.00", CultureInfo.InvariantCulture))">@(PromptFlowStudio.Services.AI.Wan.StreamerReactionEngine.AffectLabel(fx.Affect))</div>
            <div class="gth-v96-act">
                <button class="gth-v96-btn" @onclick="ToggleStreamerFx">@(StreamerFx.Running ? "⏹ 정지" : "▶ 루프 가동")</button>
                <button class="gth-v96-btn" @onclick="() => StreamerFx.TriggerManual(PromptFlowStudio.Services.AI.Wan.ReactionAffect.Hype, 0.8)">🔥 Hype 테스트</button>
                <button class="gth-v96-btn" @onclick="StreamerFx.ResetAll">♻ 초기화</button>
            </div>
            <div class="gth-v96-act">가상카메라 합성 @(VirtualCam.OverlayFramesComposited)프레임 · @(VirtualCam.OverlayAttached ? "결선됨" : "미결선")</div>
            <div class="gth-v96-act">틱 @(StreamerFx.Ticks) · 오디오 프레임 @(StreamerFx.AudioFramesObserved) · 반응 강도는 진폭/비트 휴리스틱(감정 인식 아님)</div>
        </div>

        @{ var mr = MeshLb.Route; }
        <div class="gth-v96-card meshlb @(mr.HasRoute ? "ok" : MeshLb.NodeCount > 0 ? "warn" : null)">
            <div class="gth-v96-h">
                <b>🕸 P2P 메시 부하분산</b>
                <span class="gth-v96-be">gen @(mr.Generation) · @(MeshLb.Running ? "10ms 프로브" : "정지")</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="acc">@(mr.HasRoute ? MeshLb.NodeIdAt(mr.PrimaryIndex) : "-")</b><span>Primary @(mr.PrimarySharePct)%</span></span>
                <span class="gth-v96-m"><b>@(mr.BackupIndex >= 0 ? MeshLb.NodeIdAt(mr.BackupIndex) : "-")</b><span>Backup</span></span>
                <span class="gth-v96-m"><b class="@(MeshLb.Failovers > 0 ? "warn" : null)">@(MeshLb.Failovers)</b><span>페일오버</span></span>
                <span class="gth-v96-m"><b class="ok">@(MeshLb.LastFailoverMs.ToString("0.000", CultureInfo.InvariantCulture))ms</b><span>최근 전환 소요</span></span>
            </div>
            @if (MeshLb.NodeCount > 0)
            {
                <div class="gth-v96-rows">
                    @for (var i = 0; i < MeshLb.NodeCount; i++)
                    {
                        var fp = MeshLb.FingerprintAt(i);
                        <div class="gth-v96-row-i @(fp.Health == PromptFlowStudio.Services.AI.Wan.MeshNodeHealth.Down ? "warn" : null)" @key="i">
                            <span>@(MeshLb.NodeIdAt(i))</span>
                            <span>@(fp.Health) · EWMA @(fp.EwmaLatencyMs.ToString("0.0", CultureInfo.InvariantCulture))ms · p95 @(fp.P95LatencyMs.ToString("0.0", CultureInfo.InvariantCulture))ms · @(fp.EwmaBandwidthMbps.ToString("0", CultureInfo.InvariantCulture))Mbps</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="gth-v96-empty">등록된 메시 노드 없음 - 데모 가동 시 합성 노드 4개 등록(실 네트워크 측정 아님)</div>
            }
            <div class="gth-v96-act">
                <button class="gth-v96-btn" @onclick="ToggleMeshDemo">@(MeshLb.Running ? "⏹ 정지" : "▶ 데모 가동")</button>
                <button class="gth-v96-btn" @onclick="KillMeshPrimary" disabled="@(!mr.HasRoute)">⚡ Primary 이탈</button>
                <button class="gth-v96-btn" @onclick="MeshLb.DemoReviveAll">♻ 복귀</button>
            </div>
            <div class="gth-v96-act">라우팅 @(MeshLb.RoutedRequests) · 재구성 @(MeshLb.Rebalances) · 최대 전환 @(MeshLb.MaxFailoverMs.ToString("0.000", CultureInfo.InvariantCulture))ms</div>
            <div class="gth-v96-act">실 프로브 @(MeshProbe.Running ? "가동" : "정지") · RTT 샘플 @(MeshProbe.RttSamples) · 최근 RTT @(MeshProbe.LastRttMs.ToString("0.00", CultureInfo.InvariantCulture))ms · 손실 @(MeshProbe.LossesRecorded) · 자동 페일오버 @(MeshProbe.FailoversTriggered)</div>
        </div>
    </div>

    @* ── v12.1.0: 네트워크 서비스 수명주기 관제 - P2P 노드 탐지 토글 + OBS 소켓 재연결 스위치 ── *@
    <div class="gth-v121f1">
        <div class="gth-v96-card lifecycle @(EdgeRelay.Running && Reaction.ConnectionState == PromptFlowStudio.Services.AI.Wan.ObsConnectionState.Identified ? "ok" : Reaction.ConnectionState == PromptFlowStudio.Services.AI.Wan.ObsConnectionState.Failed ? "warn" : null)">
            <div class="gth-v96-h">
                <b>🔌 서비스 수명주기</b>
                <span class="gth-v96-be">P2P @(EdgeRelay.Running ? "탐지 중" : "중지") · OBS @(Reaction.ConnectionState)</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="@(EdgeRelay.Running ? "ok" : null)">@(EdgeRelay.Peers.Count)</b><span>발견 피어</span></span>
                <span class="gth-v96-m"><b class="acc">@(EdgeRelay.PingsSent)/@(EdgeRelay.PongsReceived)</b><span>Ping/Pong</span></span>
                <span class="gth-v96-m"><b class="ok">@(EdgeRelay.PeerOffloads)</b><span>오프로드</span></span>
                <span class="gth-v96-m"><b class="@(EdgeRelay.Fallbacks > 0 ? "warn" : null)">@(EdgeRelay.Fallbacks)</b><span>로컬 폴백</span></span>
            </div>
            <div class="gth-v96-act">
                <label class="gth-v121-tg"><input type="checkbox" checked="@(EdgeRelay.Running)" @onchange="ToggleP2p" /> P2P 노드 탐지</label>
                <button class="gth-v96-btn" @onclick="PingP2p" disabled="@(!EdgeRelay.Running)">📡 Ping</button>
            </div>
            <div class="gth-v96-act">
                <input class="gth-v121-ip" @bind="_obsUrl" title="OBS WebSocket URL" />
                <input class="gth-v121-ip pw" type="password" @bind="_obsPw" placeholder="비밀번호(선택)" title="메모리에만 보관" />
            </div>
            <div class="gth-v96-act">
                <button class="gth-v96-btn" @onclick="ConnectObs" disabled="@(_obsBusy)">▶ 연결</button>
                <button class="gth-v96-btn" @onclick="ReconnectObs" disabled="@(_obsBusy || Reaction.LastServerUri is null)">↻ 재연결</button>
                <button class="gth-v96-btn" @onclick="DisconnectObs" disabled="@(_obsBusy || Reaction.ConnectionState == PromptFlowStudio.Services.AI.Wan.ObsConnectionState.Disconnected)">⏹ 해제</button>
            </div>
            <div class="gth-v96-act">@(_lifeNote ?? EdgeRelay.LastAction ?? "대기 중")</div>
        </div>
    </div>

    @* ── v11.2.0: OBS WebSocket 5.0 인터랙티브 리액션 엔진 관제(소켓상태/활성모드/큐/폭주방지/Fail-Safe) ── *@
    <div class="gth-v112f1">
        <div class="gth-v96-card reaction @(Reaction.ConnectionState == PromptFlowStudio.Services.AI.Wan.ObsConnectionState.Identified ? "ok" : Reaction.ConnectionState == PromptFlowStudio.Services.AI.Wan.ObsConnectionState.Failed ? "warn" : null)">
            <div class="gth-v96-h">🎮 인터랙티브 리액션(OBS)
                <span class="gth-v96-be">@(Reaction.ConnectionState) · 활성모드 @(Reaction.ActiveMode?.ToString() ?? "-")</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="acc">@(Reaction.EventsReceived)</b><span>수신 이벤트</span></span>
                <span class="gth-v96-m"><b class="ok">@(Reaction.Dispatched)</b><span>디스패치 완료</span></span>
                <span class="gth-v96-m"><b class="@(Reaction.QueueOverflows > 0 ? "warn" : null)">@(Reaction.QueueOverflows)</b><span>큐 오버플로우</span></span>
                <span class="gth-v96-m"><b class="@(Reaction.FailSafeResets > 0 ? "warn" : null)">@(Reaction.FailSafeResets)</b><span>Fail-Safe 원복</span></span>
            </div>
            @if (Reaction.RecentEvents.Count > 0)
            {
                <div class="gth-v96-rows">
                    @foreach (var ev in Reaction.RecentEvents.Take(5))
                    {
                        <div class="gth-v96-row-i" @key="@(ev.RawEventType + ev.At.Ticks)">
                            <span class="gth-v96-n">@(ev.Type)</span>
                            <span class="gth-v96-s">@(ev.RawEventType) · @(ev.At.ToLocalTime().ToString("HH:mm:ss"))</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="gth-v96-empty">아직 수신된 이벤트가 없습니다 - OBS WebSocket 5.0 서버에 ConnectAsync 로 접속하면 자동 수신됩니다.</div>
            }
            <div class="gth-v96-act">@(Reaction.LastAction ?? "대기 중")</div>
        </div>
    </div>

    @* ── v11.1.0: Win32 공유메모리 가상카메라 브로드캐스터(NDI 아님 - 정직 표기) 관제 ── *@
    <div class="gth-v111f1">
        <div class="gth-v96-card vcam @(VirtualCam.FramesDropped > 0 ? "warn" : VirtualCam.FramesSubmitted > 0 ? "ok" : null)">
            <div class="gth-v96-h">📡 가상카메라 파이프(공유메모리)
                <span class="gth-v96-be">전송 @(VirtualCam.FramesSubmitted) · 드롭 @(VirtualCam.FramesDropped)</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="acc">@(VirtualCam.EstimatedFps.ToString("0.#"))</b><span>추정 FPS(throughput)</span></span>
                <span class="gth-v96-m"><b>@(VirtualCam.LastFrameInfo is { } vf ? $"{vf.Width}x{vf.Height}" : "-")</b><span>해상도</span></span>
                <span class="gth-v96-m"><b class="@(VirtualCam.OccupancyPct > 80 ? "warn" : "ok")">@(VirtualCam.OccupancyPct.ToString("0.#"))<small>%</small></b><span>파이프 점유율</span></span>
                <span class="gth-v96-m"><b class="@(VirtualCam.MutexTimeouts > 0 ? "warn" : null)">@(VirtualCam.MutexTimeouts)</b><span>Mutex 타임아웃</span></span>
            </div>
            <div class="gth-v96-act">@(VirtualCam.LastAction ?? "대기 중 - OBS 등 리더 측 전용 플러그인 별도 필요(공유메모리 프로듀서만 제공)")</div>
        </div>
    </div>

    @* ── v11.0.0-F1: 멀티모달 오디오-모션 동기화 — Radix-2 FFT 도미넌트 주파수 + 비트 감지 → 모션 주입 관제 ── *@
    <div class="gth-v110f1">
        <div class="gth-v96-card audiosync @(Audio.BeatsDetected > 0 ? "ok" : null)">
            <div class="gth-v96-h">🎵 오디오-모션 동기화
                <span class="gth-v96-be">프레임 @(Audio.FramesAnalyzed) · 비트 @(Audio.BeatsDetected)</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="acc">@(Audio.Report.LastAmplitude.ToString("0.###"))</b><span>진폭(RMS)</span></span>
                <span class="gth-v96-m"><b class="up">@(Audio.Report.LastFrequencyHz.ToString("0"))<small>Hz</small></b><span>도미넌트 주파수</span></span>
                <span class="gth-v96-m"><b class="ok">@(Audio.MotionInjections)</b><span>모션 주입</span></span>
                <span class="gth-v96-m"><b class="@(Motion.LastApplied is not null ? "acc" : null)">@(Motion.LastApplied?.ZoomMagnitude.ToString("0.##") ?? "-")</b><span>최근 줌 강도</span></span>
            </div>
            @if (Motion.LastApplied is { } lastBeatVector)
            {
                <div class="gth-v96-rows">
                    <div class="gth-v96-row-i">
                        <span class="gth-v96-n">스텝 @(lastBeatVector.Step)</span>
                        <span class="gth-v96-s">Pan=@(lastBeatVector.Pan)(@(lastBeatVector.PanMagnitude.ToString("0.##"))) · Zoom=@(lastBeatVector.Zoom)(@(lastBeatVector.ZoomMagnitude.ToString("0.##"))) · Roll=@(lastBeatVector.RollDegrees.ToString("0.#"))°</span>
                    </div>
                </div>
            }
            else
            {
                <div class="gth-v96-empty">아직 비트가 감지되지 않았습니다 — 오디오 프레임 분석 중 에너지 급증이 감지되면 자동으로 카메라 모션이 주입됩니다.</div>
            }
            <div class="gth-v96-act">@(Audio.LastAction ?? "대기 중")</div>
        </div>
    </div>

    @* ── v10.6.0-F3: 동적 카메라 모션 제어(실시간 슬라이더) + LoRA 핫스왑(배지+Pause 게이트) 관제 ── *@
    <div class="gth-v106f3">
        <div class="gth-v96-card motion @(Motion.LastApplied is not null ? "ok" : null)">
            <div class="gth-v96-h">🎥 동적 카메라 모션 제어
                <span class="gth-v96-be">주입 @(Motion.Injected)회 · 대기 @(Motion.PendingCount)</span>
            </div>
            <div class="gth-v96-optlabel">Pan</div>
            <div class="gth-v96-row">
                <select class="gth-v96-btn" @onchange="OnPanDirChanged">
                    <option value="None">None</option><option value="Up">Up</option><option value="Down">Down</option><option value="Left">Left</option><option value="Right">Right</option>
                </select>
                <input type="range" min="0" max="1" step="0.05" value="@(_panMagSlider.ToString(CultureInfo.InvariantCulture))" @oninput="OnPanMagInput" />
                <span class="acd-slider-v">@(_panMagSlider.ToString("0.##", CultureInfo.InvariantCulture))</span>
            </div>
            <div class="gth-v96-optlabel">Zoom</div>
            <div class="gth-v96-row">
                <select class="gth-v96-btn" @onchange="OnZoomDirChanged">
                    <option value="None">None</option><option value="In">In</option><option value="Out">Out</option>
                </select>
                <input type="range" min="0" max="1" step="0.05" value="@(_zoomMagSlider.ToString(CultureInfo.InvariantCulture))" @oninput="OnZoomMagInput" />
                <span class="acd-slider-v">@(_zoomMagSlider.ToString("0.##", CultureInfo.InvariantCulture))</span>
            </div>
            <div class="gth-v96-optlabel">Roll</div>
            <div class="gth-v96-row">
                <input type="range" min="-45" max="45" step="1" value="@(_rollSlider.ToString(CultureInfo.InvariantCulture))" @oninput="OnRollInput" />
                <span class="acd-slider-v">@(_rollSlider.ToString("0", CultureInfo.InvariantCulture))°</span>
            </div>
            @if (Motion.LastApplied is { } mv)
            {
                <div class="gth-v96-hash">최근 주입 스텝 @(mv.Step) · Pan=@(mv.Pan)(@(mv.PanMagnitude.ToString("0.##", CultureInfo.InvariantCulture))) · Zoom=@(mv.Zoom)(@(mv.ZoomMagnitude.ToString("0.##", CultureInfo.InvariantCulture))) · Roll=@(mv.RollDegrees.ToString("0.#", CultureInfo.InvariantCulture))°</div>
            }
            <div class="gth-v96-row">
                <button class="gth-v96-btn chk" @onclick="RunMotionDemo">▶ 데모 주입(프레임 반영)</button>
                <button class="gth-v96-btn" @onclick="Motion.ResetAll">↻ 초기화</button>
            </div>
            <div class="gth-v96-act">@(Motion.LastAction ?? "대기 중")</div>
        </div>

        <div class="gth-v96-card lora @(Lora.LoopState != SamplingLoopState.Running ? "warn" : Lora.ActiveLoRAs.Count > 0 ? "ok" : null)">
            <div class="gth-v96-h">🎨 LoRA 핫스왑
                <span class="gth-v96-be">@(Lora.LoopState)</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="ok">@(Lora.Merges)</b><span>병합</span></span>
                <span class="gth-v96-m"><b class="warn">@(Lora.Unmerges)</b><span>해제</span></span>
                <span class="gth-v96-m"><b class="acc">@(Lora.Pauses)</b><span>Pause</span></span>
                <span class="gth-v96-m"><b class="up">@(Lora.LastPauseMs.ToString("0.#", CultureInfo.InvariantCulture))</b><span>ms/Pause</span></span>
            </div>
            @if (Lora.ActiveLoRAs.Count > 0)
            {
                <div class="gth-v96-tags">
                    @foreach (var lw in Lora.ActiveLoRAs)
                    {
                        <span class="gth-v96-tag" @key="lw.Id">@(lw.Id) ×@(lw.Strength.ToString("0.##", CultureInfo.InvariantCulture))</span>
                    }
                </div>
            }
            else
            {
                <div class="gth-v96-empty">활성화된 LoRA 가 없습니다.</div>
            }
            <div class="gth-v96-row">
                <button class="gth-v96-btn chk" @onclick="RunLoraMergeDemo" disabled="@(Lora.LoopState != SamplingLoopState.Running)">▶ 데모 LoRA 병합</button>
                <button class="gth-v96-btn stop" @onclick="RunLoraUnmergeDemo" disabled="@(Lora.LoopState != SamplingLoopState.Running || Lora.ActiveLoRAs.Count == 0)">✕ 마지막 해제</button>
                <button class="gth-v96-btn" @onclick="Lora.ResetAll">↻ 초기화</button>
            </div>
            <div class="gth-v96-act">@(Lora.LastAction ?? "대기 중")</div>
        </div>
    </div>

    <div class="gth-v106f2">
        <div class="gth-v96-card hetero @(HeteroScheduler.DualGpuMode ? "ok" : null)">
            <div class="gth-v96-h">🖥️ 이종 하드웨어 스케줄러
                <span class="gth-v96-be">@(HeteroScheduler.DualGpuMode ? "듀얼GPU 라우팅" : "단일GPU/폴백") · @(HeteroScheduler.Devices.Count)개 어댑터</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="up">@(HeteroScheduler.PrimaryTasks)</b><span>Primary</span></span>
                <span class="gth-v96-m"><b class="acc">@(HeteroScheduler.SecondaryTasks)</b><span>Secondary</span></span>
                <span class="gth-v96-m"><b class="ok">@(HeteroScheduler.Migrations)</b><span>마이그레이션</span></span>
                <span class="gth-v96-m"><b class="warn">@(HeteroScheduler.Report.LastMigrationMs.ToString("0.##", CultureInfo.InvariantCulture))</b><span>ms/마이그레이션</span></span>
            </div>
            @if (HeteroScheduler.Devices.Count > 0)
            {
                <div class="gth-v96-rows">
                    @foreach (var dev in HeteroScheduler.Devices)
                    {
                        <div class="gth-v96-row-i" @key="dev.Index">
                            <span class="gth-v96-n">#@(dev.Index) @(dev.Class)</span>
                            <span class="gth-v96-s">@(dev.Description)</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="gth-v96-empty">GPU 어댑터를 탐지하지 못했습니다(레지스트리 접근 불가/비-Windows) — 모든 작업이 단일 스레드풀 경로로 안전하게 폴백됩니다.</div>
            }
            <div class="gth-v96-row">
                <button class="gth-v96-btn chk" @onclick="RunHeteroDemo">▶ 데모 오프로드 실행</button>
                <button class="gth-v96-btn" @onclick="HeteroScheduler.ResetAll">↻ 재탐지+초기화</button>
            </div>
            <div class="gth-v96-act">@(HeteroScheduler.LastAction ?? "대기 중")</div>
        </div>
    </div>

    <div class="gth-v106">
        <div class="gth-v96-card wanpost @(PostProc.DirectMlCapable ? "ok" : null)">
            <div class="gth-v96-h">🎞️ Wan 2.1 후처리 파이프라인
                <span class="gth-v96-be">@(PostProc.DirectMlCapable ? "DirectML 가용" : "BCL 시뮬레이션") · ×@(PostProc.CurrentFactor == PromptFlowStudio.Services.Media.UpscaleTarget.Uhd8K ? 4 : 2)</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="up">@(PostProc.FramesIn)</b><span>입력프레임</span></span>
                <span class="gth-v96-m"><b class="acc">@(PostProc.Interpolated)</b><span>보간</span></span>
                <span class="gth-v96-m"><b class="ok">@(PostProc.Upscaled)</b><span>업스케일</span></span>
                <span class="gth-v96-m"><b class="warn">@(PostProc.Report.LastElapsedMs.ToString("0.##", CultureInfo.InvariantCulture))</b><span>ms/프레임</span></span>
            </div>
            @if (PostProc.LastInterpolatedDigest8 is { } interpDigest)
            {
                <div class="gth-v96-hash">최근 보간 프레임 지문 · @interpDigest</div>
            }
            <div class="gth-v96-row">
                <button class="gth-v96-btn chk" @onclick="RunPostProcessDemo">▶ 데모 프레임 제출</button>
                <button class="gth-v96-btn" @onclick="PostProc.ResetAll">↻ 초기화</button>
            </div>
            <div class="gth-v96-act">@(PostProc.LastAction ?? "대기 중")</div>
        </div>

        <div class="gth-v96-card wanpreview">
            <div class="gth-v96-h">🖼️ Latent 프로그레시브 프리뷰
                <span class="gth-v96-be">@(Previewer.Mapped ? "MMF" : "Pool") · 스텝 @(Math.Max(Previewer.LastStep, 0))/@(Previewer.TotalSteps)</span>
            </div>
            @if (Previewer.GetLatestPreviewDataUrl() is { } prevUrl)
            {
                <img class="gth-v106-canvas" src="@prevUrl" alt="Latent Preview" width="120" height="120" />
            }
            else
            {
                <div class="gth-v96-empty">아직 발행된 디노이징 스텝이 없습니다. 데모 스텝을 실행하면 프로그레시브 잠재 프레임 미리보기가 표시됩니다.</div>
            }
            <div class="gth-v96-row">
                <button class="gth-v96-btn chk" @onclick="RunPreviewStepDemo">▶ 데모 스텝 발행</button>
                <button class="gth-v96-btn" @onclick="Previewer.ResetAll">↻ 초기화</button>
            </div>
            <div class="gth-v96-act">@(Previewer.LastAction ?? "대기 중")</div>
        </div>
    </div>

    <div class="gth-v105f5">
        <div class="gth-v96-card hotfixsign @(HotfixSigner.Failures > 0 ? "warn" : HotfixSigner.Signed > 0 ? "ok" : null)">
            <div class="gth-v96-h">🔏 핫픽스 자동 서명기
                <span class="gth-v96-be">@(IntegrityValidator.Sha3Active ? "SHA3-256" : "SHA-256(폴백)")</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="ok">@(HotfixSigner.Signed)</b><span>서명완료</span></span>
                <span class="gth-v96-m"><b class="err">@(HotfixSigner.Failures)</b><span>실패</span></span>
                <span class="gth-v96-m"><b class="acc">@(HotfixSigner.LastResult?.Digest8 ?? "--------")</b><span>Digest8</span></span>
            </div>
            @if (HotfixSigner.LastResult is { } hres)
            {
                <div class="gth-v96-hash @(!hres.Ok ? "deny" : null)">
                    @(hres.ArtifactId) · @(hres.Algorithm) · @(hres.Ok ? "manifest+.sig 출력 완료" : hres.Note)
                </div>
            }
            else
            {
                <div class="gth-v96-empty">아직 서명 이력이 없습니다 — 데모 서명을 실행하면 hotfix-manifest.json + .sig 가 출력 폴더에 생성됩니다.</div>
            }
            <div class="gth-v96-row">
                <button class="gth-v96-btn chk" @onclick="RunHotfixAutoSign">▶ 데모 핫픽스 서명</button>
                <button class="gth-v96-btn" @onclick="OpenHotfixOutputFolder" title="@(HotfixSigner.OutputRoot)">📂 출력 폴더 열기</button>
                <button class="gth-v96-btn" @onclick="HotfixSigner.ResetAll">↻ 초기화</button>
            </div>
            <div class="gth-v96-act">@(HotfixSigner.LastAction ?? "대기 중")</div>
        </div>
    </div>

    @* ── v10.5.0-F4: OTLP 로그 리포트 시각화 — 최근 N건(기본 50) 성공률·PII 마스킹 총량·서킷브레이커 상태/전이 이력 ── *@
    <div class="gth-v105f4">
        <div class="gth-v96-card otlpviz @(Visualizer.Snapshot.CurrentState != ExportCircuitState.Closed ? "warn" : "ok")">
            <div class="gth-v96-h">📊 OTLP 로그 리포트 시각화
                <span class="gth-v96-be">@(Visualizer.Snapshot.CurrentState) · 윈도우 @(Visualizer.Snapshot.WindowSize)건</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="ok">@(Visualizer.Snapshot.Sent)</b><span>성공</span></span>
                <span class="gth-v96-m"><b class="err">@(Visualizer.Snapshot.Failed)</b><span>실패</span></span>
                <span class="gth-v96-m"><b class="acc">@(Visualizer.Snapshot.SuccessRatePct.ToString("0.#", CultureInfo.InvariantCulture))%</b><span>성공률</span></span>
                <span class="gth-v96-m"><b class="up">@(Visualizer.Snapshot.TotalMaskedFields)</b><span>PII마스킹</span></span>
            </div>
            @if (Visualizer.Snapshot.Sent + Visualizer.Snapshot.Failed > 0)
            {
                <div class="gth-v96-bar" title="최근 윈도우 성공/실패 비율">
                    <span class="gth-v97-seg ok" style="flex-grow:@(Visualizer.Snapshot.Sent)" title="성공 @(Visualizer.Snapshot.Sent)건"></span>
                    <span class="gth-v97-seg bad" style="flex-grow:@(Visualizer.Snapshot.Failed)" title="실패 @(Visualizer.Snapshot.Failed)건"></span>
                </div>
            }
            else
            {
                <div class="gth-v96-empty">아직 집계된 배치가 없습니다 — 아래 프로덕션 텔레메트리 익스포터의 오토파일럿을 시작하면 실시간으로 집계됩니다.</div>
            }
            <div class="gth-v96-hash">평균 소요 @(Visualizer.Snapshot.AvgElapsedMs.ToString("0.##", CultureInfo.InvariantCulture))ms · 서킷 전이 @(Visualizer.Snapshot.TransitionCount)건 · 집계 @(Visualizer.Updates)회</div>
            <div class="gth-v96-act">@(Visualizer.LastAction ?? "대기 중")</div>
        </div>
    </div>

    @* ── v10.5.0-F3: 하드웨어 자율 캘리브레이터 — CPU 프록시 반복 상수 호스트별 재정규화(24h TTL·스파이크 시 1.0 배율 폴백) ── *@
    <div class="gth-v105f3">
        <div class="gth-v96-card calib @(Calibrator.LastResult is { Ok: false } ? "warn" : Calibrator.LastResult is { Ok: true } ? "ok" : null)">
            <div class="gth-v96-h">⚙ 하드웨어 자율 캘리브레이터
                <span class="gth-v96-be">@(Calibrator.LastResult is null ? "미측정" : Calibrator.LastResult.Ok ? "정상" : "폴백")</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="up">@(Calibrator.Calibrations)</b><span>캘리브레이션</span></span>
                <span class="gth-v96-m"><b class="warn">@(Calibrator.Fallbacks)</b><span>폴백</span></span>
                <span class="gth-v96-m"><b class="acc">@(Calibrator.LastResult?.DynamicIterationMultiplier.ToString("0.###", CultureInfo.InvariantCulture) ?? "1.0")</b><span>배율</span></span>
                <span class="gth-v96-m"><b class="ok">@(Calibrator.LastResult?.EffectiveBaseIterations.ToString("N0", CultureInfo.InvariantCulture) ?? "18,500,000")</b><span>유효반복</span></span>
            </div>
            @if (Calibrator.LastResult is { } cr)
            {
                <div class="gth-v96-hash @(!cr.Ok ? "deny" : null)">
                    @(cr.MeasuredOpsPerMs.ToString("0", CultureInfo.InvariantCulture))ops/ms · 측정 @(cr.ElapsedMs.ToString("0.#", CultureInfo.InvariantCulture))ms · @(cr.At.ToLocalTime().ToString("HH:mm:ss", CultureInfo.InvariantCulture))
                </div>
            }
            else
            {
                <div class="gth-v96-empty">아직 캘리브레이션이 실행되지 않았습니다 — 벤치마커/라이브튜너 최초 사용 시 자동 1회 측정(24시간 TTL 캐시) 또는 아래 버튼으로 즉시 실행합니다.</div>
            }
            <div class="gth-v96-row">
                <button class="gth-v96-btn chk" @onclick="RunForceRecalibrate">🔄 지금 재캘리브레이션</button>
            </div>
            <div class="gth-v96-act">@(Calibrator.LastAction ?? "대기 중")</div>
        </div>
    </div>

    @* ── v10.5.0-F2: Wan 백엔드 커넥터(ComfyUI 원격 / DirectML 인프로세스) 자율 폴백 관제 ── *@
    <div class="gth-v105f2">
        <div class="gth-v96-card wanbackend @(BackendFactory.LastStatus is { ComfyUiAvailable: false } ? "warn" : BackendFactory.LastStatus is not null ? "ok" : null)">
            <div class="gth-v96-h">🔌 Wan 백엔드 커넥터
                <span class="gth-v96-be">@(BackendFactory.LastStatus?.Active.ToString() ?? "미확인")</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="up">@(BackendFactory.ProbeCount)</b><span>프로브</span></span>
                <span class="gth-v96-m"><b class="ok">@(BackendFactory.ComfySelections)</b><span>ComfyUI선택</span></span>
                <span class="gth-v96-m"><b class="acc">@(BackendFactory.DirectMlSelections)</b><span>인프로세스선택</span></span>
                <span class="gth-v96-m"><b class="@(BackendFactory.LastStatus?.ComfyUiAvailable == true ? "ok" : "warn")">@(BackendFactory.LastStatus?.ComfyUiAvailable == true ? "가용" : "미가동")</b><span>ComfyUI</span></span>
            </div>
            @if (_lastWanProgress is { } wp)
            {
                <div class="gth-v96-hash @(wp.Stage is WanBackendStage.Failed or WanBackendStage.Cancelled ? "deny" : null)">
                    작업 @(wp.JobId) · @(wp.Stage) @(wp.PercentComplete)% · @(wp.Message)
                </div>
            }
            else
            {
                <div class="gth-v96-empty">아직 스트리밍 이력이 없습니다. 테스트 작업을 제출하면 활성 백엔드(ComfyUI 또는 DirectML 인프로세스)를 자동 선택해 타일 단위 진행률을 실시간 표시합니다.</div>
            }
            <div class="gth-v96-row">
                <button class="gth-v96-btn chk" @onclick="RunWanBackendDemo" disabled="@_wanDemoRunning">▶ 테스트 작업 제출+스트리밍</button>
                <button class="gth-v96-btn stop" @onclick="CancelWanBackendDemo" disabled="@(!_wanDemoRunning)">⏹ 취소</button>
                <button class="gth-v96-btn" @onclick="BackendFactory.ForceRecheck">🔄 지금 재확인</button>
            </div>
            <div class="gth-v96-act">@(BackendFactory.LastAction ?? "대기 중")</div>
        </div>
    </div>

    @* ── v10.5.0-F1: 보안 시크릿 격리 볼트(DPAPI/환경변수) — Rule7 소급 적용 관제 ── *@
    <div class="gth-v105f1">
        <div class="gth-v96-card secvault @(SecretVault.InsecureFallbacks > 0 ? "warn" : SecretVault.Resolved > 0 ? "ok" : null)">
            <div class="gth-v96-h">🔐 보안 시크릿 볼트
                <span class="gth-v96-be">해석 @(SecretVault.Resolved) · 볼트경로 …\Keys</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="up">@(SecretVault.Resolved)</b><span>해석</span></span>
                <span class="gth-v96-m"><b class="acc">@(SecretVault.Generated)</b><span>신규생성</span></span>
                <span class="gth-v96-m"><b class="warn">@(SecretVault.InsecureFallbacks)</b><span>비보안폴백</span></span>
                <span class="gth-v96-m"><b class="ok">@(SecretVault.History.Count)</b><span>이력</span></span>
            </div>
            @if (SecretVault.History.Count > 0)
            {
                <div class="gth-v96-rows">
                    @foreach (var sr in SecretVault.History.Take(5))
                    {
                        <div class="gth-v96-row-i @(!sr.IsSecure ? "deg" : null)" @key="@(sr.KeyName + sr.At.Ticks)">
                            <span class="gth-v96-n">@(sr.KeyName)</span>
                            <span class="gth-v96-s">@(sr.Source) · @(sr.Note)</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="gth-v96-empty">아직 해석된 시크릿이 없습니다 — 위 서명/봉인 계열 서비스(QuantumResistantStateSealer 등)가 최초 생성될 때 자동으로 환경변수→DPAPI→폴백 순으로 해석됩니다.</div>
            }
            <div class="gth-v96-row">
                <button class="gth-v96-btn" @onclick="SecretVault.ResetHistory">↻ 이력 초기화(봉인값 유지)</button>
            </div>
            <div class="gth-v96-act">@(SecretVault.LastAction ?? "대기 중")</div>
        </div>
    </div>

    @* ── v10.2.0 Wan 실시간 성능 튜닝 & 벤치마킹 — 4/6/8GB 가상 스윕 · 라이브 양자화 튜너 · JSON/MD 리포트 ── *@
    <div class="gth-v102">
        <div class="gth-v96-card bench @(Bench.DemoRunning ? "ok" : null)">
            <div class="gth-v96-h">📊 Wan 성능 벤치마커
                <span class="gth-v96-be">@(Bench.DemoRunning ? "오토 스윕" : "정지") · 스윕 @(Bench.Sweeps)</span>
            </div>
            @if (Bench.LastReport is { } bsr)
            {
                <div class="gth-v96-bar" title="가상 VRAM 4/6/8GB 스윕">
                    @foreach (var t in bsr.Tiers)
                    {
                        <span class="gth-v97-seg @(t.Ok ? "ok" : "bad")" @key="t.BudgetMb" title="@(t.BudgetMb)MB · @(t.QuantUsed) · @(t.ThroughputFramesPerSec)fps · 피크@(t.PeakVramMb)MB"></span>
                    }
                </div>
                <div class="gth-v96-rows">
                    @foreach (var t in bsr.Tiers)
                    {
                        <div class="gth-v96-row-i @(!t.Ok ? "deg" : null)" @key="@("tier" + t.BudgetMb)">
                            <span class="gth-v96-n">@(t.BudgetMb)MB · @(t.QuantUsed)</span>
                            <span class="gth-v96-s">@(t.ThroughputFramesPerSec.ToString("0.#", CultureInfo.InvariantCulture))fps · P95 @(t.P95Ms.ToString("0.#", CultureInfo.InvariantCulture))/P99 @(t.P99Ms.ToString("0.#", CultureInfo.InvariantCulture))ms · 드랍@(t.DroppedFrames) · 피크@(t.PeakVramMb.ToString("0", CultureInfo.InvariantCulture))MB</span>
                        </div>
                    }
                </div>
                <div class="gth-v96-hash">최고처리량 @(bsr.BestThroughputBudgetMb)MB · 최저 @(bsr.WorstThroughputBudgetMb)MB · 스윕 @(bsr.SweepElapsedMs.ToString("0", CultureInfo.InvariantCulture))ms</div>
            }
            else
            {
                <div class="gth-v96-empty">스윕 이력이 없습니다. 4/6/8GB 가상 VRAM 예산에서 동일 워크로드(832×480@33f)의 실측 디코딩 속도/피크 메모리를 비교합니다.</div>
            }
            @if (Bench.LastRamp is { } rampRes)
            {
                <div class="gth-v96-hash">🌡️ 램프: 브레이킹포인트 ~@(rampRes.BreakingPointMb)MB · @(rampRes.StepsRun)스텝 · @(rampRes.QuantAtBreak) · @(rampRes.ElapsedMs.ToString("0.#", CultureInfo.InvariantCulture))ms</div>
            }
            <div class="gth-v96-row">
                <button class="gth-v96-btn" @onclick="ToggleBench">@(Bench.DemoRunning ? "⏸ 정지" : "▶ 오토 스윕(8s)")</button>
                <button class="gth-v96-btn chk" @onclick="RunSweepNow">📊 즉시 스윕</button>
                <button class="gth-v96-btn chk" @onclick="RunRampNow">🌡️ 동적 램프 스트레스</button>
                <button class="gth-v96-btn chk" @onclick="RunSaveReport" disabled="@(Bench.LastReport is null)">💾 리포트 저장</button>
                <button class="gth-v96-btn" @onclick="Bench.ResetAll">↻ 초기화</button>
            </div>
            <div class="gth-v96-act">@(_reportNote ?? Bench.LastAction ?? "대기 중")</div>
        </div>

        @{ var tun = LiveTuner.Snapshot; }
        <div class="gth-v96-card livetuner @(tun.CurrentQuant != WanQuantMode.Fp16 ? "warn" : null)">
            <div class="gth-v96-h">🎚 라이브 양자화 튜너
                <span class="gth-v96-be">@(tun.CurrentQuant) · EWMA @(tun.EwmaMs.ToString("0.#", CultureInfo.InvariantCulture))/@(tun.TargetMs.ToString("0", CultureInfo.InvariantCulture))ms</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="up">@(tun.FramesObserved)</b><span>프레임관측</span></span>
                <span class="gth-v96-m"><b class="warn">@(tun.Downgrades)</b><span>다운그레이드</span></span>
                <span class="gth-v96-m"><b class="ok">@(tun.Upgrades)</b><span>업그레이드</span></span>
                <span class="gth-v96-m"><b class="acc">@(tun.CurrentQuant)</b><span>현재</span></span>
            </div>
            <div class="gth-v96-hash">실행 중인 Wan 작업(오케스트레이터)의 타일마다 실측 소요시간을 통보받아 같은 작업 도중에도 양자화를 즉시 보정합니다 — 아래 파이프라인 오토파일럿을 가동하면 실시간으로 관측됩니다.</div>
            <div class="gth-v96-row">
                <button class="gth-v96-btn" @onclick="LiveTuner.ResetAll">↻ 초기화</button>
            </div>
            <div class="gth-v96-act">@(LiveTuner.LastAction ?? "대기 중")</div>
        </div>
    </div>

    @* ── v10.1.0 알리바바 Wan 2.1 저사양 가속(4~8GB VRAM) — 하드웨어 프로파일러 · 저사양 엔진 · 파이프라인 오케스트레이터 ── *@
    <div class="gth-wan101">
        <div class="gth-v96-card wanhw @(HwProfiler.LastProfile is { } hwp && !hwp.VramDetected ? "warn" : null)">
            <div class="gth-v96-h">🖥 적응형 하드웨어 프로파일러
                <span class="gth-v96-be">@(HwProfiler.LastProfile is { } hwb ? (hwb.VramDetected ? $"{hwb.VramMb}MB VRAM" : "미탐지(폴백)") : "미프로파일")</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="up">@(HwProfiler.ProfileCount)</b><span>프로파일</span></span>
                <span class="gth-v96-m"><b class="warn">@(HwProfiler.DownscaleCount)</b><span>다운스케일</span></span>
                <span class="gth-v96-m"><b class="err">@(HwProfiler.GiveUpCount)</b><span>포기</span></span>
                <span class="gth-v96-m"><b class="acc">@(HwProfiler.LastProfile?.RamMb ?? 0)</b><span>RAM MB</span></span>
            </div>
            @if (HwProfiler.LastProfile is { } hw)
            {
                <div class="gth-v96-hash">권장 티어 @(hw.RecommendedTier.DisplayName) · 탐지 @(hw.ProbedAt.ToLocalTime().ToString("HH:mm:ss", CultureInfo.InvariantCulture))</div>
            }
            @if (HwProfiler.LastDownscale is { } ds)
            {
                <div class="gth-v96-hash @(ds.Feasible ? null : "deny")">@(ds.Plan.Quant) · @(ds.FinalSpec.Width)x@(ds.FinalSpec.Height)@@@(ds.FinalSpec.Frames)f · @(ds.StepsApplied)단계 다운스케일 · @(ds.Plan.Note)</div>
            }
            <div class="gth-v96-row">
                <button class="gth-v96-btn chk" @onclick="RunProfileNow">🔍 즉시 프로파일</button>
            </div>
            <div class="gth-v96-act">@(_hwNote ?? "대기 중")</div>
        </div>

        @{ var wpRep = WanOrch.Report; }
        <div class="gth-v96-card wanpipe @(wpRep.Circuit != WanCircuitState.Closed ? "err" : WanOrch.DemoRunning ? "ok" : null)">
            <div class="gth-v96-h">🎬 Wan 파이프라인 오케스트레이터
                <span class="gth-v96-be">@(wpRep.Circuit) · 큐 @(wpRep.QueueDepth)</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="up">@(wpRep.Enqueued)</b><span>큐진입</span></span>
                <span class="gth-v96-m"><b class="ok">@(wpRep.Completed)</b><span>완료</span></span>
                <span class="gth-v96-m"><b class="err">@(wpRep.Failed)</b><span>실패</span></span>
                <span class="gth-v96-m"><b class="warn">@(wpRep.CircuitTrips)</b><span>서킷트립</span></span>
            </div>
            @if (WanOrch.RecentJobs.Count > 0)
            {
                <div class="gth-v96-rows">
                    @foreach (var jb in WanOrch.RecentJobs)
                    {
                        <div class="gth-v96-row-i @(!jb.Ok ? "deg" : null)" @key="@(jb.JobId + jb.Stage + jb.PercentComplete)">
                            <span class="gth-v96-n">@(jb.JobId)</span>
                            <span class="gth-v96-s">@(jb.Stage) @(jb.PercentComplete)%</span>
                        </div>
                    }
                </div>
            }
            <div class="gth-v96-row">
                <button class="gth-v96-btn" @onclick="ToggleWanOrch">@(WanOrch.DemoRunning ? "⏸ 정지" : "▶ 오토파일럿")</button>
                <button class="gth-v96-btn chk" @onclick="RunEnqueueHeavyJob">🎥 4K 과대 작업 투입</button>
                <button class="gth-v96-btn" @onclick="WanOrch.ResetAll">↻ 초기화</button>
            </div>
            <div class="gth-v96-act">@(WanOrch.LastAction ?? "대기 중")</div>
        </div>
    </div>

    @* ── v10.0.0-LTS: 핫픽스 패치 오케스트레이터 · 제로트러스트 프로덕션 텔레메트리 익스포터 ── *@
    <div class="gth-v100lts">
        <div class="gth-v96-card hotfix @(HotfixPatcher.RolledBackCount > 0 ? "warn" : HotfixPatcher.DemoRunning ? "ok" : null)">
            <div class="gth-v96-h">🩹 LTS 핫픽스 패처
                <span class="gth-v96-be">@(HotfixPatcher.DemoRunning ? "오토파일럿" : "정지")</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="up">@(HotfixPatcher.Staged)</b><span>스테이징</span></span>
                <span class="gth-v96-m"><b class="ok">@(HotfixPatcher.Applied)</b><span>적용</span></span>
                <span class="gth-v96-m"><b class="err">@(HotfixPatcher.Rejected)</b><span>거부</span></span>
                <span class="gth-v96-m"><b class="warn">@(HotfixPatcher.RolledBackCount)</b><span>롤백</span></span>
            </div>
            @if (HotfixPatcher.Packages.Count > 0)
            {
                <div class="gth-v96-nodes">
                    @foreach (var hp in HotfixPatcher.Packages)
                    {
                        <span class="gth-v96-node @(HotfixClass(hp.Stage))" @key="hp.Id" title="@(hp.Digest8) · 무결성@(hp.IntegrityOk ? "OK" : "?") · 호환성@(hp.CompatOk ? "OK" : "?")">@(hp.Id)</span>
                    }
                </div>
            }
            <div class="gth-v96-row">
                <button class="gth-v96-btn" @onclick="ToggleHotfixPatcher">@(HotfixPatcher.DemoRunning ? "⏸ 정지" : "▶ 오토파일럿")</button>
                <button class="gth-v96-btn chk" @onclick="RunStageAndApply">🩹 스테이징+적용</button>
                <button class="gth-v96-btn" @onclick="HotfixPatcher.ResetAll">↻ 초기화</button>
            </div>
            <div class="gth-v96-act">@(HotfixPatcher.LastAction ?? "대기 중")</div>
        </div>

        <div class="gth-v96-card prodexp @(ProdExporter.Circuit.State != ExportCircuitState.Closed ? "warn" : ProdExporter.DemoRunning ? "ok" : null)">
            <div class="gth-v96-h">📡 프로덕션 텔레메트리 익스포터
                <span class="gth-v96-be">@(ProdExporter.Circuit.State) · 버퍼 @(ProdExporter.BufferedCount)</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="up">@(ProdExporter.Sent)</b><span>전송</span></span>
                <span class="gth-v96-m"><b class="err">@(ProdExporter.Failed)</b><span>실패</span></span>
                <span class="gth-v96-m"><b class="acc">@(ProdExporter.BufferedCount)</b><span>버퍼</span></span>
                <span class="gth-v96-m"><b class="warn">@(_lastExportNote is not null ? "•" : "-")</b><span>PII마스킹</span></span>
            </div>
            <div class="gth-v96-row">
                <button class="gth-v96-btn" @onclick="ToggleProdExporter">@(ProdExporter.DemoRunning ? "⏸ 정지" : "▶ 오토파일럿")</button>
                <button class="gth-v96-btn chk" @onclick="RunPiiFlush">🔒 PII샘플+플러시</button>
                <button class="gth-v96-btn stop" @onclick="ProdExporter.InjectNetworkFault">💥 네트워크 장애</button>
                <button class="gth-v96-btn" @onclick="ProdExporter.ResetAll">↻ 초기화</button>
            </div>
            <div class="gth-v96-act">@(_lastExportNote ?? ProdExporter.LastAction ?? "대기 중")</div>
        </div>
    </div>

    @* ── v10.0.0 Enterprise Core Release: 감사 텔레메트리 집계 · 강화 정책 집행 · 자율 헬스 오케스트레이션 ── *@
    <div class="gth-v100">
        <div class="gth-v96-card audit @(AuditAgg.TamperFlags > 0 ? "err" : AuditAgg.DemoRunning ? "ok" : null)">
            <div class="gth-v96-h">📜 엔터프라이즈 감사 집계기
                <span class="gth-v96-be">@(AuditAgg.SpokeCount)스포크 · @(AuditAgg.DemoRunning ? "가동" : "정지")</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="up">@(AuditAgg.Submitted)</b><span>제출</span></span>
                <span class="gth-v96-m"><b class="err">@(AuditAgg.TamperFlags)</b><span>변조</span></span>
                <span class="gth-v96-m"><b class="acc">@(AuditAgg.RecentEntries.Count)</b><span>원장</span></span>
                <span class="gth-v96-m"><b class="ok">@(AuditAgg.Spokes.Count)</b><span>스포크</span></span>
            </div>
            <div class="gth-v96-nodes">
                @foreach (var sp in AuditAgg.Spokes)
                {
                    <span class="gth-v96-node lead" @key="sp.Id" title="Allow @(sp.Allow) · Deny @(sp.Deny) · Error @(sp.Error)">@(sp.Id)</span>
                }
            </div>
            @if (AuditAgg.RecentEntries.Count > 0)
            {
                <div class="gth-v96-rows">
                    @foreach (var e in AuditAgg.RecentEntries.Take(3))
                    {
                        <div class="gth-v96-row-i @(e.Result == AuditResult.Deny ? "deg" : null)" @key="e.Seq">
                            <span class="gth-v96-n">#@(e.Seq) @(e.Spoke)</span>
                            <span class="gth-v96-s">@(e.Action)→@(e.Result) · @(e.Hash8)</span>
                        </div>
                    }
                </div>
            }
            <div class="gth-v96-row">
                <button class="gth-v96-btn" @onclick="ToggleAuditAgg">@(AuditAgg.DemoRunning ? "⏸ 정지" : "▶ 시작")</button>
                <button class="gth-v96-btn stop" @onclick="AuditAgg.InjectChainTamper">✂ 원장 변조</button>
                <button class="gth-v96-btn chk" @onclick="RunVerifyChain">🔍 체인 검증</button>
                <button class="gth-v96-btn" @onclick="AuditAgg.ResetAll">↻ 초기화</button>
            </div>
            <div class="gth-v96-act">@(_auditNote ?? AuditAgg.LastAction ?? "대기 중")</div>
        </div>

        <div class="gth-v96-card policy @(PolicyEnforcer.Quarantines > 0 && _lastPolicy is { Allowed: false } ? "warn" : PolicyEnforcer.DemoRunning ? "ok" : null)">
            <div class="gth-v96-h">⚖ 강화 보안 정책 집행기
                <span class="gth-v96-be">rev @(PolicyEnforcer.RuleRevision) · @(PolicyEnforcer.DemoRunning ? "평가 중" : "정지")</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="up">@(PolicyEnforcer.Evaluations)</b><span>평가</span></span>
                <span class="gth-v96-m"><b class="err">@(PolicyEnforcer.Denies)</b><span>거부</span></span>
                <span class="gth-v96-m"><b class="warn">@(PolicyEnforcer.Quarantines)</b><span>격리</span></span>
                <span class="gth-v96-m"><b class="ok">@(PolicyEnforcer.Releases)</b><span>해제</span></span>
            </div>
            <div class="gth-v96-nodes">
                @foreach (var pr in PolicyEnforcer.Principals)
                {
                    <span class="gth-v96-node @(PrinClass(pr.State))" @key="pr.Id" title="위반 @(pr.Violations)회">@(pr.Id)</span>
                }
            </div>
            @if (_lastPolicy is { } lp)
            {
                <div class="gth-v96-hash @(lp.Allowed ? null : "deny")">@(lp.Allowed ? "ALLOW" : "DENY") · @(lp.Reason) · @(lp.DecisionHash8)</div>
            }
            <div class="gth-v96-row">
                <button class="gth-v96-btn" @onclick="TogglePolicyEnforcer">@(PolicyEnforcer.DemoRunning ? "⏸ 정지" : "▶ 시작")</button>
                <button class="gth-v96-btn chk" @onclick="RunPolicyEval">⚖ 평가 실행</button>
                <button class="gth-v96-btn stop" @onclick='() => PolicyEnforcer.InjectRepeatedViolations("guest-anon")'>🚫 반복 위반 주입</button>
                <button class="gth-v96-btn" @onclick="PolicyEnforcer.ResetAll">↻ 초기화</button>
            </div>
            <div class="gth-v96-act">@(PolicyEnforcer.LastAction ?? "대기 중")</div>
        </div>

        @{ var hRep = HealthOrch.Report; }
        <div class="gth-v96-card health @(hRep.Open > 0 ? "err" : hRep.HalfOpen > 0 ? "warn" : HealthOrch.DemoRunning ? "ok" : null)">
            <div class="gth-v96-h">💚 자율 헬스 오케스트레이터
                <span class="gth-v96-be">합성점수 @(hRep.CompositeScore.ToString("0.#", CultureInfo.InvariantCulture))</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="ok">@(hRep.Closed)</b><span>Closed</span></span>
                <span class="gth-v96-m"><b class="err">@(hRep.Open)</b><span>Open</span></span>
                <span class="gth-v96-m"><b class="warn">@(hRep.HalfOpen)</b><span>HalfOpen</span></span>
                <span class="gth-v96-m"><b class="acc">@(hRep.Recoveries)</b><span>회복</span></span>
            </div>
            <div class="gth-v96-nodes">
                @foreach (var br in HealthOrch.Breakers)
                {
                    <span class="gth-v96-node @(BreakerClass(br.State))" @key="br.Name" title="연속실패 @(br.ConsecutiveFailures) · 트립 @(br.Trips)">@(br.Name)@(br.CooldownSec > 0 ? " " + br.CooldownSec.ToString("0", CultureInfo.InvariantCulture) + "s" : null)</span>
                }
            </div>
            <div class="gth-v96-row">
                <button class="gth-v96-btn" @onclick="ToggleHealthOrch">@(HealthOrch.DemoRunning ? "⏸ 정지" : "▶ 시작")</button>
                <button class="gth-v96-btn stop" @onclick="HealthOrch.InjectRandomFailure" disabled="@(!HealthOrch.DemoRunning)">💥 무작위 장애</button>
                <button class="gth-v96-btn chk" @onclick="HealthOrch.ResetAll">↻ 초기화</button>
            </div>
            <div class="gth-v96-act">@(HealthOrch.LastAction ?? "대기 중")</div>
        </div>
    </div>

    @* ── v9.9.0 스웜 합의 엔진 · 양자 저항 상태 봉인기 · 자기 최적화 파이프라인 튜너 ── *@
    <div class="gth-v99">
        <div class="gth-v96-card cons @(Consensus99.DemoRunning ? "ok" : null)">
            <div class="gth-v96-h">🗳 스웜 합의 엔진(bFT)
                <span class="gth-v96-be">@(Consensus99.DemoRunning ? "라운드 가동" : "정지") · 제안자 @(Consensus99.ProposerId)</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="up">@(Consensus99.Rounds)</b><span>라운드</span></span>
                <span class="gth-v96-m"><b class="ok">@(Consensus99.CommittedCount)</b><span>커밋</span></span>
                <span class="gth-v96-m"><b class="warn">@(Consensus99.ViewChanges)</b><span>뷰체인지</span></span>
                <span class="gth-v96-m"><b class="err">@(Consensus99.Isolations)</b><span>격리</span></span>
            </div>
            <div class="gth-v96-nodes">
                @foreach (var ag in Consensus99.Agents)
                {
                    <span class="gth-v96-node @(ConsClass(ag))" @key="ag.Id" title="스트라이크 @(ag.Strikes) · 투표 @(ag.VotesCast)">@(ag.Role == ConsensusAgentRole.Proposer ? "★" : null)@(ag.Id)</span>
                }
            </div>
            <div class="gth-v96-row">
                <button class="gth-v96-btn" @onclick="ToggleConsensus99">@(Consensus99.DemoRunning ? "⏸ 정지" : "▶ 시작")</button>
                <button class="gth-v96-btn chk" @onclick="RunConsensusRound">🗳 라운드 실행</button>
                <button class="gth-v96-btn stop" @onclick="Consensus99.InjectByzantine" disabled="@(!Consensus99.DemoRunning)">🎭 비잔틴 주입</button>
                <button class="gth-v96-btn stop" @onclick="Consensus99.InjectProposerDown" disabled="@(!Consensus99.DemoRunning)">💀 제안자 다운</button>
                <button class="gth-v96-btn" @onclick="Consensus99.ResetAll">↻ 초기화</button>
            </div>
            <div class="gth-v96-act">@(Consensus99.LastAction ?? "대기 중")</div>
        </div>

        <div class="gth-v96-card seal2 @(_sealerNote is not null && _sealerNote.Contains("변조") ? "err" : StateSealer.DemoRunning ? "ok" : null)">
            <div class="gth-v96-h">🧬 양자 저항 상태 봉인기
                <span class="gth-v96-be">@(StateSealer.Mapped ? "MMF" : "Pool") · v@(StateSealer.CurrentVersion)</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="up">@(StateSealer.Seals)</b><span>봉인</span></span>
                <span class="gth-v96-m"><b class="acc">@(StateSealer.Verifies)</b><span>검증</span></span>
                <span class="gth-v96-m"><b class="err">@(StateSealer.Tampers)</b><span>변조</span></span>
                <span class="gth-v96-m"><b class="ok">@(StateSealer.Rollbacks)</b><span>롤백</span></span>
            </div>
            <div class="gth-v96-bar" title="8슬롯 스냅샷 링">
                @foreach (var s in StateSealer.Snapshots)
                {
                    <span class="gth-v97-seg @(SnapClass(s.State))" @key="s.Slot" title="슬롯#@(s.Slot) v@(s.Version) @(s.Digest8) · @(s.State)"></span>
                }
            </div>
            <div class="gth-v96-row">
                <button class="gth-v96-btn" @onclick="ToggleStateSealer">@(StateSealer.DemoRunning ? "⏸ 정지" : "▶ 주기 봉인")</button>
                <button class="gth-v96-btn chk" @onclick="RunSealSnapshot">🧬 스냅샷 봉인</button>
                <button class="gth-v96-btn stop" @onclick="StateSealer.InjectTamper">✂ 변조 주입</button>
                <button class="gth-v96-btn chk" @onclick="RunVerifySealer">🔍 검증·복구</button>
                <button class="gth-v96-btn" @onclick="StateSealer.ResetAll">↻ 초기화</button>
            </div>
            <div class="gth-v96-act">@(_sealerNote ?? StateSealer.LastAction ?? "대기 중")</div>
        </div>

        @{ var pidSt = PidTuner.State; }
        <div class="gth-v96-card pid @(PidTuner.DemoRunning ? "ok" : null)">
            <div class="gth-v96-h">🎚 자기 최적화 PID 튜너
                <span class="gth-v96-be">품질 @(pidSt.Quality.ToString("0.00", CultureInfo.InvariantCulture)) · 동시성 @(pidSt.Concurrency.ToString("0.0", CultureInfo.InvariantCulture))</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="@(pidSt.VramPct >= 90 ? "err" : "up")">@(pidSt.VramPct.ToString("0", CultureInfo.InvariantCulture))</b><span>VRAM%</span></span>
                <span class="gth-v96-m"><b class="warn">@(pidSt.LatencyMs.ToString("0", CultureInfo.InvariantCulture))</b><span>지연ms</span></span>
                <span class="gth-v96-m"><b class="@(pidSt.ErrorSignal >= 0 ? "ok" : "err")">@(pidSt.ErrorSignal.ToString("0.0", CultureInfo.InvariantCulture))</b><span>오차</span></span>
                <span class="gth-v96-m"><b class="acc">@(PidTuner.Corrections)</b><span>보정</span></span>
            </div>
            <div class="gth-v96-hash">적분항 @(pidSt.Integral.ToString("0.00", CultureInfo.InvariantCulture)) · 포화 @(PidTuner.SaturationHits)회 · 틱 @(PidTuner.Ticks)</div>
            <div class="gth-v96-row">
                <button class="gth-v96-btn" @onclick="TogglePidTuner">@(PidTuner.DemoRunning ? "⏸ 정지" : "▶ 시작")</button>
                <button class="gth-v96-btn stop" @onclick="PidTuner.InjectVramPressure" disabled="@(!PidTuner.DemoRunning)">🧨 VRAM 압박</button>
                <button class="gth-v96-btn stop" @onclick="PidTuner.InjectLatencySpike" disabled="@(!PidTuner.DemoRunning)">⏱ 지연 스파이크</button>
                <button class="gth-v96-btn chk" @onclick="PidTuner.ResetAll">↻ 초기화</button>
            </div>
            <div class="gth-v96-act">@(PidTuner.LastAction ?? "대기 중")</div>
        </div>
    </div>

    @* ── v9.8.0 자율 뉴럴 타일링 업스케일러 · 기밀 컴퓨팅 증명기 · 적응형 멀티클라우드 페일오버 ── *@
    <div class="gth-v98">
        <div class="gth-v96-card ups @(Upscaler.DemoRunning ? "ok" : null)">
            <div class="gth-v96-h">🧩 뉴럴 타일링 업스케일러
                <span class="gth-v96-be">@(Upscaler.Mapped ? "MMF" : "Pool") · @(Upscaler.Target) · @(Upscaler.ArenaMb)MB</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="up">@(Upscaler.Runs)</b><span>런</span></span>
                <span class="gth-v96-m"><b class="acc">@(Upscaler.TilesInferred)</b><span>타일</span></span>
                <span class="gth-v96-m"><b class="ok">@(Upscaler.SeamsBlended)</b><span>블렌드</span></span>
                <span class="gth-v96-m"><b class="warn">@(Upscaler.DepthCorrections)</b><span>뎁스</span></span>
            </div>
            <div class="gth-v96-bar" title="@(Upscaler.Target) 타일">
                @foreach (var t in Upscaler.Tiles)
                {
                    <span class="gth-v97-seg @(TileClass(t.State))" @key="t.Index" title="#@(t.Index) r@(t.Row)c@(t.Col) · @(t.State) · +@(t.SharpnessGain)"></span>
                }
            </div>
            @if (Upscaler.LastReport is { } upsRep)
            {
                <div class="gth-v96-hash">@(upsRep.Cols)×@(upsRep.Rows) · ×@(upsRep.ScaleFactor.ToString("0.#", CultureInfo.InvariantCulture)) · @(upsRep.MegaPixels.ToString("0.#", CultureInfo.InvariantCulture))Mpx · @(upsRep.ThroughputMpxS.ToString("0", CultureInfo.InvariantCulture))Mpx/s · @(upsRep.ElapsedMs.ToString("0.##", CultureInfo.InvariantCulture))ms</div>
            }
            else
            {
                <div class="gth-v96-empty">업스케일 이력이 없습니다. MMF 무할당 아레나에 타일을 분할 추론하고 공간 뎁스 보정·심 블렌딩으로 4K/8K 텐서를 업스케일합니다.</div>
            }
            <div class="gth-v96-row">
                <button class="gth-v96-btn" @onclick="ToggleUpscaler">@(Upscaler.DemoRunning ? "⏸ 정지" : "▶ 시작")</button>
                <button class="gth-v96-btn chk" @onclick="RunUpscale">⤴ 업스케일</button>
                <button class="gth-v96-btn chk" @onclick="() => Upscaler.SetTarget(PromptFlowStudio.Services.Media.UpscaleTarget.Uhd4K)">4K</button>
                <button class="gth-v96-btn chk" @onclick="() => Upscaler.SetTarget(PromptFlowStudio.Services.Media.UpscaleTarget.Uhd8K)">8K</button>
                <button class="gth-v96-btn stop" @onclick="Upscaler.InjectDepthDrift">🌀 뎁스 드리프트</button>
                <button class="gth-v96-btn" @onclick="Upscaler.ResetAll">↻ 초기화</button>
            </div>
            <div class="gth-v96-act">@(Upscaler.LastAction ?? "대기 중")</div>
        </div>

        <div class="gth-v96-card att @(Attestor.LastReport is { } attTop ? (attTop.State == AttestState.Trusted ? "ok" : attTop.State == AttestState.Degraded ? "warn" : "err") : null)">
            <div class="gth-v96-h">🛡 기밀 컴퓨팅 증명기
                <span class="gth-v96-be">@(Attestor.LastReport is { } attHd ? attHd.State.ToString() : "미증명") · 지문 @(Attestor.LastReport?.Fingerprint8 ?? "--------")</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="up">@(Attestor.Attestations)</b><span>증명</span></span>
                <span class="gth-v96-m"><b class="ok">@(Attestor.QuotesValid)</b><span>유효</span></span>
                <span class="gth-v96-m"><b class="err">@(Attestor.TamperDetected)</b><span>변조</span></span>
                <span class="gth-v96-m"><b class="warn">@(Attestor.ZtnaDenied)</b><span>ZTNA거부</span></span>
            </div>
            <div class="gth-v96-nodes">
                @foreach (var c in Attestor.ClaimViews)
                {
                    <span class="gth-v96-node @(ClaimClass(c.Passed))" @key="c.Kind" title="@(c.Digest8)">@(c.Kind) @(c.Passed ? "✓" : "✗")</span>
                }
            </div>
            @if (Attestor.LastReport is { } attRep)
            {
                <div class="gth-v96-hash @(attRep.QuoteValid ? null : "deny")">quote @(attRep.QuoteValid ? "유효" : "무효") · @(attRep.Passed)/@(attRep.Total) PCR · 포스처 @(attRep.PostureScore.ToString("0.00", CultureInfo.InvariantCulture)) · nonce @(attRep.Nonce8)</div>
            }
            <div class="gth-v96-row">
                <button class="gth-v96-btn" @onclick="ToggleAttestor">@(Attestor.DemoRunning ? "⏸ 정지" : "▶ 주기 증명")</button>
                <button class="gth-v96-btn chk" @onclick="RunAttest">🔎 증명</button>
                <button class="gth-v96-btn stop" @onclick="Attestor.InjectEnclaveTamper">✂ 엔클레이브 변조</button>
                <button class="gth-v96-btn stop" @onclick="Attestor.InjectPostureDrop">📉 포스처 저하</button>
                <button class="gth-v96-btn" @onclick="Attestor.ResetAll">↻ 초기화</button>
            </div>
            <div class="gth-v96-act">@(Attestor.LastAction ?? "대기 중")</div>
        </div>

        @{ var fovRep = Failover.Report; }
        <div class="gth-v96-card fo @(fovRep.Healthy <= 1 ? "err" : Failover.DemoRunning ? "ok" : null)">
            <div class="gth-v96-h">☁ 멀티클라우드 페일오버
                <span class="gth-v96-be">활성 @(fovRep.Active) · SLA @(fovRep.SlaBudgetMs.ToString("0", CultureInfo.InvariantCulture))ms</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="warn">@(fovRep.Failovers)</b><span>페일오버</span></span>
                <span class="gth-v96-m"><b class="up">@(fovRep.SessionsMigrated)</b><span>마이그레이션</span></span>
                <span class="gth-v96-m"><b class="err">@(fovRep.Losses)</b><span>유실</span></span>
                <span class="gth-v96-m"><b class="@(fovRep.LastSwitchMs <= fovRep.SlaBudgetMs ? "ok" : "err")">@(fovRep.LastSwitchMs.ToString("0.##", CultureInfo.InvariantCulture))</b><span>스위치ms</span></span>
            </div>
            <div class="gth-v96-nodes">
                @foreach (var n in Failover.Nodes)
                {
                    <span class="gth-v96-node @(RouteClass(n.State))" @key="n.Region" title="@(n.State) · 손실 @(n.LossPct)% · 세션 @(n.Sessions)">@(n.IsActive ? "★" : null)@(n.Region) @(n.RttMs.ToString("0", CultureInfo.InvariantCulture))ms</span>
                }
            </div>
            <div class="gth-v96-row">
                <button class="gth-v96-btn" @onclick="ToggleFailover">@(Failover.DemoRunning ? "⏸ 정지" : "▶ 시작")</button>
                <button class="gth-v96-btn stop" @onclick="Failover.InjectNodeDown" disabled="@(!Failover.DemoRunning)">💥 노드 다운</button>
                <button class="gth-v96-btn stop" @onclick="Failover.InjectLatencySpike" disabled="@(!Failover.DemoRunning)">⏱ RTT 스파이크</button>
                <button class="gth-v96-btn chk" @onclick="Failover.ResetAll">↻ 초기화</button>
            </div>
            <div class="gth-v96-act">@(Failover.LastAction ?? "대기 중")</div>
        </div>
    </div>

    @* ── v9.7.0 자율 스웜 가버넌스 · 양자 스토리지 봉인 · 자기 최적화 멀티모달 파이프라인 ── *@
    <div class="gth-v97">
        @{ var sgRep = SwarmGov.Report; }
        <div class="gth-v96-card gov @(!sgRep.QuorumMet ? "err" : SwarmGov.DemoRunning ? "ok" : null)">
            <div class="gth-v96-h">🕸 자율 스웜 가버넌스
                <span class="gth-v96-be">@(SwarmGov.DemoRunning ? "감시 중" : "정지") · 리더 @(string.IsNullOrEmpty(SwarmGov.Leader) ? "부재" : SwarmGov.Leader)</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="@(sgRep.QuorumMet ? "ok" : "err")">@(sgRep.Healthy)/@(sgRep.Total)</b><span>쿼럼@(sgRep.Quorum)</span></span>
                <span class="gth-v96-m"><b class="up">@(SwarmGov.Rebalances)</b><span>리밸런스</span></span>
                <span class="gth-v96-m"><b class="acc">@(SwarmGov.Elections)</b><span>재선출</span></span>
                <span class="gth-v96-m"><b class="err">@(SwarmGov.Evictions)</b><span>격리</span></span>
            </div>
            <div class="gth-v96-nodes">
                @foreach (var p in SwarmGov.Peers)
                {
                    <span class="gth-v96-node @(GovClass(p.State))" @key="p.Id" title="@(p.Kind) · 부하 @(p.LoadPct)% · 미스 @(p.MissedBeats)">@(p.IsLeader ? "★" : null)@(p.Id) @(p.LoadPct.ToString("0", CultureInfo.InvariantCulture))%</span>
                }
            </div>
            <div class="gth-v96-row">
                <button class="gth-v96-btn" @onclick="ToggleSwarmGov">@(SwarmGov.DemoRunning ? "⏸ 정지" : "▶ 시작")</button>
                <button class="gth-v96-btn stop" @onclick="SwarmGov.InjectPeerFault" disabled="@(!SwarmGov.DemoRunning)">💔 하트비트 유실</button>
                <button class="gth-v96-btn stop" @onclick="SwarmGov.InjectLoadSpike" disabled="@(!SwarmGov.DemoRunning)">📈 부하 급증</button>
                <button class="gth-v96-btn chk" @onclick="SwarmGov.ResetAll">↻ 초기화</button>
            </div>
            <div class="gth-v96-act">@(SwarmGov.LastAction ?? "대기 중")</div>
        </div>

        <div class="gth-v96-card seal @(StorageSeal.LastReport is { } ssTop ? (ssTop.RootValid ? "ok" : "err") : null)">
            <div class="gth-v96-h">🔏 양자 스토리지 봉인
                <span class="gth-v96-be">Merkle+PQC · 루트 @(StorageSeal.LastReport?.RootHash8 ?? "미스캔")</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="up">@(StorageSeal.Seals)</b><span>봉인</span></span>
                <span class="gth-v96-m"><b class="acc">@(StorageSeal.Scans)</b><span>스캔</span></span>
                <span class="gth-v96-m"><b class="err">@(StorageSeal.TampersDetected)</b><span>변조</span></span>
                <span class="gth-v96-m"><b class="ok">@(StorageSeal.Recoveries)</b><span>복구</span></span>
            </div>
            <div class="gth-v96-bar" title="@(StorageSeal.SegmentCount)세그먼트">
                @foreach (var sg in StorageSeal.Segments)
                {
                    <span class="gth-v97-seg @(SegClass(sg.State))" @key="sg.Index" title="#@(sg.Index) @(sg.Hash8) · @(sg.State)"></span>
                }
            </div>
            @if (StorageSeal.LastReport is { } ssRep)
            {
                <div class="gth-v96-hash @(ssRep.RootValid ? null : "deny")">서명 @(ssRep.Signature8) · 변조 @(ssRep.Tampered) · 복구 @(ssRep.Recovered) · @(ssRep.ElapsedMs.ToString("0.##", CultureInfo.InvariantCulture))ms</div>
            }
            else
            {
                <div class="gth-v96-empty">봉인 이력이 없습니다. 12세그먼트를 SHA-256 Merkle 트리로 봉인·루트를 PQC 서명해 변조를 상수시간 검출·복제본에서 자율 복구합니다.</div>
            }
            <div class="gth-v96-row">
                <button class="gth-v96-btn" @onclick="ToggleStorageSeal">@(StorageSeal.DemoRunning ? "⏸ 스캔 정지" : "▶ 주기 스캔")</button>
                <button class="gth-v96-btn chk" @onclick="RunStorageScan">🔍 스캔</button>
                <button class="gth-v96-btn stop" @onclick="StorageSeal.InjectTamper">✂ 변조 주입</button>
                <button class="gth-v96-btn chk" @onclick="StorageSeal.SealAll">🔏 재봉인</button>
                <button class="gth-v96-btn" @onclick="StorageSeal.ResetAll">↻ 초기화</button>
            </div>
            <div class="gth-v96-act">@(StorageSeal.LastAction ?? "대기 중")</div>
        </div>

        @{ var optSt = SelfOpt.State; }
        <div class="gth-v96-card opt @(optSt.Tier >= TuneTier.Eco ? "warn" : SelfOpt.DemoRunning ? "ok" : null)">
            <div class="gth-v96-h">🎛 자기 최적화 파이프라인
                <span class="gth-v96-be">@(optSt.Tier) · @(optSt.TileRes)p/@(optSt.TargetFps)fps</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="@(optSt.VramPct >= 90 ? "err" : "up")">@(optSt.VramPct.ToString("0", CultureInfo.InvariantCulture))</b><span>VRAM%</span></span>
                <span class="gth-v96-m"><b class="@(optSt.GpuLatencyMs >= 60 ? "err" : "warn")">@(optSt.GpuLatencyMs.ToString("0", CultureInfo.InvariantCulture))</b><span>지연ms</span></span>
                <span class="gth-v96-m"><b class="ok">@(optSt.AchievedFps.ToString("0", CultureInfo.InvariantCulture))</b><span>실측fps</span></span>
                <span class="gth-v96-m"><b class="acc">@(optSt.InterpFrames)</b><span>보간</span></span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="up">@(SelfOpt.Upshifts)</b><span>업시프트</span></span>
                <span class="gth-v96-m"><b class="warn">@(SelfOpt.Downshifts)</b><span>다운시프트</span></span>
                <span class="gth-v96-m"><b class="acc">@(SelfOpt.Adjusts)</b><span>조정</span></span>
                <span class="gth-v96-m"><b class="err">@(SelfOpt.Throttles)</b><span>스로틀</span></span>
            </div>
            <div class="gth-v96-row">
                <button class="gth-v96-btn" @onclick="ToggleSelfOpt">@(SelfOpt.DemoRunning ? "⏸ 정지" : "▶ 시작")</button>
                <button class="gth-v96-btn stop" @onclick="SelfOpt.InjectVramPressure" disabled="@(!SelfOpt.DemoRunning)">🧨 VRAM 압박</button>
                <button class="gth-v96-btn stop" @onclick="SelfOpt.InjectLatencySpike" disabled="@(!SelfOpt.DemoRunning)">⏱ 지연 스파이크</button>
                <button class="gth-v96-btn chk" @onclick="SelfOpt.ResetAll">↻ 초기화</button>
            </div>
            <div class="gth-v96-act">@(SelfOpt.LastAction ?? "대기 중")</div>
        </div>
    </div>

    @* ── v9.6.0 자율 뉴럴 메모리 스트리머 · 양자 내성 신원 연합 · 실시간 이상 감지 센티널 ── *@
    <div class="gth-v96">
        <div class="gth-v96-card mem @(NeuralMem.LastReport is { } nr ? (nr.ChecksumFailures > 0 ? "err" : "ok") : null)">
            <div class="gth-v96-h">🧠 뉴럴 메모리 스트리머
                <span class="gth-v96-be">@(NeuralMem.IsMapped ? "MMF" : "Pool 강등") · @(MemMb(NeuralMem.CapacityBytes))MB</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="up">@(MemMb(NeuralMem.MappedBytes))</b><span>MMF MB</span></span>
                <span class="gth-v96-m"><b class="warn">@(MemMb(NeuralMem.PooledBytes))</b><span>Pool MB</span></span>
                <span class="gth-v96-m"><b class="acc">@(NeuralMem.Evictions)</b><span>강등</span></span>
                <span class="gth-v96-m"><b class="err">@(NeuralMem.ChecksumFailures)</b><span>체크섬</span></span>
            </div>
            @if (NeuralMem.LastReport is { } rep)
            {
                <div class="gth-v96-bar" title="MMF @(rep.Mapped) · Pool @(rep.Pooled)">
                    <span class="map" style="flex:@(rep.Mapped.ToString(CultureInfo.InvariantCulture))"></span>
                    <span class="pool" style="flex:@(rep.Pooled.ToString(CultureInfo.InvariantCulture))"></span>
                </div>
                <div class="gth-v96-hash">@(rep.Tensors)텐서 · @(rep.Chunks)청크 · @(rep.ThroughputMBps.ToString("0.#", CultureInfo.InvariantCulture))MB/s · @(rep.ElapsedMs.ToString("0.##", CultureInfo.InvariantCulture))ms</div>
            }
            else
            {
                <div class="gth-v96-empty">스트리밍 이력이 없습니다. 13텐서(16MB)를 MMF 아레나에 적재하고 Channel 청크 체인 체크섬으로 무복사 스트리밍합니다.</div>
            }
            <div class="gth-v96-row">
                <button class="gth-v96-btn" @onclick="RunNeuralMem" disabled="@_memBusy">🧠 적재·스트리밍</button>
                <button class="gth-v96-btn chk" @onclick="StreamNeuralMem" disabled="@_memBusy">▶ 재스트리밍</button>
                <button class="gth-v96-btn stop" @onclick="FlipNeuralMem" disabled="@_memBusy">⚡ 비트 플립</button>
                <button class="gth-v96-btn" @onclick="ReleaseNeuralMem" disabled="@_memBusy">🗑 해제</button>
            </div>
            <div class="gth-v96-act">@(_memNote ?? NeuralMem.LastError ?? NeuralMem.LastAction ?? "대기 중")</div>
        </div>

        <div class="gth-v96-card fed @(IdFed.LastExchange is { } lx ? (lx.Granted ? "ok" : "warn") : null)">
            <div class="gth-v96-h">🔐 양자 내성 신원 연합
                <span class="gth-v96-be">ES384+ML-DSA-65 · jti @(IdFed.ReplayCacheSize)</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="ok">@(IdFed.GrantedCount)</b><span>승인</span></span>
                <span class="gth-v96-m"><b class="err">@(IdFed.DeniedCount)</b><span>거부</span></span>
                <span class="gth-v96-m"><b class="up">@(IdFed.IssuedCount)</b><span>발급</span></span>
                <span class="gth-v96-m"><b class="acc">@(_fedClusters.Count)</b><span>클러스터</span></span>
            </div>
            @if (_fedClusters.Count > 0)
            {
                <div class="gth-v96-caps">
                    @foreach (var fc in _fedClusters)
                    {
                        <span class="gth-v96-cap" @key="fc.Id" title="키 지문 @(fc.KeyFingerprint) · 신뢰 피어 @(string.Join(", ", fc.TrustedPeers))">@(fc.Id) · gen @(fc.Generation)</span>
                    }
                </div>
                @if (IdFed.LastExchange is { } ex)
                {
                    <div class="gth-v96-hash @(ex.Granted ? null : "deny")">@(ex.FromCluster)→@(ex.ToCluster) · @(FedScopes(ex)) · @(ex.ElapsedMs.ToString("0.###", CultureInfo.InvariantCulture))ms</div>
                }
            }
            else
            {
                <div class="gth-v96-empty">연합이 없습니다. 3클러스터를 시드하면 하이브리드 서명·재생·mTLS 바인딩·ZTNA 포스처를 교차 클러스터 토큰 교환으로 실측합니다.</div>
            }
            <div class="gth-v96-row">
                <button class="gth-v96-btn" @onclick="SeedFederation">🌐 연합 시드</button>
                <button class="gth-v96-btn chk" @onclick="@(() => RunFed(IdFed.DemoValid))" disabled="@(_fedClusters.Count == 0)">✔ 정상 교환</button>
                <button class="gth-v96-btn stop" @onclick="@(() => RunFed(IdFed.DemoReplay))" disabled="@(_fedClusters.Count == 0)">♻ 재생</button>
                <button class="gth-v96-btn stop" @onclick="@(() => RunFed(IdFed.DemoStolen))" disabled="@(_fedClusters.Count == 0)">🕵 탈취</button>
                <button class="gth-v96-btn stop" @onclick="@(() => RunFed(IdFed.DemoForgedPqc))" disabled="@(_fedClusters.Count == 0)">✂ PQC 위조</button>
                <button class="gth-v96-btn stop" @onclick="@(() => RunFed(IdFed.DemoUntrusted))" disabled="@(_fedClusters.Count == 0)">⛔ 미신뢰</button>
                <button class="gth-v96-btn stop" @onclick="@(() => RunFed(IdFed.DemoLowPosture))" disabled="@(_fedClusters.Count == 0)">📉 포스처</button>
                <button class="gth-v96-btn" @onclick="RotateFedKeys" disabled="@(_fedClusters.Count == 0)">🔄 키 회전</button>
            </div>
            <div class="gth-v96-act">@(IdFed.LastAction ?? "대기 중")</div>
        </div>

        <div class="gth-v96-card sen @(Sentinel.ActiveFault is not null ? "err" : Sentinel.DemoRunning ? "ok" : null)">
            <div class="gth-v96-h">🚨 실시간 이상 감지 센티널
                <span class="gth-v96-be">@(Sentinel.DemoRunning ? "감시 중" : "정지") · 활성 @(Sentinel.ActiveSession)</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="up">@(Sentinel.EarlyCount)</b><span>사전</span></span>
                <span class="gth-v96-m"><b class="warn">@(Sentinel.WarnCount)</b><span>경고</span></span>
                <span class="gth-v96-m"><b class="err">@(Sentinel.CriticalCount)</b><span>치명</span></span>
                <span class="gth-v96-m"><b class="acc">@(Sentinel.Switches)</b><span>교체</span></span>
            </div>
            <div class="gth-v96-sig">
                @foreach (var sg in SentinelSignals)
                {
                    var sv = Sentinel.Signal(sg);
                    <span class="gth-v96-sv" @key="sg" title="평균 @(SenNum(sv.Mean)) · σ @(SenNum(sv.Std)) · 기울기 @(SenNum(sv.Slope))">
                        <b class="@(sv.Slope > 0 ? "rise" : null)">@(SenNum(sv.Last))</b><span>@(SenLabel(sg))</span>
                    </span>
                }
            </div>
            <div class="gth-v96-nodes">
                @foreach (var ss in Sentinel.Sessions)
                {
                    <span class="gth-v96-node @(SenClass(ss.State))" @key="ss.Id" title="@(ss.Tier) · 사고 @(ss.Incidents)">@(ss.Id)@(ss.CooldownSec > 0 ? " " + ss.CooldownSec.ToString("0", CultureInfo.InvariantCulture) + "s" : null)</span>
                }
            </div>
            @if (Sentinel.Events.Count > 0)
            {
                <div class="gth-v96-rows">
                    @foreach (var ev in Sentinel.Events.Take(3))
                    {
                        <div class="gth-v96-row-i @(ev.Severity == SentinelSeverity.Critical ? "deg" : null)">
                            <span class="gth-v96-n">@(ev.Kind) · @(ev.Severity)</span>
                            <span class="gth-v96-s">@(ev.Action)</span>
                        </div>
                    }
                </div>
            }
            <div class="gth-v96-row">
                <button class="gth-v96-btn" @onclick="ToggleSentinel">@(Sentinel.DemoRunning ? "⏸ 감시 정지" : "▶ 감시 시작")</button>
                <button class="gth-v96-btn stop" @onclick="Sentinel.InjectOverload" disabled="@(!Sentinel.DemoRunning)">🔥 과부하</button>
                <button class="gth-v96-btn stop" @onclick="Sentinel.InjectFrameDrop" disabled="@(!Sentinel.DemoRunning)">🎞 프레임 드랍</button>
                <button class="gth-v96-btn stop" @onclick="Sentinel.InjectStall" disabled="@(!Sentinel.DemoRunning)">🧱 정체</button>
                <button class="gth-v96-btn chk" @onclick="Sentinel.ResetAll">↻ 초기화</button>
            </div>
            <div class="gth-v96-act">@(Sentinel.LastAction ?? "대기 중")</div>
        </div>
    </div>

    @* ── v9.5.0 적응형 뉴럴 디렉터 · 분산 엣지 합의 메시 · 제로트러스트 거버넌스 오디터 ── *@
    <div class="gth-v95">
        <div class="gth-v95-card nd @(NeuralDir.LastPlan is not null ? "ok" : null)">
            <div class="gth-v95-h">🎬 적응형 뉴럴 디렉터
                <span class="gth-v95-be">플랜 @(NeuralDir.PlanCount)</span>
            </div>
            <input class="gth-v95-ip" @bind="_ndPrompt" title="연출 의도 프롬프트" />
            @if (NeuralDir.LastPlan is { } plan)
            {
                <div class="gth-v95-grid">
                    <span class="gth-v95-m"><b class="acc">@(plan.TempoBpm.ToString("0", CultureInfo.InvariantCulture))</b><span>BPM</span></span>
                    <span class="gth-v95-m"><b class="up">@(plan.Shots.Count)</b><span>샷</span></span>
                    <span class="gth-v95-m"><b class="warn">@Pct(plan.EffectiveArousal)</b><span>각성도</span></span>
                    <span class="gth-v95-m"><b class="ok">@(plan.Onsets)</b><span>온셋</span></span>
                </div>
                <div class="gth-v95-strip">
                    @foreach (var shot in plan.Shots)
                    {
                        <span class="gth-v95-shot s@((int)shot.Size)" @key="shot.Index" style="flex:@(shot.DurationSec.ToString("0.##", CultureInfo.InvariantCulture))" title="@(ShotTitle(shot))">@(ShotAbbr(shot.Size))</span>
                    }
                </div>
                <div class="gth-v95-hash">@(plan.Mood.Label) · 지문 @(plan.Digest[..16])</div>
            }
            else
            {
                <div class="gth-v95-empty">연출 이력이 없습니다. 프롬프트 감정과 오디오 스펙트럼 플럭스로 컷 시점·샷 사이즈·카메라 워킹·3D 포즈를 자율 조율합니다.</div>
            }
            <div class="gth-v95-row">
                <button class="gth-v95-btn" @onclick="DirectNeural">🎬 연출</button>
                <button class="gth-v95-btn chk" @onclick="ReplayNeural" disabled="@(NeuralDir.LastPlan is null)">♻ 멱등 재현</button>
            </div>
            <div class="gth-v95-act">@(_ndNote ?? NeuralDir.LastAction ?? "대기 중")</div>
        </div>

        <div class="gth-v95-card cons @(EdgeConsensus.LastRound is { } lr ? (lr.Committed ? "ok" : "err") : null)">
            <div class="gth-v95-h">🛰️ 분산 엣지 합의 메시
                <span class="gth-v95-be">term @(EdgeConsensus.Term) · 리더 @(EdgeConsensus.LeaderId ?? "-")</span>
            </div>
            <div class="gth-v95-grid">
                <span class="gth-v95-m"><b class="ok">@(EdgeConsensus.CommittedCount)</b><span>커밋</span></span>
                <span class="gth-v95-m"><b class="err">@(EdgeConsensus.FailedRounds)</b><span>실패</span></span>
                <span class="gth-v95-m"><b class="warn">@(EdgeConsensus.IsolatedTotal)</b><span>격리</span></span>
                <span class="gth-v95-m"><b class="acc">@(EdgeConsensus.Quorum)/@(EdgeConsensus.Members)</b><span>쿼럼</span></span>
            </div>
            @if (_consNodes.Count > 0)
            {
                <div class="gth-v95-nodes">
                    @foreach (var cn in _consNodes)
                    {
                        <span class="gth-v95-node @(ConsClass(cn))" @key="cn.Id" title="@(cn.Id) · ci @(cn.CommitIndex) · strikes @(cn.Strikes)">@(cn.Id[5..])</span>
                    }
                </div>
            }
            else
            {
                <div class="gth-v95-empty">클러스터가 없습니다. 7노드(f=2)를 구성하면 BFT 쿼럼 커밋·비잔틴 자가 격리·악성 리더 탄핵을 실측합니다.</div>
            }
            <div class="gth-v95-row">
                <button class="gth-v95-btn" @onclick="SeedConsensus">🧩 7노드 구성</button>
                <button class="gth-v95-btn chk" @onclick="ProposeConsensus" disabled="@(_consNodes.Count == 0)">📝 프레임 합의</button>
                <button class="gth-v95-btn stop" @onclick="InjectConsByzantine" disabled="@(_consNodes.Count == 0)">☠ 비잔틴</button>
                <button class="gth-v95-btn stop" @onclick="InjectConsLeader" disabled="@(_consNodes.Count == 0)">👑 악성 리더</button>
                <button class="gth-v95-btn stop" @onclick="CrashConsNode" disabled="@(_consNodes.Count == 0)">⚡ 크래시</button>
                <button class="gth-v95-btn chk" @onclick="VerifyConsChain" disabled="@(_consNodes.Count == 0)">✔ 원장 검증</button>
                <button class="gth-v95-btn" @onclick="HealConsensus" disabled="@(_consNodes.Count == 0)">↻ 복구</button>
            </div>
            <div class="gth-v95-act">@(_consNote ?? EdgeConsensus.LastAction ?? "대기 중")</div>
        </div>

        <div class="gth-v95-card gov @(GovAuditor.LastScan is { } ls ? (ls.Compliant ? (ls.Warn > 0 ? "warn" : "ok") : "err") : null)">
            <div class="gth-v95-h">🛡️ 제로트러스트 거버넌스 오디터
                <span class="gth-v95-be">@(GovAuditor.Armed ? "상시 감시" : "수동") · 스캔 @(GovAuditor.ScanCount)</span>
            </div>
            @if (GovAuditor.LastScan is { } scan)
            {
                <div class="gth-v95-grid">
                    <span class="gth-v95-m"><b class="ok">@(scan.Pass)</b><span>Pass</span></span>
                    <span class="gth-v95-m"><b class="warn">@(scan.Warn)</b><span>Warn</span></span>
                    <span class="gth-v95-m"><b class="err">@(scan.Fail)</b><span>Fail</span></span>
                    <span class="gth-v95-m"><b class="up">@(scan.ElapsedMs.ToString("0.###", CultureInfo.InvariantCulture))ms</b><span>스캔</span></span>
                </div>
                <div class="gth-v95-caps">
                    <span class="gth-v95-cap">테넌트 @(scan.Tenants)</span>
                    <span class="gth-v95-cap">WORM @(scan.LedgerEntries)</span>
                    <span class="gth-v95-cap">C2PA @(scan.Manifests)</span>
                    <span class="gth-v95-cap @(scan.Compliant ? "full" : "bad")">@(scan.Compliant ? "규정 준수" : "규정 위반")</span>
                </div>
                @if (scan.Findings.Count > 0)
                {
                    <div class="gth-v95-rows">
                        @foreach (var fd in scan.Findings.Take(4))
                        {
                            <div class="gth-v95-row-i @(fd.Severity == GovAuditSeverity.Fail ? "deg" : null)">
                                <span class="gth-v95-n">@(fd.Pillar) · @(fd.Subject)</span>
                                <span class="gth-v95-s">@(fd.Detail)</span>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="gth-v95-empty">감사 이력이 없습니다. 데모 테넌트를 시드하면 정책·C2PA·WORM 3기둥을 무할당 스캔하고 서명 리포트를 발행합니다.</div>
            }
            <div class="gth-v95-row">
                <button class="gth-v95-btn" @onclick="SeedGovAudit">🏢 시드</button>
                <button class="gth-v95-btn chk" @onclick="ScanGovAudit">🔍 스캔</button>
                <button class="gth-v95-btn stop" @onclick="TamperGovLedger">✂ 원장 위조</button>
                <button class="gth-v95-btn stop" @onclick="TamperGovManifest">✂ C2PA 위조</button>
                <button class="gth-v95-btn stop" @onclick="ViolateGovPolicy">⛔ 정책 위반</button>
                <button class="gth-v95-btn chk" @onclick="ReportGovAudit">📄 리포트 검증</button>
                <button class="gth-v95-btn" @onclick="ToggleGovArmed">@(GovAuditor.Armed ? "⏸ 감시 해제" : "▶ 상시 감시")</button>
            </div>
            <div class="gth-v95-act">@(_govAuditNote ?? GovAuditor.LastAction ?? "대기 중")</div>
        </div>
    </div>

    @* ── v9.4.0 자율 워크플로우 합성 · 초저지연 엣지 방송 · 멀티테넌트 거버너 ── *@
    <div class="gth-v94">
        <div class="gth-v94-card wf @(WfSynth.LastWorkflow is { } lwf ? (lwf.Valid ? "ok" : "err") : null)">
            <div class="gth-v94-h">🧬 자율 워크플로우 합성
                <span class="gth-v94-be">rev @(WfSynth.SynthesisCount) · 순환차단 @(WfSynth.CyclesBroken)</span>
            </div>
            <input class="gth-v94-ip" @bind="_wfIntent" title="자연어 의도" />
            @if (WfSynth.LastWorkflow is { } wf)
            {
                <div class="gth-v94-grid">
                    <span class="gth-v94-m"><b class="acc">@(wf.Nodes.Count)</b><span>노드</span></span>
                    <span class="gth-v94-m"><b class="up">@(wf.Edges.Count)</b><span>간선</span></span>
                    <span class="gth-v94-m"><b class="ok">@(wf.Layers.Count)</b><span>레이어</span></span>
                    <span class="gth-v94-m"><b class="warn">@Pct(wf.Intent.Confidence)</b><span>신뢰도</span></span>
                </div>
                <div class="gth-v94-layers">
                    @foreach (var layer in wf.Layers.Select((ids, li) => (ids, li)))
                    {
                        <div class="gth-v94-layer" @key="layer.li">
                            <span class="gth-v94-li">L@(layer.li)</span>
                            @foreach (var nid in layer.ids)
                            {
                                <span class="gth-v94-node">@nid</span>
                            }
                        </div>
                    }
                </div>
                <div class="gth-v94-hash">지문 @(wf.Digest[..16])@(wf.Issues.Count > 0 ? " · " + wf.Issues[^1] : null)</div>
            }
            else
            {
                <div class="gth-v94-empty">합성 이력이 없습니다. 의도 문장에서 컷 수·TTS·립싱크·업스케일·자막 단서를 추출해 Kahn 위상 정렬 DAG 로 합성합니다.</div>
            }
            <div class="gth-v94-row">
                <button class="gth-v94-btn" @onclick="SynthesizeWorkflow">⚙ 합성</button>
                <button class="gth-v94-btn chk" @onclick="InjectWfCycle" disabled="@(WfSynth.LastWorkflow is null)">↺ 순환 주입</button>
                <button class="gth-v94-btn" @onclick="VerifyWf" disabled="@(WfSynth.LastWorkflow is null)">✔ 지문 검증</button>
            </div>
            <div class="gth-v94-act">@(_wfNote ?? WfSynth.LastAction ?? "대기 중")</div>
        </div>

        <div class="gth-v94-card cast @(EdgeCast.State == EdgeBroadcastState.Live ? (EdgeCast.SlaRatio >= 0.99 ? "ok" : "warn") : EdgeCast.State == EdgeBroadcastState.InProcess ? "warn" : null)">
            <div class="gth-v94-h">📡 초저지연 엣지 방송
                <span class="gth-v94-be">@CastLabel(EdgeCast.State)@(EdgeCast.Port > 0 ? " · :" + EdgeCast.Port.ToString(CultureInfo.InvariantCulture) : null)</span>
            </div>
            <div class="gth-v94-grid">
                <span class="gth-v94-m"><b class="@(EdgeCast.P95Ms < ZeroLatencyEdgeBroadcaster.SlaMs ? "ok" : "err")">@(EdgeCast.P95Ms.ToString("0.##", CultureInfo.InvariantCulture))ms</b><span>P95</span></span>
                <span class="gth-v94-m"><b class="up">@(EdgeCast.ProbeLatencyMs.ToString("0.##", CultureInfo.InvariantCulture))ms</b><span>종단 지연</span></span>
                <span class="gth-v94-m"><b class="acc">@(EdgeCast.SubscriberCount)</b><span>엣지</span></span>
                <span class="gth-v94-m"><b class="warn">@(EdgeCast.DroppedCount)</b><span>최신성 폐기</span></span>
            </div>
            <div class="gth-v94-bar"><div class="gth-v94-fill cast" style="width:@Pct(EdgeCast.SlaRatio)"></div></div>
            <div class="gth-v94-caps">
                <span class="gth-v94-cap @(EdgeCast.SlaRatio >= 0.99 ? "full" : "bad")">SLA&lt;50ms @Pct(EdgeCast.SlaRatio)</span>
                <span class="gth-v94-cap">발행 @(EdgeCast.PublishedCount)</span>
                <span class="gth-v94-cap">송신 @((EdgeCast.SentBytes / 1024).ToString(CultureInfo.InvariantCulture))KB</span>
                <span class="gth-v94-cap">프로브 수신 @(EdgeCast.ProbeReceived)</span>
            </div>
            <div class="gth-v94-row">
                <button class="gth-v94-btn" @onclick="StartEdgeCast" disabled="@(EdgeCast.State != EdgeBroadcastState.Stopped)">▶ 기동</button>
                <button class="gth-v94-btn chk" @onclick="ToggleEdgeDemo" disabled="@(EdgeCast.State == EdgeBroadcastState.Stopped)">@(EdgeCast.DemoRunning ? "⏸ 데모 정지" : "🎬 30fps 데모")</button>
                <button class="gth-v94-btn chk" @onclick="ConnectEdgeProbe" disabled="@(EdgeCast.State != EdgeBroadcastState.Live)">🔗 루프백 프로브</button>
                <button class="gth-v94-btn stop" @onclick="StopEdgeCast" disabled="@(EdgeCast.State == EdgeBroadcastState.Stopped)">■ 정지</button>
            </div>
            <div class="gth-v94-act">@(EdgeCast.LastError ?? _castNote ?? EdgeCast.LastAction ?? "대기 중")</div>
        </div>

        <div class="gth-v94-card gov @(TenantGov.PeakUtilization >= TenantGov.Watermark ? "err" : TenantGov.PeakUtilization >= 0.7 ? "warn" : TenantGov.GrantedCount > 0 ? "ok" : null)">
            <div class="gth-v94-h">🏛️ 멀티테넌트 거버너
                <span class="gth-v94-be">워터마크 @Pct(TenantGov.Watermark) · 임대 @(TenantGov.ActiveLeaseCount)</span>
            </div>
            <div class="gth-v94-grid">
                <span class="gth-v94-m"><b class="ok">@(TenantGov.GrantedCount)</b><span>승인</span></span>
                <span class="gth-v94-m"><b class="err">@(TenantGov.DeniedCount)</b><span>거부</span></span>
                <span class="gth-v94-m"><b class="warn">@(TenantGov.PreemptionCount)</b><span>선점</span></span>
                <span class="gth-v94-m"><b class="up">@(TenantGov.OverloadBlockCount)</b><span>사전 차단</span></span>
            </div>
            <div class="gth-v94-bar"><div class="gth-v94-fill gov" style="width:@Pct(TenantGov.PeakUtilization)"></div></div>
            @if (_govTenants.Count > 0)
            {
                <div class="gth-v94-rows">
                    @foreach (var tv in _govTenants)
                    {
                        <div class="gth-v94-row-i @(tv.Preempted > 0 ? "deg" : tv.Leases > 0 ? "linked" : null)" @key="tv.TenantId">
                            <span class="gth-v94-n">@tv.TenantId · @tv.Tier</span>
                            <span class="gth-v94-s">N@(tv.InUse.NpuPct)/@(tv.HardCap.NpuPct) G@(tv.InUse.GpuPct)/@(tv.HardCap.GpuPct) · @(tv.Leases)건</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="gth-v94-empty">등록된 테넌트가 없습니다. 데모 테넌트를 등록하면 Hard-cap 격리·워터마크 사전 차단·하위 등급 선점을 실측합니다.</div>
            }
            <div class="gth-v94-row">
                <button class="gth-v94-btn" @onclick="SeedGovTenants">🏢 테넌트 등록</button>
                <button class="gth-v94-btn chk" @onclick="@(() => GovAcquire("batch-free", 30))" disabled="@(_govTenants.Count == 0)">＋ 배치</button>
                <button class="gth-v94-btn chk" @onclick="@(() => GovAcquire("studio-live", 35))" disabled="@(_govTenants.Count == 0)">⚡ 라이브</button>
                <button class="gth-v94-btn stop" @onclick="ReleaseGovAll" disabled="@(TenantGov.ActiveLeaseCount == 0)">↻ 전량 회수</button>
            </div>
            <div class="gth-v94-act">@(_govNote ?? TenantGov.LastAction ?? "대기 중")</div>
        </div>
    </div>

    @* ── v9.3.0 공간 글래스모피즘 · 양자 내성 P2P 메시 · 자율 복구 워치독 ── *@
    <div class="gth-v93">
        <div class="gth-v93-card glass @(Glass.PassCount > 0 ? "ok" : null)">
            <div class="gth-v93-h">🔮 공간 글래스모피즘
                <span class="gth-v93-be">yaw @(Fmt(Glass.YawDeg))° · pitch @(Fmt(Glass.PitchDeg))°</span>
            </div>
            <div class="gth-v93-stage">
                @if (Glass.LastResult is { } gr)
                {
                    @foreach (var layer in gr.Layers.Reverse())
                    {
                        <div class="gth-v93-pane" @key="layer.Index"
                             style="transform:@layer.Transform;backdrop-filter:@layer.BackdropFilter;-webkit-backdrop-filter:@layer.BackdropFilter;opacity:@(layer.Opacity.ToString("0.###", CultureInfo.InvariantCulture));--gth-spec:@(layer.Specular.ToString("0.###", CultureInfo.InvariantCulture))">
                            <span>L@(layer.Index)</span>
                        </div>
                    }
                }
                else
                {
                    <div class="gth-v93-empty">렌더 이력이 없습니다. 궤도 회전 시 원근 행렬·Fresnel·굴절을 레이어별로 합성합니다.</div>
                }
            </div>
            <div class="gth-v93-grid">
                <span class="gth-v93-m"><b class="acc">@(Glass.LayerCount)</b><span>레이어</span></span>
                <span class="gth-v93-m"><b class="up">@Pct(Glass.LastResult?.FresnelAvg ?? 0d)</b><span>Fresnel</span></span>
                <span class="gth-v93-m"><b class="warn">@Pct(Glass.LastResult?.SpecularPeak ?? 0d)</b><span>스펙큘러</span></span>
                <span class="gth-v93-m"><b class="ok">@(Glass.PassCount)</b><span>패스</span></span>
            </div>
            <div class="gth-v93-row">
                <button class="gth-v93-btn" @onclick="() => OrbitGlass(-15d, 0d)">⟲</button>
                <button class="gth-v93-btn" @onclick="() => OrbitGlass(15d, 0d)">⟳</button>
                <button class="gth-v93-btn" @onclick="() => OrbitGlass(0d, -10d)">▲</button>
                <button class="gth-v93-btn" @onclick="() => OrbitGlass(0d, 10d)">▼</button>
                <button class="gth-v93-btn chk" @onclick="ToggleGlassMaterial">@(Glass.Material == PromptFlowStudio.Services.Media.GlassMaterial.Holo ? "홀로" : "크라운")</button>
                <button class="gth-v93-btn stop" @onclick="ResetGlass">↺</button>
            </div>
            <div class="gth-v93-act">@(Glass.LastAction ?? "대기 중")</div>
        </div>

        <div class="gth-v93-card mesh @(P2p.RejectedCount > 0 ? "err" : P2p.AliveCount < P2p.NodeCount ? "warn" : P2p.DeliveredCount > 0 ? "ok" : null)">
            <div class="gth-v93-h">🛰️ 양자 내성 P2P 메시
                <span class="gth-v93-be">@P2p.AlgorithmLabel · @P2p.LocalNodeId</span>
            </div>
            <div class="gth-v93-grid">
                <span class="gth-v93-m"><b class="acc">@(P2p.AliveCount)/@(P2p.NodeCount)</b><span>노드</span></span>
                <span class="gth-v93-m"><b class="ok">@(P2p.DeliveredCount)</b><span>전달</span></span>
                <span class="gth-v93-m"><b class="warn">@(P2p.RerouteCount)</b><span>재라우팅</span></span>
                <span class="gth-v93-m"><b class="err">@(P2p.RejectedCount)</b><span>서명 거부</span></span>
            </div>
            <div class="gth-v93-bar"><div class="gth-v93-fill mesh" style="width:@Pct(P2p.ReachabilityRatio)"></div></div>
            @if (_meshNodes.Count > 1)
            {
                <div class="gth-v93-rows">
                    @foreach (var node in _meshNodes)
                    {
                        <div class="gth-v93-row-i @(node.State == MeshNodeState.Dead ? "cut" : node.State == MeshNodeState.Suspect ? "deg" : "linked")" @key="node.NodeId">
                            <span class="gth-v93-n">@node.NodeId · @(node.PublicKeyHex[..8])</span>
                            <span class="gth-v93-s">@(node.Hops < 0 ? "고립" : node.Hops + "홉 · " + Fmt(node.CostMs) + "ms")</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="gth-v93-empty">메시 노드가 없습니다. 데모 메시를 구성하면 링+코드 토폴로지 위로 홉 체인 서명 봉투를 릴레이합니다.</div>
            }
            @if (P2p.LastRoute is { } route)
            {
                <div class="gth-v93-hash">@string.Join(" → ", route.Path)@(route.Envelope is { } env ? " · " + env.HopChainHex[..12] : null)</div>
            }
            <div class="gth-v93-row">
                <button class="gth-v93-btn" @onclick="SeedMesh">⬡ 메시 구성</button>
                <button class="gth-v93-btn chk" @onclick="() => SendMesh(false)" disabled="@(P2p.NodeCount < 2)">✉ 릴레이</button>
                <button class="gth-v93-btn chk" @onclick="() => SendMesh(true)" disabled="@(P2p.NodeCount < 3)">⚡ 카오스 릴레이</button>
                <button class="gth-v93-btn" @onclick="TamperMesh" disabled="@(P2p.LastRoute?.Envelope is null)">✔ 위조 검증</button>
                <button class="gth-v93-btn" @onclick="AnchorMesh">⛓ 원장 봉인</button>
                <button class="gth-v93-btn stop" @onclick="ReviveMesh">↻ 복귀</button>
            </div>
            <div class="gth-v93-act">@(_meshNote ?? P2p.LastAlert ?? P2p.LastAction ?? "대기 중")</div>
        </div>

        <div class="gth-v93-card dog @(Watchdog.IsHealthy ? (Watchdog.RecoveryCount > 0 ? "ok" : null) : "warn")">
            <div class="gth-v93-h">🐕 자율 복구 워치독
                <span class="gth-v93-be">@(Watchdog.IsArmed ? "감시 중" : "일시정지") · @FaultLabel(Watchdog.LastFault)</span>
            </div>
            <div class="gth-v93-grid">
                <span class="gth-v93-m"><b class="err">@(Watchdog.DeadlockCount)</b><span>교착 복구</span></span>
                <span class="gth-v93-m"><b class="warn">@(Watchdog.LeakCount + Watchdog.FragmentationCount)</b><span>메모리 복구</span></span>
                <span class="gth-v93-m"><b class="up">@(Watchdog.NpuOverloadCount)</b><span>NPU 감속</span></span>
                <span class="gth-v93-m"><b class="acc">@((Watchdog.HeapBytes / 1048576).ToString(CultureInfo.InvariantCulture))MB</b><span>힙</span></span>
            </div>
            <div class="gth-v93-bar"><div class="gth-v93-fill dog" style="width:@Pct(Watchdog.FragmentationRatioNow)"></div></div>
            <div class="gth-v93-caps">
                <span class="gth-v93-cap">파편화 @Pct(Watchdog.FragmentationRatioNow)</span>
                <span class="gth-v93-cap @(Watchdog.HeapGrowthRatio >= 0.25 ? "bad" : "full")">힙 증가 @Pct(Math.Max(0d, Watchdog.HeapGrowthRatio))</span>
                <span class="gth-v93-cap @(Watchdog.NpuThrottled ? "bad" : "full")">@(Watchdog.NpuThrottled ? "NPU 감속 중" : "NPU 정상")</span>
                <span class="gth-v93-cap">레인 @(Watchdog.LaneCount)</span>
            </div>
            @if (_dogHistory.Count > 0)
            {
                <div class="gth-v93-rows">
                    @foreach (var rec in _dogHistory)
                    {
                        <div class="gth-v93-row-i @(rec.Kind == WatchdogFaultKind.Deadlock ? "cut" : "deg")" @key="rec.Sequence">
                            <span class="gth-v93-n">@FaultLabel(rec.Kind) · @rec.Action</span>
                            <span class="gth-v93-s">@rec.At.ToString("HH:mm:ss", CultureInfo.InvariantCulture)</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="gth-v93-empty">복구 이력이 없습니다. 2초 주기로 핫패스 하트비트·힙 추세·파편화·NPU 스롯틀을 감시합니다.</div>
            }
            <div class="gth-v93-row">
                <button class="gth-v93-btn" @onclick="ProbeWatchdog">🔍 즉시 프로브</button>
                <button class="gth-v93-btn chk" @onclick="InjectStall">⛔ 교착 주입</button>
                <button class="gth-v93-btn stop" @onclick="ToggleWatchdog">@(Watchdog.IsArmed ? "⏸ 일시정지" : "▶ 재개")</button>
            </div>
            <div class="gth-v93-act">@(_dogNote ?? Watchdog.LastAction ?? "대기 중")</div>
        </div>
    </div>

    @* ── v9.2.0 온디바이스 멀티모달 AI · 크로스 디바이스 동기화 · 자율 크래시 텔레메트리 ── *@
    <div class="gth-v92">
        <div class="gth-v92-card vis @(Vision.IsRunning ? "run" : Vision.TotalRuns > 0 ? "ok" : null)">
            <div class="gth-v92-h">⚡ 온디바이스 AI 추론
                <span class="gth-v92-be">@Vision.AcceleratorLabel</span>
            </div>
            <div class="gth-v92-grid">
                <span class="gth-v92-m"><b class="acc">@(Vision.TotalRuns)</b><span>세션</span></span>
                <span class="gth-v92-m"><b class="ok">@(Vision.TotalTiles)</b><span>타일</span></span>
                <span class="gth-v92-m"><b class="up">@(Fmt(Vision.TileLatencyMs) + "ms")</b><span>타일 지연</span></span>
                <span class="gth-v92-m"><b class="warn">@Vision.ThroughputLabel</b><span>처리량</span></span>
            </div>
            <div class="gth-v92-bar"><div class="gth-v92-fill vis" style="width:@Pct(Vision.LastResult?.AvgConfidence ?? 0d)"></div></div>
            @if (Vision.LastResult is { TileCount: > 0 } vr)
            {
                <div class="gth-v92-caps">
                    <span class="gth-v92-cap">신뢰도 @Pct(vr.AvgConfidence)</span>
                    <span class="gth-v92-cap">피크 @Pct(vr.PeakConfidence)</span>
                    <span class="gth-v92-cap @(vr.MemoryMapped ? "full" : null)">@(vr.MemoryMapped ? "메모리 맵" : vr.Synthesized ? "합성 텐서" : "순차 읽기")</span>
                    <span class="gth-v92-cap">@(vr.ManagedBytesDelta / 1024)KB 할당</span>
                </div>
                <div class="gth-v92-rows">
                    @foreach (var t in _visionTiles)
                    {
                        <div class="gth-v92-row-i" @key="t.Index">
                            <span class="gth-v92-n">#@(t.Index) @t.Label</span>
                            <span class="gth-v92-s">@Pct(t.Confidence)</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="gth-v92-empty">추론 이력이 없습니다. 실행하면 원본을 메모리 맵 타일로 훑고, 원본이 없으면 결정적 합성 텐서로 강등해 경로를 검증합니다.</div>
            }
            <div class="gth-v92-row">
                <button class="gth-v92-btn go" @onclick="RunVisionInference" disabled="@Vision.IsRunning">▶ 64타일 추론</button>
                <button class="gth-v92-btn chk" @onclick="WarmupVision" disabled="@Vision.IsRunning">🔥 웜업</button>
                <button class="gth-v92-btn stop" @onclick="ReprobeVision" disabled="@Vision.IsRunning">↻ 재프로브</button>
            </div>
            <div class="gth-v92-act">@(Vision.LastError ?? _visionNote ?? "대기 중")</div>
        </div>

        <div class="gth-v92-card sync @(Sync.LinkState == CrossDeviceLinkState.Connected ? "ok" : Sync.LinkState == CrossDeviceLinkState.Connecting ? "run" : Sync.LinkState == CrossDeviceLinkState.Degraded ? "warn" : null)">
            <div class="gth-v92-h">🔄 크로스 디바이스 싱크
                <span class="gth-v92-be">@LinkLabel(Sync.LinkState) · @Sync.ReplicaId</span>
            </div>
            <div class="gth-v92-grid">
                <span class="gth-v92-m"><b class="acc">@(Sync.KeyCount)</b><span>동기 키</span></span>
                <span class="gth-v92-m"><b class="ok">@(Sync.ConnectedPeerCount)</b><span>연결 단말</span></span>
                <span class="gth-v92-m"><b class="up">@(Sync.SentCount)</b><span>송신</span></span>
                <span class="gth-v92-m"><b class="warn">@(Sync.ReceivedCount)</b><span>수신</span></span>
            </div>
            <div class="gth-v92-bar"><div class="gth-v92-fill sync" style="width:@Pct(Sync.ConvergenceRatio)"></div></div>
            <div class="gth-v92-caps">
                <span class="gth-v92-cap @(Sync.ConflictCount == 0 ? "full" : null)">LWW 충돌 @(Sync.ConflictCount)</span>
                <span class="gth-v92-cap">멱등 차단 @(Sync.DuplicateCount)</span>
                <span class="gth-v92-cap @(Sync.RejectedCount > 0 ? "bad" : null)">HMAC 폐기 @(Sync.RejectedCount)</span>
                <span class="gth-v92-cap">보류 @(Sync.PendingCount)</span>
            </div>
            @if (_syncPeers.Count > 0)
            {
                <div class="gth-v92-rows">
                    @foreach (var peer in _syncPeers)
                    {
                        <div class="gth-v92-row-i @(peer.Connected ? "linked" : "cut")" @key="peer.PeerId">
                            <span class="gth-v92-n">@peer.Endpoint</span>
                            <span class="gth-v92-s">@(peer.Sent)↑ @(peer.Received)↓</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="gth-v92-empty">연결된 단말이 없습니다. 데스크톱에서 수신을 시작하고 모바일 Deck 이 같은 LAN 으로 접속하면 CRDT 델타가 양방향 수렴합니다.</div>
            }
            <div class="gth-v92-row">
                <input class="gth-v92-ip" @bind="_syncHost" title="접속 대상 호스트" />
                <button class="gth-v92-btn go" @onclick="StartSyncHost" disabled="@(Sync.LinkState == CrossDeviceLinkState.Listening)">▶ 수신</button>
                <button class="gth-v92-btn chk" @onclick="ConnectSyncPeer">🔗 접속</button>
                <button class="gth-v92-btn chk" @onclick="PublishSyncDelta">✎ 델타 발행</button>
                <button class="gth-v92-btn stop" @onclick="StopSync" disabled="@(Sync.LinkState == CrossDeviceLinkState.Offline)">■ 종료</button>
            </div>
            <div class="gth-v92-act">@(Sync.LastError ?? _syncNote ?? Sync.LastAction ?? "대기 중")</div>
        </div>

        <div class="gth-v92-card crash @(Crash.Thermal == ThermalState.Critical ? "err" : Crash.Thermal == ThermalState.Throttling ? "warn" : Crash.IsHealthy ? "ok" : null)">
            <div class="gth-v92-h">🩺 크래시 · NPU 텔레메트리
                <span class="gth-v92-be">@ThermalLabel(Crash.Thermal) · @(Fmt(Crash.NpuLatencyMs) + "ms")</span>
            </div>
            <div class="gth-v92-grid">
                <span class="gth-v92-m"><b class="err">@(Crash.ExceptionCount)</b><span>예외</span></span>
                <span class="gth-v92-m"><b class="warn">@(Crash.NpuStallCount)</b><span>NPU 병목</span></span>
                <span class="gth-v92-m"><b class="up">@(Crash.ThermalEventCount)</b><span>발열 징후</span></span>
                <span class="gth-v92-m"><b class="acc">@(Crash.DroppedCount)</b><span>링버퍼 폐기</span></span>
            </div>
            <div class="gth-v92-bar"><div class="gth-v92-fill crash" style="width:@Pct(Crash.BufferFillRatio)"></div></div>
            @if (_crashSignals.Count > 0)
            {
                <div class="gth-v92-rows">
                    @foreach (var sig in _crashSignals)
                    {
                        <div class="gth-v92-row-i @(sig.Kind == CrashSignalKind.Exception ? "cut" : sig.Kind == CrashSignalKind.NpuStall ? "deg" : null)" @key="sig.Sequence">
                            <span class="gth-v92-n">@sig.Source</span>
                            <span class="gth-v92-s">@sig.At.ToLocalTime().ToString("HH:mm:ss", CultureInfo.InvariantCulture)</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="gth-v92-empty">수집된 신호가 없습니다. 전역 예외 훅과 2초 샘플러가 NPU 지연·발열 스롯틀·메모리 압박을 무할당으로 감시 중입니다.</div>
            }
            @if (Crash.LastReport is { } crashRep)
            {
                <div class="gth-v92-hash">지문 @(crashRep.Digest[..16])@(crashRep.LedgerSequence >= 0 ? " · 원장 seq=" + crashRep.LedgerSequence.ToString(CultureInfo.InvariantCulture) : " · 원장 미주입")</div>
            }
            <div class="gth-v92-row">
                <button class="gth-v92-btn go" @onclick="ExportCrashReport">📤 반출</button>
                <button class="gth-v92-btn chk" @onclick="VerifyCrashReport" disabled="@(Crash.LastReport is null)">✔ 위변조 검증</button>
                <button class="gth-v92-btn stop" @onclick="ResetCrashTelemetry">↻ 리셋</button>
                @if (_reportVerified is { } verified)
                {
                    <span class="gth-v92-cap @(verified ? "full" : "bad")">@(verified ? "무결" : "위변조 검출")</span>
                }
            </div>
            <div class="gth-v92-act">@(Crash.LastError ?? _crashNote ?? Crash.LastAction ?? "대기 중")</div>
        </div>
    </div>

    @* ── v8.9.0 Graphify 지식 그래프 · MCP E2E 자동화 · Zero-Alloc 봉인 관제 ── *@
    <div class="gth-v89">
        <div class="gth-v89-card graph @(Graph.IsLoaded ? "ok" : Graph.IsLoading ? "run" : null)">
            <div class="gth-v89-h">🕸️ Graphify 지식 그래프
                <span class="gth-v89-be">@(Graph.IsLoaded ? Fmt(Graph.LoadMs) + "ms 로드" : "미로드")</span>
            </div>
            <div class="gth-v89-grid">
                <span class="gth-v89-m"><b class="acc">@Graph.NodeCount</b><span>노드</span></span>
                <span class="gth-v89-m"><b class="up">@Graph.EdgeCount</b><span>간선</span></span>
                <span class="gth-v89-m"><b class="ok">@Graph.CommunityCount</b><span>커뮤니티</span></span>
                <span class="gth-v89-m"><b>@Graph.QueryCount</b><span>조회</span></span>
            </div>
            @if (Graph.IsLoaded)
            {
                <div class="gth-v89-row">
                    <input class="gth-v89-in" @bind="_graphQuery" @bind:event="oninput" placeholder="심볼 · 파일 경로" />
                    <button class="gth-v89-btn chk" @onclick="TraceGraph" disabled="@string.IsNullOrWhiteSpace(_graphQuery)">🔎 역추적</button>
                </div>
                @if (_graphHops.Count > 0)
                {
                    <div class="gth-v89-hops">
                        @foreach (var h in _graphHops)
                        {
                            <div class="gth-v89-hop" @key="@(h.Depth + h.FromLabel + h.ToLabel)">
                                <span class="gth-v89-hop-d">@(h.Depth)홉</span>
                                <span class="gth-v89-hop-l">@h.FromLabel → @h.ToLabel</span>
                                <span class="gth-v89-hop-s">@h.Relation</span>
                            </div>
                        }
                    </div>
                }
                else if (_graphBoundary is not null)
                {
                    <div class="gth-v89-act">커뮤니티 @(_graphBoundary.Id) · 노드 @(_graphBoundary.NodeCount) · 응집도 @Pct(_graphBoundary.Cohesion)</div>
                }
                <div class="gth-v89-caps">
                    @foreach (var g in _godNodes)
                    {
                        <span class="gth-v89-cap" @key="g.Id">@g.Label <small>@(g.Degree)</small></span>
                    }
                </div>
            }
            else
            {
                <div class="gth-v89-empty">graph.json 미로드 — /graphify 산출물(graphify-out)을 파싱해 모듈 의존성 역추적을 활성화합니다.</div>
            }
            <div class="gth-v89-row">
                <button class="gth-v89-btn go" @onclick="LoadGraph" disabled="@Graph.IsLoading">@(Graph.IsLoading ? "파싱 중…" : Graph.IsLoaded ? "↻ 그래프 재로드" : "📂 그래프 로드")</button>
                <span class="gth-v89-act">@(Graph.LastError ?? Graph.LastAction ?? "대기 중")</span>
            </div>
        </div>

        <div class="gth-v89-card mcp @(Mcp.FullyLive ? "ok" : Mcp.IsRunning ? "run" : null)">
            <div class="gth-v89-h">🎭 MCP E2E 자동화
                <span class="gth-v89-be">접속 @(Mcp.ConnectedCount)/@(Mcp.ServerCount) · @Fmt(Mcp.LastLatencyMs)ms</span>
            </div>
            <div class="gth-v89-grid">
                <span class="gth-v89-m"><b class="@(Mcp.LastReport?.AllPassed == true ? "ok" : "warn")">@(Mcp.LastReport is null ? "—" : Pct(Mcp.LastReport.PassRatio))</b><span>통과율</span></span>
                <span class="gth-v89-m"><b class="acc">@Mcp.TotalCalls</b><span>RPC 호출</span></span>
                <span class="gth-v89-m"><b class="err">@Mcp.FailedCalls</b><span>실패</span></span>
                <span class="gth-v89-m"><b class="up">@Mcp.StubFallbacks</b><span>스텁 폴백</span></span>
            </div>
            <div class="gth-v89-peers">
                @foreach (var sv in Mcp.Servers)
                {
                    <div class="gth-v89-peer @(sv.State == McpServerState.Connected ? "linked" : sv.State == McpServerState.Offline ? "cut" : "deg")" @key="sv.Name">
                        <span class="gth-v89-peer-id">@sv.Name</span>
                        <span class="gth-v89-peer-s">@McpLabel(sv.State)</span>
                    </div>
                }
            </div>
            @if (Mcp.IsRunning)
            {
                <div class="gth-v89-bar"><div class="gth-v89-fill mcp" style="width:@Pct(Mcp.TotalSteps == 0 ? 0d : (double)Mcp.CurrentStep / Mcp.TotalSteps)"></div></div>
            }
            @if (_mcpSteps.Count > 0)
            {
                <div class="gth-v89-hops">
                    @foreach (var st in _mcpSteps)
                    {
                        <div class="gth-v89-hop @(st.Passed ? "pass" : "fail")" @key="st.Index">
                            <span class="gth-v89-hop-d">@(st.Index)</span>
                            <span class="gth-v89-hop-l">@StepLabel(st.Action) @st.Target</span>
                            <span class="gth-v89-hop-s">@(st.Stub ? "스텁" : Fmt(st.LatencyMs) + "ms")</span>
                        </div>
                    }
                </div>
            }
            <div class="gth-v89-row">
                <button class="gth-v89-btn go" @onclick="RunMcpE2e" disabled="@Mcp.IsRunning">@(Mcp.IsRunning ? "스텝 " + Mcp.CurrentStep + "/" + Mcp.TotalSteps : "▶ E2E 실행")</button>
                <button class="gth-v89-btn chk" @onclick="ProbeMcpServers" disabled="@Mcp.IsRunning">📡 서버 프로브</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(Mcp.LastAction))
            {
                <div class="gth-v89-act">@Mcp.LastAction</div>
            }
        </div>

        <div class="gth-v89-card seal @(Sealer.IsPipelineSealed ? "ok" : Sealer.ViolationCount > 0 ? "warn" : Sealer.IsSealing ? "run" : null)">
            <div class="gth-v89-h">🔒 Zero-Alloc 봉인
                <span class="gth-v89-be">@(Sealer.Certificate is null ? "미봉인" : Sealer.Certificate.Version)</span>
            </div>
            <div class="gth-v89-grid">
                <span class="gth-v89-m"><b class="@(Sealer.ViolationCount == 0 ? "ok" : "err")">@(Sealer.TotalBytesPerOp.ToString("0.##", CultureInfo.InvariantCulture))<small>B/op</small></b><span>총 할당</span></span>
                <span class="gth-v89-m"><b class="acc">@Sealer.SealedPaths<small>/@(Sealer.PathCount)</small></b><span>봉인 경로</span></span>
                <span class="gth-v89-m"><b class="err">@Sealer.ViolationCount</b><span>위반</span></span>
                <span class="gth-v89-m"><b class="up">@(Sealer.Certificate?.Gen2Delta ?? 0)</b><span>Gen2 델타</span></span>
            </div>
            @if (Sealer.IsSealing)
            {
                <div class="gth-v89-bar"><div class="gth-v89-fill seal" style="width:@Pct(Sealer.PathCount == 0 ? 0d : (double)Sealer.CurrentPath / Sealer.PathCount)"></div></div>
            }
            @if (_sealReports.Count > 0)
            {
                <div class="gth-v89-hops">
                    @foreach (var r in _sealReports)
                    {
                        <div class="gth-v89-hop @(r.Sealed ? "pass" : "fail")" @key="r.Name">
                            <span class="gth-v89-hop-l">@r.Name</span>
                            <span class="gth-v89-hop-s">@(r.BytesPerOp.ToString("0.##", CultureInfo.InvariantCulture))B</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="gth-v89-empty">핫패스 @(Sealer.PathCount)개 등록 — 봉인 실행 시 전용 스레드에서 op 당 할당/LOH/POH 증분을 계측합니다.</div>
            }
            <div class="gth-v89-row">
                <button class="gth-v89-btn go" @onclick="SealPipeline" disabled="@Sealer.IsSealing">@(Sealer.IsSealing ? "계측 " + Sealer.CurrentPath + "/" + Sealer.PathCount : "🧪 파이프라인 봉인")</button>
                @if (Sealer.Certificate is { Hash.Length: > 12 } cert)
                {
                    <span class="gth-v89-act">SHA-256 @(cert.Hash[..12])</span>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Sealer.LastAction))
            {
                <div class="gth-v89-act">@Sealer.LastAction</div>
            }
        </div>
    </div>

    @* ── v8.5.0 멀티모달 뉴럴 캐시 · 엔터프라이즈 SSO 관제 ── *@
    <div class="gth-v85">
        <div class="gth-v85-card cache">
            <div class="gth-v85-h">🧠 멀티모달 뉴럴 캐시 <span class="gth-v85-be">@(NeuralCache.CapacityBytes / (1024 * 1024))MB MMF</span></div>
            <div class="gth-v85-grid">
                <span class="gth-v85-m"><b class="acc">@Pct(NeuralCache.HitRatio)</b><span>히트율</span></span>
                <span class="gth-v85-m"><b class="ok">@NeuralCache.Hits</b><span>히트</span></span>
                <span class="gth-v85-m"><b class="warn">@NeuralCache.Misses</b><span>미스</span></span>
                <span class="gth-v85-m"><b>@NeuralCache.Entries</b><span>엔트리</span></span>
            </div>
            <div class="gth-v85-bar"><div class="gth-v85-fill cache" style="width:@Pct(NeuralCache.FillRatio)"></div></div>
        </div>
        <div class="gth-v85-card sso">
            <div class="gth-v85-h">🔑 엔터프라이즈 SSO
                <span class="gth-v85-be">@(Sso.RsaConfigured ? "RS256" : Sso.HmacConfigured ? "HS256" : "미구성")</span>
            </div>
            <div class="gth-v85-grid">
                <span class="gth-v85-m"><b class="ok">@Sso.ValidatedOk</b><span>인증 통과</span></span>
                <span class="gth-v85-m"><b class="err">@Sso.Rejected</b><span>거부</span></span>
                <span class="gth-v85-m"><b class="acc">@Sso.ActiveSessions</b><span>활성 세션</span></span>
                <span class="gth-v85-m"><b>@(string.IsNullOrEmpty(Sso.LastSubject) ? "—" : Sso.LastSubject)</b><span>최근 주체</span></span>
            </div>
            @if (!string.IsNullOrWhiteSpace(Sso.LastError))
            {
                <div class="gth-v85-e">⚠ @Sso.LastError</div>
            }
        </div>
    </div>

    @* ── v7.0.0 로컬-클라우드 하이브리드 추론 집계 ── *@
    <div class="gth-hybrid">
        <div class="gth-hybrid-h">🧠 하이브리드 메시
            <span class="gth-hybrid-be">가속기 @AcceleratorLabel · 원격 @(Hybrid.RemoteUsableNodes)노드</span>
        </div>
        <div class="gth-hybrid-grid">
            <span class="gth-hybrid-m"><b class="loc">@Hybrid.LocalDispatched</b><span>로컬 배정</span></span>
            <span class="gth-hybrid-m"><b class="rem">@Hybrid.RemoteDispatched</b><span>원격 배정</span></span>
            <span class="gth-hybrid-m"><b class="@(LocalInfer.Accelerated ? "acc" : null)">@LocalInfer.BackendLabel</b><span>@(LocalInfer.NativeReady ? "네이티브 텐서" : "감지(BCL 연산)")</span></span>
            <span class="gth-hybrid-m"><b class="@(_vramOk ? "acc" : null)">@_vramText</b><span>GPU VRAM</span></span>
        </div>
    </div>

    @* ── v6.3.0 REST Edge 서버 제어 ── *@
    <div class="gth-edge @(Edge.IsListening ? "on" : Edge.State == EdgeServerState.Failed ? "err" : null)">
        <div class="gth-edge-h">
            <span class="gth-edge-dot"></span>
            <span class="gth-edge-t">🌐 REST Edge 서버</span>
            <span class="gth-edge-s">@EdgeLabel</span>
        </div>
        <div class="gth-edge-row">
            @if (Edge.IsListening)
            {
                <code class="gth-edge-url">@Edge.Prefix<span>api/v1/render/batch</span></code>
                <button class="gth-edge-btn stop" @onclick="() => Edge.Stop()">■ 중지</button>
            }
            else
            {
                <input class="gth-edge-port" type="number" min="1" max="65535" @bind="_port" title="수신 포트" />
                <button class="gth-edge-btn go" @onclick="StartEdge">▶ 수신 시작</button>
            }
            <span class="gth-edge-req">요청 @Edge.RequestCount</span>
        </div>
        @if (Edge.State == EdgeServerState.Failed && !string.IsNullOrWhiteSpace(Edge.LastError))
        {
            <div class="gth-edge-e">⚠ @Edge.LastError</div>
        }
    </div>

    @* ── 게이트웨이 카운터 ── *@
    <div class="gth-gw">
        <div class="gth-gw-h">🔐 API 게이트웨이 <span class="gth-gw-t">@Gateway.TenantCount 테넌트</span></div>
        <div class="gth-gw-grid">
            <span class="gth-gw-m"><b>@Gateway.TotalRequests</b><span>총 요청</span></span>
            <span class="gth-gw-m"><b class="ok">@Gateway.AllowedCount</b><span>허용</span></span>
            <span class="gth-gw-m"><b class="warn">@Gateway.Denied429Count</b><span>429 거부</span></span>
            <span class="gth-gw-m"><b class="err">@Gateway.Denied401Count</b><span>401 거부</span></span>
            <span class="gth-gw-m"><b class="acc">@Gateway.DispatchedCount</b><span>렌더 이관</span></span>
        </div>

