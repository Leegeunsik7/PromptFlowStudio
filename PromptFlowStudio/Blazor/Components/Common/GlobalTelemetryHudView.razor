    // RPS 표본 → SVG 폴리라인/면적 좌표(240×60 뷰박스 · 로캘 독립).
    private void Rebuild()
    {
        var samples = Telemetry.Samples;
        _pts = samples.Select(s => (double)s.Rps).ToArray();
        _max = Math.Max(1, _pts.Length == 0 ? 1 : (int)_pts.Max());
        if (_pts.Length < 2) { _linePts = ""; _areaPts = ""; return; }

        const double w = 240, h = 60;
        var n = _pts.Length;
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < n; i++)
        {
            var x = i / (double)(n - 1) * w;
            var y = h - Math.Clamp(_pts[i] / _max, 0, 1) * (h - 4) - 2;
            if (i > 0) sb.Append(' ');
            sb.Append(x.ToString("0.#", CultureInfo.InvariantCulture)).Append(',').Append(y.ToString("0.#", CultureInfo.InvariantCulture));
        }
        _linePts = sb.ToString();
        _areaPts = $"0,{h.ToString("0.#", CultureInfo.InvariantCulture)} {_linePts} {w.ToString("0.#", CultureInfo.InvariantCulture)},{h.ToString("0.#", CultureInfo.InvariantCulture)}";
    }

    private static string Fmt(double v) => ((int)Math.Round(v)).ToString(CultureInfo.InvariantCulture);
    private static string Pct(double v01) => (Math.Clamp(v01, 0, 1) * 100).ToString("0", CultureInfo.InvariantCulture) + "%";

