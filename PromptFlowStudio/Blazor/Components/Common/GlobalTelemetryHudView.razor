    private void SendMesh(bool chaos)
    {
        var targets = P2p.Nodes.Where(n => n.NodeId != P2p.LocalNodeId && n.State != MeshNodeState.Dead).ToArray();
        if (targets.Length == 0) { _meshNote = "도달 가능한 노드 없음"; return; }

        // 가장 먼 노드를 목적지로 선택해 다중 홉 릴레이를 유도.
        var dest = targets.OrderByDescending(n => n.Hops).First().NodeId;
        var r = P2p.Send(dest, "hud-probe-" + DateTimeOffset.UtcNow.ToString("O", CultureInfo.InvariantCulture), chaos);
        _meshNote = (r.Delivered ? "전달" : r.Reason) + " · " + (r.Path.Count - 1).ToString(CultureInfo.InvariantCulture)
            + "홉 · 재라우팅 " + r.Reroutes.ToString(CultureInfo.InvariantCulture);
    }

    private void TamperMesh()
    {
        if (P2p.LastRoute?.Envelope is not { } env) return;
        var intact = P2p.VerifyEnvelope(env);
        // 홉 절단 위조: 목록만 줄이고 HopCount 는 유지 → 개수 바인딩으로 거부되어야 한다.
        var forged = env with { Hops = env.Hops.Take(Math.Max(0, env.Hops.Count - 1)).ToArray() };
        var forgedPass = P2p.VerifyEnvelope(forged);
        _meshNote = "원본 " + (intact ? "무결" : "불일치") + " · 절단 위조 " + (forgedPass ? "통과(결함)" : "거부");
    }

