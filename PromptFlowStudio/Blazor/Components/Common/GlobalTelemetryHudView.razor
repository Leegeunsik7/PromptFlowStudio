    private void TraceGraph()
    {
        _graphHops = Graph.TraceModuleDependencies(_graphQuery, depth: 3, reverse: true, limit: 6);
        _graphBoundary = Graph.CommunityBoundary(_graphQuery);
        if (_graphHops.Count == 0)
        {
            var found = Graph.FindNodes(_graphQuery, 4);
            if (found.Count > 0)
            {
                _godNodes = found;
                _graphBoundary ??= Graph.CommunityBoundary(found[0].Id);
            }
        }
    }

