    private async Task RunWanBackendDemo()
    {
        if (_wanDemoRunning) return;
        _wanDemoRunning = true; _lastWanProgress = null;
        try
        {
            var conn = await BackendFactory.GetActiveConnectorAsync();
            _wanActiveConn = conn;
            var jobId = $"hud-demo-{DateTimeOffset.UtcNow.Ticks % 100000}";
            _wanActiveJobId = jobId;
            var spec = new WanJobSpec("wan1.3b_fp8", 832, 480, 33, 16, WanQuantMode.Fp16);
            var sub = await conn.SubmitJobAsync(new WanBackendJobRequest(jobId, spec, "HUD 백엔드 데모 · 시네마틱 테스트 프롬프트"));
            if (!sub.Accepted) { _lastWanProgress = new WanBackendProgress(jobId, WanBackendStage.Failed, 0, sub.Message); return; }

            await foreach (var p in conn.StreamProgressAsync(jobId))
            {
                _lastWanProgress = p;
                StateHasChanged();
            }
        }
        finally { _wanDemoRunning = false; }
    }

