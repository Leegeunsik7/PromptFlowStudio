            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(3));
            await op(cts.Token);
        }
        catch (Exception ex) { _lifeNote = "OBS: " + ex.Message; }
        finally { _obsBusy = false; await InvokeAsync(StateHasChanged); }
    }

