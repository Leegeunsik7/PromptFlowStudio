@* [PromptFlow Studio v6.2.0] 글로벌 관제 HUD — API RPS · GPU 슬롯 · Webhook 처리 · EWMA 지연을 실시간 표출(데스크톱 전용).
   ⚠ 데스크톱 메인 레이아웃 오버레이 전용(모바일 미마운트)이라 @inject 안전. Telemetry.OnChange 는 1초 타이머(백그라운드) 스레드 → InvokeAsync(StateHasChanged) 마샬링(제3헌장). Pure CSS/SVG(외부 APM/차트 0 · 제약사항 2). *@

<div class="gth">
    <div class="gth-head">
        <span class="gth-title">📊 글로벌 관제 (Global Observability)</span>
        <span class="gth-sub">최근 @(TelemetryAggregator.Window)초 롤링 · 1초 집계</span>
    </div>

    @* ── 네온 상태 카드 ── *@
    <div class="gth-cards">
        <div class="gth-card rps">
            <span class="gth-card-v">@Telemetry.CurrentRps</span>
            <span class="gth-card-l">API RPS <span class="gth-card-x">peak @Telemetry.PeakRps</span></span>
        </div>
        <div class="gth-card lat">
            <span class="gth-card-v">@Fmt(Telemetry.AvgLatencyMs)<small>ms</small></span>
            <span class="gth-card-l">EWMA 지연</span>
        </div>
        <div class="gth-card gpu">
            <span class="gth-card-v">@Telemetry.GpuInFlight<small>/@TotalSlots</small></span>
            <span class="gth-card-l">GPU 슬롯 <span class="gth-card-x">@(Telemetry.GpuUsableNodes)노드</span></span>
        </div>
        <div class="gth-card wh">
            <span class="gth-card-v">@Pct(Telemetry.WebhookSuccessRate)</span>
            <span class="gth-card-l">Webhook 성공률 <span class="gth-card-x">대기 @Webhook.QueuedCount</span></span>
        </div>
    </div>

    @* ── RPS 스파크라인(Pure SVG · viewBox 없이 폭 스케일) ── *@
    <div class="gth-graph">
        <div class="gth-graph-h"><span>API RPS 추이</span><span class="gth-graph-max">max @_max</span></div>
        <svg class="gth-spark" viewBox="0 0 240 60" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="gthFill" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.5" />
                    <stop offset="100%" stop-color="#22d3ee" stop-opacity="0" />
                </linearGradient>
            </defs>
            @if (_pts.Length >= 2)
            {
                <polygon points="@_areaPts" fill="url(#gthFill)" />
                <polyline points="@_linePts" fill="none" stroke="#22d3ee" stroke-width="1.5" stroke-linejoin="round" />
            }
            else
            {
                <line x1="0" y1="59" x2="240" y2="59" stroke="#334155" stroke-width="1" />
            }
        </svg>
    </div>

    @* ── v8.1.0 스트레스 오디트 ── *@
    <div class="gth-stress @(Stress.Last?.Pass == true ? "pass" : Stress.Last is null ? null : "fail")">
        <div class="gth-stress-h">
            🧪 시스템 스트레스 오디트
            <button class="gth-stress-btn" @onclick="RunStress" disabled="@(Stress.IsRunning)">@(Stress.IsRunning ? "실행 중…" : "▶ 300건 주입")</button>
        </div>
        @if (Stress.Last is { } a)
        {
            <div class="gth-stress-grid">
                <span class="gth-stress-m"><b class="@(a.Pass ? "ok" : "err")">@(a.Pass ? "PASS" : "FAIL")</b><span>결과</span></span>
                <span class="gth-stress-m"><b class="@(a.GatewayOk ? "ok" : "err")">@a.Denied429</b><span>429 방어</span></span>
                <span class="gth-stress-m"><b class="@(a.C2paOk ? "ok" : "err")">@(a.C2paOk ? "무결" : "실패")</b><span>C2PA</span></span>
                <span class="gth-stress-m"><b class="@(a.SwarmOk ? "ok" : "err")">@(a.SwarmOk ? "수렴" : "실패")</b><span>스웜</span></span>
                <span class="gth-stress-m"><b>@($"{a.Gc0}/{a.Gc1}/{a.Gc2}")</b><span>GC 0/1/2</span></span>
                <span class="gth-stress-m"><b class="acc">@a.LatencyMs.ToString("0")ms</b><span>지연</span></span>
            </div>
        }
    </div>

    @* ── v8.0.0 에이전트 스웜 · 공간 3D · C2PA 관제 ── *@
    <div class="gth-v8">
        <div class="gth-v8-card swarm">
            <div class="gth-v8-h">🤖 에이전트 스웜 자율 교정 @(Swarm.IsRunning ? "· 가동 중" : "")</div>
            <div class="gth-v8-grid">
                <span class="gth-v8-m"><b>@Swarm.TotalRounds</b><span>라운드</span></span>
                <span class="gth-v8-m"><b class="warn">@Swarm.DefectsFound</b><span>결함 감지</span></span>
                <span class="gth-v8-m"><b class="ok">@Swarm.DefectsResolved</b><span>자율 교정</span></span>
            </div>
        </div>
        <div class="gth-v8-card spatial">
            <div class="gth-v8-h">🥽 공간 3D 자산</div>
            <div class="gth-v8-grid">
                <span class="gth-v8-m"><b class="acc">@Spatial.TranscodedClips</b><span>SBS 변환 컷</span></span>
                <span class="gth-v8-m"><b>@(Spatial.LastPlan?.Clips.Count ?? 0)</b><span>최근 계획</span></span>
                <span class="gth-v8-m"><b class="@(C2paSafe ? "ok" : "err")">@(C2paSafe ? "무결" : "경고")</b><span>C2PA</span></span>
            </div>
            @if (!C2paSafe && !string.IsNullOrWhiteSpace(C2pa.LastAlert))
            {
                <div class="gth-v8-alert">🔒 @C2pa.LastAlert (변조 @C2pa.TamperCount)</div>
            }
        </div>
    </div>

    @* ── v8.2.0 클라우드 오토스케일 · 실시간 협업 관제 ── *@
    <div class="gth-v82">
        <div class="gth-v82-card scaler @(Scaler.Pressure > 0 ? "hot" : null)">
            <div class="gth-v82-h">
                ☁️ 클라우드 오토스케일
                <span class="gth-v82-be">@(Scaler.Enabled ? "자동" : "정지") · @(Scaler.ProviderConfigured ? "실 공급자" : "스텁")</span>
            </div>
            <div class="gth-v82-grid">
                <span class="gth-v82-m"><b class="acc">@Scaler.ActiveInstances<small>/@Scaler.MaxNodes</small></b><span>활성 인스턴스</span></span>
                <span class="gth-v82-m"><b class="@(Scaler.Pressure > 0 ? "warn" : "ok")">@Scaler.Pressure</b><span>부하 압력</span></span>
                <span class="gth-v82-m"><b class="up">@Scaler.ScaleOutEvents</b><span>Scale-out</span></span>
                <span class="gth-v82-m"><b class="dn">@Scaler.ScaleInEvents</b><span>Scale-in</span></span>
            </div>
            <div class="gth-v82-row">
                <button class="gth-v82-btn go" @onclick="ScaleOut">▲ +1 노드</button>
                <button class="gth-v82-btn stop" @onclick="ScaleInOne" disabled="@(Scaler.ActiveInstances == 0)">▼ −1 노드</button>
                @if (!string.IsNullOrWhiteSpace(Scaler.LastAction))
                {
                    <span class="gth-v82-act">@Scaler.LastAction</span>
                }
            </div>
        </div>
        <div class="gth-v82-card collab @(Collab.IsListening ? "on" : Collab.State == CollabHubState.Failed ? "err" : null)">
            <div class="gth-v82-h">
                👥 실시간 협업 <span class="gth-v82-be">@CollabLabel · site @Collab.SiteId</span>
            </div>
            <div class="gth-v82-grid">
                <span class="gth-v82-m"><b class="acc">@Collab.ConnectedPeers</b><span>접속 피어</span></span>
                <span class="gth-v82-m"><b>@Collab.SyncedClips</b><span>동기 클립</span></span>
                <span class="gth-v82-m"><b class="ok">@Collab.DeltasApplied</b><span>델타 적용</span></span>
                <span class="gth-v82-m"><b class="warn">@Collab.Conflicts</b><span>LWW 충돌</span></span>
            </div>
            <div class="gth-v82-row">
                @if (Collab.IsListening)
                {
                    <code class="gth-v82-url">@Collab.Prefix<span>timeline</span></code>
                    <button class="gth-v82-btn stop" @onclick="() => Collab.Stop()">■ 중지</button>
                }
                else
                {
                    <input class="gth-v82-port" type="number" min="1" max="65535" @bind="_collabPort" title="협업 포트" />
                    <button class="gth-v82-btn go" @onclick="StartCollab">▶ 협업 시작</button>
                }
            </div>
            @if (Collab.State == CollabHubState.Failed && !string.IsNullOrWhiteSpace(Collab.LastError))
            {
                <div class="gth-v82-e">⚠ @Collab.LastError</div>
            }
        </div>
    </div>

    @* ── v8.4.0 AI 플릿 · 폐쇄망 재해 복구 관제 ── *@
    <div class="gth-v84">
        <div class="gth-v84-card fleet">
            <div class="gth-v84-h">🤖 AI 에이전트 플릿 <span class="gth-v84-be">활성 @Fleet.ActiveWorkers/@Fleet.WorkerCount</span></div>
            <div class="gth-v84-grid">
                <span class="gth-v84-m"><b class="acc">@Fleet.ActiveWorkers</b><span>활성 워커</span></span>
                <span class="gth-v84-m"><b class="warn">@Fleet.QuarantinedWorkers</b><span>격리</span></span>
                <span class="gth-v84-m"><b class="up">@Fleet.SpawnCount</b><span>스폰</span></span>
                <span class="gth-v84-m"><b class="ok">@Fleet.TotalAssigned</b><span>작업 배정</span></span>
            </div>
            @if (!string.IsNullOrWhiteSpace(Fleet.LastAction))
            {
                <div class="gth-v84-act">@Fleet.LastAction</div>
            }
        </div>
        <div class="gth-v84-card dr">
            <div class="gth-v84-h">💾 폐쇄망 재해 복구
                <button class="gth-v84-btn go" @onclick="CaptureSnapshot">📸 스냅샷</button>
            </div>
            <div class="gth-v84-grid">
                <span class="gth-v84-m"><b class="acc">@Recovery.SnapshotCount</b><span>스냅샷</span></span>
                <span class="gth-v84-m"><b class="ok">@Recovery.RestoreCount</b><span>복구</span></span>
                <span class="gth-v84-m"><b>@Timeline.ClipCount</b><span>현재 클립</span></span>
            </div>
            @if (!string.IsNullOrWhiteSpace(Recovery.LastSnapshotHash))
            {
                <code class="gth-v84-hash">🔗 @Hash12(Recovery.LastSnapshotHash!)</code>
            }
        </div>
    </div>

    @* ── v8.6.0 분산 합의 · AI 장애 예측 관제 ── *@
    <div class="gth-v86">
        <div class="gth-v86-card raft @(Consensus.HasLeader ? "led" : "vote")">
            <div class="gth-v86-h">🗳️ 분산 합의 (Raft)
                <span class="gth-v86-be">term @Consensus.CurrentTerm · @(Consensus.HasLeader ? Consensus.LeaderId : "선출 중")</span>
            </div>
            <div class="gth-v86-grid">
                <span class="gth-v86-m"><b class="acc">@Consensus.AliveCount<small>/@Consensus.NodeCount</small></b><span>정족 노드</span></span>
                <span class="gth-v86-m"><b class="ok">@(Consensus.CommitIndex + 1)</b><span>커밋 로그</span></span>
                <span class="gth-v86-m"><b>@Consensus.Elections</b><span>선출 횟수</span></span>
                <span class="gth-v86-m"><b class="up">@Consensus.HeartbeatCount</b><span>하트비트</span></span>
            </div>
        </div>
        <div class="gth-v86-card fore @(Predictive.Risk == ForecastRisk.Critical ? "crit" : Predictive.Risk == ForecastRisk.Elevated ? "warn" : null)">
            <div class="gth-v86-h">🔮 AI 장애 예측 <span class="gth-v86-be">@RiskLabel · @(PredictiveTelemetryEngine.Horizon)s 지평</span></div>
            <div class="gth-v86-grid">
                <span class="gth-v86-m"><b class="@ForeColor">@Fmt(Predictive.Latest?.ForecastLatencyMs ?? 0)<small>ms</small></b><span>예측 지연</span></span>
                <span class="gth-v86-m"><b class="@ForeColor">@Pct(Predictive.Latest?.SaturationForecast ?? 0)</b><span>예측 포화</span></span>
                <span class="gth-v86-m"><b>@Predictive.Forecasts</b><span>예측 표본</span></span>
                <span class="gth-v86-m"><b class="err">@Predictive.Warnings</b><span>선제 경고</span></span>
            </div>
            @if (!string.IsNullOrWhiteSpace(Predictive.LastWarning))
            {
                <div class="gth-v86-alert">@Predictive.LastWarning</div>
            }
        </div>
    </div>

    @* ── v8.7.0 멀티 리전 페일오버 · 양자 원장 서명 · 제로 트러스트 메쉬 관제 ── *@
    <div class="gth-v87">
        <div class="gth-v87-card region @(RegionFailover.QuorumOk ? "ok" : "warn")">
            <div class="gth-v87-h">🌐 멀티리전 페일오버 <span class="gth-v87-be">쿼럼 @RegionFailover.HealthyCount/@RegionFailover.RegionCount</span></div>
            <div class="gth-v87-grid">
                <span class="gth-v87-m"><b class="acc">@(RegionFailover.ActiveRegionId ?? "—")</b><span>활성 리전</span></span>
                <span class="gth-v87-m"><b class="@(RegionFailover.QuorumOk ? "ok" : "err")">@(RegionFailover.QuorumOk ? "정상" : "미달")</b><span>정족수</span></span>
                <span class="gth-v87-m"><b class="up">@RegionFailover.FailoverCount</b><span>페일오버</span></span>
                <span class="gth-v87-m"><b>@RegionFailover.ProbeCount</b><span>프로브</span></span>
            </div>
            <div class="gth-v87-row">
                <button class="gth-v87-btn go" @onclick="ForceRegionFailover" disabled="@(RegionFailover.ActiveRegionId is null)">🔀 강제 페일오버 테스트</button>
                @if (!string.IsNullOrWhiteSpace(RegionFailover.LastAction))
                {
                    <span class="gth-v87-act">@RegionFailover.LastAction</span>
                }
            </div>
        </div>
        <div class="gth-v87-card ledger">
            <div class="gth-v87-h">🔐 양자 원장 서명 <span class="gth-v87-be">@Ledger.Keys.Algorithm</span></div>
            <div class="gth-v87-grid">
                <span class="gth-v87-m"><b class="acc">@Ledger.EntryCount</b><span>원장 항목</span></span>
                <span class="gth-v87-m"><b class="ok">@Ledger.VerifiedOk</b><span>검증 통과</span></span>
                <span class="gth-v87-m"><b class="@(Ledger.TamperCount == 0 ? "ok" : "err")">@Ledger.TamperCount</b><span>변조 경고</span></span>
                <span class="gth-v87-m"><b>@Ledger.SignedCount</b><span>서명 건수</span></span>
            </div>
            <div class="gth-v87-row">
                <button class="gth-v87-btn go" @onclick="SignLedgerSample">🖊️ 샘플 서명</button>
                <button class="gth-v87-btn chk" @onclick="VerifyLedgerChain">✅ 체인 검증</button>
                <code class="gth-v87-hash">🔗 @Hash12(Ledger.ChainHead)</code>
            </div>
            @if (!string.IsNullOrWhiteSpace(LastVerify))
            {
                <div class="gth-v87-act">@LastVerify</div>
            }
        </div>
        <div class="gth-v87-card mesh">
            <div class="gth-v87-h">🕸️ 제로 트러스트 메쉬 <span class="gth-v87-be">피어 @Mesh.PeerCount</span></div>
            <div class="gth-v87-grid">
                <span class="gth-v87-m"><b class="ok">@Mesh.Allowed</b><span>허용</span></span>
                <span class="gth-v87-m"><b class="err">@Mesh.Denied401</b><span>401 거부</span></span>
                <span class="gth-v87-m"><b class="warn">@Mesh.DeniedOpen</b><span>회로 Open</span></span>
                <span class="gth-v87-m"><b class="up">@Mesh.TripCount</b><span>차단 전이</span></span>
            </div>
            @if (Mesh.Peers.Count > 0)
            {
                <div class="gth-v87-peers">
                    @foreach (var p in Mesh.Peers)
                    {
                        <div class="gth-v87-peer @(p.State == CircuitState.Open ? "open" : p.State == CircuitState.HalfOpen ? "half" : "closed")" @key="p.SpiffeId">
                            <span class="gth-v87-peer-id">@p.SpiffeId</span>
                            <span class="gth-v87-peer-s">@PeerLabel(p.State)</span>
                        </div>
                    }
                </div>
            }
            <div class="gth-v87-row">
                <button class="gth-v87-btn go" @onclick="ProbeMeshPeers" disabled="@(_meshProbing)">@(_meshProbing ? "프로브 중…" : "📡 RPC 프로브")</button>
            </div>
        </div>
    </div>

    @* ── v8.8.0 엣지 스웜 연합 · 자율 메모리 압축 · MAUI 모바일 브리지 관제 ── *@
    <div class="gth-v88">
        <div class="gth-v88-card fed @(Federation.IsConverged ? "ok" : Federation.IsFederating ? "run" : null)">
            <div class="gth-v88-h">🛰️ 엣지 스웜 연합
                <span class="gth-v88-be">@Federation.NodeId · 피어 @(Federation.LinkedCount)/@(Federation.PeerCount)</span>
            </div>
            <div class="gth-v88-grid">
                <span class="gth-v88-m"><b class="@(Federation.AgreementRatio >= 1d ? "ok" : "warn")">@Pct(Federation.AgreementRatio)</b><span>합의율</span></span>
                <span class="gth-v88-m"><b class="acc">@Federation.DeltasOut</b><span>델타 송신</span></span>
                <span class="gth-v88-m"><b class="up">@Federation.DeltasIn</b><span>델타 수신</span></span>
                <span class="gth-v88-m"><b>@Federation.DuplicatesDropped<small>/@Federation.SignatureRejects</small></b><span>중복/서명거부</span></span>
            </div>
            @if (Federation.Peers.Count > 0)
            {
                <div class="gth-v88-peers">
                    @foreach (var p in Federation.Peers)
                    {
                        <div class="gth-v88-peer @(p.State == FederationPeerState.Linked ? "linked" : p.State == FederationPeerState.Partitioned ? "cut" : "deg")" @key="p.NodeId">
                            <span class="gth-v88-peer-id">@p.NodeId</span>
                            <span class="gth-v88-peer-s">@FedLabel(p.State)@(p.Agreed ? " ✓" : "")</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="gth-v88-empty">등록된 엣지 피어가 없습니다. RegisterPeer(nodeId, host:port) 로 연합 노드를 등록하세요.</div>
            }
            <div class="gth-v88-row">
                <button class="gth-v88-btn go" @onclick="RunFederatedConvergence" disabled="@Federation.IsFederating">@(Federation.IsFederating ? "수렴 중…" : "🔗 연합 수렴")</button>
                <span class="gth-v88-act">라운드 @(Federation.CurrentRound)/@(EdgeSwarmFederation.MaxRounds)</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(Federation.LastAction))
            {
                <div class="gth-v88-act">@Federation.LastAction</div>
            }
        </div>

        <div class="gth-v88-card mem @(Compactor.UnderPressure ? "warn" : null)">
            <div class="gth-v88-h">🧹 자율 메모리 압축
                <span class="gth-v88-be">@(Compactor.AutoEnabled ? "자동" : "수동") · 힙 @(Compactor.HeapMb)MB</span>
            </div>
            <div class="gth-v88-grid">
                <span class="gth-v88-m"><b class="@(Compactor.UnderPressure ? "err" : "ok")">@Pct(Compactor.FragmentationRatio)</b><span>파편화</span></span>
                <span class="gth-v88-m"><b class="acc">@Compactor.LohMb<small>/@(Compactor.PohMb)MB</small></b><span>LOH/POH</span></span>
                <span class="gth-v88-m"><b class="up">@Compactor.CompactionCount</b><span>압축 라운드</span></span>
                <span class="gth-v88-m"><b class="ok">@Compactor.ReclaimedTotalMb<small>MB</small></b><span>누적 회수</span></span>
            </div>
            <div class="gth-v88-bar"><div class="gth-v88-fill mem" style="width:@Pct(Compactor.FragmentationRatio)"></div></div>
            <div class="gth-v88-row">
                <button class="gth-v88-btn go" @onclick="CompactMemoryNow" disabled="@_compacting">@(_compacting ? "압축 중…" : "🧯 즉시 압축")</button>
                <button class="gth-v88-btn chk" @onclick="ToggleAutoCompaction">@(Compactor.AutoEnabled ? "⏸ 자동 중지" : "▶ 자동 시작")</button>
                <span class="gth-v88-act">풀 상한 @(Compactor.PoolMaxArrayLength / 1024)KB · 재튜닝 @Compactor.PoolRetunes</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(Compactor.LastAction))
            {
                <div class="gth-v88-act">@Compactor.LastAction</div>
            }
        </div>

        <div class="gth-v88-card bridge @(MobileBridge.IsNativeBound ? "ok" : null)">
            <div class="gth-v88-h">📱 MAUI 모바일 브리지
                <span class="gth-v88-be">@MobileBridge.PlatformLabel</span>
            </div>
            <div class="gth-v88-grid">
                <span class="gth-v88-m"><b class="ok">@MobileBridge.NativeCalls</b><span>네이티브 호출</span></span>
                <span class="gth-v88-m"><b class="warn">@MobileBridge.StubFallbacks</b><span>스텁 폴백</span></span>
                <span class="gth-v88-m"><b class="acc">@MobileBridge.PendingCount</b><span>보류 큐</span></span>
                <span class="gth-v88-m"><b class="up">@MobileBridge.ReplayedCalls</b><span>재생</span></span>
            </div>
            @if (MobileBridge.CapabilityLabels.Count > 0)
            {
                <div class="gth-v88-caps">
                    @foreach (var c in MobileBridge.CapabilityLabels)
                    {
                        <span class="gth-v88-cap" @key="c">@c</span>
                    }
                </div>
            }
            else
            {
                <div class="gth-v88-empty">네이티브 훅 미결선 — 데스크톱은 BCL 스텁 경로로 동작하며 호출은 보류 큐에 보존됩니다.</div>
            }
            <div class="gth-v88-row">
                <button class="gth-v88-btn go" @onclick="TestMobileHaptic">📳 햅틱 테스트</button>
                <button class="gth-v88-btn chk" @onclick="FlushMobileBridge" disabled="@(MobileBridge.PendingCount == 0)">♻ 보류 재생</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(MobileBridge.LastAction))
            {
                <div class="gth-v88-act">@MobileBridge.LastAction</div>
            }
        </div>
    </div>

    @* ── v9.0.0 엔터프라이즈 마스터 릴리스 — 통합 오케스트레이션 · 보안 최종 봉인 · Air-Gapped 매니페스트 ── *@
    <div class="gth-v90">
        <div class="gth-v90-card master @(Master.SystemState == MasterSystemState.Operational ? "ok" : Master.IsBooting ? "run" : Master.SystemState == MasterSystemState.Critical ? "err" : Master.SystemState == MasterSystemState.Degraded ? "warn" : null)">
            <div class="gth-v90-h">🏆 마스터 오케스트레이터
                <span class="gth-v90-be">@SystemLabel · 가동 @(((int)Master.Uptime.TotalMinutes))분</span>
            </div>
            <div class="gth-v90-grid">
                <span class="gth-v90-m"><b class="acc">@Master.ModuleCount</b><span>등록 모듈</span></span>
                <span class="gth-v90-m"><b class="ok">@Master.ReadyCount</b><span>준비</span></span>
                <span class="gth-v90-m"><b class="warn">@Master.DegradedCount</b><span>저하</span></span>
                <span class="gth-v90-m"><b class="err">@Master.DownCount</b><span>정지</span></span>
            </div>
            <div class="gth-v90-bar"><div class="gth-v90-fill master" style="width:@Pct(Master.ReadinessRatio)"></div></div>
            <div class="gth-v90-caps">
                @foreach (var t in Master.TierRollup)
                {
                    <span class="gth-v90-cap @(t.Ready == t.Total ? "full" : null)" @key="t.Tier">@TierLabel(t.Tier) <small>@(t.Ready)/@(t.Total)</small></span>
                }
            </div>
            @if (_masterMods.Count > 0)
            {
                <div class="gth-v90-mods">
                    @foreach (var m in _masterMods)
                    {
                        <div class="gth-v90-mod @(m.State == MasterModuleState.Ready ? "linked" : m.State == MasterModuleState.Degraded ? "deg" : "cut")" @key="m.Name">
                            <span class="gth-v90-mod-n">@m.Name</span>
                            <span class="gth-v90-mod-s">@(m.Note ?? m.Metric)</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="gth-v90-empty">모듈 미등록 — 전체 시동을 실행하면 v8 전 모듈이 계층(Core→Edge) 순으로 등록·프로브됩니다.</div>
            }
            <div class="gth-v90-row">
                <button class="gth-v90-btn go" @onclick="BootMaster" disabled="@Master.IsBooting">@(Master.IsBooting ? "시동 중… " + (Master.CurrentModule ?? "") : "▶ 전체 시동")</button>
                <button class="gth-v90-btn chk" @onclick="RefreshMaster" disabled="@Master.IsBooting">↻ 재프로브</button>
                <button class="gth-v90-btn stop" @onclick="StopMaster" disabled="@Master.IsBooting">■ 정지</button>
            </div>
            <div class="gth-v90-act">@(Master.LastAction ?? "대기 중")</div>
        </div>

        <div class="gth-v90-card seal @(SecSeal.LastVerdict == SealVerdict.Pass ? "ok" : SecSeal.IsSealing ? "run" : SecSeal.LastVerdict == SealVerdict.Fail ? "err" : SecSeal.LastVerdict == SealVerdict.Warn ? "warn" : null)">
            <div class="gth-v90-h">🛡 프로덕션 보안 봉인
                <span class="gth-v90-be">@VerdictLabel(SecSeal.LastVerdict)@(SecSeal.LastCertificate?.IsSigned == true ? " · HMAC 서명" : "")</span>
            </div>
            <div class="gth-v90-grid">
                <span class="gth-v90-m"><b class="ok">@(SecSeal.LastCertificate?.Pass ?? 0)</b><span>통과</span></span>
                <span class="gth-v90-m"><b class="warn">@(SecSeal.LastCertificate?.Warn ?? 0)</b><span>주의</span></span>
                <span class="gth-v90-m"><b class="err">@(SecSeal.LastCertificate?.Fail ?? 0)</b><span>실패</span></span>
                <span class="gth-v90-m"><b class="up">@(SecSeal.LastCertificate?.Unknown ?? 0)</b><span>미주입</span></span>
            </div>
            @if (SecSeal.Pillars.Count > 0)
            {
                <div class="gth-v90-mods">
                    @foreach (var p in SecSeal.Pillars)
                    {
                        <div class="gth-v90-mod @(p.Verdict == SealVerdict.Pass ? "linked" : p.Verdict == SealVerdict.Warn ? "deg" : p.Verdict == SealVerdict.Fail ? "cut" : null)" @key="p.Pillar">
                            <span class="gth-v90-mod-n">@p.Name</span>
                            <span class="gth-v90-mod-s">@p.Metric</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="gth-v90-empty">미봉인 — C2PA 출처 · WORM 원장 · SAML/OIDC · ZTNA 메쉬 4주를 단일 헬스체크로 판정해 무결성 인증서를 발급합니다.</div>
            }
            @if (!string.IsNullOrWhiteSpace(SecSeal.LastFingerprint))
            {
                <code class="gth-v90-hash">SHA-256 @(SecSeal.LastFingerprint!.Substring(0, 24))…</code>
            }
            <div class="gth-v90-row">
                <button class="gth-v90-btn go" @onclick="SealProduction" disabled="@SecSeal.IsSealing">@(SecSeal.IsSealing ? "봉인 중… " + (SecSeal.CurrentPillar ?? "") : "🔒 최종 봉인")</button>
                <button class="gth-v90-btn chk" @onclick="VerifySeal" disabled="@(SecSeal.LastCertificate is null)">✔ 인증서 검증</button>
            </div>
            <div class="gth-v90-act">@(_sealVerified is null ? (SecSeal.LastIssue ?? (SecSeal.IsProductionSealed ? "출하 가능 — Fail 0" : "대기 중")) : _sealVerified == true ? "✔ 인증서 무결 — 지문/서명 일치" : "⚠ 인증서 위변조 — 지문 불일치")</div>
        </div>

        <div class="gth-v90-card rel @(Manifest.LastManifest is not null ? "ok" : Manifest.IsBuilding ? "run" : null)">
            <div class="gth-v90-h">📦 마스터 릴리스 매니페스트
                <span class="gth-v90-be">v@Manifest.Version · Air-Gapped</span>
            </div>
            <div class="gth-v90-grid">
                <span class="gth-v90-m"><b class="acc">@Manifest.HashedFiles</b><span>지문 파일</span></span>
                <span class="gth-v90-m"><b class="up">@((Manifest.LastManifest?.TotalMb ?? 0).ToString("0.#", CultureInfo.InvariantCulture))</b><span>산출물 MB</span></span>
                <span class="gth-v90-m"><b class="@(Manifest.License is null ? "warn" : "ok")">@(Manifest.License is null ? "미발급" : Manifest.License.DaysRemaining + "일")</b><span>라이선스</span></span>
                <span class="gth-v90-m"><b>@Manifest.BuildCount</b><span>생성 횟수</span></span>
            </div>
            @if (!string.IsNullOrWhiteSpace(Manifest.RootHash))
            {
                <code class="gth-v90-hash">ROOT @(Manifest.RootHash!.Substring(0, 24))…</code>
            }
            else
            {
                <div class="gth-v90-empty">매니페스트 미생성 — 배포 산출물(dll/exe/json)을 스트리밍 SHA-256 지문화해 루트 해시로 봉인합니다.</div>
            }
            @if (Manifest.License is not null)
            {
                <div class="gth-v90-mods">
                    <div class="gth-v90-mod @(_licenseValid == false ? "cut" : "linked")">
                        <span class="gth-v90-mod-n">@Manifest.License.Licensee · @Manifest.License.Edition</span>
                        <span class="gth-v90-mod-s">@(Manifest.License.Seats)석 · @(_licenseValid == false ? "토큰 불일치" : "자체검증 통과")</span>
                    </div>
                </div>
            }
            <div class="gth-v90-row">
                <button class="gth-v90-btn go" @onclick="BuildManifest" disabled="@Manifest.IsBuilding">@(Manifest.IsBuilding ? "해시 중… " + (Manifest.CurrentFile ?? "") : "🔏 매니페스트 생성")</button>
                <button class="gth-v90-btn chk" @onclick="IssueLicense">🎫 라이선스 발급</button>
                <button class="gth-v90-btn chk" @onclick="ExportManifest" disabled="@(Manifest.LastManifest is null)">💾 반출</button>
            </div>
            <div class="gth-v90-act">@(Manifest.LastError ?? Manifest.LastExportPath ?? "대기 중")</div>
        </div>
    </div>

    @* ── v9.1.0 MAUI 모바일 하이브리드 — 제스처 · 저전력 거버너 · 오프라인 스토리지 ── *@
    <div class="gth-v91">
        <div class="gth-v91-card ges @(Gesture.IsPinching ? "run" : Gesture.GestureCount > 0 ? "ok" : null)">
            <div class="gth-v91-h">📱 모바일 제스처 엔진
                <span class="gth-v91-be">@(Gesture.LastGesture?.Summary ?? "입력 대기")</span>
            </div>
            <div class="gth-v91-grid">
                <span class="gth-v91-m"><b class="acc">@Gesture.GestureCount</b><span>총 인식</span></span>
                <span class="gth-v91-m"><b class="up">@Gesture.SwipeCount</b><span>스와이프</span></span>
                <span class="gth-v91-m"><b class="ok">@Gesture.PinchCount</b><span>핀치</span></span>
                <span class="gth-v91-m"><b>@Gesture.ActivePointers</b><span>접점</span></span>
            </div>
            <div class="gth-v91-caps">
                <span class="gth-v91-cap ges">현재 뷰 <small>@Gesture.CurrentView</small></span>
                <span class="gth-v91-cap ges">줌 <small>x@(Gesture.ZoomScale.ToString("0.00", CultureInfo.InvariantCulture))</small></span>
                <span class="gth-v91-cap ges">트랙 <small>@(Fmt(Gesture.TimelinePixelsPerSecond))px/s</small></span>
                <span class="gth-v91-cap ges">패닝 <small>@(Gesture.PanOffsetSeconds.ToString("0.0", CultureInfo.InvariantCulture))s</small></span>
            </div>
            <div class="gth-v91-row">
                <button class="gth-v91-btn go" @onclick="() => SimulateSwipe(true)">◀ 스와이프</button>
                <button class="gth-v91-btn go" @onclick="() => SimulateSwipe(false)">스와이프 ▶</button>
                <button class="gth-v91-btn chk" @onclick="SimulatePinch">🔍 핀치 줌</button>
                <button class="gth-v91-btn stop" @onclick="ResetGesture">↺ 변환 초기화</button>
            </div>
            <div class="gth-v91-act">직전 뷰 @Gesture.PreviousView · 링 @(Gesture.SwipeRing.Count)단계</div>
        </div>

        <div class="gth-v91-card pwr @(Power.Profile == MobilePowerProfile.Performance ? "ok" : Power.Profile == MobilePowerProfile.Critical ? "err" : Power.Profile == MobilePowerProfile.Saver ? "warn" : "run")">
            <div class="gth-v91-h">🔋 저전력 거버너
                <span class="gth-v91-be">@PowerLabel(Power.Profile)@(Power.IsForced ? " · 수동" : "")</span>
            </div>
            <div class="gth-v91-grid">
                <span class="gth-v91-m"><b class="@(Power.BatteryPercent < 0 ? "warn" : Power.BatteryPercent < 15 ? "err" : "ok")">@(Power.BatteryPercent < 0 ? "?" : Power.BatteryPercent.ToString(CultureInfo.InvariantCulture))</b><span>배터리%</span></span>
                <span class="gth-v91-m"><b class="acc">@Power.RecommendedUiFps</b><span>권고 FPS</span></span>
                <span class="gth-v91-m"><b class="up">@Power.RecommendedSwarmThreads</b><span>스웜 스레드</span></span>
                <span class="gth-v91-m"><b>@Power.TransitionCount</b><span>전환</span></span>
            </div>
            <div class="gth-v91-bar"><div class="gth-v91-fill pwr" style="width:@Pct(Power.BatteryLevel < 0 ? 0 : Power.BatteryLevel)"></div></div>
            <div class="gth-v91-caps">
                <span class="gth-v91-cap pwr @(Power.ScreenOn ? "on" : null)">화면 <small>@(Power.ScreenOn ? "켜짐" : "꺼짐")</small></span>
                <span class="gth-v91-cap pwr @(Power.IsCharging ? "on" : null)">충전 <small>@(Power.IsCharging ? "중" : "안함")</small></span>
                <span class="gth-v91-cap pwr @(Power.AllowBackgroundInference ? "on" : null)">백그라운드 추론 <small>@(Power.AllowBackgroundInference ? "허용" : "차단")</small></span>
                <span class="gth-v91-cap pwr">코어 <small>@Power.CoreCount</small></span>
            </div>
            <div class="gth-v91-row">
                <button class="gth-v91-btn go" @onclick="EvaluatePower">↻ 재평가</button>
                <button class="gth-v91-btn chk" @onclick="ToggleScreen">@(Power.ScreenOn ? "🌙 화면 꺼짐" : "☀ 화면 켜짐")</button>
                <button class="gth-v91-btn stop" @onclick="CyclePowerProfile">@(Power.IsForced ? "🔓 자동 복귀" : "🔒 절약 고정")</button>
            </div>
            <div class="gth-v91-act">@Power.LastReason@(Power.IsBridgeBound ? " · 브리지 결선" : " · 브리지 미주입")</div>
        </div>

        <div class="gth-v91-card sto @(OfflineStore.LastError is not null ? "err" : OfflineStore.IsDirty ? "warn" : OfflineStore.FlushCount > 0 ? "ok" : null)">
            <div class="gth-v91-h">💾 오프라인 스토리지
                <span class="gth-v91-be">@(OfflineStore.IsBusy ? "I/O 중…" : OfflineStore.IsDirty ? "미저장 변경" : "동기 완료")</span>
            </div>
            <div class="gth-v91-grid">
                <span class="gth-v91-m"><b class="acc">@OfflineStore.PromptCount</b><span>프롬프트</span></span>
                <span class="gth-v91-m"><b class="up">@OfflineStore.DeltaCount</b><span>델타</span></span>
                <span class="gth-v91-m"><b class="ok">@OfflineStore.FlushCount</b><span>플러시</span></span>
                <span class="gth-v91-m"><b>@OfflineStore.SizeLabel</b><span>디스크</span></span>
            </div>
            <div class="gth-v91-hash">@OfflineStore.StoragePath</div>
            <div class="gth-v91-row">
                <button class="gth-v91-btn go" @onclick="SeedOfflineSample" disabled="@OfflineStore.IsBusy">✎ 샘플 적재</button>
                <button class="gth-v91-btn chk" @onclick="FlushOfflineStore" disabled="@OfflineStore.IsBusy">💾 플러시</button>
                <button class="gth-v91-btn chk" @onclick="LoadOfflineStore" disabled="@OfflineStore.IsBusy">📂 복원</button>
                <button class="gth-v91-btn stop" @onclick="ClearOfflineStore" disabled="@OfflineStore.IsBusy">🗑 비우기</button>
            </div>
            <div class="gth-v91-act">@(OfflineStore.LastError ?? _offlineNote ?? "대기 중")</div>
        </div>
    </div>

    @* ── v10.3.0 프로덕션 아티팩트 패키징 & 릴리스 무결성 최종 검증 & 배포 매니페스트 내보내기(Final) ── *@
    <div class="gth-v103">
        <div class="gth-v96-card pkg @(Packager.LastReport is { AnyPackaged: true } ? "ok" : null)">
            <div class="gth-v96-h">📦 프로덕션 아티팩트 패키저
                <span class="gth-v96-be">성공 @(Packager.PackagedCount) · 스킵 @(Packager.SkippedCount)</span>
            </div>
            @if (Packager.LastReport is { } pkr)
            {
                <div class="gth-v96-rows">
                    @foreach (var pa in pkr.Packaged)
                    {
                        <div class="gth-v96-row-i" @key="@("pkg" + pa.Platform)">
                            <span class="gth-v96-n">@(pa.DisplayName)</span>
                            <span class="gth-v96-s">@((pa.Bytes / 1024.0 / 1024.0).ToString("0.##", CultureInfo.InvariantCulture))MB · @(pa.FileCount)파일</span>
                        </div>
                    }
                    @foreach (var sk in pkr.Skipped)
                    {
                        <div class="gth-v96-row-i deg" @key="@("skip" + sk)">
                            <span class="gth-v96-n">스킵</span>
                            <span class="gth-v96-s">@(sk)</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="gth-v96-empty">패키징 이력이 없습니다. Windows(현재 빌드 자체)/Android/iOS/Shared RCL 산출물을 zip 번들로 구성합니다(없는 플랫폼은 Graceful 스킵).</div>
            }
            <div class="gth-v96-row">
                <button class="gth-v96-btn chk" @onclick="RunPackageAll">📦 전체 패키징</button>
                <button class="gth-v96-btn" @onclick="Packager.ResetAll">↻ 초기화</button>
            </div>
            <div class="gth-v96-act">@(Packager.LastAction ?? "대기 중")</div>
        </div>

        <div class="gth-v96-card integrity @(IntegrityValidator.TamperDetected > 0 ? "err" : IntegrityValidator.Verified > 0 ? "ok" : null)">
            <div class="gth-v96-h">🔏 릴리스 무결성 최종 검증
                <span class="gth-v96-be">@(IntegrityValidator.Sha3Active ? "SHA3-256" : "SHA-256(폴백)") · 원장 @(IntegrityValidator.LedgerCount)</span>
            </div>
            <div class="gth-v96-grid">
                <span class="gth-v96-m"><b class="up">@(IntegrityValidator.Signed)</b><span>서명</span></span>
                <span class="gth-v96-m"><b class="acc">@(IntegrityValidator.Verified)</b><span>검증</span></span>
                <span class="gth-v96-m"><b class="err">@(IntegrityValidator.TamperDetected)</b><span>변조</span></span>
                <span class="gth-v96-m"><b class="ok">@(IntegrityValidator.LedgerCount)</b><span>원장</span></span>
            </div>
            @if (IntegrityValidator.History.Count > 0)
            {
                <div class="gth-v96-rows">
                    @foreach (var hv in IntegrityValidator.History.Take(3))
                    {
