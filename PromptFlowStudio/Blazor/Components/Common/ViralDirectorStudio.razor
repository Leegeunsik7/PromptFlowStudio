@using System.Globalization
@using System.Text
@using System.Threading
@implements IDisposable
@inject ViralHookVariantGeneratorService Hooks
@inject RetentionHeatmapPredictorEngine Retention
@inject IServiceProvider Services

@* v16.23.0 🎬 AI 바이럴 후킹 감독 — 첫 3초 A/B/C 후킹 프리셋 · 유지율 예측 스펙트럼 · 스피드 램핑 · 1-Click A/B/C 생성/패키징/게시 *@
<div class="vds">
    <div class="vds-h" @onclick="() => _open = !_open">
        <span class="vds-tag">🎬 AI 바이럴 후킹 감독</span>
        <span class="vds-st">
            후킹 @(_opening.Score)점 · 예상 유지율 @(Pct(_pred?.AverageRetention ?? 0))%
            @if (_pred is { Zones.Length: > 0 } zp) { <b class="vds-warn"> · 이탈 위험 @(zp.Zones.Length)구간</b> }
            <span class="vds-chev">@(_open ? "▾" : "▸")</span>
        </span>
    </div>
    @if (_open)
    {
        <div class="vds-body">
            @* ── 첫 3초 후킹 스타일 프리셋 ── *@
            <div class="vds-sec">
                <div class="vds-lbl">⏱️ 첫 3초 후킹 프리셋 <span class="vds-sub">추천: @(ViralHookVariantGeneratorService.SpecOf(_opening.Recommended).Letter) @(ViralHookVariantGeneratorService.SpecOf(_opening.Recommended).Label)
                    · 질문 @(_opening.HasQuestion ? "✓" : "✗") · 클로즈업 @(_opening.HasCloseUp ? "✓" : "✗") · 모션 @(_opening.HasMotion ? "✓" : "✗")</span></div>
                <div class="vds-presets">
                    @for (var i = 0; i < ViralHookVariantGeneratorService.Specs.Count; i++)
                    {
                        var idx = i;
                        var sp = ViralHookVariantGeneratorService.Specs[idx];
                        <div class="vds-preset @(_selected[idx] ? "on" : null) @(sp.Style == _opening.Recommended ? "rec" : null)">
                            <label class="vds-pick">
                                <input type="checkbox" checked="@_selected[idx]" disabled="@Busy" @onchange="e => _selected[idx] = e.Value is true" />
                                <b>@(sp.Icon) @(sp.Letter)</b> @(sp.Label)
                            </label>
                            <span class="vds-sub">@sp.Description</span>
                            <textarea class="vds-copy" rows="2" disabled="@Busy" @bind="_copies[idx]"></textarea>
                        </div>
                    }
                </div>
            </div>

            @* ── 예상 시청자 유지율 스펙트럼 ── *@
            <div class="vds-sec">
                <div class="vds-lbl">📈 예상 시청자 유지율 <span class="vds-sub">
                    @if (_pred is { } pr)
                    {
                        @("원본 평균 " + Pct(pr.AverageRetention) + "% · 끝 " + Pct(pr.FinalRetention) + "% → 램핑 후 평균 " + Pct(pr.RampedAverageRetention) + "% · " + Sec(pr.TotalSeconds) + "s→" + Sec(pr.RampedTotalSeconds) + "s")
                    }
                    else { @("컷 프롬프트/나레이션을 입력하면 예측합니다") }
                </span></div>
                @if (_pred is { Curve.Length: > 1 } pg)
                {
                    <svg class="vds-graph" viewBox="0 0 @(GraphW) @(GraphH + 14)" preserveAspectRatio="none">
                        @for (var b = 0; b < pg.Curve.Length; b++)
                        {
                            <rect x="@X(b, pg.Curve.Length)" y="@(GraphH + 4)" width="@(Fmt(GraphW / (double)pg.Curve.Length + 0.3))" height="8" fill="@RetentionHeatmapPredictorEngine.HeatColorOf(pg.Curve[b])" />
                        }
                        @foreach (var z in pg.Zones)
                        {
                            <g>
                                <rect x="@(Fmt(z.Start / pg.TotalSeconds * GraphW))" y="0" width="@(Fmt((z.End - z.Start) / pg.TotalSeconds * GraphW))" height="@GraphH" fill="rgba(239,68,68,.16)" />
                                <text x="@(Fmt(z.Start / pg.TotalSeconds * GraphW + 2))" y="10" class="vds-zt">@(Fmt(z.Speed))x</text>
                            </g>
                        }
                        <polyline points="@Points(pg.Curve, pg.Curve.Length)" fill="none" stroke="#94a3b8" stroke-width="1.2" stroke-dasharray="3 2" />
                        <polyline points="@Points(pg.RampedCurve, pg.Curve.Length)" fill="none" stroke="#22d3ee" stroke-width="1.6" />
                    </svg>
                    <div class="vds-legend"><span class="l0">┄ 원본</span><span class="l1">━ 램핑 후</span><span class="l2">■ 이탈 위험(자동 1.2~1.5x · 펀치-인)</span></div>
                }
            </div>

            @* ── 실행 ── *@
            <div class="vds-act">
                <button class="vds-btn go" disabled="@(Busy || Disabled || !HasFinal || !Hooks.IsAvailable)" @onclick="GenerateAsync"
                        title="@(HasFinal ? "최종 영상의 첫 3초에 선택한 후킹 변주를 렌더합니다." : "먼저 최종 영상을 내보내세요.")">🎬 1-Click A/B/C 일괄 생성</button>
                <button class="vds-btn" disabled="@(Busy || Disabled || !HasFinal || _pred is not { Zones.Length: > 0 } || !Retention.IsAvailable)" @onclick="RampAsync">⚡ 이탈 구간 스피드 램핑</button>
                @if (_packager is not null)
                {
                    <button class="vds-btn" disabled="@(Busy || _batch is not { Ok: true })" @onclick="PackageAsync">🧪 A/B 패키징</button>
                }
                @if (Busy) { <button class="vds-btn stop" @onclick="Cancel">⏹ 취소</button> }
            </div>
            @if (_stage is not null) { <div class="vds-prog"><div class="vds-bar" style="width:@(_pct)%"></div><span>@(_stage) @(_pct)%</span></div> }
            @if (_batch is { } bt)
            {
                <div class="vds-items">
                    @foreach (var it in bt.Items)
                    {
                        <span class="vds-item @(it.Ok ? "ok" : "bad")" title="@(it.VideoPath ?? it.Message)">@(ViralHookVariantGeneratorService.SpecOf(it.Style).Letter) @(it.Ok ? "✓" : "✗ " + it.Message)</span>
                    }
                </div>
            }

            @* ── A/B 실험 게시(데스크톱 전용 · 소셜 브릿지) ── *@
            @if (_packager is not null && _pkg is { } pk)
            {
                <div class="vds-sec">
                    <div class="vds-lbl">🚀 A/B 실험 게시 <span class="vds-sub">실험 @(pk.ExperimentId.ToString("N")[..8]) · 변주 @(pk.Variants.Count)개 · @(Path.GetFileName(pk.Root))</span></div>
                    <div class="vds-targets">
                        @foreach (var t in Targets)
                        {
                            var tt = t;
                            <label class="vds-pick @(_packager.IsEnabled(tt) ? null : "dis")">
                                <input type="checkbox" checked="@_targets.Contains(tt)" disabled="@(Busy || !_packager.IsEnabled(tt))"
                                       @onchange="e => ToggleTarget(tt, e.Value is true)" /> @DirectSocialPublisherBridge.LabelOf(tt)
                            </label>
                        }
                        <label class="vds-pick"><input type="checkbox" @bind="_public" disabled="@Busy" /> 공개 게시 동의</label>
                    </div>
                    <button class="vds-btn go" disabled="@(Busy || _targets.Count == 0)" @onclick="PublishAsync">🚀 1-Click A/B 실험 게시 (@(pk.Variants.Count * _targets.Count)건)</button>
                    @if (_outcomes is { Count: > 0 })
                    {
                        <div class="vds-items">
                            @foreach (var o in _outcomes)
                            {
                                <span class="vds-item @(o.Result.Ok ? "ok" : "bad")" title="@(o.Result.Url ?? o.Result.Message)">@(o.Letter)·@(DirectSocialPublisherBridge.LabelOf(o.Result.Target)) @(o.Result.Ok ? "✓" : "✗")</span>
                            }
                        </div>
                    }
                </div>
            }
            @if (_msg is not null) { <div class="vds-msg">@_msg</div> }
        </div>
    }
</div>

<style>
    .vds { border: 1px solid color-mix(in srgb, #f43f5e 30%, var(--line)); border-radius: 12px; background: linear-gradient(160deg, color-mix(in srgb, #f43f5e 7%, var(--card)), var(--card)); margin: 2px 0 6px; overflow: hidden; }
    .vds-h { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 8px 11px; cursor: pointer; flex-wrap: wrap; }
    .vds-tag { font: 800 11.5px Pretendard,'Malgun Gothic',sans-serif; color: #fda4af; }
    .vds-st { font: 600 10px var(--mono); color: var(--text-muted); }
    .vds-warn { color: #f87171; }
    .vds-chev { margin-left: 6px; }
    .vds-body { padding: 4px 11px 10px; border-top: 1px solid color-mix(in srgb, #f43f5e 18%, var(--line)); display: grid; gap: 8px; }
    .vds-sec { display: grid; gap: 5px; }
    .vds-lbl { font: 700 11px Pretendard,'Malgun Gothic',sans-serif; color: var(--text); }
    .vds-sub { font: 500 10px Pretendard,'Malgun Gothic',sans-serif; color: var(--text-muted); }
    .vds-presets { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
    .vds-preset { border: 1px solid var(--line); border-radius: 9px; padding: 6px; display: grid; gap: 3px; opacity: .65; }
    .vds-preset.on { opacity: 1; border-color: color-mix(in srgb, #f43f5e 55%, var(--line)); }
    .vds-preset.rec { box-shadow: 0 0 0 1px #fbbf24 inset; }
    .vds-pick { font: 600 10.5px Pretendard,'Malgun Gothic',sans-serif; display: inline-flex; align-items: center; gap: 4px; }
    .vds-pick.dis { opacity: .45; }
    .vds-copy { width: 100%; resize: vertical; font: 500 10.5px Pretendard,'Malgun Gothic',sans-serif; background: var(--bg); color: var(--text); border: 1px solid var(--line); border-radius: 6px; padding: 3px 5px; }
    .vds-graph { width: 100%; height: 96px; background: #05070c; border-radius: 8px; }
    .vds-zt { font: 700 8px var(--mono); fill: #fca5a5; }
    .vds-legend { display: flex; gap: 10px; font: 600 9.5px var(--mono); color: var(--text-muted); flex-wrap: wrap; }
    .vds-legend .l1 { color: #22d3ee; } .vds-legend .l2 { color: #f87171; }
    .vds-act, .vds-targets, .vds-items { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
    .vds-btn { font: 700 11px Pretendard,'Malgun Gothic',sans-serif; border: 1px solid var(--line); background: var(--card); color: var(--text); border-radius: 8px; padding: 5px 10px; cursor: pointer; }
    .vds-btn.go { background: linear-gradient(135deg,#f43f5e,#f59e0b); color: #fff; border: 0; }
    .vds-btn.stop { color: #f87171; }
    .vds-btn:disabled { opacity: .45; cursor: not-allowed; }
    .vds-prog { position: relative; height: 16px; border-radius: 8px; background: var(--bg); overflow: hidden; }
    .vds-bar { position: absolute; inset: 0 auto 0 0; background: linear-gradient(90deg,#f43f5e,#f59e0b); transition: width .2s; }
    .vds-prog span { position: relative; font: 700 9.5px var(--mono); padding-left: 6px; line-height: 16px; }
    .vds-item { font: 600 10px var(--mono); padding: 2px 6px; border-radius: 6px; border: 1px solid var(--line); }
    .vds-item.ok { color: #4ade80; } .vds-item.bad { color: #f87171; }
    .vds-msg { font: 600 10.5px Pretendard,'Malgun Gothic',sans-serif; color: var(--text-muted); }
    @@media (max-width: 720px) { .vds-presets { grid-template-columns: 1fr; } }
</style>

@code {
    [Parameter, EditorRequired] public StoryboardProject Project { get; set; } = default!;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private const double GraphW = 300;
    private const double GraphH = 80;
    private static readonly SocialPublishTarget[] Targets = { SocialPublishTarget.YouTubeShorts, SocialPublishTarget.TikTok, SocialPublishTarget.InstagramReels };

    private MultiVariantPublishPackager? _packager;   // 데스크톱 전용(모바일 미등록 → 패키징/게시 숨김 · @inject 대신 선택적 해석)
    private readonly bool[] _selected = { true, true, true };
    private readonly string[] _copies = { "", "", "" };
    private readonly List<SocialPublishTarget> _targets = new(3);
    private HookOpeningAnalysis _opening;
    private RetentionPrediction? _pred;
    private ViralHookBatchResult? _batch;
    private AbExperimentPackage? _pkg;
    private IReadOnlyList<AbPublishOutcome>? _outcomes;
    private CancellationTokenSource? _cts;
    private string? _stage;
    private string? _msg;
    private string _topic = "";
    private int _pct;
    private int _signature;
    private bool _open = true;
    private bool _public;

    private bool Busy => _cts is not null;
    private bool HasFinal => !string.IsNullOrWhiteSpace(Project.FinalVideoPath) && File.Exists(Project.FinalVideoPath);

    protected override void OnInitialized()
    {
        _packager = Services.GetService(typeof(MultiVariantPublishPackager)) as MultiVariantPublishPackager;
        Hooks.OnChange += OnServiceChanged;
        Retention.OnChange += OnServiceChanged;
        if (_packager is not null) _packager.OnChange += OnServiceChanged;
    }

    protected override void OnParametersSet()
    {
        // 컷 구성(프롬프트/나레이션)이 바뀐 경우에만 재분석 — 렌더마다 재계산 0
        var sig = Signature(Project);
        if (sig == _signature && _pred is not null) return;
        _signature = sig;
        _opening = Hooks.AnalyzeOpening(Project);
        _pred = Retention.Analyze(Project, _opening.Score / 100.0);
        var topic = ViralHookVariantGeneratorService.TopicOf(Project);
        for (var i = 0; i < _copies.Length; i++)
            if (string.IsNullOrWhiteSpace(_copies[i]) || topic != _topic)
                _copies[i] = ViralHookVariantGeneratorService.BuildCopy(ViralHookVariantGeneratorService.Specs[i].Style, topic);
        _topic = topic;
    }

    private static int Signature(StoryboardProject p)
    {
        var h = new HashCode();
        h.Add(p.Title);
        h.Add(p.CoverTitle);
        foreach (var s in p.Scenes) { h.Add(s.Prompt); h.Add(s.VoiceText); }
        return h.ToHashCode();
    }

    private async Task GenerateAsync()
    {
        var styles = new List<ViralHookStyle>(3);
        var copies = new Dictionary<ViralHookStyle, string>(3);
        for (var i = 0; i < _selected.Length; i++)
        {
            if (!_selected[i]) continue;
            var st = ViralHookVariantGeneratorService.Specs[i].Style;
            styles.Add(st);
            copies[st] = _copies[i];
        }
        if (styles.Count == 0) { _msg = "⚠ 후킹 스타일을 1개 이상 선택하세요."; return; }
        await RunAsync(async ct =>
        {
            _batch = await Hooks.RenderVariantsAsync(Project.FinalVideoPath!, _topic, styles, copies, null, _pred?.TotalSeconds ?? 0, Progress(), ct);
            _pkg = null;
            _outcomes = null;
            _msg = (_batch.Ok ? "✅ " : "⚠ ") + _batch.Message + (_batch.OutputDir is null ? "" : " · " + _batch.OutputDir);
        });
    }

    private async Task RampAsync()
    {
        if (_pred is null) return;
        var src = Project.FinalVideoPath!;
        var output = Path.Combine(Path.GetDirectoryName(Path.GetFullPath(src))!, Path.GetFileNameWithoutExtension(src) + "_ramped.mp4");
        var pred = _pred;
        await RunAsync(async ct =>
        {
            _stage = "⚡ 스피드 램핑·펀치-인 렌더 중…";
            var prog = new Progress<double>(v => { _pct = (int)Math.Round(Math.Clamp(v, 0, 1) * 100); _ = InvokeAsync(StateHasChanged); });
            var r = await Retention.ApplySpeedRampAsync(src, output, pred, progress: prog, ct: ct);
            if (r.Ok && r.OutputPath is not null)
            {
                Project.FinalVideoPath = r.OutputPath;   // 후킹 변주는 램핑본 기준(원본 파일은 보존)
                await OnChanged.InvokeAsync();
            }
            _msg = (r.Ok ? "✅ " : "⚠ ") + r.Message + (r.OutputPath is null ? "" : " · " + Path.GetFileName(r.OutputPath));
        });
    }

    private async Task PackageAsync()
    {
        if (_packager is null || _batch is null) return;
        var items = _batch.Items;
        await RunAsync(async ct =>
        {
            _stage = "🧪 변주별 제목·썸네일·해시태그 패키징 중…";
            _pkg = await _packager.PackageAsync(Project, items, ct: ct);
            _outcomes = null;
            _msg = _packager.LastAction;
            if (_pkg is not null && _targets.Count == 0)
                foreach (var t in Targets) if (_packager.IsEnabled(t)) _targets.Add(t);
        });
    }

    private async Task PublishAsync()
    {
        if (_packager is null || _pkg is null) return;
        var pkg = _pkg;
        var targets = _targets.ToArray();
        var pub = _public;
        await RunAsync(async ct =>
        {
            _stage = "🚀 A/B 변주 게시 중…";
            _outcomes = await _packager.PublishAsync(pkg, targets, pub, ct);
            _msg = _packager.LastAction;
        });
    }

    private async Task RunAsync(Func<CancellationToken, Task> work)
    {
        var cts = new CancellationTokenSource();
        if (Interlocked.CompareExchange(ref _cts, cts, null) is not null) { cts.Dispose(); return; }
        _pct = 0;
        _msg = null;
        try { await work(cts.Token); }
        catch (OperationCanceledException) { _msg = "⚠ 취소됨"; }
        catch (Exception ex) { Program.Log("ViralDirector.Run", ex); _msg = "⚠ 실패: " + ex.Message; }
        finally
        {
            Interlocked.CompareExchange(ref _cts, null, cts);
            cts.Dispose();
            _stage = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Cancel()
    {
        try { _cts?.Cancel(); } catch (ObjectDisposedException) { }
    }

    private IProgress<PostProductionProgress> Progress() => new Progress<PostProductionProgress>(p =>
    {
        _pct = p.Percent;
        _stage = p.Stage;
        _ = InvokeAsync(StateHasChanged);
    });

    private void ToggleTarget(SocialPublishTarget t, bool on)
    {
        if (on) { if (!_targets.Contains(t)) _targets.Add(t); }
        else _targets.Remove(t);
    }

    private void OnServiceChanged() => _ = InvokeAsync(StateHasChanged);

    private static string Points(float[] curve, int span)
    {
        var sb = new StringBuilder(curve.Length * 12);
        var n = Math.Max(2, span);
        for (var i = 0; i < curve.Length && i < n; i++)
        {
            if (i > 0) sb.Append(' ');
            sb.Append(Fmt(i * GraphW / (n - 1))).Append(',').Append(Fmt((1 - curve[i]) * GraphH));
        }
        return sb.ToString();
    }

    private static string X(int i, int n) => Fmt(i * GraphW / n);
    private static string Fmt(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
    private static string Pct(double v) => (v * 100).ToString("0", CultureInfo.InvariantCulture);
    private static string Sec(double v) => v.ToString("0.#", CultureInfo.InvariantCulture);

    public void Dispose()
    {
        Hooks.OnChange -= OnServiceChanged;
        Retention.OnChange -= OnServiceChanged;
        if (_packager is not null) _packager.OnChange -= OnServiceChanged;
        Cancel();   // 진행 중 작업은 RunAsync finally 에서 CTS 정리
    }
}
