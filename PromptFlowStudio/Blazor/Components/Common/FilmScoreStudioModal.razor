@using System.Globalization
@using PromptFlowStudio.Services.FilmScore
@implements IDisposable
@inject FilmScoreStudioRunner Runner

@*
    [PromptFlow Studio v16.86.0] 🎼 AI 제너레이티브 영화 음악 & 사운드 디자인 스튜디오 — 감정 패드(정서가 × 각성) · 긴장 · 컷/스팅어 ·
    악기군 멀티트랙(페이더 · 레벨 · 대역 스펙트럼) · 폴리 동기화 인디케이터(이벤트 레인 · 동기 오차) · LUFS 라우드니스 미터(M/S/I · TP · 정규화/리미터/더킹) · 7.1.4 채널 · 미리듣기.
*@

<div class="fss-scrim" @onclick="Close">
    <div class="fss-modal" @onclick:stopPropagation="true">
        <div class="fss-h">
            <div>
                <div class="fss-title">🎼 AI 제너레이티브 영화 음악 &amp; 사운드 디자인 스튜디오</div>
                <div class="fss-sub">서사 <b>감정선 · 컷 템포</b>에 반응해 오케스트라 BGM을 실시간 편곡하고, 발걸음 · 의상 마찰 · VFX 충돌/폭발 <b>폴리</b>를 샘플 정확 동기로 합성하며,
                    <b>EBU R128 / ATSC A/85</b> 라우드니스 · 트루 피크 · 대사 더킹 · 7.1.4 채널 할당을 가드합니다.</div>
            </div>
            <button class="fss-x" @onclick="Close">✕</button>
        </div>

        <div class="fss-bar">
            <button class="fss-btn @(Runner.IsRunning ? "on" : null)" @onclick="ToggleRun">@(Runner.IsRunning ? "⏸ 정지" : "▶ 재생")</button>
            <button class="fss-btn" @onclick="Step" disabled="@Runner.IsRunning">⏭ 1초</button>
            <button class="fss-btn" @onclick="Runner.NewShot">🎬 새 샷</button>
            <button class="fss-btn @(Runner.AutoNarrative ? "on" : null)" @onclick="() => Runner.AutoNarrative = !Runner.AutoNarrative">📖 서사 아크 @(Runner.AutoNarrative ? FilmScoreStudioRunner.SegmentName(Runner.Segment) : "수동")</button>
            <button class="fss-btn" @onclick="() => Runner.Cut(false)">✂ 컷</button>
            <button class="fss-btn" @onclick="() => Runner.Cut(true)">✂ 하드 컷</button>
            <button class="fss-btn" @onclick="() => Runner.Explode(40f)">💥 폭발</button>
            <button class="fss-btn @(G.Dialogue.Active ? "on" : null)" @onclick="() => G.Dialogue.Active = !G.Dialogue.Active">🗣 대사</button>
            <span class="fss-chip @(Runner.LastTickMs < 16.6 ? "ok" : "warn")">블록 @(F1(Runner.LastTickMs)) ms</span>
            <span class="fss-chip">BGM @(F2(S.LastRenderMs)) · 폴리 @(F2(Runner.Foley.LastRenderMs)) · 마스터 @(F2(G.LastProcessMs)) ms</span>
            <span class="fss-chip">t @(F1(Runner.SceneTime)) s</span>
        </div>

        <div class="fss-main">
            <div class="fss-col">
                <div class="fss-card">
                    <div class="fss-sec">🎻 스코어 — @(NeuralCinematographicFilmScoreGenerator.NoteName(S.KeyRoot)) @(NeuralCinematographicFilmScoreGenerator.ModeName(S.Mode)) · 화음 @(S.ChordName) · @(F0(S.Bpm)) BPM · 마디 @(S.Bar + 1)</div>
                    <div class="fss-split">
                        <svg class="fss-pad" viewBox="0 0 160 160" @onclick="OnPad">
                            <rect x="0" y="0" width="160" height="160" class="bg" />
                            <line x1="80" y1="0" x2="80" y2="160" class="ax" /><line x1="0" y1="80" x2="160" y2="80" class="ax" />
                            <g><text x="4" y="12" class="lb">긴박·부정</text></g><g><text x="104" y="12" class="lb">고양·긍정</text></g>
                            <g><text x="4" y="154" class="lb">침잠</text></g><g><text x="122" y="154" class="lb">평온</text></g>
                            <circle cx="@(F1(80 + S.Valence * 76))" cy="@(F1(156 - S.Arousal * 152))" r="6" class="dot" />
                        </svg>
                        <div class="fss-kv col">
                            <span>정서가 <b>@(F2(S.Valence))</b> · 각성 <b>@(F2(S.Arousal))</b> · 긴장 <b>@(F2(S.Tension))</b></span>
                            <label class="fss-lab">긴장 <input type="range" min="0" max="100" value="@(F0(S.Tension * 100))" @onchange="e => SetF(e, v => Runner.SetCue(S.Valence, S.Arousal, v / 100f))" /></label>
                            <span>레이어 <b>@(S.LayerStrings ? "현 " : "")@(S.LayerWoodwinds ? "목관 " : "")@(S.LayerBrass ? "금관 " : "")@(S.LayerPercussion ? "타악 " : "")@(S.LayerOstinato ? "오스티나토" : "")</b></span>
                            <span>보이스 <b>@(S.ActiveVoices)</b> / @(NeuralCinematographicFilmScoreGenerator.MaxVoices) · 노트 @(S.NotesOn) · 스틸 @(S.VoiceSteals)</span>
                            <span>스팅어 <b>@(S.Stingers)</b> · 컷 지연 @(F0(S.LastCutLatencyMs)) ms · 컷 @(Runner.Cuts)</span>
                            <span>화음 @foreach (var m in S.ChordNotes) { <b>@(NeuralCinematographicFilmScoreGenerator.NoteName(m))@((m / 12) - 1) </b> }</span>
                        </div>
                    </div>
                </div>

                <div class="fss-card">
                    <div class="fss-sec">🎚 악기군 멀티트랙 — 페이더 · 레벨 · 대역 스펙트럼(63 Hz ~ 16 kHz)</div>
                    <div class="fss-tracks">
                        @for (var s = 0; s < HarmonicMixingAndAudioMasteringGuard.StemCount; s++)
                        {
                            var stem = (Stem)s; var db = G.StemDb(stem);
                            <div class="fss-trk">
                                <span class="nm" style="color:@(StemColor(s))">@(StemName(s))</span>
                                <input type="range" min="0" max="200" value="@(F0(G.StemFader[s] * 100))" @onchange="e => SetFader(stem, e)" />
                                <div class="mt"><i style="width:@(Pct(db, -60f, 0f));background:@(StemColor(s))"></i></div>
                                <span class="db">@(db < -99f ? "−∞" : F0(db))</span>
                                <svg class="sp" viewBox="0 0 @(HarmonicMixingAndAudioMasteringGuard.Bands * 6) 20" preserveAspectRatio="none">
                                    @for (var b = 0; b < HarmonicMixingAndAudioMasteringGuard.Bands; b++)
                                    {
                                        var h = Math.Clamp((G.Spectrum(stem, b) + 80f) / 80f, 0f, 1f) * 20f;
                                        <rect x="@(b * 6)" y="@(F1(20 - h))" width="5" height="@(F1(h))" style="fill:@(StemColor(s))" />
                                    }
                                </svg>
                            </div>
                        }
                    </div>
                </div>

                <div class="fss-card">
                    <div class="fss-sec">✨ 프롬프트 — 감정 · 원단 · 규격 · 폭발</div>
                    <div class="fss-row">
                        <input class="fss-in" @bind="_prompt" placeholder="예: 비극적인 슬픔, 가죽 코트, ATSC / triumph chase EBU explosion" />
                        <button class="fss-btn on" @onclick="() => Runner.TriggerPrompt(_prompt)">적용</button>
                        <button class="fss-btn" @onclick="Preview">🔊 4초 미리듣기</button>
                    </div>
                    @if (_wav is not null)
                    {
                        <audio controls src="@_wav" class="fss-au"></audio>
                    }
                </div>
            </div>

            <div class="fss-col">
                <div class="fss-card">
                    <div class="fss-sec">📏 라우드니스 — @(G.Standard == LoudnessStandard.EbuR128 ? "EBU R128" : "ATSC A/85") 목표 @(F0(G.TargetLufs)) LUFS · 상한 @(F0(G.CeilingDbtp)) dBTP
                        <span class="fss-badge @(G.Compliant ? "ok" : "warn")">@(G.Compliant ? "✔ 준수" : "… 측정 중/미준수")</span></div>
                    <div class="fss-row">
                        <button class="fss-btn @(G.Standard == LoudnessStandard.EbuR128 ? "on" : null)" @onclick="() => { G.Standard = LoudnessStandard.EbuR128; G.ResetMeters(); }">EBU R128</button>
                        <button class="fss-btn @(G.Standard == LoudnessStandard.AtscA85 ? "on" : null)" @onclick="() => { G.Standard = LoudnessStandard.AtscA85; G.ResetMeters(); }">ATSC A/85</button>
                        <button class="fss-btn @(G.Normalize ? "on" : null)" @onclick="() => G.Normalize = !G.Normalize">정규화</button>
                        <button class="fss-btn @(G.Limiter ? "on" : null)" @onclick="() => G.Limiter = !G.Limiter">TP 리미터</button>
                        <button class="fss-btn @(G.Ducking ? "on" : null)" @onclick="() => G.Ducking = !G.Ducking">대사 더킹</button>
                        <button class="fss-btn" @onclick="G.ResetMeters">↺ 미터 리셋</button>
                    </div>
                    <div class="fss-lufs">
                        @Meter("M", G.Post.Momentary)
                        @Meter("S", G.Post.ShortTerm)
                        @Meter("I", G.Post.Integrated)
                        @Meter("프리 S", G.Pre.ShortTerm)
                    </div>
                    <div class="fss-kv">
                        <span>트루 피크 <b>@(F1(G.BlockTruePeakDbtp))</b> · 최대 <b>@(F1(G.MaxTruePeakDbtp)) dBTP</b></span>
                        <span>정규화 <b>@(F1(G.NormGainDb)) dB</b></span>
                        <span>리미터 GR <b>@(F1(G.LimiterGrDb)) dB</b></span>
                        <span>더킹 GR <b>@(F1(G.DuckGrDb)) dB</b> · 음성 대역 SNR <b>@(F1(G.DialogueSnrDb)) dB</b></span>
                        <span>게이트 블록 @(G.Post.GatedBlocks)</span>
                    </div>
                    <div class="fss-sl">
                        <label>더킹 깊이 <b>@(F0(G.DuckDepthDb)) dB</b><input type="range" min="0" max="20" value="@(F0(G.DuckDepthDb))" @onchange="e => SetF(e, v => G.DuckDepthDb = v)" /></label>
                        <label>음성 대역 딥 <b>@(F0(G.SpeechDipDb)) dB</b><input type="range" min="0" max="12" value="@(F0(G.SpeechDipDb))" @onchange="e => SetF(e, v => G.SpeechDipDb = v)" /></label>
                    </div>
                </div>

                <div class="fss-card">
                    <div class="fss-sec">🔊 7.1.4 채널 할당(v16.76) — C = 대사 전용 · LFE ≤ 120 Hz</div>
                    <div class="fss-chs">
                        @for (var c = 0; c < HarmonicMixingAndAudioMasteringGuard.Ch; c++)
                        {
                            var db = G.ChannelDb(c);
                            <div class="ch"><div class="bar"><i style="height:@(Pct(db, -70f, -6f))"></i></div><span>@(PromptFlowStudio.Services.SpatialAudio.NeuralBinauralHrtfSpatializer.BedNames[c])</span></div>
                        }
                    </div>
                    <div class="fss-kv">
                        <button class="fss-btn @(G.Binaural ? "on" : null)" @onclick="() => G.Binaural = !G.Binaural">🎧 HRTF 바이노럴 미리듣기</button>
                        <span>LFE 고역 누출 <b>@(F1(G.LfeHighBandRatio * 100))%</b></span>
                    </div>
                </div>

                <div class="fss-card">
                    <div class="fss-sec">👣 폴리 동기화 — @(AutonomousNeuralFoleySfxSynthesizer.SurfaceName(Runner.CurrentSurface)) 위 @(F1(Runner.WalkSpeed)) m/s · 발걸음 @(Runner.Footsteps) · 폭발 @(Runner.Explosions)</div>
                    <svg class="fss-lane" viewBox="0 0 400 60" preserveAspectRatio="none">
                        <line x1="380" y1="0" x2="380" y2="60" class="now" />
                        @for (var k = 0; k < Runner.Foley.LogCount; k++)
                        {
                            var ev = Runner.Foley.LogEvent(k);
                            var x = 380f - (float)(Runner.Foley.BlockTime - ev.Time) * 90f;
                            if (x < 0f) continue;
                            var y = ev.Kind == FoleyKind.Footstep ? 18f : ev.Kind == FoleyKind.Explosion ? 42f : 30f;
                            <circle cx="@(F1(x))" cy="@(F1(y))" r="@(F1(2.5f + 3f * ev.Energy))" style="fill:@(KindColor(ev.Kind))" />
                        }
                    </svg>
                    <div class="fss-kv">
                        <span><i class="lg" style="background:#34d399"></i>발걸음</span><span><i class="lg" style="background:#60a5fa"></i>충돌/스플래시</span><span><i class="lg" style="background:#f97316"></i>폭발</span>
                        <span>동기 오차 평균 <b>@(F3(Runner.Foley.MeanSyncErrorMs))</b> · 최대 <b>@(F3(Runner.Foley.MaxSyncErrorMs)) ms</b></span>
                        <span>지연 이벤트 @(Runner.Foley.LateEvents) · 대기 @(Runner.Foley.Pending) · 보이스 @(Runner.Foley.ActiveVoices)</span>
                        <span>의상 마찰 <b>@(Runner.Foley.Fabric)</b> @(F3(Runner.Foley.RustleLevel))</span>
                        <button class="fss-btn @(Runner.Foley.PropagationDelay ? "on" : null)" @onclick="() => Runner.Foley.PropagationDelay = !Runner.Foley.PropagationDelay">음속 지연</button>
                        <button class="fss-btn @(Runner.Running ? "on" : null)" @onclick="() => Runner.Running = !Runner.Running">🚶 보행</button>
                    </div>
                </div>
                <div class="fss-note">@(Runner.LastAction ?? "대기")</div>
            </div>
        </div>
    </div>
</div>

<style>
    .fss-scrim { position: fixed; inset: 0; z-index: var(--z-studio-modal); background: rgba(0,0,0,.62); display: flex; align-items: center; justify-content: center; padding: 20px; }
    .fss-modal { width: min(1600px, 97vw); max-height: 94vh; display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--line); border-radius: 18px; box-shadow: 0 24px 60px rgba(0,0,0,.45); overflow: hidden; }
    .fss-h { display: flex; justify-content: space-between; gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--line); background: linear-gradient(120deg, color-mix(in srgb, #a855f7 18%, var(--card)), color-mix(in srgb, #f59e0b 14%, var(--card))); }
    .fss-title { font-size: 17px; font-weight: 900; color: var(--text-primary); }
    .fss-sub { font-size: 12px; color: var(--text-secondary); margin-top: 4px; line-height: 1.5; } .fss-sub b { color: var(--text-primary); }
    .fss-x { background: none; border: none; color: var(--text-muted); font-size: 18px; cursor: pointer; border-radius: 8px; }
    .fss-bar { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 20px; border-bottom: 1px solid var(--line); align-items: center; }
    .fss-btn { font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 8px; border: 1px solid var(--line); background: transparent; color: var(--text-primary); cursor: pointer; }
    .fss-btn:disabled { opacity: .4; cursor: default; } .fss-btn.on { background: color-mix(in srgb, #a855f7 26%, transparent); border-color: #c084fc; }
    .fss-chip { font: 700 11px var(--mono); padding: 4px 9px; border-radius: 999px; border: 1px solid var(--line); color: var(--text-secondary); }
    .fss-chip.ok { border-color: #22c55e; color: #86efac; } .fss-chip.warn { border-color: #f97316; color: #fdba74; }
    .fss-badge { font: 800 11px var(--mono); padding: 2px 8px; border-radius: 999px; } .fss-badge.ok { background: #14532d; color: #86efac; } .fss-badge.warn { background: #431407; color: #fdba74; }
    .fss-main { display: grid; grid-template-columns: 1.1fr 1fr; gap: 14px; padding: 14px 20px; min-height: 0; flex: 1; overflow-y: auto; }
    .fss-col { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
    .fss-card { border: 1px solid var(--line); border-radius: 12px; padding: 12px; display: flex; flex-direction: column; gap: 8px; }
    .fss-sec { font-weight: 800; font-size: 13px; color: var(--text-primary); display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .fss-split { display: grid; grid-template-columns: 170px 1fr; gap: 12px; align-items: start; }
    .fss-pad { width: 160px; height: 160px; cursor: crosshair; border-radius: 10px; }
    .fss-pad .bg { fill: #0b1020; } .fss-pad .ax { stroke: #334155; stroke-dasharray: 3 3; } .fss-pad .lb { font: 600 8px var(--mono); fill: #64748b; } .fss-pad .dot { fill: #c084fc; stroke: #fff; stroke-width: 1.5; }
    .fss-tracks { display: flex; flex-direction: column; gap: 6px; }
    .fss-trk { display: grid; grid-template-columns: 56px 110px 1fr 34px 90px; gap: 8px; align-items: center; font-size: 11px; }
    .fss-trk .nm { font-weight: 800; } .fss-trk .mt { height: 8px; background: #111827; border-radius: 4px; overflow: hidden; } .fss-trk .mt i { display: block; height: 100%; }
    .fss-trk .db { font-family: var(--mono); color: var(--text-secondary); text-align: right; } .fss-trk .sp { width: 90px; height: 20px; background: #0b1020; border-radius: 3px; }
    .fss-row { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
    .fss-in { flex: 1; min-width: 200px; font-size: 12px; padding: 6px 9px; border-radius: 8px; border: 1px solid var(--line); background: var(--card); color: var(--text-primary); }
    .fss-au { width: 100%; height: 32px; }
    .fss-lab { display: flex; gap: 6px; align-items: center; font-size: 11px; color: var(--text-secondary); }
    .fss-lufs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
    .fss-m { display: flex; flex-direction: column; align-items: center; gap: 3px; font-size: 11px; color: var(--text-secondary); }
    .fss-m .bar { position: relative; width: 26px; height: 120px; background: #0b1020; border-radius: 4px; overflow: hidden; }
    .fss-m .bar i { position: absolute; left: 0; right: 0; bottom: 0; background: linear-gradient(0deg, #22c55e, #eab308 70%, #ef4444); }
    .fss-m .bar .tgt { position: absolute; left: -2px; right: -2px; height: 2px; background: #fff; }
    .fss-m b { font-family: var(--mono); color: var(--text-primary); }
    .fss-sl { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 10px; }
    .fss-sl label { display: flex; flex-direction: column; gap: 3px; font-size: 11px; color: var(--text-secondary); } .fss-sl b { font-family: var(--mono); color: var(--text-primary); }
    .fss-chs { display: grid; grid-template-columns: repeat(12, 1fr); gap: 4px; }
    .fss-chs .ch { display: flex; flex-direction: column; align-items: center; gap: 2px; font: 600 9px var(--mono); color: var(--text-muted); }
    .fss-chs .bar { position: relative; width: 14px; height: 64px; background: #0b1020; border-radius: 3px; overflow: hidden; } .fss-chs .bar i { position: absolute; bottom: 0; left: 0; right: 0; background: #38bdf8; }
    .fss-lane { width: 100%; height: 60px; background: #0b1020; border-radius: 8px; } .fss-lane .now { stroke: #f472b6; stroke-width: 1.5; }
    .lg { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 4px; vertical-align: middle; }
    .fss-kv { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 11px; color: var(--text-secondary); align-items: center; } .fss-kv b { color: var(--text-primary); font-family: var(--mono); }
    .fss-kv.col { flex-direction: column; align-items: flex-start; gap: 4px; }
    .fss-note { font-size: 11px; color: var(--text-muted); }
    @@media (max-width: 1200px) { .fss-main { grid-template-columns: 1fr; } }
</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private string? _prompt, _wav;
    private System.Threading.Timer? _timer;

    private NeuralCinematographicFilmScoreGenerator S => Runner.Score;
    private HarmonicMixingAndAudioMasteringGuard G => Runner.Guard;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("FilmScore.Modal.Timer", ex); }
        }, null, 200, 200);
    }

    private static string F0(double v) => v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => v.ToString("0.00", CultureInfo.InvariantCulture);
    private static string F3(double v) => v.ToString("0.000", CultureInfo.InvariantCulture);
    private static string Pct(float db, float lo, float hi) => F0(Math.Clamp((db - lo) / (hi - lo), 0f, 1f) * 100) + "%";

    private static string StemName(int s) => s switch { 0 => "현", 1 => "금관", 2 => "목관", 3 => "타악", 4 => "앰비언트", 5 => "폴리", _ => "대사" };
    private static string StemColor(int s) => s switch { 0 => "#f472b6", 1 => "#f59e0b", 2 => "#34d399", 3 => "#ef4444", 4 => "#818cf8", 5 => "#60a5fa", _ => "#e5e7eb" };
    private static string KindColor(FoleyKind k) => k switch { FoleyKind.Footstep => "#34d399", FoleyKind.Explosion => "#f97316", _ => "#60a5fa" };

    private RenderFragment Meter(string label, float lufs) => __builder =>
    {
        const float lo = -50f, hi = -5f;
        var tgt = (G.TargetLufs - lo) / (hi - lo) * 100f;
        <div class="fss-m">
            <div class="bar"><i style="height:@(Pct(lufs, lo, hi))"></i><span class="tgt" style="bottom:@(F0(tgt))%"></span></div>
            <b>@(lufs <= -69.9f ? "−∞" : F1(lufs))</b><span>@label</span>
        </div>
    };

    private static bool TryF(ChangeEventArgs e, out float v) => float.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out v);
    private void SetF(ChangeEventArgs e, Action<float> apply) { if (TryF(e, out var v)) apply(v); }

    private void SetFader(Stem s, ChangeEventArgs e)
    {
        if (!TryF(e, out var v)) return;
        G.StemFader[(int)s] = v / 100f;
    }

    /// <summary>감정 패드: X = 정서가(−1..1) · Y = 각성(위 = 1).</summary>
    private void OnPad(MouseEventArgs e)
    {
        var va = Math.Clamp(((float)e.OffsetX - 80f) / 76f, -1f, 1f); var ar = Math.Clamp((156f - (float)e.OffsetY) / 152f, 0f, 1f);
        Runner.SetCue(va, ar, S.Tension);
    }

    private void Preview() => _wav = "data:audio/wav;base64," + Convert.ToBase64String(G.ExportPreviewWav());

    private void Step() { for (var k = 0; k < FilmScoreStudioRunner.Hz; k++) Runner.TickOnce(); }

    private void ToggleRun() { if (Runner.IsRunning) Runner.Stop(); else Runner.Start(); }

    private Task Close() => OnClose.InvokeAsync();

    private void OnServiceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
