@using System.Globalization
@using System.Linq
@using PromptFlowStudio.Services.Mobile
@using PromptFlowStudio.Services.Storyboard
@implements IDisposable
@inject IMotionTiltController Motion
@inject PromptFlowStudio.Shared.Haptics.IHapticEngine Haptic
@inject PromptFlowStudio.Services.Ui.StudioMemoryAudit MemAudit

@* [PromptFlow Studio · v5.3.4] 모바일 스튜디오 덱 — PromptFlow AI 영상/스토리보드 전용(산업용 PLC/서보/Modbus 제거 · 도메인 정화).
   4대 덱: ①AI 프롬프트 퀵 생성기 ②스토리보드 씬 모바일 플레이어 ③Wan 3.0 렌더링 큐 모니터 ④자이로 3D 씬 모션 카메라.
   자이로 센서는 스토리보드 3D 구도 조율에 사용. 소멸 시 IDisposable 로 센서 정지·구독 해제(멱등 · 배터리/릭 방어). *@

<div class="ms-deck">
    <div class="ms-h">
        <span class="ms-title">🎬 PromptFlow 모바일 스튜디오</span><span class="ms-badge">v5.3.4</span>
    </div>

    @* ── ① ✨ AI 프롬프트 퀵 생성기 — 2단계 화면 흐름(테마 선택 → 상세/적용). 테마를 누르면 상세 화면으로 전환된다. ── *@
    <div class="ms-card">
        @if (_picked is null)
        {
            @* 화면 1: 테마 선택 *@
            <div class="ms-screen-anim" @key="@("pick")">
                <div class="ms-ct">✨ AI 프롬프트 퀵 생성기 <span class="ms-sub">테마를 누르면 상세 화면으로 이동</span></div>
                <div class="ms-chips">
                    @foreach (var t in _templates)
                    {
                        <button class="ms-chip" @onclick="() => PickTemplate(t)" @key="t.Key">@t.Emoji @t.Name <span class="ms-chip-go">›</span></button>
                    }
                </div>
            </div>
        }
        else
        {
            @* 화면 2: 선택한 테마 상세 + 적용(다음 화면) *@
            <div class="ms-screen-anim ms-detail" @key="_picked.Key">
                <div class="ms-ct">
                    <button class="ms-back" @onclick="BackToPick" title="테마 목록으로">‹ 뒤로</button>
                    <span>@_picked.Emoji @_picked.Name 테마</span>
                </div>
                <div class="ms-detail-hero">
                    <span class="ms-detail-emoji">@_picked.Emoji</span>
                    <div class="ms-detail-meta"><b>@_picked.Name</b><small>시네마틱 프롬프트 자동 생성 완료</small></div>
                </div>
                <textarea class="ms-prompt" readonly rows="4">@_prompt</textarea>
                <div class="ms-detail-act">
                    <button class="ms-apply" @onclick="ApplyPicked">✅ 이 테마로 적용</button>
                    <button class="ms-mini" @onclick="BackToPick">◀ 다른 테마</button>
                </div>
            </div>
        }
    </div>

    @* ── ② 🎬 스토리보드 씬 모바일 플레이어 ── *@
    <div class="ms-card">
        <div class="ms-ct">🎬 스토리보드 씬 플레이어 <span class="ms-sub">AI 생성 컷 모바일 뷰포트 미리보기</span></div>
        @if (Scenes.Count == 0)
        {
            <div class="ms-empty">아직 생성된 컷이 없습니다 — 스토리보드에서 컷을 만들면 여기서 미리보기됩니다.</div>
        }
        else
        {
            <div class="ms-player">
                <div class="ms-screen">
                    @{ var cur = Scenes[Math.Clamp(_playIndex, 0, Scenes.Count - 1)]; }
                    <div class="ms-screen-idx">컷 @(Math.Clamp(_playIndex, 0, Scenes.Count - 1) + 1)/@Scenes.Count · @StatusIcon(cur.Status)</div>
                    <div class="ms-screen-prompt">@(Snippet(cur.Prompt))</div>
                </div>
                <div class="ms-player-ctl">
                    <button class="ms-mini" @onclick="() => Step(-1)">◀ 이전</button>
                    <button class="ms-mini" @onclick="() => Step(1)">다음 ▶</button>
                </div>
            </div>
        }
    </div>

    @* ── ③ ⚡ Wan 3.0 렌더링 큐 모니터 ── *@
    <div class="ms-card">
        <div class="ms-ct">⚡ Wan 3.0 렌더링 큐 모니터 <span class="ms-sub">모바일 백그라운드 렌더 상태</span></div>
        <div class="ms-q-sum">완료 @Completed / @Scenes.Count · 진행 @Rendering · 대기 @Pending</div>
        <div class="ms-q-bar"><div class="ms-q-fill" style="width:@Fx(Progress)%"></div></div>
        <div class="ms-q-cap">전체 진행률 @Fx(Progress)% @(Scenes.Count == 0 ? "· (큐 비어 있음)" : "")</div>
    </div>

    @* ── ④ 🧭 자이로 3D 씬 모션 카메라 ── *@
    <div class="ms-card">
        <div class="ms-ct">🧭 자이로 3D 씬 모션 카메라 <span class="ms-sub">폰을 기울여 3D 구도 조율</span>
            <button class="ms-mini ms-right" @onclick="ToggleMotion">@(_motionOn ? "■ 중지" : "▶ 시작")</button></div>
        <div class="ms-stage">
            <div class="ms-scene3d" style="--rx:@Fx(_rotX)deg; --ry:@Fx(_rotY)deg">
                <div class="ms-plane bg"></div>
                <div class="ms-plane mid"></div>
                <div class="ms-plane fg"></div>
            </div>
        </div>
        <div class="ms-tiltcap">
            @if (Motion.IsSupported) { <text>구도 X @Fx(_rotX)° · Y @Fx(_rotY)°</text> }
            else { <text>🖥️ 데스크톱: 자이로 미지원 — 모바일에서 폰을 기울이면 3D 구도가 실시간 회전합니다.</text> }
        </div>
    </div>

    @if (_msg is not null) { <div class="ms-msg">@_msg</div> }
</div>

<style>
    .ms-deck{border:1px solid color-mix(in srgb,#7c5cff 34%,var(--line)); border-radius:16px; overflow:hidden;
        background:linear-gradient(160deg, color-mix(in srgb,#7c5cff 10%,rgba(18,20,31,.76)), rgba(18,20,31,.9)); backdrop-filter:blur(16px) saturate(150%); -webkit-backdrop-filter:blur(16px) saturate(150%)}
    .ms-h{display:flex; align-items:center; gap:8px; padding:12px 15px; border-bottom:1px solid color-mix(in srgb,#7c5cff 22%,var(--line))}
    .ms-title{font:900 14px Pretendard,'Malgun Gothic',sans-serif; background:linear-gradient(90deg,#a78bfa,#38bdf8); -webkit-background-clip:text; background-clip:text; color:transparent}
    .ms-badge{font:800 10px var(--mono); color:#fff; background:linear-gradient(135deg,#7c5cff,#0ea5e9); border-radius:20px; padding:2px 8px}
    .ms-card{margin:12px 15px; padding:12px 13px; border-radius:13px; background:var(--card-2); border:1px solid var(--line)}
    .ms-ct{font:800 12.5px Pretendard,'Malgun Gothic',sans-serif; color:var(--text-primary); display:flex; align-items:center; gap:8px; flex-wrap:wrap}
    .ms-sub{font:600 10px var(--mono); color:var(--text-muted)}
    .ms-right{margin-left:auto}
    /* ① 프롬프트 퀵 생성기 — 2단계 화면 */
    .ms-screen-anim{animation:msSlideIn .22s ease both}
    @@keyframes msSlideIn{from{opacity:0; transform:translateX(10px)} to{opacity:1; transform:translateX(0)}}
    .ms-chips{display:flex; flex-wrap:wrap; gap:6px; margin:9px 0}
    .ms-chip{display:inline-flex; align-items:center; gap:5px; font:700 11px Pretendard,'Malgun Gothic',sans-serif; padding:8px 11px; border-radius:20px; border:1px solid var(--line); background:var(--card); color:var(--text-secondary); cursor:pointer; min-height:36px}
    .ms-chip:hover{border-color:#7c5cff; color:var(--text-primary)}
    .ms-chip-go{font:900 12px var(--mono); color:#7c5cff; opacity:.7}
    .ms-prompt{width:100%; box-sizing:border-box; resize:none; background:var(--card); border:1px solid var(--line); border-radius:10px; padding:9px 11px; color:var(--text-primary); font:600 11px var(--mono); line-height:1.5; outline:none; margin-top:9px}
    /* ① 화면2: 상세/적용 */
    .ms-back{font:800 11px Pretendard,'Malgun Gothic',sans-serif; padding:5px 10px; border-radius:8px; border:1px solid var(--line); background:var(--card); color:#a78bfa; cursor:pointer; min-height:32px}
    .ms-back:hover{border-color:#7c5cff; color:var(--text-primary)}
    .ms-detail-hero{display:flex; align-items:center; gap:11px; margin:11px 0 4px; padding:11px; border-radius:11px; background:linear-gradient(135deg,color-mix(in srgb,#7c5cff 16%,transparent),transparent); border:1px solid color-mix(in srgb,#7c5cff 28%,var(--line))}
    .ms-detail-emoji{font-size:30px; line-height:1}
    .ms-detail-meta{display:flex; flex-direction:column; gap:2px}
    .ms-detail-meta b{font:900 14px Pretendard,'Malgun Gothic',sans-serif; color:var(--text-primary)}
    .ms-detail-meta small{font:600 10px var(--mono); color:var(--text-muted)}
    .ms-detail-act{display:flex; gap:8px; margin-top:10px}
    .ms-apply{flex:1; font:800 12px Pretendard,'Malgun Gothic',sans-serif; padding:10px 13px; border-radius:10px; border:none; background:linear-gradient(135deg,#7c5cff,#0ea5e9); color:#fff; cursor:pointer; min-height:40px}
    .ms-apply:hover{filter:brightness(1.08)}
    /* ② 씬 플레이어 */
    .ms-empty{font:600 11px var(--mono); color:var(--text-muted); padding:14px 6px; text-align:center}
    .ms-player{display:flex; flex-direction:column; gap:9px; margin-top:9px}
    .ms-screen{min-height:88px; border-radius:11px; background:linear-gradient(135deg,#0b1020,#161a2e); border:1px solid color-mix(in srgb,#38bdf8 30%,var(--line)); padding:11px}
    .ms-screen-idx{font:800 10px var(--mono); color:#7dd3fc; margin-bottom:6px}
    .ms-screen-prompt{font:600 11.5px Pretendard,'Malgun Gothic',sans-serif; color:var(--text-secondary); line-height:1.5; display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden}
    .ms-player-ctl{display:flex; gap:8px}
    .ms-mini{font:800 11px Pretendard,'Malgun Gothic',sans-serif; padding:8px 13px; border-radius:9px; border:1px solid var(--line); background:var(--card); color:var(--text-secondary); cursor:pointer; min-height:38px}
    .ms-mini:hover{border-color:#7c5cff; color:var(--text-primary)}
    /* ③ 렌더링 큐 모니터 */
    .ms-q-sum{font:700 11px var(--mono); color:var(--text-secondary); margin:8px 0 6px}
    .ms-q-bar{height:9px; border-radius:20px; background:var(--card); border:1px solid var(--line); overflow:hidden}
    .ms-q-fill{height:100%; background:linear-gradient(90deg,#7c5cff,#38bdf8,#34d399); transition:width .35s ease}
    .ms-q-cap{font:700 9.5px var(--mono); color:var(--text-muted); margin-top:5px}
    /* ④ 자이로 3D 씬 */
    .ms-stage{height:150px; display:grid; place-items:center; perspective:640px; margin-top:9px}
    .ms-scene3d{position:relative; width:130px; height:96px; transform-style:preserve-3d; transform:rotateX(var(--rx,-18deg)) rotateY(var(--ry,22deg)); transition:transform .06s linear}
    .ms-plane{position:absolute; inset:0; margin:auto; width:130px; height:82px; border-radius:10px; border:1.5px solid; box-shadow:0 0 14px currentColor}
    .ms-plane.bg{transform:translateZ(-40px); color:#34d399; background:#34d39914}
    .ms-plane.mid{transform:translateZ(0); color:#a78bfa; background:#a78bfa14}
    .ms-plane.fg{transform:translateZ(40px); color:#38bdf8; background:#38bdf814}
    .ms-tiltcap{text-align:center; font:700 10px var(--mono); color:var(--text-muted); margin-top:6px; line-height:1.5; word-break:keep-all}
    .ms-msg{margin:0 15px 14px; padding:9px 12px; border-radius:10px; background:var(--card); border:1px solid color-mix(in srgb,#7c5cff 30%,var(--line)); font:700 11px Pretendard,'Malgun Gothic',sans-serif; color:#c4b5fd; line-height:1.5}
</style>

@code {
    /// <summary>미리보기할 스토리보드 프로젝트(선택) — 씬 플레이어/렌더 큐 모니터의 소스. null 이면 안내 표시.</summary>
    [Parameter] public StoryboardProject? Project { get; set; }

    private sealed record PromptTemplate(string Key, string Emoji, string Name, string Prompt);

    private static readonly PromptTemplate[] _templates =
    {
        new("baby", "👶", "감성 아기", "a joyful baby laughing in soft morning light, cozy nursery, warm pastel tones, shallow depth of field, cinematic, 4k"),
        new("corp", "🏢", "B2B 기업", "sleek corporate headquarters at dusk, slow drone orbit, glass reflections, professional branding, volumetric lighting, cinematic, 4k"),
        new("auto", "🚗", "자동차", "dynamic automotive hero shot, glossy car on wet asphalt, neon reflections, motion blur, dramatic rim light, cinematic, 4k"),
        new("weather", "☁️", "날씨/환경", "atmospheric weather scene, volumetric fog rolling over a valley at dawn, golden light rays, ultra-detailed, cinematic, 4k"),
        new("cine", "🎞️", "시네마틱", "epic cinematic establishing shot, dramatic composition, volumetric lighting, film grain, ultra-detailed, sharp focus, 4k"),
    };

    private string _prompt = "";
    private PromptTemplate? _picked;   // 선택된 테마(=null 이면 화면1 목록, 값 있으면 화면2 상세)
    private double _rotX = -18, _rotY = 22;
    private int _tiltThrottle;
    private bool _motionOn;
    private int _playIndex;
    private string? _msg;
    private long _memToken;
    private bool _disposed;

    private IReadOnlyList<StoryboardScene> Scenes => Project?.Scenes ?? (IReadOnlyList<StoryboardScene>)System.Array.Empty<StoryboardScene>();
    private int Completed => Scenes.Count(s => s.Status == SceneStatus.Completed);
    private int Rendering => Scenes.Count(s => s.Status is SceneStatus.Generating or SceneStatus.Downloading);
    private int Pending => Scenes.Count(s => s.Status == SceneStatus.Pending);
    private double Progress => Scenes.Count == 0 ? 0 : Math.Round(Completed * 100.0 / Scenes.Count, 0);

    protected override void OnInitialized()
    {
        _memToken = MemAudit.Track("MobileSupremacyDeck");
        Motion.OnTilt += OnTilt;
    }

    // ① 테마 선택 → 상세(다음) 화면으로 전환 + 시네마틱 프롬프트 생성
    private void PickTemplate(PromptTemplate t)
    {
        _picked = t;                         // 화면2(상세)로 전환
        _prompt = t.Prompt;
        Haptic.Play(HapticEvent.SimTouch);   // 화면 전환 햅틱 피드백(모바일)
    }

    // ① 상세 화면 → 테마 목록(이전) 화면으로 복귀
    private void BackToPick()
    {
        _picked = null;
        _msg = null;
        Haptic.Play(HapticEvent.SimTouch);
    }

    // ① 선택 테마 적용 — 프로젝트의 빈 컷에 프롬프트 주입(데스크톱 ApplyBabyTheme 와 동일 기조)
    private void ApplyPicked()
    {
        if (_picked is null) return;
        Haptic.Play(HapticEvent.DeploySuccess);   // 적용 성공 햅틱

        var filled = 0;
        if (Project is not null)
            foreach (var s in Project.Scenes)
                if (string.IsNullOrWhiteSpace(s.Prompt)) { s.Prompt = _prompt; filled++; }

        _msg = filled > 0
            ? $"✅ «{_picked.Name}» 테마 적용 — 빈 컷 {filled}개에 프롬프트 주입됨."
            : (Project is null || Project.Scenes.Count == 0
                ? $"✅ «{_picked.Name}» 프롬프트 준비 완료 — 스토리보드에서 컷을 만들면 반영할 수 있습니다."
                : $"✅ «{_picked.Name}» 선택 — 모든 컷에 이미 프롬프트가 있어 기존 값을 유지했습니다.");
    }

    // ② 씬 플레이어 스텝
    private void Step(int delta)
    {
        if (Scenes.Count == 0) return;
        _playIndex = (Math.Clamp(_playIndex, 0, Scenes.Count - 1) + delta + Scenes.Count) % Scenes.Count;
        Haptic.Play(HapticEvent.SimTouch);
    }

    private static string StatusIcon(SceneStatus s) => s switch
    {
        SceneStatus.Completed => "✅ 완료",
        SceneStatus.Generating => "⏳ 생성중",
        SceneStatus.Downloading => "⬇️ 다운로드",
        SceneStatus.Failed => "⚠️ 실패",
        SceneStatus.Canceled => "⏹ 취소",
        _ => "· 대기",
    };

    private static string Snippet(string? p)
    {
        var s = (p ?? "").Trim();
        return s.Length == 0 ? "(프롬프트 없음)" : s.Length > 140 ? s[..140] + "…" : s;
    }

    // ④ 자이로 3D 씬 모션
    private async Task ToggleMotion()
    {
        _motionOn = !_motionOn;
        try
        {
            if (_motionOn) await Motion.StartAsync(60);
            else { await Motion.StopAsync(); _rotX = -18; _rotY = 22; }
        }
        catch (System.Exception ex) { _msg = "센서 오류: " + ex.Message; }
    }

    private void OnTilt(TiltSample s)
    {
        _rotX = -s.Pitch; _rotY = s.Roll;   // 폰 기울기 → 스토리보드 3D 구도 회전
        if (++_tiltThrottle % 3 == 0) _ = SafeRender();   // 60Hz→~20fps throttle(thrashing 방지)
    }

    private Task SafeRender()
    {
        if (_disposed) return Task.CompletedTask;
        return InvokeAsync(StateHasChanged);
    }

    private static string Fx(double v) => (double.IsNaN(v) || double.IsInfinity(v) ? 0 : v).ToString("0.#", CultureInfo.InvariantCulture);

    /// <summary>앱 백그라운드 진입 시(MAUI OnSleep) 센서를 즉시 정지(배터리 방어).</summary>
    public async Task PauseAsync()
    {
        try { await Motion.StopAsync(); } catch { }
        _motionOn = false;
    }

    /// <summary>⏹️ 소멸 즉시 멱등 해제 — 센서 정지 + 구독 해제(배터리 누수·메모리 릭 0).</summary>
    public void Dispose()
    {
        if (_disposed) return;   // 멱등
        _disposed = true;
        Motion.OnTilt -= OnTilt;
        try { _ = Motion.StopAsync(); } catch { }
        MemAudit.Release(_memToken);
    }
}
