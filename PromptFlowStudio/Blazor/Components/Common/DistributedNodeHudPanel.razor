@using System.Globalization
@using PromptFlowStudio.Services.Wan
@using PromptFlowStudio.Services.Mobile
@implements IDisposable

@* [PromptFlow Studio v6.0.1-b] 분산 GPU 노드 그리드 HUD — 등록 워커의 건강/슬롯/EWMA 지연을 실시간 네온 카드로 표출 + 동적 노드 등록/헬스체크.
   ⚠ 무주입(모바일 안전 · 제2헌장): DistributedRenderGrid 는 부모에서 [Parameter] 로 수신. Grid.OnChange 는 15초 자가치유 타이머/스케줄러(백그라운드 스레드)에서 오므로 InvokeAsync(StateHasChanged) 마샬링(제3헌장). *@

<div class="dng">
    <div class="dng-head">
        <span class="dng-title">⚡ 분산 GPU 노드 그리드</span>
        <span class="dng-badge @(Grid?.UsableNodeCount > 0 ? "on" : null)">가용 @(Grid?.UsableNodeCount ?? 0) / @(Grid?.Nodes.Count ?? 0)대</span>
        @if (Grid?.IsRunning == true) { <span class="dng-live">● 분산 렌더 가동 중</span> }
    </div>

    @* ── 진행률 프로그레스 바(분산 렌더 실행 중 · GridProgress 스냅샷) ── *@
    @if (Grid?.IsRunning == true && Grid.LastProgress is { } p)
    {
        <div class="dng-run">
            <div class="dng-run-track"><div class="dng-run-bar" style="width:@(p.Percent.ToString(CultureInfo.InvariantCulture))%"></div></div>
            <span class="dng-run-step">세그먼트 @(p.Completed)/@(p.Total) 완료 · 가동 @(p.Dispatched) · 대기 @(p.Queued) @(p.Failed > 0 ? $"· 실패 {p.Failed}" : "")</span>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Grid?.StatusMessage)) { <div class="dng-status">@Grid!.StatusMessage</div> }

    @* ── 동적 노드 등록 폼(URL + 병렬 슬롯 → 등록 즉시 헬스 프로브) ── *@
    <div class="dng-form">
        <input class="dng-in url" @bind="_newUrl" @bind:event="oninput" placeholder="워커 URL (예: http://192.168.0.10:5000)" inputmode="url" @onkeydown="OnFormKey" />
        <input class="dng-in slot" type="number" min="1" max="16" @bind="_newSlots" title="GPU 동시 슬롯" />
        <button class="dng-add" @onclick="RegisterNode" disabled="@(_registering || string.IsNullOrWhiteSpace(_newUrl))">
            @(_registering ? "확인 중…" : "＋ 노드 등록")
        </button>
    </div>
    @if (_formMsg is not null) { <div class="dng-formmsg @(_formOk ? "ok" : "err")">@_formMsg</div> }

    @* ── 노드 카드 그리드(실시간 · 15초 자가치유 반영) ── *@
    @if (Grid is null || Grid.Nodes.Count == 0)
    {
        <div class="dng-empty">등록된 워커 노드가 없습니다. 위 입력창에 원격 GPU 워커 주소를 등록하세요.<br />분산 그리드가 하트비트로 도달성을 확인하고 대량 양산·세그먼트 큐를 자동 분산합니다.</div>
    }
    else
    {
        <div class="dng-grid">
            @foreach (var n in Grid.Nodes)
            {
                <div class="dng-card @HealthClass(n.Health)" @key="n.Id">
                    <div class="dng-card-top">
                        <span class="dng-dot @HealthClass(n.Health)"></span>
                        <span class="dng-name" title="@n.BaseUrl">@n.Name</span>
                        <span class="dng-hstat">@HealthLabel(n.Health)</span>
                    </div>
                    <div class="dng-url">@n.BaseUrl</div>

                    @* 슬롯 미터(InFlight / Max) *@
                    <div class="dng-slots">
                        <span class="dng-slots-lbl">슬롯 @(n.InFlight)/@(Math.Max(1, n.MaxConcurrency))</span>
                        <div class="dng-slots-track">
                            @for (var i = 0; i < Math.Max(1, n.MaxConcurrency); i++)
                            {
                                <span class="dng-slot @(i < n.InFlight ? "busy" : "free")" @key="i"></span>
                            }
                        </div>
                    </div>

                    <div class="dng-metrics">
                        <span class="dng-metric"><b>@LatencyText(n.AvgLatencyMs)</b><span>EWMA 지연</span></span>
                        <span class="dng-metric"><b class="ok">@n.CompletedCount</b><span>완료</span></span>
                        <span class="dng-metric"><b class="@(n.FailedCount > 0 ? "err" : null)">@n.FailedCount</b><span>실패</span></span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(n.LastError)) { <div class="dng-err">⚠ @n.LastError</div> }
                    <div class="dng-hb">💓 @HeartbeatText(n.LastHeartbeatAt)</div>

                    <div class="dng-card-act">
                        <button class="dng-mini" @onclick="() => ProbeNode(n.Id)" disabled="@(_probingId == n.Id)">@(_probingId == n.Id ? "…" : "🔍 헬스체크")</button>
                        @if (n.Health == WorkerNodeHealth.Offline || n.ConsecutiveFailures > 0)
                        {
                            <button class="dng-mini warn" @onclick="() => Grid!.ResetNode(n.Id)">♻ 격리해제</button>
                        }
                        <button class="dng-mini del" @onclick="() => Grid!.RemoveNode(n.Id)" disabled="@Grid!.IsRunning">✕</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    /// <summary>분산 렌더 그리드(관찰 가능 싱글턴) — 부모(MobileStudioDeck 등)가 [Parameter] 로 주입(모바일 무주입 원칙 준수).</summary>
    [Parameter, EditorRequired] public DistributedRenderGrid Grid { get; set; } = default!;

    private string _newUrl = "";
    private int _newSlots = 1;
    private bool _registering;
    private string? _formMsg;
    private bool _formOk;
    private string? _probingId;

    protected override void OnInitialized()
    {
        if (Grid is not null) Grid.OnChange += OnGridChanged;
    }

    // ⚠ 15초 하트비트/스케줄러는 백그라운드 스레드 → UI 스레드로 마샬링(제3헌장).
    private void OnGridChanged() => InvokeAsync(StateHasChanged);

    private async Task OnFormKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter") await RegisterNode();
    }

    // 등록 즉시 ProbeNodeAsync 로 도달성 검증(제약: task2).
    private async Task RegisterNode()
    {
        var url = (_newUrl ?? "").Trim();
        if (_registering || string.IsNullOrWhiteSpace(url)) return;
        if (!RemoteRenderClient.IsValidWorkerUrl(url))
        {
            _formOk = false; _formMsg = "⚠ 유효한 워커 URL 이 아닙니다 (http/https/ws/wss · 예: http://192.168.0.10:5000).";
            return;
        }

        _registering = true; _formMsg = null;
        try
        {
            var slots = Math.Clamp(_newSlots, 1, 16);
            var name = BuildNodeName(url);
            var node = Grid.RegisterNode(name, url, slots);
            var reachable = await Grid.ProbeNodeAsync(node.Id);
            _formOk = reachable;
            _formMsg = reachable
                ? $"✅ «{name}» 등록 · 도달 확인 — 분산 그리드에 편입되었습니다."
                : $"📴 «{name}» 등록됨 — 현재 미도달(Offline). 하트비트가 복구 시 자동 편입합니다.";
            _newUrl = "";
        }
        catch (Exception ex) { _formOk = false; _formMsg = "⚠ 등록 오류: " + ex.Message; }
        finally { _registering = false; }
    }

    private async Task ProbeNode(string id)
    {
        _probingId = id;
        try { await Grid.ProbeNodeAsync(id); }
        catch { /* Graceful — 프로브 실패는 노드 상태로 반영됨 */ }
        finally { _probingId = null; }
    }

    // ── 표시 유틸(순수 BCL · 로캘 독립) ──
    private static string HealthClass(WorkerNodeHealth h) => h switch
    {
        WorkerNodeHealth.Online => "online",
        WorkerNodeHealth.Degraded => "degraded",
        WorkerNodeHealth.Offline => "offline",
        _ => "unknown",
    };

    private static string HealthLabel(WorkerNodeHealth h) => h switch
    {
        WorkerNodeHealth.Online => "온라인",
        WorkerNodeHealth.Degraded => "불안정",
        WorkerNodeHealth.Offline => "오프라인",
        _ => "탐색 전",
    };

    private static string LatencyText(double ms)
        => ms <= 0 ? "—" : (ms >= 1000 ? (ms / 1000.0).ToString("0.0", CultureInfo.InvariantCulture) + "s"
                                       : ms.ToString("0", CultureInfo.InvariantCulture) + "ms");

    private static string HeartbeatText(DateTimeOffset? at)
    {
        if (at is null) return "대기 중";
        var d = DateTimeOffset.Now - at.Value;
        if (d.TotalSeconds < 5) return "방금";
        if (d.TotalSeconds < 60) return $"{(int)d.TotalSeconds}초 전";
        if (d.TotalMinutes < 60) return $"{(int)d.TotalMinutes}분 전";
        return at.Value.ToString("HH:mm", CultureInfo.InvariantCulture);
    }

    private static string BuildNodeName(string url)
    {
        try { var u = new Uri(url); return $"GPU · {u.Host}:{u.Port}"; }
        catch { return url; }
    }

    public void Dispose()
    {
        if (Grid is not null) Grid.OnChange -= OnGridChanged;
    }
}

<style>
    .dng { display: flex; flex-direction: column; gap: 12px; font-family: Pretendard, 'Malgun Gothic', sans-serif; }
    .dng-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .dng-title { font: 900 14px Pretendard,'Malgun Gothic',sans-serif; background: linear-gradient(90deg,#6ee7b7,#7dd3fc); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .dng-badge { font: 700 10.5px var(--mono); color: var(--text-muted); background: var(--card-2); border: 1px solid var(--line); border-radius: 12px; padding: 3px 10px; }
    .dng-badge.on { color: #6ee7b7; border-color: color-mix(in srgb,#34d399 40%,var(--line)); background: color-mix(in srgb,#34d399 10%,transparent); }
    .dng-live { margin-left: auto; font: 800 10px var(--mono); color: #f5c451; animation: dngPulse 1.1s ease-in-out infinite; }
    @@keyframes dngPulse { 0%,100% { opacity: 1; } 50% { opacity: .4; } }

    /* 진행 바 */
    .dng-run { display: flex; flex-direction: column; gap: 5px; }
    .dng-run-track { height: 7px; border-radius: 6px; background: rgba(255,255,255,.08); overflow: hidden; }
    .dng-run-bar { height: 100%; border-radius: 6px; background: linear-gradient(90deg,#34d399,#0ea5e9); transition: width .25s ease; box-shadow: 0 0 10px color-mix(in srgb,#34d399 50%,transparent); }
    .dng-run-step { font: 700 10.5px var(--mono); color: #7dd3fc; word-break: keep-all; }
    .dng-status { font: 600 11px Pretendard,'Malgun Gothic',sans-serif; color: var(--text-muted); word-break: keep-all; line-height: 1.5; }

    /* 등록 폼 */
    .dng-form { display: flex; gap: 8px; }
    .dng-in { background: var(--card-2); border: 1px solid var(--line); border-radius: 10px; color: var(--text-primary); font: 700 12px var(--mono); padding: 0 12px; min-height: 44px; outline: none; }
    .dng-in:focus { border-color: #34d399; }
    .dng-in.url { flex: 1; min-width: 0; }
    .dng-in.slot { width: 62px; flex: 0 0 auto; text-align: center; }
    .dng-add { flex: 0 0 auto; min-height: 44px; padding: 0 15px; border: none; border-radius: 12px; cursor: pointer; font: 800 12px Pretendard,'Malgun Gothic',sans-serif; color: #04121c; background: linear-gradient(135deg,#34d399,#0ea5e9); white-space: nowrap; }
    .dng-add:disabled { opacity: .5; cursor: not-allowed; }
    .dng-formmsg { font: 700 10.5px Pretendard,'Malgun Gothic',sans-serif; padding: 8px 11px; border-radius: 9px; line-height: 1.5; word-break: keep-all; }
    .dng-formmsg.ok { color: #6ee7b7; background: color-mix(in srgb,#34d399 10%,transparent); border: 1px solid color-mix(in srgb,#34d399 30%,var(--line)); }
    .dng-formmsg.err { color: #fca5a5; background: color-mix(in srgb,#ef4444 10%,transparent); border: 1px solid color-mix(in srgb,#ef4444 34%,var(--line)); }

    .dng-empty { font: 600 11.5px Pretendard,'Malgun Gothic',sans-serif; color: var(--text-muted); padding: 22px 6px; text-align: center; line-height: 1.7; word-break: keep-all;
        border: 1px dashed var(--line); border-radius: 13px; background: rgba(11,13,20,.4); }

    /* 노드 카드 그리드(반응형: 1열 → 2열) */
    .dng-grid { display: grid; grid-template-columns: 1fr; gap: 10px; }
    @@media (min-width: 560px) { .dng-grid { grid-template-columns: 1fr 1fr; } }
    .dng-card { position: relative; display: flex; flex-direction: column; gap: 8px; padding: 12px; border-radius: 14px; border: 1px solid var(--line); background: rgba(18,20,31,.66); overflow: hidden; transition: border-color .2s, box-shadow .2s; }
    .dng-card::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 3px; background: var(--text-muted); }
    .dng-card.online { border-color: color-mix(in srgb,#34d399 40%,var(--line)); box-shadow: 0 0 16px color-mix(in srgb,#34d399 14%,transparent); }
    .dng-card.online::before { background: #34d399; box-shadow: 0 0 12px #34d399; }
    .dng-card.degraded { border-color: color-mix(in srgb,#f5c451 40%,var(--line)); }
    .dng-card.degraded::before { background: #f5c451; box-shadow: 0 0 12px #f5c451; }
    .dng-card.offline { border-color: color-mix(in srgb,#ef4444 34%,var(--line)); opacity: .82; }
    .dng-card.offline::before { background: #ef4444; }
    .dng-card.unknown::before { background: var(--text-muted); }

    .dng-card-top { display: flex; align-items: center; gap: 8px; }
    .dng-dot { flex: 0 0 auto; width: 9px; height: 9px; border-radius: 50%; background: var(--text-muted); }
    .dng-dot.online { background: #34d399; box-shadow: 0 0 8px #34d399; animation: dngBeat 1.6s ease-in-out infinite; }
    .dng-dot.degraded { background: #f5c451; box-shadow: 0 0 8px #f5c451; }
    .dng-dot.offline { background: #ef4444; }
    @@keyframes dngBeat { 0%,100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.35); opacity: .55; } }
    .dng-name { flex: 1; min-width: 0; font: 800 12.5px Pretendard,'Malgun Gothic',sans-serif; color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .dng-hstat { flex: 0 0 auto; font: 800 9.5px var(--mono); color: var(--text-muted); }
    .dng-card.online .dng-hstat { color: #6ee7b7; }
    .dng-card.degraded .dng-hstat { color: #f5c451; }
    .dng-card.offline .dng-hstat { color: #fca5a5; }
    .dng-url { font: 600 10px var(--mono); color: var(--text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    /* 슬롯 미터 */
    .dng-slots { display: flex; align-items: center; gap: 8px; }
    .dng-slots-lbl { flex: 0 0 auto; font: 700 9.5px var(--mono); color: var(--text-secondary); }
    .dng-slots-track { display: flex; gap: 3px; flex-wrap: wrap; }
    .dng-slot { width: 16px; height: 7px; border-radius: 3px; background: rgba(255,255,255,.09); }
    .dng-slot.busy { background: linear-gradient(90deg,#34d399,#0ea5e9); box-shadow: 0 0 6px color-mix(in srgb,#34d399 50%,transparent); animation: dngPulse 1s ease-in-out infinite; }

    .dng-metrics { display: flex; gap: 10px; }
    .dng-metric { display: flex; flex-direction: column; gap: 1px; }
    .dng-metric b { font: 800 13px var(--mono); color: var(--text-primary); }
    .dng-metric b.ok { color: #34d399; } .dng-metric b.err { color: #fca5a5; }
    .dng-metric span { font: 600 8.5px var(--mono); color: var(--text-muted); }

    .dng-err { font: 700 10px Pretendard,'Malgun Gothic',sans-serif; color: #fca5a5; word-break: break-all; line-height: 1.45; }
    .dng-hb { font: 600 9px var(--mono); color: var(--text-muted); }

    .dng-card-act { display: flex; gap: 6px; margin-top: 2px; }
    .dng-mini { flex: 1; min-height: 34px; border-radius: 9px; border: 1px solid var(--line); background: var(--card-2); color: var(--text-secondary); cursor: pointer; font: 700 10.5px Pretendard,'Malgun Gothic',sans-serif; }
    .dng-mini:hover:not(:disabled) { border-color: #34d399; color: var(--text-primary); }
    .dng-mini:disabled { opacity: .5; cursor: not-allowed; }
    .dng-mini.warn { flex: 0 0 auto; padding: 0 10px; color: #f5c451; }
    .dng-mini.warn:hover { border-color: #f5c451; }
    .dng-mini.del { flex: 0 0 auto; width: 38px; color: #fca5a5; }
    .dng-mini.del:hover:not(:disabled) { border-color: #ef4444; }
</style>
