@using System.Globalization
@using PromptFlowStudio.Services.Neuro
@implements IDisposable
@inject NeuroBioSignalEmotionParserEngine Parser
@inject BioFeedbackGenerativeMediaModifier Mod
@inject CollectiveEmotionHeatmapAggregator Agg
@inject BciNeuroStudioRunner Runner

@*
    [PromptFlow Studio v16.56.0] 🧠 AI BCI & 바이오피드백 스튜디오 — 실시간 뇌파 파형 뷰포트(4ch) · 대역 전력 · 개인/집단 몰입·흥분·쾌적·공포 게이지 ·
    집단 몰입 곡선/공감 피크 · 쾌적×흥분 감정 스펙트럼 · 좌석 열지도 · 변조 감도/의도/분기 · 그레이딩 프리뷰 · UDP 수신.
*@

<div class="bc-scrim" @onclick="Close">
    <div class="bc-modal" @onclick:stopPropagation="true">
        <div class="bc-h">
            <div>
                <div class="bc-title">🧠 AI BCI &amp; 바이오피드백 스튜디오</div>
                <div class="bc-sub">관객의 <b>뇌파(θ·α·β·γ) · 심박 변이도 · 피부 전도도</b>를 감정 지수로 해석하고, <b>집단 공감 순간</b>을 탐지해 색감 · BGM · 긴장 효과음 · VFX · <b>인터랙티브 분기</b>를 끊김 없이 자율 변조합니다.</div>
            </div>
            <button class="bc-x" @onclick="Close">✕</button>
        </div>

        <div class="bc-bar">
            <span class="bc-chip @(Runner.IsRunning ? "ok" : null)">@(Runner.IsRunning ? "● 루프 실행" : "○ 정지") · @(F1((float)Runner.MediaTimeSec))s</span>
            <span class="bc-chip">관객 @(Agg.ActiveViewers)/@(Runner.Audience) · 신호 @(Parser.SubjectCount)</span>
            <span class="bc-chip">패킷 @(Parser.Packets) · 불량 @(Parser.BadPackets) · 아티팩트 @(Parser.Artifacts)</span>
            <span class="bc-chip @(Agg.PeakCount > 0 ? "hot" : null)">공감 피크 @(Agg.PeakCount)</span>
            <span class="bc-chip">분기 결정 @(Mod.BranchDecisions)@(Mod.LastChoiceLabel is { } lc ? " · " + lc : "")</span>
            <span class="bc-chip @(Parser.UdpListening ? "ok" : null)">UDP @(Parser.UdpListening ? Parser.UdpPort.ToString(CultureInfo.InvariantCulture) : "꺼짐")</span>
        </div>

        <div class="bc-main">
            <div class="bc-col">
                <div class="bc-card">
                    <div class="bc-sec">〰 실시간 뇌파 · 관객 #@(Runner.FocusSubject) @(Focus.Dominant)</div>
                    <input type="range" min="0" max="@(Runner.Audience - 1)" step="1" value="@(Runner.FocusSubject)" @oninput="OnFocus" />
                    <svg class="bc-wave" viewBox="0 0 512 200" preserveAspectRatio="none">
                        <rect x="0" y="0" width="512" height="200" fill="#020617" />
                        @for (var c = 0; c < 4; c++)
                        {
                            <polyline points="@(_wavePts[c])" fill="none" stroke="@(WaveColors[c])" stroke-width="1" />
                            <g><text x="4" y="@(c * 50 + 12)" class="bc-svgt">@(ChannelNames[c])</text></g>
                        }
                    </svg>
                    <div class="bc-bands">
                        @foreach (var (name, v) in Bands())
                        {
                            <span>@(name)</span><div class="bc-meter"><i style="width:@(F0(v * 100f))%"></i></div>
                        }
                    </div>
                    <div class="bc-kv">
                        <span>심박</span><b>@(F0(Focus.HeartRate)) bpm</b>
                        <span>RMSSD</span><b>@(F0(Focus.Rmssd)) ms</b>
                        <span>GSR</span><b>@(F2(Focus.GsrMicroSiemens)) µS</b>
                        <span>신뢰도</span><b>@(F0(Focus.Confidence * 100f))%</b>
                    </div>
                </div>
                <div class="bc-card">
                    <div class="bc-sec">🎯 개인 감정 게이지</div>
                    <div class="bc-gauges">
                        @foreach (var (label, v, color) in Gauges(Focus))
                        {
                            <div class="bc-gauge">
                                <svg viewBox="0 0 100 60">
                                    <path d="M 10 55 A 40 40 0 0 1 90 55" fill="none" stroke="#1e293b" stroke-width="9" />
                                    <path d="@(GaugeArc(v))" fill="none" stroke="@(color)" stroke-width="9" />
                                    <g><text x="50" y="52" text-anchor="middle" class="bc-gv">@(F0(v * 100f))</text></g>
                                </svg>
                                <span>@(label)</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="bc-col">
                <div class="bc-card">
                    <div class="bc-sec">👥 집단 몰입/공포 · 공감도 @(F0(Agg.Synchrony * 100f))%</div>
                    <div class="bc-gauges">
                        @foreach (var (label, v, color) in Gauges(Agg.CollectiveState))
                        {
                            <div class="bc-gauge">
                                <svg viewBox="0 0 100 60">
                                    <path d="M 10 55 A 40 40 0 0 1 90 55" fill="none" stroke="#1e293b" stroke-width="9" />
                                    <path d="@(GaugeArc(v))" fill="none" stroke="@(color)" stroke-width="9" />
                                    <g><text x="50" y="52" text-anchor="middle" class="bc-gv">@(F0(v * 100f))</text></g>
                                </svg>
                                <span>@(label)</span>
                            </div>
                        }
                    </div>
                    <svg class="bc-curve" viewBox="0 0 600 100" preserveAspectRatio="none">
                        <rect x="0" y="0" width="600" height="100" fill="#0b1220" />
                        <polyline points="@(_curveE)" fill="none" stroke="#38bdf8" stroke-width="1.5" />
                        <polyline points="@(_curveA)" fill="none" stroke="#f472b6" stroke-width="1" />
                        <polyline points="@(_curveS)" fill="none" stroke="#a3e635" stroke-width="1" stroke-dasharray="3 2" />
                    </svg>
                    <div class="bc-legend"><i style="background:#38bdf8"></i>몰입 <i style="background:#f472b6"></i>흥분 <i style="background:#a3e635"></i>공감</div>
                </div>
                <div class="bc-card">
                    <div class="bc-sec">⚡ 집단 공감 피크</div>
                    @if (_peakCount == 0)
                    {
                        <div class="bc-mut">아직 탐지된 피크가 없습니다.</div>
                    }
                    @for (var i = 0; i < _peakCount; i++)
                    {
                        var p = _peaks[i];
                        <div class="bc-peak"><b>@(F1((float)p.MediaTimeSec))s</b><span>@(p.Emotion)</span><em>몰입 @(F0(p.Engagement * 100f))% · 공감 @(F0(p.Synchrony * 100f))% · z @(F1(p.Score))</em></div>
                    }
                </div>
                <div class="bc-card bc-heat">
                    <div>
                        <div class="bc-sec">🌈 감정 스펙트럼(쾌적 → · 흥분 ↑)</div>
                        <svg viewBox="0 0 16 16" class="bc-spec">
                            @for (var a = 0; a < CollectiveEmotionHeatmapAggregator.Grid; a++)
                            {
                                for (var v = 0; v < CollectiveEmotionHeatmapAggregator.Grid; v++)
                                {
                                    <rect x="@(v)" y="@(15 - a)" width="1" height="1" fill="@(Heat(Agg.Spectrum[a * CollectiveEmotionHeatmapAggregator.Grid + v] * 6f))" />
                                }
                            }
                        </svg>
                    </div>
                    <div>
                        <div class="bc-sec">💺 좌석 몰입 열지도</div>
                        <svg viewBox="10 0 12 @(SeatRows)" class="bc-seat" preserveAspectRatio="none">
                            @for (var r = 0; r < SeatRows; r++)
                            {
                                for (var c = 10; c < 22; c++)
                                {
                                    <rect x="@(c)" y="@(r)" width="0.92" height="0.92" fill="@(Heat(Agg.SeatHeat[r * CollectiveEmotionHeatmapAggregator.SeatCols + c]))" />
                                }
                            }
                        </svg>
                    </div>
                </div>
            </div>

            <div class="bc-col">
                <div class="bc-card">
                    <div class="bc-sec">🎛 감정 자율 변조</div>
                    <div class="bc-row">
                        @if (Runner.IsRunning)
                        {
                            <button class="bc-btn hot" @onclick="Runner.Stop">⏸ 정지</button>
                        }
                        else
                        {
                            <button class="bc-btn on" @onclick="Runner.Start">▶ 바이오피드백 루프</button>
                        }
                        <button class="bc-btn" disabled="@(Runner.IsRunning)" @onclick="Step">⏩ 10초</button>
                        <button class="bc-btn" @onclick="ToggleUdp">@(Parser.UdpListening ? "📴 UDP 끄기" : "📶 UDP 17870")</button>
                    </div>
                    <label class="bc-lab">변조 감도 <b>@(F2(Mod.Sensitivity))</b></label>
                    <input type="range" min="0" max="1" step="0.05" value="@(F2(Mod.Sensitivity))" @oninput="OnSensitivity" />
                    <label class="bc-lab">시뮬 관객 <b>@(Runner.Audience)</b>명</label>
                    <input type="range" min="4" max="192" step="4" value="@(Runner.Audience)" @onchange="OnAudience" />
                    <div class="bc-row">
                        @foreach (var it in Intents)
                        {
                            var intent = it;
                            <button class="bc-btn sm @(Mod.Intent == intent ? "on" : null)" @onclick="() => Mod.Intent = intent">@(IntentLabel(intent))</button>
                        }
                    </div>
                    <div class="bc-row">
                        <button class="bc-btn sm @(Runner.UseCollective ? "on" : null)" @onclick="() => Runner.UseCollective = true">👥 집단 입력</button>
                        <button class="bc-btn sm @(!Runner.UseCollective ? "on" : null)" @onclick="() => Runner.UseCollective = false">👤 개인 입력</button>
                        <button class="bc-btn sm @(Mod.AutoBranch ? "on" : null)" @onclick="() => Mod.AutoBranch = !Mod.AutoBranch">🔀 자동 분기 @(Mod.AutoBranch ? "ON" : "OFF")</button>
                    </div>
                    @if (_frameUrl is not null)
                    {
                        <img class="bc-frame" src="@(_frameUrl)" alt="그레이딩 프리뷰" />
                    }
                </div>
                <div class="bc-card">
                    <div class="bc-sec">📊 변조 파라미터(현재 · 목표)</div>
                    @foreach (var p in Params)
                    {
                        <div class="bc-param">
                            <span>@(BioFeedbackGenerativeMediaModifier.Label(p))</span>
                            <b>@(Fmt(p, Mod[p]))</b>
                            <em>→ @(Fmt(p, Mod.TargetOf(p)))</em>
                        </div>
                    }
                </div>
                <div class="bc-act">@(Runner.LastAction ?? Agg.LastAction ?? Mod.LastAction ?? Parser.LastAction ?? "BCI 대기")</div>
            </div>
        </div>
    </div>
</div>

<style>
    .bc-scrim { position: fixed; inset: 0; z-index: var(--z-studio-modal); background: rgba(0,0,0,.6); display: flex; align-items: center; justify-content: center; padding: 20px; }
    .bc-modal { width: min(1560px, 97vw); max-height: 94vh; display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--line); border-radius: 18px; box-shadow: 0 24px 60px rgba(0,0,0,.45); overflow: hidden; }
    .bc-h { display: flex; justify-content: space-between; gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--line); background: linear-gradient(120deg, color-mix(in srgb, #8b5cf6 18%, var(--card)), color-mix(in srgb, #f43f5e 12%, var(--card))); }
    .bc-title { font-size: 17px; font-weight: 900; color: var(--text-primary); }
    .bc-sub { font-size: 12px; color: var(--text-secondary); margin-top: 4px; line-height: 1.5; }
    .bc-sub b { color: var(--text-primary); }
    .bc-x { background: none; border: none; color: var(--text-muted); font-size: 18px; cursor: pointer; border-radius: 8px; }
    .bc-bar { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 20px; border-bottom: 1px solid var(--line); }
    .bc-chip { font: 700 11px var(--mono); padding: 3px 8px; border-radius: 999px; border: 1px solid var(--line); color: var(--text-muted); }
    .bc-chip.ok { color: #22c55e; border-color: #22c55e; }
    .bc-chip.hot { color: #f97316; border-color: #f97316; }
    .bc-main { display: grid; grid-template-columns: 1fr 1.1fr 1fr; gap: 14px; padding: 14px 20px; min-height: 0; flex: 1; overflow-y: auto; }
    .bc-col { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
    .bc-card { border: 1px solid var(--line); border-radius: 12px; padding: 12px; display: flex; flex-direction: column; gap: 6px; }
    .bc-sec { font-weight: 800; font-size: 13px; color: var(--text-primary); }
    .bc-lab { font-size: 11px; color: var(--text-secondary); }
    .bc-lab b { color: var(--text-primary); font-family: var(--mono); }
    .bc-row { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
    .bc-btn { font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 8px; border: 1px solid var(--line); background: transparent; color: var(--text-primary); cursor: pointer; }
    .bc-btn.on { background: color-mix(in srgb, #8b5cf6 25%, transparent); border-color: #8b5cf6; }
    .bc-btn.hot { background: color-mix(in srgb, #f97316 22%, transparent); border-color: #f97316; }
    .bc-btn.sm { font-size: 11px; padding: 3px 8px; }
    .bc-btn:disabled { opacity: .45; cursor: default; }
    .bc-wave { width: 100%; height: 180px; border-radius: 10px; }
    .bc-svgt { font-size: 9px; fill: #94a3b8; }
    .bc-bands { display: grid; grid-template-columns: auto 1fr; gap: 3px 8px; font-size: 11px; align-items: center; color: var(--text-muted); }
    .bc-meter { height: 7px; border-radius: 999px; background: var(--line); overflow: hidden; }
    .bc-meter i { display: block; height: 100%; background: linear-gradient(90deg, #8b5cf6, #38bdf8); }
    .bc-kv { display: grid; grid-template-columns: auto 1fr auto 1fr; gap: 3px 10px; font-size: 11px; }
    .bc-kv span { color: var(--text-muted); }
    .bc-kv b { font-family: var(--mono); color: var(--text-primary); font-weight: 600; }
    .bc-gauges { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
    .bc-gauge { display: flex; flex-direction: column; align-items: center; font-size: 11px; color: var(--text-muted); }
    .bc-gauge svg { width: 100%; max-width: 110px; }
    .bc-gv { font-size: 16px; font-weight: 800; fill: #e2e8f0; }
    .bc-curve { width: 100%; height: 110px; border-radius: 10px; }
    .bc-legend { font-size: 10px; color: var(--text-muted); display: flex; gap: 6px; align-items: center; }
    .bc-legend i { width: 10px; height: 3px; display: inline-block; }
    .bc-peak { display: grid; grid-template-columns: 54px 80px 1fr; gap: 6px; font-size: 11px; align-items: baseline; }
    .bc-peak b { font-family: var(--mono); color: #f97316; }
    .bc-peak em { color: var(--text-muted); font-style: normal; }
    .bc-mut { font-size: 11px; color: var(--text-muted); }
    .bc-heat { display: grid; grid-template-columns: 1fr 1.4fr; gap: 10px; }
    .bc-spec { width: 100%; max-width: 160px; aspect-ratio: 1; border-radius: 6px; }
    .bc-seat { width: 100%; height: 90px; }
    .bc-frame { width: 100%; border-radius: 10px; image-rendering: pixelated; border: 1px solid var(--line); }
    .bc-param { display: grid; grid-template-columns: 1fr auto auto; gap: 8px; font-size: 11px; }
    .bc-param span { color: var(--text-muted); }
    .bc-param b { font-family: var(--mono); color: var(--text-primary); }
    .bc-param em { font-family: var(--mono); color: var(--text-muted); font-style: normal; }
    .bc-act { font-size: 11px; color: var(--text-muted); font-family: var(--mono); padding: 4px 2px; }
    @@media (max-width: 1100px) { .bc-main { grid-template-columns: 1fr; } }
</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private static readonly string[] WaveColors = { "#38bdf8", "#a78bfa", "#f472b6", "#a3e635" };
    private static readonly string[] ChannelNames = { "TP9", "AF7", "AF8", "TP10" };
    private static readonly DirectorIntent[] Intents = { DirectorIntent.Balanced, DirectorIntent.Thrill, DirectorIntent.Calm };
    private static readonly ModParam[] Params = (ModParam[])Enum.GetValues(typeof(ModParam));
    private readonly string[] _wavePts = { "", "", "", "" };
    private readonly float[] _wave = new float[512];
    private readonly float[] _ce = new float[600], _ca = new float[600], _cs = new float[600];
    private readonly PeakMoment[] _peaks = new PeakMoment[8];
    private readonly byte[] _frame = new byte[BciNeuroStudioRunner.FrameWidth * BciNeuroStudioRunner.FrameHeight * 3];
    private string _curveE = "", _curveA = "", _curveS = "";
    private string? _frameUrl;
    private int _peakCount;
    private long _shownSeq = -1;
    private System.Threading.Timer? _timer;

    private EmotionState Focus => Parser.StateAt(Runner.FocusIndex);
    private int SeatRows => Math.Clamp((Runner.Audience + 11) / 12, 1, CollectiveEmotionHeatmapAggregator.SeatRows);

    protected override void OnInitialized()
    {
        Parser.OnChange += OnServiceChanged;
        Mod.OnChange += OnServiceChanged;
        Agg.OnChange += OnServiceChanged;
        Runner.OnChange += OnServiceChanged;
        Refresh();
        _timer = new System.Threading.Timer(_ => { if (Runner.IsRunning && Runner.FrameSeq != _shownSeq) _ = InvokeAsync(() => { Refresh(); StateHasChanged(); }); }, null, 200, 200);
    }

    private static string F0(float v) => v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(float v) => v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(float v) => v.ToString("0.00", CultureInfo.InvariantCulture);

    private static string Fmt(ModParam p, float v) => p switch
    {
        ModParam.Tempo or ModParam.LowPass => F0(v),
        ModParam.HueShift or ModParam.Pitch => F1(v),
        _ => F2(v),
    };

    private static string IntentLabel(DirectorIntent i) => i switch { DirectorIntent.Thrill => "🎢 스릴", DirectorIntent.Calm => "🌿 평온", _ => "⚖ 균형" };

    private static IEnumerable<(string, float, string)> Gauges(EmotionState s)
    {
        yield return ("몰입", s.Engagement, "#38bdf8");
        yield return ("흥분", s.Arousal, "#f472b6");
        yield return ("쾌적", s.Valence, "#a3e635");
        yield return ("공포/전율", s.Fear, "#ef4444");
    }

    private IEnumerable<(string, float)> Bands()
    {
        var s = Focus;
        var max = MathF.Max(1e-3f, MathF.Max(MathF.Max(s.Theta, s.Alpha), MathF.Max(s.Beta, s.Gamma)));
        yield return ("θ 세타", s.Theta / max);
        yield return ("α 알파", s.Alpha / max);
        yield return ("β 베타", s.Beta / max);
        yield return ("γ 감마", s.Gamma / max);
    }

    private static string GaugeArc(float v)
    {
        var a = MathF.PI * (1f - Math.Clamp(v, 0.001f, 1f));
        return "M 10 55 A 40 40 0 0 1 " + F1(50f + 40f * MathF.Cos(a)) + " " + F1(55f - 40f * MathF.Sin(a));
    }

    private static string Heat(float v)
    {
        v = Math.Clamp(v, 0f, 1f);
        int r = (int)(20 + 235 * MathF.Min(1f, v * 1.6f)), g = (int)(30 + 160 * MathF.Max(0f, v * 1.4f - 0.4f)), b = (int)(90 * (1f - v) + 30);
        return "rgb(" + r.ToString(CultureInfo.InvariantCulture) + "," + g.ToString(CultureInfo.InvariantCulture) + "," + b.ToString(CultureInfo.InvariantCulture) + ")";
    }

    private static string Polyline(ReadOnlySpan<float> v, int n, float xScale, float yBase, float yScale)
    {
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = 0; i < n; i++)
        {
            if (i > 0) sb.Append(' ');
            sb.Append(F1(i * xScale)).Append(',').Append(F1(yBase - v[i] * yScale));
        }
        return sb.ToString();
    }

    private void Refresh()
    {
        var idx = Runner.FocusIndex;
        for (var c = 0; c < 4; c++)
        {
            var n = Parser.CopyWaveform(idx, c, _wave);
            for (var i = 0; i < n; i++) _wave[i] = Math.Clamp(_wave[i], -60f, 60f);
            _wavePts[c] = n == 0 ? "" : Polyline(_wave, n, 512f / Math.Max(1, n - 1), c * 50 + 25, 0.38f);
        }
        var cn = Agg.CopyCurve(_ce, _ca, _cs);
        var xs = 600f / Math.Max(1, cn - 1);
        _curveE = Polyline(_ce, cn, xs, 98f, 96f);
        _curveA = Polyline(_ca, cn, xs, 98f, 96f);
        _curveS = Polyline(_cs, cn, xs, 98f, 96f);
        _peakCount = Agg.CopyPeaks(_peaks);
        Runner.CopyFrame(_frame);
        _frameUrl = BmpUrl(_frame, BciNeuroStudioRunner.FrameWidth, BciNeuroStudioRunner.FrameHeight);
        _shownSeq = Runner.FrameSeq;
    }

    /// <summary>RGB24 → BMP data URL(UI 계층 할당 허용).</summary>
    private static string BmpUrl(byte[] rgb, int w, int h)
    {
        var stride = (w * 3 + 3) & ~3;
        var size = 54 + stride * h;
        var b = new byte[size];
        b[0] = (byte)'B'; b[1] = (byte)'M';
        BitConverter.TryWriteBytes(b.AsSpan(2), size); BitConverter.TryWriteBytes(b.AsSpan(10), 54); BitConverter.TryWriteBytes(b.AsSpan(14), 40);
        BitConverter.TryWriteBytes(b.AsSpan(18), w); BitConverter.TryWriteBytes(b.AsSpan(22), h); BitConverter.TryWriteBytes(b.AsSpan(26), (short)1); BitConverter.TryWriteBytes(b.AsSpan(28), (short)24);
        BitConverter.TryWriteBytes(b.AsSpan(34), stride * h);
        for (var y = 0; y < h; y++)
        {
            var dst = 54 + (h - 1 - y) * stride; var src = y * w * 3;
            for (var x = 0; x < w; x++) { b[dst + x * 3] = rgb[src + x * 3 + 2]; b[dst + x * 3 + 1] = rgb[src + x * 3 + 1]; b[dst + x * 3 + 2] = rgb[src + x * 3]; }
        }
        return "data:image/bmp;base64," + Convert.ToBase64String(b);
    }

    private static float Parse(ChangeEventArgs e, float fallback)
        => float.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : fallback;

    private void OnSensitivity(ChangeEventArgs e) => Mod.Sensitivity = Parse(e, Mod.Sensitivity);
    private void OnAudience(ChangeEventArgs e) => Runner.SetAudience((int)Parse(e, Runner.Audience));
    private void OnFocus(ChangeEventArgs e) { Runner.FocusSubject = (int)Parse(e, Runner.FocusSubject); Refresh(); }

    private void Step()
    {
        for (var k = 0; k < BciNeuroStudioRunner.TickHz * 10; k++) Runner.TickOnce(1.0 / BciNeuroStudioRunner.TickHz);
        Refresh();
    }

    private void ToggleUdp()
    {
        if (Parser.UdpListening) Parser.StopUdp();
        else Parser.StartUdp(17870, any: true);
    }

    private Task Close() => OnClose.InvokeAsync();

    private void OnServiceChanged() => _ = InvokeAsync(() => { Refresh(); StateHasChanged(); });

    public void Dispose()
    {
        _timer?.Dispose();
        Parser.OnChange -= OnServiceChanged;
        Mod.OnChange -= OnServiceChanged;
        Agg.OnChange -= OnServiceChanged;
        Runner.OnChange -= OnServiceChanged;
    }
}
