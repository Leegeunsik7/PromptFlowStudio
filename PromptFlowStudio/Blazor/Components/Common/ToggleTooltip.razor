@* [PromptFlow Studio] 스위치 역할 실시간 가이드 토스트 — 스위치 클릭 시 ON/OFF 연출 차이 + 권장 시나리오를 애니메이션 카드로.
   Guide 가 세팅되면 우하단에서 슬라이드-인(자동 소멸은 부모가 타이머로 관리). @key 로 가이드 전환 시 애니메이션 재생. *@

@if (Guide is { } g)
{
    <div class="tt-wrap">
        <div class="tt-card" @key="g.Key">
            <div class="tt-h">
                <span class="tt-ic">@g.Icon</span>
                <span class="tt-title">@g.Title</span>
                <button class="tt-x" @onclick="OnClose" title="닫기">✕</button>
            </div>
            <SwitchAnimationSnippet Key="@g.Key" />
            <div class="tt-row"><span class="tt-tag on">켜짐</span><span class="tt-txt">@g.WhenOn</span></div>
            <div class="tt-row"><span class="tt-tag off">꺼짐</span><span class="tt-txt">@g.WhenOff</span></div>
            <div class="tt-row"><span class="tt-tag sc">권장</span><span class="tt-txt">@g.Scenario</span></div>
        </div>
    </div>
}

<style>
    .tt-wrap { position: fixed; right: 18px; bottom: 18px; z-index: var(--z-toast-notification); pointer-events: none; }
    .tt-card { pointer-events: auto; width: min(340px, 86vw); background: var(--card); border: 1px solid var(--line); border-radius: 14px;
        box-shadow: 0 16px 40px rgba(0,0,0,.42); padding: 13px 15px; animation: tt-in .28s cubic-bezier(.2,.9,.3,1.2); }
    .tt-h { display: flex; align-items: center; gap: 8px; margin-bottom: 9px; }
    .tt-ic { font-size: 17px; }
    .tt-title { font: 900 13.5px var(--mono); color: var(--text-primary); flex: 1; }
    .tt-x { flex: 0 0 auto; width: 24px; height: 24px; border: none; background: none; color: var(--text-muted); cursor: pointer; font-size: 13px; border-radius: 7px; }
    .tt-x:hover { background: var(--card-2); color: var(--text-primary); }
    .tt-row { display: flex; gap: 8px; align-items: flex-start; padding: 4px 0; }
    .tt-tag { flex: 0 0 auto; font: 800 9.5px var(--mono); padding: 2px 7px; border-radius: 999px; margin-top: 1px; }
    .tt-tag.on { color: #fff; background: #10b981; }
    .tt-tag.off { color: var(--text-secondary); background: var(--card-2); border: 1px solid var(--line); }
    .tt-tag.sc { color: #fff; background: linear-gradient(135deg, var(--flow-violet), var(--flow-magenta)); }
    .tt-txt { font-size: 11.5px; line-height: 1.45; color: var(--text-secondary); white-space: pre-line; }
    @@keyframes tt-in { from { opacity: 0; transform: translateY(14px) scale(.96); } to { opacity: 1; transform: none; } }
    @@media (prefers-reduced-motion: reduce) { .tt-card { animation: none; } }
</style>

@code {
    /// <summary>표시할 스위치 가이드(null 이면 숨김).</summary>
    [Parameter] public SwitchGuide? Guide { get; set; }
    /// <summary>닫기 콜백.</summary>
    [Parameter] public EventCallback OnClose { get; set; }
}
