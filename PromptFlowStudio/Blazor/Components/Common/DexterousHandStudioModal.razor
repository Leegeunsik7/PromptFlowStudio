@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private const float Zoom = 900f;
    private System.Threading.Timer? _timer;
    private double _yaw = 20, _pitch = 20;
    private bool _showRaw, _showGt;

    private DexterousFingerPoseTriangulationEngine E => Runner.Engine;
    private InterDigitalSelfCollisionDislocationGuard G => Runner.Guard;
    private VirtualPropContactGraspingSynthesizer Pr => Runner.Prop;

    protected override void OnInitialized()
    {
        Runner.OnChange += OnServiceChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            try { _ = InvokeAsync(StateHasChanged); }
            catch (Exception ex) { PromptFlowStudio.Program.Log("DexterousHand.Modal.Timer", ex); }
        }, null, 200, 200);
    }

    private static string F0(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0", CultureInfo.InvariantCulture);
    private static string F1(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "0" : v.ToString("0.0", CultureInfo.InvariantCulture);
    private static string F2(double v) => double.IsNaN(v) || double.IsInfinity(v) ? "—" : v.ToString("0.00", CultureInfo.InvariantCulture);
    private static double Num(ChangeEventArgs e, double fallback) => double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : fallback;

    /// <summary>궤도 정사영(작업 공간 중심 기준).</summary>
    private Vector2 P(Vector3 w)
    {
        var p = w - DexterousHandStudioRunner.Center;
        float yaw = (float)(_yaw * Math.PI / 180), pitch = (float)(_pitch * Math.PI / 180);
        float cy = MathF.Cos(yaw), sy = MathF.Sin(yaw), cp = MathF.Cos(pitch), sp = MathF.Sin(pitch);
        var x = p.X * cy + p.Z * sy;
        var z = -p.X * sy + p.Z * cy;
        var y = p.Y * cp + z * sp;
        return new Vector2(320 + x * Zoom, 230 - y * Zoom);
    }

    /// <summary>열 지도 색(0..1 → 남색 · 파랑 · 초록 · 노랑 · 빨강).</summary>
    private static string HeatCss(double t)
    {
        t = Math.Clamp(t, 0, 1);
        double r, g, b;
        if (t < 0.25) { var u = t / 0.25; r = 11 + (29 - 11) * u; g = 16 + (78 - 16) * u; b = 32 + (216 - 32) * u; }
        else if (t < 0.5) { var u = (t - 0.25) / 0.25; r = 29 + (34 - 29) * u; g = 78 + (197 - 78) * u; b = 216 + (94 - 216) * u; }
        else if (t < 0.75) { var u = (t - 0.5) / 0.25; r = 34 + (250 - 34) * u; g = 197 + (204 - 197) * u; b = 94 + (21 - 94) * u; }
        else { var u = (t - 0.75) / 0.25; r = 250 + (239 - 250) * u; g = 204 + (68 - 204) * u; b = 21 + (68 - 21) * u; }
        return "rgb(" + F0(r) + "," + F0(g) + "," + F0(b) + ")";
    }

/// <summary>마디 뼈(부모 관절이 지배) 가드 상태 클래스.</summary>
    private string? BoneFlag(int k)
    {
        var p = k % HandTopology.Points;
        var j = (p - 1) % 4 - 1;
        if (j < 0) return null;
        int h = k / HandTopology.Points, f = HandTopology.FingerOf(p);
        return G.Reverted(h, f, (DigitJoint)j) ? "rev" : G.Clamped(h, f, (DigitJoint)j) ? "rom" : null;
    }

        private string BoxPath(PropShape s)
    {
        Span<Vector2> c = stackalloc Vector2[8];
        for (var i = 0; i < 8; i++)
        {
            var l = s.A + new Vector3((i & 1) == 0 ? -s.B.X : s.B.X, (i & 2) == 0 ? -s.B.Y : s.B.Y, (i & 4) == 0 ? -s.B.Z : s.B.Z);
            c[i] = P(Pr.ToWorld(l));
        }
        var sb = new System.Text.StringBuilder(256);
        ReadOnlySpan<int> e = stackalloc int[] { 0, 1, 1, 3, 3, 2, 2, 0, 4, 5, 5, 7, 7, 6, 6, 4, 0, 4, 1, 5, 2, 6, 3, 7 };
        for (var i = 0; i < e.Length; i += 2)
            sb.Append('M').Append(F1(c[e[i]].X)).Append(',').Append(F1(c[e[i]].Y)).Append('L').Append(F1(c[e[i + 1]].X)).Append(',').Append(F1(c[e[i + 1]].Y));
        return sb.ToString();
    }

    private string Series(Func<int, float> f, double max, double h)
    {
        var n = Runner.SeriesCount;
        if (n < 2) return "";
        var sb = new System.Text.StringBuilder(n * 12);
        for (var i = n - 1; i >= 0; i--)
            sb.Append(F1(360.0 * (n - 1 - i) / (DexterousHandStudioRunner.SeriesLen - 1))).Append(',').Append(F1(h - 2 - (h - 4) * Math.Clamp(f(i) / max, 0, 1))).Append(' ');
        return sb.ToString();
    }

    private void ToggleRun() { if (Runner.IsRunning) Runner.Stop(); else Runner.Start(); }
    private void Step60() { for (var i = 0; i < DexterousHandStudioRunner.Hz; i++) Runner.Step(); }

    private Task Close() => OnClose.InvokeAsync();

    /// <summary>가동 중(10 Hz 이벤트)은 200 ms 타이머가 처리 — 정지 상태 액션만 즉시 반영.</summary>
    private void OnServiceChanged() { if (!Runner.IsRunning) _ = InvokeAsync(StateHasChanged); }

    public void Dispose()
    {
        Runner.OnChange -= OnServiceChanged;
        _timer?.Dispose();
        Runner.Stop();
    }
}
