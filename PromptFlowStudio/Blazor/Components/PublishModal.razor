@using System.Globalization
@using PromptFlowStudio.ViewModels
@implements IDisposable

@* [PromptFlow Studio] 🚀 SNS 원클릭 발행 모달 — YouTube Shorts · Instagram Reels.
   ▸ 데스크톱 전용(ViewModels 는 모바일 링크 대상 아님 → Mobile.csproj 에서 RazorComponent Remove). @inject 없이 Vm 파라미터만 받는다.
   ▸ 전송은 Vm 이 백그라운드로 수행 — 모달을 닫아도 계속되며 다시 열면 진행률 확인. *@

@if (Vm is { IsOpen: true } vm)
{
    <div class="pm-dim" @onclick="vm.Close"></div>
    <div class="pm" role="dialog" aria-label="SNS 원클릭 발행">
        <div class="pm-h">
            <span>🚀 SNS 원클릭 발행</span>
            <button class="pm-x" @onclick="vm.Close" title="닫기(전송은 백그라운드 계속)">✕</button>
        </div>

        <div class="pm-body">
            <div class="pm-row pm-path" title="@vm.VideoPath">🎬 @(System.IO.Path.GetFileName(vm.VideoPath))@(vm.SrtPath is null ? "" : "  ·  📝 " + System.IO.Path.GetFileName(vm.SrtPath))</div>

            @if (vm.StockSuiteAvailable)
            {
                @* ⚡ 핀테크 퀵 프리셋 — 선택 즉시 해상도·60fps·LUT·워터마크·배지·BGM(loudnorm)·멀티 비율·발행 대상 11종 일괄 반영 *@
                <div class="pm-row pm-seo">
                    <select class="pm-btn" value="@(vm.ActivePreset is { } ap ? PromptFlowStudio.Services.Export.FintechExportPreset.Key(ap) : "")"
                            @onchange="OnQuickPreset" disabled="@(vm.IsStockSuiteBusy || vm.IsBusy)" title="⚡ Quick Preset — 인코딩 스위치 일괄 설정">
                        <option value="">⚡ Quick Preset</option>
                        <option value="oled">@PromptFlowStudio.Services.Export.FintechExportPreset.Label(PromptFlowStudio.Services.Export.FintechPresetKind.OledHts)</option>
                        <option value="shorts">@PromptFlowStudio.Services.Export.FintechExportPreset.Label(PromptFlowStudio.Services.Export.FintechPresetKind.MobileShorts)</option>
                        <option value="uw329">@PromptFlowStudio.Services.Export.FintechExportPreset.Label(PromptFlowStudio.Services.Export.FintechPresetKind.Ultrawide32x9)</option>
                        @if (vm.HasCustomPreset) { <option value="custom">💾 Custom Preset</option> }
                        <option value="save">💾 Save Current as Custom Preset</option>
                    </select>
                    <select class="pm-btn" value="@((int)vm.StockSuiteLut)" @onchange="OnLutChanged" disabled="@vm.IsStockSuiteBusy" title="🎨 LUT 번인">
                        @foreach (var lp in PromptFlowStudio.Services.Export.ColorGradingService.All)
                        {
                            <option value="@((int)lp)">🎨 @PromptFlowStudio.Services.Export.ColorGradingService.Label(lp)</option>
                        }
                    </select>
                    @if (vm.PresetMessage is { } pmsg) { <span class="pm-seo-msg">@pmsg</span> }
                </div>
                <div class="pm-row pm-seo">
                    <select class="pm-btn" value="@(vm.StockSuiteFormat == PromptFlowStudio.Services.Export.StockSuiteExportFormat.WebMVp9 ? "webm" : "mp4")"
                            @onchange="e => vm.StockSuiteFormat = PromptFlowStudio.Services.Export.StockSuiteExporter.ParseFormat(e.Value?.ToString())" disabled="@vm.IsStockSuiteBusy" title="StockSuite 내보내기 포맷">
                        <option value="mp4">MP4 (기본)</option>
                        <option value="webm">WebM VP9 (HTS 저사양 최적화)</option>
                    </select>
            <label class="pm-btn" title="1080p Lanczos 업스케일 + 언샵 마스크 샤프닝(재인코딩) — 끄면 스트림 복사(빠른 내보내기)"><input type="checkbox" checked="@vm.StockSuiteSharpen" @onchange="e => vm.StockSuiteSharpen = e.Value is true" disabled="@vm.IsStockSuiteBusy" /> 고선명 샤프닝 (1080p Lanczos + Unsharp)</label>
                    <select class="pm-btn" value="@(PromptFlowStudio.Services.Export.StockSuiteExporter.ResolutionKey(vm.StockSuiteResolution))"
                            @onchange="@(e => vm.StockSuiteResolution = PromptFlowStudio.Services.Export.StockSuiteExporter.ParseResolution(e.Value?.ToString()))" disabled="@vm.IsStockSuiteBusy" title="해상도 프로필">
                        <option value="1080">1080p (기본)</option>
                        <option value="4k">4K UHD (3840x2160 Lanczos)</option>
                        <option value="21x9">21:9 울트라와이드 (2560x1080 Lanczos)</option>
                        <option value="32x9">32:9 슈퍼 울트라와이드 (3840x1080 Lanczos)</option>
                    </select>
            <label class="pm-btn" title="좌상단 ANG QUANT LAB · REALTIME STREAM / 우상단 ● LIVE KST 번인(재인코딩) — 폰트 미설치·drawtext 실패 시 워터마크 생략 폴백"><input type="checkbox" checked="@vm.StockSuiteWatermark" @onchange="e => vm.StockSuiteWatermark = e.Value is true" disabled="@vm.IsStockSuiteBusy" /> 📺 핀테크 HUD 워터마크</label>
            <label class="pm-btn" title="우하단 반투명 카드에 티커·사명 / 시세·등락률(+ 네온 그린 · − 크림슨) 번인 — 티커 공란·폰트 실패 시 배지 생략 폴백"><input type="checkbox" checked="@vm.StockSuiteTickerBadge" @onchange="e => { vm.StockSuiteTickerBadge = e.Value is true; if (vm.StockSuiteTickerBadge && vm.TickerSymbol.Length > 0 && vm.TickerPrice == 0m) vm.SetTicker(vm.TickerSymbol); }" disabled="@vm.IsStockSuiteBusy" /> 📊 라이브 티커 배지</label>
            @if (vm.StockSuiteTickerBadge)
            {
                <input class="pm-btn" style="width:6em" placeholder="AAPL" value="@vm.TickerSymbol" @onchange="e => vm.SetTicker(e.Value?.ToString())" disabled="@vm.IsStockSuiteBusy" title="티커 — 입력 시 캐시 시세(IPC · quotes.json) 자동 채움" />
                <input class="pm-btn" style="width:9em" placeholder="Apple Inc." value="@vm.TickerCompany" @onchange="e => vm.TickerCompany = e.Value?.ToString() ?? string.Empty" disabled="@vm.IsStockSuiteBusy" title="사명" />
                <input class="pm-btn" style="width:6em" type="number" step="0.01" value="@(vm.TickerPrice.ToString(System.Globalization.CultureInfo.InvariantCulture))" @onchange="e => vm.TickerPrice = decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var tp) ? tp : 0m" disabled="@vm.IsStockSuiteBusy" title="시세($)" />
                <input class="pm-btn" style="width:5em" type="number" step="0.1" value="@(vm.TickerChangePercent.ToString(System.Globalization.CultureInfo.InvariantCulture))" @onchange="e => vm.TickerChangePercent = double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var tc) ? tc : 0d" disabled="@vm.IsStockSuiteBusy" title="등락률(%)" />
                <button class="pm-btn" @onclick="() => vm.SetTicker(vm.TickerSymbol)" disabled="@(vm.IsStockSuiteBusy || string.IsNullOrWhiteSpace(vm.TickerSymbol))" title="캐시 시세 다시 불러오기">📈</button>
                @if (vm.TickerQuoteMessage is { } tqm)
                {
                    <span class="pm-sub">@tqm</span>
                }
            }
            <label class="pm-btn" title="16~24fps AI 영상을 minterpolate(MCI) 로 60fps 보간 — 고주사율(120Hz+) OLED 끊김 제거 · 재인코딩 시간 증가"><input type="checkbox" checked="@vm.StockSuiteSmooth60" @onchange="e => vm.StockSuiteSmooth60 = e.Value is true" disabled="@vm.IsStockSuiteBusy" /> ⚡ 60fps 모션 스무딩</label>
                    <button class="pm-btn" @onclick="ExportStockSuite" disabled="@vm.IsStockSuiteBusy"
                            title="환경설정의 StockSuite 에셋 폴더에 bg_ambient.mp4 로 원자적 덮어쓰기">@(vm.IsStockSuiteBusy ? "⏳ 복사 중…" : "💼 StockSuite로 내보내기")</button>
                    @if (vm.StockSuiteExported && vm.CanLaunchStockSuite)
                    {
                        @if (vm.StockSuiteRestartPending)
                        {
                            <button class="pm-btn" @onclick="() => vm.LaunchStockSuite(true)" title="실행 중인 StockSuite 를 종료하고 다시 실행해 새 에셋을 즉시 반영">🔄 재실행</button>
                        }
                        else
                        {
                            <button class="pm-btn" @onclick="() => vm.LaunchStockSuite(false)" title="환경설정의 StockSuite.exe 를 실행해 에셋 적용을 실기 검증">🚀 StockSuite 실행</button>
                        }
                    }
                    <button class="pm-btn" @onclick="ExportDualSplit" disabled="@vm.IsStockSuiteBusy" title="32:9/21:9 울트라와이드 원본을 좌/우 1920×1080(bg_screen_1 · bg_screen_2)으로 분할 — 베젤 간격만큼 우측 크롭 보정 + 멀티 디스플레이 설정 갱신">🖥️ 듀얼 모니터 분할 내보내기</button>
                    @if (vm.StockSuiteExported && vm.CanRollbackStockSuite)
                    {
                        <button class="pm-btn" @onclick="() => vm.RollbackStockSuite()" disabled="@vm.IsStockSuiteBusy" title="덮어쓰기 직전 백업(bg_ambient.backup)과 맞교환 — 다시 누르면 되돌리기">↩️ 이전 배경으로 복원</button>
                    }
                    @if (vm.StockSuiteMessage is { Length: > 0 } ssMsg)
                    {
                        <span class="pm-seo-msg">@ssMsg</span>
                    }
                </div>
                <div class="pm-row pm-seo">
                    <select class="pm-btn" value="@(PromptFlowStudio.Services.Export.StockSuiteExporter.HtsAspectKey(vm.MultiHtsAspect))"
                            @onchange="e => vm.MultiHtsAspect = PromptFlowStudio.Services.Export.StockSuiteExporter.ParseHtsAspect(e.Value?.ToString())" disabled="@vm.IsMultiPackageBusy" title="HTS 데스크톱 울트라와이드 비율">
                        <option value="16x9">HTS 16:9 (1920×1080)</option>
                        <option value="21x9">HTS 21:9 (2560×1080)</option>
                        <option value="32x9">HTS 32:9 (3840×1080)</option>
                    </select>
                    <button class="pm-btn" @onclick="ExportMultiPackage" disabled="@vm.IsMultiPackageBusy"
                            title="HTS 울트라와이드(무음·샤프닝) + 모바일 9:16 + SNS 쇼츠 9:16(BGM·1.5초 페이드아웃)을 한 번에 생성">@(vm.IsMultiPackageBusy ? "⏳ 패키지 생성 중…" : "📦 올인원 멀티 패키지 내보내기")</button>
                    @if (vm.MultiPackageMessage is { Length: > 0 } mpMsg)
                    {
                        <span class="pm-seo-msg">@mpMsg</span>
                    }
                </div>
            }

            <div class="pm-row pm-seo">
                <button class="pm-btn pm-seo-btn" @onclick="GenerateSeo" disabled="@(vm.IsBusy || vm.IsSeoBusy)"
                        title="프롬프트 · 듀레이션 · 선택 채널 기반 제미나이 SEO 제목 · 설명 · 해시태그 자동 입력(키 없으면 로컬 템플릿)">@(vm.IsSeoBusy ? "⏳ 생성 중…" : "✨ AI 제목·해시태그 자동 생성")</button>
                @if (vm.SeoMessage is { Length: > 0 } seoMsg)
                {
                    <span class="pm-seo-msg">@seoMsg</span>
                }
            </div>

            @if (vm.BgmAvailable)
            {
                <div class="pm-lbl">🎵 배경음악 선택 (영상 길이 컷 · 끝 1.5초 페이드아웃)</div>
                <div class="pm-row pm-seo">
                    <select class="pm-btn" value="@(PromptFlowStudio.Services.Export.AudioMuxService.Key(vm.Bgm))"
                            @onchange="e => vm.Bgm = PromptFlowStudio.Services.Export.AudioMuxService.ParsePreset(e.Value?.ToString())" disabled="@vm.IsBusy">
                        <option value="none">무음(기본)</option>
                        <option value="synthwave">📈 핀테크 신스웨이브</option>
                        <option value="lofi">☕ 로파이 비트</option>
                        <option value="custom">사용자 MP3 선택</option>
                    </select>
                    @if (vm.Bgm == PromptFlowStudio.Services.Export.SnsBgmPreset.CustomFile)
                    {
                        <input class="pm-in" placeholder="예: C:\Music\bgm.mp3" @bind="vm.CustomBgmPath" disabled="@vm.IsBusy" />
                    }
                    @if (vm.BgmStatus is { Length: > 0 } bgmMsg)
                    {
                        <span class="pm-seo-msg">@bgmMsg</span>
                    }
                </div>
            }

            <div class="pm-lbl">대상 채널</div>
            <div class="pm-row">
                <label class="pm-chk"><input type="checkbox" @bind="vm.ToYouTube" disabled="@vm.IsBusy" /> ▶️ YouTube Shorts
                    <span class="pm-badge @(vm.YouTubeEnabled ? "ok" : "mock")">@(vm.YouTubeEnabled ? "연결됨" : "모의")</span></label>
                <label class="pm-chk"><input type="checkbox" @bind="vm.ToInstagram" disabled="@vm.IsBusy" /> 📸 Instagram Reels
                    <span class="pm-badge @(vm.InstagramEnabled ? "ok" : "mock")">@(vm.InstagramEnabled ? "연결됨" : "모의")</span></label>
            </div>

            <div class="pm-lbl">제목 (훅 기반 자동 · @(vm.Title.Length)/100)</div>
            <input class="pm-in" @bind="vm.Title" @bind:event="oninput" maxlength="100" disabled="@vm.IsBusy" />

            <div class="pm-lbl">설명 (씬 대본 타임스탬프 자동 요약)</div>
            <textarea class="pm-in pm-ta" @bind="vm.Description" disabled="@vm.IsBusy"></textarea>

            <div class="pm-lbl">태그 (쉼표 구분 · #Shorts 자동 포함)</div>
            <input class="pm-in" @bind="vm.TagsText" disabled="@vm.IsBusy" />

            <div class="pm-grid">
                <div>
                    <div class="pm-lbl">공개 상태 (YouTube)</div>
                    <select class="pm-in" @bind="vm.Privacy" disabled="@(vm.IsBusy || vm.Schedule)">
                        @foreach (var o in PublishViewModel.PrivacyOptions)
                        {
                            <option value="@o.Key">@o.Label</option>
                        }
                    </select>
                </div>
                <div>
                    <div class="pm-lbl"><label class="pm-chk"><input type="checkbox" @bind="vm.Schedule" disabled="@vm.IsBusy" /> 예약 발행 (YouTube · 비공개→자동 공개)</label></div>
                    <input class="pm-in" type="datetime-local" value="@(vm.ScheduleLocal.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture))"
                           @onchange="OnScheduleChanged" disabled="@(vm.IsBusy || !vm.Schedule)" />
                </div>
            </div>

            @if (vm.ToInstagram)
            {
                <div class="pm-lbl">릴스 캡션 (≤2200자 · 해시태그 ≤30개 · @(vm.Caption.Length)자)</div>
                <textarea class="pm-in pm-ta" @bind="vm.Caption" disabled="@vm.IsBusy"></textarea>
                <div class="pm-lbl">공개 영상 URL (선택 — 있으면 Graph API 직결, 없으면 웹훅/로컬 브릿지)</div>
                <input class="pm-in" @bind="vm.PublicVideoUrl" placeholder="https://cdn.example.com/video.mp4" disabled="@vm.IsBusy" />
                <label class="pm-chk pm-consent"><input type="checkbox" @bind="vm.InstagramConsent" disabled="@vm.IsBusy" /> 릴스는 공개 게시됩니다 — 동의합니다</label>
            }

            @if (vm.ToYouTube && vm.YouTubeStatus is { } ys)
            {
                <div class="pm-prog"><span>▶️ @ys</span><div class="pm-bar"><div class="pm-bar-f yt" style="width:@(Pct(vm.YouTubeProgress))%"></div></div></div>
                @if (vm.YouTubeResult is { Url: { } url })
                {
                    <div class="pm-link">🔗 @url</div>
                }
            }
            @if (vm.ToInstagram && vm.InstagramStatus is { } igs)
            {
                <div class="pm-prog"><span>📸 @igs</span><div class="pm-bar"><div class="pm-bar-f ig" style="width:@(Pct(vm.InstagramProgress))%"></div></div></div>
            }
        </div>

        <div class="pm-foot">
            @if (vm.IsBusy)
            {
                <span class="pm-sub">전체 @(Pct(vm.OverallProgress))%</span>
                <button class="pm-btn ghost" @onclick="vm.Cancel">⏹ 취소</button>
            }
            else
            {
                <button class="pm-btn ghost" @onclick="vm.Close">닫기</button>
                <button class="pm-btn go" disabled="@(!vm.CanStart)" @onclick="Start">⬆ 업로드 시작</button>
            }
        </div>
    </div>
}

<style>
    .pm-dim{position:fixed;inset:0;background:rgba(2,6,23,.62);z-index:900}
    .pm{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);width:min(640px,94vw);max-height:90vh;display:flex;flex-direction:column;z-index:901;
        background:var(--card,#111a2e);border:1px solid var(--line,rgba(148,163,184,.2));border-radius:16px;color:var(--ink,#e6eefc);box-shadow:0 24px 60px rgba(0,0,0,.45)}
    .pm-h{display:flex;justify-content:space-between;align-items:center;padding:14px 18px;font-weight:800;font-size:15px;border-bottom:1px solid var(--line,rgba(148,163,184,.16))}
    .pm-x{background:transparent;border:0;color:inherit;font-size:16px;cursor:pointer}
    .pm-body{padding:12px 18px;overflow:auto;display:flex;flex-direction:column;gap:6px}
    .pm-lbl{font-size:12px;font-weight:700;color:var(--sub,#93a3b8);margin-top:6px}
    .pm-row{display:flex;gap:14px;flex-wrap:wrap;align-items:center}
    .pm-seo{gap:10px}
    .pm-seo-btn{background:linear-gradient(90deg,#6d5dfc,#b06ab3);color:#fff;border:0}
    .pm-seo-msg{font-size:12px;opacity:.8}
    .pm-path{font:12px 'Roboto Mono',Consolas,monospace;color:var(--sub,#cbd5e1);word-break:break-all}
    .pm-chk{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:700;cursor:pointer}
    .pm-consent{margin-top:6px;font-size:12px}
    .pm-in{width:100%;box-sizing:border-box;padding:8px 11px;border-radius:9px;border:1px solid var(--line,rgba(148,163,184,.25));background:rgba(15,23,42,.6);color:inherit;font-size:13px}
    .pm-ta{min-height:84px;resize:vertical;font-family:inherit}
    .pm-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .pm-badge{padding:2px 8px;border-radius:999px;font-size:10.5px;font-weight:800}
    .pm-badge.ok{color:#4ade80;background:rgba(34,197,94,.12);border:1px solid rgba(34,197,94,.4)}
    .pm-badge.mock{color:#fbbf24;background:rgba(251,191,36,.12);border:1px solid rgba(251,191,36,.4)}
    .pm-prog{display:flex;flex-direction:column;gap:4px;font-size:12px;margin-top:8px}
    .pm-bar{height:6px;border-radius:999px;background:rgba(148,163,184,.18);overflow:hidden}
    .pm-bar-f{height:100%;transition:width .2s}
    .pm-bar-f.yt{background:linear-gradient(90deg,#ef4444,#f97316)}
    .pm-bar-f.ig{background:linear-gradient(90deg,#a855f7,#ec4899)}
    .pm-link{font:12px 'Roboto Mono',Consolas,monospace;color:#93c5fd;word-break:break-all}
    .pm-foot{display:flex;justify-content:flex-end;align-items:center;gap:10px;padding:12px 18px;border-top:1px solid var(--line,rgba(148,163,184,.16))}
    .pm-sub{font-size:12px;color:var(--sub,#93a3b8);margin-right:auto}
    .pm-btn{padding:9px 16px;border-radius:10px;border:1px solid var(--line,rgba(148,163,184,.25));background:transparent;color:inherit;font-weight:800;font-size:13px;cursor:pointer}
    .pm-btn.go{border:0;color:#fff;background:linear-gradient(135deg,#8b7bff,#6d5efc)}
    .pm-btn[disabled]{opacity:.55;cursor:default}
</style>

@code {
    [Parameter] public PublishViewModel? Vm { get; set; }

    private PublishViewModel? _bound;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_bound, Vm)) return;
        if (_bound is not null) _bound.OnChange -= OnVmChanged;
        _bound = Vm;
        if (_bound is not null) _bound.OnChange += OnVmChanged;
    }

    private void OnVmChanged()
    {
        try { _ = InvokeAsync(StateHasChanged); }
        catch (Exception ex) { Program.Log("PublishModal.OnChange", ex); }
    }

    private void OnScheduleChanged(ChangeEventArgs e)
    {
        if (Vm is not null && DateTime.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, DateTimeStyles.AssumeLocal, out var t)) Vm.ScheduleLocal = t;
    }

    private async Task Start()
    {
        if (Vm is null) return;
        try { await Vm.StartAsync(); }
        catch (Exception ex) { Program.Log("PublishModal.Start", ex); }
    }

    private async Task GenerateSeo()
    {
        if (Vm is null) return;
        try { await Vm.GenerateSeoAsync(); }
        catch (Exception ex) { Program.Log("PublishModal.Seo", ex); }
    }

    private async Task ExportMultiPackage()
    {
        if (Vm is null) return;
        try { await Vm.ExportMultiPackageAsync(); }
        catch (Exception ex) { Program.Log("PublishModal.MultiPkg", ex); }
    }

    private void OnQuickPreset(ChangeEventArgs e)
    {
        if (Vm is null) return;
        var v = e.Value?.ToString();
        if (v == "save") { Vm.SaveCustomPreset(); return; }
        if (PromptFlowStudio.Services.Export.FintechExportPreset.ParseKind(v) is { } k) Vm.ApplyPreset(k);
    }

    private void OnLutChanged(ChangeEventArgs e)
    {
        if (Vm is null) return;
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var i) && Enum.IsDefined(typeof(PromptFlowStudio.Services.Export.LutProfile), i))
            Vm.StockSuiteLut = (PromptFlowStudio.Services.Export.LutProfile)i;
    }

    private async Task ExportStockSuite()
    {
        if (Vm is null) return;
        try { await Vm.ExportToStockSuiteAsync(); }
        catch (Exception ex) { Program.Log("PublishModal.StockSuite", ex); }
    }

    private async Task ExportDualSplit()
    {
        if (Vm is null) return;
        try { await Vm.ExportDualMonitorSplitAsync(); }
        catch (Exception ex) { Program.Log("PublishModal.DualSplit", ex); }
    }

    private static string Pct(double v) => Math.Round(Math.Clamp(v, 0, 1) * 100).ToString("0", CultureInfo.InvariantCulture);

    public void Dispose()
    {
        if (_bound is not null) _bound.OnChange -= OnVmChanged;
        _bound = null;
    }
}
