@using PromptFlowStudio.Services.Pluto
@implements IDisposable

@* [PromptFlow Studio] 🪐 플루토 코파일럿 드로어 — 일상 메모 → 3스타일(📷 화보 · 🎨 픽사풍 3D · 📼 16mm 레트로) 15초 3막 변형 카드 → 🎬 1-클릭 스튜디오 적용.
   모바일 링크 대상 서브컴포넌트 — @inject 금지(코파일럿은 파라미터 주입). *@

@if (Open)
{
    <div class="pcd-dim" @onclick="CloseAsync"></div>
    <aside class="pcd" role="dialog" aria-label="플루토 시나리오 코파일럿" data-pluto-copilot="1">
        <div class="pcd-h">
            <span>🪐 플루토에게 시나리오 요청</span>
            <PlutoDirectorBadge Director="Copilot?.Director" AlignRight="true" />
            <button class="pcd-x" title="닫기" @onclick="CloseAsync">✕</button>
        </div>
        <div class="pcd-body">
            <div class="pcd-lbl">오늘 있었던 일을 짧게 적어주세요</div>
            <textarea class="pcd-in" rows="3" maxlength="300" placeholder="예) 오늘 아기가 거실에서 처음으로 뒤집기 성공하고 방긋 웃었어"
                      @bind="_memo" @bind:event="oninput"></textarea>
            <button class="pcd-btn go" disabled="@(_busy || Copilot is null || string.IsNullOrWhiteSpace(_memo))" @onclick="GenerateAsync">✨ 시나리오 요청</button>
            @if (_busy)
            {
                <div class="pcd-stages" role="status" aria-live="polite" data-stage="@(_stage)">
                    @for (var i = 0; i < Stages.Length; i++)
                    {
                        var cls = i < _stage ? "pcd-stage done" : i == _stage ? "pcd-busy pcd-stage" : "pcd-stage";
                        <div class="@cls">@(i < _stage ? "✓ " : "")@Stages[i]</div>
                    }
                    <button class="pcd-btn pcd-cancel" title="생성 취소(로컬 GPU/CPU 연산 즉시 중단)" @onclick="CancelGeneration">⏹ 생성 취소</button>
                </div>
            }
            @if (_error is { Length: > 0 } err)
            {
                <div class="pcd-err">@err</div>
            }
            @if (_variants is { Count: > 0 } list)
            {
                @foreach (var v in list)
                {
                    <div class="pcd-card" data-variant="@v.VariantId">
                        <div class="pcd-style">@v.StyleName <span class="pcd-src">@(v.UsedLlm ? "🧠 Gemini" : "⚡ 로컬")</span></div>
                        <div class="pcd-hook">@v.HookTitle</div>
                        <div class="pcd-chips">
                            <div class="pcd-chip"><b>① Hook · 0~4초</b><span>@v.Act1Hook</span></div>
                            <div class="pcd-chip"><b>② Climax · 4~11초</b><span>@v.Act2Climax</span></div>
                            <div class="pcd-chip"><b>③ Smile · 11~15초</b><span>@v.Act3Ending</span></div>
                        </div>
                        <div class="pcd-meta"><span class="pcd-badge">🎥 @v.CameraMovement</span><span class="pcd-badge">🎵 @v.RecommendedBgm</span></div>
                        <button class="pcd-btn go" @onclick="() => ApplyAsync(v)">🎬 이 스타일로 스튜디오 적용</button>
                    </div>
                }
            }
        </div>
    </aside>
}

<style>
    .pcd-dim { position: fixed; inset: 0; background: rgba(2,6,23,.45); z-index: 880; }
    .pcd { position: fixed; top: 0; right: 0; bottom: 0; width: min(420px, 94vw); z-index: 881; display: flex; flex-direction: column;
           background: var(--card,#111a2e); color: var(--ink,#e6eefc); border-left: 1px solid rgba(167,139,250,.35); box-shadow: -18px 0 48px rgba(0,0,0,.4);
           animation: pcd-in .22s ease-out; }
    @@keyframes pcd-in { from { transform: translateX(100%); } to { transform: translateX(0); } }
    .pcd-h { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; padding: 14px 18px; font-weight: 900; border-bottom: 1px solid rgba(148,163,184,.16); }
    .pcd-x { background: transparent; border: 0; color: inherit; font-size: 16px; cursor: pointer; }
    .pcd-body { padding: 14px 18px; overflow: auto; display: flex; flex-direction: column; gap: 10px; }
    .pcd-lbl { font-size: 12px; font-weight: 700; opacity: .75; }
    .pcd-in { width: 100%; border-radius: 10px; border: 1px solid rgba(148,163,184,.3); background: transparent; color: inherit; padding: 10px; font: inherit; resize: vertical; }
    .pcd-btn { padding: 9px 14px; border-radius: 10px; border: 1px solid rgba(148,163,184,.3); background: transparent; color: inherit; font-weight: 800; cursor: pointer; }
    .pcd-btn.go { border: 0; color: #fff; background: linear-gradient(135deg,#8b7bff,#6d5efc); }
    .pcd-btn:disabled { opacity: .5; cursor: default; }
    .pcd-err { color: #f87171; font-size: 12px; }
    .pcd-card { border: 1px solid rgba(167,139,250,.35); border-radius: 14px; padding: 14px; display: flex; flex-direction: column; gap: 8px;
                background: linear-gradient(160deg, rgba(167,139,250,.12), rgba(244,114,182,.08)); }
    .pcd-busy { align-self: flex-start; padding: 6px 12px; border-radius: 999px; font-size: 12px; font-weight: 800; color: #c4b5fd;
                border: 1px solid rgba(167,139,250,.45); background: rgba(167,139,250,.12); animation: pcd-pulse 1.4s ease-in-out infinite; }
    @@keyframes pcd-pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: .55; transform: scale(.97); } }
    .pcd-stages { display: flex; flex-direction: column; gap: 6px; }
    .pcd-stage { align-self: flex-start; padding: 6px 12px; font-size: 12px; font-weight: 700; opacity: .4; }
    .pcd-stage.done { opacity: .8; color: #86efac; }
    .pcd-stage.pcd-busy { opacity: 1; }
    .pcd-cancel { align-self: flex-start; font-size: 12px; padding: 6px 12px; }
    .pcd-style { display: flex; justify-content: space-between; align-items: center; font-size: 13px; font-weight: 900; }
    .pcd-src { font-size: 11px; font-weight: 700; opacity: .65; }
    .pcd-hook { font-size: 16px; font-weight: 900; }
    .pcd-chips { display: flex; flex-direction: column; gap: 6px; }
    .pcd-chip { display: flex; flex-direction: column; gap: 2px; border-left: 3px solid #a78bfa; padding: 4px 0 4px 10px; font-size: 12px; }
    .pcd-chip b { font-size: 11.5px; }
    .pcd-chip span { opacity: .85; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .pcd-meta { display: flex; flex-wrap: wrap; gap: 6px; font-size: 11.5px; }
    .pcd-badge { padding: 3px 8px; border-radius: 999px; border: 1px solid rgba(148,163,184,.3); opacity: .9; }
</style>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public PlutoCopilot? Copilot { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<PlutoScriptVariant> OnApply { get; set; }
    /// <summary>🌊 변형 카드가 스트림에서 완성될 때마다 실시간 전달(나머지 스타일 생성 중에도 즉시).</summary>
    [Parameter] public EventCallback<PlutoScriptVariant> OnVariantStreamed { get; set; }

    private string _memo = "";
    private List<PlutoScriptVariant>? _variants;
    private string? _error;
    private bool _busy;
    private int _stage;   // 0 페르소나 분석 · 1 3대 스타일 구성 · 2 BGM 큐시트 매칭

    /// <summary>🧠 단계별 진행 — 0~1초 · 1~2.5초 · 2.5초~.</summary>
    private static readonly string[] Stages =
    {
        "🍼 아이 페르소나 및 성장 단계 분석 중...",
        "🎬 3대 스타일(화보·3D·레트로) 시나리오 구성 중...",
        "🎵 카메라 무빙 및 감성 BGM 큐시트 매칭 중...",
    };
    private static readonly TimeSpan Stage2At = TimeSpan.FromMilliseconds(1000);
    private static readonly TimeSpan Stage3At = TimeSpan.FromMilliseconds(2500);

    private CancellationTokenSource? _cts;   // 🛡️ 진행 중 생성 — 닫기/페이지 이탈 시 취소(늦은 결과가 재오픈 시 튀어나오는 잔상 차단)

    private async Task GenerateAsync()
    {
        _error = null;
        if (_busy || Copilot is null || string.IsNullOrWhiteSpace(_memo)) return;
        _busy = true;
        _stage = 0;
        _variants = null;
        var cts = new CancellationTokenSource();
        _cts = cts;
        var stageCts = CancellationTokenSource.CreateLinkedTokenSource(cts.Token);
        _ = RunStagesAsync(stageCts.Token);   // ⏱ 경량 단계 진행(생성 종료/취소 시 함께 정지)
        try
        {
            // 🌊 Gemini 우선 · 로컬 AI는 SSE 점진 스트리밍 — 변형 1건이 닫히는 즉시 카드 표시(누락 스타일은 종료 후 로컬 보강)
            await foreach (var v in Copilot.StreamTripletVariantsAsync(_memo, null, cts.Token))
            {
                if (cts.IsCancellationRequested) break;
                var list = _variants ??= new List<PlutoScriptVariant>(3);
                var at = list.Count;
                var order = PlutoCopilot.TripletOrder(v.VariantId);
                for (var i = 0; i < list.Count; i++)
                {
                    if (PlutoCopilot.TripletOrder(list[i].VariantId) > order) { at = i; break; }
                }
                list.Insert(at, v);
                await InvokeAsync(StateHasChanged);
                if (OnVariantStreamed.HasDelegate)
                {
                    try { await OnVariantStreamed.InvokeAsync(v); }
                    catch (Exception ex) when (ex is not OperationCanceledException) { Program.Log("PlutoCopilot.Streamed", ex); }   // 구독자 예외 격리
                }
            }
            if (cts.IsCancellationRequested) _variants = null;
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested) { }   // 닫기/이탈 — 조용히 폐기
        catch (Exception ex) { Program.Log("PlutoCopilot.Triplet", ex); _variants = null; _error = "⚠ 시나리오 생성 실패 — 메모를 바꿔 다시 시도해 주세요"; }
        finally
        {
            try { stageCts.Cancel(); } catch (ObjectDisposedException) { }
            stageCts.Dispose();
            if (ReferenceEquals(_cts, cts)) _cts = null;
            cts.Dispose();
            _busy = false;
            _stage = 0;
        }
    }

    private async Task RunStagesAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(Stage2At, ct);
            ct.ThrowIfCancellationRequested();   // 종료 직후 지연 콜백의 잔상 차단
            _stage = 1;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(Stage3At - Stage2At, ct);
            ct.ThrowIfCancellationRequested();
            _stage = 2;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (Exception ex) { Program.Log("PlutoCopilot.Stage", ex); }
    }

    /// <summary>⏹ 사용자 취소 — 진행 중 HTTP(로컬 게이트웨이) 요청까지 즉시 중단(연결 토큰 전파).</summary>
    private void CancelGeneration()
    {
        if (!_busy) return;
        CancelPending();
        _error = "⏹ 생성을 취소했어요";
    }

    /// <summary>부모가 <see cref="Open"/>을 false로 내리면(닫기·화면 전환) 진행 중 생성 즉시 취소.</summary>
    protected override void OnParametersSet()
    {
        if (!Open && _cts is not null) CancelPending();
    }

    private void CancelPending()
    {
        var cts = _cts;
        _cts = null;
        try { cts?.Cancel(); }
        catch (ObjectDisposedException) { }
    }

    private async Task ApplyAsync(PlutoScriptVariant v)
    {
        try { await OnApply.InvokeAsync(v); }
        catch (Exception ex) { Program.Log("PlutoCopilot.Apply", ex); _error = "⚠ 적용 실패"; }
    }

    private async Task CloseAsync()
    {
        CancelPending();
        try { await OnClose.InvokeAsync(); }
        catch (Exception ex) { Program.Log("PlutoCopilot.Close", ex); }
    }

    public void Dispose() => CancelPending();
}
