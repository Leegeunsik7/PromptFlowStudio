@inherits LayoutComponentBase
@using PromptFlowStudio.Shared.Sim
@inject SessionState Session
@inject Microsoft.Extensions.Configuration.IConfiguration Cfg
@inject NavigationManager Nav
@inject PromptFlowStudio.Services.Help.HelpState Help
@inject PromptFlowStudio.Services.Ui.UserPreferenceService Prefs
@inject PromptFlowStudio.Services.Ui.CommandPaletteService Palette
@inject PromptFlowStudio.Services.Ui.IntentNavigationRunner NavRun
@inject PromptFlowStudio.Services.Ui.StudioNavigationService StudioNav
@inject PromptFlowStudio.Services.Ui.ThemeService Theme
@inject PromptFlowStudio.Services.Ui.SidebarGuideService SideGuide
@inject PromptFlowStudio.Services.Storyboard.BatchProductionService Batch
@inject IJSRuntime JS
@inject PromptFlowStudio.Services.Wan.IWanPromptBoosterService Booster
@implements IDisposable

@* ★ [회원 로그인 게이트 + 사이드바] BlazorWebView 는 항상 인터랙티브라 레이아웃에서 직접 세션 판독(정적 SSR 트릭 불요).
   미인증 시 shell 을 숨기고 /login 으로. Auth:RequireLogin=false 로 해제 가능. *@
@* ★ [커스텀 테마 엔진] 활성 테마의 색상 토큰을 :root 오버라이드로 주입(JS 불요). 활성 없으면 빈 문자열.
     ⚠ 값은 ThemeService.SafeColor 로 검증됨(스타일 주입 차단). data-theme(light/dark) 시스템과 공존. *@
<style id="pf-theme">@((MarkupString)Theme.ActiveCss)</style>

@if (_pass)
{
    @* 드로어 토글 — 1000px 이하에서만 보인다(CSS 가 제어).
       현장은 태블릿을 들고 다닌다. 사이드바가 250px 를 상시 먹으면
       10인치 화면에서 히트맵이 2열로 찌그러진다. *@
    <button type="button" class="drawer-btn" @onclick="ToggleDrawer"
            aria-label="메뉴 열기" aria-expanded="@(_drawer ? "true" : "false")">☰</button>

    <div class="app-shell @(_drawer ? "drawer-open" : "") @(_sideCollapsed ? "side-collapsed" : "")"
         @onkeydown="OnShellKey" tabindex="-1">

        @if (_drawer)
        {
            @* 스크림 — 바깥을 누르면 닫힌다. 모바일에서 가장 자연스러운 닫기 동작이다. *@
            <div class="drawer-scrim" @onclick="CloseDrawer" aria-hidden="true"></div>
        }

        <aside class="sidebar">
            <div class="side-brand">
                @*  공급사 마크(ANG). 로그인 화면과 같은 규칙이다.
                    ⚠ .side-logo 타일은 sidebar-light 에서도 어두운 그라데이션을
                      유지하므로(app.css 가 배경을 따로 정의) 흰 마크 하나로 충분하다. *@
                <div class="side-logo">
                    <img class="side-ang" src="img/ang_logo_w.png" alt="" aria-hidden="true" draggable="false" />
                </div>
                <div><div class="side-name">PromptFlow Studio</div><div class="side-tag">PROMPT · FLOW · VIDEO</div></div>
            </div>
            @* 메뉴를 고르면 드로어를 닫는다 — 모바일에서 안 닫히면 본문이 안 보인다 *@
            <nav class="nav" @onclick="CloseDrawer" @onmouseleave="HideSideGuide">
                <div class="nav-grp">스튜디오</div>
                <div class="navw" @onmouseenter='e => ShowSideGuide("", e.ClientY)'>
                    <NavLink class="nav-item" href="" accesskey="0" Match="NavLinkMatch.All">
                        <span class="ic">🎬</span><span class="nav-t" title="워크스페이스">워크스페이스</span><span class="nav-kbd">Alt+0</span>
                    </NavLink>
                </div>

                @* 생성 워크플로우 — 모든 단계가 실제 페이지로 연결됨. *@
                <div class="nav-grp">생성 워크플로우</div>
                <div class="navw" @onmouseenter='e => ShowSideGuide("workspace", e.ClientY)'><NavLink class="nav-item" href="workspace"><span class="ic">✍️</span><span class="nav-t" title="프롬프트 입력">프롬프트 입력</span></NavLink></div>
                <div class="navw" @onmouseenter='e => ShowSideGuide("storyboard", e.ClientY)'><NavLink class="nav-item" href="storyboard"><span class="ic">🎞️</span><span class="nav-t" title="스토리보드">스토리보드</span></NavLink></div>
                <div class="navw" @onmouseenter='e => ShowSideGuide("batch", e.ClientY)'><NavLink class="nav-item" href="batch"><span class="ic">🏭</span><span class="nav-t" title="대량 양산">대량 양산</span></NavLink></div>
                <div class="navw" @onmouseenter='e => ShowSideGuide("analytics", e.ClientY)'><NavLink class="nav-item" href="analytics"><span class="ic">📊</span><span class="nav-t" title="생산성 &amp; 비용 대시보드">생산성 &amp; 비용</span></NavLink></div>
                <div class="navw" @onmouseenter='e => ShowSideGuide("live-studio", e.ClientY)'><NavLink class="nav-item" href="live-studio"><span class="ic">📺</span><span class="nav-t" title="24/7 AI 라이브 스튜디오">24/7 AI 라이브 스튜디오</span></NavLink></div>
                <div class="navw" @onmouseenter='e => ShowSideGuide("brand-studio", e.ClientY)'><NavLink class="nav-item" href="brand-studio"><span class="ic">🛍️</span><span class="nav-t" title="커머셜 브랜드 스튜디오">커머셜 브랜드 스튜디오</span></NavLink></div>
                <div class="navw" @onmouseenter='e => ShowSideGuide("motion", e.ClientY)'><NavLink class="nav-item" href="motion"><span class="ic">🎥</span><span class="nav-t" title="모션·카메라">모션·카메라</span></NavLink></div>
                <div class="navw" @onmouseenter='e => ShowSideGuide("queue", e.ClientY)'><NavLink class="nav-item" href="queue"><span class="ic">⏳</span><span class="nav-t" title="렌더링 큐">렌더링 큐</span></NavLink></div>
                <div class="navw" @onmouseenter='e => ShowSideGuide("gallery", e.ClientY)'><NavLink class="nav-item" href="gallery"><span class="ic">🖼️</span><span class="nav-t" title="갤러리">갤러리</span></NavLink></div>
                @* v5.8.2: AI 15초 컷다운 — 15~30초 원본을 15초 숏폼으로 자동 재단(신규 사이드 메뉴 · 갤러리 다음). *@
                <div class="navw" @onmouseenter='e => ShowSideGuide("ai-cutdown", e.ClientY)'><NavLink class="nav-item" href="ai-cutdown"><span class="ic">✂️</span><span class="nav-t" title="AI 15초 컷다운">AI 15초 컷다운</span></NavLink></div>
                @* v5.6.2: 노드 오케스트레이터(구글 Flow 대체 코어) 정식 라우트 — 갤러리 다음. *@
                <div class="navw" @onmouseenter='e => ShowSideGuide("flow", e.ClientY)'><NavLink class="nav-item" href="flow"><span class="ic">🕹️</span><span class="nav-t" title="노드 오케스트레이터">노드 오케스트레이터</span></NavLink></div>
                <div class="navw" @onmouseenter='e => ShowSideGuide("node-studio", e.ClientY)'><NavLink class="nav-item" href="node-studio"><span class="ic">🧩</span><span class="nav-t" title="비주얼 노드 플로우 스튜디오">비주얼 노드 플로우</span></NavLink></div>
                @* v5.3.2: 모바일 시뮬레이터 — PC 우측에 디바이스 프레임을 슬라이딩 토글(라우팅 아님). *@
                <div class="navw" @onmouseenter='e => ShowSideGuide("mobile-sim", e.ClientY)'><button type="button" class='nav-item nav-btn @(_showMobileSim ? "on" : null)' @onclick="ToggleMobileSim"><span class="ic">📱</span><span class="nav-t" title="모바일 시뮬레이터">모바일 시뮬레이터</span></button></div>
                @* v6.2.0: 글로벌 관제 — 데스크톱 전용 우측 슬라이딩 관제 대시보드(라우팅 아님 · 모바일 라우터와 무간섭). *@
                <div class="navw" @onmouseenter='e => ShowSideGuide("observability", e.ClientY)'><button type="button" class='nav-item nav-btn @(_showObservability ? "on" : null)' @onclick="ToggleObservability"><span class="ic">📊</span><span class="nav-t" title="글로벌 관제">글로벌 관제</span></button></div>
                @* v7.0.0: AI 멀티트랙 타임라인 — 데스크톱 전용 우측 슬라이딩 NLE 스튜디오(라우팅 아님 · 모바일 라우터 무간섭). *@
                <div class="navw" @onmouseenter='e => ShowSideGuide("timeline", e.ClientY)'><button type="button" class='nav-item nav-btn @(_showTimeline ? "on" : null)' @onclick="ToggleTimeline"><span class="ic">🎬</span><span class="nav-t" title="AI 타임라인">AI 타임라인</span></button></div>

                @* v17.50.1: 6대 도메인 아코디언 — 스튜디오 모달 진입점 전량(StudioCatalog). 검색어 입력 시 전 카테고리 펼침 필터. *@
                <div class="nav-grp">스튜디오 모듈</div>
                @* v17.89.0: 🧭 목적 문장 → 스튜디오 추천 허브(Ctrl+K) — 메뉴 이름을 몰라도 하고 싶은 일로 찾는다. *@
                <button type="button" class="nav-intent" @onclick="ToggleIntentHub" aria-label="AI 인텐트 내비게이션 열기"><span>🧭 무엇을 하고 싶으세요?</span><kbd>Ctrl+K</kbd></button>
                <div class="nav-acc-search"><input type="search" placeholder="🔎 스튜디오 검색" @bind="_navFilter" @bind:event="oninput" aria-label="스튜디오 검색" /></div>
                @for (var ci = 0; ci < StudioCatalog.Categories.Length; ci++)
                {
                    var cat = ci;
                    var hits = NavFiltering ? StudioCatalog.CountMatches(cat, _navFilter) : StudioCatalog.CountIn(cat);
                    if (NavFiltering && hits == 0) continue;
                    var open = _openCats[cat] || NavFiltering;
                    <button type="button" class="nav-acc @(open ? "open" : null)" aria-expanded="@(open ? "true" : "false")" @onclick="() => ToggleCat(cat)">
                        <span class="nav-acc-t">@StudioCatalog.Categories[cat]</span><span class="nav-acc-n">@hits</span><span class="nav-acc-c" aria-hidden="true">▸</span>
                    </button>
                    @if (open)
                    {
                        <div class="nav-acc-body">
                            @foreach (var e in StudioCatalog.Entries)
                            {
                                if (e.Category != cat || NavFiltering && !StudioCatalog.Matches(e, _navFilter)) continue;
                                var key = e.Key;
                                <button type="button" class='nav-item nav-btn nav-sub @(IsStudioOpen(key) ? "on" : null)' title="@e.Title" @onclick="() => OpenStudio(key)"><span class="ic">@e.Icon</span><span class="nav-t">@e.Title</span></button>
                            }
                        </div>
                    }
                }
                @if (NavFiltering && NavMatchTotal() == 0)
                {
                    <div class="nav-acc-empty">일치하는 스튜디오가 없습니다</div>
                }

                <div class="nav-grp">시스템</div>
                @* 사용자 설정 — 테마 등 이 PC 운용 환경(관리자 비밀번호 불요, 모든 사용자). *@
                <div class="navw" @onmouseenter='e => ShowSideGuide("user-settings", e.ClientY)'><NavLink class="nav-item" href="user-settings"><span class="ic">🎚️</span><span class="nav-t" title="사용자 설정">사용자 설정</span></NavLink></div>
                @* 회원·라이선스·메일·설치PC 관리는 <관리자 설정> 탭으로 통합(관리자 비밀번호 게이트). *@
                <div class="navw" @onmouseenter='e => ShowSideGuide("settings", e.ClientY)'><NavLink class="nav-item" href="settings"><span class="ic">⚙️</span><span class="nav-t" title="관리자 설정">관리자 설정</span></NavLink></div>
                @* v5.3.4: 중복 메뉴 [원클릭 앱 제작] 제거 — 배포는 [관리자 설정 ▸ 보안·배포] 탭으로 일원화. *@
            </nav>

            @* ══ 화면 옵션 위젯 ═══════════════════════════════════════════════
               ⚠ 테마는 문서 루트의 data-theme 하나로만 갈린다(app.css 토큰이
                 :root[data-theme] 를 본다). 여기서 별도 클래스를 만들지 않는다 —
                 진실이 둘이 되면 한쪽만 바뀌어 화면이 어긋난다.
               ⚠ 모션 끄기는 OS 의 prefers-reduced-motion 과 <별개>다.
                 OS 설정은 그대로 존중하고, 둘 중 하나라도 켜지면 멈춘다. *@
            <div class="side-opt" role="group" aria-label="화면 옵션">
                @foreach (var o in _sideOpts)
                {
                    <div class="side-opt-r" @key="o.Key">
                        <span class="side-opt-l">
                            <span aria-hidden="true">@o.Icon</span>@o.Label
                        </span>
                        <div class="side-opt-b" role="group" aria-label="@o.Label">
                            <button type="button"
                                    class="@($"sopt {(o.On() ? "" : "on")}")"
                                    aria-pressed="@(o.On() ? "false" : "true")"
                                    @onclick="() => SetOpt(o.Key, false)">@o.OffText</button>
                            <button type="button"
                                    class="@($"sopt {(o.On() ? "on" : "")}")"
                                    aria-pressed="@(o.On() ? "true" : "false")"
                                    @onclick="() => SetOpt(o.Key, true)">@o.OnText</button>
                        </div>
                    </div>
                }
            </div>

            @* 커스텀 테마 엔진 진입 — 좌측 하단 테마 영역. *@
            <button type="button" class="side-theme-btn" @onclick="() => _themeEditor = true"
                    title="브랜드/장르 색상으로 UI 전체를 커스텀">
                🎨 커스텀 테마 제작@(Theme.Active is { } a ? $" · {a.Name}" : "")
            </button>

            <div class="side-foot">
                <div class="side-ava">@Avatar</div>
                <div class="side-um">
                    <div class="side-un">@(Session.Display.Length > 0 ? Session.Display : "게스트")</div>
                    <div class="side-ue">@Session.User · @RoleKo</div>
                </div>
                @* 도움말은 상단 헤더의 [도움말 F1] 가 단독 진입점이다.
                   사이드바의 보조 도움말 버튼은 중복이라 제거했다(단축키 F1·Alt+H 는 그대로 동작). *@
                <button class="side-out" title="로그아웃" @onclick="Logout">⏻</button>
            </div>
        </aside>
        <main class="content">
            @* ═══════════════════════════════════════════════════════════════
               상단 헤더 툴바

               ⚠ 이 레이아웃에는 원래 상단 바가 없었다. 도움말 버튼이 사이드바
                 맨 아래 프로필 상자 안에 묻혀 있어 아무도 못 찾았다.
                 관제 화면에서 '도움이 필요한 순간' 은 대개 경보가 떠 있는
                 순간이고, 그때 사용자의 시선은 화면 위쪽에 있다.

               ⚠ sticky 로 붙인다. 본문이 스크롤돼도 도움말이 항상 손에 닿아야
                 한다. .content 가 overflow:auto 라 sticky 가 그 안에서 동작한다.
               ═══════════════════════════════════════════════════════════════ *@
            <header class="topbar" role="banner">
                <div class="topbar-where">
                    @if (Here is { } h)
                    {
                        <span class="topbar-ic" aria-hidden="true">@h.Icon</span>
                        <span class="topbar-t">@h.Title</span>
                    }
                </div>

                <div class="topbar-tools">
                    @* v17.50.1: 스튜디오 트리거 98개는 좌측 사이드바 6대 카테고리로 이관 — 헤더는 트랜스포트 바(타임코드 · 레이턴시 · 메모리/GPU · 피크)만. *@
                    <MasterTransportBar OnToggleSidebar="ToggleSidebar" SidebarCollapsed="_sideCollapsed" />
                    <div class="topbar-brand" title="ANG Technology">
                        <img class="ang-mark ang-w" src="img/ang_logo_w.png"
                             alt="" aria-hidden="true" draggable="false" />
                        <img class="ang-mark ang-b" src="img/ang_logo_b.png"
                             alt="" aria-hidden="true" draggable="false" />
                        <span class="ang-name">ANG&nbsp;Technology</span>
                    </div>
                </div>
            </header>

            @* v13.0.1: 페이지 1개의 미처리 예외가 사이드바/헤더까지 셸 전체를 붕괴시키지 않도록 격리. 다른 메뉴로 이동하면 자동 복구. *@
            <div class="content-body">
                <ErrorBoundary @ref="_pageBoundary">
                    <ChildContent>@Body</ChildContent>
                    <ErrorContent Context="fault">
                        <div role="alert" style="display:flex;flex-direction:column;gap:8px;margin:24px;padding:16px 18px;border:1px solid #E53935;border-radius:10px;background:rgba(229,57,53,.08);">
                            <b>⚠ 이 화면에서 오류가 발생해 격리했습니다.</b>
                            <span>다른 메뉴는 정상 동작합니다. (@(fault.GetType().Name))</span>
                            <button type="button" style="align-self:flex-start;padding:6px 14px;border-radius:6px;border:1px solid currentColor;background:transparent;color:inherit;cursor:pointer;" @onclick="RecoverPage">다시 시도</button>
                        </div>
                    </ErrorContent>
                </ErrorBoundary>
            </div>
        </main>

        @* ⚠ 앱 전체에서 딱 하나만 둔다. 페이지마다 두면 F1 이 여러 개를 동시에 연다.
           전역 단축키(F1 · ?)는 이 컴포넌트가 document 리스너로 직접 등록한다 —
           Blazor 의 @@onkeydown 은 포커스가 shell 안에 있을 때만 발동해서
           "언제든 열린다"를 보장하지 못한다. *@
        @* 앱 전체에서 딱 하나. 열림 상태는 HelpState 서비스가 들고 있으므로
           페이지 안의 미니 아이콘도 같은 드로어를 연다. *@
        <HelpDrawer />
        @* 앱 전체에서 하나. 명령 목록은 CommandPaletteService 가 들고 있다. *@
        <CommandPalette />

        @* v5.3.2: 모바일 시뮬레이터 — 우측 슬라이딩 오버레이(순수 CSS transition)로 공용 디바이스 프레임(Shared.Sim.MobileSimulatorSidePane) 노출.
           사이드바 [📱 모바일 시뮬레이터] 토글로 열고, 스크림/✕ 로 닫으면 내부 컴포넌트가 언마운트되어 리소스 해제. *@
        <div class="mss-scrim @(_showMobileSim ? "on" : null)" @onclick="CloseMobileSim" aria-hidden="true"></div>
        <div class="mss-slide @(_showMobileSim ? "open" : null) @(_simFullscreen ? "fullscreen-mode" : null)" role="dialog" aria-modal="true" aria-label="모바일 시뮬레이터"
             tabindex="-1" @ref="_mssRef" @onkeydown="OnMssKey">
            <div class="mss-slide-head">
                <span class="mss-slide-t">📱 모바일 시뮬레이터</span>
                <button type="button" class="mss-slide-x" @onclick="CloseMobileSim" title="닫기">✕</button>
            </div>
            <div class="mss-slide-body">
                @if (_showMobileSim)
