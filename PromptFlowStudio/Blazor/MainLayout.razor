        // v17.63.0 단일 활성 스튜디오 — 스크림 z-index(112~118)가 버전별 고정이라 드로어(z 1200)로 두 번째 모달을 열면
        // DOM 순서상 앞선 모달 뒤에 깔려 클릭 불가였다. 새 모달을 열기 전에 열린 카탈로그 스튜디오를 모두 닫는다.
        foreach (var e in StudioCatalog.Entries) if (e.Key != key && IsStudioOpen(e.Key)) SetStudio(e.Key, false);
        SetStudio(key, true);
    }

    /// <summary>UI 감사 — Esc 공용: 열린 카탈로그 스튜디오 모달 전량 해제.</summary>
    private void CloseOpenStudios()
    {
        foreach (var e in StudioCatalog.Entries) if (IsStudioOpen(e.Key)) SetStudio(e.Key, false);
    }

