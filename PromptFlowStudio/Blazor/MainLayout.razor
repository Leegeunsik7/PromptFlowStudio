    /// <summary>
    /// 도움말 열기.
    /// ⚠ F1 · ? 는 HelpDrawer 가 document 레벨에서 직접 잡는다. 여기 것은
    ///   버튼 클릭과 Alt+H 용이다 — 일부 원격데스크톱·키오스크 환경에서
    ///   F1 이 호스트에 먹히는 경우를 대비한 보조 경로다.
    /// </summary>
    /// <summary>
    /// 전역 명령 등록 — 10개 메뉴 이동 + 화면 설정 + 도움말.
    ///
    /// <para>
    /// ⚠ 위험한 명령은 여기 넣지 않는다. E-Stop '발동' 이 팔레트에 있으면
    ///   타자 몇 글자와 Enter 로 전 로봇이 선다. 무장(Arm)까지만 두고,
    ///   실제 정지는 800ms 길게 누르기라는 물리적 확인을 거치게 한다.
    /// </para>
    ///
    /// <para>
    /// ⚠ 화면별 명령(예: 카메라 개별 이동)은 각 페이지가
    ///   <c>Palette.RegisterRange</c> 로 자기 것을 등록하고, 떠날 때
    ///   <c>UnregisterPrefix</c> 로 걷어 간다. 여기 있는 건 어디서나
    ///   쓰는 것뿐이다.
    /// </para>
    /// </summary>
    private void RegisterCommands()
    {
        // ── 메뉴 이동 ── (실제 라우트만; 생성 워크플로우 단계는 준비 중이라 팔레트 제외)
        var menus = new (string Route, string Icon, string Title, string[] Kw)[]
        {
            ("",             "🎬", "워크스페이스",   new[] { "home", "studio", "홈", "스튜디오", "워크스페이스", "대시보드" }),
            ("workspace",    "✍️", "프롬프트 입력",   new[] { "workspace", "프롬프트", "생성", "t2v", "i2v", "영상", "텍스트" }),
            ("storyboard",   "🎞️", "스토리보드",     new[] { "storyboard", "스토리보드", "컷", "장면", "연쇄" }),
            ("batch",        "🏭", "대량 양산",      new[] { "batch", "대량", "양산", "배치", "공장", "csv", "일괄", "factory" }),
            ("motion",       "🎥", "모션·카메라",    new[] { "motion", "모션", "카메라", "팬", "줌", "드론", "프리셋" }),
            ("queue",        "⏳", "렌더링 큐",       new[] { "queue", "렌더", "큐", "진행률", "대기", "작업" }),
            ("gallery",      "🖼️", "갤러리",          new[] { "gallery", "갤러리", "미디어", "영상목록", "저장" }),
            ("user-settings","🎚️", "사용자 설정",     new[] { "임계값", "테마", "밀도", "화면", "표시", "환경", "사용자", "user" }),
            ("settings",     "⚙️", "관리자 설정",     new[] { "설정", "관리자", "계정", "권한", "라이선스", "만료", "회원", "rbac", "메일", "smtp", "설치" }),
        };

        foreach (var m in menus)
        {
            var route = m.Route;
            Palette.Register(new PaletteCommand(
                Id: "nav." + (route.Length == 0 ? "home" : route),
                Group: "이동",
                Icon: m.Icon,
                Title: m.Title + " 열기",
                Hint: "/" + route,
                Keywords: m.Kw,
                Run: () => { Nav.NavigateTo(route); return Task.CompletedTask; }));
        }

        // v17.89.0 목적 기반 탐색 — Ctrl+K 와 같은 허브.
        Palette.Register(new PaletteCommand(
            "nav.intent", "이동", "🧭", "AI 인텐트 내비게이션 & 도움말 허브", "Ctrl+K",
            new[] { "intent", "인텐트", "추천", "찾기", "도움말", "메뉴", "목적" },
            () => { OpenStudio("_intentNavigationHub"); StateHasChanged(); return Task.CompletedTask; }));

        // ── 화면 설정 ──
        Palette.Register(new PaletteCommand(
            "ui.theme", "화면", "🌗", "테마 전환 (다크 ↔ 라이트)", null,
            new[] { "theme", "dark", "light", "밝기", "야간" },
            async () =>
            {
                var next = Prefs.Get(UserPreferenceService.Keys.Theme) == "dark" ? "light" : "dark";
                Prefs.Set(UserPreferenceService.Keys.Theme, next);
                await ApplyDisplayOpts();
            }));

        Palette.Register(new PaletteCommand(
            "ui.density", "화면", "▤", "목록 밀도 전환 (컴팩트 ↔ 여유)", null,
            new[] { "density", "compact", "행", "간격" },
            () =>
            {
                var next = Prefs.Get(UserPreferenceService.Keys.Density) == "compact" ? "comfortable" : "compact";
                Prefs.Set(UserPreferenceService.Keys.Density, next);
                return Task.CompletedTask;
            }));

        Palette.Register(new PaletteCommand(
            "ui.sound", "화면", "🔊", "경보 음향 켜기/끄기", null,
            new[] { "sound", "mute", "소리", "알림", "음성" },
            () =>
            {
                Prefs.SetBool(UserPreferenceService.Keys.SoundAlert,
                              !Prefs.GetBool(UserPreferenceService.Keys.SoundAlert));
                return Task.CompletedTask;
            }));

        Palette.Register(new PaletteCommand(
            "ui.reset", "화면", "↺", "화면 설정 기본값으로 되돌리기",
            "밀도·테마·핀 등 이 PC 의 화면 설정만 초기화",
            new[] { "reset", "초기화", "원복", "기본값" },
            async () => { Prefs.Reset(); await ApplyDisplayOpts(); })
            { IsSensitive = true });

        // ── 화면(방송 스튜디오 모드) ──
        Palette.Register(new PaletteCommand(
            "ui.broadcast", "화면", "📡", "방송 스튜디오 모드 켜기/끄기", null,
            new[] { "broadcast", "studio", "방송", "스튜디오", "네온", "글래스" },
            async () =>
            {
                Prefs.IsBroadcast = !Prefs.IsBroadcast;
                try { await JS.InvokeVoidAsync("siteMaticUi.setRootFlag", "broadcast", Prefs.IsBroadcast); } catch (Exception) { }
            }));

        // ── 렌더링 제어 ──
        Palette.Register(new PaletteCommand(
            "render.pause", "렌더", "⏸️", "대량 렌더링 일시정지", "진행 중 항목 완료 후 멈춤",
            new[] { "pause", "일시정지", "멈춤", "렌더", "배치" },
            () => { Batch.Pause(); return Task.CompletedTask; })
            { CanRun = () => Batch.IsRunning && !Batch.PauseRequested && !Batch.IsPaused });
        Palette.Register(new PaletteCommand(
            "render.resume", "렌더", "▶️", "대량 렌더링 재개", null,
            new[] { "resume", "재개", "계속", "시작", "렌더", "배치" },
            () => { Batch.Resume(); return Task.CompletedTask; })
            { CanRun = () => Batch.IsPaused || Batch.PauseRequested });

        // ── 도움말 ──
        Palette.Register(new PaletteCommand(
            "help.open", "도움말", "📖", "현재 화면 도움말 열기", "F1",
            new[] { "help", "사용법", "매뉴얼", "안내" },
            () => { Help.Open(); return Task.CompletedTask; }));

        // ── 세션 ──
        Palette.Register(new PaletteCommand(
            "session.logout", "계정", "⏻", "로그아웃", null,
            new[] { "logout", "나가기", "종료" },
            () => { Session.SignOut(); Nav.NavigateTo("login"); return Task.CompletedTask; })
            { IsSensitive = true });
    }

