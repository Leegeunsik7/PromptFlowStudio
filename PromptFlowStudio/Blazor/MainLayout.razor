    private void OnIntentHotkey() => _ = InvokeAsync(() => { ToggleIntentHub(); StateHasChanged(); });

    /// <summary>v17.89.0 JS(? 버튼) → 도움말 서랍. 단일 활성 카탈로그 플래그 우선, 없으면(스토리보드 등) 헤더 제목으로 키 해석.</summary>
    [JSInvokable]
    public Task OnStudioHelpRequested(string? header) => InvokeAsync(() =>
    {
        string? key = null;
        foreach (var e in StudioCatalog.Entries) if (IsStudioOpen(e.Key)) { key = e.Key; break; }
        key ??= StudioCatalogHelpRegistry.ResolveKeyByHeader(header);
        if (_studioHelpOpen && _studioHelpKey == key) { _studioHelpOpen = false; StateHasChanged(); return; }
        _studioHelpKey = key;
        _studioHelpHeader = header;
        _studioHelpOpen = true;
        if (key is not null) NavRun.NoteHelp(key);
        StateHasChanged();
    });

    private void CloseStudioHelp() => _studioHelpOpen = false;

    /// <summary>연관 메뉴 → 현재 모달(스토리보드 소유 포함)의 ✕ 를 JS 로 눌러 닫고 대상 스튜디오로 전환.</summary>
    private async Task SwitchFromHelp(string key)
    {
        _studioHelpOpen = false;
        try { await JS.InvokeVoidAsync("siteMaticStudioHelp.closeHost"); }
        catch (Exception) { /* 호스트 모달이 이미 닫힘 — 전환은 계속 */ }
        CloseOpenStudios();
        NavRun.NoteOpen(key);
        OpenStudio(key);
    }

    private void OpenHubFromHelp() { _studioHelpOpen = false; OpenStudio("_intentNavigationHub"); }
