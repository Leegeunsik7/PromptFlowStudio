    private IReadOnlyList<string> _mobileThemeNames => PromptFlowStudio.Services.Ui.ThemeService.BuiltIns.Select(b => b.Name).ToList();
    private void ApplyMobileTheme(string name) => Theme.ApplyByName(string.IsNullOrWhiteSpace(name) ? null : name);

    // v5.7.6: 모바일 시뮬 → 호스트 LLM 부스터 브리지. 데스크톱 전용 IWanPromptBoosterService(동기)를 태스크로 실행,
    //   1초 초과/실패/빈 결과 시 BCL 휴리스틱으로 완만 디그레이드(Graceful Degradation). 모바일 컴포넌트는 델리게이트만 받음(무주입).
    private async Task<string> BoostViaHost(string prompt)
    {
        try
        {
            var boostTask = Task.Run(() => Booster.Boost(prompt));
            if (await Task.WhenAny(boostTask, Task.Delay(1000)) == boostTask)
            {
                var boosted = await boostTask;
                if (!string.IsNullOrWhiteSpace(boosted)) return boosted;
            }
        }
        catch (Exception) { /* 원격/부스터 실패 → BCL 폴백 */ }
        return PromptFlowStudio.Services.Wan.WanPromptCompiler.EnhancePromptHeuristic(prompt);
    }
    // v5.3.3: 오버레이 키보드 접근성 — Esc 로 닫기(패널이 포커스를 가진 동안 발동).
    private void OnMssKey(KeyboardEventArgs e) { if (e.Key == "Escape") CloseMobileSim(); }

    /// <summary>
    /// 전역 단축키. Alt+0 워크스페이스, Alt+H 도움말, Esc 로 드로어 닫기.
    /// </summary>
    private void OnShellKey(KeyboardEventArgs e)
    {
        // UI 감사: Esc — 열린 카탈로그 스튜디오 모달을 먼저 닫는다(스크림 클릭 닫기와 일관).
        if (e.Key == "Escape") { _studioHelpOpen = false; CloseOpenStudios(); CloseDrawer(); return; }
        if (!e.AltKey) return;

        // Alt+H — 도움말
        if (e.Key is "h" or "H") { OpenHelp(); return; }

        // Alt+0 — 워크스페이스(홈)
        if (e.Key == "0") { CloseDrawer(); Nav.NavigateTo(""); }
    }
    private string Avatar => Session.Display.Length > 0 ? Session.Display[..1] : "S";
    private string RoleKo => Session.Role switch { "Admin" => "관리자", "Operator" => "운영자", _ => "뷰어" };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // v5.3.3: 모바일 시뮬레이터가 열리면 오버레이로 키보드 포커스를 이동(접근성). 매 렌더 상단에서 1회만.
        if (_focusMss && _showMobileSim)
        {
            _focusMss = false;
            try { await _mssRef.FocusAsync(); } catch { /* 렌더 경합/미마운트 무시 */ }
        }

        if (!firstRender) return;

        // v17.89.0 모달 헤더 ? 버튼 주입기(MutationObserver) — 실패해도 앱은 계속.
        try
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("siteMaticStudioHelp.attach", _selfRef);
        }
        catch (Exception) { /* 프리렌더 · 종료 중 */ }

        // 저장된 설정을 메모리로 끌어온 뒤 테마를 실제로 적용한다.
        // ⚠ 이 두 줄이 없으면 환경 설정의 테마 선택이 아무 효과도 내지 않는다.
        await Prefs.InitAsync(JS);
        await ApplyDisplayOpts();
        StateHasChanged();
    }

    /// <summary>사이드바 화면 옵션 1행.</summary>
    private sealed record SideOpt(
        string Key, string Icon, string Label,
        string OffText, string OnText, Func<bool> On);

    private SideOpt[] _sideOpts => new[]
    {
        new SideOpt("theme",   "🎨", "테마",     "다크", "라이트", () => Prefs.IsThemeLight),
        new SideOpt("sidebar", "📚", "사이드바", "다크", "라이트", () => Prefs.IsSidebarLight),
        // ⚠ 모션은 <켜기가 기본>이다. 끄기를 기본으로 두면 처음 쓰는 사람은
        //   이 제품이 정적인 화면인 줄 안다.
        new SideOpt("motion",  "🎬", "모션",     "정지", "켜기",   () => !Prefs.IsMotionDisabled),
        // 방송 스튜디오 시네마틱 테마(글래스모피즘·네온) — 기본 ON.
        new SideOpt("broadcast","📡", "스튜디오", "표준", "방송",   () => Prefs.IsBroadcast),
    };

    private void SetOpt(string key, bool on)
    {
        switch (key)
        {
            case "theme": Prefs.IsThemeLight = on; break;
            case "sidebar": Prefs.IsSidebarLight = on; break;
            // 버튼의 '켜기' 가 눌리면 <비활성화 해제>다. 부호가 뒤집힌다.
            case "motion": Prefs.IsMotionDisabled = !on; break;
            case "broadcast": Prefs.IsBroadcast = on; break;
        }
        _ = ApplyDisplayOpts();
    }

    /// <summary>
    /// 화면 옵션을 문서 루트에 반영한다.
    /// ⚠ 테마는 data-theme, 나머지는 클래스다. 섞지 않는다.
    /// </summary>
    private async Task ApplyDisplayOpts()
    {
        await ApplyTheme();
        try
        {
            await JS.InvokeVoidAsync("siteMaticUi.setRootFlag", "sidebar-light", Prefs.IsSidebarLight);
            await JS.InvokeVoidAsync("siteMaticUi.setRootFlag", "motion-off", Prefs.IsMotionDisabled);
            await JS.InvokeVoidAsync("siteMaticUi.setRootFlag", "broadcast", Prefs.IsBroadcast);
        }
        catch (Exception) { /* 화면 옵션 때문에 앱이 죽으면 안 된다 */ }
    }

    private async Task ApplyTheme()
    {
        try { await JS.InvokeVoidAsync("siteMaticUi.setTheme", Prefs.Get(UserPreferenceService.Keys.Theme)); }
        catch (Exception) { /* 테마 때문에 앱이 죽으면 안 된다 */ }
    }

    protected override void OnInitialized()
    {
        Session.OnChange += OnCh;
        Prefs.OnChange += OnCh;
        Theme.OnChange += OnCh;   // 커스텀 테마 변경 시 <style> 재렌더(라이브 반영)
        RegisterCommands();
        Palette.IntentHubRequested += OnIntentHotkey;
        // ⚠ 이게 없으면 F1 으로 열었을 때 헤더 버튼의 aria-expanded 가
        //   "false" 로 남는다. 스크린리더는 대화상자가 열린 줄 모른다.
        Help.OnChange += OnCh;
        var require = !string.Equals(Cfg["Auth:RequireLogin"], "false", StringComparison.OrdinalIgnoreCase);
        if (require && !Session.IsAuthenticated)
        {
            var path = new Uri(Nav.Uri).AbsolutePath.Trim('/');
            if (!string.Equals(path, "login", StringComparison.OrdinalIgnoreCase))
            {
                Nav.NavigateTo("login");
                return;
            }
        }
        _pass = true;
    }

    private void Logout()
    {
        Session.SignOut();
        Nav.NavigateTo("login");
    }

    private void OnCh() => InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        Session.OnChange -= OnCh;
        Help.OnChange -= OnCh;
        Prefs.OnChange -= OnCh;
        Theme.OnChange -= OnCh;
        Palette.IntentHubRequested -= OnIntentHotkey;
        _selfRef?.Dispose();
        _selfRef = null;
    }
}
