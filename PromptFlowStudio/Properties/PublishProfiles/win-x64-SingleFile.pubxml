<?xml version="1.0" encoding="utf-8"?>
<!--
  v18.1.0 프로덕션 배포 프로파일 — Windows x64 자체 포함(Self-Contained) 압축 단일 실행 파일.
  사용: dotnet publish PromptFlowStudio/PromptFlowStudio.csproj -p:PublishProfile=win-x64-SingleFile
  ▸ 관리 어셈블리 + 네이티브 DLL(WebView2Loader 등)은 압축 단일 exe 내부에 임베드(실행 시 self-extract).
  ▸ wwwroot·appsettings.json·Tools\·ffmpeg.exe 는 exe 옆 물리 파일로 유지한다.
    ⚠ IncludeAllContentForSelfExtract 는 사용 금지 — AppContext.BaseDirectory 가 %TEMP% 추출 폴더로 바뀌어
      AppIntegrityGuard(설치 폴더 서명 검증)·CliPathResolver(Tools\)·오프라인 스토어 경로가 깨진다.
  ⚠ 트리밍 금지(WinForms/Blazor 리플렉션 의존) — 메인 csproj 의 PublishTrimmed=false 와 동일 계약.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>..\publish\win-x64-singlefile\</PublishDir>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
