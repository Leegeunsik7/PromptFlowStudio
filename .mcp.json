{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "node",
      "args": ["tools/mcp/node_modules/@playwright/mcp/cli.js"],
      "env": { "npm_config_prefer_offline": "true", "npm_config_offline": "true" }
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "node",
      "args": ["tools/mcp/node_modules/chrome-devtools-mcp/build/src/bin/chrome-devtools-mcp.js"],
      "env": { "npm_config_prefer_offline": "true", "npm_config_offline": "true" }
    }
  }
}
