<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- ══════════════════════════════════════════════════════════════════════
       PromptFlow Studio v4.0.0 · .NET MAUI Blazor Hybrid 모바일 셸(안드로이드)
       ⚠ 빌드 전제: `dotnet workload install maui-android` + Android SDK(API 34+).
         이 환경(net8.0-windows 데스크톱 빌드)에는 MAUI 워크로드가 없어 컴파일 대상이 아니다.
       ── 코드 재사용 전략(Task 1) ──
         기존 .razor UI / CSS 글래스모피즘 / 순수 BCL 서비스는 로직 1줄 수정 없이 재사용한다.
         권장(프로덕션): 공용 코드를 Razor Class Library(PromptFlowStudio.Shared)로 추출해
         WinForms 데스크톱 호스트와 MAUI 호스트가 <ProjectReference> 로 공유.
         즉시(현 리포): 아래처럼 기존 프로젝트의 Blazor/Services 를 <소스 링크>로 포함(플랫폼 시임만 교체).
       ══════════════════════════════════════════════════════════════════ -->

  <PropertyGroup>
    <!-- v4.2 크로스플랫폼: Android + iOS(iPhone/iPad) 멀티타깃 -->
    <TargetFrameworks>net8.0-android;net8.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- v16.63.0 DirectPath 공유 메모리(MemoryMappedFile/NativeMemory) 포인터 Span 무복사 접근 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <ApplicationTitle>PromptFlow Studio</ApplicationTitle>
    <ApplicationId>com.angtec.promptflowstudio</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>5.1.0</ApplicationDisplayVersion>
  </PropertyGroup>

  <!-- 갤럭시 S26 울트라 = Android 15 · ARM64 -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetFrameworkIdentifier('$(TargetFramework)')) == '.NETCoreApp' and $(TargetFramework.Contains('-android'))">
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <!-- iPhone/iPad = iOS 15+ · ARM64 -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-ios'))">
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier Condition="'$(Configuration)'=='Release'">ios-arm64</RuntimeIdentifier>
    <!-- v5.0 CoreNFC — NDEF 리더 세션 엔타이틀먼트(Info.plist 의 NFCReaderUsageDescription 과 함께 필요) -->
    <CodesignEntitlements>Platforms/iOS/Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.100" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="8.0.100" />
  </ItemGroup>

  <!-- Android 전용: 생체인증(AndroidX.Biometric) + USB-시리얼(System.IO.Ports) -->
  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <PackageReference Include="Xamarin.AndroidX.Biometric" Version="1.1.0.16" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <!-- v5.1.1: Laerdal.FFmpeg(FFmpegKit · NU1101 복원 불가) 제거 → 표준 NuGet V3 피드의 FFmpeg.AutoGen 로 교체.
       ⚠ FFmpeg.AutoGen 은 libav* P/Invoke 바인딩(명령행 실행기 아님) — RunFfmpegAsync 는 프로그래매틱 구현 전까지
         Graceful 비활성(false). 캡처/센서/AR/NFC 등 비-ffmpeg 기능은 정상 동작. -->
  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" Version="7.0.0" />
  </ItemGroup>

  <!-- v4.1: 공용 RCL 참조 — 데스크톱 호스트와 동일한 컴포넌트/서비스/시임 공유(100% 재사용). -->
  <ItemGroup>
    <ProjectReference Include="..\PromptFlowStudio.Shared\PromptFlowStudio.Shared.csproj" />
  </ItemGroup>

  <!-- 기존 데스크톱 프로젝트의 순수 BCL 서비스 + Blazor 컴포넌트를 소스 링크로 재사용.
       (데스크톱 셸 전용 파일은 제외 — WinForms 호스트/진입점/데스크톱 페이지.) -->
  <ItemGroup>
    <Compile Include="..\PromptFlowStudio\Services\**\*.cs" LinkBase="Shared\Services"
             Exclude="..\PromptFlowStudio\Services\**\bin\**\*;..\PromptFlowStudio\Services\**\obj\**\*" />
    <!-- v5.3: 데스크톱 전용(WinForms/System.Drawing) 구현체 4종을 모바일 빌드에서 제외 —
         계약(인터페이스)은 Shared 로 이관됨, 구현은 MauiPlatformServices 로 대체(DI override). net8.0-android 컴파일 정합성 확보. -->
    <Compile Remove="..\PromptFlowStudio\Services\Platform\AutoUpdateService.cs" />
    <Compile Remove="..\PromptFlowStudio\Services\Platform\FilePickerService.cs" />
    <Compile Remove="..\PromptFlowStudio\Services\Platform\ClipboardService.cs" />
    <Compile Remove="..\PromptFlowStudio\Services\Platform\VideoExportService.cs" />
    <!-- Blazor 컴포넌트/페이지(.razor) + 격리 CSS 재사용 -->
    <!-- v16.5.1: 프로젝트 밖 링크 항목은 TargetPath 가 파일명으로 평탄화돼 네임스페이스/폴더 _Imports 가 소실 → 링크 경로를 TargetPath 로 명시
         (Shared\Blazor\_Imports.razor 의 @namespace 로 데스크톱과 동일한 PromptFlowStudio.Blazor.Components.* 네임스페이스 유지). -->
    <RazorComponent Include="..\PromptFlowStudio\Blazor\Components\**\*.razor" LinkBase="Shared\Blazor"
                    TargetPath="Shared\Blazor\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- wwwroot(글래스모피즘 CSS/JS) 재사용 — 데스크톱 index.html 은 제외(모바일 자체 wwwroot\index.html 사용).
       ⚠ 로컬 wwwroot\index.html 은 SDK 기본 Content 로 자동 포함되므로 명시 include 금지(NETSDK1022 중복 방지). -->
  <ItemGroup>
    <Content Include="..\PromptFlowStudio\wwwroot\**\*" LinkBase="wwwroot" Exclude="..\PromptFlowStudio\wwwroot\index.html" />
  </ItemGroup>

</Project>
